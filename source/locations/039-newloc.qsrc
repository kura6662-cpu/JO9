# $newloc
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START COG_CACHE | 2026-10-16_innate_learning_traits
! JO9 MOD START FOG_SAVE_CACHE | 2026-10-17_fog_relay
ui_style = 2
! JO9 MOD START TRAITS_SAVE_CACHE | 2026-10-17_traits_batch
if jo9_traits_revision < 2:
 jo9_traits_revision = 2
 gs '#static_base'
 gs '#dynamic'
 gs '#static_txt'
 gs '#variative'
 code_defined['newloc_update_iced_features_list'] = 0
 code_defined['interaction_result_self_sex_lesson'] = 0
 code_defined['interaction_result_make_slave_do'] = 0
 code_defined['interaction_result_milking_slave'] = 0
 code_defined['interaction_cow_setup'] = 0
 code_defined['interaction_lesson_humiliation'] = 0
 code_defined['interaction_lesson_seduction'] = 0
 code_defined['interaction_active_sex'] = 0
 code_defined['interaction_entertain_concert'] = 0
 code_defined['interaction_result_rape'] = 0
 code_defined['interaction_serve_clean_house'] = 0
 code_defined['interaction_entertain_erotic_show'] = 0
 code_defined['interaction_entertain_striptease'] = 0
 code_defined['interaction_entertain_acrobatics'] = 0
 code_defined['interaction_serve_massage'] = 0
 code_defined['interaction_serve_wash_master'] = 0
 code_defined['interaction_serve_prepare_meal'] = 0
 $jo9_traits_initialize_actor = {
  if dynslave_state > CONST_INT['no_slave']:
   gs 'jo9_traits_personality', 'gradecheck', 'dynslave'
   gs 'jo9_traits_value', 'refresh', 'dynslave'
  end
 }
 dynamic $do_for_each_slave_in_list, '$jo9_traits_initialize_actor', '$all_slave_characters'
 killvar '$jo9_traits_initialize_actor'
end
! JO9 MOD END TRAITS_SAVE_CACHE
if jo9_fog_revision < 1:
 jo9_fog_revision = 1
 gs '#options'
 if $place = 'edge_patrol' and get_weapon = 0: copyarr '$display_options', '$edge_of_mists'
end
! JO9 MOD END FOG_SAVE_CACHE
if jo9_learning_revision < 2:
 jo9_learning_revision = 2
 gs '#static_base'
 gs '#dynamic'
 gs '#static_txt'
 gs '#txt'
 code_defined['newloc_update_iced_features_list'] = 0
end
! JO9 MOD END COG_CACHE
! JO9_STATE_V2: refresh cached definitions once per loaded legacy save.
! JO9 MOD START J9M3010 | 2026-10-15_zzz_meiki_training | changed block; context may be included
if jo9_meiki_revision < 214348873:
 jo9_meiki_revision = 214348873
! JO9 MOD END J9M3010
 gs '#static_base'
 gs '#dynamic'
 ! JO9_STATE_EDITOR_LABEL_CACHE_BEGIN
 $virginity[1] = '가짜 처녀'
 $virginity[2] = '뻑뻑한 보지'
 $virginity[3] = '잘 젖는 보지'
 $virginity[4] = '최고의 보지'
 ! JO9_STATE_EDITOR_LABEL_CACHE_END
end
gs 'jo9_meiki_state', 'slave', 0
gs 'jo9_meiki_state', 'assistant', 0
gs 'jo9_meiki_state', 'room1', 0
gs 'jo9_meiki_state', 'room2', 0
gs 'jo9_meiki_state', 'room3', 0
gs 'jo9_meiki_state', 'room4', 0
! JO9_SINGLE_GRIMDARK_UI_20261014
! JO9 MOD START J9M3009 | 2026-10-10_restore_private_room_ui_corrections | changed block; context may be included
if snk_room_target > 0 and $curloc = '$newloc': gs 'snk_room_bridge', 'guard', '$newloc'
gs 'snk_room_diet_migrate'
! JO9 MOD END J9M3009
! JO9 MOD START WORLD_TEXT_CACHE_V4 | 2026-10-18_world_text_rework_228
! JO9 MOD START PLACE_STAGE_CACHE_V5 | 2026-10-18_world_description_stages
if jo9_reference_info_revision < 5: gs 'jo9_reference_info'
! JO9 MOD END PLACE_STAGE_CACHE_V5
! JO9 MOD END WORLD_TEXT_CACHE_V4
!Location handler transitions
!Overhauled by crushboss
!AddOnn - disabled wizard_mode check to enable in story mode via options menu
if $master_name ! 'Старый Охотник': wizard_mode = 0

!AddOn - Version check
$code_rev = '2.4.0.0'
$title_fix = '잭 오 나인 테일 v<<$code_rev>> Kor Ver'
if saved_game_loaded > 0 or $ongload = '' or $game_ver ! $title_fix:
	killvar 'saved_game_loaded'
	gs '$addon', 'update', 'full'
elseif one_time_conversion_of_interaction_counter_arrays = 0:
	!TODO: move into upgrade handler when version increments from 2.2.2 to next version
	msg '오래된 저장 파일이 감지되었습니다 ... 이제 이 창을 닫고 계속 플레이해도 됩니다 ... 이후 저장 파일 크기를 줄이기 위해 게임이 잠시 멈출 수 있습니다 ... 잠시 기다려 주십시오. 업데이트가 끝나면 알림이 표시됩니다'
	one_time_conversion_of_interaction_counter_arrays = 2 &! initialized to 1 in main_menu so new games started after this code was added will bypass this update check
elseif one_time_conversion_of_interaction_counter_arrays = 2:
	one_time_conversion_of_interaction_counter_arrays = 3 &! incremental delay to ensure the first message is seen before the game pauses
elseif one_time_conversion_of_interaction_counter_arrays = 3:
	one_time_conversion_of_interaction_counter_arrays = 4 &! do-once
	$temp_counter_array_vars[] = 'sex_done_today'
	$temp_counter_array_vars[] = 'already_done_today'
	$temp_counter_array_vars[] = 'city_already_done_today'
	$perm_counter_array_vars[] = 'sex_done_thisperson'
	$perm_counter_array_vars[] = 'city_already_done_ever'
	$add_counter_vars_for_valid_slaves = {
		if dynslave_state ! CONST_INT['no_slave']:
			$temp_counter_array_vars[] = 'dynslave_already_done_today'         &! instance-specific version of already_done_today    &! array var, each index corresponds to an interaction id, with a count as the value
			$perm_counter_array_vars[] = 'dynslave_already_done_total'         &! replaced 'already_done_curslave'                   &! array var, each index corresponds to an interaction id, with a count as the value
			$temp_counter_array_vars[] = 'dynslave_already_done_recent'        &! new in 2.2                                         &! array var, each index corresponds to an interaction id, with a count as the value
			$temp_counter_array_vars[] = 'dynslave_already_sex_today'          &! replaced 'today_sex_curslave'                      &! array var, each index corresponds to an interaction id, with a count as the value
			$perm_counter_array_vars[] = 'dynslave_already_sex_total'          &! replaced 'already_sex_curslave'                    &! array var, each index corresponds to an interaction id, with a count as the value
		end
	}
	dynamic $do_for_each_slave_in_list, '$add_counter_vars_for_valid_slaves', '$all_slave_characters'
	dynamic $replace($add_counter_vars_for_valid_slaves, 'dyn'+'slave', 'stock')
	dynamic $replace($add_counter_vars_for_valid_slaves, 'dyn'+'slave', 'select')
	dynamic $replace($add_counter_vars_for_valid_slaves, 'dyn'+'slave', 'saved_stock')
	killvar '$add_counter_vars_for_valid_slaves'
	for i = 0 to arrsize('$temp_counter_array_vars') - 1: killvar $temp_counter_array_vars[i]
	killvar '$temp_counter_array_vars'
	for i = 0 to arrsize('$perm_counter_array_vars') - 1:
		if arrsize($perm_counter_array_vars[i]) > 0:
			for j = 0 to arrsize($perm_counter_array_vars[i]) - 1:
				dynamic "if <<$perm_counter_array_vars[i]>>[j] > 0: converted_count += 1 & <<$perm_counter_array_vars[i]>>_converted[$str(j)] += <<$perm_counter_array_vars[i]>>[j]"
			end
		end
	end
	for i = 0 to arrsize('$perm_counter_array_vars') - 1: copyarr $perm_counter_array_vars[i], $perm_counter_array_vars[i] + '_converted'
	for i = 0 to arrsize('$perm_counter_array_vars') - 1: killvar $perm_counter_array_vars[i] + '_converted'
	killvar '$perm_counter_array_vars'
	msg '업데이트가 완료되었습니다 ... 이후 저장 파일 크기가 줄어들었습니다 ... 이제 이 창을 닫고 계속 플레이해도 됩니다'
elseif newloc_do_once_per_game = 0:
	newloc_do_once_per_game = 1
	gs '#estate_base' &! adjust rental costs based on game difficulty - ImperatorAugustus
end

if debug_newloc = 1: msg '$newloc: $curloc = <<$curloc>>'

!Evaluate slave achievements (skip if fainted - ImperatorAugustus)
if slave_state = CONST_INT['slave_exist']:
	if slave['selfesteem'] > 0 and slave['virtue'] > 0:
		slave['virtue'] = 5
		if slave['selfesteem_revealed'] = 0: slave['selfesteem_revealed'] = 1
	end
	if slave['selfesteem'] < 0 and slave['sin'] > 0:
		slave['sin'] = 5
		if slave['selfesteem_revealed'] = 0: slave['selfesteem_revealed'] = 1
	end
	if slave['virtue'] > 0: eval = slave['virtue']
	if slave['sin'] > 0: eval = 5 + slave['sin']
	if slave['sin'] = 0 and slave['virtue'] = 0: eval = 0
end

! standard of living [0,6] must be equal or greater than residence prestige (currently ranges [-1, 4], therefore +1) and cannot be more than one level higher (therefore +2) - ImperatorAugustus
master_wealth_target = max(estate_prestige[$estate] + 1, min(master_wealth_target, estate_prestige[$estate] + 2)) &! takes effect at next end of decade billing
master_wealth = max(estate_prestige[$estate] + 1, min(master_wealth, estate_prestige[$estate] + 2)) &! clamp "current" level within same range (can be out of range on day 1 and after changing apartments)

!Added behavior and rules for extended rental - crushboss
if pet_tentacle ! 1:
	pet_tentacle = 0
	tentacle_state = 0
	tentacle_hp = 0
	tentacle_size = 0
else
	if spawn_milked = 0: tentacle_state = 1
	if spawn_milked > tentacle_size: tentacle_state = 2
end

if dungeon ! 1:
	arachnidSpider = 0
	polypusvermin = 0
else
	arachnidSpider = 1
	polypusvermin = 1
end

!Add data for extended rental cheat - crushboss
if extended_rental_cheat > 0:
	!Extended Rental
	lab = 1
	boudoir = 1
	dungeon = 1
	barn = 1
	bath = 1
	kitchen = 1
	pen = 1
	arachnidSpider = 1
	polypusvermin = 1

	!Estate Interiors
	$study = 'classic'
	$interior_study_large['classic'] = 'interiors\classic_study_large'
	$interior_study['classic'] = 'interiors\classic_study'
	$interior_study_info['classic'] = '   '
	$bg['study'] = $interior_study[$study]
	$bg['home_lux'] = $interior_study_large[$study]
	$place_name['study'] = $estate_study_name[$estate]
	$place_location['study'] = $estate_study_location[$estate]
	$place_info['study'] = $interior_study_info[$study]

	$bed = 'stylish'
	$interior_bed_large['stylish'] = 'interiors\stylish_bed_large'
	$interior_bed['stylish'] = 'interiors\stylish_bed'
	$interior_bed_info['stylish'] = '   '
	$bg['bedroom'] = $interior_bed[$bed]
	$bg['bedroom_lux'] = $interior_bed_large[$bed]
	$place_name['bedroom'] = $estate_bed_name[$estate]
	$place_location['bedroom'] = $estate_bed_location[$estate]
	$place_info['bedroom'] = $interior_bed_info[$bed]

	$bath = 'gothic'
	$interior_bath_large['gothic'] = 'interiors\gothic_bath_large'
	$interior_bath['gothic'] = 'interiors\gothic_bath'
	$interior_bath_info['gothic'] = '   '
	$bg['bathroom'] = $interior_bath[$bath]
	$bg['bathroom_lux'] = $interior_bath_large[$bath]
	$place_name['bathroom'] = $estate_bath_name[$estate]
	$place_location['bathroom'] = $estate_bath_location[$estate]
	$place_info['bathroom'] = $interior_bath_info[$bath]

	$dungeon = 'executor'
	$interior_dungeon_large['executor'] = 'interiors\executor_dungeon_large'
	$interior_dungeon['executor'] = 'interiors\executor_dungeon'
	$interior_dungeon_info['executor'] = '   '
	$bg['dungeon'] = $interior_dungeon[$dungeon]
	$bg['dungeon_lux'] = $interior_dungeon_large[$dungeon]
	$place_name['dungeon'] = $estate_dungeon_name[$estate]
	$place_location['dungeon'] = $estate_dungeon_location[$estate]
	$place_info['dungeon'] = $interior_dungeon_info[$dungeon]

	$kitchen = 'basic'
	$interior_kitchen_large['basic'] = 'interiors\basic_kitchen_large'
	$interior_kitchen['basic'] = 'interiors\basic_kitchen'
	$interior_kitchen_info['basic'] = '   '
	$bg['kitchen'] = $interior_kitchen[$kitchen]
	$bg['kitchen_lux'] = $interior_kitchen_large[$kitchen]
	$place_name['kitchen'] = $estate_kitchen_name[$estate]
	$place_location['kitchen'] = $estate_kitchen_location[$estate]
	$place_info['kitchen'] = $interior_kitchen_info[$kitchen]

	$lab = 'basic'
	$interior_lab_large['basic'] = 'interiors\basic_lab_large'
	$interior_lab['basic'] = 'interiors\basic_lab'
	$interior_lab_info['basic'] = '   '
	$bg['lab'] = $interior_lab[$lab]
	$bg['lab_lux'] = $interior_lab_large[$lab]
	$place_name['lab'] = $estate_lab_name[$estate]
	$place_location['lab'] = $estate_lab_location[$estate]
	$place_info['lab'] = $interior_lab_info[$lab]

	$boudoir = 'gothic'
	$interior_boudoir_large['gothic'] = 'interiors\gothic_boudoir_large'
	$interior_boudoir['gothic'] = 'interiors\gothic_boudoir'
	$interior_boudoir_info['gothic'] = '   '
	$bg['boudoir'] = $interior_boudoir[$boudoir]
	$bg['boudoir_lux'] = $interior_boudoir_large[$boudoir]
	$place_name['boudoir'] = $estate_boudoir_name[$estate]
	$place_location['boudoir'] = $estate_boudoir_location[$estate]
	$place_info['boudoir'] = $interior_boudoir_info[$boudoir]

	extended_rental_cheat -= 1
end

if master_wealth < 4: club_member = 0

!Added Chimera Gem enhancement - crushboss
if chimera_gem_on = 1: master_excitement = 5 & master_excitement_rate = 200

!Variable rule normalization for assistant - crushboss
!Rules are now properties of the assistant array, so killvar 'assistant' (below) clears them - ImperatorAugustus
!if assistant_state = 0 and assistant['account_rule'] = 1: assistant['account_rule'] = 0
!if assistant_state = 0 and assistant['alchemist_rule'] = 1: assistant['alchemist_rule'] = 0
!if assistant_state = 0 and assistant['cleans_rule'] = 1: assistant['cleans_rule'] = 0
!if assistant_state = 0 and assistant['cooks_rule'] = 1: assistant['cooks_rule'] = 0
!if assistant_state = 0 and assistant['washes_master_rule'] = 1: assistant['washes_master_rule'] = 0
!if assistant_state = 0 and assistant['supervise_rule'] = 1: assistant['supervise_rule'] = 0

!Reset assistant variables if no assistant exists and fix blank screen bug for assistant - crushboss
if assistant_state = CONST_INT['no_slave']: dynamic $clear_slave_instance, 'assistant'

! automatically enable alchemy rule for assistant when there is no slave
if assistant_state = CONST_INT['slave_exist'] and slave_state = CONST_INT['no_slave']: assistant['alchemist_rule'] = 1

!Disable Vaginal Balls rule if the correct conditions don’t exist - crushboss
!Most of the slave rule conditions are handled in slave_stat but for various reasons this one requires special handling here
if slave['v_balls_rule'] = 1:
	if inventory['vaginal_balls'] < 1 or slave['virginity'] < 1:
		slave['v_balls_rule'] = 0
	end
end

!Fix blank screen bug - crushboss
if $assistant['right_wpn'] = '': $assistant['right_wpn'] = 'безоружный'
if $assistant['left_wpn'] = '': $assistant['left_wpn'] = 'безоружный'
if $assistant['armor'] = '': $assistant['armor'] = 'без_брони'
if $assistant['cloth'] = '': $assistant['cloth'] = 'голая'

!Reset all slave variables when no slave exists - improved - crushboss
if slave_state = CONST_INT['no_slave']:
	dynamic $clear_slave_instance, 'slave'
	success = 0
	angst_rise = 0
	moral_app = 0
	moral_basis = 0
	moral_boost = 0
	slave_fights_back = 0
	slave_escape = 0
	slave_attack = 0
	slave_suicide = 0
	slave_died = 0
	rules_broken_message = 0
	show_slave_fullimage = 0
	cheer_effect = 0
	cheer_rate = 0
	reasoning_effect = 0
	reasoning_rate = 0
	slave_will_masturbate = 0
	slave_masturbating_anyway = 0
    room1_will_masturbate = 0
    room2_will_masturbate = 0
    room3_will_masturbate = 0
    room4_will_masturbate = 0
	fear_resistance = 0
	rise_difficulty = 0
	futile_threat = 0

	slave_beg_for_sex = 0
	killvar 'slave_specialisation'
	!Do not enable - bug fix - crushboss
	! killvar 'sex'
end

!Fix blank screen bug - crushboss
if $slave['right_wpn'] = '': $slave['right_wpn'] = 'безоружный'
if $slave['left_wpn'] = '': $slave['left_wpn'] = 'безоружный'
if $slave['armor'] = '': $slave['armor'] = 'без_брони'
if $slave['cloth'] = '': $slave['cloth'] = 'голая'

!handle accumulated half actions - ImperatorAugustus
if master_half_action > 1: master_half_action -= 2 & dynamic $master_energy_drop
dynamic $do_for_each_slave_in_list, '$update_slave_energy_stars', '$unfrozen_slave_characters' &! this can modify energy (shifting negative half_action values to positive energy)

!counting home prestige
estate_quality = estate_prestige[$estate] + interior_prestige[$study] + interior_prestige[$bed] + interior_prestige[$bath] + interior_prestige[$kitchen] + interior_prestige[$boudoir] + interior_prestige[$dungeon] + interior_prestige[$lab]
estate_quality_modifier = estate_quality + brand_reputation

if raven_crown_on = 1: auspex = 1 & magna_magnifika = 10 &! S+ level (highest achievable through casting)
if obereg_on = 1: spell_revelio = 1

!Added bull ring enhancement - crushboss (infinite energy disabled, see $master_energy_drop -ImperatorAugustus)
!if bull_ring_on = 1 and master_energy < 1: master_energy = 1

!Not sure why the line below is needed - crushboss (that line was to prevent assistants from receiving bonuses from items the slave is wearing, in addition to the items the assistant is wearing - ImperatorAugustus)
!assistant_item = 0 &! but it is not needed now - ImperatorAugustus

! update house mess before updating slaves and master whose mood may be affected (relocated from $calculate_attributes)
house_mess = 0
if house_mess_rate >= house_mess_rate_cap[0]: house_mess = 1
if house_mess_rate >= house_mess_rate_cap[1]: house_mess = 2
if house_mess_rate >= house_mess_rate_cap[2]: house_mess = 3
if house_mess_rate >= house_mess_rate_cap[3]: house_mess = 4
if house_mess_rate >= house_mess_rate_cap[4]: house_mess = 5
if house_mess_rate < 0: house_mess_rate = 0

! update slave, assistant, prisoner and cow (slaves who are visible on the main screen)
gs '$slave_traits' &! check for revealed traits and refresh trait features list for slave, assistant, prisoner, cow
dynamic $do_for_each_slave_in_list, '$newloc_update_slave', '$main_screen_slave_characters' &! see #static_base (includes $set_obedience_difficulty and $slave_price)

!TRAITS OF FROZEN SLAVES
if code_defined['newloc_update_iced_features_list'] = 0:
	code_defined['newloc_update_iced_features_list'] = 1 &! do-once

! JO9 MOD START COG_ICED_DISPLAY | 2026-10-16_innate_learning_traits
	$newloc_update_iced_features_list = {
		$dynslave_features_list = ''
		if dynslave_state ! CONST_INT['no_slave']:
   if dynslave['jo9_learning_trait'] = 1: $dynslave_features_list += '<a href="EXEC: msg $jo9_genius_text">천재</a><br>'
   if dynslave['jo9_learning_trait'] = -1: $dynslave_features_list += '<a href="EXEC: msg $jo9_idiot_text">백치</a><br>'
! JO9 MOD END COG_ICED_DISPLAY
! JO9 MOD START TRAITS_DISPLAY_DYNSLAVE_COG_ICED_DISPLAY | 2026-10-17_traits_batch
 $dynslave_features_list += $func('jo9_traits', 'list', 'dynslave')
! JO9 MOD END TRAITS_DISPLAY_DYNSLAVE_COG_ICED_DISPLAY
			if dynslave['brand'] = 0: $dynslave_features_list +='<a color = ''#cd0000;'' href = ''EXEC: msg $Нет_клейма''>낙인 없음</a><br>'
			if dynslave['wounds'] > 0: $dynslave_features_list += $wounds[dynslave['wounds']] + '<br>'
			if dynslave['scars'] > 0: $dynslave_features_list += $scars[dynslave['scars']] + '<br>'
			if dynslave['bruises'] > 0: $dynslave_features_list += $bruises[dynslave['bruises']] + '<br>'
			if dynslave['rehabilitation'] > 0: $dynslave_features_list += '회복 [<<dynslave[''rehabilitation'']>>]<br>'
			if dynslave['virginity'] < 2: $dynslave_features_list += '처녀<br>'
			if dynslave['fertility'] = -2: $dynslave_features_list += '미성숙<br>'
			if dynslave['fertility'] = -1: $dynslave_features_list += '불임<br>'
			if dynslave['fertility'] = 1: $dynslave_features_list += '산란형<br>'
			if dynslave['pregnant'] > 0 and dynslave['pregnant_revealed'] > 0: $dynslave_features_list += '임신<br>'
			if dynslave['arena_level'] > 4: $dynslave_features_list += '투기장 챔피언<br>'
		end
	}
end

dynamic $do_for_each_slave_in_list, '$newloc_update_iced_features_list', '$iced_slave_characters'

gs '$calculate_attributes' &! update master stats including energy and mood, should be done after updating slaves due to dependencies - ImperatorAugustus

восприятие = master_fighter - 1
ловкость = master_fighter - 1
сила = master_fighter - 1

!Update variables for displaying stats that range from negative to positive (neutral to positive use indices 0-5, negative use indices 6-10)
master_mood_plus = iif(master_mood < 0, 5 - master_mood, master_mood)
master_excitement_plus = iif(master_excitement < 0, 5 - master_excitement, master_excitement)

slave_mood_plus = iif(slave['mood'] < 0, 5 - slave['mood'], slave['mood'])
slave_arousal_plus = iif(slave['arousal'] < 0, 5 - slave['arousal'], slave['arousal'])

assistant_mood_plus = iif(assistant['mood'] < 0, 5 - assistant['mood'], assistant['mood'])
assistant_arousal_plus = iif(assistant['arousal'] < 0, 5 - assistant['arousal'], assistant['arousal'])

if cooked_food < 0: cooked_food_plus = 0
if cooked_food > 0: cooked_food_plus = cooked_food

!calculation of fridge free space
fridge_items = fridge['alcohol'] + fridge['vegetables'] + fridge['grain'] + fridge['spice'] + fridge['cheese'] + fridge['eggs'] + fridge['milk'] + fridge['cream'] + fridge['mince'] + fridge['meat'] + fridge['virgin_meat']
fridge_space = estate_size[$estate] - fridge_items
if spawn_semen > estate_size[$estate]: spawn_semen = estate_size[$estate]

!Calculation of Laboratory free space - $get_lab_space - crushboss
lab_items = lab_store['slime'] + lab_store['kanabis'] + lab_store['koffe'] + lab_store['meth'] + lab_store['opium'] + вакхический_нектар + тонизируюзщий_эликсир + целительный_бальзам + афродизиак + мощный_афодизиак + приворотное_зелье + вода_леты + метаболизм_плюс + метаболизм_минус + жир_плюс + жир_минус
lab_space = estate_size[$estate] - lab_items

if exam_in_progress = 1:
	if sparks <= 0:
		txt = 1
		lecture = 13
		gt 'demo_intro'
	end
end

!Patrician quest adjustments - crushboss (replaced with a different tracking method - ImperatorAugustus)
