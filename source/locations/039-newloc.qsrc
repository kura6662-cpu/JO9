	assistant['rehabilitation'] = 0
end
!end of testing code - crushboss
if slave_type ! 978 and assistant_type ! 978 and prisoner_type ! 978 and farmhand_type ! 978 and harpy_type ! 978 and cow_type ! 978 and pig_type ! 978 and iced_1_type ! 978 and iced_2_type ! 978 and iced_3_type ! 9178 and iced_4_type ! 978 and iced_5_type ! 978 and iced_6_type ! 978 and iced_7_type ! 978 and iced_8_type ! 978 and iced_9_type ! 978 and iced_10_type ! 978 and iced_11_type ! 978 and iced_12_type ! 978 and iced_13_type ! 978 and iced_14_type ! 978 and iced_15_type ! 978 and iced_16_type ! 978 and iced_17_type ! 978 and iced_18_type ! 978: unique_slave["vampirella"] = 0

!Фикс квеста Акбара
