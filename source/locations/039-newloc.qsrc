IF lost_quest_slave_jasmine > 0 and npc_progress['jasmine'] = 0: lost_quest_slave_jasmine = 0
IF lost_quest_slave = 0: lost_quest_slave = 0 and lost_quest_slave_jasmine = 0
!Akabur_quest
if active[$event['Akabur_quest']] >= 12 and npc_progress['jasmine'] > 0:
    if slave_type ! 2617 and assistant_type ! 2617 and prisoner_type ! 2617 and farmhand_type ! 2617 and harpy_type ! 2617 and cow_type ! 2617 and pig_type ! 2617 and iced_1_type ! 2617 and iced_2_type ! 2617 and iced_3_type ! 2617 and iced_4_type ! 2617 and iced_5_type ! 2617 and iced_6_type ! 2617 and iced_7_type ! 2617 and iced_8_type ! 2617 and iced_9_type ! 2617 and iced_10_type ! 2617 and iced_11_type ! 2617 and iced_12_type ! 2617 and iced_13_type ! 2617 and iced_14_type ! 2617 and iced_15_type ! 2617 and iced_16_type ! 2617 and iced_17_type ! 2617 and iced_18_type ! 2617: lost_quest_slave_jasmine = 1 and active[$event['Akabur_quest']] = 22
end
!msg "event_Akabur_quest = <<active[$event['Akabur_quest']]>><br>npc_progress_elsa = <<npc_progress['elsa']>><br>slave_type = <<slave_type>>"
if active[$event['Akabur_quest']] >= 2 and npc_progress['elsa'] > 0 and npc_progress['elsa'] < 3:
	if slave_type ! 2616 and assistant_type ! 2616 and prisoner_type ! 2616 and farmhand_type ! 2616 and harpy_type ! 2616 and cow_type ! 2616 and pig_type ! 2616 and iced_1_type ! 2616 and iced_2_type ! 2616 and iced_3_type ! 2616 and iced_4_type ! 2616 and iced_5_type ! 2616 and iced_6_type ! 2616 and iced_7_type ! 2616 and iced_8_type ! 2616 and iced_9_type ! 2616 and iced_10_type ! 2616 and iced_11_type ! 2616 and iced_12_type ! 2616 and iced_13_type ! 2616 and iced_14_type ! 2616 and iced_15_type ! 2616 and iced_16_type ! 2616 and iced_17_type ! 2616 and iced_18_type ! 2616: lost_quest_slave = 1 and active[$event['Akabur_quest']] = 22
end  



!hints (temporarily disabled - ImperatorAugustus)
if game_difficulty < 2 and 1 = 0:
	if demo_game = 0:
		if hint_new_game = 0:
			if day = 1 and is_home = 1 and $curloc = 'menu_form':
				hint_new_game = 1
				msg '축하한다! 이제 당신은 조련사 길드의 정식 일원이 되었다.<br><br>이제 진짜 시험이 시작된다 - 그토록 많은 이들이 실패한 곳에서 당신은 성공할 수 있을까?<br><br>' & _ 
				msg '백색 도시의 길드를 방문해 계약을 받을 수도 있고, 노예 시장에 어떤 매물이 나와 있는지 볼 수도 있다.<br><br>행운을 빈다, <<$master_name>>!'
			elseif day > 1:
				hint_new_game = 2
			end
		end
	end
	if hint_zero_energy_master = 0:
		if master_energy <= 0:
			hint_zero_energy_master = 1
			msg '당신은 기력을 다 써 버렸다. 이제 당신의 기력을 쓰는 활동은 힘까지 깎아 먹게 된다. 하루를 끝낼 때가 된 걸지도 모른다.'
		end
	end
	if hint_zero_energy_slave = 0:
		if slave_state = CONST_INT['slave_exist'] and slave['energy'] <= 0:
			hint_zero_energy_slave = 1
			msg '당신의 노예는 기력을 다 써 버렸다. 이제 그녀의 기력을 쓰는 활동은 지구력까지 깎아 먹게 된다.'
		end
	end
	if hint_slave_exertion_limit = 0:
		if slave_state = CONST_INT['slave_exist'] and slave_already_done_today['exertion'] >= slave['stamina']:
			hint_slave_exertion_limit = 1
			msg '당신의 노예는 오늘 운동 활동의 한계에 도달했다. 더 무리하면 지구력이 깎이게 된다.'
		end
	end
	if slave_state = CONST_INT['slave_exist']:
		if hint_uncollared = 0:
			if slave['slave_collar'] = 0 and is_home = 0 and demo_game = 0:
				hint_uncollared = 1
				msg '축하한다, <<$master_name>>! 이제 <<$slave_name>>의 운명은 당신 손에 달려 있다.<br><br>그녀에게 숨겨진 건강 문제가 있을 수도 있다는 점을 명심해라. 그녀가 다쳤거나 쇠약해지고 있는 것 같다면 뱀자리 구역의 테크노스피어 의료 센터로 데려갈 수 있다. 타박상은 시간이 지나면 낫고, 그녀가 행복하며 쉴 시간을 얻으면 더 빨리 회복된다.'
			end
		end
		if hint_first_slave = 0:
			if day = 1 and $curloc = 'menu_form':
				hint_first_slave = 1
				msg '첫 노예를 훈련시키기 시작하면서, 길드의 멘토 안젤리카가 가르쳐 준 내용을 떠올려라.<br><br>노예는 공포, 절망, 자각, 습관, 길들임, 헌신, 흥분을 통해 복종하게 된다.'
				msg '그녀가 더는 당신의 지시 수행을 거부하지 않게 되면, 맡겨진 일을 성실하게 해내도록 동기를 부여해야 한다. 시큰둥한 노력은 아예 하지 않는 것과 거의 다름없기 때문이다.<br><br>공포, 자각, 습관, 길들임, 헌신, 흥분이 모두 성실함에 기여하지만, 그녀의 기분은 결정적인 요소다.'
				msg '공포는 효과적인 위협과 처벌을 통해 쌓인다. 절망은 불행이나, 그녀가 마땅하다고 느끼는 것보다 더 가혹한 처벌에서 생겨난다. 자각은 복종이 보상받거나 강제된다는 사실을 배우면서 쌓인다. 습관은 그녀가 맡겨진 일을 끝내고 규칙을 따르면서 형성된다. 길들임은 그녀가 본능적으로 당신의 우월함을 느낄 때 쌓인다.'
				msg '그녀에게 자신의 지위를 상기시키는 방법은 많지만, 오라가 당신보다 강한 노예를 길들이기는 어렵다 (이것은 <i>아우스펙스</i> 주문으로 확인할 수 있다).<br><br>자기 수련은 필수지만, 마법 기술은 지름길을 제공하기도 한다 (예를 들어 <i>마그나 마그니피카</i>). 적절한 규칙과 잠옷은 복종을 강화할 수 있다.'
			end
		end
		if hint_first_refusal = 0:
			if slave_already_done_today['sin_gained_with_negative_res'] > 0:
				hint_first_refusal = 1
				msg '복종은 절대적인 것이 아니다. 당신의 노예는 어떤 일은 거부하더라도 다른 일은 받아들일 수 있다. 자존심이 강하거나 영리한 노예는 집안일이 자신보다 아래라고 여길 수도 있고, 누가 지켜보지 않는 상태에서 일하는 편을 더 선호할 수도 있다. 기질이 까다로운 노예는 자신을 표현할 수 있는 활동을 선호할 수도 있다. 건강이 좋지 않은 노예는 고된 일을 거부할 수도 있다.'
				msg '당신의 노예가 당신이 시키는 모든 일을 거부한다면, 그녀에게 알맞은 옷을 입히고 학교 수업에 보내거나 개인 교사를 붙였을 때 더 좋은 결과를 얻을 수 있다.'
			end
		end
		if hint_excessive_punishment = 0:
			if slave['daily_punishment_count'] = 3:
				hint_excessive_punishment = 1
				msg '당신은 오늘 노예를 세 번 처벌했다. 노예에게 자기 죄를 곱씹을 시간을 충분히 주지 않은 채 반복해서 처벌하면 절망으로 이어질 수 있다.<br><br>그녀에게 시킬 만한 일을 도저히 찾을 수 없다면, 잠시 쉬는 편이 나을지도 모른다.' + iif(slave['mood'] < 0, '<br><br>그녀의 기분을 나아지게 할 방법을 찾아볼 수도 있겠다.', '')
			end
		end
		if hint_no_rules = 0:
			if day > 1 and slave['obedience'] < 0 and overnight_rules_count = 0 and slave['fear'] = 0 and (slave['spoil'] > 0 or slave_rate['spoil'] > 0):
				hint_no_rules = 1
				msg '당신은 아직 노예에게 아무 규칙도 정해 주지 않았다. 노예가 당신을 두려워하지 않을 때 지나친 자유를 주면 버릇없어질 수 있다. 그녀가 당신을 두려워하게 만들 수 없다면, 깨지 않으려 하거나 애초에 깰 수 없는 규칙을 몇 가지 정해라. 그녀가 다른 면에서는 복종적이고 당신을 충분히 두려워하는 법을 익히면, 위협만으로도 제자리를 알게 할 수 있을지 모른다. 하지만 이것은 고급 기술이다.'
			end
		end
		if hint_breaks_rules = 0:
			if slave['obedience'] < 0 and slave['rules_broken'] > 0:
				hint_breaks_rules = 1
				msg '노예가 당신이 정한 규칙을 어겨도 그대로 두면 훈련이 약해지고, 그녀는 더 제멋대로이거나, 자존심이 강해지거나, 기질이 까다로워질 수 있다.<br><br>그녀가 자발적으로 규칙을 따르지 않으려 한다면, 네크로폴리스의 스틸 로즈에서 필요한 장비를 갖춘 규칙부터 강제로 시행할 수 있다.'
				msg '또는 그녀가 당신을 두려워하게 만들 수 있다면, 자발적으로 따르지 않을 규칙은 덜어 줄 수도 있다. 그녀는 빈 시간을 다음 처벌을 기다리며 보내게 될 것이기 때문이다.'
			end
		end
		if hint_slave_escape = 0:
			if master_moodlet['neg_escape'] > 0:
				hint_slave_escape = 1
				msg '밤에 로마의 거리를 통해 달아나는 노예가 안전한 피난처를 찾기는 쉽지 않다. 설령 그녀를 돌려보내려는 사람이 발견하더라도, 낙인과 목걸이가 없다면 어떻게 그녀가 당신의 소유물이라는 걸 알겠는가?<br><br>스틸 로즈를 방문할 때가 된 것 같군.'
			end
		end
		if hint_first_spoil = 0:
			if slave['spoil'] = 1 and slave_rate['spoil'] > 0 and slave['obedience'] < 0:
				hint_first_spoil = 1
				msg '당신의 노예는 비협조적으로 변했다 - 약간 버릇없어진 것이다. 공적 이상으로 보상하거나 너무 자주 보상하고, 처벌을 느슨하거나 시원찮게 하고, 받을 자격이 없는 특권을 주고, 자유 시간을 너무 많이 주고, 데이트를 자주 하고, 선물을 많이 주면 이런 권리의식이 생길 수 있다.'
				msg '비협조적인 노예는 복종도는 낮아지지만 자기 성취에 대해 더 큰 공로감을 느끼며, 이것은 때로 이점이 될 수 있다. 중요한 것은 균형을 찾는 일이다. 공포, 불행, 절망, 헌신은 노예를 제자리에 묶어 둔다.<br><br>그녀가 다른 면에서는 복종적이고 당신을 충분히 두려워하는 법을 익히면, 위협만으로도 제자리를 알게 할 수 있을지 모른다. 하지만 이것은 고급 기술이다.'
			end
		end
		if hint_unruly_spoil = 0:
			if slave['spoil'] = 2 and slave_rate['spoil'] > 0 and (slave_already_done_recent[$str(menu_goldencage)] > 0 or slave['massaged'] > 0):
				hint_unruly_spoil = 1
				msg 'Your slave has become unruly - moderately spoiled. Giving her massages or sending her to the Golden Cage is good for her, but it can also create a sense of entitlement. She is now spoiled enough that it is beginning to erode her obedience. It is necessary to find a balance. Fear, unhappiness, despair and devotion keep a slave in her place.'
			end
		end
		if hint_first_mindbreak = 0:
			if $slave_psy_status = 'broken':
				hint_first_mindbreak = 1
				msg $sanity_broken
				msg '앞으로 이런 상태를 피하려면, 복종 심리에서 <b>불안</b>에 대해 멘토가 가르쳐 준 내용을 떠올려라.<br><br>지금 당신의 노예도 참을성만 있다면 여전히 훈련시킬 수 있다. 이런 상태의 노예에게 길드의 하급 매입 담당자가 얼마라도 지불할 의향이 있는지도 알아볼 수 있다.'
			end
		end
		if hint_first_obedient = 0:
			if slave['obedience'] > 0 and rebell[$slave_psy_status] <= 0 and slave['moral'] = 0 and $slave_psy_status ! 'broken' and $curloc = 'menu_form':
				hint_first_obedient = 1
				msg '축하한다, <<$master_name>>! 당신의 노예는 더 이상 반항적이지 않다. 그녀를 행복하게 유지하고, 버릇없어지지 않게 하고, 그녀가 싫어하는 규칙을 강제하지 않는다면, 그녀는 점차 자신의 운명을 받아들이고 당신에게 헌신하게 될 것이다. 자유에 대한 야망은 섬김에 대한 야망으로 바뀌게 된다. 이런 과정은 친밀한 보상과 성공적인 데이트로 더 빨리 진행시킬 수 있다.'
			end
		end
		if hint_first_dminus = 0:
			gs '$slave_price' &! update rating
			if rating > 1: hint_first_dminus = 2
			if rating = 1 and $slave_psy_status ! 'broken' and $curloc = 'menu_form':
				hint_first_dminus = 1
! JO9 MOD START RNL112 | 2026-10-17_zz_rank_display_labels
! RNL: 표시 등급 문자만 변경; 같은 대입문의 연결 줄은 원문을 유지한다.
				msg '축하한다, <<$master_name>>! 당신의 노예는 이제 조련사 길드의 <<dyneval($vb_cycle_rank, 1, "<b>D</b>")>> 등급 기준을 충족할 만큼 복종적이고 숙련되었다. 이제 그녀의 훈련을 어떻게 마무리할지 결정해야 한다.'
! JO9 MOD END RNL112
				msg '시간과 노력을 충분히 들이면 어떤 노예든 최고 등급에 도달할 수 있다. 하지만 그때까지 청구서를 감당할 수 있겠는가? 당신의 목표를 잘 생각해라.' + _ 
					iif(contract['active'] = 1, ' 길드 계약이라면 등급이 높을수록 품질 보너스도 높아진다. 계약이 하루 늦을 때마다 10스파크의 벌금이 붙는다. 품질 보너스는 이 금액을 쉽게 넘길 수 있다.', _ 
												' 구역 거주민을 위해 노예를 준비 중이라면 요구치를 넘겨도 보너스는 없지만, 거래를 마무리할 때 당신의 노예가 의뢰인을 <b>매혹</b>할 수 있어야 한다.')
				msg '더 높은 등급을 위해서는 그녀의 성 기술을 길러야 할 수도 있다. 이를 위해서는 당신이 직접 가르쳐야 한다. 성적 수업은 그녀의 복종심을 시험하므로, 기본부터 시작해서 경험이 쌓일수록 더 대담한 활동으로 넘어가는 편이 쉽다. 그녀의 자존심, 흥분도, 복장, 경험, 그리고 당신 자신의 매력과 경험에 주의를 기울여라.'
			end
		end
	end
end

------------ $newloc ------------
