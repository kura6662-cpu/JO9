!Интерес покупателей (relocated from npc_progress for auction consistency - ImperatorAugustus)
z = arrsize('$auction_buyer')
retail_buyers_number = 0
b = 10 + ((day + z) mod 11) &! pseudo-rand(10,20)

for i = 1 to z:
	a = 1 + ((day * b * i) mod z) &! deterministic pseudo-random numbers instead of rand(1,z)
	if npc_participation_chance[$auction_buyer[a]] > 0:
		if retail_buyers_number > b:
			npc_participation_chance[$auction_buyer[a]] = 0
		else
			npc_participation_chance[$auction_buyer[a]] = 100
			retail_buyers_number += 1
		end
	end
end

