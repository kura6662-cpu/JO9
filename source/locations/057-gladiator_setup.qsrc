# $gladiator_setup
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2837 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '$gladiator_setup': gs 'snk_room_bridge', 'guard', '$gladiator_setup'
! JO9 MOD END J9M2837
!Calculation of input for gladiatrix combat
!Improved - crushboss

!Reset Combat Variables at the start of a new Gladiatrix Contest - crushboss
gs '$combat_variable_reset'
sp_txt = 0
количество_врагов = 1
superviser_message = 0
a = 0
killvar '$extra_special_active'
killvar '$extra_special_used'
killvar '$враг'
killvar '$ge'

a = 1 + ((48271 * (day + slave_type + len($g_type))) mod 65537)/(65537/4) &! pseudo-rand(1,4)
if slave['arena_level'] < 1:
	if a = 1: $ge = 'dimaher_a'
	if a = 2: $ge = 'hoplite_a'
	if a = 3: $ge = 'secutor_a'
	if a = 4: $ge = 'kimerian_a'
	superviser_message = 1
elseif slave['arena_level'] = 1:
	if a = 1: $ge = 'dimaher_b'
	if a = 2: $ge = 'hoplite_b'
	if a = 3: $ge = 'secutor_b'
	if a = 4: $ge = 'kimerian_b'
	superviser_message = 2
elseif slave['arena_level'] = 2:
	if a = 1: $ge = 'dimaher_c'
	if a = 2: $ge = 'hoplite_c'
	if a = 3: $ge = 'secutor_c'
	if a = 4: $ge = 'kimerian_c'
	superviser_message = 3
elseif slave['arena_level'] = 3:
	if a = 1: $ge = 'dimaher_d'
	if a = 2: $ge = 'hoplite_d'
	if a = 3: $ge = 'secutor_d'
	if a = 4: $ge = 'kimerian_d'
	superviser_message = 4
elseif slave['arena_level'] >= 4 and $slave['trademark_style'] = '':
	if a = 1: $ge = 'dimaher_e'
	if a = 2: $ge = 'hoplite_e'
	if a = 3: $ge = 'secutor_e'
	if a = 4: $ge = 'kimerian_e'
	superviser_message = 5
end

if slave['arena_level'] > 4 and $slave['trademark_style'] ! '':
	if challenge_type = 1:
		a = 1 + ((48271 * (day + slave_type)) mod 65537)/(65537/5) &! pseudo-rand(1,5)
		!Added code to have the Vatican Champion appear sooner to help avoid the Vatican Champion damage bug - crushboss (disabled by ImperatorAugustus)
		!if trophy_vatican = 0 and a ! 5:
		!	b = rand(1,10)
		!	if b < 6: a = 5
		!	b = 0
		!	end
		if a = 1: $ge = 'champion_kamira'
		if a = 2: $ge = 'champion_corvus'
		if a = 3: $ge = 'champion_serpis'
		if a = 4: $ge = 'champion_taurus'
		if a = 5: $ge = 'champion_vatican'
		superviser_message = 6
	end
	if challenge_type = 2:
		количество_врагов = 5
		$ge = 'fugituive_a'
		$ge2 = 'fugituive_b'
		$ge3 = 'fugituive_c'
		$ge4 = 'fugituive_d'
		$ge5 = 'fugituive_e'
		superviser_message = 7
	end
	if challenge_type = 3:
		$ge = 'исчадие_арены'
		superviser_message = 8
	end
	if challenge_type = 4:
		$ge = 'champion_absolute'
		superviser_message = 9
	end
end

if $g_type = "retiarius":
	$extra_special_active = 'content/pic/buttons/net_active.png'
	$extra_special_used = 'content/pic/buttons/net_used.png'
end

if $g_type = "flagrius":
	$extra_special_active = 'content/pic/buttons/whip_active.png'
	$extra_special_used = 'content/pic/buttons/whip_used.png'
end

if $g_type = "dimacherus" or $g_type = '':
	$g_type = "dimacherus"
	$extra_special_active = 'content/pic/buttons/dual_active.png'
	$extra_special_used = 'content/pic/buttons/dual_used.png'
end

if $g_type = "hoplomachus":
	$extra_special_active = 'content/pic/buttons/shield_active.png'
	$extra_special_used = 'content/pic/buttons/shield_used.png'
end

if $g_type = "kimerian":
	$extra_special_active = 'content/pic/buttons/heavy_active.png'
	$extra_special_used = 'content/pic/buttons/heavy_used.png'
end

interaction_city = 12801
$враг[1] = $ge
$враг[2] = $ge2
$враг[3] = $ge3
$враг[4] = $ge4
$враг[5] = $ge5

gt 'interaction_city'

------------ $gladiator_setup ------------
