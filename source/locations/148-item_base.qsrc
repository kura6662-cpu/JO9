	if dynslave['enchanter_affinity'] > 0: dynslave['pos_clothes'] = 100 &! affinity finds the outfit comfortable, but wearing it does not reveal the trait - ImperatorAugustus
	learn_bonus['enchanter'] += 3 &! mystical way
	learn_bonus['alchemy'] += 2 &! mystical way
	dynslave['st_plus'] -= 1 &! not very sexy
	dynslave['ex_plus'] += 2 &! but very mysterious
}

!['sun_dress']
