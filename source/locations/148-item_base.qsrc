	dynslave['st_plus'] += 1
}

!['sailor_foku']
! JO9 MOD START J9M2227 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'sailor_foku', '세라복', 10, '<br> 세인트 피터 학원의 제복. 강의실을 마치 집처럼 느낄수 있게 해준다. 세라복의 어린 여학생보다 순진하고, 매력적으로 보일건 없다.<br><br>  사무 교육효율 Up, 학과 출석 효율 up, 세련됨 +1', 'scene\item\item_sailor'
! JO9 MOD END J9M2227

