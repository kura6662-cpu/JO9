}


!['crown_of_thorns']
! JO9 MOD START J9M2198 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'crown_of_thorns', '뾰족한 가시관', 5, '<br> 물론 이름만 이렇고 실제로 가시는 없다. 테두리는 가시 철사로 둘러져 있으며, 조립 기술의 눈속임으로 위험해 보이는 것이다. 통증은 유발하나 상처는 내지 않고, 쉽게 벗을 수 없는 구조다. 부드러운 긁힘이 자존심도 긁어낸다.<br><br>  매일 사육Up, 마조히즘 수치에 따라 기분 변화, 세련됨 -2', 'scene\item\item_thorns'
! JO9 MOD END J9M2198

$item_property['crown_of_thorns'] = {
	if dynslave['masochism'] <= 0:
		if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
			$place = 'study'
			$picture_type = 'dynslave_picture'
			npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 가시관 착용을 거부한다. 그래도 강제로 착용시킬까?'
			$yes = {
				if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
					dynamic $slave_fights_back
				else
					dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
					dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
				end
			}
			$no = {
				$dynslave['headband'] = 'пусто' &! empty
				dynslave_inventory['crown_of_thorns'] += 1
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			}
			gt 'choice_screen'
		end
	end
	dynslave['masochism_revealed'] = max(1, dynslave['masochism_revealed']) &! always reveals trait when worn - ImperatorAugustus
	if dynslave['masochism'] ! 2: dynslave['neg_clothes'] = 100
	worn_bonus['mood'] += iif(dynslave['masochism'] = 2, 1, -1) &! conditioned mood effect on masochism (2 = masochist) - ImperatorAugustus
	daily_bonus['instinct'] += 2 &! mild pain reminds slave of humility - ImperatorAugustus
	dynslave['st_plus'] = -2 &! added style penalty - ImperatorAugustus
}

!['plain_tiara']
! JO9 MOD START J9M2197 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'plain_tiara', '평범한 관', 10, '<br> 스파크 귀금속 세공의 세련된 관 머리를 완벽하게 장식하고, 고귀한 분위기를 내뿜는다.<br><br>  럭셔리함, 세련됨 +2', 'scene\item\item_plain_tiara'
! JO9 MOD END J9M2197

$item_property['plain_tiara'] = {
	if dynslave['passion_luxury'] > 0: worn_bonus['mood_rate'] += 5 & dynslave['passion_luxury_revealed'] = max(1, dynslave['passion_luxury_revealed']) &! sybarite loves luxurious items - ImperatorAugustus
	dynslave['st_plus'] += 2 &! more stylish than glasses as the diadem has no other function for non-sybarite slaves - ImperatorAugustus
}

!['hairnet']
! JO9 MOD START J9M2196 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'hairnet', '진주 머리망', 10, '><br> 비싼 직물로 짜여진 진주장식 예쁜 그물망<br>멋스러움을 더해줄 뿐더러 머리 모양을 영구적으로 잡아준다. 은색 머리핀과 진주빗을 동봉 판매한다.<br><br>  머리모양 고정, 세련됨 +2 ', 'scene\item\item_hairnet'
! JO9 MOD END J9M2196

$item_property['hairnet'] = {
	dynslave['wig'] = 1 &! equivalent style bonus as a recent haircut - ImperatorAugustus
	dynslave['st_plus'] += 2 &! increased style effectiveness to give a reason to use it (superior to a wig for style, but no exoticism bonus) - ImperatorAugustus
}
$item_property_off['hairnet'] = {
	if dynslave['hairstyle'] = 1: dynslave['hairstyle'] = 0
}

!['glasses']
! JO9 MOD START J9M2195 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'glasses', '세련된 안경', 10, '<br> 예쁘고 실용적인 안경 전문가의 안내로 시력을 최적 교정하고, 보다 효율적으로 문서를 읽게 해준다. 세련된 귀금속 테는 착용 여성에게 독특한 분위기를 준다.<br><br>  사무 교육효율 조금Up, 세련됨 +1', 'scene\item\item_glasses'
! JO9 MOD END J9M2195

$item_property['glasses'] = {
	if dynslave['secretary_affinity'] > 0: dynslave['pos_clothes'] = 100 &! slaves with secretary affinity are happier wearing glasses (but wearing them does not reveal the trait) - ImperatorAugustus
	learn_bonus['secretary'] += 1
	dynslave['st_plus'] += 1
}

!['nekomimi']
! JO9 MOD START J9M2194 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'nekomimi', '고양이 귀', 10, '<br> 유연한 테두리의 커다란 털 고양이 귀 타인들의 시선을 끌고, 진짜 애완녀처럼 느끼게 한다. 다만 수인에 대한 이미지는 썩 좋지 않다는걸 감안해야 한다.<br><br>  애완녀 교육효율 조금Up, 독특함+1, 세련됨 -1', 'scene\item\item_nekomimi'
! JO9 MOD END J9M2194

$item_property['nekomimi'] = {
	if dynslave['pet_affinity'] > 0: dynslave['pos_clothes'] = 100 &! slaves with pet affinity find these comfortable (but wearing does not reveal the trait) - ImperatorAugustus
	learn_bonus['pet'] += 1 &! feel like a real pet
	dynslave['st_plus'] -= 1 &! not a refined, stylish look
	dynslave['ex_plus'] += 1 &! but it is slightly exotic
}

!['incrusted_tiara']
! JO9 MOD START J9M2193 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'incrusted_tiara', '날개장식 티아라', 20, '<br> 커다란 관에 아른대는 최고급 보석들로 장식했다. 시선을 한몸에 집중받고 아름다움을 연출한다.<br><br>  럭셔리함, 독특함 +1, 세련됨 +3', 'scene\item\item_incrusted_tiara'
! JO9 MOD END J9M2193

$item_property['incrusted_tiara'] = {
	if dynslave['passion_luxury'] > 0: worn_bonus['mood_rate'] += 5 & dynslave['passion_luxury_revealed'] = max(1, dynslave['passion_luxury_revealed']) &! sybarite loves luxurious items - ImperatorAugustus
	dynslave['st_plus'] += 3 &! increased effectiveness to give a reason to use it (better than a wig for style when combined with a recent haircut, but less exotic) - ImperatorAugustus
	dynslave['ex_plus'] += 1
}

!['exotic_wig']
! JO9 MOD START J9M2192 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'exotic_wig', '독특한 가발', 20, '<br> 개성있는 모습을 연출하고 싶은가? 이 느낌있는 가발을 쓰면 된다.<br>다채색, 깃털장식, 레게 머리에, 빛나는 보석을 머리칼에 엮어 정말 한눈에 이끌린다.<br><br>  머리모양 고정, 독특함 +2, 세련됨 +1', 'scene\item\item_exotic_wig'
! JO9 MOD END J9M2192

$item_property['exotic_wig'] = {
	dynslave['wig'] = 1 &! equivalent style bonus as a recent haircut - ImperatorAugustus
	dynslave['ex_plus'] += 2 &! best in slot
	dynslave['st_plus'] += 1 &! inferior to hairnet and diadem for style - ImperatorAugustus
}
$item_property_off['exotic_wig'] = {
	if dynslave['hairstyle'] = 1: dynslave['hairstyle'] = 0
}

!ITEMS WORN ON NECK - NOT SLAVE COLLARS (SLAVE WEARING THESE CAN ESCAPE)

!['plain_pendant']
! JO9 MOD START J9M2191 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'plain_pendant', '장식 목걸이', 5, '<br> 잘 세공된 펜던트가 달린 귀금속 줄. 세련미와 멋을 강조해준다.<br><br>  세련됨 +1', 'scene\item\item_plain_pendant'
! JO9 MOD END J9M2191

$item_property['plain_pendant'] = {
	dynslave['st_plus'] += 1
}

!['incrusted_necklace']
! JO9 MOD START J9M2190 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'incrusted_necklace', '보석 목걸이', 10, '<br> 아름다운 보석문양 목걸이<br><br>  세련됨 +2', 'scene\item\item_incrusted_necklace'
! JO9 MOD END J9M2190

$item_property['incrusted_necklace'] = {
	dynslave['st_plus'] += 2
}

!['dog_collar']
! JO9 MOD START J9M2189 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'dog_collar', '개목줄', 5, '<br> 인간을 위한게 아니라, 동물을 위한 목줄이다. 즉각 동물처럼 느끼게 만들지만, 전문적인 목줄보다는 벗기기가 쉽다. <br><br>  애완녀 교육효율 Up, 세련됨 -1', 'scene\item\item_dog_collar'
! JO9 MOD END J9M2189

$item_property['dog_collar'] = {
	if dynslave['pet'] < 3 and dynslave['pet_affinity'] = 0:
		if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
			$place = 'study'
			$picture_type = 'dynslave_picture'
			npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 애완동물용 목줄 착용을 거부한다. 그래도 강제로 착용시킬까? 잠금장치가 없어서 쉽게 벗을 수 있다.'
			$yes = {
				if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
					dynamic $slave_fights_back
				else
					dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
					dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
				end
			}
			$no = {
				$dynslave['collar'] = 'пусто' &! empty
				dynslave_inventory['dog_collar'] += 1
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			}
			gt 'choice_screen'
		end
	end
	if dynslave['pet'] > 2 and (dynslave['ego'] < 3 or dynslave['moral'] > 1): worn_bonus['mood_rate'] += 5
	! no mood penalty, like leather and ornamented collar, but this is not a slave collar (easy to remove) - ImperatorAugustus
	learn_bonus['pet'] += 2 &! helps set up a slave in the right mood (better than leather or spiked collar for pet training) - ImperatorAugustus
	dynslave['st_plus'] = -1 &! added style penalty - ImperatorAugustus
}

!ITEMS WORN ON NECK - SLAVE COLLARS (SLAVE WEARING THESE CANNOT ESCAPE)

!['leather_collar']
! JO9 MOD START J9M2188 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'leather_collar', '가죽 목줄', 3, '<br> 넓은 가죽띠에 단추형 보석과 고리를 채워놓은 목줄. 착용 하자마자 운명을 되새겨준다. 다양한 놀이에 실용적이라는건 말할 필요도 없다.<br><br> 목줄. 매일 사육up, 애완녀 교육효율 조금up, 세련됨 -1', 'scene\item\item_leather_collar'
! JO9 MOD END J9M2188

$item_property['leather_collar'] = {
	if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
		$place = 'study'
		$picture_type = 'dynslave_picture'
		npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 가죽 목걸이 착용을 거부한다. 그래도 강제로 잠가 버릴까?'
		$yes = {
			if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
				dynamic $slave_fights_back
			else
				dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			end
		}
		$no = {
			$dynslave['collar'] = 'пусто' &! empty
			dynslave_inventory['leather_collar'] += 1
			dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
		}
		gt 'choice_screen'
	end
	! no mood penalty gives a reason to use this or the ornamented collar, and this is 17$ cheaper - ImperatorAugustus
	dynslave['slave_collar'] = 1 &! equipped with name token
	daily_bonus['instinct'] += 1 &! never forget about her fate
	learn_bonus['pet'] += 1 &! rings for attaching a leash
	dynslave['st_plus'] = -1 &! added style penalty - ImperatorAugustus
}

!도나이식
!['steel_leash']
! JO9 MOD START J9M2187 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'steel_leash', '외출용 목줄', 20, '<br> 고급스러운 목줄. 분실을 대비해 주인 이름이 각인되어 있다.<br><br>  목줄. 매일 태도 조금 좋아짐, 매일 사육up, 세련됨 -2', 'scene\item\item_steel_leash'
! JO9 MOD END J9M2187

$item_property['steel_leash'] = {
	if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
		$place = 'study'
		$picture_type = 'dynslave_picture'
		npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>(이)가 목줄 착용을 거부합니다. 그녀에게 강제로 착용시키기 위해 무력을 사용하시겠습니까?'
		$yes = {
			if dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
				dynamic $slave_fights_back
			else
				dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
				dynslave_stat_screen = 2 & gt 'dynslave_stat'
			end
		}
		$no = {
			$dynslave['collar'] = 'пусто' &! empty
			dynslave_inventory['steel_leash'] += 1
			dynslave_stat_screen = 2 & gt 'dynslave_stat'
		}
		gt 'choice_screen'
	end
	dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 1 &! not a pleasant experience
	dynslave['slave_collar'] = 1 &! engraved with name and address
	daily_bonus['pride'] -= 1 &! impact on pride and conceit
	daily_bonus['instinct'] += 2 &! heavy reminder of fate
	dynslave['st_plus'] = -2 &! added style penalty - ImperatorAugustus
}

!['pwring']
! JO9 MOD START J9M2186 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'pwring', '순산 기원 반지', 20, '<br> 다산의 여신의 가호가 깃든 반지 임산부의 건강을 지켜준다. -메이드룸 배치시 버그있음<br><br>  임신중일떄 체력감소 완화, 세련됨 +2', 'scene\item\item_pwring'
! JO9 MOD END J9M2186

$item_property['pwring'] = {
	dynslave['st_plus'] += 2 
    if dynslave['pregnant'] > 1: daily_bonus['stamina'] += 2
}


!['steel_collar']
! JO9 MOD START J9M2185 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'steel_collar', '쇠목줄', 10, '<br> 튼튼한 쇠목줄. 불가피한 운명을 뇌리에 박아준다. 목을 조이고 피부를 스쳐대는, 이 쇠목줄 착용은 꺼림칙한 경험이다. 분실을 대비해 주인 이름이 각인되어 있다. 자존심을 긁는건 말할 필요도 없다.<br><br>  목줄. 매일 태도 조금 좋아짐, 매일 사육 대폭up, 세련됨 -2', 'scene\item\item_steel_collar'
! JO9 MOD END J9M2185

$item_property['steel_collar'] = {
	if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
		$place = 'study'
		$picture_type = 'dynslave_picture'
		npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 강철 목걸이 착용을 거부한다. 그래도 강제로 잠가 버릴까?'
		$yes = {
			if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
				dynamic $slave_fights_back
			else
				dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			end
		}
		$no = {
			$dynslave['collar'] = 'пусто' &! empty
			dynslave_inventory['steel_collar'] += 1
			dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
		}
		gt 'choice_screen'
	end
	dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 2 &! not a pleasant experience
	dynslave['slave_collar'] = 1 &! engraved with name and address
	if dynslave['pride'] > 2: daily_bonus['pride'] -= 1 &! impact on pride and conceit
	daily_bonus['instinct'] += 3 &! heavy reminder of fate
	dynslave['st_plus'] = -2 &! added style penalty - ImperatorAugustus
}

!['spiked_collar']
! JO9 MOD START J9M2184 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'spiked_collar', '가시장식 목줄', 10, '<Br> 스파크 길고 뾰족한 철가시가 박힌 위험한 모양의 목줄. 자신의 분수를 알려주며 더 위협적인 느낌을 받게 한다. 투사에게 좋은 장신구로, 특히나 성격을 더 드세게 보이게 한다.<br><br>  목줄. 매일 자아/사육Up 감수성 dn, 전투술 교육효율 조금up 세련됨 -1', 'scene\item\item_spiked_collar'
! JO9 MOD END J9M2184

$item_property['spiked_collar'] = {
	if dynslave['gladiatrix'] < 3 and dynslave['gladiatrix_affinity'] = 0:
		if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
			$place = 'study'
			$picture_type = 'dynslave_picture'
			npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 가시 목걸이 착용을 거부한다. 그래도 강제로 잠가 버릴까?'
			$yes = {
				if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
					dynamic $slave_fights_back
				else
					dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
					dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
				end
			}
			$no = {
				$dynslave['collar'] = 'пусто' &! empty
				dynslave_inventory['spiked_collar'] += 1
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			}
			gt 'choice_screen'
		end
	end
	if dynslave['gladiatrix'] > 2 and dynslave['ego'] > 2 and dynslave['temper'] > 2:
		! good accessory for gladiatrix and temperamental bitch
		worn_bonus['mood_rate'] += 5 &! mood increase for B+ gladiatrix skill (not for pets - use collar and leash instead) - ImperatorAugustus
	else
		dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 1 &! reason to use leather or ornamented collar in early training - ImperatorAugustus
	end
	dynslave['slave_collar'] = 1 &! equipped with name token
	daily_bonus['instinct'] += 1 &! reminds of her status
	daily_bonus['sensitivity'] -= 1 &! more aggressive
	learn_bonus['gladiatrix'] += 1 &! accessory for gladiatrix
	dynslave['st_plus'] = -1 &! added style penalty - ImperatorAugustus
}

!['shock_collar']
dynamic $ib_cycle, 'shock_collar', '전기충격 목걸이', 25, '   가격: 25 스파크<br>   기술식 전기충격 목걸이다. 세르피스가 복제 병사들을 훈육하기 위해 개발했고, 군사용이 아닌 용도로 조련사 길드와 협약을 맺었다. 노예에게 자신의 신분을 상기시켜 줄 뿐 아니라, 말하는 동안 정신 패턴을 지속적으로 감시하여 겸손이 부족한 태도를 감지하면 크루시아토와 비슷한 효과를 가한다. 분실 시를 대비해 네 이름표가 달려 있다.', 'scene\item\item_shock_collar'

$item_property['shock_collar'] = {
	if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
		$place = 'study'
		$picture_type = 'dynslave_picture'
		npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 전기충격 목걸이 착용을 거부한다. 그래도 강제로 잠가 버릴까?'
		$yes = {
			if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
				dynamic $slave_fights_back
			else
				dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			end
		}
		$no = {
			$dynslave['collar'] = 'пусто' &! empty
			dynslave_inventory['shock_collar'] += 1
			dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
		}
		gt 'choice_screen'
	end
	dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 1 &! not a pleasant experience
	dynslave['slave_collar'] = 1 &! engraved with name and address
	daily_bonus['instinct'] += 1 &! reminds of her status
	dynslave['st_plus'] = 2 &! as stylish as a gemstone necklace - ImperatorAugustus
	dynslave['ex_plus'] = 1 &! inferior to ornamented collar - ImperatorAugustus
}

!['golden_collar']
! JO9 MOD START J9M2183 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'golden_collar', '금장 목줄', 20, '<br> 넓직한 금띠로 된 이 사치스런 목줄은 특이한 보석 장식과 주인의 이름표가 달려있고, 여러개의 줄은 목을 당기고 흔들수 있다. 이 화려한 목장식은 누구에게 복종해야 하는가를 되새김질 시킨다.<br><br>  목줄. 매일 사육 up, 독특함+2, 세련됨 +2', 'scene\item\item_golden_collar'
! JO9 MOD END J9M2183

$item_property['golden_collar'] = {
	if dynslave['passion_luxury'] = 0:
		if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
			$place = 'study'
			$picture_type = 'dynslave_picture'
			npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 장식 목걸이 착용을 거부한다. 그래도 강제로 잠가 버릴까?'
			$yes = {
				if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
					dynamic $slave_fights_back
				else
					dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
					dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
				end
			}
			$no = {
				$dynslave['collar'] = 'пусто' &! empty
				dynslave_inventory['golden_collar'] += 1
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			}
			gt 'choice_screen'
		end
	end
	if dynslave['passion_luxury'] > 0: worn_bonus['mood_rate'] += 5 & dynslave['passion_luxury_revealed'] = max(1, dynslave['passion_luxury_revealed']) &! sybarite loves luxurious items - ImperatorAugustus
	dynslave['slave_collar'] = 1 &! equipped with name token
	daily_bonus['instinct'] += 1 &! will not forget you are her master
	dynslave['ex_plus'] += 2 &! best in slot
	dynslave['st_plus'] += 2 &! as stylish as a gemstone necklace
}

