dynamic $ib_cycle, 'slutcostume', '창녀 복장', 30, '   가격: 30 스파크.  <br>   <font size = 3%>이건 창녀들의 고전 복장이다. 가발, 상의, 치마, 도미나 부츠 - 전부 단순하고 직설적이다. 군더더기는 없다. 하지만 소녀는 풀어지고 자신의 관능을 드러내게 될 것이며, 네 노예의 몸매가 지닌 모든 장점도 잠재 고객들에게 뚜렷하게 보여질 것이니, 당연히 매상도 더 올라갈 것이다. 물론 이 복장을 입은 네 노예는 극장이나 식당, 혹은 그냥 시내를 산책할 때는 우스꽝스럽게 보일 것이다. 하지만 홍등가에서는 분명 몇 점쯤은 더 벌어 줄 것이다.</font> - 성 교육효율Up, 매일 흥분도 초대폭Up, 매일 인식/습관 소폭Up, 세련됨 +3, 독특함 +2', 'scene\item\slut_costume'
dynamic $ib_cycle, 'slut_dress', '창녀 드레스'
$item_property["slut_dress"] = {
!    dynslave["exotic_bonus"] += 50
!    dynslave["style"] -= 1
    learn_bonus["sex"] += 2
    daily_bonus["arousal"] += 4
    daily_bonus["custom"] += 1
    daily_bonus["rational"] += 1
    dynslave["st_plus"] += 3
    dynslave["ex_plus"] += 2 
}
dynamic $ib_cycle, 'slut_wig', '창녀 가발'
dynamic $ib_cycle, 'slut_boots', '창녀 부츠'
!["klips"]
dynamic $ib_cycle, 'klips', '클립 귀걸이', 5, '   가격: 5 스파크.  <br>   클립식 귀걸이는 피어싱이 필요 없는 귀걸이다. 일반 귀걸이만큼 훌륭하다. - 세련됨 +1', 'scene\item\klips'
$item_property["klips"] = {
!    dynslave["style"] += 1
    dynslave["st_plus"] += 1
}
!["brasletyboho"]
dynamic $ib_cycle, 'brasletyboho', '보헤미안 팔찌', 10, '   가격: 10 스파크.  <br>   같은 스타일로 통일된 선명한 팔찌와 반지 세트가 네 노예의 우아함과 이국성을 강조해 준다. - 세련됨 +1, 독특함 +1', 'scene\item\brasletyboho'
$item_property["brasletyboho"] = {
!    dynslave["style"] += 2
    dynslave["mood"] += 1
!    dynslave["exotic_bonus"] += 15
    dynslave["st_plus"] += 1
    dynslave["ex_plus"] += 1
}
!["encrustedbracelet"]
dynamic $ib_cycle, 'encrustedbracelet', '보석 박힌 팔찌', 20, '   가격: 20 스파크.  <br>   기분을 북돋워 주고 네 노예의 스타일과 이국성을 완벽하게 강조해 주도록 만든, 보석이 박힌 금팔찌다. - 세련됨 +2, 독특함 +1', 'scene\item\encrustedbracelet'
$item_property["encrustedbracelet"] = {
!    dynslave["style"] += 2
    dynslave["mood"] += 1
!    dynslave["exotic_bonus"] += 20
    dynslave["st_plus"] += 2
    dynslave["ex_plus"] += 1
}
!["kaffs"]
dynamic $ib_cycle, 'kaffs', '커프', 20, '   가격: 20 스파크.  <br>   이어 커프는 귀 전체를 감싸는 귀걸이다. 네 노예의 이국성과 우아함을 한층 돋보이게 해 줄 것이다. - 세련됨 +2, 독특함 +2', 'scene\item\kaffs'
$item_property["kaffs"] = {
!    dynslave["style"] += 2
    dynslave["mood"] += 1
!    dynslave["exotic_bonus"] += 20
    dynslave["st_plus"] += 2
    dynslave["ex_plus"] += 2
}
!["sleivbraslety"]
dynamic $ib_cycle, 'sleivbraslety', '노예 팔찌', 30, '   가격: 30 스파크  <br>   여러 종류의 보석이 박힌 귀금속 팔찌다. 아주 야성적인 이국미를 풍긴다. - 세련됨 +2, 독특함 +3', 'scene\item\sleivbraslety'
$item_property["sleivbraslety"] = {
!    dynslave["style"] += 1
    dynslave["mood"] += 1
!    dynslave["exotic_bonus"] += 40
    dynslave["st_plus"] += 2
	dynslave["ex_plus"] += 3
}
!["sandalii"]
dynamic $ib_cycle, 'sandalii', '샌들', 30, '   가격: 30 스파크.  <br>   샌들은 전통적인 신발 선택지다. 일상용으로도 특별한 자리용으로도 적합하다. 편안하고, 우아하며, 가격도 합리적이다. - 세련됨 +2', 'scene\item\sandalii'
$item_property["sandalii"] = {
!    dynslave["style"] += 1
