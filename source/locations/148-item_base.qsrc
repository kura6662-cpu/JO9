!['fluffy_gloves']
! JO9 MOD START J9M2215 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'fluffy_gloves', '고양이 손', 5, '<br> 이 오동통하고 푹신한 장갑은 고양이 손을 본따 만들어졌다. 기능은 없어도 옷장 수집품으론 더할 나위 없다. 동물이 된 기분을 쉽게 느끼게 만들어줘요!<br><br>  애완녀 교육효율 조금Up, 그외 모든 교육효율 초특대폭dn 세련됨 -1', 'scene\item\item_fluffy_gloves'
! JO9 MOD END J9M2215

$item_property['fluffy_gloves'] = {
	if dynslave['pet_affinity'] > 0: dynslave['pos_clothes'] = 100 &! slaves with pet affinity find these comfortable (but wearing does not reveal the trait) - ImperatorAugustus
	learn_bonus['pet'] += 1 &! easier to feel like a pet
	! not functional - interferes with other lessons - ImperatorAugustus
	learn_bonus['service']      -= 10
	learn_bonus['cook']         -= 10
	learn_bonus['secretary']    -= 10
	learn_bonus['expression']   -= 10
	learn_bonus['nurse']        -= 10
	learn_bonus['alchemy']      -= 10
	learn_bonus['enchanter']    -= 10
	learn_bonus['stamina']      -= 10
	learn_bonus['gladiatrix']   -= 10
	learn_bonus['calisthenics'] -= 10
	learn_bonus['music']        -= 10
	learn_bonus['art']          -= 10
	learn_bonus['cowSK']        -= 10
	learn_bonus['dressage']     -= 10
	dynslave['st_plus'] -= 1 &! not stylish - ImperatorAugustus
}

!ITEMS WORN ON FEET

!['tabi']
! JO9 MOD START J9M2214 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'tabi', '일본 전통 양말', 5, '<br> "타비" 라는 이름의 이 두꺼운 양말은 엄지 발가락쪽이 나뉘어 있다. 무술 훈련, 조용한 움직임에 최적화된 전통 양말이다. 무슨 훈련을 몇 번이든 견뎌낸다.<br><br>  전투술 교육효율 Up, 무용 교육효율 조금up, 독특함 +1', 'scene\item\item_tabi'
! JO9 MOD END J9M2214

$item_property['tabi'] = {
	if dynslave['gladiatrix'] > 2 or dynslave['gladiatrix_affinity'] > 0: dynslave['pos_clothes'] = 100 &! B+ gladiatrices or slaves with gladiatrix trait find these comfortable (but wearing does not reveal the trait) - ImperatorAugustus
	learn_bonus['gladiatrix'] += 2 &! martial arts
	learn_bonus['calisthenics'] += 1 &! silent movement
	dynslave['ex_plus'] += 1 &! slightly exotic - ImperatorAugustus
}

!['fluffy_stepins']
! JO9 MOD START J9M2213 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'fluffy_stepins', '푹신한 슬리퍼', 5, '<br> 부드럽고 뽀송한 이 슬리퍼는 엄청 따뜻하고, 정말 편하다. 생긴건 간단하다, 뒤는 트여있고 머리엔 리본과 공 두개가 달려있다.<br><br> 편안함, 세련됨, 독특함 -1', 'scene\item\item_fluffy_stepins'
! JO9 MOD END J9M2213

$item_property['fluffy_stepins'] = {
	dynslave['pos_clothes'] = 100
	dynslave['st_plus'] -= 1 &! does not complement a stylish outfit - ImperatorAugustus
	dynslave['ex_plus'] -= 1 &! reduces exoticism - ImperatorAugustus
}

!['pointes']
! JO9 MOD START J9M2212 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'pointes', '토슈즈', 5, '<br> 발레를 하면서 절대 없어서는 안 될 물건, 토슈즈. 무도를 위해 고안되었고, 익숙한 사람에겐 가장 편안한 신발.<br><br>  무용술 교육효율 Up, 일정이상의 무용술 기능시 편안함', 'scene\item\item_pointes'
! JO9 MOD END J9M2212

$item_property['pointes'] = {
	if dynslave['calisthenics'] > 2 or dynslave['calisthenics_affinity'] > 0: dynslave['pos_clothes'] = 100 &! B+ dancers or slaves with ballerina trait find these comfortable (but wearing does not reveal the trait) - ImperatorAugustus
	learn_bonus['calisthenics'] += 2 &! dancing
}

!['sneakers']
! JO9 MOD START J9M2211 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'sneakers', '운동화', 5, '<br> 운동하기 편안하고, 실용적인 신발로 평소에 신기 편하다.<br><br>  체력 교육효율 대폭 up, 전투술/무용 교육효율 조금Up, 운동광일때 매일 체력up 세련됨 -1, 독특함 -1', 'scene\item\item_sneakers'
! JO9 MOD END J9M2211

$item_property['sneakers'] = {
	if dynslave['sport_affinity'] > 0: dynslave['pos_clothes'] = 100 &! slaves with sport affinity find these comfortable (but wearing does not reveal the trait) - ImperatorAugustus
	learn_bonus['stamina'] += 3 &! sports
	learn_bonus['gladiatrix'] += 1 &! sports
	learn_bonus['calisthenics'] += 1 &! sports
	dynslave['st_plus'] -= 1 &! does not complement a stylish outfit - ImperatorAugustus
	dynslave['ex_plus'] -= 1 &! reduces exoticism - ImperatorAugustus
}

!['high_heels']
! JO9 MOD START J9M2210 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'high_heels', '하이힐', 5, '<br> 높고 뾰족한 이 구두가 우아와 세련의 표본이다. 광범위한 모양과 색상으로, 어떤 의상에도 맞는 쌍이 있기 마련이다. 하이힐 없는 패션에 완성이란 없다.<br><br>  세련됨 +2', 'scene\item\item_high_heels'
! JO9 MOD END J9M2210

$item_property['high_heels'] = {
	if dynslave['stamina'] < 3: dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 3 - dynslave['stamina'] &! unhealthy slaves find heels unpleasant to wear - ImperatorAugustus
	dynslave['st_plus'] += 2 &! as elegant as high_boots
}

!['high_boots']
! JO9 MOD START J9M2209 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'high_boots', '도미나 부츠', 20, '<br> 광택나는 금속 장식의 세련미 넘치는 허벅지 높이 부츠. 번식욕을 자극하고, 걷잡을 수 없는 욕구를 불러 일으킨다.<br><br>  매일 성격/체력 up, (일정 이상의 체력일 때)성 교육효율Up, 세련됨 +2', 'scene\item\item_high_boots'
! JO9 MOD END J9M2209

$item_property['high_boots'] = {
	if dynslave['stamina'] < 3: dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 3 - dynslave['stamina'] &! unhealthy slaves find heels unpleasant to wear - ImperatorAugustus
	learn_bonus['sex'] += 2 &! emphasize sexuality
	if dynslave['temper'] > 2: daily_bonus['temper'] += 1 &! emphasize temper, effect shared with hoofed_boots (pony gear) - ImperatorAugustus
	dynslave['st_plus'] += 2 &! as elegant as high_heels
}

