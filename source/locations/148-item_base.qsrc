		if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
			$place = 'study'
			$picture_type = 'dynslave_picture'
			npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 가죽 족쇄 착용을 거부한다. 그래도 강제로 착용시킬까?'
			$yes = {
				if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
					dynamic $slave_fights_back
				else
					dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
					dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
				end
			}
			$no = {
				if $dynslave['gloves'] = 'leather_straps':
					$dynslave['gloves'] = 'пусто' &! empty
					dynslave_inventory['leather_straps'] += 1
				end
				if $dynslave['boots'] = 'leather_straps':
					$dynslave['boots'] = 'пусто' &! empty
					dynslave_inventory['leather_straps'] += 1
				end
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			}
			gt 'choice_screen'
		end
	end
	dynslave['deprivation_attitude_revealed'] = max(1, dynslave['deprivation_attitude_revealed']) &! always reveals trait when worn - ImperatorAugustus
	if dynslave['deprivation_attitude'] = 2:
		! deprivation attitude 2 = loves helplessness - ImperatorAugustus
		worn_bonus['mood_rate'] += 5
		if master_style >= 3: daily_bonus['arousal'] += 1
	elseif dynslave['deprivation_attitude'] = -1:
		! deprivation attitude -1 = claustrophobic - ImperatorAugustus
		dynslave['neg_clothes'] = 100
		worn_bonus['mood'] -= 2
		daily_bonus['arousal'] -= 2
	else
		dynslave['neg_clothes'] = 100
		worn_bonus['mood_rate'] -= 5
	end
