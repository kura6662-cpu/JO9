	if dynslave['exhibitionism'] < 0 and $dynslave_psy_status ! 'horny': dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 1 & dynslave['exhibitionism_revealed'] = max(1, dynslave['exhibitionism_revealed']) &! body-shy, insufficiently-aroused slaves dislike revealing outfits - ImperatorAugustus
	learn_bonus['sex'] += 3
	dynslave['st_plus'] += 2
}

!['ukata']
! JO9 MOD START J9M2224 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'ukata', '유카타', 20, '<br> 아름다우며 엄숙함을 내뿜는 일본 전통복, 게이샤 옷으로도 불린다. 명도높고 색채 짙은 소재의 비싼 허리띠가 옷의 청초함을 강조해준다. 이 엄숙한 옷차림은, 어떤 특권층과의 공식 석상에도 어울린다.<br><br>  수사학 교육효율 Up, 무용술 교육효율 소폭up 세련됨 +2 독특함 +2', 'scene\item\item_ukata'
