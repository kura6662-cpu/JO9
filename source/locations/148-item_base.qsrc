!['laced_underwear']
! JO9 MOD START J9M2228 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'laced_underwear', '명주 속옷', 5, '<br> 요염한 명주 속옷 세트. 브라, 팬티, 가벼운 코르셋과 가터벨트로, 어떤 여자든 갖고싶게 만든다. 노예로 눈요기도 하고, 거친 밤도 만들어 주세요!<br><br>  매일 흥분도Up, 성 교육효율Up, 세련됨 +1', 'scene\item\item_laced_underwear'
! JO9 MOD END J9M2228

