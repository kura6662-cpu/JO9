	if dynslave['calisthenics_affinity'] > 0: dynslave['pos_clothes'] = 100 &! affinity finds the outfit comfortable, but wearing it does not reveal the trait - ImperatorAugustus
	learn_bonus['calisthenics'] += 3
	learn_bonus['sex'] += 1
	dynslave['ex_plus'] += 3
	dynslave['st_plus'] += 2
}

!['leather_corset']
! JO9 MOD START J9M2222 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'leather_corset', '코르셋 치마', 50, '<br> 금속 매무새의 이 딱딱한 코르셋은, 가슴과 성기를 드러내고 있다. 가벼운 바람 만으로도, 노출된 성감대를 자극하여 주인을 갈구할 것이다! 거기에, 모든 성교육을 더욱 집중하게 해준다. 아름답고, 자극적이며, 행동적으로!<br><br>  일정 이상 충성시 매일 흥분도Up, 성 교육효율 대폭Up, 세련됨 +2', 'scene\item\item_corset'
