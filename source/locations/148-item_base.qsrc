			}
			gt 'choice_screen'
		end
	end
	! body-shy, insufficiently-aroused slaves dislike revealing outfits (leather corset, emphasize the breasts) - ImperatorAugustus
	if dynslave['exhibitionism'] < 0 and $dynslave_psy_status ! 'horny': dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 1 & dynslave['exhibitionism_revealed'] = max(1, dynslave['exhibitionism_revealed'])
	! slaves who love helplessness feel better when tied up while those inured to it are less unaffected and those who are afraid of it feel worse
