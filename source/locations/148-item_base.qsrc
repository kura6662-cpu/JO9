!['petsuit']
! JO9 MOD START J9M2176 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'petsuit', '동물 구속복', 25, '<br> 시야와 귀를 완전히 차단하지는 않는 구속복 착용자를 고양이나 개처럼 행동하게 만든다. 팔꿈치와 무릎 네 부위로만 걸어야 한다.<br><br>  매일 사육Up, 태도 좋아짐, 애완녀 교육효율 대폭Up 그외 일반기술Dn, 독특함 +1, 세련됨 -2', 'scene\item\item_petsuit'
! JO9 MOD END J9M2176

$item_property['petsuit'] = {
	! these conditions must be kept in sync with next_day pet_rule evaluation to avoid interrupting next_day processing with an equip refusal
	if dynslave['pride'] >= 2 and dynslave['pet_affinity'] = 0 and dynslave['pet'] < 3 and dynslave['deprivation_attitude'] <= 0:
		if dynslave_state = CONST_INT['slave_exist'] and rebell[$dynslave_psy_status] > 0 and dynslave['obedience'] < 0 and dynslave['beaten_ever'] = 0 and dynslave['domini_dictum'] = 0:
			$place = 'study'
			$picture_type = 'dynslave_picture'
			npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 펫수트 착용을 거부한다. 그래도 강제로 착용시킬까?'
			$yes = {
				if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
					dynamic $slave_fights_back
				else
					dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
					dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
				end
			}
			$no = {
				$dynslave['cloth'] = 'голая' &! naked
				dynslave_inventory['petsuit'] += 1
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			}
			gt 'choice_screen'
		end
	end
	dynslave['deprivation_attitude_revealed'] = max(1, dynslave['deprivation_attitude_revealed']) &! always reveals trait when worn - ImperatorAugustus
	if dynslave['deprivation_attitude'] = 2:
		worn_bonus['mood'] += 1
	else
		dynslave['neg_clothes'] = 100
		worn_bonus['mood'] -= 1 - dynslave['deprivation_attitude'] &! less restrictive than pet suit (1 for inured, -1 for claustrophobic)
		daily_bonus['ego'] -= 1 &! like behave pet rule - ImperatorAugustus
	end
	daily_bonus['pride']        -= 1 &! being forced to act like an animal is degrading - ImperatorAugustus
	daily_bonus['instinct']     += 2 &! restraints induce taming (less than deprivation suit) - ImperatorAugustus
	learn_bonus['pet']          += 3 &! act like a cat or dog (best in slot, anal tail gives +2) - ImperatorAugustus
	! interferes with lessons
	learn_bonus['service']      -= 10
	learn_bonus['cook']         -= 10
	learn_bonus['secretary']    -= 10
	learn_bonus['expression']   -= 10
	learn_bonus['nurse']        -= 10
	learn_bonus['alchemy']      -= 10
	learn_bonus['enchanter']    -= 10
	learn_bonus['stamina']      -= 10
	learn_bonus['gladiatrix']   -= 10
	learn_bonus['calisthenics'] -= 10
	learn_bonus['music']        -= 10
	learn_bonus['art']          -= 10
	learn_bonus['dressage']     -= 10
	learn_bonus['cowSK']        -= 10
	dynslave['st_plus'] = -2
	dynslave['ex_plus'] = 1
}

!['deprivation_suit']
dynamic $ib_cycle, 'deprivation_suit', '구속복', 50, '<br> 복장으로 불리지만 그런 류로 입는게 아니라, 철저한 구속을 위한 것이다. 두툼한 고무 외피와 튼튼한 가죽 끈으로 움직임을 막아 버리고, 계속 착복 자세를 유지하는 압력을 가한다. 눈, 귀, 입은 완전히 틀어막혀 착용자를 세상과 단절시킨다. - 사육 특대폭up, 기분 dn, 모든 일반교육 초특대폭dn', 'scene\item\item_dsuit'

