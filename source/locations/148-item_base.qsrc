# #item_base
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2251 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '#item_base': gs 'snk_room_bridge', 'guard', '#item_base'
! JO9 MOD END J9M2251
!ITEM DATABASE
![0]
$item_name[0] = '-' &! DO NOT MODIFY THIS
item_price[0] = 0
!item_size[0] = 0 &! CURRENTLY UNUSED
$item_description[0] = ''
$item_demo[0] = ''

$item_property[0] = {}
$item_property_off[0] = {}

!EXAMPLE OF AN ITEM DEFINITION
!['']
!$item_name[''] = ''
!item_price[''] = 0
!$item_description[''] = ''
!$item_demo[''] = 'scene\item\item_'
!
!$item_property[''] = {
	!dynslave_rate['nothing'] += 1
	!learn_bonus['skill'] += 1
	!example_item_is_worn = 1
!}
!
!$item_property_off[''] = {
	!example_item_is_worn = 0
!}

$recalc_equipment_bonuses = {
	!this function expects to be called with dynamic $replace($recalc_equipment_bonuses, 'dynslave', 'an actual slave variable')
	!currently used in $newloc via #static_base (for style, exotic and moodlet), next_day and $moodlets_account (for daily_bonus) and interaction (for learn_bonus)
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted

		dynslave['st_plus'] = 0 &! reset count from zero (items that confer a style bonus)
		dynslave['ex_plus'] = 0 &! reset count from zero (items that confer an exoticism bonus)
		dynslave['neg_clothes'] = 0 &! reset in case no longer wearing an item with this effect
		dynslave['pos_clothes'] = 0 &! reset in case no longer wearing an item with this effect
		dynslave['slave_collar'] = 0 &! reset in case no longer wearing an item with this effect
		dynslave['wig'] = 0 &! reset in case no longer wearing an item with this effect
		killvar 'learn_bonus'
		killvar 'daily_bonus'
		killvar 'worn_bonus'
		! use $replace to generalize the $item_property effects - ImperatorAugustus
		dynamic $replace($item_property[$dynslave['armor']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['headband']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['earrings']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['tongue']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['cloth']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['collar']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['nipplerings']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['gloves']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['ring_left']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['ring_right']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['navel']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['clitring']], 'dyn'+'slave', 'dynslave')
		dynamic $replace($item_property[$dynslave['boots']], 'dyn'+'slave', 'dynslave')
		if $args[0] ! 'ignore gifts':
			if dynslave_inventory['plaid'] > 0: dynamic $replace($item_property['plaid'], 'dyn'+'slave', 'dynslave')
			if dynslave_inventory['stuffed_toy'] > 0: dynamic $replace($item_property['stuffed_toy'], 'dyn'+'slave', 'dynslave')
			if dynslave_inventory['perfume'] > 0: dynamic $replace($item_property['perfume'], 'dyn'+'slave', 'dynslave')
			if dynslave_inventory['pony'] > 0: dynamic $replace($item_property['pony'], 'dyn'+'slave', 'dynslave')
		end
		! neg_clothes is intended as a display-only moodlet, to indicate via "how do you feel?" that some item(s) worn by the slave have negative impact - ImperatorAugustus
		if dynslave['neg_clothes'] > 0: worn_bonus['mood'] += 1 &! reverse the -1 mood for a negative moodlet that is applied by $recalc_slave_mood in #static_base
		! items setting neg_clothes should apply negative worn_bonus['mood'] or worn_bonus['mood_rate'] adjustments of the appropriate magnitude
		! in contrast, pos_clothes applies +1 mood (not stacking from multiple items); however, it does not contribute to raising mood above Hopeful (capped in $recalc_slave_mood in #static_base)
		if dynslave['pos_clothes'] > 0 and (dynslave['neg_clothes'] > 0 or $dynslave['cloth'] = 'голая' or $dynslave['cloth'] = 'пусто'): dynslave['pos_clothes'] = -100 & worn_bonus['mood'] += 1
		! this suppresses contradictory moodlet text if pos_clothes is active at the same time as neg_clothes or when slave is naked, but still elevates mood
		! setting pos_clothes to -100 signals $recalc_slave_mood to skip the moodlet and also to apply a -1 adjustment if total mood exceeds Hopeful

	end
}

!TODO: replace price hardcode in the description to a variable
!replacement for item copypaste, by Lyazar
$ib_cycle = {
	$_ib_cycle_name = $args[0]
	$item_name[$_ib_cycle_name] = $args[1]
	item_price[$_ib_cycle_name] = args[2]
	$item_description[$_ib_cycle_name] = $args[3]
	$item_demo[$_ib_cycle_name] = $args[4]

	killvar '$_ib_cycle_name'
}

!example:

!$item_name['голая'] = 'Naked'
!item_price['голая'] = 0
!$item_description['голая'] = '   Your slave is completely naked.'
!$item_demo['голая'] = 'scene\'

! replaces to:

!dynamic $ib_cycle, 'голая', 'Naked', 0, '   Your slave is completely naked.', 'scene\'
!-----replacement for item copypaste, by Lyazar-----

