!['vaginal_balls']
dynamic $ib_cycle, 'vaginal_balls', '바기나 비즈', 5, '<br> 손잡이가 달려있는 두 개의 이어진 구슬, 질속에 장시간 삽입 가능하게 설계되었다. 괄약근과 감도 개발에 아주 좋은 물건이다.', 'scene\item\item_vaginal_balls'

$item_property['vaginal_balls'] = {
}

!['anal_plug']
dynamic $ib_cycle, 'anal_plug', '애널 플러그', 20, '<br> 일반적인 똥꼬 마개와 달리 홈을 갖고 있어, 돌리면 항문을 확장시킨다. 홈엔 작은 자물쇠가 있고 열쇠 없이 마개를 제거할 수 없다.', 'scene\item\item_toys'

$item_property['anal_plug'] = {}

!['secure_gag']
dynamic $ib_cycle, 'secure_gag', '견고한 재갈', 20, '<br> 개구기와 말굴레의 강점만 빼내어 만든 인상깊은 철제 도구. 열쇠 없이는 탈착 불가능하며 입크기를 최대로 고정시킨다.', 'scene\item\item_secure_gag'

$item_property['secure_gag'] = {
}

!['chastity belt']
dynamic $ib_cycle, 'chastity_belt', '정조대', 30, '<br> 가죽과 철로 구성된 착용형 정조대 질구엔 열쇠 소지자를 제외한, 누구 좆도 얼씬할 수 없다.', 'scene\item\item_chastity_belt'

$item_property['chastity_belt'] = {
}

!['pissuar_stable']
dynamic $ib_cycle, 'pissuar_stable', '구속 소변기', 100, '<br> 노예 자체를 씀으로써 많은 공간을 요구하지 않는 가구 손, 발, 머리를 위한 충분한 크기의 조임틀이 있다. 입을 위한 개구기와 코마개도 같이 있다. 또, 그릇 딸린 투명한 머리띠를 착용시켜 <u>마실래 박힐래</u> 놀이도 할 수 있다.', 'scene\item\item_pissuar'

$item_property['pissuar_stable'] = {
}

!['toilet_stable']
dynamic $ib_cycle, 'toilet_stable', '구속 대변기', 250, '<br> 꽤나 큰 부피의 가구지만, 그만한 가치가 있다. 튀어나온 머리 부분을 제외하고, 움직임을 완벽히 고정하여 도망을 차단한다. 특별 장치가, 입 안에 이물질 넣는 동안 벌린채로 확실히 고정해준다.', 'scene\item\item_toilet'

$item_property['toilet_stable'] = {
}

!PRESENTS

!Букет ['bouqet']
dynamic $ib_cycle, 'bouqet', '아름다운 꽃다발 (2$)', 2, '<br> 작지만 매우 아름다운 꽃다발. 이것은 수경재배로 길러져 활짝 핀 특별한 꽃다발이다. - 단 하루만 활짝 피고 져버리지만, 꽤 저렴하다.', 'scene\item\item_bouqet'

$item_property['bouqet'] = {}

!Плед ['plaid']
dynamic $ib_cycle, 'plaid', '체크무늬 담요 (9$)', 9, '<br> 탈탄식 격자 무늬의 크고 부드러운 직물. 이 담요를 덮으면 소녀는 편안함을 느끼고 인생의 시련을 더 잘 극복할 수 있을 것이다. 마음만이라도.', 'scene\item\item_plaid'

$item_property['plaid'] = {
	if (dynslave['sleep_condition'] = 0 and 'dynslave' = 'slave') or dynslave['well_rested'] > 0: daily_bonus['angst'] -= 1 &! reduces angst nightly if used during the day or in her bedroll
}

!Мягкая игрушка ['stuffed_toy']
dynamic $ib_cycle, 'stuffed_toy', '봉제 인형 (15$)', 15, '<br> 다소 크고 비싼 이 인형은 좋은 선물이 될 것이다. 또한 문 근처에서 얇은 침낭에서 자는 노예를 따뜻하게 해줄 것이다.', 'scene\item\item_stuffed_toy'

$item_property['stuffed_toy'] = {
	if dynslave['sleep_condition'] = 0 and 'dynslave' = 'slave': daily_bonus['half_action'] -= 1 &! increases energy by a half-star overnight when sleeping on a bedroll
}

!Духи ['perfume']
dynamic $ib_cycle, 'perfume', '고급 향수 (20$)', 20, '<br> 안개를 건너 온 훌륭한 조합으로 만들어진 예쁜 병에 든 향수. 물론, 이런 선물을 마다할 여자는 없다. 그러나 당신의 목적은 두가지다. - 그녀에 대항 보상과, 고객들에게 더 인기 있어지는 것.', 'scene\item\item_perfume'

$item_property['perfume'] = {
	if 'dynslave' ! 'prisoner' and arrpos('$livestock_slave_characters', 'dynslave') = -1: daily_bonus['custom'] += 1 & dynslave['perfume'] = 1
}

!Мини-пони ['pony']
dynamic $ib_cycle, 'pony', '애완 망아지 (50$)', 50, '<br> 이 고양이 크기의 멋진 생명체는 기술 집약소 유전공학의 산물이다. 이들은 수명이 그리 길지 않고, 먹을 수도 없다. 하지만 주인에 대한 충성심이 강하고 사랑스러운 존재다. 당신은 이제 주기적으로 사료비를 내야 한다. (1$/일)', 'scene\item\item_pony'

$item_property['pony'] = {
	dynslave['pos_pony'] = 1
	dynslave['neg_pony_died'] = 0
}
