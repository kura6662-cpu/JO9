	dynslave['neg_clothes'] = 100 & worn_bonus['mood_rate'] -= 5 &! not very comfortable - ImperatorAugustus
	dynslave['st_plus'] += 3 &! same style bonus as wedding dress at half the price - ImperatorAugustus
}

!['wedding_dress']
! JO9 MOD START J9M2220 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'wedding_dress', '웨딩드레스', 100, '<br> 웨딩드레스 보다 뛰어난게 없다. 호화로울 뿐 아니라, 순수함과 행복의 상징이다. 특히나 희생적인 노예에. 모든 여자들이 이걸 입는 꿈을 주체하지 못한다! 거사를 위한 앞트임도 가능하다.<br><br>  일정 이하 태도시 편안함, 일정 이상 충성시 매일 흥분도, 성 교육효율 대폭 up, 세련됨 +3', 'scene\item\item_wedding_dress'
! JO9 MOD END J9M2220

$item_property['wedding_dress'] = {
	if dynslave['pride'] < 3 and rebell[$dynslave_psy_status] <= 0: dynslave['pos_clothes'] = 100
	if min(dynslave['moral'], dynslave['mood'], master_style) >= 3: daily_bonus['moral'] += 1 & daily_bonus['arousal'] += 1 & worn_bonus['mood_rate'] += 5 &! devoted slaves fantasize about being a waifu, further increasing mood by +0.5 while also raising devotion and arousal - ImperatorAugustus
	learn_bonus['sex'] += dynslave['moral'] &! better than corset only with maximum devotion, but the mood bonus helps balance the scale - ImperatorAugustus
	dynslave['st_plus'] += 3 &! same style bonus as gorgeous dress and precious tiara - ImperatorAugustus
}

