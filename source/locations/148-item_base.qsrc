!Raven crown ['raven_crown']
! JO9 MOD START J9M2240 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'raven_crown', '큰까마귀 관', 0, '<br> 이 인공물은 큰까마귀 관이라 제작자 발리오스가 명명했다. 영구적인 아우스펙스를 사용하게 만들며 타인을 꿰뚫어볼 수 있다. 또 아우라의 장악력도 이끌어 내며, 종합정보 열람 및 각종 창에서 등급 확인이 가능해진다.<br><br>  아우스펙스 영구 발동, 장악력 조금 상승', ''
! JO9 MOD END J9M2240

$item_property['raven_crown'] = {
	auspex = 1
	item_supermacy_bonus += 1
	raven_crown_on = 1
}
$item_property_off['raven_crown'] = {
	auspex = 0
	item_supermacy_bonus -= 1
	raven_crown_on = 0
}

