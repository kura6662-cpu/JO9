	if dynslave['exhibitionism'] < 0 and $dynslave_psy_status ! 'horny': dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 1 & dynslave['exhibitionism_revealed'] = max(1, dynslave['exhibitionism_revealed']) &! body-shy, insufficiently-aroused slaves dislike revealing outfits - ImperatorAugustus
	if dynslave['moral'] > 0 and master_style >= 3: daily_bonus['arousal'] += 2
	learn_bonus['sex'] += 4
	dynslave['st_plus'] += 2
}

!['rich_dress']
! JO9 MOD START J9M2221 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'rich_dress', '수려한 의상', 50, '&nbsp- 가격 :50 스파크<br><br> 맞다, 이 의상은 비싸기만 하고 편안하지 않다. 그래도 수려하다! 축복받은 디자이너들이, 누가 입든 우아하고 감각적으로 보이게끔 만들었다.<br><br>  불편함, 세련됨 +3', 'scene\item\item_rich_dress'
! JO9 MOD END J9M2221

