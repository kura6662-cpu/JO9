			$place = 'study'
			$picture_type = 'dynslave_picture'
			npc = 0 & txt = 1 & $text[1] = '  <<$dynslave_name>>는 감각 차단 수트 착용을 거부한다. 그래도 강제로 착용시킬까?'
			$yes = {
				if 'dynslave' = 'slave' and dynslave['gladiatrix'] > max(0, master_supermacy - master_style):
					dynamic $slave_fights_back
				else
					dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'dynslave')
					dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
				end
			}
			$no = {
				$dynslave['cloth'] = 'голая' &! naked
				dynslave_inventory['deprivation_suit'] += 1
				dynslave_stat_screen = 2 & menu_form = 0 & gt iif('dynslave' = 'slave' or 'dynslave' = 'assistant', 'dynslave_stat', $return_lock)
			}
			gt 'choice_screen'
		end
	end
	dynslave['deprivation_attitude_revealed'] = max(1, dynslave['deprivation_attitude_revealed']) &! always reveals trait when worn - ImperatorAugustus
	if dynslave['deprivation_attitude'] = 2:
		worn_bonus['mood'] += 1
	else
		dynslave['neg_clothes'] = 100
		worn_bonus['mood'] -= 2 - dynslave['deprivation_attitude'] &! more restrictive than pet suit (1 for inured, -1 for claustrophobic)
		daily_bonus['temper'] -= 1 &! like behave silence rule - ImperatorAugustus
	end
	daily_bonus['instinct']     += 3 &! restraints induce taming (best in slot) - ImperatorAugustus
	! interferes with lessons
	learn_bonus['pet']          -= 10
	learn_bonus['service']      -= 10
	learn_bonus['cook']         -= 10
	learn_bonus['secretary']    -= 10
	learn_bonus['expression']   -= 10
	learn_bonus['nurse']        -= 10
	learn_bonus['alchemy']      -= 10
	learn_bonus['enchanter']    -= 10
	learn_bonus['stamina']      -= 10
	learn_bonus['gladiatrix']   -= 10
	learn_bonus['calisthenics'] -= 10
	learn_bonus['music']        -= 10
	learn_bonus['art']          -= 10
	learn_bonus['dressage']     -= 10
	learn_bonus['cowSK']        -= 10
	dynslave['st_plus'] = -4
	dynslave['ex_plus'] = 2
}

