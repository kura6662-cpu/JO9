	bull_ring_on = 0
	item_supermacy_bonus -= 1
}

!Оберег ["obereg"]
! JO9 MOD START J9M2236 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'obereg', '오베레그', 0, '<br> 이 독특한 형태의 부적은 전직 검투사 그라쿠스에게 대가로 받은 것이다. 착용자에게 특별한 힘을 주고, 질병으로 부터 보호해 준다. 그리고 아우라 장악력을 증대시킨다.<br><br>  평시: 장악력 조금 상승, 질병면역, 행동력 초과사용시 다음날 체력감소 무효, 리벨리스 영구 발동', ''
! JO9 MOD END J9M2236
$item_property["obereg"] = {
	spell_revelio = 1
    obereg_on = 1
    item_supermacy_bonus += 2
}
$item_property_off["obereg"] = {
	spell_revelio = 0
    obereg_on = 0
    item_supermacy_bonus -= 2
}

!OTHER ITEMS
!['пусто'] EMPTY
dynamic $ib_cycle, 'пусто', '-', 0, '', ''

$item_property['пусто'] = {
}

!ITEMS WORN ON BODY

!['голая'] NAKED
dynamic $ib_cycle, 'голая', '알몸', 0, ' <br> 이미 완전히 벗은 알몸이다.<br><br>  - 부정적인 무들렛, 일정 흥분 이하 기분 dn, 성교육, 체력, 사육 +1, 젖소녀 일정 이상 교육시 부정적인 무들렛 삭제', ''

$item_property['голая'] = {
	if dynslave['pride'] > 2: worn_bonus['mood_rate'] -= dynslave['pride']*3 &! proud slaves dislike being put on display - ImperatorAugustus
	if dynslave['exhibitionism'] < 0 and $dynslave_psy_status ! 'horny': worn_bonus['mood'] -= 1 & dynslave['exhibitionism_revealed'] = max(1, dynslave['exhibitionism_revealed']) &! shy, insufficiently-aroused slaves strongly dislike being naked - stacks with the neg_naked moodlet applied in #static_base that can be suppressed with exhibitionism training (shy trait itself also can be removed with enough training) - ImperatorAugustus
	learn_bonus['sex'] += 1
	learn_bonus['stamina'] += 1
	daily_bonus['instinct'] += 1
}

!Фартук ['apron']
! JO9 MOD START J9M2235 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
dynamic $ib_cycle, 'common_apron', '주름 앞치마', 5, '<br> 앞치마는 주방에서 가장 쓸모있다. 이 앞치마는 다른 옷과 동시 착용하지 않으며, 당신 여자가 주방에서 일하는 동안 여러 기회를 만들어낼 수 있다<br><br>  요리 교육효율 Up,', 'scene\item\item_apron1'
! JO9 MOD END J9M2235

$item_property['common_apron'] = {
	if dynslave['pride'] > 2: dynslave['neg_clothes'] = 100 & worn_bonus['mood_rate'] -= dynslave['pride']*3 &! proud slaves dislike being put on display - ImperatorAugustus
	if dynslave['exhibitionism'] < 0 and $dynslave_psy_status ! 'horny': dynslave['neg_clothes'] = 100 & worn_bonus['mood'] -= 1 & dynslave['exhibitionism_revealed'] = max(1, dynslave['exhibitionism_revealed']) &! body-shy, insufficiently-aroused slaves dislike revealing outfits - ImperatorAugustus
	if dynslave['cook_affinity'] > 0: dynslave['pos_clothes'] = 100 &! affinity finds the outfit comfortable, but wearing it does not reveal the trait - ImperatorAugustus
	learn_bonus['cook'] += 2
