	if dynslave['deprivation_attitude'] = -1: worn_bonus['mood'] -= 1 & dynslave['deprivation_attitude_revealed'] = max(1, dynslave['deprivation_attitude_revealed']) &! Claustrophobic (-1)
	! the effects above can stack with the effects below
