!Старая схема
!반복구매형 npc 리스트
$repeat_npc_id[1] = 'брина_рыжая'
$repeat_npc_id[2] = 'менхантер'
$repeat_npc_id[3] = 'kagami_san'
$repeat_npc_id[4] = 'madame_jofre'
$repeat_npc_id[5] = 'azura'
$repeat_npc_id[6] = 'servilia_quinta'
$repeat_npc_id[7] = 'estelindel'
$repeat_npc_id[8] = 'barman'
$repeat_npc_id[9] = 'uncle_bo'
$repeat_npc_id[10] = 'poison'
$repeat_npc_id[11] = 'moneylender'
$repeat_npc_id[12] = 'лао_ван'
$repeat_npc_id[13] = 'sergant'
$repeat_npc_id[14] = 'vampire_hunter'
$repeat_npc_id[15] = 'egeya'
$repeat_npc_id[16] = 'alina'
$repeat_npc_id[17] = 'valentina1'
$repeat_npc_id[18] = 'valentina2'
$repeat_npc_id[19] = 'Amarida'
$repeat_npc_id[20] = 'penelope'
$repeat_npc_id[21] = 'anes'
$repeat_npc_id[22] = 'ermelinda'
$repeat_npc_id[23] = 'noemi'
$repeat_npc_id[24] = 'Marianna'
$repeat_npc_id[25] = 'kap'
$repeat_npc_id[26] = 'Elisabet_1'
$repeat_npc_id[27] = 'Elisabet_2'
$repeat_npc_id[28] = 'Elisabet_3'
$repeat_npc_id[29] = 'Elisabet_4'
$repeat_npc_id[30] = 'Elisabet_5'

notes_count = 0
n = arrsize('$repeat_npc_id')
i = 0
:loop
	rr = rand (0,10)
	i += 1
	$npc_id = $repeat_npc_id[i]
	fundsup_base = rand (1,25)
	fundsup = fundsup_base * demand_rating[$npc_id]
	npc_money[$npc_id] = common_price[demand_rating[$npc_id]] + fundsup
	if no_slave_count[$npc_id] > 0: no_slave_count[$npc_id] -= 1
	train_slave_count[$npc_id] -= 1
	if no_slave_count[$npc_id] <= 0:
		buy_slave = rand (1,buying_temp[$npc_id])
		if buy_slave = 1:
			no_slave_count[$npc_id] = count_size[$npc_id] + rr
		end
		if buy_slave >= 2 and buy_slave <= 2:
			no_slave_count[$npc_id] = npc_contract_time[$npc_id] + count_size[$npc_id] + rr
			train_slave_count[$npc_id] = 10
		end
	end
	if train_slave_count[$npc_id] > 0 and $train_contract[$npc_id] ! '':
		notes_count += 1
		$guild_board[notes_count] = $train_contract[$npc_id]
		$contractor_id[notes_count] = $npc_id
	end
	if i < n: jump 'loop'
	
npc_money['mistress_angelika'] = 200000
