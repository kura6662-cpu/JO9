# guild_board
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1354 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'guild_board': gs 'snk_room_bridge', 'guard', 'guild_board'
! JO9 MOD END J9M1354
!BILLBOARDS IN SLAVERS GUILD
$place = 'guild_board'
txt_count = notes_count
$text_display = $guild_board[txt]
$text[txt] = ''

! JO9 MOD START J9M1353 | 2026-10-08_persistent_image_cycle, 2026-10-15_z_inline_text_prefix | changed block; context may be included
*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\page_blank.png"></div>')
! JO9_INLINE_TEXT_PREFIX_20261015
local $jo9_leading_empty = $strfind($text[txt], '^(\s|&nbsp;|<[bB][rR]\s*/?>)+')
if $jo9_leading_empty ! '': $text[txt] = $mid($text[txt], len($jo9_leading_empty) + 1, len($text[txt]))
! JO9 MOD END J9M1353
*p '<div id = "text"><<$text[txt]>></div>'
*p '<div id = "bg_blue"><<$text_display>></div>'
*p '<div id = "close_left"><a href = "EXEC: gt ''guild''"><img src = "content\pic\buttons\close_button.png"></a></div>'

if npc = 0:
	$info_bar = ''
	*p '<div id = "side_panel_main"><center><div style="font-size: 40px;"><<$place_name[$place]>></div><<$place_location[$place]>><br>'
	*nl '참고 정보:</center></div>'
	*p '<div id = "side_panel_text"><span class="jo9-reference-body"><<$place_info[$place]>></span><style>.jo9-reference-body,.jo9-reference-body *{font-size:20px !important;}</style></div>'
else
	$info_bar = ''
! JO9 MOD START J9M1352 | 2026-10-08_persistent_image_cycle | changed block; context may be included
	if nsfw = 0 and $npc_image[$npc_id] ! '': *p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\characters\<<$npc_image[$npc_id]>>.png"></div>')
! JO9 MOD END J9M1352
	*p '<div id = "side_panel_main"><center><div style="font-size: 40px;"><<$npc_name[$npc_id]>></div><<$npc_status[$npc_id]>><br>'
	*nl ':</center></div>'
	*p '<div id = "side_panel_text"><<$npc_attitude[npc_attitude[$npc_id]]>>'
	*nl '<span class="jo9-reference-body"><<$npc_info[$npc_id]>></span><style>.jo9-reference-body,.jo9-reference-body *{font-size:20px !important;}</style></div>'
end

if slave_state = CONST_INT['no_slave'] and contract['time'] = 0:
	*p '<div id = "evaluate"><a href = "EXEC: interaction_city = 900 & gt ''interaction_city''"><img src="content\pic\buttons\evaluate.png"></a></div>'
else
	*p '<div id = "evaluate"><img src="content\pic\buttons\deny.png"></div>'
end

if txt > 1:
	addobj '<img src = "content\pic\buttons\back_button.png">'
else
	addobj '<img src = "content\pic\buttons\noback_button.png">'
end
addobj '<img src = "content\pic\buttons\forward_button.png">'

------------ guild_board ------------
