# interaction_screen_city
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1346 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'interaction_screen_city': gs 'snk_room_bridge', 'guard', 'interaction_screen_city'
! JO9 MOD END J9M1346
! TODO: rework the way multiple images are shown one after the other

gs '_layout'
if $special_action[txt] ! '':
	dynamic $special_action[txt]
end

! JO9_SALON_SINGLE_PAGES_20261012
if $place = 'erosalon' and interaction_city = 102024:
	$service_picture = ''
	$bg_path = ''
	if $special_image[1] = 'scene\VIP\VIP3.png': $special_image[1] = 'scene\VIP\salononeg01.png'
	if $special_image[2] = 'scene\VIP\VIP3.png': $special_image[2] = 'scene\VIP\salononeg02.png'
end

! JO9_SALON_GROUP_PAGES_20261012
if $place = 'erosalon' and interaction_city = 102025:
	$service_picture = ''
	$bg_path = ''
	if $special_image[1] = 'scene\VIP\VIP3.png': $special_image[1] = 'scene\VIP\salongroup01.png'
	if $special_image[2] = 'scene\VIP\VIP3.png': $special_image[2] = 'scene\VIP\salongroup02.png'
end

if not_safe = 1:
	not_safe = 0
! JO9 MOD START J9M1345 | 2026-10-08_persistent_image_cycle | changed block; context may be included
	*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\empty.png"></div>')
! JO9 MOD END J9M1345
elseif $bg[$place] ! '':
! JO9 MOD START J9M1344 | 2026-10-08_persistent_image_cycle | changed block; context may be included
	*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\<<$bg[$place]>>.png"></div>')
! JO9 MOD END J9M1344
end

if $special_image_full[txt] ! '':
! JO9 MOD START J9M1343 | 2026-10-08_persistent_image_cycle | changed block; context may be included
	if nsfw = 0: *p func('interior_change', 'jo9_html', '<div id = "bg"><img src="<<$special_image_full[txt]>>"></div>')
! JO9 MOD END J9M1343
elseif $special_image[txt] ! '':
! JO9 MOD START J9M1342 | 2026-10-08_persistent_image_cycle | changed block; context may be included
	if nsfw = 0: *p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\<<$special_image[txt]>>"></div>')
! JO9 MOD END J9M1342
end

! JO9 MOD START J9M1341 | 2026-10-08_persistent_image_cycle | changed block; context may be included
if $place = 'computer' and nsfw = 1: *p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\empty.png"></div>')
! JO9 MOD END J9M1341

! JO9 MOD START J9M1340 | 2026-10-15_z_inline_text_prefix | changed block; context may be included
! JO9_INLINE_TEXT_PREFIX_20261015
local $jo9_leading_empty = $strfind($text[txt], '^(\s|&nbsp;|<[bB][rR]\s*/?>)+')
if $jo9_leading_empty ! '': $text[txt] = $mid($text[txt], len($jo9_leading_empty) + 1, len($text[txt]))
! JO9 MOD END J9M1340
*p '<div id = "text"><<$text[txt]>></div>'

if $picture_type = 'pic_png':
	if $bg_path ! '': 
		! show the image and reset the variable to empty string. this way it will not override any of the special_image images
		! that might need to show after it. 
! JO9 MOD START J9M1339 | 2026-10-08_persistent_image_cycle | changed block; context may be included
		*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\<<$bg_path>>.png"></div>')
! JO9 MOD END J9M1339
		$bg_path = ''
	end
end

if $picture_type = 'unique':
! JO9 MOD START J9M1338 | 2026-10-08_persistent_image_cycle | changed block; context may be included
	if $bg_path ! '': *p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\<<$bg_path>>.png"></div>')
! JO9 MOD END J9M1338
end

if $picture_type = 'untyped':
	if nsfw = 0 and $bg_path ! '': 
! JO9 MOD START J9M1337 | 2026-10-08_persistent_image_cycle | changed block; context may be included
		*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="<<$bg_path>>"></div>')
! JO9 MOD END J9M1337
		$bg_path = ''
	end
end
if ($interaction_type = 'drop_to_farid' and txt = 2) or interaction_city = 61120 or interaction_city = 61121:
	npc = 0
	jump 'first_point'
end

if $interaction_type = 'sell_milk_cow':
	$info_bar = '' 
	if nsfw = 1:
! JO9 MOD START J9M1336 | 2026-10-08_persistent_image_cycle | changed block; context may be included
		*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\empty.png"></div>')
! JO9 MOD END J9M1336
		else
! JO9 MOD START J9M1335 | 2026-10-08_persistent_image_cycle | changed block; context may be included
		*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\characters\jarik_small.png"></div>')
! JO9 MOD END J9M1335
	end

	*p '<div id = "side_panel_main"><center><div style="font-size: 40px;"><<$npc_name[$npc_id]>></div><<$npc_status[$npc_id]>><br>'
	*nl '참고 정보:</center></div>'

	*p '<div id = "side_panel_text"><<$npc_attitude[npc_attitude[$npc_id]]>>'
	*nl '<<$csell_tuto>></div>'
	jump 'second_point'
end

if npc = 0:
	$info_bar = ''
	*p '<div id = "side_panel_main"><center><div style="font-size: 40px;"><<$place_name[$place]>></div><<$place_location[$place]>><br>'
	*nl '참고 정보:</center></div>'
	*p '<div id = "side_panel_text"><span class="jo9-reference-body"><<$place_info[$place]>></span><style>.jo9-reference-body,.jo9-reference-body *{font-size:20px !important;}</style></div>'
else
	$info_bar = ''
	if nsfw = 1:
! JO9 MOD START J9M1334 | 2026-10-08_persistent_image_cycle | changed block; context may be included
		*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\empty.png"></div>')
! JO9 MOD END J9M1334
	elseif $npc_image[$npc_id] ! '':
! JO9 MOD START J9M1333 | 2026-10-08_persistent_image_cycle | changed block; context may be included
		*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\characters\<<$npc_image[$npc_id]>>.png"></div>')
! JO9 MOD END J9M1333
	end
	*p '<div id = "side_panel_main"><center><div style="font-size: 40px;"><<$npc_name[$npc_id]>></div><<$npc_status[$npc_id]>><br>'
	*nl '참고 정보:</center></div>'

	*p '<div id = "side_panel_text"><<$npc_attitude[npc_attitude[$npc_id]]>>'
	*nl '<span class="jo9-reference-body"><<$npc_info[$npc_id]>></span><style>.jo9-reference-body,.jo9-reference-body *{font-size:20px !important;}</style></div>'
end

jump 'second_point'
:first_point
!수정작업
gs '$stock_traits'
! JO9 MOD START J9M1332 | 2026-10-10_restore_ui_format_after_dialogue_normalization | changed block; context may be included
$for_inter_screen_city = '<br>	 속성정보<br><div style="line-height:25%">
</div><font style="font-size:12px;"> 외모		</font><<$beauty[stock["beauty"]]>>
<font style="font-size:12px;"> 체력	</font><<$stamina[stock["stamina"]]>>
<font style="font-size:12px;"> 감수성	</font><<$sensitivity[stock["sensitivity"]]>>
<a style="line-height:25%"><br></a><font style="font-size:12px;"> 성격		</font>	<<$temper[stock["temper"]]>>
<font style="font-size:12px;"> 지성		</font><<$intellect[stock["intellect"]]>>
<font style="font-size:12px;"> 자아	</font><<$ego[stock["ego"]]>><br><a style="line-height:25%">
</a><font style="font-size:12px;"> 태도	</font><<$pride[stock["pride"]]>>
<font style="font-size:12px;"> 독특함	</font><<$exotic[stock["exotic"]]>>
<font style="font-size:12px;"> 체형	</font><<$fat[stock["fat"]]>><br><a style="line-height:25%">
</a><font style="font-size:12px;"> 화려함	</font><<$style[stock["style"]]>><br></a>'
! JO9 MOD END J9M1332

if $master_head_gear = 'raven_crown':
$for_inter_screen_city += '<br><font style="color:#000000">노예의 특성</font><a style="line-height:25%"><br>
</a><<$ucase($mid($stock_boobs2_txt[stock["boobs"]],1,1))+mid($stock_boobs2_txt[stock["boobs"]],2)>><a style="line-height:25%"><br></a><<$stock_features_list>>'
	gs '$slave_price', 'stock'
	$info_bar = '노예 등급: <<$rating[rating]>><br>연 령 대: <<$slave_age_name[stock["age"]]>><br></a>'
	$info_bar += '<<$for_inter_screen_city>>'
else
	$info_bar = '<<$for_inter_screen_city>>'
end

if $interaction_type ! 'hunting_trophy': $special_image[3] = '<<$stock["fullimage"]>>.png'
if interaction_city = 61120 or interaction_city = 61121:
	$stock_attrib_list = $info_bar
	$info_bar = ''
end

:second_point

*p '<div id = "interaction_stat_bar"><<$info_bar>></div>'

if sound_on = 1 and $play_sound[txt] ! '': play 'content\snd\<<$play_sound[txt]>>.wav', sound_volume
if $play_sound[txt] ! '': $play_sound[txt] = ''

if txt > 1:
	addobj '<img src = "content\pic\buttons\back_button.png">'
else
	addobj '<img src = "content\pic\buttons\noback_button.png">'
end
addobj '<img src = "content\pic\buttons\forward_button.png">'

------------ interaction_screen_city ------------
