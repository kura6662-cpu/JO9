	if city_form ! 1000: *p '<div id="options_icon" class="tooltip-bottom" tooltip-data="게임 설정"><a href = "EXEC: prev_city_form = city_form & city_form = 1000 & gt ''city_menu_form''"><img src="content\pic\ui\grimdark\buttons\gear.png"></a></div>'
