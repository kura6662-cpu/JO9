if city_form ! 1000 and city_form < 2000:
	if sound_on = 1:
		*p '<div id = "back_home"><a class="tooltip-left-up" tooltip-data="집으로 가기" href = "EXEC: menu_form = 0 & city_form = estate_location[$estate] & gs ''$city_random_event'', ''home'' & play ''content/snd/door.wav'' & is_home = 1 & gt ''menu_form''"><img src="content\pic\buttons\home_button.png"></a></div>'
	else
		*p '<div id = "back_home"><a class="tooltip-left-up" tooltip-data="집으로 가기" href = "EXEC: menu_form = 0 & city_form = estate_location[$estate] & gs ''$city_random_event'', ''home'' & is_home = 1 & gt ''menu_form''"><img src="content\pic\buttons\home_button.png"></a></div>'
	end
end

