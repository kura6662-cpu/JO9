		skill_sum += dynslave['cook']
		if dynslave['cook'] >= 5: max_skill += 1
		skill_sum += dynslave['gladiatrix']
		if dynslave['gladiatrix'] >= 5: max_skill += 1
		skill_sum += dynslave['alchemy']
		if dynslave['alchemy'] >= 5: max_skill += 1
		skill_sum += dynslave['enchanter']
		if dynslave['enchanter'] >= 5: max_skill += 1
		skill_sum += dynslave['art']
		if dynslave['art'] >= 5: max_skill += 1
		skill_sum += dynslave['music']
		if dynslave['music'] >= 5: max_skill += 1
		skill_sum += dynslave['calisthenics']
		if dynslave['calisthenics'] >= 5: max_skill += 1
		skill_sum += dynslave['secretary']
		if dynslave['secretary'] >= 5: max_skill += 1

