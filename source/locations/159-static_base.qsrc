			rating = 0 &! F-
		elseif attribute_sum < 8  or ( is_stock = 0 and (skill_sum < 10                                                         or dynslave['obedience'] < 5) ):
			rating = 1 &! D-
		elseif attribute_sum < 10 or ( is_stock = 0 and (skill_sum < 15 or dynslave['sex_sum'] < 2                              or dynslave['obedience'] < 6) )                            or (dynslave['beauty'] < 2 and dynslave['fame'] < 2):
			rating = 2 &! D+
		elseif attribute_sum < 12 or ( is_stock = 0 and (skill_sum < 18 or dynslave['sex_sum'] < 4                                  or dynslave['moral'] < 1 or dynslave['stamina'] < 3) ):
			rating = 3 &! C-
