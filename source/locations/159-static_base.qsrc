		if len($dynslave_features_list) > 666: $dynslave_features_list = '<font size="2"><<$dynslave_features_list>></font>'
		
	end &! end of slave conscious/fainted check
}

$equip_set_manager = {
	if dynslave_state > CONST_INT['no_slave']:

		if $args[0] = 'save':
			if $args[1] ! '':
				$dynslave['equip_set'] = $args[1]
				$args[0] = 'view'
			else
				$dynslave['equip_set'] = $trim(input ('현재 장비 세트의 이름을 입력해라 (기존 세트 이름을 입력하면 덮어쓴다)'))
				$args[0] = 'list'
			end
			if $equip_set_name[$dynslave['equip_set']] = '' and arrsize('$equip_set_name') >= 18:
				msg '이미 기억한 장비 세트를 하나 잊어버리기 전까지는 장비 세트를 더 만들 수 없다'
			elseif $trim($dynslave['equip_set']) ! '':
				$equip_set_name[$dynslave['equip_set']] = $dynslave['equip_set']
				$equip_set_cloth[$dynslave['equip_set']] = $dynslave['cloth']
				$equip_set_headband[$dynslave['equip_set']] = $dynslave['headband']
				$equip_set_collar[$dynslave['equip_set']] = $dynslave['collar']
				$equip_set_gloves[$dynslave['equip_set']] = $dynslave['gloves']
				$equip_set_boots[$dynslave['equip_set']] = $dynslave['boots']
				$equip_set_ring_left[$dynslave['equip_set']] = $dynslave['ring_left']
				$equip_set_ring_right[$dynslave['equip_set']] = $dynslave['ring_right']
				$equip_set_earrings[$dynslave['equip_set']] = $dynslave['earrings']
				$equip_set_tongue[$dynslave['equip_set']] = $dynslave['tongue']
				$equip_set_nipplerings[$dynslave['equip_set']] = $dynslave['nipplerings']
				$equip_set_navel[$dynslave['equip_set']] = $dynslave['navel']
				$equip_set_clitring[$dynslave['equip_set']] = $dynslave['clitring']
			end
		end

		if $args[0] = 'equip':
			$args[0] = 'list'
			!keep below in sync with item_change.qsrc
			if is_home = 0 and $return_lock ! 'none':
				$return_lock = 'menu_form'
				menu_form = 0
				gs '$city_random_event', 'home' &! check for an event when returning home - ImperatorAugustus
				dynamic $home_sounds &! before is_home = 1
				is_home = 1
			end
			$dynslave['equip_set'] = $args[1]
			if 			 inventory[$equip_set_cloth[$dynslave['equip_set']]]       > 0  or $equip_set_cloth[$dynslave['equip_set']] = 'голая'       or _ 
				dynslave_inventory[$equip_set_cloth[$dynslave['equip_set']]]       > 0:			$new_item = $equip_set_cloth[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 24, 44) & $return_lock = 'none' & gs 'item_change'
			if 			 inventory[$equip_set_headband[$dynslave['equip_set']]]    > 0  or $equip_set_headband[$dynslave['equip_set']] = 'пусто'    or _ 
				dynslave_inventory[$equip_set_headband[$dynslave['equip_set']]]    > 0:			$new_item = $equip_set_headband[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 25, 45) & $return_lock = 'none' & gs 'item_change'
			if 			 inventory[$equip_set_collar[$dynslave['equip_set']]]      > 0  or $equip_set_collar[$dynslave['equip_set']] = 'пусто'      or _ 
				dynslave_inventory[$equip_set_collar[$dynslave['equip_set']]]      > 0:			$new_item = $equip_set_collar[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 27, 47) & $return_lock = 'none' & gs 'item_change'
			if 			 inventory[$equip_set_gloves[$dynslave['equip_set']]]      > 0  or $equip_set_gloves[$dynslave['equip_set']] = 'пусто'      or _ 
				dynslave_inventory[$equip_set_gloves[$dynslave['equip_set']]]      > 0:			$new_item = $equip_set_gloves[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 28, 48) & $return_lock = 'none' & gs 'item_change'
			if 			 inventory[$equip_set_boots[$dynslave['equip_set']]]       > 0  or $equip_set_boots[$dynslave['equip_set']] = 'пусто'       or _ 
				dynslave_inventory[$equip_set_boots[$dynslave['equip_set']]]       > 0:			$new_item = $equip_set_boots[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 31, 51) & $return_lock = 'none' & gs 'item_change'
			if 			 inventory[$equip_set_ring_left[$dynslave['equip_set']]]   > 0  or $equip_set_ring_left[$dynslave['equip_set']] = 'пусто'   or _ 
				dynslave_inventory[$equip_set_ring_left[$dynslave['equip_set']]]   > 0:			$new_item = $equip_set_ring_left[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 32, 52) & $return_lock = 'none' & gs 'item_change'
			if 			 inventory[$equip_set_ring_right[$dynslave['equip_set']]]  > 0  or $equip_set_ring_right[$dynslave['equip_set']] = 'пусто'  or _ 
				dynslave_inventory[$equip_set_ring_right[$dynslave['equip_set']]]  > 0:			$new_item = $equip_set_ring_right[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 33, 53) & $return_lock = 'none' & gs 'item_change'
			if dynslave['ear_piercing'] ! 0 or $equip_set_earrings[$dynslave['equip_set']] = 'incrusted_earrings' or $equip_set_earrings[$dynslave['equip_set']] = 'пусто':
				if 			 inventory[$equip_set_earrings[$dynslave['equip_set']]]    > 1  or $equip_set_earrings[$dynslave['equip_set']] = 'пусто'    or _ 
					dynslave_inventory[$equip_set_earrings[$dynslave['equip_set']]]    > 1:			$new_item = $equip_set_earrings[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 26, 46) & $return_lock = 'none' & gs 'item_change', 2
			end
			if dynslave['tongue_piercing'] ! 0:
				if 			 inventory[$equip_set_tongue[$dynslave['equip_set']]]      > 0  or $equip_set_tongue[$dynslave['equip_set']] = 'пусто'      or _ 
					dynslave_inventory[$equip_set_tongue[$dynslave['equip_set']]]      > 0:			$new_item = $equip_set_tongue[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 35, 55) & $return_lock = 'none' & gs 'item_change'
			end
			if dynslave['nipple_piercing'] ! 0:
				if 			 inventory[$equip_set_nipplerings[$dynslave['equip_set']]] > 1  or $equip_set_nipplerings[$dynslave['equip_set']] = 'пусто' or _ 
					dynslave_inventory[$equip_set_nipplerings[$dynslave['equip_set']]] > 1:			$new_item = $equip_set_nipplerings[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 29, 49) & $return_lock = 'none' & gs 'item_change', 2
			end
			if dynslave['belly_piercing'] ! 0:
				if 			 inventory[$equip_set_navel[$dynslave['equip_set']]]       > 0  or $equip_set_navel[$dynslave['equip_set']] = 'пусто'       or _ 
					dynslave_inventory[$equip_set_navel[$dynslave['equip_set']]]       > 0:			$new_item = $equip_set_navel[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 34, 54) & $return_lock = 'none' & gs 'item_change'
			end
			if dynslave['clit_piercing'] ! 0:
				if 			 inventory[$equip_set_clitring[$dynslave['equip_set']]]    > 0  or $equip_set_clitring[$dynslave['equip_set']] = 'пусто'    or _ 
					dynslave_inventory[$equip_set_clitring[$dynslave['equip_set']]]    > 0:			$new_item = $equip_set_clitring[$dynslave['equip_set']] & slot = iif('dynslave' = 'slave', 30, 50) & $return_lock = 'none' & gs 'item_change'
			end
		end

		if $args[0] = 'forget':
			$args[0] = 'list'
			for i = 0 to arrsize('$equip_set_name'):
				if $equip_set_name[i] = $args[1]:
					killvar '$equip_set_name', i
					killvar '$equip_set_cloth', i
					killvar '$equip_set_headband', i
					killvar '$equip_set_collar', i
					killvar '$equip_set_gloves', i
					killvar '$equip_set_boots', i
					killvar '$equip_set_ring_left', i
					killvar '$equip_set_ring_right', i
					killvar '$equip_set_earrings', i
					killvar '$equip_set_tongue', i
					killvar '$equip_set_nipplerings', i
					killvar '$equip_set_navel', i
					killvar '$equip_set_clitring', i
				end
			end
		end

		if $equip_set_name['Naked'] = '':
			$equip_set_name['Naked']        = '알몸'
			$equip_set_cloth['Naked']       = 'голая' &! naked
			$equip_set_headband['Naked']    = 'пусто' &! empty
			$equip_set_collar['Naked']      = 'пусто' &! empty
			$equip_set_gloves['Naked']      = 'пусто' &! empty
			$equip_set_boots['Naked']       = 'пусто' &! empty
			$equip_set_ring_left['Naked']   = 'пусто' &! empty
			$equip_set_ring_right['Naked']  = 'пусто' &! empty
			$equip_set_earrings['Naked']    = 'пусто' &! empty
			$equip_set_tongue['Naked']      = 'пусто' &! empty
			$equip_set_nipplerings['Naked'] = 'пусто' &! empty
			$equip_set_navel['Naked']       = 'пусто' &! empty
			$equip_set_clitring['Naked']    = 'пусто' &! empty
		end
		
		!장비 프리셋 빈거 생기는거 ㅈ같아서 주석처리함.
		if arrsize('$equip_set_name') = 1:
			!$equip_set_name['Maid']            = '메이드'
			!$equip_set_cloth['Maid']           = 'maid_dress'
			!$equip_set_headband['Maid']        = 'hijab'
			!$equip_set_gloves['Maid']          = 'rubber_gloves'

			!$equip_set_name['Cook']            = '요리사'
			!$equip_set_cloth['Cook']           = 'common_apron'
			!$equip_set_headband['Cook']        = 'plain_headband'
			!$equip_set_gloves['Cook']          = 'rubber_gloves'

			!$equip_set_name['Secretary']       = '비서'
			!$equip_set_cloth['Secretary']      = 'sailor_foku'
			!$equip_set_headband['Secretary']   = 'glasses'

			!$equip_set_name['Elocutionist']    = '화술가'
			!$equip_set_cloth['Elocutionist']   = 'ukata'

			!$equip_set_name['Nurse']           = '간호사'
			!$equip_set_cloth['Nurse']          = 'nurse_dress'
			!$equip_set_gloves['Nurse']         = 'rubber_gloves'

			!$equip_set_name['Enchantress']     = '마법사'
			!$equip_set_cloth['Enchantress']    = 'enchanter_robe'
			!$equip_set_gloves['Enchantress']   = 'leather_gloves'

			!$equip_set_name['Athlete']         = '운동선수'
			!$equip_set_cloth['Athlete']        = 'leotard'
			!$equip_set_boots['Athlete']        = 'sneakers'

			!$equip_set_name['Gladiatrix']      = '여검투사'
			!$equip_set_cloth['Gladiatrix']     = 'chainmail_bikini'
			!$equip_set_collar['Gladiatrix']    = 'spiked_collar'
			!$equip_set_gloves['Gladiatrix']    = 'plastic_bracers'
			!$equip_set_boots['Gladiatrix']     = 'tabi'

			!$equip_set_name['Dancer']          = '무희'
			!$equip_set_cloth['Dancer']         = 'bellydance'
			!$equip_set_boots['Dancer']         = 'pointes'

			!$equip_set_name['Dancer']          = '무희'
			!$equip_set_cloth['Dancer']         = 'bellydance'
			!$equip_set_boots['Dancer']         = 'pointes'

			!$equip_set_name['Pet']             = '애완'
			!$equip_set_cloth['Pet']            = 'anal_tail'
			!$equip_set_headband['Pet']         = 'nekomimi'
			!$equip_set_collar['Pet']           = 'dog_collar'
			!$equip_set_gloves['Pet']           = 'fluffy_gloves'

			!$equip_set_name['Pony']             = '조랑말'
			!$equip_set_cloth['Pony']            = 'anal_tail'
			!$equip_set_headband['Pony']         = 'pony_plume'
			!$equip_set_gloves['Pony']           = 'ponygirl_harness'
			!$equip_set_boots['Pony']            = 'hoofed_boots'

			!$equip_set_name['Cow']              = '젖소'
			!$equip_set_cloth['Cow']             = 'cow_gear'

			!$equip_set_name['Sex']              = '섹스'
			!$equip_set_cloth['Sex']             = 'leather_corset'
			!$equip_set_gloves['Sex']            = 'leather_straps'
			!$equip_set_boots['Sex']             = 'high_boots'
			!$equip_set_nipplerings['Sex']       = 'nipple_chain'

			!$equip_set_name['Taming']           = '조련'
			!$equip_set_cloth['Taming']          = 'deprivation_suit'
			!$equip_set_headband['Taming']       = 'crown_of_thorns'
			!$equip_set_collar['Taming']         = 'steel_collar'
			!$equip_set_gloves['Taming']         = 'leather_straps'
			!$equip_set_boots['Taming']          = 'leather_straps'
			!$equip_set_tongue['Taming']         = 'heavy_gauge_rings'
			!$equip_set_nipplerings['Taming']    = 'nipple_chain'
			!$equip_set_navel['Taming']          = 'heavy_gauge_rings'
			!$equip_set_clitring['Taming']       = 'heavy_gauge_rings'
		end

		if $args[0] = 'view':
			slot = -1 &! allows us to override $equip_choice
			$equip_choice = '<a href="EXEC: dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''list''"><b><u>뒤로 가기</u></b></a>'
			$equip_choice += '<br>세트 보기 "<b><<$args[1]>></b>"'
			$equip_choice += '<br>없는 아이템은 (*)로 표시됩니다.'
			$equip_choice += '<br>점유된 슬롯을 비우려면 클릭하세요.'
			$equip_choice += '<br>현재 장비로 <a href="EXEC: dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''save'', ''<<$args[1]>>''"><b><u>교체</u></b></a>'
			$equip_choice += ''
			$equip_choice += '<br><a href="EXEC: $equip_set_cloth[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">복   장</a>: '       + $item_name[$equip_set_cloth[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_cloth[$args[1]], $dynslave['cloth'])
			if $equip_set_cloth[$args[1]] ! $dynslave['cloth']             and _ 
			   $equip_set_cloth[$args[1]] ! ''                             and _ 
			   $equip_set_cloth[$args[1]] ! 'голая'                        and _ 
			   max(inventory[$equip_set_cloth[$args[1]]], dynslave_inventory[$equip_set_cloth[$args[1]]]) = 0: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_headband[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">머   리</a>: '      + $item_name[$equip_set_headband[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_headband[$args[1]], $dynslave['headband'])
			if $equip_set_headband[$args[1]] ! $dynslave['headband']       and _ 
			   $equip_set_headband[$args[1]] ! ''                          and _ 
			   $equip_set_headband[$args[1]] ! 'пусто'                     and _ 
			   max(inventory[$equip_set_headband[$args[1]]], dynslave_inventory[$equip_set_headband[$args[1]]]) = 0: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_collar[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">목 걸 이</a>: '          + $item_name[$equip_set_collar[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_collar[$args[1]], $dynslave['collar'])
			if $equip_set_collar[$args[1]] ! $dynslave['collar']           and _ 
			   $equip_set_collar[$args[1]] ! ''                            and _ 
			   $equip_set_collar[$args[1]] ! 'пусто'                       and _ 
			   max(inventory[$equip_set_collar[$args[1]]], dynslave_inventory[$equip_set_collar[$args[1]]]) = 0: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_gloves[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">장   갑</a>: '         + $item_name[$equip_set_gloves[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_gloves[$args[1]], $dynslave['gloves'])
			if $equip_set_gloves[$args[1]] ! $dynslave['gloves']           and _ 
			   $equip_set_gloves[$args[1]] ! ''                            and _ 
			   $equip_set_gloves[$args[1]] ! 'пусто'                       and _ 
			   max(inventory[$equip_set_gloves[$args[1]]], dynslave_inventory[$equip_set_gloves[$args[1]]]) = 0: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_boots[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">신   발</a>: '          + $item_name[$equip_set_boots[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_boots[$args[1]], $dynslave['boots'])
			if $equip_set_boots[$args[1]] ! $dynslave['boots']             and _ 
			   $equip_set_boots[$args[1]] ! ''                             and _ 
			   $equip_set_boots[$args[1]] ! 'пусто'                        and _ 
			   max(inventory[$equip_set_boots[$args[1]]], dynslave_inventory[$equip_set_boots[$args[1]]]) = 0: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_ring_left[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">반 지 1</a>: '        + $item_name[$equip_set_ring_left[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_ring_left[$args[1]], $dynslave['ring_left'])
			if $equip_set_ring_left[$args[1]] ! $dynslave['ring_left']     and _ 
			   $equip_set_ring_left[$args[1]] ! ''                         and _ 
			   $equip_set_ring_left[$args[1]] ! 'пусто'                    and _ 
			   max(inventory[$equip_set_ring_left[$args[1]]], dynslave_inventory[$equip_set_ring_left[$args[1]]]) = 0: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_ring_right[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">반 지 2</a>: '        + $item_name[$equip_set_ring_right[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_ring_right[$args[1]], $dynslave['ring_right'])
			if $equip_set_ring_right[$args[1]] ! $dynslave['ring_right']   and _ 
			   $equip_set_ring_right[$args[1]] ! ''                        and _ 
			   $equip_set_ring_right[$args[1]] ! 'пусто'                   and _ 
			   max(inventory[$equip_set_ring_right[$args[1]]], dynslave_inventory[$equip_set_ring_right[$args[1]]]) = 0: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_earrings[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">귀 걸 이</a>: '      + $item_name[$equip_set_earrings[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_earrings[$args[1]], $dynslave['earrings'], 2)
			if $equip_set_earrings[$args[1]] ! $dynslave['earrings']       and _ 
			   $equip_set_earrings[$args[1]] ! ''                          and _ 
			   $equip_set_earrings[$args[1]] ! 'пусто'                     and _ 
			   max(inventory[$equip_set_earrings[$args[1]]], dynslave_inventory[$equip_set_earrings[$args[1]]]) < 2: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_tongue[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">혓 바 닥</a>: '        + $item_name[$equip_set_tongue[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_tongue[$args[1]], $dynslave['tongue'])
			if $equip_set_tongue[$args[1]] ! $dynslave['tongue']           and _ 
			   $equip_set_tongue[$args[1]] ! ''                            and _ 
			   $equip_set_tongue[$args[1]] ! 'пусто'                       and _ 
			   max(inventory[$equip_set_tongue[$args[1]]], dynslave_inventory[$equip_set_tongue[$args[1]]]) = 0: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_nipplerings[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">젖 꼭 지</a>: '       + $item_name[$equip_set_nipplerings[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_nipplerings[$args[1]], $dynslave['nipplerings'], 2)
			if $equip_set_nipplerings[$args[1]] ! $dynslave['nipplerings'] and _ 
			   $equip_set_nipplerings[$args[1]] ! ''                       and _ 
			   $equip_set_nipplerings[$args[1]] ! 'пусто'                  and _ 
			   max(inventory[$equip_set_nipplerings[$args[1]]], dynslave_inventory[$equip_set_nipplerings[$args[1]]]) < 2: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_navel[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">배   꼽</a>: '         + $item_name[$equip_set_navel[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_navel[$args[1]], $dynslave['navel'])
			if $equip_set_navel[$args[1]] ! $dynslave['navel']             and _ 
			   $equip_set_navel[$args[1]] ! ''                             and _ 
			   $equip_set_navel[$args[1]] ! 'пусто'                        and _ 
			   max(inventory[$equip_set_navel[$args[1]]], dynslave_inventory[$equip_set_navel[$args[1]]]) = 0: $equip_choice += ' (*)'
			$equip_choice += '<br><a href="EXEC: $equip_set_clitring[''<<$args[1]>>''] = &quot;&quot; & dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$args[1]>>''">음   핵</a>: '      + $item_name[$equip_set_clitring[$args[1]]] + dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $equip_set_clitring[$args[1]], $dynslave['clitring'])
			if $equip_set_clitring[$args[1]] ! $dynslave['clitring']       and _ 
			   $equip_set_clitring[$args[1]] ! ''                          and _ 
			   $equip_set_clitring[$args[1]] ! 'пусто'                     and _ 
			   max(inventory[$equip_set_clitring[$args[1]]], dynslave_inventory[$equip_set_clitring[$args[1]]]) = 0: $equip_choice += ' (*)'
		end

		if $args[0] = 'list' or $args[0] = '':
			slot = -1 &! allows us to override $equip_choice
			$equip_choice = '<a href="EXEC: dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''save''"><b><u>현재 장비 저장</u></b></a>'
			for i = 0 to arrsize('$equip_set_name'):
				if $equip_set_name[i] ! '':
					$equip_choice += '<br><a href="EXEC: dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''equip'',  ''<<$equip_set_name[i]>>''"><b><u>장착</u></b></a>'
					$equip_choice +=   ', <a href="EXEC: dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''view'',  ''<<$equip_set_name[i]>>''"><b><u>보기</u></b></a>'
					$equip_choice += ' 또는 <a href="EXEC: dynamic $replace($equip_set_manager, ''dyn''+''slave'', ''dynslave''), ''forget'', ''<<$equip_set_name[i]>>''"><b><u>잊기</u></b></a>'
					$equip_choice += ' "<<$equip_set_name[i]>>"'
				end
			end
		end

		dynamic $show_item_description_and_image, ''
		
		dynslave_stat_screen = 2
		$return_lock = 'dynslave_stat'
		gt 'dynslave_stat'

	end
}

------------ #static_base ------------
