		attribute_sum = dynslave['stamina']
		attribute_sum += dynslave['sensitivity']
		attribute_sum += dynslave['temper']
		attribute_sum += dynslave['intellect']
		attribute_sum += dynslave['ego']
		attribute_sum -= dynslave['pride']

		!Skill Calculation for Rating
		skill_sum = dynslave['expression']
		if dynslave['expression'] >= 5: max_skill += 1
		skill_sum += dynslave['pet']
		if dynslave['pet'] >= 5: max_skill += 1
		skill_sum += dynslave['dressage']
		if dynslave['dressage'] >= 5: max_skill += 1
		skill_sum += dynslave['cowSK']
		if dynslave['cowSK'] >= 5: max_skill += 1
		skill_sum += dynslave['nurse']
		if dynslave['nurse'] >= 5: max_skill += 1
		skill_sum += dynslave['service']
