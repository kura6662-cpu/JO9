		dynslave['sex_sum'] = dynslave['oral']
		if dynslave['oral'] >= 5: max_sex += 1
		dynslave['sex_sum'] += dynslave['penetration']
		if dynslave['penetration'] >= 5: max_sex += 1
		dynslave['sex_sum'] += dynslave['petting']
		if dynslave['petting'] >= 5: max_sex += 1
		dynslave['sex_sum'] += dynslave['orgy']
		if dynslave['orgy'] >= 5: max_sex += 1
		dynslave['sex_sum'] += dynslave['xenophily']
		if dynslave['xenophily'] >= 5: max_sex += 1
		dynslave['sex_sum'] += dynslave['fetishism']
		if dynslave['fetishism'] >= 5: max_sex += 1
		dynslave['sex_sum'] += dynslave['roleplay']
		if dynslave['roleplay'] >= 5: max_sex += 1
		dynslave['sex_sum'] += dynslave['lesbiansex']
		if dynslave['lesbiansex'] >= 5: max_sex += 1
