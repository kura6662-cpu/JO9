		if dynslave['pregnant'] > 0 and dynslave['pregnant_revealed'] = 1 and dynslave['vaginal_modification'] ! 4 and dynslave['fertility'] = 0:
			msg '<<$경고>><center><<$dynslave_name>>(이)가 지난 며칠간 아프고 생리도 하지 않았다.<br><br>아무래도 임신한 모양이다!<center>'
			dynslave['pregnant_revealed'] = 2
			if dynslave['fertility_revealed'] = 0: dynslave['fertility_revealed'] = 1
		end

	end &! end of slave conscious/fainted check
}

$update_slave_features_list = {
	if dynslave_state > CONST_INT['no_slave']:

		!Slave Traits
! JO9 MOD START COG_DISPLAY | 2026-10-16_innate_learning_traits
		$dynslave_features_list = ''
  ! jo9_learning_trait: 1 천재, -1 백치, 0 일반. 선천 특성은 보유 즉시 표시한다.
  if dynslave['jo9_learning_trait'] = 1: $dynslave_features_list += '<a href="EXEC: msg $jo9_genius_text"><<dyneval($vb_cycle_skill, 5, "천재")>></a><br>'
  if dynslave['jo9_learning_trait'] = -1: $dynslave_features_list += '<a href="EXEC: msg $jo9_idiot_text"><<dyneval($vb_cycle_skill, 0, "백치")>></a><br>'
! JO9 MOD END COG_DISPLAY
! JO9 MOD START TRAITS_DISPLAY_DYNSLAVE_COG_DISPLAY | 2026-10-17_traits_batch
 $dynslave_features_list += $func('jo9_traits', 'list', 'dynslave')
! JO9 MOD END TRAITS_DISPLAY_DYNSLAVE_COG_DISPLAY
		sanity = dynslave['ego'] + dynslave['temper'] + dynslave['pride']
		if sanity < 3:
			$dynslave_features_list += '<a style = "color: #cd0000;" href="EXEC: msg $sanity_broken">정신분열</a><br>'
		elseif sanity < 5:
			$dynslave_features_list += '<a style = "color: #EA0090;" href="EXEC: msg $sanity_low">신경 쇠약</a><br>'
		end
		if dynslave['brand'] = 0:   $dynslave_features_list += '<a href = "EXEC: msg $Нет_клейма"><<dyneval($vb_cycle_skill, 0, "상표 없음")>></a><br>'
		if dynslave['wounds'] > 0:  $dynslave_features_list += '<a href="EXEC: msg $wounds_chart"><<$wounds[dynslave[''wounds'']]>></a><br>'
		if dynslave['scars'] > 0:   $dynslave_features_list += '<a href="EXEC: msg $scars_chart"><<$scars[dynslave[''scars'']]>></a><br>'
		if dynslave['bruises'] > 0: $dynslave_features_list += '<a href="EXEC: msg $bruises_chart"><<$bruises[dynslave[''bruises'']]>></a><br>'
		if cheat_no_starve = 0 and (master_medic >= 4 or iif('dynslave' = 'cow', farmhand['nurse'], assistant['nurse']) >= 4):
			if dynslave['days_without_food'] = 0 and dynslave['neg_hungry'] > 0:
