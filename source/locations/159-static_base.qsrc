			rating = 5 &! B-
		elseif attribute_sum < 15 or ( is_stock = 0 and (skill_sum < 24 or dynslave['sex_sum'] < 15 or max_skill < 3 or max_sex < 2 or dynslave['moral'] < 4) )                            or (dynslave['beauty'] < 4 and dynslave['fame'] < 4):
			rating = 6 &! B+
		elseif attribute_sum < 16 or ( is_stock = 0 and (skill_sum < 26 or dynslave['sex_sum'] < 18) ):
			rating = 7 &! A-
		elseif attribute_sum < 18 or ( is_stock = 0 and (skill_sum < 28 or dynslave['sex_sum'] < 20 or max_skill < 4 or max_sex < 3 or dynslave['moral'] < 5) )                            or (dynslave['beauty'] < 5 and dynslave['fame'] < 5):
			rating = 8 &! A+
		elseif attribute_sum < 20 or ( is_stock = 0 and (skill_sum < 30 or dynslave['sex_sum'] < 25 or max_skill < 5 or max_sex < 4) ):
			rating = 9 &! S-
		else
			rating = 10 &! S+
		end

		!Rating adjustments
		if rating < 0: rating = 0
		if rating > 10: rating = 10

		!ImperatorAugustus: Adjust price based on actual rating, from 20% at F- (or stock) to full value at S+
		!Provides a reason to train slaves acquired from patrolling the Border of the Fogs (previously the sale price for an F- slave with excellent stats could exceed 800 sparks)
		!Provides a reason to train high-potential slaves to the highest tier for sale by auction
		if rating = 0 or is_stock = 1:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 20/100) &! F-
		elseif rating = 1:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 25/100) &! D-
		elseif rating = 2:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 30/100) &! D+
		elseif rating = 3:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 40/100) &! C-
		elseif rating = 4:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 45/100) &! C+
		elseif rating = 5:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 50/100) &! B-
		elseif rating = 6:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 55/100) &! B+
		elseif rating = 7:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 70/100) &! A-
		elseif rating = 8:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 75/100) &! A+
		elseif rating = 9:
			slaveprice = max(30, (meat_price*3)/2, slaveprice * 90/100) &! S-
		end

		killvar 'is_stock'

		!Populate rating tooltip info - crushboss
		$rating_help = '<center><u>해야 할 일:</u></center><div style=''font-size: 90%;''>'

		if rating = 0:
	!F-
			if dynslave['beauty'] < 1 and dynslave['fame'] < 1: $rating_help += '필요 외모 또는 인지도<br>'
			if dynslave['obedience'] < 1: $rating_help += '더 높은 복종심<br>'
			if skill_sum < 5: $rating_help += '더 높은 일반기술 등급<br>'
			if attribute_sum < 6: $rating_help += '더 높은 <a href=''EXEC: msg $атрибуты_справка''>기틀 속성</a><br>'
			if dynslave['stamina'] < 2: $rating_help += '체력<br>'
		elseif rating = 1:
	!D-
			if dynslave['obedience'] < 5: $rating_help += '더 높은 복종심<br>'
			if skill_sum < 10: $rating_help += '더 높은 일반기술 등급<br>'
			if attribute_sum < 8: $rating_help += '더 높은 <a href=''EXEC: msg $атрибуты_справка''>기틀 속성</a><br>'
		elseif rating = 2:
	!D+
			if dynslave['beauty'] < 2 and dynslave['fame'] < 2: $rating_help += '필요 외모 또는 인지도<br>'
			if dynslave['obedience'] < 6: $rating_help += '더 높은 복종심<br>'
			if dynslave['sex_sum'] < 2: $rating_help += '더 높은 성애기술 등급<br>'
			if skill_sum < 15: $rating_help += '더 높은 일반기술 등급<br>'
			if attribute_sum < 10: $rating_help += '더 높은 <a href=''EXEC: msg $атрибуты_справка''>기틀 속성</a><br>'
		elseif rating = 3:
	!C-
			if dynslave['stamina'] < 3: $rating_help += '체력<br>'
			if dynslave['sex_sum'] < 4: $rating_help += '더 높은 성애기술 등급<br>'
			if skill_sum < 18: $rating_help += '더 높은 일반기술 등급<br>'
			if attribute_sum < 12: $rating_help += '더 높은 <a href=''EXEC: msg $атрибуты_справка''>기틀 속성</a><br>'
			if dynslave['moral'] < 1: $rating_help += '강한 충성심<br>'
		elseif rating = 4:
	!C+
			if dynslave['beauty'] < 3 and dynslave['fame'] < 3: $rating_help += '필요 외모 또는 인지도<br>'
			if dynslave['sex_sum'] < 8: $rating_help += '더 높은 성애기술 등급<br>'
			if skill_sum < 20: $rating_help += '더 높은 일반기술 등급<br>'
			if attribute_sum < 13: $rating_help += '더 높은 <a href=''EXEC: msg $атрибуты_справка''>기틀 속성</a><br>'
			if dynslave['moral'] < 2: $rating_help += '더 강한 충성심<br>'
			if max_skill < 2: $rating_help += '최상급 일반기술 2 종<br>'
			if max_sex < 1: $rating_help += '최상급 성애기술 1 종<br>'
