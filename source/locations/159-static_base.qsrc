			if dynslave['sex_sum'] < 10: $rating_help += '더 높은 성애기술 등급<br>'
			if skill_sum < 22: $rating_help += '더 높은 일반기술 등급<br>'
			if attribute_sum < 14: $rating_help += '더 높은 <a href=''EXEC: msg $атрибуты_справка''>기틀 속성</a><br>'
			if dynslave['moral'] < 3: $rating_help += '더 강한 충성심<br>'
		elseif rating = 6:
	!B+
			if dynslave['beauty'] < 4 and dynslave['fame'] < 4: $rating_help += '필요 외모 또는 인지도<br>'
			if dynslave['sex_sum'] < 15: $rating_help += '더 높은 성애기술 등급<br>'
			if skill_sum < 24: $rating_help += '더 높은 일반 기술 등급<br>'
			if attribute_sum < 15: $rating_help += '더 높은 <a href=''EXEC: msg $атрибуты_справка''>기틀 속성</a><br>'
			if dynslave['moral'] < 4: $rating_help += '더 강한 충성심<br>'
			if max_skill < 3: $rating_help += '최상급 일반기술 3 종<br>'
			if max_sex < 2: $rating_help += '최상급 성애기술 2 종<br>'
		elseif rating = 7:
