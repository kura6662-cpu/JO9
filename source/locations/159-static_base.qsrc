!!!!!utility function to append sequentially number-indexed elements from a source array to a target array
! for example, assume a[0] = 5, a[1] = 10, arrsize('a') = 2, b[0] = 15, b[1] = 20: after appending 'b' to 'a', a[2] will be 20 and a[3] will be 25)
! syntax: dynamic $array_append, '$target_array', '$source_array', [# start index in source array], [# number of elements to copy: arrsize($source_array) - start index by default]
! unlike copyarr which copies both the numeric and string form of an array, if you want to append 'b' to 'a' and '$b' to '$a' with this function, you must call it twice
$array_append = {
	$array_append_target_array = $args[0]
	$array_append_source_array = $args[1]
	array_append_num_to_copy = args[3]
	array_append_iterator = args[2]
	if (array_append_num_to_copy <= 0): array_append_num_to_copy = arrsize($array_append_source_array) - array_append_iterator
	if array_append_iterator < array_append_num_to_copy:
		:array_append_loop
			dynamic "<<$array_append_target_array>>[] = <<$array_append_source_array>>[<<array_append_iterator>>]"
			array_append_iterator += 1
		if array_append_iterator < array_append_num_to_copy: jump 'array_append_loop'
	end
	killvar '$array_append_target_array'
	killvar '$array_append_source_array'
	killvar 'array_append_num_to_copy'
	killvar 'array_append_iterator'
}

