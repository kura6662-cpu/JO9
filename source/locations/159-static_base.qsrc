!!!!!utility function to loop through a list of slave types and run a specified dynamic function on each of them
! the dynamic function code can use dynslave as a generic slave variable/prefix, which will be replaced by each value from the list
! example usage:  dynamic $do_for_each_slave_in_list, '$next_day_forgotten_rewards', '$unfrozen_slave_characters' &! all except iced
!  will run dynamic $replace($next_day_forgotten_rewards, 'dynslave', 'slave'), dynamic $replace($next_day_forgotten_rewards, 'dynslave', 'assistant'), etc.
$do_for_each_slave_in_list = {
	!uncomment next line for troubleshooting
	if debug = 1: msg "$do_for_each_slave_in_list '<<$args[0]>>', '<<$args[1]>>'"
	do_for_each_slave_in_list_count = arrsize($args[1])
	if do_for_each_slave_in_list_count > 0:
		do_for_each_slave_in_list_index = 0
		:do_for_each_slave_in_list_loop
			dynamic "
				dynamic $replace(<<$args[0]>>, 'dynslave', <<$args[1]>>[do_for_each_slave_in_list_index]), <<$args[1]>>[do_for_each_slave_in_list_index] &! replace dynslave and pass as $args[0]
			"
			do_for_each_slave_in_list_index += 1
		if do_for_each_slave_in_list_index < do_for_each_slave_in_list_count: jump 'do_for_each_slave_in_list_loop'
	end
}


!!!!! define "object classes" with groups of associated "variables" and "methods" that can be initialized, cleared, updated, and swapped with equivalent groups of variables with a common instance name (e.g., slave, iced_2)
!killvar '$archetypes'
!$archetypes[] = 'playable'
!$archetypes[] = 'place'
!$archetypes[] = 'item'
!$archetypes[] = 'npc'

!killvar '$playable_types'
!$playable_types[] = 'master' &! "inherits" from playable
!$playable_types[] = 'slave' &! "inherits" from playable

!! lists of associated variables ('instance' in the names will be substituted with a unique name for each instance of the object)
!! here we are listing discrete variables (not individual properties/fields/indices) that collectively represent a single unique instance of an object type
!! discrete variables should be minimized in favor of properties on instance variables, because copyarr and killall make it easy to rename or clear arrays
!! however, here are some good reasons to use discrete variables:
!! 1. to represent child arrays (inventory, for example) because QSP does not support nested arrays (multiple dimensions or arrays of arrays)
!! 2. for performance (storing frequently-accessed data in a separate var avoids searching through a long array of strings for a given index)

killvar '$playable_vars'
$playable_vars[] = 'instance'            &! e.g., 'master' or 'slave'
$playable_vars[] = 'instance_state'      &! e.g., 'master_state' or 'slave_state'                                       &! number var, frequently accessed
$playable_vars[] = '$instance_name'      &! e.g., '$master_name' or '$slave_name'                                       &! string var, frequently accessed
$playable_vars[] = '$instance_ava'       &! e.g., '$master_ava' or '$slave_ava'                                         &! string var, frequently accessed

$playable_vars[] = 'instance_type'       &! e.g., 'master_type' or 'slave_type'                                         &! number var, not frequently accessed, make this a property
$playable_vars[] = 'instance_rate'       &! e.g., 'master_rate' or 'slave_rate'                                         &! array var, each string index corresponds to an attribute, with a number as the value
$playable_vars[] = 'instance_inventory'  &! e.g., 'master_inventory' or 'slave_inventory'                               &! array var, each string index corresponds to an item type, with a count as the value

killvar '$master_vars'
copyarr '$master_vars', '$playable_vars' &! $master_vars inherits from $playable_vars

$masters_vars[] = 'instance_mood'                     &! 'master_mood' array var, each string index corresponds to a moodlet name, with a number as the value (remaining duration)

killvar '$slave_vars'
copyarr '$slave_vars', '$playable_vars' &! $slave_vars inherits from $playable_vars

$slave_vars[] = '$instance_psy_basic'                 &! TODO: not an array type, make this a property
$slave_vars[] = '$instance_psy_status'                &! TODO: not an array type, make this a property
$slave_vars[] = '$instance_world'                     &! TODO: not an array type, make this a property
$slave_vars[] = '$instance_world_description'         &! TODO: not an array type, make this a property
$slave_vars[] = '$instance_family'                    &! TODO: not an array type, make this a property
$slave_vars[] = '$instance_family_description'        &! TODO: not an array type, make this a property
$slave_vars[] = '$instance_occupation'                &! TODO: not an array type, make this a property
$slave_vars[] = '$instance_occupation_description'    &! TODO: not an array type, make this a property

$slave_vars[] = 'instance_already_done_today'         &! instance-specific version of already_done_today    &! array var, each index corresponds to an interaction id, with a count as the value
$slave_vars[] = 'instance_already_done_total'         &! replaced 'already_done_curslave'                   &! array var, each index corresponds to an interaction id, with a count as the value
$slave_vars[] = 'instance_already_done_recent'        &! new in 2.2                                         &! array var, each index corresponds to an interaction id, with a count as the value
$slave_vars[] = 'instance_already_sex_today'          &! replaced 'today_sex_curslave'                      &! array var, each index corresponds to an interaction id, with a count as the value
$slave_vars[] = 'instance_already_sex_total'          &! replaced 'already_sex_curslave'                    &! array var, each index corresponds to an interaction id, with a count as the value

$slave_vars[] = 'interaction_instance'                &! per-slave-instance reset-for-each-interaction keys &! array var, each string index corresponds to a "key" name, with an integer value
$slave_vars[] = '$instance_scene_tag'                &!고유씬이미지태그 tag for print unique-scene-images of mod-characters
$slave_vars[] = '$instance_dohna_tag'                &!도나도나 캐릭터

!swap two slave instances together with all associated variables
!call with: dynamic $swap_slave_instances, 'instance1', 'instance2'  where each instance is e.g., 'slave', 'iced_1', 'prisoner', 'farmhand', etc.

$swap_slave_instances = {
	_counter = arrsize('$slave_vars')
	:_swap_slave_instance_loop
		_counter -= 1
		$from_var = $replace($slave_vars[_counter], 'instance', $args[0])
		$to_var = $replace($slave_vars[_counter], 'instance', $args[1])
		! from -> _temp
		killvar '_temp'
		copyarr '_temp', $from_var
		! to   -> from
		killvar $from_var
		copyarr $from_var, $to_var
		! temp -> to
		killvar $to_var
		copyarr $to_var, '_temp'
	if _counter > 0: jump '_swap_slave_instance_loop'

	killvar '$from_var'
	killvar '$to_var'
	killvar '_temp'
	killvar '_counter'

	! update strings that may contain if statements or subexpressions referring to these slave instances
	dynamic $replace($update_slave_features_list, 'dyn'+'slave', $args[0])
	dynamic $replace($update_slave_features_list, 'dyn'+'slave', $args[1])
	gs '#var_base'
	gs '#txt_man'   &! after #var_base
	gs '#txt_2_man' &! after #var_base
}

$clear_slave_instance = {
	_counter = arrsize('$slave_vars')
	:_clear_slave_instance_loop
		_counter -= 1
		killvar $replace($slave_vars[_counter], 'instance', $args[0])
	if _counter > 0: jump '_clear_slave_instance_loop'
	killvar '_counter'

	dynamic "
		$<<$args[0]>>['wpn'] = 'безоружный' &! fists
		$<<$args[0]>>['right_wpn'] = 'безоружный' &! fists
		$<<$args[0]>>['left_wpn'] = 'безоружный' &! fists
		$<<$args[0]>>['armor'] = 'без_брони' &! without armor
		$<<$args[0]>>['cloth'] = 'голая' &! naked
	"
	
	! update strings that may contain if statements or subexpressions referring to the cleared slave instance

!	if hero_choice > 100: gs '#var_base_woman'
	
	gs '#var_base'
	gs '#txt_man'   &! after #var_base
	gs '#txt_2_man' &! after #var_base
!	if hero_choice > 100: gs '#txt_woman' &! after #var_base
!	if hero_choice > 100: gs '#txt_2_woman' &! after #var_base
end
end
}


!!!!! core game function to refresh characteristics (attributes, skills) from associated rate counters and enforce upper and lower bounds - called by $newloc and generate_stock
$dyn_calc_slave_attrs = {
	if dynslave_state > CONST_INT['no_slave']:

		!Continuous field dependence (primary value is computed from rate variable, which represents continuous -- i.e., complete -- range of primary value)
		!Temporary rate will be added/subtracted (e.g., dynslave_rate['temp_beauty'], dynslave_rate['temp_exotic'], dynslave_rate['temp_style'])
		i = 0
		n = arrsize('$cont_atr')
		:slave_cont_loop
			if dynslave_rate[$cont_atr[i]] < cont_atr_min: dynslave_rate[$cont_atr[i]] = cont_atr_min &! zero is lower bound for rate
			if dynslave_rate[$cont_atr[i]] > cont_atr_max: dynslave_rate[$cont_atr[i]] = cont_atr_max &! 200 is upper bound for rate
			rate = dynslave_rate[$cont_atr[i]] + dynslave_rate['temp_' + $cont_atr[i]]
			dynslave[$cont_atr[i]] = 0
			if rate >= cont_atr_threshold[1]: dynslave[$cont_atr[i]] = 1
			if rate >= cont_atr_threshold[2]: dynslave[$cont_atr[i]] = 2
			if rate >= cont_atr_threshold[3]: dynslave[$cont_atr[i]] = 3
			if rate >= cont_atr_threshold[4]: dynslave[$cont_atr[i]] = 4
			if rate >= cont_atr_threshold[5]: dynslave[$cont_atr[i]] = 5
			i += 1
		if i < n: jump 'slave_cont_loop'

		! Linked stats - high physique (fat) imposes a cap on endurance (stamina)
		if dynslave['fat'] > 3 and dynslave['stamina'] >= 4: dynslave['stamina'] = 4 & dynslave_rate['stamina'] = min(dynslave_rate['stamina'], 0)

		!Discrete, field independence (stats - range and interpretation of rate variable depends on current primary value)
		i = 0
		n = arrsize('$indep_atr')
		:slave_independent_loop
			!ImperatorAugustus: enforce [0,5] range for primary value
			if dynslave[$indep_atr[i]] < 0: dynslave[$indep_atr[i]] = 0
			if dynslave[$indep_atr[i]] > 5: dynslave[$indep_atr[i]] = 5
			rate = dynslave_rate[$indep_atr[i]]
			if dynslave[$indep_atr[i]] = 0:
				if rate <= indep_atr_min_threshold[0]: dynslave_rate[$indep_atr[i]] = indep_atr_min_threshold[0]
				if rate >= indep_atr_max_threshold[0]: dynslave[$indep_atr[i]] += 1 & dynslave_rate[$indep_atr[i]] = 0
			elseif dynslave[$indep_atr[i]] = 1:
				if rate <= indep_atr_min_threshold[1]: dynslave[$indep_atr[i]] -= 1 & dynslave_rate[$indep_atr[i]] = 0
				if rate >= indep_atr_max_threshold[1]: dynslave[$indep_atr[i]] += 1 & dynslave_rate[$indep_atr[i]] = 0
			elseif dynslave[$indep_atr[i]] = 2:
				if rate <= indep_atr_min_threshold[2]: dynslave[$indep_atr[i]] -= 1 & dynslave_rate[$indep_atr[i]] = 0
				if rate >= indep_atr_max_threshold[2]: dynslave[$indep_atr[i]] += 1 & dynslave_rate[$indep_atr[i]] = 0
			elseif dynslave[$indep_atr[i]] = 3:
				if rate <= indep_atr_min_threshold[3]: dynslave[$indep_atr[i]] -= 1 & dynslave_rate[$indep_atr[i]] = 0
				if rate >= indep_atr_max_threshold[3]: dynslave[$indep_atr[i]] += 1 & dynslave_rate[$indep_atr[i]] = 0
			elseif dynslave[$indep_atr[i]] = 4:
				if rate <= indep_atr_min_threshold[4]: dynslave[$indep_atr[i]] -= 1 & dynslave_rate[$indep_atr[i]] = 0
				if rate >= indep_atr_max_threshold[4]: dynslave[$indep_atr[i]] += 1 & dynslave_rate[$indep_atr[i]] = 0
			elseif dynslave[$indep_atr[i]] = 5:
				if rate <= indep_atr_min_threshold[5]: dynslave[$indep_atr[i]] -= 1 & dynslave_rate[$indep_atr[i]] = 0
				if rate >  indep_atr_max_threshold[5]: dynslave_rate[$indep_atr[i]] = indep_atr_max_threshold[5]
			end
			i += 1
		if i < n: jump 'slave_independent_loop'

		!Discrete, field semi-dependence (non-sexual skills - rate threshold for increase or decrease depends on current skill level and whether there is an affinity)
		i = 0
		n = arrsize('$dep_atr')
		:slave_dependent_loop
			!ImperatorAugustus: enforce [0,5] range for primary value
			if dynslave[$dep_atr[i]] < 0: dynslave[$dep_atr[i]] = 0
			if dynslave[$dep_atr[i]] > 5: dynslave[$dep_atr[i]] = 5
			!Rate thresholds required to level skill up or down
			srd1 = 5
			srd2 = 10
			srd3 = 20
			srd4 = 40
			!Check for affinity (zero or negative affinity increases rate threshold required to increase or decrease primary level)
			affinity[$dep_atr[i]] = dynslave[$dep_atr[i]+'_affinity']
			if affinity[$dep_atr[i]] <= 0:
				slave_rm = dynslave[$dep_atr[i]]
				srd1 += slave_rm/2
				srd2 += slave_rm
				srd3 += slave_rm*2
				srd4 += slave_rm*3
			end
			!ImperatorAugustus:  fixed a long-standing bug where assistant was using slave skill affinity instead of assistant skill affinity
			!The main calculation of discrete, semi-dependent (skills)
			rate = dynslave_rate[$dep_atr[i]]
			if dynslave[$dep_atr[i]] = 0:
				if rate < 0:      dynslave[$dep_atr[i]] = 0 & dynslave_rate[$dep_atr[i]] = 0
				if rate >= srd1:  dynslave[$dep_atr[i]] = 1 & dynslave_rate[$dep_atr[i]] = 0
			elseif dynslave[$dep_atr[i]] = 1:
				if rate <= -srd1: dynslave[$dep_atr[i]] = 0 & dynslave_rate[$dep_atr[i]] = 0
				if rate >= srd1:  dynslave[$dep_atr[i]] = 2 & dynslave_rate[$dep_atr[i]] = 0
			elseif dynslave[$dep_atr[i]] = 2:
				if rate <= -srd2: dynslave[$dep_atr[i]] = 1 & dynslave_rate[$dep_atr[i]] = 0
				if rate >= srd2:  dynslave[$dep_atr[i]] = 3 & dynslave_rate[$dep_atr[i]] = 0
			elseif dynslave[$dep_atr[i]] = 3:
				if rate <= -srd3: dynslave[$dep_atr[i]] = 2 & dynslave_rate[$dep_atr[i]] = 0
				if rate >= srd3:  dynslave[$dep_atr[i]] = 4 & dynslave_rate[$dep_atr[i]] = 0
			elseif dynslave[$dep_atr[i]] = 4:
				if rate <= -srd4: dynslave[$dep_atr[i]] = 3 & dynslave_rate[$dep_atr[i]] = 0
				if rate >= srd4:  dynslave[$dep_atr[i]] = 5 & dynslave_rate[$dep_atr[i]] = 0
			elseif dynslave[$dep_atr[i]] = 5:
				if rate < -srd4:  dynslave[$dep_atr[i]] = 4 & dynslave_rate[$dep_atr[i]] = 0
				if rate > 10:     dynslave[$dep_atr[i]] = 5 & dynslave_rate[$dep_atr[i]] = 10
			end
			i += 1
		if i < n: jump 'slave_dependent_loop'

		!Discrete, field semi-dependence (sexual skills - does not use rate thresholds, for now just enforce upper and lower bounds [0,5])
		i = 0
		n = arrsize('$sex_atr')
		:slave_sex_subskill_loop
			if dynslave[$sex_atr[i]] < 0:
				dynslave[$sex_atr[i]] = 0
			elseif dynslave[$sex_atr[i]] > 5:
				dynslave[$sex_atr[i]] = 5
			end
			i += 1
		if i < n: jump 'slave_sex_subskill_loop'

		!Linked sex skills
		dynslave['sub_hug'] = max(dynslave['sub_hug'], min(1, dynslave['sub_paizuri']), min(1, dynslave['sub_vaginal'])) &! rubbing rises to D- if paizuri or vaginal is at least D-
		dynslave['sub_hj'] =  max(dynslave['sub_hj'], min(2, dynslave['petting'])) &! handjob rises to D- and C- together with petting category
		dynslave['sub_fj'] =  max(dynslave['sub_fj'], min(2, dynslave['petting'])) &! footjob rises to D- and C- together with petting category
		dynslave['petting'] = (dynslave['sub_hj'] + dynslave['sub_fj'] + dynslave['sub_hug'] + dynslave['sub_paizuri'])/4

		dynslave['sub_bj'] = max(dynslave['sub_bj'], min(3, max(dynslave['sub_dt'], dynslave['sub_bukkake'] - 2, dynslave['orgy']))) &! blowjob rises up to B+ with deepthroat, bukkake (lagging two levels), group sex
		dynslave['sub_tongue'] = max(dynslave['sub_tongue'], min(3, dynslave['oral'])) &! licking rises to D-, C-, B+ together with oral category
		dynslave['oral'] = (dynslave['sub_kiss'] + dynslave['sub_tongue'] + dynslave['sub_bj'] + dynslave['sub_dt'] + dynslave['sub_asslik'])/5

		dynslave['sub_vaginal'] =  max(dynslave['sub_vaginal'],  min(2, dynslave['sub_fisting'])) &! vaginal rises with vaginal fisting up to C-
		dynslave['sub_anal'] =     max(dynslave['sub_anal'],     min(2, dynslave['anal_stretch'])) &! anal rises with anal fisting up to C-
		dynslave['sub_vaginal'] =  max(dynslave['sub_vaginal'],  min(3, max(dynslave['sub_dp'], dynslave['sub_tp'], dynslave['sub_gangbang']))) &! vaginal rises with group sex up to B+
		dynslave['sub_anal'] =     max(dynslave['sub_anal'],     min(3, max(dynslave['sub_dp'], dynslave['sub_tp'], dynslave['sub_gangbang']))) &! anal rises with group sex up to B+
		dynslave['sub_fisting'] =  max(dynslave['sub_fisting'],  min(2, dynslave['sub_vaginal'])) &! fisting rises to D- and C- together with vaginal
		dynslave['anal_stretch'] = max(dynslave['anal_stretch'], min(2, dynslave['sub_anal'])) &! anal fisting rises to D- and C- together with anal
		dynslave['penetration'] = (dynslave['sub_vaginal'] + dynslave['sub_anal'] + dynslave['sub_fisting'] + dynslave['anal_stretch'])/4

		!Vagina type becoming 'developed' if sub_fisting > 3 - Pianocat (added check for restored hymen and raised threshold - ImperatorAugustus)
! JO9 MOD START J9M2490 | 2026-10-15_zz_meiki_state | changed block; context may be included
		if dynslave['sub_fisting'] > 3 and dynslave['virginity'] = 2: dynslave['virginity'] = 3
		gs 'jo9_meiki_state', 'dynslave', 0
! JO9 MOD END J9M2490

		dynslave['sub_exhibit'] = max(dynslave['sub_exhibit'], min(1, dynslave['sub_humiliation'])) &! exhibitionism rises to D- when humiliation is D- or higher
		dynslave['sub_humiliation'] = max(dynslave['sub_humiliation'], min(1, dynslave['sub_exhibit'])) &! humiliation rises to D- when exhibitionism is D- or higher
		dynslave['sub_dildo'] = max(dynslave['sub_dildo'], iif(dynslave['sub_vaginal'] > 0, 2, 0)) &! dildo skips to C- when vaginal is D- or higher
		dynslave['sub_masturbation'] = max(dynslave['sub_masturbation'], min(1, dynslave['sub_exhibit'] - 2), min(3, dynslave['sub_dildo'])) &! masturbation rises to D- when exhibitionism is B+ or higher and rises with dildo to B+
		dynslave['sub_seduce'] = max(dynslave['sub_seduce'], min(2, dynslave['sub_exhibit'] - 1)) &! seduction rises with exhibitionism up to C- (lagging by 1)
		dynslave['roleplay'] = (dynslave['sub_seduce'] + dynslave['sub_masturbation'] + dynslave['sub_dildo'] + dynslave['sub_exhibit'] + dynslave['sub_humiliation'])/5

		dynslave['sub_mazo'] = max(dynslave['sub_mazo'], min(3, dynslave['sub_selfpain'])) &! masochism rises to D-, C-, B+ with self-torture
		dynslave['sub_selfpain'] = max(dynslave['sub_selfpain'], min(1, dynslave['sub_mazo'])) &! self-torture rises to D- if masochism is at least D-
		dynslave['sub_piss'] = max(dynslave['sub_piss'], min(2, dynslave['sub_kopro'] - 3)) &! golden shower rises with coprophagia, but lags by three levels (not higher than C-)
		dynslave['fetishism'] = (dynslave['sub_enema'] + dynslave['sub_mazo'] + dynslave['sub_selfpain'] + dynslave['sub_piss'] + dynslave['sub_kopro'])/5

		dynslave['sub_tp'] = max(dynslave['sub_tp'], min(3, dynslave['sub_gangbang'])) &! triple penetration rises with gangbang up to B+
		dynslave['sub_dp'] = max(dynslave['sub_dp'], dynslave['sub_tp']) &! double penetration rises with triple penetration and gangbang (implicitly)
		dynslave['sub_bukkake'] = max(dynslave['sub_bukkake'], min(3, dynslave['sub_bj']/3 + dynslave['sub_hj']/3 + dynslave['sub_tongue']/3)) &! bukkake rises when blowjob is B+, handjob is B+, licking is B+, but none of these can raise bukkake above B+ overall
		dynslave['orgy'] = (dynslave['sub_threesome'] + dynslave['sub_dp'] + dynslave['sub_tp'] + dynslave['sub_gangbang'] + dynslave['sub_bukkake'])/5

		dynslave['sub_polypusvermin'] = max(dynslave['sub_polypusvermin'], min(2, dynslave['sub_tentacles'])) &! sea tentacle mating rises with fiend milking up to C- (but not vice versa) - ImperatorAugustus
		dynslave['xenophily'] = (dynslave['sub_arachnidspider'] + dynslave['sub_polypusvermin'] + dynslave['sub_zoosex'] + dynslave['sub_bestiality'] + dynslave['sub_horse'] + dynslave['sub_tentacles'])/6

		dynslave['lesbiansex'] = (dynslave['sub_lesbiansex1'] + dynslave['sub_lesbiansex2'] + dynslave['sub_lesbiansex3'] + dynslave['sub_lesbiansex4'])/4
! JO9 MOD START J9TP_GRADECHECK | 2026-10-17_traits_personality
		gs 'jo9_traits_personality', 'gradecheck', 'dynslave'
! JO9 MOD END J9TP_GRADECHECK



		! JO9 MOD START TBV_GRADE_REFRESH | 2026-10-17_trait_value
		gs 'jo9_traits_value', 'refresh', 'dynslave'
		! JO9 MOD END TBV_GRADE_REFRESH
	end &! end of slave conscious/fainted check
}


$set_obedience_difficulty = {
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted - ImperatorAugustus

		if difficulty_setting = 1:
			!Easy
			if demo_game = 1: skill_adv_mul = 2 &! 2x training speed with easy obedience difficulty unless easy custom game which has a menu option for it (added in 2.3.1) - ImperatorAugustus
			dynslave['obedience_difficulty'] = 2
			slave_obedience_bonus += 4 &! not dynslave is correct here - ImperatorAugustus
			! *_obedience_bonus is used in $newloc, $slave_price and $assistant_rank_stats -ImperatorAugustus
			if overnight_rules_count < 3: overnight_rules_count = 3
			! overnight_rules_count is used only in next_day -ImperatorAugustus
			if dynslave['daily_reward_count'] > 2: dynslave['daily_reward_count'] = 2
			if dynslave['daily_punishment_count'] > 2: dynslave['daily_punishment_count'] = 2
			if dynslave['spoil'] > 3: dynslave['spoil'] = 3 & dynslave_rate['spoil'] = 10
			if dynslave['angst'] > 3: dynslave['angst'] = 3 & dynslave_rate['angst'] = 10
		elseif difficulty_setting = 0:
			!Normal
			if game_difficulty = 2: skill_adv_mul = 1 &! 1x training speed with normal obedience difficulty unless easy custom game which has a menu option for it (added in 2.3.1) - ImperatorAugustus
			dynslave['obedience_difficulty'] = 4
			if overnight_rules_count = 2: overnight_rules_count = 3
			! overnight_rules_count is used only in next_day -ImperatorAugustus
			if dynslave['daily_reward_count'] = 3: dynslave['daily_reward_count'] = 2
			if dynslave['daily_punishment_count'] = 3: dynslave['daily_punishment_count'] = 2
		elseif difficulty_setting = 2:
			!Difficult/Hardcore
			if game_difficulty = 2: skill_adv_mul = 1 &! 1x training speed with hardcore obedience difficulty unless easy custom game which has a menu option for it (added in 2.3.1) - ImperatorAugustus
			! disabled daily obedience increase and fixed obedience difficulty at 14 for 0 devotion, 10 for 1 devotion, 6 for 2 or more devotion - ImperatorAugustus
			! this removes how long you have owned the slave as a factor, and replaces it with an obedience increase at 1 devotion (equivalent to obedience after one decade in the old formula)
			! this tracks with the old formula that reduced obedience difficulty down to a minimum of 6 (see commented code below) so the net gameplay effect is to emphasize devotion vs. time
			dynslave['obedience_difficulty'] = 14 - min(8, 4 * dynslave['moral'])
			!if dynslave['age_count'] = 0: dynslave['obedience_difficulty'] = 14
			!if dynslave['age_count'] = 1: dynslave['obedience_difficulty'] = 13
			!if dynslave['age_count'] = 2: dynslave['obedience_difficulty'] = 12
			!if dynslave['age_count'] = 3: dynslave['obedience_difficulty'] = 11
			!if dynslave['age_count'] = 4: dynslave['obedience_difficulty'] = 10
			!if dynslave['age_count'] = 5: dynslave['obedience_difficulty'] = 9
			!if dynslave['age_count'] = 6: dynslave['obedience_difficulty'] = 8
			!if dynslave['age_count'] = 7: dynslave['obedience_difficulty'] = 7
			!if dynslave['age_count'] >= 8: dynslave['obedience_difficulty'] = 6

			!Obedience difficult daily decrease - crushboss
			!if slave_state = CONST_INT['slave_exist'] and difficulty_setting = 2:
			!	if slave['moral'] > 2 and slave['obedience_difficulty'] > 6: slave['obedience_difficulty'] = 6
			!	if slave['obedience_difficulty'] > 6:
			!		slave['obedience_difficulty'] -= 1
			!	elseif slave['obedience_difficulty'] < 6:
			!		slave['obedience_difficulty'] += 1
			!	end
			!end
		end

	end &! end of conscious/fainted check
}

$update_slave_energy_stars = {
	if dynslave_state > CONST_INT['no_slave']:

		$dynslave_energy_stars = ''
		! if energy exceeds cap and a half star is missing, refill it
		if dynslave['energy'] > dynslave['stamina'] and dynslave['half_action'] = 1: dynslave['half_action'] = 0
		! transfer bonus energy stars (negative half_actions) to normal energy stars
		if dynslave['half_action'] < 0 and dynslave['energy'] < dynslave['stamina']:
			dynslave['energy'] += (-1 * dynslave['half_action']) / 2
			dynslave['half_action'] = dynslave['half_action'] MOD 2 - max(0, dynslave['energy'] - dynslave['stamina'])*2
		end
		! consume spent half actions (positive half_actions)
		:_process_slave_half_actions_loop
			if dynslave['half_action'] > 1: dynslave['half_action'] -= 2 & dynamic $replace($dynamic_energy_drop, 'dyn'+'slave', 'dynslave')
			if dynslave['half_action'] > 1: jump '_process_slave_half_actions_loop'
		! clamp value
		dynslave['energy'] = max(-5, min(dynslave['stamina'], dynslave['energy']))
		! update exhausted moodlet state, which affects the color of energy stars
		if dynslave['energy'] < 0 or dynslave_already_done_today['exertion'] >= dynslave['stamina']:
			dynslave['neg_exhausted'] = 100
		else
			dynslave['neg_exhausted'] = 0
		end
		! assemble row of images corresponding to current energy level and exhaustion status
		if dynslave['energy'] = 0:
			if dynslave['half_action'] = 1:
				$dynslave_energy_stars = '<img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_red_half.png">'
			elseif dynslave['half_action'] = -1:
				$dynslave_energy_stars = iif(dynslave['neg_exhausted'] = 0, '<img src = "content/pic/ui overhaul/energy/energy_green_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_purple_half.png">') + '<img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png">'
			else
				$dynslave_energy_stars = '-'
			end
		else
			if dynslave['energy'] < 0:
				for i = 1 to (5 + dynslave['energy']) step 1: $dynslave_energy_stars += iif(i = (5 + dynslave['energy']) and dynslave['half_action'] = 1, '<img src = "content/pic/ui overhaul/energy/energy_red_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_empty.png">')
				for i = 1 to (-1 * dynslave['energy']) step 1: $dynslave_energy_stars += iif(i = 1 and (dynslave['half_action'] MOD 2) = -1, '<img src = "content/pic/ui overhaul/energy/energy_red_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_red.png">')
			else
				for i = 1 to (dynslave['energy'] + max(0, dynslave['half_action']/-2)) step 1: $dynslave_energy_stars += iif(i = dynslave['energy'] and dynslave['half_action'] = 1, iif(dynslave['neg_exhausted'] = 0, '<img src = "content/pic/ui overhaul/energy/energy_green_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_purple_half.png">'), iif(dynslave['neg_exhausted'] = 0, '<img src = "content/pic/ui overhaul/energy/energy_green.png">', '<img src = "content/pic/ui overhaul/energy/energy_purple.png">'))
				if (dynslave['half_action'] MOD 2) = -1:
					$dynslave_energy_stars += iif(dynslave['neg_exhausted'] = 0, '<img src = "content/pic/ui overhaul/energy/energy_green_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_purple_half.png">')
					if (5 - dynslave['energy'] - max(0, dynslave['half_action']/-2)) > 1: for i = 2 to (5 - dynslave['energy'] - max(0, dynslave['half_action']/-2)) step 1: $dynslave_energy_stars += '<img src = "content/pic/ui overhaul/energy/energy_empty.png">'
				elseif (5 - dynslave['energy'] - max(0, dynslave['half_action']/-2)) > 0:
					for i = 1 to (5 - dynslave['energy'] - max(0, dynslave['half_action']/-2)) step 1: $dynslave_energy_stars += '<img src = "content/pic/ui overhaul/energy/energy_empty.png">'
				end
			end
		end
		! display blue stars for night energy saved up from rest rewards during the day, to be spent at night (rules) or carried over to the next day (amount capped by endurance)
		if dynslave['well_rested'] > 0:
			$dynslave_energy_stars += '&nbsp;'
			for i = 1 to dynslave['well_rested'] step 1: $dynslave_energy_stars += '<img src = "content/pic/ui overhaul/energy/energy_blue.png">'
		end

	end &! end of conscious or fainted state check
}

$recalc_slave_mood = {
	!this dynamic function should be executed with dynamic $replace($recalc_slave_mood, 'dynslave', 'ACTUAL SLAVE VARIABLE NAME')
	!recalculates mood and constructs an array of mood description strings from active moodlets, item mood bonuses and mood rate
	if dynslave_state ! CONST_INT['no_slave']:
		dynslave['mood'] = 0
		killvar '$dynslave_mood_list'
		ndex = 1 &! index into above variable (first moodlet description will be added at index 1)

		if $dynslave_psy_status = 'broken': jump 'recalc_slave_mood_psy_broken' &! mind-broken slaves are always calm - ImperatorAugustus

		! apply worn clothing mood bonuses/penalties ($recalc_equipment_bonuses can change which moodlets are active, so run it first)
		dynamic $replace($recalc_equipment_bonuses, 'dyn'+'slave', 'dynslave') &! split the first to protect from earlier $replace
		dynslave['mood'] += worn_bonus['mood'] &! mood bonus can be positive, negative or zero as sum of all applicable item effects

		!mood rate was being reset every time - changed to re-apply on each refresh and clear in next_day - ImperatorAugustus
		dynslave['mood'] += (dynslave_rate['mood'] + worn_bonus['mood_rate']) / 10 &! note: mood rate can be negative

		n = arrsize('$slave_good_mood')
		i = 0 &! moods start from index 0
		:recalc_slave_mood_loop1
			$curmod = $slave_good_mood[i]
			if dynslave[$curmod] > 0:
				dynamic "$dynslave_mood_list[ndex] = '" + $replace($mood_description[$curmod], 'dyn'+'slave', 'dynslave') + "'" &! evaluate the subexpressions
				dynslave['mood'] += 1
				ndex += 1
			end
			i += 1
		if i < n: jump 'recalc_slave_mood_loop1'

		n = arrsize('$slave_bad_mood')
		i = 0 &! moods start from index 0
		:recalc_slave_mood_loop2
			$curmod = $slave_bad_mood[i]
			if dynslave[$curmod] > 0:
				dynamic "$dynslave_mood_list[ndex] = '" + $replace($mood_description[$curmod], 'dyn'+'slave', 'dynslave') + "'" &! evaluate the subexpressions
				dynslave['mood'] -= 1
				ndex += 1
			end
			i += 1
		if i < n: jump 'recalc_slave_mood_loop2'

		if arrsize('$dynslave_mood_list') < 1:
			!pos_ is the default moodlet
			dynamic "$dynslave_mood_list[1] = '" + $replace($mood_description['pos_'], 'dyn'+'slave', 'dynslave') + "'" &! evaluate the subexpressions
		end

		if dynslave['pos_clothes'] = -100 and dynslave['mood'] > 1: dynslave['mood'] -= 1 &! pos_clothes moodlet does not contribute to raising mood above Hopeful - ImperatorAugustus

		slave_psy_hardness = max (dynslave['ego'], dynslave['temper'], dynslave['spoil'], dynslave['pride']) + dynslave['courage']
		if dynslave['angst'] > dynslave['temper'] and dynslave['mood'] > 0:
			! cap mood at 0 (calm) when angst exceeds temperament
			dynslave['mood'] = 0
! JO9 MOD START J9M2489 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
			$dynslave_mood_list[] = '[<<$dynslave_name>>]<br>&nbsp;너무 절망스러워서 희망이 느껴지지 않아요...</div>'
! JO9 MOD END J9M2489
		elseif dynslave['angst'] > 0 and dynslave['mood'] > (2 - dynslave['angst']/2):
			! cap mood between 0 (calm) and +2 (optimistic) when angst is non-zero but less than or equal to temperament
			dynslave['mood'] = (2 - dynslave['angst']/2)
			if dynslave['neg_angst'] = 0: dynamic "$dynslave_mood_list[] = '" + $replace($mood_description['neg_angst'], 'dyn'+'slave', 'dynslave') + "'" &! evaluate the subexpressions
		elseif dynslave['obedience'] < slave_psy_hardness and dynslave['mood'] > 2:
			! cap mood at +2 if obedience is less than slave_psy_hardness (when fear is zero, devotion is non-zero, but obedience is still low)
			dynslave['mood'] = 2
! JO9 MOD START J9M2488 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
			if dynslave['neg_fear'] = 0: $dynslave_mood_list[] = '[<<$dynslave_name>>]<br>&nbsp;지금 이 순간도 공포가 내 머릿속을 휘젓는 것 같아요...</div>'
! JO9 MOD END J9M2488
		elseif dynslave['fear'] >= dynslave['moral'] and dynslave['mood'] > 3:
			! cap mood at +3 (pleased) if fear matches or exceeds devotion (including when both are zero)
			! fear is not mitigated by masochism or abuse attitude because fear reflects anticipation of _effective_ future punishment
			dynslave['mood'] = 3
! JO9 MOD START J9M2487 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
			if dynslave['neg_fear'] = 0: $dynslave_mood_list[] = '[<<$dynslave_name>>]<br>&nbsp;지금 이 순간도 공포가 내 머릿속을 휘젓는 것 같아요...</div>'
! JO9 MOD END J9M2487
		end

		! keep mood within [-5, +5] range
		dynslave['mood'] = max(-5, min(5, dynslave['mood']))

		:recalc_slave_mood_psy_broken
		if $dynslave_psy_status = 'broken':
			!neg_ is the mindbroken moodlet
			$curmod = $replace($mood_description['neg_'], 'dyn'+'slave', 'dynslave') &! split the first to protect from earlier $replace
			dynamic "$dynslave_mood_list[1] = '<<$curmod>>'" &! evaluate the subexpressions
		end
	end
}

! Recalculate assistant moods dynamically
$recalc_assistant_mood = {
    if assistant_state ! CONST_INT['no_assistant']:
        assistant['mood'] = 0
        killvar '$assistant_mood_list'
        ndex = 1 &! index into mood list

        if $assistant_psy_status = 'broken': jump 'recalc_assistant_mood_psy_broken'

        ! apply worn clothing / item bonuses
        dynamic $replace($recalc_equipment_bonuses, 'dynslave', 'assistant')
        assistant['mood'] += worn_bonus['mood']

        assistant['mood'] += (assistant_rate['mood'] + worn_bonus['mood_rate']) / 10

        n = arrsize('$slave_good_mood')
        i = 0
        :recalc_assistant_mood_loop1
            $curmod = $slave_good_mood[i]
            if assistant[$curmod] > 0:
                dynamic "$assistant_mood_list[ndex] = '" + $replace($mood_description[$curmod], 'dynslave', 'assistant') + "'"
                assistant['mood'] += 1
                ndex += 1
            end
            i += 1
        if i < n: jump 'recalc_assistant_mood_loop1'

        n = arrsize('$slave_bad_mood')
        i = 0
        :recalc_assistant_mood_loop2
            $curmod = $slave_bad_mood[i]
            if assistant[$curmod] > 0:
                dynamic "$assistant_mood_list[ndex] = '" + $replace($mood_description[$curmod], 'dynslave', 'assistant') + "'"
                assistant['mood'] -= 1
                ndex += 1
            end
            i += 1
        if i < n: jump 'recalc_assistant_mood_loop2'

        if arrsize('$assistant_mood_list') < 1:
            dynamic "$assistant_mood_list[1] = '" + $replace($mood_description['pos_'], 'dynslave', 'assistant') + "'"
        end

        ! cap mood limits if necessary
        assistant['mood'] = max(-5, min(5, assistant['mood']))

        :recalc_assistant_mood_psy_broken
        if $assistant_psy_status = 'broken':
            $curmod = $replace($mood_description['neg_'], 'dynslave', 'assistant')
            dynamic "$assistant_mood_list[1] = '<<$curmod>>'"
        end
    end
}




$newloc_update_slave = {
	if dynslave_state > CONST_INT['no_slave']:

		!refresh equipment bonuses (here we are interested in style bonuses, exoticism bonuses and moodlets - learn_bonus is handled in interaction and daily_bonus is handled in next_day)
		dynamic $replace($recalc_equipment_bonuses, 'dyn'+'slave', 'dynslave') &! protect from earlier replace, defined in #item_base

		!exotic and style
		if dynslave['age'] = CONST_INT['loli_age']:
			dynslave['epilation'] = 100
			if dynslave['makeup'] = 0 and dynslave['beauty'] > 1: dynslave['makeup'] = 2 &! natural beauty (on par with tattoo makeup)
		end
		!characteristic alignment for slave - crushboss
		if dynslave['ill'] < 0: dynslave['ill'] = 0
		if dynslave['ill'] > 7: dynslave['ill'] = 7
		if dynslave['issues'] < 0: dynslave['issues'] = 0
		if dynslave['issues'] > 5: dynslave['issues'] = 5
		if dynslave['rehabilitation'] < 0: dynslave['rehabilitation'] = 0
		if dynslave['rehabilitation'] > 30: dynslave['rehabilitation'] = 30
		if dynslave['metabolism'] < 1: dynslave['metabolism'] = 1
		if dynslave['metabolism'] > 5: dynslave['metabolism'] = 5

		if dynslave['pregnant'] = 0 and dynslave['parasite'] = 0: dynslave['pregnant_revealed'] = 0

		!check for 'sleep in cells' rule without dungeon and change it to 'sleep on floor' - ImperatorAugustus
		if dynslave['sleep_condition'] = -2 and dungeon = 0: dynslave['sleep_condition'] = -1

		!IMPACTS ON BEAUTY (temp_beauty rate is refreshed constantly)
		dynslave_rate['temp_beauty'] = 0 - cont_atr_threshold[dynslave['scars']] - cont_atr_threshold[dynslave['bruises']]
		if dynslave['fat'] = 0 or dynslave['fat'] = 4: dynslave_rate['temp_beauty'] -= dynslave_rate['beauty'] / 2
		if dynslave['fat'] = 5: dynslave_rate['temp_beauty'] -= (4 * dynslave_rate['beauty']) / 5

		!IMPACTS ON STYLE (temp style rate is refreshed constantly)
		dynslave_rate['temp_style'] = (dynslave['grace']*cont_atr_threshold[2]) - cont_atr_threshold[dynslave['hygiene']]
		if dynslave['makeup'] > 1: dynslave_rate['temp_style'] += 10
		if dynslave['makeup'] > 0: dynslave_rate['temp_style'] += 10
		if dynslave['makeup'] = 0: dynslave_rate['temp_style'] -= 10
		if dynslave['perfume'] > 0: dynslave_rate['temp_style'] += 20
		if dynslave['perfume'] = 0: dynslave_rate['temp_style'] -= 10
		if dynslave['manicure'] > 0: dynslave_rate['temp_style'] += 10
		if dynslave['manicure'] = 0: dynslave_rate['temp_style'] -= 10
		if dynslave['epilation'] > 0: dynslave_rate['temp_style'] += 10
		if dynslave['epilation'] = 0: dynslave_rate['temp_style'] -= 10
		if dynslave['hairstyle'] < 1 and dynslave['wig'] > 0: dynslave['hairstyle'] = 1
		if dynslave['hairstyle'] > 0: dynslave_rate['temp_style'] += 10
		if dynslave['hairstyle'] = 0: dynslave_rate['temp_style'] -= 10

		dynslave['st_count'] = 0
		if dynslave['st_plus'] >= 1: dynslave['st_count'] = 1 & dynslave_rate['temp_style'] += 10
		if dynslave['st_plus'] >= 3: dynslave['st_count'] = 2 & dynslave_rate['temp_style'] += 10
		if dynslave['st_plus'] >= 6: dynslave['st_count'] = 3 & dynslave_rate['temp_style'] += 20
		if dynslave['st_plus'] >= 9: dynslave['st_count'] = 4 & dynslave_rate['temp_style'] += 20
		if dynslave['st_plus'] >= 13: dynslave['st_count'] = 5 & dynslave_rate['temp_style'] += 30

		!counters for anatomy tab
		dynslave['grace_count'] = 0
		if dynslave['grace'] = 1: dynslave['grace_count'] = 1
		if dynslave['grace'] = -1: dynslave['grace_count'] = 2

		dynslave['makeup_count'] = 0
		if dynslave['perfume'] > 0: dynslave['makeup_count'] += 1
		if dynslave['manicure'] > 0: dynslave['makeup_count'] += 1
		if dynslave['epilation'] > 0: dynslave['makeup_count'] += 1

		!IMPACTS ON EXOTICISM
		dynslave_rate['temp_exotic'] = 0
		dynslave['piercings'] = dynslave['ear_piercing'] + dynslave['nose_piercing'] + dynslave['nostril_piercing'] + dynslave['tongue_piercing'] + dynslave['tongue_split'] + dynslave['scarification'] + dynslave['nipple_piercing'] + dynslave['belly_piercing'] + dynslave['clit_piercing'] &! [0, 9]
		if dynslave['piercings'] >= 1: dynslave['piercing_count'] = 1 & dynslave_rate['temp_exotic'] += 5
		if dynslave['piercings'] >= 3: dynslave['piercing_count'] = 2 & dynslave_rate['temp_exotic'] += 5
		if dynslave['piercings'] >= 5: dynslave['piercing_count'] = 3 & dynslave_rate['temp_exotic'] += 10
		if dynslave['piercings'] >= 7: dynslave['piercing_count'] = 4 & dynslave_rate['temp_exotic'] += 20
		if dynslave['piercings'] >= 9: dynslave['piercing_count'] = 5 & dynslave_rate['temp_exotic'] += 40

		dynslave['ex_count'] = 0
		if dynslave['ex_plus'] >= 1: dynslave['ex_count'] = 1 & dynslave_rate['temp_exotic'] += 5
		if dynslave['ex_plus'] >= 2: dynslave['ex_count'] = 2 & dynslave_rate['temp_exotic'] += 5
		if dynslave['ex_plus'] >= 3: dynslave['ex_count'] = 3 & dynslave_rate['temp_exotic'] += 10
		if dynslave['ex_plus'] >= 6: dynslave['ex_count'] = 4 & dynslave_rate['temp_exotic'] += 20
		if dynslave['ex_plus'] >= 9: dynslave['ex_count'] = 5 & dynslave_rate['temp_exotic'] += 40

		!if dynslave['scars'] = 1 or dynslave['scars'] = 2: dynslave_rate['temp_exotic'] += 10 &! level one and level two scarring increase exoticism but also lower beauty (TODO)

		! update stats after setting temp rate variables
		dynamic $replace($dyn_calc_slave_attrs, 'dyn'+'slave', 'dynslave') &! protect from earlier replace

		! update slave moodlets (after $dyn_calc_slave_attrs updates stats levels)
		if dynslave['beauty'] = 0 and (dynslave['bruises'] > 0 or dynslave['scars'] > 0):
			dynslave['neg_ugly'] = 100
		else
			dynslave['neg_ugly'] = 0
		end

		dynslave['neg_slave_mess'] = 0
		if house_mess > 3 and arrpos('$mobile_slave_characters', 'dynslave') ! -1: dynslave['neg_slave_mess'] = 100

		if dynslave['hygiene'] > 1: dynslave['pos_slave_clean'] = 0
		if dynslave['hygiene'] > 3: dynslave['neg_slave_dirty'] = 100
		if dynslave['hygiene'] < 4: dynslave['neg_slave_dirty'] = 0

		dynslave['neg_horny'] = 0
		a = (dynslave['pos_orgasm'] + dynslave['ego'] + dynslave['pride'] + dynslave['temper'] + dynslave['sensitivity'])/3
		if dynslave['nymphomania'] = 0 and dynslave['arousal'] > 0 and a < dynslave['arousal']:
			dynslave['neg_horny'] = 100
		elseif dynslave['nymphomania'] > 1 and dynslave['arousal'] > 0:
			dynslave['neg_horny'] = 100
		elseif dynslave['nymphomania'] < 0:
			dynslave['neg_horny'] = 0
		end
		a = 0

		if ($dynslave['cloth'] = 'голая' or $dynslave['cloth'] = 'пусто') and ('dynslave' ! 'cow' or dynslave['cowSK'] < 3):
			if dynslave['sub_exhibit'] < dynslave['ego']: dynslave['neg_naked'] = 100
		else
			dynslave['neg_naked'] = 0
		end

		! sanity check for inapplicable moodlets
		if dynslave['wounds'] = 0: dynslave['neg_slave_wounded'] = 0
		if dynslave['ill'] = 0: dynslave['neg_slave_ill'] = 0
		if dynslave['angst'] = 0: dynslave['neg_angst'] = 0
		if cheat_no_starve = 1 or (dynslave['days_without_food'] = 0 and dynslave['fat'] > 0): dynslave['neg_hungry'] = 0
		if dynslave['spoil'] = 0 or max(dynslave['neg_hungry'], dynslave['neg_starvation'], dynslave['neg_raped'], dynslave['neg_defloration'], dynslave['neg_angst']) > 0: dynslave['neg_spoil'] = 0
		if rebell[$dynslave_psy_status] > 0: dynslave['pos_moral'] = 0

		! update mood after updating moodlets, before checking mood when updating psy status below
		dynamic $replace($recalc_slave_mood, 'dyn'+'slave', 'dynslave') &! protect from earlier replace

		!Psychological status of slave
		! reluctant, arrogant, hateful, resistant, lachrymose, soft, servile, frightened, obedient, broken, depresive, horny, hysteric, optimistic, docile
		slave_psy_hardness = max(dynslave['ego'], dynslave['temper'], dynslave['spoil'], dynslave['pride'])
		slave_psy_hardness += dynslave['courage']
		courage = slave_psy_hardness
		if dynslave['mood'] > 0: courage += dynslave['mood']
		if dynslave['courage'] = 2:
			courage = 100
			dynslave['fear'] = 0 &! moronic slaves are impossible to frighten
		end

		max_motivation = max(dynslave['fear'],dynslave['moral'],dynslave['custom'],dynslave['rational'],dynslave['instinct'],dynslave['spoil'],dynslave['angst'],dynslave['arousal'])
		sanity = dynslave['ego'] + dynslave['temper'] + dynslave['pride']

																						$dynslave_psy_status = $dynslave_psy_basic &! use baseline psy status if nothing overrides
		if dynslave['moral'] > 0 and $dynslave_psy_basic = 'lachrymose':				$dynslave_psy_status = 'soft' &! with non-zero devotion, soft replaces lachrymose
		if dynslave['mood'] < 0:
			if $dynslave_psy_basic = 'optimistic':										$dynslave_psy_status = 'soft' &! when mood is negative, soft replaces optimistic
			if dynslave['moral'] < 2:
				if dynslave['temper'] >= max(4, max_motivation):						$dynslave_psy_status = 'hateful' &! high attributes override baseline (pride > ego > temper)
				if dynslave['ego'] >= max(4, max_motivation):							$dynslave_psy_status = 'resistant'
				if dynslave['pride'] >= max(4, max_motivation):							$dynslave_psy_status = 'arrogant'
			else
				if dynslave['temper'] >= max(4, max_motivation):						$dynslave_psy_status = 'hysteric' &! high attributes override baseline (pride > ego > temper)
				if dynslave['ego'] >= max(4, max_motivation):							$dynslave_psy_status = 'docile'
				if dynslave['pride'] >= max(4, max_motivation):							$dynslave_psy_status = 'soft'
			end
		elseif rebell[$dynslave_psy_basic] ! 0:
																						$dynslave_psy_status = 'reluctant' &! baseline replacement
																						! when mood is not negative, reluctant replaces arrogant/depresive/docile/frightened/hateful/hysteric/lachrymose/resistant
		end
		if sanity < 3 and no_mindbreak ! 1:
																						$dynslave_psy_status = 'broken' &! must first raise nature (ego) to restore a broken slave - ImperatorAugustus
			dynslave['pride'] = 0 & dynslave_rate['pride'] = 0
			dynslave['temper'] = 0 &  dynslave_rate['temper'] = 0
			dynslave['fear'] = 0 & dynslave_rate['fear'] = 0
			dynslave['rational'] = 0 & dynslave_rate['rational'] = 0
			dynslave['instinct'] = 0 & dynslave_rate['instinct'] = 0
			dynslave['custom'] = 5 & dynslave_rate['custom'] = 0
			dynslave['spoil'] = 0 & dynslave_rate['spoil'] = 0
			dynslave['moral'] = 0 & dynslave_rate['moral'] = 0
		elseif dynslave['fear'] = max_motivation and dynslave['fear'] >= courage:
																						$dynslave_psy_status = 'frightened'
		elseif dynslave['mood'] < 2 and (dynslave['angst'] > dynslave['temper']/3 or dynslave['mood'] = -5):
																						$dynslave_psy_status = 'depresive'
			if dynslave['sensitivity'] >= 4 and dynslave['mood'] < -1:					$dynslave_psy_status = 'lachrymose'
		elseif dynslave['obedience'] >= slave_psy_hardness/2:
			! custom or instinct as max motivation inherit psy status from above
			if dynslave['spoil'] > max(1, dynslave['fear'], (dynslave['moral']+1)/2):
																						$dynslave_psy_status = 'hysteric'
			elseif dynslave['mood'] >= 0:
				if dynslave['fear']     = max_motivation:								$dynslave_psy_status = 'docile'
				if dynslave['rational'] = max_motivation  or dynslave['moral'] > 1:		$dynslave_psy_status = 'obedient'
				if dynslave['moral']    = max_motivation  or dynslave['moral'] > 3:		$dynslave_psy_status = 'servile'
				if dynslave['spoil']   >= (1 + dynslave['moral'])/2:					$dynslave_psy_status = 'docile'
				if dynslave['arousal']  = max_motivation and dynslave['moral'] > 0:		$dynslave_psy_status = 'horny'
			end
		end

		!for master moodlets
		if $dynslave_psy_status = 'horny' or $dynslave_psy_status = 'servile' or $dynslave_psy_status = 'obedient':
			dynslave['status_met'] = 1
		else
			dynslave['status_met'] = 0
		end

		!Calculate slave traits, rank, and stats - crushboss
		!Calculate slave price (includes obedience calculation)
		dynamic $replace($update_slave_price, 'dyn'+'slave', 'dynslave') &! protect from earlier replace

	end &! end of slave conscious/fainted check
}

	

!!!!! core game location $slave_price converted to dynamic function, called from $slave_price location
$update_slave_price = {
	if dynslave_state ! CONST_INT['no_slave']:
		!Variable Reset - crushboss

		!GLOBALS
		killvar 'slave_specialisation'
		dynslave['obedience'] = 0 &! re-calculated below
		slave_obedience_bonus = 0 &! modified by $set_obedience_difficulty
		slaveprice = 0 &! used in slave_auction_sell (when you sell your slave to Farid)
		haggling_limit = 0 &! used in slave_auction_pass (when you or an NPC buy a slave from Farid during the daily auction)
		relative_rating = 0 &! used in slave_sell_chek
		!dynslave['sex_sum'] &! used in #dynamic, debug_info, interaction_city, slave_stat
		rating = 0 &! used in slave_sell_chek, interaction_city, interaction_result_city, guild, demo_intro
		$rating_help = ''
		!is_stock is intentionally not reset here so it can be set by the caller

		!LOCALS
		slave_mood_bonus = 0
		slave_nature = 0
		slave_fear_bonus = 0
		slave_obedience_penalty = 0
		attribute_sum = 0
		max_skill = 0
		max_sex = 0
		skill_sum = 0
		maxsum = 0
		slave_base_price = 0

		!Price for slave - improved - crushboss
		if dynslave['stamina'] < 2: slave_base_price -= 20
		if dynslave['stamina'] < 3: slave_base_price -= 40
		if dynslave['stamina'] > 2: slave_base_price += 10
		if dynslave['stamina'] > 3: slave_base_price += 20
		if dynslave['stamina'] > 4: slave_base_price += 30
		if dynslave['base_beauty'] < 1: slave_base_price -= 160
		if dynslave['base_beauty'] < 2: slave_base_price -= 80
		if dynslave['base_beauty'] < 3: slave_base_price -= 40
		if dynslave['base_beauty'] > 2: slave_base_price += 20
		if dynslave['base_beauty'] > 3: slave_base_price += 40
		if dynslave['base_beauty'] > 4: slave_base_price += 80
		if dynslave['fat'] < 1: slave_base_price -= 20
		if dynslave['fat'] = 1: slave_base_price += 20
		if dynslave['fat'] = 2: slave_base_price += 15
		if dynslave['fat'] > 2: slave_base_price -= 5
		if dynslave['fat'] > 3: slave_base_price -= 10
		if dynslave['fat'] > 4: slave_base_price -= 160
		if dynslave['scars'] > 0: slave_base_price -= 5
		if dynslave['scars'] > 1: slave_base_price -= 10
		if dynslave['scars'] > 2: slave_base_price -= 20
		if dynslave['scars'] > 4: slave_base_price -= 40
		if dynslave['bruises'] > 1: slave_base_price -= 5
		if dynslave['bruises'] > 2: slave_base_price -= 10
		if dynslave['bruises'] > 3: slave_base_price -= 15
		if dynslave['bruises'] > 4: slave_base_price -= 30
		if dynslave['style'] > 0: slave_base_price += 5
		if dynslave['style'] > 1: slave_base_price += 10
		if dynslave['style'] > 2: slave_base_price += 20
		if dynslave['style'] > 3: slave_base_price += 40
		if dynslave['style'] > 4: slave_base_price += 80
		if dynslave['exotic'] > 0: slave_base_price += 20
		if dynslave['exotic'] > 1: slave_base_price += 30
		if dynslave['exotic'] > 2: slave_base_price += 40
		if dynslave['exotic'] > 3: slave_base_price += 60
		if dynslave['exotic'] > 4: slave_base_price += 80
		if dynslave['sensitivity'] < 2: slave_base_price -= 20
		if dynslave['sensitivity'] < 3: slave_base_price -= 20
		if dynslave['sensitivity'] > 3: slave_base_price += 20
		if dynslave['sensitivity'] > 4: slave_base_price += 20
		if dynslave['intellect'] < 2: slave_base_price -= 40
		if dynslave['intellect'] < 3: slave_base_price -= 40
		if dynslave['intellect'] > 3: slave_base_price += 40
		if dynslave['intellect'] > 4: slave_base_price += 40
		if dynslave['temper'] < 2: slave_base_price -= 45
		if dynslave['temper'] < 3: slave_base_price -= 45
		if dynslave['temper'] > 2: slave_base_price += 20
		if dynslave['temper'] > 3: slave_base_price += 30
		if dynslave['temper'] > 4: slave_base_price += 40
		if dynslave['ego'] < 2: slave_base_price -= 80
		if dynslave['ego'] < 3: slave_base_price -= 40
		if dynslave['ego'] > 2: slave_base_price += 20
		if dynslave['ego'] > 3: slave_base_price += 40
		if dynslave['ego'] > 4: slave_base_price += 80
		if dynslave['pride'] < 1: slave_base_price += 20
		if dynslave['pride'] < 2: slave_base_price += 20
		if dynslave['pride'] < 3: slave_base_price += 20
		if dynslave['pride'] > 3: slave_base_price -= 30
		if dynslave['pride'] > 4: slave_base_price -= 30
		if dynslave['virginity'] < 2: slave_base_price += 20
		if dynslave['grace'] = 1: slave_base_price += 10
		if dynslave['grace'] = -1: slave_base_price -= 10
		if dynslave['dexterity'] > 0: slave_base_price += 10
		if dynslave['dexterity'] < 0: slave_base_price -= 10
		if dynslave['fame'] > 0: slave_base_price += 10
		if dynslave['fame'] > 1: slave_base_price += 20
		if dynslave['fame'] > 2: slave_base_price += 30
		if dynslave['fame'] > 3: slave_base_price += 40
		if dynslave['fame'] > 4: slave_base_price += 80

		! make sure slaves are valued at least as much in the market as at the butcher to prevent arbitrage - ImperatorAugustus
		dynamic $replace($dyn_meat_evaluation, 'dyn'+'slave', 'dynslave')
		if slave_base_price < max(20, meat_price): slave_base_price = max(20, meat_price)

! JO9 MOD START TBV_BASE_PRICE | 2026-10-17_trait_value
		! Rebuilt base valuation receives the permanent versatile bonus once.
		slave_base_price = func('jo9_traits_value', 'base_price', 'dynslave', slave_base_price)
		!Calculate slave price
		slaveprice = (slave_base_price*3)/2 &! global variable, used when selling to Farid
! JO9 MOD END TBV_BASE_PRICE
		if slaveprice < 30: slaveprice = 30

