			if attribute_sum < 16: $rating_help += '더 높은 <a href=''EXEC: msg $атрибуты_справка''>기틀 속성</a><br>'
			if dynslave['sex_sum'] < 18: $rating_help += '더 높은 성애기술 등급<br>'
			if skill_sum < 26: $rating_help += '더 높은 일반기술 등급<br>'
		elseif rating = 8:
