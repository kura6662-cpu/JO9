! Replacement for consecutive colors with the same name
$vb_full_cycle = {
	$_arr_name = $args[0]
	_max_iter = args[1]
	$_caption = $args[2]
	$_tmp = ''

	_counter = 0
:_vb_full_cycle_loop
		!dynamic "<<$_arr_name>>[<<_counter>>] = dyneval($vb_cycle_skill, <<_counter>>, <<$_caption>>)"
		$_tmp = dyneval($vb_cycle_skill, _counter, $_caption)
		dynamic "<<$_arr_name>>[<<_counter>>] = $_tmp"
		_counter += 1
	if _counter <= _max_iter: jump '_vb_full_cycle_loop'

	killvar '$_arr_name'
	killvar '_max_iter'
	killvar '$_caption'
	killvar '_counter'
	killvar '$_tmp'
}
