		if dynslave['courage'] = 2: slave_obedience_penalty += 6
		if dynslave['courage'] = 1: slave_obedience_penalty += 4
		if dynslave['courage'] = -1: slave_obedience_bonus += dynslave['fear']
		if dynslave['age'] = CONST_INT['loli_age']: slave_obedience_bonus += 2
		if dynslave['age'] = CONST_INT['young_age']: slave_obedience_bonus += 1
		! Calculate mood bonus for obedience
		if dynslave['mood'] > 0: slave_mood_bonus = 1 + (dynslave['mood']/2)
		! Calculate fear bonus for obedience
		if dynslave['fear'] > 0:
			slave_nature = (dynslave['pride'] + dynslave['temper'] + dynslave['ego'] + dynslave['intellect'])
			if slave_nature < 11:
				slave_fear_bonus = (dynslave['fear']*2)
			elseif slave_nature = 11:
				slave_fear_bonus = (dynslave['fear']*2) + 1
			elseif slave_nature = 12:
				slave_fear_bonus = (dynslave['fear']*2) + 2
			elseif slave_nature = 13:
				slave_fear_bonus = (dynslave['fear']*2) + 3
			elseif slave_nature = 14:
				slave_fear_bonus = (dynslave['fear']*2) + 4
			elseif slave_nature > 14:
				slave_fear_bonus = (dynslave['fear']*2) + 5
			end
		end
