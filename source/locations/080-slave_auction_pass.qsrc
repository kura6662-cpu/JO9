# slave_auction_pass
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2860 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'slave_auction_pass': gs 'snk_room_bridge', 'guard', 'slave_auction_pass'
! JO9 MOD END J9M2860
!Skip over one auction phase (buying slave)
if auction_phase = 5:
	haggling_stage = 0
	auction_phase = 7
	gt 'city_menu_form'
end

if auction_phase = 7:
	haggling_stage = 0
	gt 'city_menu_form'
end

if auction_phase = 6:
	sparks -= cur_stock_price
	haggling_stage = 0
	auction_phase = 7
	$return_lock = 'city_menu_form'
	gt 'stock_to_slave'
end

if auction_phase = 4:
	if stock_sold >= stock_limit:
		auction_phase = 5
	else
		if haggling_stage = 1:
			auction_phase = 0
			haggling_stage = 0
			gs 'generate_stock'
		end
		rises = 0
	end
	if haggling_stage = 2:
		auction_phase = 6
		gt 'slave_auction_buy'
	end
end

if  haggling_stage > 0:
	stake_size = 0
	:loop
		rise_chance = rand(1,haggling_limit)
		rise_chance += rises
		if rise_chance <= haggling_limit:
			rises += 1
			stake_size += 1
			if stake_size < 10: jump 'loop'
		end

	if stake_size = 0:
		if auction_phase < 4: auction_phase += 1
	else
		cur_stock_price += stake_size * 5
		rise_stock_price = cur_stock_price + 5
		a = rand(1,35)
		$text = '<<$rival_stake[a]>> <<$stake_size[stake_size]>>'
		haggling_stage = 1
		auction_phase = 1
	end
end

if haggling_stage = 0:
	stock_sold += 1
	cur_stock_price = slave_base_price
	rise_stock_price = slave_base_price
	haggling_stage = 1
else
	rise_stock_price = cur_stock_price + 5
end

gt 'slave_auction_buy'
------------ slave_auction_pass ------------
