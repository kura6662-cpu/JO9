# $mod_assistant_rise
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2936 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '$mod_assistant_rise': gs 'snk_room_bridge', 'guard', '$mod_assistant_rise'
! JO9 MOD END J9M2936
!Decrease bad moodlets of assistant
n = arrsize('$assistant_bad_mod')
i = 0
:loop
i += 1
$curmod = $assistant_bad_mood[i]
assistant['<<$curmod>>'] -= args
if i < n: jump 'loop'
------------ $mod_assistant_rise ------------
