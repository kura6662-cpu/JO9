! Central Quarter (Forum)
$centralkvartal_options[1] = {
  npc = 0
  $place = 'centralkvartalForum'
  $text_display = '<br><br><br>'
  FUNC('$menu', 'spacer', 2)

  FUNC('$menu', '===BEGIN===', 'column_0')
  IF faction_fame['centralkvartal'] >= 3:
    $sp_text[1] = '   나는 포럼에 들어갈 수 있게 되었다. 이제 누구에게 내 서비스를 제안할지만 정하면 된다.'
    if npc_progress['Legat'] < 2 and active[$quest[15]] < 2: FUNC('$menu', 'interaction_city', $menu_item_Legat_palace, menu_Legat_palace, '접견: 레가트')
    if npc_progress['Pelageya'] < 2 and active[$quest[14]] < 2: FUNC('$menu', 'interaction_city', $menu_item_Pelageya_palace, menu_Pelageya_palace, '접견: 펠라게야')
  ELSE
    $place = 'centralkvartalForum_gate'
    $text_display += '<br><br><br><br>'
    $sp_text[1] = '   로마의 행정 중심지는 삼엄하게 지켜지고 있다. 허가 없이는 들어갈 수 없다.'
  END

  IF faction_fame['centralkvartal'] >= 4 and (npc_progress['ImperatorGay'] = 0 or npc_progress['ImperatorGay'] = 1):
    $sp_text[1] = '   나는 황제를 알현할 수 있게 되었다. 서둘러 그를 만나 그의 임무를 완수해야 한다.'
    if npc_progress['ImperatorGay'] < 2: FUNC('$menu', 'interaction_city', $menu_item_ImperatorGay_palace, menu_ImperatorGay_palace, '황제 알현')
  END

  !IF faction_fame['centralkvartal'] = 4 and npc_progress['ImperatorGay'] = 2 and noble_status = 1:
  !  $sp_text[1] = '   황제는 만족했다. 도움이 필요하면 언제든 그를 믿을 수 있다.'
  !END

  IF faction_fame['centralkvartal'] = 5 and npc_progress['ImperatorGay'] = 2 and noble_status = 1:
    $sp_text[1] = '   이제 나는 귀족이며 포럼의 노빌레스이다. 도움이 필요하면 언제든 이곳 사람들을 믿을 수 있다.'
  END

  if witch_text = 2 and active[$quest[14]] < 2: FUNC('$menu', 'interaction_city', $menu_item_ImperatorGay_palace, 1540, '황제와 이야기한다')
  if active[$quest[15]] = 2 and venera2 = 0: FUNC('$menu', 'interaction_city', $menu_item_Varvar_king_palace, 1556, '야만왕과 이야기한다')

  FUNC('$menu', 'city_form', $menu_item_centralkvartal, menu_Leavecentralkvartal_district, '떠난다')
  FUNC('$menu', '===END===')
}

