$smuggler_options[2] = {
	npc = 1 & $npc_id = 'bararaika'
	$sp_text[2] = '  우리 노예 전부의 훈련 방식은 표준화되어 있어. 외모도 마찬가지고. 클론이니까, 알지. 하지만 원하는 연령대는 고를 수 있어. 길드는 어떤 이유로든 클론 사용을 아주 못마땅하게 여긴다는 걸 기억해. 들키면 책임은 전부 네 몫이다. 명성이 높으면 그들의 스캔을 막을 수 있지 않은 한 가망이 없다.'
	$text_display = '<br><br>'
	func('$menu', 'spacer', 1)

	func('$menu', '===BEGIN===', 'column_0')
