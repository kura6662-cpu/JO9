	end
	if sparks >= spm_price and spm_learned['подрезка'] = 0:
		func('$menu', 'interaction_city', $menu_item_Dashing, menu_Dashing, '돌진 베기 (<<spm_price>>$)')
		else
		func('$menu', 'location_gray', $menu_item_Dashing_gray, empty, '돌진 베기 (<<spm_price>>$)')
