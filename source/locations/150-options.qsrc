!Colosseum
!added $sp_text for the first and second options are so theres no sticky text about preparing for battle
$colosseum_options[1] = {
	$place = 'colosseum'
! JO9 MOD START J9M2355 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
	$sp_text[1] = '당신은 원형 경기장 밑에 위치한 대기실에 들어섰다. 경비병이 아무런 문제 없이 당신을 통과시켜줬다. - 노예 상인 길드는 검투사와 경마에도 영향력을 미친다. 당신은 적당한 상대를 고르기만 하면 된다.'
! JO9 MOD END J9M2355
	func('$menu', 'spacer', 1)

	func('$menu', '===BEGIN===', 'column_0')
	func('$menu', 'exec_options', $menu_item_LanistaColosseum, 'sp_txt = 21 & gt $curloc', '투사 훈련소')
	func('$menu', 'exec_options', $menu_item_StablemanColosseum, 'sp_txt = 22 & gt $curloc', '경주 관리자')
	if ride_count ! 0:
		func('$menu', 'location_gray', $menu_item_racecount_gray, empty, '경주까지 : <<ride_count>>')
	else
		if slave_state = CONST_INT['slave_exist'] and slave['energy'] > 1 and slave['brand'] ! 0 and city_already_done_today[$str(menu_participate_race)] = 0:
			func('$menu', 'exec_options', $menu_item_participate_race, 'sp_txt = 23 & gt $curloc', '전투마차 경주 참가')
		elseif city_already_done_today[$str(menu_participate_race)] = 0:
			func('$menu', 'location_gray_tooltip', $menu_item_racecount_gray, empty, '경주참가 불가', '노예가 없거나 상표 없음 혹은 행동력 부족')
		end
		if city_already_done_today[menu_participate_race] = 0 and city_already_done_today[menu_watch_race] = 0: func('$menu', 'interaction_city', $menu_item_watch_race, menu_watch_race, '경주대회 관람')
	end
	if gladi_count ! 0:
		func('$menu', 'location_gray', $menu_item_battlecount_gray, empty, '시합까지 : <<gladi_count>>')
	else
		if slave_state = CONST_INT['slave_exist'] and slave['energy'] > 1 and slave['brand'] ! 0 and slave['gladiatrix_contest'] = 0 and gladiatrix_contest_count <= max(1, guild_reputation - 1):
			func('$menu', 'exec_options', $menu_item_Put_gladiatrix, 'combatant = 1 & sp_txt = 24 & gt $curloc', '여성투사 시합 참가')
		else
			func('$menu', 'location_gray_tooltip', $menu_item_battlecount_gray, empty, '시합참가 불가', '노예가 없거나 상표 없음, 행동력 부족, 연속 참가를 위한 인지도 부족')
		end
		if city_already_done_today['12801'] = 0 and city_already_done_today[$str(menu_watch_battle)] = 0: func('$menu', 'interaction_city', $menu_item_Watch_battle, menu_watch_battle, '투사시합 관람')
	end
! JO9 MOD START J9M2354 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	func('$menu', 'city_form', $menu_item_Leave_Colosseum, menu_Leave_Colosseum, '콜로세움 밖으로')
! JO9 MOD END J9M2354
	func('$menu', '===END===')
}

$colosseum_options[21] = {
	npc = 1 & $npc_id = 'brina'
	func('$menu', 'spacer', 1)

	func('$menu', '===BEGIN===', 'column_0')
	if master_energy > 0:
		func('$menu', 'exec_options', $menu_item_Arrange_me, 'sp_txt = 2 & gt $curloc', '연습 경기 : 노예상')
