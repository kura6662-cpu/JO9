$futaland_tower_options[1] = {
$place = 'futaland_tower'
$text_display = '<br><br><br>'
FUNC('$menu', 'spacer', 2)
FUNC('$menu', '===BEGIN===', 'column_0') 
IF faction_fame['futaland'] >= 3:
 $sp_text[1] = '   자, 들어왔다... 이제 누구에게 내 서비스를 제안할지 고르기만 하면 된다.'
 if npc_progress['ilariya'] < 2: FUNC('$menu', 'interaction_city', $menu_item_ilariya, 11021, '접견: 일라리야')
 if npc_progress['artemia'] < 2: FUNC('$menu', 'interaction_city', $menu_item_artemia, 11022, '접견: 아르테미아')
 if npc_progress['mstislava'] < 2: FUNC('$menu', 'interaction_city', $menu_item_mstislava, 11023, '접견: 므스티슬라바')
 else
 $place = 'futaland_gate'
 $text_display += '<br><br><br><br>' 
 $sp_text[1] = '   입구의 경비들은 꽤 위압적으로 보인다. 저런 "기계"들을 상대로는 괜히 까불지 않는 편이 낫다. 통행증 없이는 누구도 들여보내지 않을 것 같군...'
END
