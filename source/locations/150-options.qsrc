$sp_text[1] = '  크리스마스에 축제 시장이 없다면 무슨 크리스마스겠는가? 명절 전야에는 모든 취향과 색깔에 맞는 선물을 여기서 살 수 있었을 것이다. 그랬던 것이... 지금의 겨울 동화 주인들이 모든 현지 상인들을 쫓아내고, 축제의 중심지를 말 그대로 거대한 사창가로 바꿔 놓기 전까지는 말이다. '
$text_display = '<br><br>'
FUNC('$menu', '===BEGIN===', 'column_0')
IF npc_progress['womens_attraction'] < 1: FUNC('$menu', 'interaction_city', $menu_item_womens_attraction, 10320, '괴력의 그린치')
IF npc_progress['womens_attraction'] = 1: FUNC('$menu', 'interaction_city', $menu_item_womens_attraction, 10321, '괴력의 그린치')
FUNC('$menu', 'city_form', $menu_item_wintertales, 131, '떠난다')
FUNC('$menu', '===END===')
}
$XXXTalesforest_options[1] = {
FUNC('$menu', 'spacer', 0)
$sp_text[1] = '  겨울 동화의 심장은 원래 새해 전야마다 주민들이 가장 즐겨 찾는 장소였다. 할아버지들과 그 조수들은 축제 분위기를 유지하고 손님들을 새롭고 기묘한 것으로 놀라게 하려고 최선을 다했다. 하지만 지금 이곳에는 우울과 침체만이 지배하고 있으며, 아이들의 즐거운 웃음소리는 때때로 가슴을 찢는 듯한 신음과 흡족한 끙끙거림으로 깨지는 죽음 같은 정적에 자리를 내주었다.'
$text_display = '<br><br>'
FUNC('$menu', '===BEGIN===', 'column_0')
IF npc_progress['fabrika_podarkov'] < 1: FUNC('$menu', 'interaction_city', $menu_item_fabrika_podarkov, 1035, '선물 공장')
IF npc_progress['fabrika_podarkov'] = 1: FUNC('$menu', 'interaction_city', $menu_item_fabrika_podarkov, 10351, '선물 공장')
IF npc_progress['santa_claus'] < 1 and npc_progress['grinch'] = 1: FUNC('$menu', 'interaction_city', $menu_item_santa, 1036, '할아버지들의 거처')
IF npc_progress['santa_claus'] = 1: FUNC('$menu', 'interaction_city', $menu_item_santa, 10361, '할아버지들의 거처')
IF npc_progress['mrs_santa_claus'] < 1 and npc_progress['grinch'] = 1: FUNC('$menu', 'interaction_city', $menu_item_mrs_santa_claus, 10362, '클로스 부인')
IF npc_progress['mrs_santa_claus'] = 1: FUNC('$menu', 'interaction_city', $menu_item_mrs_santa_claus, 10363, '클로스 부인')
IF npc_progress['red_room'] < 1 and npc_progress['mrs_santa_claus'] = 1: FUNC('$menu', 'interaction_city', $menu_item_red_room, 1037, '붉은 방')
IF npc_progress['red_room'] = 1 and npc_progress['shlyapkin'] < 2: FUNC('$menu', 'interaction_city', $menu_item_red_room, 10371, '붉은 방')
IF active[$event['спасение_рождества']] = 8: FUNC('$menu', 'interaction_city', $menu_item_auction_announcement, 10376, '경매')
IF npc_progress['mrs_santa_claus'] = 1 and npc_progress['red_room'] = 1 and npc_progress['shlyapkin'] ! 2: FUNC('$menu', 'interaction_city', $menu_item_shlyapkin, 10372, '슐랴프킨과 이야기한다')
IF npc_progress['grinch'] < 1: FUNC('$menu', 'interaction_city', $menu_item_grinch, 1038, '그린치')
IF npc_progress['grinch'] = 1 and active[$event['спасение_рождества']] < 9: FUNC('$menu', 'interaction_city', $menu_item_grinch, 10381, '그린치')
IF active[$event['спасение_рождества']] = 9: FUNC('$menu', 'interaction_city', $menu_item_grinch, 10383, '그린치를 만난다')
FUNC('$menu', 'city_form', $menu_item_wintertales, 131, '떠난다')
FUNC('$menu', '===END===')
}


