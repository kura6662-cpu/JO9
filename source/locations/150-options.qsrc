$colosseum_options[24] = {
	func('$menu', 'spacer', 2)
	func('$menu', '===BEGIN===', 'column_0')
	if $slave['trademark_style'] = '':
		$sp_text[24] = '  전투는 무기와 장비가 엄격히 규정된 상태로 투기장에서 열린다. 이번 전투에서 <<$slave_name>>가 사용할 전투 스타일을 골라야 한다. 만약 그녀가 챔피언이 되면, 챔피언전에서 사용한 스타일이 그녀의 상징적인 전투 방식이 되며 다시는 바꿀 수 없다. 갑옷을 사용하는 스타일은 노예가 직접 그 갑옷을 갖고 있어야 한다.'
		func('$menu', 'exec_options', $menu_item_net_and_trident, '$g_type = "retiarius" & slave["gladiatrix_contest"] = 1 & gladiatrix_contest_count += 1 & gt "$gladiator_setup"', '알몸, 그물과 삼지창')
		if $slave['armor'] = $armor['flagrius']:
			func('$menu', 'exec_options', $menu_item_whipsaw, '$g_type = "flagrius" & slave["gladiatrix_contest"] = 1 & gladiatrix_contest_count += 1 & gt "$gladiator_setup"', '아라미드 복합 갑옷, 톱날채찍')
		else
			func('$menu', 'location_gray_tooltip', $menu_item_battlecount_gray, empty, '아라미드 복합 갑옷, 톱날채찍', '필요한 갑옷을 착용하고 있지 않다: <<$item_name[$armor["flagrius"]]>>')
		end
		if $slave['armor'] = $armor['dimacherus']:
			func('$menu', 'exec_options', $menu_item_Dual, '$g_type = "dimacherus" & slave["gladiatrix_contest"] = 1 & gladiatrix_contest_count += 1 & gt "$gladiator_setup"', '아라미드 전투복, 쌍수 무기')
		else
			func('$menu', 'location_gray_tooltip', $menu_item_battlecount_gray, empty, '아라미드 전투복, 쌍수 무기', '필요한 갑옷을 착용하고 있지 않다: <<$item_name[$armor["dimacherus"]]>>')
		end
		if $slave['armor'] = $armor['hoplomachus']:
			func('$menu', 'exec_options', $menu_item_shield, '$g_type = "hoplomachus" & slave["gladiatrix_contest"] = 1 & gladiatrix_contest_count += 1 & gt "$gladiator_setup"', '요정족 사슬갑옷, 무기와 방패')
		else
			func('$menu', 'location_gray_tooltip', $menu_item_battlecount_gray, empty, '요정족 사슬갑옷, 무기와 방패', '필요한 갑옷을 착용하고 있지 않다: <<$item_name[$armor["hoplomachus"]]>>')
		end
		func('$menu', 'exec_options', $menu_item_Heavy, '$g_type = "kimerian" & slave["gladiatrix_contest"] = 1 & gladiatrix_contest_count += 1 & gt "$gladiator_setup"', '알몸, 고중량 무기')
		func('$menu', 'exec_options', $menu_item_Refusefight, 'sp_txt = 1 & gt $curloc', '전투를 거부한다')
		challenge_type = 0 &! reset challenge_type for non-champion battles after a champion battle on the same day
	else
		$sp_text[24] = '  투기장에서 인정받는 챔피언들은 가장 화려하고 가장 많은 관객을 끌어모으는 경기에서만 싸운다. 챔피언이 참여하는 이런 특수 경기들은 경기일의 시작과 끝을 장식한다.'
		if $slave['armor'] = $armor[$slave['trademark_style']]:
			func('$menu', 'exec_options', $menu_item_Challange_champion, '$g_type = $slave["trademark_style"] & challenge_type = 1 & slave["gladiatrix_contest"] = 1 & gladiatrix_contest_count += 1 & gt "$gladiator_setup"', '챔피언에게 도전한다')
			func('$menu', 'exec_options', $menu_item_Group_fight, '$g_type = $slave["trademark_style"] & challenge_type = 2 & slave["gladiatrix_contest"] = 1 & gladiatrix_contest_count += 1 & gt "$gladiator_setup"', '집단전')
			func('$menu', 'exec_options', $menu_item_Battle_fiend, '$g_type = $slave["trademark_style"] & challenge_type = 3 & slave["gladiatrix_contest"] = 1 & gladiatrix_contest_count += 1 & gt "$gladiator_setup"', '안개 괴물과 싸운다')
			if (slave['arena_level'] >= 8 and slave['c4done'] = 0) or (slave['c1done'] = 1 and slave['c2done'] = 1 and slave['c3done'] = 1 and slave['c4done'] = 0): func('$menu', 'exec_options', $menu_item_absolute_champion, '$g_type = $slave["trademark_style"] & challenge_type = 4 & arena_mode = 1 & slave["gladiatrix_contest"] = 1 & gladiatrix_contest_count += 1 & gt "$gladiator_setup"', '절대 왕좌에 도전한다')
		else
			func('$menu', 'location_gray_tooltip', $menu_item_battlecount_gray, empty, '챔피언에게 도전한다', '필요한 갑옷을 착용하고 있지 않다: <<$item_name[$armor[$slave["trademark_style"]]]>>')
			func('$menu', 'location_gray_tooltip', $menu_item_battlecount_gray, empty, '집단전', '필요한 갑옷을 착용하고 있지 않다: <<$item_name[$armor[$slave["trademark_style"]]]>>')
			func('$menu', 'location_gray_tooltip', $menu_item_battlecount_gray, empty, '안개 괴물과 싸운다', '필요한 갑옷을 착용하고 있지 않다: <<$item_name[$armor[$slave["trademark_style"]]]>>')
		end
		func('$menu', 'exec_options', $menu_item_Refusefight, 'sp_txt = 1 & gt $curloc', '전투를 거부한다')
	end
	func('$menu', '===END===')
}

