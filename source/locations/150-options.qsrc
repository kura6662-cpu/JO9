!Yôhanan Stiven house
$yôhanan_stiven_options[1] = {
	$text_display = '<br>'
	if slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] ! 4:
		$text_display += '<br><div id="under">상품을 제안한다<br><div id = "clear"><a href = ''EXEC: interaction_city = 3111 & gt "interaction_city"''><img src = "content\pic\clear.png"></a></div></div>'
	else
		$text_display += '<br><div id="under_gray">상품을 제안한다<br></div>'
	end
	$text_display += '<br><div id="under">취향을 확인한다<br><div id = "clear"><a href = ''EXEC: interaction_city = 3112 & gt "interaction_city"''><img src = "content\pic\clear.png"></a></div></div>'
	$text_display += '<br><div id="under">작별 인사를 하고 떠난다<br><div id = "clear"><a href = ''EXEC: city_form = 31 & gt "city_menu_form"''><img src = "content\pic\clear.png"></a></div></div>'
}

!Preparing for fight - weapon selection screen - overhauled by crushboss
$get_weapon[1] = {

	$text_display = ''

	if $за_спиной ! '':
		$text_display += "<br><div id=""under"">등 뒤 : <<$item_name[$за_спиной]>><br><div id = ""clear""><a href = 'EXEC: no_wpn[""за_спиной""] = 1 & sp_txt = 2 & gt $curloc'><img src = ""content\pic\clear.png""></a></div></div>"
	else
		$text_display += '<br><div id="under_gray">등 뒤에 아무것도 없다!<br></div>'
	end

	if $слева ! '':
		$text_display += "<br><div id=""under"">왼 손 : <<$item_name[$слева]>><br><div id = ""clear""><a href = 'EXEC: no_wpn[""слева""] = 1 & sp_txt = 2 & gt $curloc'><img src = ""content\pic\clear.png""></a></div></div>"
	else
		$text_display += '<br><div id="under_gray">왼 손에 아무것도 없다!<br></div>'
	end

	if $справа ! '':
		$text_display += "<br><div id=""under"">오른손 : <<$item_name[$справа]>><br><div id = ""clear""><a href = 'EXEC: no_wpn[""справа""] = 1 & sp_txt = 2 & gt $curloc'><img src = ""content\pic\clear.png""></a></div></div>"
	else
		$text_display += '<br><div id="under_gray">오른손에 아무것도 없다!<br></div>'
	end

	if $предплечье ! '':
		$text_display += "<br><div id=""under"">팔뚝 : <<$item_name[$предплечье]>><br><div id = ""clear""><a href = 'EXEC: no_wpn[""предплечье""] = 1 & sp_txt = 2 & gt $curloc'><img src = ""content\pic\clear.png""></a></div></div>"
	elseif combatant = 0:
		$text_display += '<br><div id="under_gray">팔뚝에 아무것도 없다!<br></div>'
	elseif combatant = 1 or combatant = 2:
		$предплечье = ''
! JO9 MOD START FOG_KEEP_OTHER_ARM_WPN | 2026-10-17_fog_relay
		if jo9_fog['active'] = 0:
		$slave["arm_wpn"] = ''
		$assistant["arm_wpn"] = ''
		end
! JO9 MOD END FOG_KEEP_OTHER_ARM_WPN
	end

	if $в_сапоге ! '':
		$text_display += "<br><div id=""under"">허벅지 : <<$item_name[$в_сапоге]>><br><div id = ""clear""><a href = 'EXEC: no_wpn[""в_сапоге""] = 1 & sp_txt = 2 & gt $curloc'><img src = ""content\pic\clear.png""></a></div></div>"
	elseif combatant = 0:
		$text_display += '<br><div id="under_gray">허벅지에 아무것도 없다!<br></div>'
	elseif combatant = 1 or combatant = 2:
		$в_сапоге = ''
! JO9 MOD START FOG_KEEP_OTHER_LEG_WPN | 2026-10-17_fog_relay
		if jo9_fog['active'] = 0:
		$slave["leg_wpn"] = ''
		$assistant["leg_wpn"] = ''
		end
! JO9 MOD END FOG_KEEP_OTHER_LEG_WPN
	end

	if combatant = 0 and $master['prev_primary_wpn'] ! '' and ($master_back_wpn = $master['prev_primary_wpn'] or $master_left_wpn = $master['prev_primary_wpn'] or $master_right_wpn = $master['prev_primary_wpn'] or $master_arm_wpn = $master['prev_primary_wpn'] or $master_leg_wpn = $master['prev_primary_wpn']):
		$text_display += "<br><div id=""under"">직전 전투와 같은 장비<br><div id = ""clear""><a href = 'EXEC: nogoto = 0 & a = 1 & killvar ""no_wpn"" & gt ""начать_бой""'><img src = ""content\pic\clear.png""></a></div></div>"
	elseif combatant = 1 and $slave['prev_primary_wpn'] ! '' and ($slave['back_wpn'] = $slave['prev_primary_wpn'] or $slave['left_wpn'] = $slave['prev_primary_wpn'] or $slave['right_wpn'] = $slave['prev_primary_wpn'] or $slave['arm_wpn'] = $slave['prev_primary_wpn'] or $slave['leg_wpn'] = $slave['prev_primary_wpn']):
		$text_display += "<br><div id=""under"">직전 전투와 같은 장비<br><div id = ""clear""><a href = 'EXEC: nogoto = 0 & a = 1 & killvar ""no_wpn"" & gt ""начать_бой""'><img src = ""content\pic\clear.png""></a></div></div>"
	elseif combatant = 2 and $assistant['prev_primary_wpn'] ! '' and ($assistant['back_wpn'] = $assistant['prev_primary_wpn'] or $assistant['left_wpn'] = $assistant['prev_primary_wpn'] or $assistant['right_wpn'] = $assistant['prev_primary_wpn'] or $assistant['arm_wpn'] = $assistant['prev_primary_wpn'] or $assistant['leg_wpn'] = $assistant['prev_primary_wpn']):
		$text_display += "<br><div id=""under"">직전 전투와 같은 장비<br><div id = ""clear""><a href = 'EXEC: nogoto = 0 & a = 1 & killvar ""no_wpn"" & gt ""начать_бой""'><img src = ""content\pic\clear.png""></a></div></div>" 
	end

	$text_display += '<br><div id="under">전투 시작<br><div id = "clear"><a href = ''EXEC: nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
}

$get_weapon[2] = {

	if no_wpn["за_спиной"] = 1: nogoto = 0 & gt "начать_бой"

	$text_display = '<br>'

	!Shoulder slot will always be greyed out when selecting a secondary/off-hand weapon since all shoulder slot items are two-handed - crushboss
	if $за_спиной ! '' and no_wpn["за_спиной"] = 0:
		$text_display += "<br><div id=""under_gray"">등 뒤 : <<$item_name[$за_спиной]>><br></div>"
	elseif $за_спиной = '':
		$text_display += '<br><div id="under_gray">등 뒤에 아무것도 없다!<br></div>'
	end

	if $слева ! '' and no_wpn["слева"] = 0:
		$text_display += '<br><div id="under">왼 손 : <<$item_name[$слева]>><br><div id = "clear"><a href = ''EXEC: no_wpn["слева"] = 2 & nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
	elseif no_wpn["слева"] = 1 or no_wpn["слева"] = 2:
		$text_display += '<br><div id="under_gray">왼 손 : <<$item_name[$слева]>><br></div>'
	elseif $слева = '':
		$text_display += '<br><div id="under_gray">왼 손에 아무것도 없다!<br></div>'
	end

	if $справа ! '' and no_wpn["справа"] = 0:
		$text_display += '<br><div id="under">오른손 : <<$item_name[$справа]>><br><div id = "clear"><a href = ''EXEC: no_wpn["справа"] = 2 & nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
	elseif no_wpn["справа"] = 1 or no_wpn["справа"] = 2:
		$text_display += '<br><div id="under_gray">오른손 : <<$item_name[$справа]>><br></div>'
	elseif $справа = '':
		$text_display += '<br><div id="under_gray">오른손에 아무것도 없다!<br></div>'
	end

	if $предплечье ! '' and no_wpn["предплечье"] = 0:
		$text_display += '<br><div id="under">팔뚝 : <<$item_name[$предплечье]>><br><div id = "clear"><a href = ''EXEC: no_wpn["предплечье"] = 2 & nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
	elseif no_wpn["предплечье"] = 1 or no_wpn["предплечье"] = 2:
		$text_display += '<br><div id="under_gray">팔뚝 : <<$item_name[$предплечье]>><br></div>'
	elseif $предплечье = '' and combatant = 0:
		$text_display += '<br><div id="under_gray">팔뚝에 아무것도 없다!<br></div>'
	end

	if $в_сапоге ! '' and no_wpn["в_сапоге"] = 0:
		$text_display += '<br><div id="under">허벅지 : <<$item_name[$в_сапоге]>><br><div id = "clear"><a href = ''EXEC: no_wpn["в_сапоге"] = 2 & nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
	elseif no_wpn["в_сапоге"] = 1 or no_wpn["в_сапоге"] = 2:
		$text_display += '<br><div id="under_gray">허벅지 : <<$item_name[$в_сапоге]>><br></div>'
	elseif $в_сапоге = '' and combatant = 0:
		$text_display += '<br><div id="under_gray">허벅지에 아무것도 없다!<br></div>'
	end

	$text_display += '<br><div id="under">전투 시작<br><div id = "clear"><a href = ''EXEC: nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
}

$get_weapon[3] = {
	if no_wpn["за_спиной"] = 0 and no_wpn["слева"] = 0 and no_wpn["справа"] = 0 and no_wpn["предплечье"] = 0 and no_wpn["в_сапоге"] = 0:
		$text_display = '<br><br><br>'
		$text_display += '<br><div id="under">의자 <br><div id = "clear"><a href = ''EXEC: $оружие = "табуретка" & nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
		$text_display += '<br><div id="under">단검 <br><div id = "clear"><a href = ''EXEC: $оружие = "кинжал" & nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
		dynamic $toolsequipped
		if lashequipped = 1 or нагайка > 0: $text_display += '<br><div id="under">갈래 채찍 <br><div id = "clear"><a href = ''EXEC: $оружие = "нагайка" & nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
		$text_display += '<br><div id="under">전투에 참가한다<br><div id = "clear"><a href = ''EXEC: nogoto = 0 & gt "начать_бой"''><img src = "content\pic\clear.png"></a></div></div>'
	end
}


