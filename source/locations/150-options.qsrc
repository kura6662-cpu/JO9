	$text_display = '<br><br><br>'
	func('$menu', 'spacer', 2)

	func('$menu', '===BEGIN===', 'column_0')
	if faction_fame['serpis'] >= 3:
		$sp_text[1] = '  좋아, 안으로 들어왔다. 이제 남은 건 누구에게 내 서비스를 제안할지 고르는 것뿐이다.'
		if npc_progress['bishop_porter'] < 2: func('$menu', 'interaction_city', $menu_item_archbishopspires, menu_archbishopspires, '접견 : 대주교')
