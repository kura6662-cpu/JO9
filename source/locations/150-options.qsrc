!Real estate manager
$realtor_options[1] = {
	$text_display = '<br><br><br>'
	func('$menu', '===BEGIN===', 'column_0')
	if npc_reveal['realtor'] = 0:
		func('$menu', 'interaction_city', $menu_item_Speaktomanager, menu_Speaktomanager, '사무실 소개')
		func('$menu', 'location_gray_tooltip', $menu_item_Interiordesign_gray, empty, '실내장식 변경', '직원과 먼저 대화해야 한다')
		func('$menu', 'location_gray_tooltip', $menu_item_Extendedrental_gray, empty, '임차시설 계약', '직원과 먼저 대화해야 한다')
		!func('$menu', 'location_gray_tooltip', $menu_item_Cancelcontract_gray, empty, '계약 해지', '직원과 먼저 대화해야 한다.')
	else
		if $estate = 'slum_house':
			func('$menu', 'exec_options', $menu_item_Viewoptions, 'sp_txt = 2 & gt $curloc', '입주 가능지 방문')
		else
			func('$menu', 'interaction_city', $menu_item_Cancelcontract, menu_Cancelcontract, '계약 해지')
		end
		if (noble_status = 1 and $estate = 'white_house' and npc_progress['pope'] = 2 and owner = 0) or _
			($estate ! 'slum_house' and $estate ! 'white_house' and faction_fame[$replace($estate, '_house', '')] >= 4 and owner = 0):
! JO9 MOD START J9M2420 | 2026-10-12_visible_menu_prices | changed block; context may be included
			func('$menu', 'interaction_city', $menu_item_realtorBuy, menu_realtorBuy, '현 상태 주택 구매 (<<75 * estate_cost_main[$estate]>>$)')
! JO9 MOD END J9M2420
		elseif owner = 1:
			func('$menu', 'location_gray_tooltip', $menu_item_realtorBuy_gray, empty, '현 상태 주택 구매 불가', '이 집은 이미 당신과 계약하고 있다')
		elseif $estate = 'slum_house':
			func('$menu', 'location_gray_tooltip', $menu_item_realtorBuy_gray, empty, '현 상태 주택 구매 불가', '당신의 지금 버려진 집에 살고 있다')
		else
			func('$menu', 'location_gray_tooltip', $menu_item_realtorBuy_gray, empty, '현 상태 주택 구매 불가', '당신이 임대할 수 있는 다른 집이 없다')
		end
		if $estate = 'slum_house':
			func('$menu', 'location_gray_tooltip', $menu_item_Interiordesign_gray, empty, '실내장식 변경 불가', '당신의 지금 버려진 집에 살고 있다')
			func('$menu', 'location_gray_tooltip', $menu_item_Extendedrental_gray, empty, '임차시설 계약 불가', '당신의 지금 버려진 집에 살고 있다')
		else
			func('$menu', 'exec_options', $menu_item_Extendedrental, 'sp_txt = 3 & gt $curloc', '임차시설 계약')
			func('$menu', 'exec_options', $menu_item_Interiordesign, 'sp_txt = 4 & gt $curloc', '실내장식 변경')
		end
		if slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] ! 4:
			func('$menu', 'interaction_city', $menu_item_employeeestate, menu_employeeestate, '직원을 제공한다')
		else
			func('$menu', 'location_gray_tooltip', $menu_item_employeeestate_gray, empty, '직원을 제공한다', '거래 가능한 노예가 없다')
		end
		func('$menu', 'interaction_city', $menu_item_requirementsestate, menu_requirementsestate, '채용조건을 물어본다.')
	end
! JO9 MOD START J9M2419 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	func('$menu', 'city_form', $menu_item_Exittocity, menu_Exittocity, '도시 밖으로')
! JO9 MOD END J9M2419
	func('$menu', '===END===')
}

