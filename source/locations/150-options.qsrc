	ELSE
		FUNC('$menu', 'location_gray', $menu_item_laon8_gray, empty, '<font style="font-size: 75%;">7500$, 상환 10000$</font>')
	end
	func('$menu', 'exec_options', $menu_item_RefuseBorrow, 'sp_txt = 1 & gt $curloc', '화제를 바꾼다')
	func('$menu', '===END===')
}


