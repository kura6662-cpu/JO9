!Moneylender


$moneylender_options[1] = {
	npc = 1 & $npc_id = 'moneylender'
! FUNC('$menu', 'spacer', 2)
 FUNC('$menu', '===BEGIN===', 'column_0')
 if nsfw = 1: not_safe = 1
 IF credit <= 0:
  IF debt <= 0:
		FUNC('$menu', 'exec_options', $menu_item_Borrow_sparks, 'sp_txt = 2 & gt $curloc', '스파크를 빌린다')
	else
   IF sparks >= debt:
! JO9 MOD START J9M2348 | 2026-10-12_visible_menu_prices | changed block; context may be included
    FUNC('$menu', 'interaction_city', $menu_item_Repay_debt, menu_Repay_debt, '빚 갚기 (<<debt>>$)', '스파크가 부족하다')
! JO9 MOD END J9M2348
    ELSE
    FUNC('$menu', 'location_gray_tooltip', $menu_item_Repay_debt_gray, empty, '빚 갚기')
   END
  END 
 END
 IF credit > 0:
  IF sparks >= credit:
! JO9 MOD START J9M2347 | 2026-10-12_visible_menu_prices | changed block; context may be included
   FUNC('$menu', 'interaction_city', $menu_item_Repay_debt, 6332, '빚 갚기 (<<credit>>$)')
! JO9 MOD END J9M2347
   ELSE
   FUNC('$menu', 'location_gray', $menu_item_Repay_debt_gray, empty, '빚 갚기')
  END
  IF sparks >= payment:
! JO9 MOD START J9M2346 | 2026-10-12_visible_menu_prices | changed block; context may be included
   FUNC('$menu', 'interaction_city', $menu_item_Repay_debt, 6333, '의무 상환 (<<payment>>$)')
! JO9 MOD END J9M2346
   ELSE
   FUNC('$menu', 'location_gray', $menu_item_Repay_debt_gray, empty, '의무 상환')
  END
  IF deferred_payment < 3:
   FUNC('$menu', 'interaction_city', $menu_item_Repay_debt, 6334, '상환 유예 요청')
   ELSE
   FUNC('$menu', 'location_gray', $menu_item_Repay_debt_gray, empty, '상환 유예 요청')
  END
 END 
 FUNC('$menu', 'interaction_city', $menu_item_preferencesMoneylender, menu_preferencesMoneylender, '선호도 확인')
 IF slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] < 4 and credit = 0:
  FUNC('$menu', 'interaction_city', $menu_item_OfferMoneylender, menu_OfferMoneylender, '노예 제안하기')
  ELSE
  FUNC('$menu', 'location_gray_tooltip', $menu_item_OfferMoneylender_gray, empty, '노예 제안하기')
 END
 FUNC('$menu', 'city_form', $menu_item_Slums, menu_Slums, '대화 종료')
 FUNC('$menu', '===END===')
}

