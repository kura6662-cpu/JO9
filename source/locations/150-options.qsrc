$sp_text[1] = ' 집주인은 썩 좋아 보이지 않는다. 그래도 너에게 그걸 숨기려 애쓰는 건 분명하다. 하지만 주변의 모든 것에 대한 증오가 가득한 그 돌 같은 시선 너머로, 그녀가 분명 너에게서 뭔가를 원하고 있다는 걸 알아차린다. 적어도 너와 이야기할 준비는 되어 있다...'
$text_display = '<br><br>'
FUNC('$menu', '===BEGIN===', 'column_0')
IF npc_progress['Jane'] < 1: FUNC('$menu', 'interaction_city', $menu_item_jane, 10391, '제인과 이야기한다')
! JO9 MOD START J9M2257 | 2026-10-12_visible_menu_prices | changed block; context may be included
IF npc_progress['Jane'] = 1 and sparks >= 6000 and assistant_state = 0: FUNC('$menu', 'interaction_city', $menu_item_buy_kyaru, 10392, '캬루를 산다 (6000$)')
IF npc_progress['Jane'] = 1 and assistant_state = 1 and sparks >= 6000: FUNC('$menu', 'interaction_city', $menu_item_buy_kyaru_gray, 10393, '캬루를 산다 (6000$)')
IF npc_progress['Jane'] = 1 and sparks < 6000: FUNC('$menu', 'interaction_city', $menu_item_buy_kyaru_gray, 10394, '캬루를 산다 (6000$)')
! JO9 MOD END J9M2257
FUNC('$menu', 'city_form', $menu_item_kamira_street, 41, '떠난다')
FUNC('$menu', '===END===')
}

