$colosseum_options[23] = {
! JO9 MOD START J9M2350 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
	$sp_text[23] = '경주가 시작되기 전까지 남은 시간 동안 당신은 마차 개조를 주문할 수 있다. 무거운 재료가 쓰인 마차는 속도와 민첩성이 떨어진다. 하지만 경주 도중에 마차가 부서질 위험은 낮다. 스스로의 안전을 경시하는 것은 목숨을 걸고 경주에 참가하는 것과 같다.'
! JO9 MOD END J9M2350
	func('$menu', 'spacer', 1)
	func('$menu', '===BEGIN===', 'column_0')
	if heavy_frame = 1:
		func('$menu', 'exec_options', $menu_item_Pobedit, 'heavy_frame = 0 & dynamic $chariotweight & gt $curloc', '골조 : 고중량 텅스텐강')
	else
		func('$menu', 'exec_options', $menu_item_Carbon, 'heavy_frame = 1 & dynamic $chariotweight & gt $curloc', '골조 : 저중량 탄소섬유')
	end
	if heavy_boards = 1:
		func('$menu', 'exec_options', $menu_item_Armored, 'heavy_boards = 0 & dynamic $chariotweight & gt $curloc', '측면 : 방어용')
	else
		func('$menu', 'exec_options', $menu_item_Decorative, 'heavy_boards = 1 & dynamic $chariotweight & gt $curloc', '측면 : 장식용')
	end
	if heavy_chassis = 1:
		func('$menu', 'exec_options', $menu_item_Reinforced, 'heavy_chassis = 0 & dynamic $chariotweight & gt $curloc', '바닥 : 강화 바닥면')
	else
		func('$menu', 'exec_options', $menu_item_Lightweight, 'heavy_chassis = 1 & dynamic $chariotweight & gt $curloc', '바닥 : 저중량 면')
	end
	if heavy_wheels = 1:
		func('$menu', 'exec_options', $menu_item_Alloy, 'heavy_wheels = 0 & dynamic $chariotweight & gt $curloc', '바퀴 : 강화 합금철')
	else
		func('$menu', 'exec_options', $menu_item_Spoked, 'heavy_wheels = 1 & dynamic $chariotweight & gt $curloc', '바퀴 : 가벼운 지지용')
	end
	if heavy_rider_armor = 1:
		func('$menu', 'exec_options', $menu_item_Heavy, 'heavy_rider_armor = 0 & dynamic $chariotweight & gt $curloc', '운전석 : 방어장비')
	else
		func('$menu', 'exec_options', $menu_item_Light, 'heavy_rider_armor = 1 & dynamic $chariotweight & gt $curloc', '운전석 : 일반장비')
	end
	dynamic $chariotweight
	func('$menu', 'exec_options', $menu_item_chariotweight, '', '마차 무게 : <<chariot_weight>>')
	func('$menu', 'exec_options', $menu_item_ride_start, 'city_already_done_today[$str(menu_participate_race)] = 1 & gt "$ride_start"', '경주 시작!')
! JO9 MOD START J9M2349 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	func('$menu', 'city_form', $menu_item_Leave_Colosseum, menu_Leave_Colosseum, '콜로세움 밖으로')
