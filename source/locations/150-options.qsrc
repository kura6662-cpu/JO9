$stasis_options[2] = {
	if cells_unlocked = 5:
		$text_display = ''
		$sp_text[2] = '  이곳에서는 노예를 정지 상태로 보관할 수 있으며, 장치 유지 비용을 지불하는 한 그 상태는 계속 유지된다.'
	else
