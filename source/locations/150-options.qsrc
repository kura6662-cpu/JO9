}


!white palace
$palace_options[1] = {
	npc = 0
	$place = 'palace'
	$text_display = '<br><br><br>'
	func('$menu', 'spacer', 2)

	func('$menu', '===BEGIN===', 'column_0')
	if faction_fame['taurus'] >= 3:
		$sp_text[1] = '  나는 백색 궁전에 들어갈 수 있게 되었다. 이제 남은 건 누구에게 내 서비스를 제공할지 정하는 것뿐이다.'
		if npc_progress['bishop_molaru'] < 2: func('$menu', 'interaction_city', $menu_item_archbishoppalace, menu_archbishoppalace, '접견 : 대주교')
		if npc_progress['general_barabas'] < 2: func('$menu', 'interaction_city', $menu_item_generalpalace, menu_generalpalace, '접견 : 장군')
		if npc_progress['pretor_siegfrid'] < 2: func('$menu', 'interaction_city', $menu_item_praetorpalace, menu_praetorpalace, '접견 : 법무관')
	else
		$place = 'palace_gate'
		$text_display += '<br><br><br><br>'
		$sp_text[1] = '  백색 궁전 입구에는 경계심 강한 경비들이 서 있다. 낯선 자는 들여보내지 않는다.'
	end
	if faction_fame['taurus'] >= 4 and (npc_progress['taurus_king'] = 0 or npc_progress['taurus_king'] = 1):
		$sp_text[1] = '  왕을 알현할 수 있게 되었다. 나는 그를 만나서 원하는 바를 충족시켜주고자 노력할 것이다.'
		if npc_progress['taurus_king'] < 2: func('$menu', 'interaction_city', $menu_item_Kingpalace, menu_Kingpalace, '국왕 알현')
	end
	if faction_fame['taurus'] = 4 and npc_progress['taurus_king'] = 2 and noble_status = 1:
		$sp_text[1] = '  왕은 자신의 의뢰 결과에 만족했다. 그렇지만 나는 이미 타가문 소속 귀족이기 때문에 타우루스 가문 소속이 될 수는 없다.'
		faction_fame['taurus'] = 6 &! done here instead of in interaction_result_city so that older saves can visit to update their status - ImperatorAugustus
	end
	if faction_fame['taurus'] = 5 and npc_progress['taurus_king'] = 2 and noble_status = 1:
		$sp_text[1] = '  이제 나는 귀족이자 타우루스 가문의 기사이다. 도움이 필요하면 언제든 왕에게 의지할 수 있다.'
	end
	func('$menu', 'city_form', $menu_item_Leavepalace, menu_Leavepalace, '떠난다')
	func('$menu', '===END===')
}

!Administrative spires
$spire_options[1] = {
