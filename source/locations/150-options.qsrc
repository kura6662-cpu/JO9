	end
	if faction_fame['serpis'] >= 4 and (npc_progress['serpis_prince_first'] = 0 or npc_progress['serpis_prince_first'] = 1):
		$sp_text[1] = '  나는 대통령을 알현할 수 있게 되었다. 그를 만나 그의 의뢰를 완수하려 해야 한다.'
		if npc_progress['serpis_prince_first'] < 2: func('$menu', 'interaction_city', $menu_item_Presidentspires, menu_Presidentspires, '대통령 알현')
	end
	if faction_fame['serpis'] = 4 and npc_progress['serpis_prince_first'] = 2 and noble_status = 1:
		$sp_text[1] = '  대통령은 자신의 의뢰 결과에 만족했다. 그렇지만 나는 이미 타가문 소속 귀족이기 때문에 세르피스 가문 소속이 될 수는 없다.'
		faction_fame['serpis'] = 6 &! done here instead of in interaction_result_city so that older saves can visit to update their status - ImperatorAugustus
	end
	if faction_fame['serpis'] = 5 and npc_progress['serpis_prince_first'] = 2 and noble_status = 1:
		$sp_text[1] = '  이제 나는 귀족이자 세르피스 가문의 명예 시민이다. 도움이 필요하면 대통령께서 도와주실 것이다.'
	end
	func('$menu', 'city_form', $menu_item_Leavespires, menu_Leavespires, '떠난다')
	func('$menu', '===END===')
}

