$hospital_options[2] = {
	!$text_display = '<br><br>'
	func('$menu', 'spacer', 2)
	func('$menu', '===BEGIN===', 'column_0')
	if sparks >= 5 and slave['pregnant'] < 10 and (slave['fertility'] = 0 or (slave['fertility'] = -1 and slave['fertility_revealed'] = 0)) and slave['rehabilitation'] < 1:
		func('$menu', 'interaction_city', $menu_item_SSterilization, menu_SSterilization, '불임화 (5$)')
	else
		func('$menu', 'exec', $menu_item_SSterilization_gray, empty, '불임화 (5$)', iif(sparks < 5, '스파크가 부족하다. ', '') + iif(slave['pregnant'] > 1, '이미 임신 중이다. ', '') + iif(slave['fertility'] = -3, '수유 중인 노예는 임신할 수 없다. ', iif(slave['fertility'] = 1, '산란형은 불임화할 수 없다. ', iif(slave['fertility'] = -1, '이미 불임이다. ', iif(slave['fertility'] = -2, '아직 미성숙하다. ', '')))) + iif(slave['rehabilitation'] > 0, '다른 시술에서 회복 중이다. ', ''))
	end
	if sparks >= 25 and slave['boobs'] < iif(slave['age'] = CONST_INT['loli_age'], 3, 6) and slave['rehabilitation'] < 1:
