IF faction_fame['RedLight'] >= 2:
	$sp_text[1] = '   이제 내 가장 큰 목표까지 거의 다 왔다. 정말 작은 한 걸음만 남았다.'
	if npc_progress['Lukreciya'] < 2: FUNC('$menu', 'interaction_city', $menu_item_Lukreciya_palace, menu_Lukreciya_palace, '접견: 루크레치야')
