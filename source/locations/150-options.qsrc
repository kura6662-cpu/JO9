!Hunting Prize
$hunting_prize_options[1] = {
! JO9 MOD START J9M2445 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
	$sp_text[1] = '네 사냥 전리품을 어떻게 할까?'
! JO9 MOD END J9M2445
	if hunting_prize = 2:
		$sp_text[1] = ' 당신은 잠시간 욕망을 풀고, <<$stock_noun2[stock["age"]]>>에게서 떨어졌다. 여자는 진흙속에서 마치 태아처럼 웅크리고, 가랑이 사이로 정액을 흘리며 흐느낀다. 전투의 긴장도 풀렸으니, 이제 무엇을 할지 차분하게 생각해보자.'																																																														  
	elseif master_excitement >= 1 and master_mood ! -5 and master_excitement + stock['beauty'] + stock['exotic'] > 4:
! JO9 MOD START J9M2444 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
		$sp_text[1] = '치열한 전투가 끝났고, 여자는 헐벗은채 겁에 질려있다.'
! JO9 MOD END J9M2444
		if stock['beauty'] > 3: $text[1] += ' 그녀는 꽤 아릅답다.'
		$sp_text[1] += ' ...당신은'
		if master_excitement > 1: $text[1] += ' 아주 흥분하고 있다.'
		$sp_text[1] += ' 지금 당장 이 여자를 범하고 싶다. 지금 바로 여기에서. 당장.'
		$sp_text[1] += '<br><br> 당신의 전리품으로 무엇을 할 것인가?'
	end
	$return_lock  = 'menu_form'
	$text_display = '<br>'
	if nsfw = 0: $text_display +=  func('display_fullimage', 'stock', 'center_Isabella')
	prize_cryo_nr = 0
	if iced_1_state = CONST_INT['no_slave']: 
		prize_cryo_nr = 1
	elseif iced_2_state = CONST_INT['no_slave']:
		prize_cryo_nr = 2
	elseif iced_3_state = CONST_INT['no_slave']:
		prize_cryo_nr = 3
	elseif cells_unlocked >= 1:
		if iced_4_state = CONST_INT['no_slave']:
			prize_cryo_nr = 4
		elseif iced_5_state = CONST_INT['no_slave']:
			prize_cryo_nr = 5
		elseif iced_6_state = CONST_INT['no_slave']:
			prize_cryo_nr = 6
		elseif cells_unlocked >= 2:
			if iced_7_state = CONST_INT['no_slave']:
				prize_cryo_nr = 7
			elseif iced_8_state = CONST_INT['no_slave']:
				prize_cryo_nr = 8
			elseif iced_9_state = CONST_INT['no_slave']:
				prize_cryo_nr = 9
			elseif cells_unlocked >= 3:
				if iced_10_state = CONST_INT['no_slave']:
					prize_cryo_nr = 10
				elseif iced_11_state = CONST_INT['no_slave']:
					prize_cryo_nr = 11
				elseif iced_12_state = CONST_INT['no_slave']:
					prize_cryo_nr = 12
				elseif cells_unlocked >= 4:
					if iced_13_state = CONST_INT['no_slave']:
						prize_cryo_nr = 13
					elseif iced_14_state = CONST_INT['no_slave']:
						prize_cryo_nr = 14
					elseif iced_15_state = CONST_INT['no_slave']:
						prize_cryo_nr = 15
					elseif cells_unlocked >= 5:
						if iced_16_state = CONST_INT['no_slave']:
							prize_cryo_nr = 16
						elseif iced_17_state = CONST_INT['no_slave']:
							prize_cryo_nr = 17
						elseif iced_18_state = CONST_INT['no_slave']:
							prize_cryo_nr = 18
						end
					end
				end
			end
		end
	end

	func('$menu', 'spacer', 1)
	func('$menu', '===BEGIN===', 'column_0')
	if hunting_prize = 1 and master_excitement >= 1 and master_mood ! -5 and master_excitement + stock['beauty'] + stock['exotic'] > 4:
		func('$menu', 'interaction_city', $menu_item_Vaginal_Rape, menu_prize_rape, '전리품을 강간한다')
	end
	if slave_state ! CONST_INT['no_slave']:
		if dungeon = 1 and prisoner_state = CONST_INT['no_slave']: func('$menu', 'interaction_city', $menu_item_Checkcell, menu_prize_prisoner, '감방에 가둔다')
	else
		func('$menu', 'interaction_city', $menu_item_slave_act, menu_enslave, '데리고 간다')
		if barn = 1 and pig_state = CONST_INT['no_slave']: func('$menu', 'interaction_city', $menu_item_Pig, menu_prize_pig, '외양간 돼지로 만든다') &! 현재 노예가 없을 때만, 저항할 수 있기 때문
	end
	if prize_cryo_nr > 0:
		func('$menu', 'interaction_city', $menu_item_Rentcapsule, menu_prize_cryo, '크라이오 보관소에 넣는다')
	end
	func('$menu', 'interaction_city', $menu_item_Slaughter_slave, menu_prize_slaughter, '스파크용으로 도축한다')
! JO9 MOD START J9M2443 | 2026-10-12_visible_menu_prices | changed block; context may be included
	func('$menu', 'interaction_city', $menu_item_butcher_slave, menu_prize_butcher, '고기용 도축하기 (5$)')
! JO9 MOD END J9M2443
	func('$menu', 'interaction_city', $menu_item_marketbuy, menu_prize_sell, '경매에 부친다')
	func('$menu', '===END===')
}





!guild expert
$expert_options[1] = {
	npc = 1 & $npc_id = 'master_skups'
! JO9 MOD START J9M2442 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
	$sp_text[1] = '당신은 노예 조사부의 대표자를 만났다. 이 조교사들은 노예를 평가하는 일과 시장에서 고급 노예들을 찾는데의 전문가들이다.'
! JO9 MOD END J9M2442
	$text_display = '<br><br>'
	func('$menu', 'spacer', 2)
	func('$menu', '===BEGIN===', 'column_0')
	func('$menu', 'interaction_city', $menu_item_services, menu_services, '이곳의 업무에 대하여 묻는다')
	if search['active'] = 0: func('$menu', 'exec_options', $menu_item_Order_slave, 'sp_txt = 11 & gt $curloc', '노예탐색 의뢰')
	if search['active'] = 1: func('$menu', 'interaction_city', $menu_item_Cancelservices, menu_Cancelservices, '의뢰 취소')
	if search['active'] = 3: func('$menu', 'interaction_city', $menu_item_Pickservices, menu_Pickservices, '노예를 데려간다')
! JO9 MOD START J9M2441 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	func('$menu', 'goto_city', $menu_item_end_conv, guild, '#options', 'guild', '대화 종료')
! JO9 MOD END J9M2441
	func('$menu', '===END===')
}

$expert_options[11] = {
	npc = 1 & $npc_id = 'master_skups'
	killvar 'search'
! JO9 MOD START J9M2440 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$sp_text[11] = '[마스터 스컵스]<br>&nbsp;원하는 나이대가 있습니까?</div>'
! JO9 MOD END J9M2440
	$text_display = '<br>'
	func('$menu', 'spacer', 1)

	func('$menu', '===BEGIN===', 'column_0')
	func('$menu', 'exec_options', $menu_item_Not_old, 'search["age"] = 4 & search["cost"] += 1 & sp_txt = 2 & gt $curloc', '성숙만 빼고')
	func('$menu', 'exec_options', $menu_item_Not_young, 'search["age"] = 5 & search["cost"] += 1 & sp_txt = 2 & gt $curloc', '아동만 빼고')
	func('$menu', 'exec_options', $menu_item_Order_Mature, 'search["age"] = 1 & search["cost"] += 2 & sp_txt = 2 & gt $curloc', '성숙')
	func('$menu', 'exec_options', $menu_item_Order_Young, 'search["age"] = 2 & search["cost"] += 2 & sp_txt = 2 & gt $curloc', '젊음')
	func('$menu', 'exec_options', $menu_item_Order_Child, 'search["age"] = 3 & search["cost"] += 2 & sp_txt = 2 & gt $curloc', '아동')
	func('$menu', 'exec_options', $menu_item_Not_matter, 'search["age"] = 0 & sp_txt = 2 & gt $curloc', '상관 없음')
	func('$menu', '===END===')
}

$expert_options[2] = {
	npc = 1 & $npc_id = 'master_skups'
! JO9 MOD START J9M2439 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$sp_text[2] = '[마스터 스컵스]<br>&nbsp;외모는 중요한 지표입니다. 외모에 따라 노예의 최대 잠재력이 결정되기 때문이죠. 그러나 미인들은 흔치 않습니다. 당신이 필요한 상품은 어떤 것입니까?</div>'
! JO9 MOD END J9M2439
	$text_display = '<br><br>'
	func('$menu', 'spacer', 2)

	func('$menu', '===BEGIN===', 'column_0')
	func('$menu', 'exec_options', $menu_item_Order_Exquisite, 'search["beauty"] = 5 & search["cost"] += 4 & sp_txt = 3 & gt $curloc', '눈부신 외모의 노예')
	func('$menu', 'exec_options', $menu_item_Order_Beautiful, 'search["beauty"] = 4 & search["cost"] += 2 & sp_txt = 3 & gt $curloc', '아름다운 노예')
	func('$menu', 'exec_options', $menu_item_Order_Pretty, 'search["beauty"] = 3 & search["cost"] += 1 & sp_txt = 3 & gt $curloc', '예쁜 노예')
	func('$menu', 'exec_options', $menu_item_beauty_Not_matter, 'search["beauty"] = 0 & sp_txt = 3 & gt $curloc', '상관 없음')
	func('$menu', '===END===')
}

$expert_options[3] = {
	npc = 1 & $npc_id = 'master_skups'
! JO9 MOD START J9M2438 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$sp_text[3] = '[마스터 스컵스]<br>&nbsp;병치레가 잦은 노예를 조교하는 것은 힘든 일입니다, 더 건강하고 튼튼한 것으로 골라드릴 수 있습니다.</div>'
! JO9 MOD END J9M2438
	$text_display = '<br><br>'
	func('$menu', 'spacer', 2)

	func('$menu', '===BEGIN===', 'column_0')
