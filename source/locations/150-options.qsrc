	end
	!$text_display += {<br><div id="under_gray">- Tell me about the art of combat<br></div>}
	func('$menu', 'interaction_city', $menu_item_preferencesLanista, menu_preferencesLanista, '원하는 노예를 물어본다')
	if slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] ! 4:
		func('$menu', 'interaction_city', $menu_item_merchandiseLanista, menu_merchandiseLanista, '검투사를 제공한다')
	else
		func('$menu', 'location_gray_tooltip', $menu_item_merchandiseLanista_gray, empty, '검투사를 제공한다', '거래 가능한 노예가 없다')
	end
! JO9 MOD START J9M2353 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	func('$menu', 'exec_options', $menu_item_Leavecolosseum_options, 'sp_txt = 1 & gt $curloc', '대화 종료')
! JO9 MOD END J9M2353
	func('$menu', '===END===')
}

