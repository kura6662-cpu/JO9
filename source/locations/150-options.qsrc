		func('$menu', 'interaction_city', $menu_item_Cell2, menu_Cell2, '셀 №2: 임대 (하루 1$)')
	else
		func('$menu', 'location_gray', $menu_item_Cell2, empty, '셀 №2: 비어 있음')
	end
	if iced_3_state ! CONST_INT['no_slave']:
