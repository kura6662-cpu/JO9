	if faction_fame['kamira'] = 5 and npc_progress['tiamath'] = 2 and noble_status = 1:
		$sp_text[1] = '  이제 나는 귀족이자 카미라 가문의 용 무리이다. 도움이 필요하면 티아마트가 나를 저버리지 않을 것이다.'
	end
	func('$menu', 'city_form', $menu_item_LeaveCitadel, menu_LeaveCitadel, '떠난다')
	func('$menu', '===END===')
}

!Raven tower
$tower_options[1] = {
	$place = 'tower'
	$text_display = '<br><br><br>'
	func('$menu', 'spacer', 2)

	func('$menu', '===BEGIN===', 'column_0')
	if faction_fame['korvus'] >= 3:
		$sp_text[1] = '  구울들이 나를 신뢰한다. 이제 나는 레이븐 타워 안으로 들어갈 수 있다. 이제 남은 건 누구에게 내 서비스를 제안할지 고르는 것뿐이다.'
		if npc_progress['bishop_nerilis'] < 2: func('$menu', 'interaction_city', $menu_item_archbishoptower, menu_archbishoptower, '접견 : 대주교')
		if npc_progress['hand_of_the_knyaz'] < 2: func('$menu', 'interaction_city', $menu_item_righthandtower, menu_righthandtower, '접견 : 대공의 손')
		if npc_progress['pretor_kamael'] < 2: func('$menu', 'interaction_city', $menu_item_praetortower, menu_praetortower, '접견 : 법무관')
	else
		$place = 'tower_gate'
		$sp_text[1] = '  언데드 나이트 하나가 레이븐 타워를 굳건히 지키고 서 있다. 초대도 없이 그를 지나가려 드는 건 자살행위나 다름없다.'
		$text_display += '<br><br><br><br>'
	end
	if faction_fame['korvus'] >= 4 and (npc_progress['korvus_knyaz'] = 0 or npc_progress['korvus_knyaz'] = 1):
		$sp_text[1] = '  나는 공작을 알현할 수 있게 되었다. 그를 만나 그의 의뢰를 완수하려 해야 한다.'
		if npc_progress['korvus_knyaz'] < 2: func('$menu', 'interaction_city', $menu_item_Princetower, menu_Princetower, '대공 알현')
	end
	if faction_fame['korvus'] = 4 and npc_progress['korvus_knyaz'] = 2 and noble_status = 1:
		$sp_text[1] = '  공작은 그의 주문에 만족했다. 그렇지만 나는 이미 타가문 소속 귀족이기 때문에 코르부스 가문 소속이 될 수는 없다.'
		faction_fame['korvus'] = 6 &! done here instead of in interaction_result_city so that older saves can visit to update their status - ImperatorAugustus
	end
	if faction_fame['korvus'] = 5 and npc_progress['korvus_knyaz'] = 2 and noble_status = 1:
		$sp_text[1] = '  이제 나는 귀족이자 코르부스 가문의 노블 블러드이다. 도움이 필요하면 공작이 나를 지원해 줄 것이다.'
	end
	
	func('$menu', 'city_form', $menu_item_Leavetower, menu_Leavetower, '떠난다')
	func('$menu', '===END===')
}

!Vatican
$vatican_options[1] = {
	$place = 'vatican'
	$text_display = '<br><br><br>'
	func('$menu', 'spacer', 2)

	func('$menu', '===BEGIN===', 'column_0')
	if brand_reputation >= 5:
		if npc_progress['cardinal_de_mujlon'] < 2:
			$sp_text[1] = '  교황에게 가려면 먼저 추기경을 위해 일을 하나 해내야 한다.'
			func('$menu', 'interaction_city', $menu_item_CardinalVatican, menu_CardinalVatican, '접견: 추기경')
		else
			$text_display += '<br><br>'
		end
		if npc_progress['cardinal_de_mujlon'] = 2 and npc_progress['pope'] < 2:
			$sp_text[1] = '  이제 나는 교황을 알현할 수 있다. 그를 만나 그의 의뢰를 완수하려 해야 한다.'
			func('$menu', 'interaction_city', $menu_item_PopeVatican, menu_PopeVatican, '교황 알현')
		else
			$text_display += '<br><br>'
		end
		if npc_progress['pope'] = 2 and noble_status = 1:
			$sp_text[1] = '  이제 나는 백색 도시의 귀족이자 교황의 특사이다. 도움이 필요하면 교황이 나를 도와줄 것이다.'
		end
	else
		$place = 'vatican_gate'
		$sp_text[1] = '  바티칸의 문은 매우 삼엄하게 지켜지고 있다. 들어가려면 특별한 초대가 필요하다.'
		$text_display += '<br><br><br><br>'
	end
	func('$menu', 'city_form', $menu_item_LeaveVatican, menu_LeaveVatican, '떠난다')
	func('$menu', '===END===')
}

!Gentleman’s club
$club_options[1] = {
	$sp_text[1] = '  셸리 경의 젠틀맨스 클럽은 휴식뿐 아니라 사업 면에서도 훌륭한 기회를 제공한다. 여기서는 많은 잠재 고객을 찾을 수 있고, 아니면 최소한 주인에게 직접 노예를 팔 수도 있다.'
