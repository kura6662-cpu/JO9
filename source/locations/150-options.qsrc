IF lost_quest_slave = 0 and lost_quest_slave_jasmine = 0 and active[$event['Akabur_quest']] > 1 and slave_type ! 2616 and active[$event['Akabur_quest']] < 12: FUNC('$menu', 'interaction_city', $menu_item_Witch_Pamela, 3003, '파멜라와 이야기한다')
IF lost_quest_slave = 1 or lost_quest_slave_jasmine = 1: FUNC('$menu', 'interaction_city', $menu_item_Witch_Pamela, 30030, '파멜라와 이야기한다')
IF lost_quest_slave = 0 and lost_quest_slave_jasmine = 0 and active[$event['Akabur_quest']] > 1 and slave_type = 2616 and npc_progress['elsa'] < 3: FUNC('$menu', 'interaction_city', $menu_item_Witch_Pamela, 30031, '파멜라와 이야기한다')
IF lost_quest_slave = 0 and lost_quest_slave_jasmine = 0 and active[$event['Akabur_quest']] > 11 and slave_type ! 2616 and npc_progress['elsa'] < 3: FUNC('$menu', 'interaction_city', $menu_item_Witch_Pamela, 3004, '파멜라와 이야기한다')
IF lost_quest_slave = 0 and lost_quest_slave_jasmine = 0 and active[$event['Akabur_quest']] < 13 and npc_progress['elsa'] = 3 and slave_type ! 2617 and npc_progress['Jafar'] ! 1 and npc_progress['Jasmine'] < 3: FUNC('$menu', 'interaction_city', $menu_item_Witch_Pamela, 30040, '파멜라와 이야기한다')
IF lost_quest_slave = 0 and lost_quest_slave_jasmine = 0 and active[$event['Akabur_quest']] < 14 and npc_progress['elsa'] = 3 and slave_type = 2617 and npc_progress['Jasmine'] < 3: FUNC('$menu', 'interaction_city', $menu_item_Witch_Pamela, 30041, '파멜라와 이야기한다')
IF lost_quest_slave = 0 and lost_quest_slave_jasmine = 0 and active[$event['Akabur_quest']] = 12 and npc_progress['Jafar'] = 1 and npc_progress['elsa'] = 3 and npc_progress['jasmine'] = 3: FUNC('$menu', 'interaction_city', $menu_item_Witch_Pamela, 30045, '파멜라와 이야기한다')
FUNC('$menu', '===END===')
}
$russiankvartal_detinec_options[1] = {
$place = 'russiankvartal_detinec'
$sp_text[1] = ' '
$text_display = '<br><br>'
FUNC('$menu', 'spacer', 4)
FUNC('$menu', '===BEGIN===', 'column_0')
IF faction_fame['russiankvartal'] >= 3: 
	$sp_text[1] = '  여기 정말 아름답다! 이 모든 부의 주인이 누구인지 알아보자...'
	if npc_progress['Alesha'] < 2: FUNC('$menu', 'interaction_city', $menu_item_Alesha, 12041, 'Аlesha')
	else
	$place = 'russiankvartal_detinec_gate'
	if nsfw = 1: not_safe = 1
	$text_display += '<br><br><br><br>'
	$sp_text[1] = '  왕자 궁정 입구에는 아주 멋진 경비들이 근무 중이다. 저들의 무기가 어떻게 생겼는지 보면 흥미로울 것 같다...'
END
IF faction_fame['russiankvartal'] >= 4 and npc_progress['Alesha'] = 2 and (npc_progress['Jinn'] = 0 or npc_progress['Jinn'] = 1):
	$sp_text[1] = ' 나는 왕자를 알현할 수 있게 되었다. 어떤 결과가 나올지 보자...'
	if npc_progress['Jinn'] < 2: FUNC('$menu', 'interaction_city', $menu_item_Jinn, 12043, '드미트리 왕자')
END
IF faction_fame['russiankvartal'] = 4 and npc_progress['Jinn'] = 2 and noble_status = 1:
	$sp_text[1] = ' 이제 나는 러시아 구역에서 언제나 환영받는다. 러시아 곰들도 사람들만큼 친근한지 궁금하군?...'
END
IF faction_fame['russiankvartal'] = 5 and npc_progress['Jinn'] = 2 and noble_status = 1:
	if hero_choice < 100: $sp_text[1] = ' 나는 러시아 구역에서 그들 중 하나로 받아들여졌다. 필요하다면 곰들조차 나를 위해 나설 것이다...'
	if hero_choice > 100: $sp_text[1] = ' 나는 러시아 구역에서 그들 중 하나로 받아들여졌다. 필요하다면 곰들조차 나를 위해 나설 것이다...'
END
FUNC('$menu', 'interaction_city', $menu_item_russiankvartal, 1200, '떠난다')
FUNC('$menu', '===END===')
}

