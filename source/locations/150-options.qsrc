!Port

$port_options[1] = {
FUNC('$menu', 'spacer', 1)
$sp_text[1] = ' '
$text_display = '<br><br>'
FUNC('$menu', '===BEGIN===', 'column_0')
FUNC('$menu', 'exec_options', $menu_item_kap, 'sp_txt = 2 & gt $curloc', '선장과 이야기한다')
IF port_service = 1 and npc_progress['rafael'] < 2: FUNC('$menu', 'interaction_city', $menu_item_rafael, 10405, '라파엘과 이야기한다')

IF slave_state = CONST_INT['slave_exist'] and slave['energy'] >= 3:
	FUNC('$menu', 'interaction_city', $menu_item_port_service, 10410, '노예를 창녀로 보낸다')
ELSE
	FUNC('$menu', 'location_gray', $menu_item_port_service_gray, empty, '노예를 창녀로 보낸다')
END

IF hero_choice > 100 and master_energy >= 3: FUNC('$menu', 'interaction_city', $menu_item_port_service, 10420, '일자리를 찾는다')
IF hero_choice > 100 and master_energy >= 3 and slave['energy'] >= 3: FUNC('$menu', 'interaction_city', $menu_item_port_service, 10434, '파트타임으로 일한다')
IF hero_choice > 100 and master_energy >= 3 and slave['energy'] >= 3 and assistant['energy'] >= 3: FUNC('$menu', 'interaction_city', $menu_item_port_service, 10435, '파트타임으로 일한다')
IF port_service < 1: FUNC('$menu', 'interaction_city', $menu_item_port, 10404, '항구에 대해 묻는다')
FUNC('$menu', 'city_form', $menu_item_city_gate, menu_city_gate, '떠난다')
FUNC('$menu', '===END===')
}
$port_options[2] = {
FUNC('$menu', 'spacer', 1)
$sp_text[3] = ' '
$text_display = '<br><br>'
FUNC('$menu', '===BEGIN===', 'column_0')
FUNC('$menu', 'interaction_city', $menu_item_kap, 10401, '취향을 확인한다')

IF slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] < 4:
 FUNC('$menu', 'interaction_city', $menu_item_port_service, 10402, '노예를 제안한다')
ELSE
 FUNC('$menu', 'location_gray', $menu_item_port_service_gray, empty, '노예를 제안한다')
END

FUNC('$menu', 'exec_options', $menu_item_port, 'sp_txt = 1 & gt $curloc', '대화를 끝낸다')
