$teatr_options[2] = {
$place = 'fogs_paradise'
$sp_text[2] = "이른바 천국이라 불리는 이곳에 할당된 광대한 구역을 아름다운 무엇에 비유할 수 있다면, 그것도 정말 억지였을 것이다. 곳곳에 파인 동굴과 은신처들, 그리고 짙은 회색 안개에 둘러싸인 정원과 분수들은 이 기묘한 풍경 속에서 무언가 몹시 야성적으로 느껴졌다. 하지만 그 모든 음울함을 배경으로, 등에 날개를 붙인 벌거벗은 여자애들은 정말 바라보는 즐거움 그 자체였다. 참으로 천국답다!"
$text_display = '<br><br>'
FUNC('$menu', 'spacer', 0)
FUNC('$menu', '===BEGIN===', 'column_0')
  if active[$quest[17]] = 1 and npc_progress['angel'] < 2:FUNC('$menu', 'interaction_city', $menu_item_angel, 7921, '천사와 만난다')
  if npc_progress['angel'] = 2 and npc_progress['arhangel'] < 2:FUNC('$menu', 'interaction_city', $menu_item_arhangel, 7922, '대천사를 만난다')
  if npc_progress['arhangel'] = 2 and npc_progress['black_arhangel'] < 2:FUNC('$menu', 'interaction_city', $menu_item_black_arhangel, 7923, '검은 대천사를 만난다')
  FUNC('$menu', 'city_form', $menu_item_city_gate, 120, '떠난다')
FUNC('$menu', '===END===')
}
$teatr_options[3] = {
$place = 'fogs_hell'
$sp_text[3] = "지옥에 온 걸 환영한다! 현지 장식가들은 천국의 대척점이 되는 무대 연출을 훌륭하게 해냈다. 그리고 현지 극장쟁이들이 만들어 낸 전체적인 콘셉트를 보면, 지옥은 그들에게 훨씬 더 익숙한 장소인 모양이다. 적어도 네가 상상한 그것과 꽤 비슷해 보인다. 최소한 뜨겁고, 음침하고, 즐거움이라고는 없다. 이제 남은 건 그 안을 직접 체험해 보는 것뿐이다..."
