	end
	func('$menu', 'interaction_city', $menu_item_requirementsclub, menu_requirementsclub, '요구 사항을 묻는다')
	func('$menu', 'city_form', $menu_item_Leaveclub, menu_Leaveclub, '클럽을 떠난다')
	func('$menu', '===END===')
	}

	$club_options[2] = {
