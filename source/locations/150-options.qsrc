	end
	if spm_number < (master_fighter - boost_up['master_fighter']) and $master_spm[5] = '' and master_energy > 2:
		func('$menu', 'exec_options', $menu_item_special_technique, 'sp_txt = 5 & gt $curloc', '필살기를 배운다')
	elseif master_energy <= 2:
		func('$menu', 'location_gray_tooltip', $menu_item_special_technique_gray, empty, '필살기를 배운다', '행동력이 부족하다')
