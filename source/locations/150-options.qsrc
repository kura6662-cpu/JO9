!Beginning of the Exclusion Zone.
$safari_options[1] = {
$sp_text[1] = ' 노예 사냥은 언제나 골치 아픈 일이었다. 그리고 사파리에서 이겨 새 노예를 얻는 건 꽤 괜찮은 보너스다. 하지만 먹잇감으로 뭘 하든 네 마음이다. 예를 들어 고기로 만들어 버릴 수도 있지. 노예는 원래 그런 용도로 쓰이니까.'
$text_display = '<br><br>'
FUNC('$menu', 'spacer', 3)
FUNC('$menu', '===BEGIN===', 'column_0')
IF safari.slave = -1:
 FUNC('$menu', 'interaction_city', $menu_item_employeecamp, 8994, '전리품을 풀어 준다')
! JO9 MOD START J9M2332 | 2026-10-12_visible_menu_prices | changed block; context may be included
 FUNC('$menu', 'interaction_city', $menu_item_employeecamp, 8995, '전리품을 판다 (~100$)')
! JO9 MOD END J9M2332
 FUNC('$menu', 'interaction_city', $menu_item_employeecamp, 8996, '전리품을 죽인다')
 IF slave_state = CONST_INT['no_slave']:
  FUNC('$menu', 'interaction_city', $menu_item_employeecamp, 8998, '전리품을 데려간다')
 ELSE:
  FUNC('$menu', 'location_gray', $menu_item_employeecamp_gray, empty, '전리품을 데려간다')
 END
ELSE:
IF slave_state = CONST_INT['slave_exist']:
 FUNC('$menu', 'interaction_city', $menu_item_employeecamp, 8992, '노예를 제안한다')
ELSE
 FUNC('$menu', 'location_gray', $menu_item_employeecamp_gray, empty, '노예를 제안한다')
END
IF sparks >= 350 and master_energy >= 2:
! JO9 MOD START J9M2331 | 2026-10-12_visible_menu_prices | changed block; context may be included
 FUNC('$menu', 'interaction_city', $menu_item_requirementscamp, 8993, '참가한다 (350$)')
! JO9 MOD END J9M2331
 ELSE
! JO9 MOD START J9M2330 | 2026-10-12_visible_menu_prices | changed block; context may be included
FUNC('$menu', 'location_gray', $menu_item_employeecamp_gray, empty, '참가한다 (350$)')
! JO9 MOD END J9M2330
 END
FUNC('$menu', 'interaction_city', $menu_item_requirementscamp, 8997, '사파리를 구경한다')
FUNC('$menu', 'city_form', $menu_item_Leavecamp, 119, '사파리를 떠난다')
END
FUNC('$menu', '===END===')
}

$CherniyLes_options[1] = {
$place = 'CherniyLes_gate'
$text_display = '<br><br><br>'
FUNC('$menu', 'spacer', 2)
FUNC('$menu', '===BEGIN===', 'column_0')

IF faction_fame['otchuzhdenie'] >= 3:
	$sp_text[1] = ' 자, 들어왔다. 이제 남은 건 누구에게 내 서비스를 제안할지 고르는 것뿐이다.'
	if npc_progress['Voland'] < 2: FUNC('$menu', 'interaction_city', $menu_item_Voland_palace, 8101, '접견: 볼란드')
	if npc_progress['Varvar'] < 2: FUNC('$menu', 'interaction_city', $menu_item_Varvar_palace, 8102, '접견: 바르바르')
	if npc_progress['BlackWarrior'] < 2: FUNC('$menu', 'interaction_city', $menu_item_BlackWarrior_palace, 8103, '접견: 블랙워리어')
	else
	$place = 'CherniyLes_gate'
	if nsfw = 1: not_safe = 1
	$text_display += '<br><br><br><br>'
	$sp_text[1] = ' 검은 숲 입구에는 제법 예쁜 아마존들이 경비를 서고 있다. 생김새를 보면 단순한 경비일 뿐 아니라 최소한 창녀 노릇도 하는 듯하다. 물론 저들을 몰래 지나칠 가능성은 거의 없지만, 시도는 해 볼 수 있겠다.'
END
IF faction_fame['otchuzhdenie'] >= 4 and (npc_progress['Varvar_king'] = 0 or npc_progress['Varvar_king'] = 1):
	$sp_text[1] = ' 나는 야만왕을 알현할 수 있게 되었다. 어서 그를 만나 그의 의뢰를 완수해 보아야 한다.'
	if npc_progress['Varvar_king'] < 2: FUNC('$menu', 'interaction_city', $menu_item_Varvar_king_palace, 8104, '야만왕 알현')
END
!IF faction_fame['otchuzhdenie'] = 4 and npc_progress['Varvar_king'] = 2 and noble_status = 1:
!	$sp_text[1] = ' 야만왕은 자신의 의뢰 결과에 만족했다. 이제 무슨 일이 생기더라도 나는 검은 숲 깊숙한 곳에 몸을 숨길 수 있다.'
!END
IF faction_fame['otchuzhdenie'] = 5 and npc_progress['Varvar_king'] = 2 and noble_status = 1:
	$sp_text[1] = ' 이제 나는 배제 구역에서 제법 이름난 인물이다. 도움이 필요하면 야만왕이 나를 도와줄 것이다.'
END
if active[$quest[14]] = 2 and active[$quest[15]] < 2: FUNC('$menu', 'interaction_city', $menu_item_Varvar_king_palace, 1550, '야만왕과 이야기한다')
FUNC('$menu', 'city_form', $menu_item_otchuzhdenie, 119, '떠난다')
FUNC('$menu', '===END===')
}

$studfarm_options[1] = {
$sp_text[1] = ' 말 복장을 한 아름답고 늘씬한 여자들을 바라보는 일은 아무리 해도 질리지 않는다. 그리고 그들이 특유의 정확한 움직임으로 눈을 즐겁게 하면, 그대로 미쳐 버릴 것만 같다. 종마장 안에서는 아이들과 노는 일부터 화물 운반, 콜로세움 투기장에서의 화려한 승리까지 어떤 과제든 해낼 수 있는 평범한 포니걸들을 재료로, 이런 독특한 혈통의 말들이 만들어진다. '
$text_display = '<br><br><br>'
FUNC('$menu', 'spacer', -1)
FUNC('$menu', '===BEGIN===', 'column_0')
 FUNC('$menu', 'interaction_city', $menu_item_elisabet, 99111, '목장에 대해 알아본다')
END
FUNC('$menu', 'exec_options', $menu_item_elisabet, 'sp_txt = 2 & gt $curloc', '요구 사항을 확인한다')
IF slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] < 4:
 FUNC('$menu', 'interaction_city', $menu_item_studfarm, 99211, '포니걸을 제안한다')
 ELSE
 FUNC('$menu', 'location_gray', $menu_item_studfarm_gray, empty, '포니걸을 제안한다')
 END
END
IF slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] < 4:
 FUNC('$menu', 'interaction_city', $menu_item_studfarm, 99212, '생산용 암말을 제안한다')
 ELSE
 FUNC('$menu', 'location_gray', $menu_item_studfarm_gray, empty, '생산용 암말을 제안한다')
 END
END
IF slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] < 4:
 FUNC('$menu', 'interaction_city', $menu_item_studfarm, 99213, '승용마를 제안한다')
 ELSE
 FUNC('$menu', 'location_gray', $menu_item_studfarm_gray, empty, '승용마를 제안한다')
 END
END
IF slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] < 4:
 FUNC('$menu', 'interaction_city', $menu_item_studfarm, 99214, '마차용 말을 제안한다')
 ELSE
FUNC('$menu', 'location_gray', $menu_item_studfarm_gray, empty, '마차용 말을 제안한다')
 END
END
IF slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] < 4:
 FUNC('$menu', 'interaction_city', $menu_item_studfarm, 99215, '경주마를 제안한다')
 ELSE
FUNC('$menu', 'location_gray', $menu_item_studfarm_gray, empty, '경주마를 제안한다')
 END
END
FUNC('$menu', 'city_form', $menu_item_otchuzhdenie, 119, '떠난다')
FUNC('$menu', '===END===')
}

