		func('$menu', 'interaction_city', $menu_item_Cell3, menu_Cell3, '셀 №3: 임대 (하루 1$)')
	else
		func('$menu', 'location_gray', $menu_item_Cell3, empty, '셀 №3: 비어 있음')
	end
	
	if cells_unlocked >= 1:
