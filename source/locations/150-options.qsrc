		if npc_progress['pretor_diabaz'] < 2: func('$menu', 'interaction_city', $menu_item_praetorspires, menu_praetorspires, '접견 : 법무관')
	else
		$place = 'spire_gate'
		if nsfw = 1: not_safe = 1
