else
	$place = 'Zakritiy_klub'
	if nsfw = 1: not_safe = 1
	$text_display += '<br><br><br><br>'
	$sp_text[1] = '   "프라이빗 클럽" 입구에는 꽤 매력적인 경비가 서 있다. 저 탄탄한 몸을 보아하니, 그녀와의 대화는 오래 끌지 않는 모양이다...'
END

IF faction_fame['RedLight'] >= 4 and (npc_progress['Konstantin'] = 0 or npc_progress['Konstantin'] = 1):
	$sp_text[1] = '   콘스탄틴과 만날 약속은 받아 냈다. 이제 정면으로 들이받을 때다.'
	if npc_progress['Konstantin'] < 2: FUNC('$menu', 'interaction_city', $menu_item_Konstantin_palace, menu_Konstantin_palace, '콘스탄틴 알현')
