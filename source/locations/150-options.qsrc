# #options
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2446 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '#options': gs 'snk_room_bridge', 'guard', '#options'
! JO9 MOD END J9M2446
!DIALOG OPTIONS DATABASE

!empty location
$blank_options[1] = {
	$text_display = '<br><br><br><br><br><br><br>'
	$text_display += '<br><div id="under">떠나기<br><div id = "clear"><a href = ''EXEC: city_form = 11 & gt "city_menu_form"''><img src = "content\pic\clear.png"></a></div></div>'
}

$computer_options[1] = {
	$sp_text[1] = '  데이터베이스는 음성 명령으로 접근할 수 있으며, 요청한 정보도 같은 방식으로 제공된다. 다만 필요할 경우에는 출력할 수도 있다.'
	$text_display = '<br>'
	if nsfw = 1: not_safe = 1
	func('$menu', 'spacer', 4)

	func('$menu', '===BEGIN===', 'column_0')
	func('$menu', 'interaction_city', $menu_item_Aura_information, menu_Aura_information, '오라: 일반 정보')
	func('$menu', 'interaction_city', $menu_item_Aura_Pattern, menu_Aura_Pattern, '오라: 패턴 구조')
	func('$menu', 'city_form', $menu_item_terminal, menu_terminal, '터미널 종료')
	func('$menu', '===END===')
}

!border of the fogs
$edge_of_mists[102016] = {
mem_skip = 102016
$text_display = '<br>'
FUNC('$menu', 'spacer', 4)
FUNC('$menu', '===BEGIN===', 'column_0')
IF sparks >= 50000 and slave_state = CONST_INT['no_slave'] > 0: FUNC('$menu', 'join_battle1', $menu_item_Joinbattle, '전투 시작')
FUNC('$menu', 'city_form', $menu_item_Leavethem, 121, '전투를 포기한다')
FUNC('$menu', '===END===')
}





