	func('$menu', 'interaction_city', $menu_item_Chooseyoung, menu_Chooseyoung, '젊은 쪽을 고른다')
	if no_loli ! 1: func('$menu', 'interaction_city', $menu_item_Chooseimmature, menu_Chooseimmature, '미성숙한 쪽을 고른다')
	func('$menu', 'exec_options', $menu_item_nobuy, 'sp_txt = 1 & gt $curloc', '생각을 바꾼다')
