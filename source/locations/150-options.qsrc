!Central forum
$forum_options[1] = {
! JO9 MOD START J9M2402 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
	$sp_text[1] = '중앙 집회장은 엄청난 기회의 장이다. 여기서는 내 자신을 광고하거나, 경쟁자에게 훼방을 놓거나, 잠재적인 고객의 정보를 얻을 수도 있다.'
! JO9 MOD END J9M2402
	$text_display = '<br><br>'
	func('$menu', 'spacer', 2)

	func('$menu', '===BEGIN===', 'column_0')
	FUNC('$menu', 'interaction_city', $menu_item_Library_city, menu_Library_city, '도시 도서관')
	if slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0:
		func('$menu', 'interaction_city', $menu_item_Findcustomers, menu_Findcustomers, '잠재 고객을 찾는다')
	else
		func('$menu', 'location_gray_tooltip', $menu_item_Findcustomers_gray, empty, '잠재 고객 탐색 불가', '당신의 상표 낙인이 있는 노예가 없다')
	end
	func('$menu', 'interaction_city', $menu_item_Spreadrumors,  menu_Spreadrumors, '자기 홍보')
	func('$menu', 'exec_options', $menu_item_Specialmissions, 'sp_txt = 2 & gt $curloc', '특별 임무')
	func('$menu', 'city_form', $menu_item_Leaveforum, menu_Leaveforum, '포럼을 떠난다')
	func('$menu', '===END===')
}

$forum_options[2] = {
! JO9 MOD START J9M2401 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
	$sp_text[2] = '집회장에서는 간혹, 특별한 노예를 원하는 사람들을 만날 수 있다. 그들 중 몇몇은 정말 흥미로운 물건을 제공한다고 한다.'
! JO9 MOD END J9M2401
	$text_display = '<br><br>'
	func('$menu', 'spacer', 2)

	func('$menu', '===BEGIN===', 'column_0')
	if active[$quest[6]] < 2: func('$menu', 'interaction_city', $menu_item_Aramus, menu_Aramus, '병참장교 아라무스')
	if active[$quest[7]] < 2: func('$menu', 'interaction_city', $menu_item_Vujin, menu_Vujin, '현명한 부셴')
	if active[$quest[8]] < 2: func('$menu', 'interaction_city', $menu_item_Garsid, menu_Garsid, '임신마 가르시드')
	if active[$quest[9]] < 2: func('$menu', 'interaction_city', $menu_item_Valios, menu_Valios, '술사 발리오스')
	if active[$quest[13]] < 2: FUNC('$menu', 'interaction_city', $menu_item_Grakh, menu_Grakh, '라니스타 그라쿠스')
	!Post Patrician Quest - crushboss
	if (active[$quest[12]] = 0 and sparks >= 15000 and brand_reputation >= 3 and guild_reputation >= 3 and noble_status = 1) or active[$quest[12]] = 1:
		func('$menu', 'interaction_city', $menu_item_Spectre, menu_Spectre, '스펙터 경')
	end
	if brand_reputation >= 3 and guild_reputation >= 3 and noble_status = 1 and kulaconstruct > 0 and broker_quest = 0:
		func('$menu', 'interaction_city', $menu_item_broker, menu_broker, '수상한 중개인')
	end	
	func('$menu', 'exec_options', $menu_item_Lookaround, 'sp_txt = 1 & gt $curloc', '둘러본다')
	func('$menu', '===END===')
}

!Animal farm
$farm_options[1] = {
	if nsfw = 1: not_safe = 1
! JO9 MOD START J9M2400 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
	$sp_text[1] = '길게 늘어선 막사에는 여러 개의 우리가 구겨지듯 채워져있다. 우리 안에는 동물들과 사람들이 뒤섞여있다. 이곳의 냄새는 매우 역겹다. 그래도 일은 일이다.'
! JO9 MOD END J9M2400
	$text_display = '<br><br>'
	func('$menu', 'spacer', 1)

	func('$menu', '===BEGIN===', 'column_0')
	if slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] ! 4:
		func('$menu', 'interaction_city', $menu_item_merchandisefarm, menu_merchandisefarm, '다른 상품을 제안한다')
	else
		func('$menu', 'location_gray_tooltip', $menu_item_merchandisefarm_gray, empty, '다른 상품을 제안한다', '거래 가능한 노예가 없다')
	end
	if cow_state = CONST_INT['slave_exist'] and cow['brand'] > 0 and cow['brand'] ! 4:
		func('$menu', 'interaction_city', $menu_item_sell_cow, menu_sell_cow, '암소를 제안한다')
	else
		func('$menu', 'location_gray_tooltip', $menu_item_sell_cow_gray, empty, '암소를 제안한다', '제안할 낙인 찍힌 암소가 없다')
	end
	func('$menu', 'interaction_city', $menu_item_requirementscow, menu_requirementscow, '가축 요구 사항')
	func('$menu', 'interaction_city', $menu_item_requirementsfarm, menu_requirementsfarm, '기타 상품 요구 사항')
	func('$menu', 'interaction_city', $menu_item_milk_menu, menu_milk_cooperative, '우유 협동조합')
	func('$menu', 'city_form', $menu_item_Leavefarm, menu_Leavefarm, '가축 농장을 떠난다')
	func('$menu', '===END===')
}

$milk_cooperative[1] = {
	if nsfw = 1: not_safe = 1
! JO9 MOD START J9M2399 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$sp_text[1] = '[밀키]<br>&nbsp;죄송하지만 <<$master_name>>, <b>착유 자격증</b> 미보유자는 우유를 거래할 수 없다네요... 그래도, 사업 기반 장비들은 사가실 수 있어요!</div>'
	if milk_license = 1: $sp_text[1] = '[밀키]<br>&nbsp;안녕하세요 <<$master_name>>. 무슨 일 있나요? 혹시 오전에 젖 짜셨나요? 그럼 여기 가격표 보시고 거래해보죠!</div>'
! JO9 MOD END J9M2399
	$text_display = '<br><br>'
	func('$menu', 'spacer', 1)
	func('$menu', '===BEGIN===', 'column_0')
	func('$menu', 'interaction_city', $menu_item_Cow_gear, menu_Cow_gear, '젖소녀 장비 (25$)')
	if milk_can = 0:
		func('$menu', 'interaction_city', $menu_item_milk_can, menu_milk_can, '우유 캔 (25$)')
	end
	if milk_license = 0:
		func('$menu', 'interaction_city', $menu_item_milk_license, menu_milk_license, '착유 자격증 (200$)')
	end
	if milk_stock > 5 and milk_license = 1:
		func('$menu', 'interaction_city', $menu_item_sell_one_milk, menu_sell_one_milk, '모든 병을 판다')
	elseif milk_stock > 0 and milk_license = 1:
		func('$menu', 'interaction_city', $menu_item_sell_one_milk, menu_sell_one_milk, '한 병을 판다')
	else
		func('$menu', 'location_gray', $menu_item_sell_one_milk_gray, empty, '한 병을 판다')
	end
	if milk_stock > 4 and milk_license = 1:
		func('$menu', 'interaction_city', $menu_item_sell_five_milk, menu_sell_five_milk, '다섯 병을 판다')
	else
		func('$menu', 'location_gray', $menu_item_sell_five_milk_gray, empty, '다섯 병을 판다')
	end
	if milk_license = 1:
! JO9 MOD START J9M2398 | 2026-10-12_visible_menu_prices | changed block; context may be included
		func('$menu', 'interaction_city', $menu_item_milk_tip, menu_milk_tip, '내일의 우유 가격을 묻는다 (0~5$)')
! JO9 MOD END J9M2398
	else
		func('$menu', 'location_gray', $menu_item_milk_tip_gray, empty, '내일의 우유 가격을 묻는다')
	end
