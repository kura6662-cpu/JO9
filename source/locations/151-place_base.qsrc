!replace for places copypasta, by Lyazar
$pb_cycle = {
    $_pb_cycle_name = $args[0]
    $place_name[$_pb_cycle_name] = $args[1]
    $place_location[$_pb_cycle_name] = $args[2]
    $place_info[$_pb_cycle_name] = $args[3]

    killvar '$_pb_cycle_name'
}

