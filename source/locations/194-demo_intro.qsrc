# demo_intro
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1462 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'demo_intro': gs 'snk_room_bridge', 'guard', 'demo_intro'
! JO9 MOD END J9M1462
!Training beginning in the demo game
gs 'demo_layout'
$master_name = '잭'
npc_attitude = 11
$place = 'guild_hall'
if txt = 0: txt = 1
killvar '$text'

$npc_id = 'госпожа_ангелика'

! JO9 MOD START J9M1461 | 2026-10-08_persistent_image_cycle | changed block; context may be included
*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\guild.png"></div>')
! JO9 MOD END J9M1461

if lecture = 0:
! JO9 MOD START J9M1460 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$text[1] = '<font color="#8B0A50">가우데테(기뻐하라)! 나는 안젤리카 마님이다. 길드 마스터 평의회는 초보자들을 훈련시키고 인증하는 영예를 내게 맡겼다. 네 이름은 무엇이냐?</font>'
	$text[2] = '<font color="#191970">제 이름은 <<$master_name>>입니다. 저는 오래전부터 이 순간을 꿈꿔 왔습니다.</font>'
	$text[3] = '안젤리카 마님은 목록을 확인하고 고개를 끄덕인다. <br>' + _
	'<font color="#8B0A50">여기 보니 입회비는 이미 전액 납부했군, <<$master_name>>. 좋다. 하지만 명심해라. 돈을 얼마나 냈든, 우리 길드는 먹칠하는 자는 용납하지 않는다. 우리 조직의 명예가 최우선이다.</font>'
	$text[4] = '<font color="#8B0A50">노예상인 길드의 정식 일원이 되려면, 실전에 가까운 조건에서 시험을 통과해야 한다. 초보자를 위한 훈련도 우리가 제공한다. 필요하다면 내가 아는 모든 걸 백 번이고 말해 주마.</font>'
! JO9 MOD END J9M1460
end

npc = 1
if lecture = 100:
	if game_over = 1: gt 'Start'
	npc = 0
	if exam_in_progress = 0:
		*p '<div id = "bg">'
		*nl '<div id="under">강의 I: 성공의 구성 요소<br><div id = "clear"><a href = ''EXEC: lecture = 1 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">강의 II: 복종의 심리학<br><div id = "clear"><a href = ''EXEC: lecture = 2 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">강의 III: 채찍과 당근<br><div id = "clear"><a href = ''EXEC: lecture = 3 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">강의 IV: 부엌 노예 생활<br><div id = "clear"><a href = ''EXEC: lecture = 4 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">시험 조건 확인<br><div id = "clear"><a href = ''EXEC: lecture = 5 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">실기 시험 시작<br><div id = "clear"><a href = ''EXEC: gt "start_demo_game"''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">길드 나가기<div id = "clear"><a href = ''EXEC: gt "main_menu"''><img src = "content\pic\clear.png"></a></div></div></div>'
		$text[1] = '어떤 강의를 들을지 선택해야 한다. 아니면 시험 조건을 물어보거나, 준비가 됐을 때 시작하게 해 달라고 할 수도 있다.'
	else
		*p '<div id = "bg"><br>'
		*nl '<div id="under">강의 I: 성공의 구성 요소<br><div id = "clear"><a href = ''EXEC: lecture = 1 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">강의 II: 복종의 심리학<br><div id = "clear"><a href = ''EXEC: lecture = 2 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">강의 III: 채찍과 당근<br><div id = "clear"><a href = ''EXEC: lecture = 3 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">강의 IV: 부엌 노예<br><div id = "clear"><a href = ''EXEC: lecture = 4 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">시험 과제 제출<br><div id = "clear"><a href = ''EXEC: lecture = 11 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		*nl '<div id="under">일로 돌아가기<br><div id = "clear"><a href = ''EXEC: menu_form = 0 & gt "demo_menu_form"''><img src = "content\pic\clear.png"></a></div></div></div>'
		gs '$slave_price'
		if rating >= 4:
			$text[1] = '계산해 보니, 내 노예는 이미 <<$rating[rating]>> 등급 조건을 충족한다. 안젤리카 마님께 보여 드리고 시험을 마칠 때가 된 것 같다.'
		else
			$text[1] = '아직은 내 노예가 충분히 좋지 않은 것 같다. 그래도 안젤리카 마님께 평가를 부탁할 수는 있다. 아니면 강의 내용을 다시 상기시켜 달라고 해도 된다…'
		end
	end
end

if lecture = 1:
	$text[1] = '노예의 평점은 여러 요소에 영향을 받는다. 첫째는 기술 총합이다. 집안을 돌보는 능력, 주인을 즐겁게 하는 능력, 성적 기술 - 이 모든 것이 평점을 올린다.'
	$text[2] = '또 다른 중요한 요소는 복종심이다. 완벽한 노예라면 주인의 모든 규칙을 철저히 지키고, 어떤 요구든 망설임 없이 신속하게 따라야 한다. 가장 가치 있는 것은 진심으로 기쁘게 해 주고 섬기고 싶어 하는 마음이다.'
	$text[3] = '노예의 정신 상태도 상당히 중요하다. 한편으로 그녀는 까다롭거나 오만해서는 안 되지만, 다른 한편으로는 기질이 있고 성격이 강한 편이 좋다. 사람들은 대개 특징 없는 인형을 좋아하지 않는다. 사람들은 눈에 띄는 개성에 끌린다.'
	$text[4] = '마지막으로, 매력은 평점에 매우 큰 영향을 미친다. 노예가 자신을 얼마나 잘 드러낼 수 있는지, 그리고 얼마나 세련돼 보이는지 말이다. 기술 수준이 같다면, 세련된 노예는 늘 칙칙한 노예보다 고객을 더 만족시킨다. 특히 상류 고객에게 노예를 팔 때는 이 점을 반드시 고려해야 한다.'
	$text[5] = '훈련 과정에서 몸에 흉터가 남으면, 그녀의 매력은 필연적으로 떨어진다. 힘 조절에 신중해야 한다. 또한 소녀의 체중과 신체 상태도 꾸준히 살펴야 한다. 너무 마르지도, 너무 살찌지도 않아야 한다. 지구력과 건강은 매우 중요하다.'
	$text[6] = '형편없이 준비된 노예는 고객이 구매를 거절할 가능성이 높다. 외형을 나중에 고쳐도 마찬가지일 수 있다. 고객들의 변덕을 반드시 고려해야 한다.'
	$text[7] = '하지만 이것은 어디까지나 일반적인 경우에만 해당한다는 점도 기억해야 한다. 각 고객은 저마다의 요구를 가질 수 있고, 그것은 그 사람 눈에 우리 상품의 평점을 크게 바꿔 놓는다.'
	$text[8] = '고객이 당신에게서 여검투사를 사 간다면, 중요한 것은 그녀의 힘과 이국성이지 집안일이나 요리 솜씨는 아니다. 앞으로는 훈련되지 않은 노예를 골라, 특정 고객의 요구에 맞춰 훈련시켜야 한다.'
	$text[9] = '시험에서 고객은 노예상인 길드이므로, 우리는 그녀의 전체 평점만 고려한다. 전체 평점이 충분히 높다면 개별 기술은 중요하지 않다.'
end

if lecture = 2:
	$text[] = '반항적인 노예는 주인에게 큰 골칫덩이다. 모든 조련사에게 가장 중요한 과제 가운데 하나는 무조건적인 복종이다. 그래야만 이후 훈련을 효율적으로 진행하고 제대로 된 평점을 얻을 수 있다.'
	$text[] = '노예가 복종하려는 의지는 여러 요인에 좌우된다. 그 모든 것을 알고, 긍정적인 요인을 어떻게 만들어 내고 유지할지 이해하는 것이 중요하다. 잘 들어라.'
	$text[] = '가장 먼저 떠오르는 것은 <font color="#960018">공포</font>다. 노예에게는 네가 원하는 무엇이든 할 수 있다. 대부분의 경우 고통, 모욕, 폭력을 이용하면 겁을 주는 일은 어렵지 않다. 우리가 계산해 본 결과, <font color="#960018">공포</font>의 평균적 동기 부여력은 다른 어떤 것보다도 거의 두 배 강하다.'
	$text[] = '하지만 <font color="#960018">공포</font>에는 함정도 있다는 점을 기억해야 한다. 첫째, 벌을 줄 때는 소녀에게 회복 불가능한 신체 손상을 남기지 않도록 조심해야 한다. 그러나 그보다 더 중요한 건 정신을 망가뜨리지 않는 것이다.'
	$text[] = '노예를 벌할 때마다 그녀는 너를 두려워하게 될 뿐 아니라, 불만도 함께 커진다. 이것은 노예를 깊은 우울로 몰아넣는 지름길이다. 긍정적인 동기가 없으면, 고통과 자기연민 때문에 소녀가 훈련에 집중하지 못하게 되어 훈련이 매우 어려워진다.'
	$text[] = '기분을 떨어뜨리는 것 외에도, <font color="#960018">공포</font>에는 또 하나의 어두운 면이 있다. 우리는 그것을 <font color="#464451">절망</font>이라고 부른다. 공포를 이해하지 못하고 거부하는 데서 생겨나는 파괴적인 공포다. 노예가 죄책감도 없이 벌을 받거나, 벌의 강도가 그녀가 느끼는 죄의식보다 더 크면, <font color="#464451">절망</font>은 필연적으로 자라난다.'
	$text[] = '예민한 소녀는 기분이 나쁘다는 이유만으로도 <font color="#464451">절망</font>에 빠질 수 있다. 노예가 지나치게 여린 성격이라면, 슬픔은 그녀를 더 빨리 우울로 몰아간다. 노예를 벌하려 할 때는 그녀가 느끼는 죄의식의 정도뿐 아니라, 감수성도 함께 고려해야 한다.'
	$text[] = '<font color="#464451">절망</font>은 인격을 파괴한다. 그것의 영향 아래 노예는 기질과 자신감을 잃기 시작하고, 점점 의지가 부서져 간다. 초기에는 도움이 될 수도 있지만, 결국에는 평점만 떨어뜨릴 뿐이다. 조심해라.'
	$text[] = '<font color="#464451">절망</font>을 없애려면, 노예가 기쁨에 차 있도록 만들어라. 만족한 여자들은 점차 자기 <font color="#464451">절망</font>을 잊는다. 그녀에게 혼자만의 시간을 보상으로 주는 것도 도움이 된다. 게다가 기분이 좋을 때는 새로운 내용을 배우기도 훨씬 쉽고, 훈련 중 집중력도 더 좋아진다.'
	$text[] = '동시에 삶에 만족한 노예는 자기 <font color="#960018">공포</font>도 금세 잊어버린다. 즉, 그녀가 복종하도록 만들 다른 기반을 키워야 한다는 뜻이다. 그것은 곧 <font color="#082567">습관</font>, <font color="#CD9B1D">길들임</font>, <font color="#B452CD">자각</font>, 그리고 <font color="#00a86b">헌신</font>이다.'
	$text[] = '먼저 <font color="#082567">습관</font>부터 보자. 사람은 그저 익숙하다는 이유만으로 명령에 따를 수 있다는 건 비밀도 아니다. 노예가 네 지시와 규칙에 따를 때마다, 노예로서의 <font color="#082567">습관</font>은 조금씩 커진다. 그렇게 점차 노예는 자신이 한때 자유인이었다는 사실조차 잊어버리게 된다.'
	$text[] = '<font color="#082567">습관적 복종</font>의 성장을 끌어올리기는 어렵지만, 노예에게 엄격하게 대하면 그 과정을 앞당길 수 있다. 자존심 강한 성격은 <font color="#082567">습관</font>을 천천히 쌓지만, 동시에 <font color="#082567">습관</font>은 그녀의 자존심도 점차 깎아 먹는다. 물론 굴욕도 마찬가지다.'
	$text[] = '복종의 좋은 기초는 우리가 <font color="#B452CD">자각</font>이라 부르는 것, 즉 노예 자신의 처지를 이성적으로 이해하는 것이다. 충성은 보상받고, 저항은 피할 수 없는 벌로 이어진다는 걸 노예에게 이해시키려 해라. <font color="#B452CD">자각</font>은 복종을 촉진하지만, 강한 의지와 자존심은 자신의 운명을 받아들이는 데 방해가 될 수 있다.'
	$text[] = '<font color="#B452CD">자각</font>은 직접적인 복종을 통해서만이 아니라, 합당한 보상을 통해서도 생겨날 수 있다. 노예에게 보상을 주면 기분만 좋아지는 것이 아니라, 복종하는 행동이 좋은 대우로 이어진다는 사실을 깨닫게 된다.'
	$text[] = '하지만 극도로 조심해야 한다. 노예가 받을 만한 것 이상으로 보상하면, 그녀를 <font color="#EE1289">버릇없게</font> 만들 수 있다. 버릇없어진 노예는 통제가 더 어려워지고, 늘 어떤 형태의 긍정적 유인을 필요로 하게 된다. 그렇지 않으면 금세 상심해서 <font color="#464451">절망</font>에 빠지기 시작한다. 이것을 바로잡으려면, 그녀를 제자리에 돌려놓는 일을 망설여선 안 된다. 복종하는 행동 하나하나에 전부 보상을 주지 마라. 그것도 역시 <font color="#EE1289">버릇없음</font>으로 이어진다. 하루 한두 번 이상 보상을 주지 않는 것이 가장 좋다.'
	$text[] = '<font color="#B452CD">자각</font> 말고도 <font color="#CD9B1D">길들임</font>이 있다. 이것은 본능적 복종이다. 노예가 무의식적으로 네 우월함을 느끼고, 너를 기쁘게 하려 들 때를 말한다. 의지가 약한 사람일수록 이런 형태의 복종에 더 잘 빠진다.'
	$text[] = '노예의 <font color="#CD9B1D">길들임</font>을 키우려면 규칙, 벌, 구속적인 옷차림, 무거운 피어싱 등을 이용할 수 있다. 불복종이 고통이나 박탈로 이어지고, 노예가 끊임없이 자기 자리를 상기당하면 복종은 반사작용이 된다. <font color="#CD9B1D">길들임</font>을 키우는 또 다른 방법은 성적 욕망을 이용하는 것이다. 사람은 무의식적으로 쾌락의 근원에 끌린다.'
	$text[] = '노예가 이해하지 못하는 수준으로 벌하면 <font color="#464451">절망</font>이 생겨나지만, 너무 약하게 벌하면 <font color="#EE1289">응석</font>이 들 수 있다. 그녀를 벌하지 않고 넘어갔는데도 다시 불복종하면, <font color="#CD9B1D">길들임</font>은 필연적으로 약해진다. 반대로 새로운 과제를 주었을 때 그녀가 성실하게 수행하면, 자기 공로감이 죄책감을 줄여 준다. 죄를 지은 노예를 벌도 주지 않고 재우는 건 좋지 않지만, 그녀가 겁먹어 있다면 잠깐의 유예가 기운을 북돋울 수도 있다.'
	$text[] = '복종을 길러 내는 최종 목표는 노예가 노예의 도덕을 받아들이게 만드는 것이다. 노예가 자기 처지를 온 마음으로 받아들이고, 진심으로 주인을 섬기고 싶어 하게 될 때, 우리는 그것을 <font color="#00a86b">헌신</font>이라 부르는 도덕적 성장에 도달했다고 본다. 이 충성의 원천은 두 배로 가치 있다. 가장 믿을 만할 뿐 아니라, 새 주인에게 팔린 뒤에도 최선을 다하게 만드는 힘이기 때문이다.'
	$text[] = '<font color="#00a86b">헌신</font>은 한편으로 노예가 자기 처지에 만족하고 기분이 좋은 상태에 있으며, 다른 한편으로는 습관적 복종과 본능적·이성적 복종까지 모두 길러 냈을 때 나타나기 시작한다. 오만하거나, 혹은 너를 <font color="#960018">두려워하는</font> 노예에게서는 <font color="#00a86b">헌신</font>을 키우기 어렵다는 점을 명심해라. 충성을 강화하려면 교감과 친밀함으로 보상하는 것도 좋다.'
	$text[] = '인정받은 채찍의 대가들은 카타르시스를 통해 노예의 <font color="#00a86b">헌신</font>을 급격히 끌어올릴 수 있다. 극도의 고통이나 쾌락의 순간에 찾아오는 특수한 깨달음, 진실의 순간 말이다. 하지만 이 기술은 오직 최고수들만의 것이다.'
	$text[] = '정리하자면, 훈련에는 몇 가지 단순한 원칙이 있다. 노예가 잘못을 저질렀다면, 그녀가 느끼는 죄의식에 맞는 강도로 벌해라. 좋은 행동에는 공로에 맞게, 그러나 너무 자주 말고 보상해라. 만약 그녀가 너를 <font color="#960018">두려워하지</font> 않는다면, 최소 세 가지 규칙은 지키게 해서 <font color="#082567">습관</font>을 기르게 하고 <font color="#EE1289">응석받이</font>가 되지 않게 해라. 그녀의 오르가즘을 통제하고, 기분을 계속 주시해라.'
	$text[] = '이제 우월감과 물리적 저항에 대해서도 몇 마디 하겠다. 처음부터 네가 자기보다 강하다고 느끼는 소녀를 굴복시키는 건 훨씬 쉽다. 반대로, 그녀가 자기 자신이 너보다 강하다고 느끼면 복종하려 하지 않을 것이다.'
	$text[] = '그녀가 네 우월함을 느끼느냐 아니냐에는 몇 가지 요소가 영향을 준다. 첫째는 물론 육체적 힘이다. 둘째는 정신적 강인함과 카리스마다. 셋째는 지휘 경험, 즉 지배하는 능력이다. 마지막으로 외모다. 잘생기거나 아름다운 외형은 상대가 너에게 굴복하기 쉽게 만든다.'
	$text[] = '하지만 노예의 개인적 특성도 중요하다. 강한 성격, 높은 감정성, 그리고 물론 노예의 자존심은 그녀가 네 우월함을 느끼는 일을 방해한다. 또한 그녀가 스스로를 너보다 더 똑똑하다고 여기며, 널 속여 넘길 수 있다고 생각하는지도 주의해서 봐라. 그런 경우 그녀는 복종하려는 경향이 더 약해진다.'
	$text[] = '네 우월성이 낮다면, 그녀는 저항할 수도 있다. 네가 벌하거나 강간하려 들면, 노예는 힘으로 자신을 지키려 할 것이다. 만약 그녀가 너를 이길 수 있다면, 결과는 심각해질 수 있다. 하지만 네가 이기면, 그것은 곧 네 우월성을 증명해 준다.'
	$text[] = '우월성만으로는, 설령 아주 높더라도, 네 명령이 반드시 지켜진다는 보장은 없다. 그러나 복종의 성장을 가속하고 물리적 충돌의 가능성은 낮춘다. 몸 상태를 잘 유지하고, 지배적인 목소리를 키우며, 좋은 외형을 유지해라.'
end

if lecture = 3:
	$text[1] = '이제 벌과 보상에 대해 좀 더 이야기하자. 두 번째 강의에서 <font color="#464451">절망</font>과 <font color="#EE1289">응석</font>에 대해 말했지만, 다시 반복하겠다. 노예를 지나치게 벌하면 <font color="#464451">절망</font>을 키우고, 그녀가 받을 자격이 없는 걸 보상하면 기분은 좋아질지 몰라도 노예를 <font color="#EE1289">응석받이</font>로 만든다.'
	$text[2] = '여기서 핵심은 이것이다. 노예의 공과 죄는 상황마다 다르다. 그녀가 왜 그런 행동을 했는지 이해해야 한다.'
	$text[3] = '가령 네가 학대에 익숙하지 않은 순진한 여자를 데려다가, 네 오락을 위해 부족의 황소와 교미하라고 시킨다고 해 보자. 그녀의 눈에는 그것을 거부하는 것이 그다지 심각한 잘못이 아니다. 네 요구가 그녀가 받아들일 수 있는 한도를 훨씬 넘기 때문이다.'
	$text[4] = '만약 그런 명령을 거부했다는 이유로 소녀를 잔인하게 벌한다면, 그녀는 왜 그런 추악한 행동을 거부한 것이 용납될 수 없는 일인지 이해하지 못하기 때문에 필연적으로 <font color="#464451">절망</font>에 빠지게 된다. 하지만 시간이 지나면, 상황은 바뀔 것이다.'
! JO9 MOD START J9M1459 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$text[5] = '하지만 네 노예가 이미 훈련되어 있고 꽤 순종적이라면, 그녀는 실제로 자기 죄를 깨닫게 될 것이다. 이미 준비된 여자가 같은 행위를 황소와 하는 것을 거부한다면, 당신은 훨씬 더 가혹한 반응을 보여야 한다.'
! JO9 MOD END J9M1459
	$text[6] = '보상도 마찬가지다. 결과만 보지 말고, 노예의 성격도 함께 고려해라. 아직 거의 훈련되지 않은 노예가 딥스로트 수업에 동의했다고 해 보자. 결과가 완벽하진 않더라도, 그녀는 하겠다고 응했고 자기 저항을 이겨 냈다. 그런 경우에는 제대로 보상해 줘야 한다.'
	$text[7] = '반대로, 노예가 이미 잘 아는 일을 아주 잘해 냈고, 그것이 그녀에게 전혀 힘든 일이 아니라면 보상을 받을 자격이 없다. 오히려 벌을 고려해 볼 수도 있다.'
	$text[8] = '항상 노예의 공과 죄를 5점 척도로 평가해라. 그리고 보상과 벌의 강도 역시 함께 평가해라. 언제나 기억해라. 그녀는 자기 몫을 받는 것이다.'
	$text[9] = '하지만 내가 한 말은 어디까지나 일반적인 지침일 뿐이라는 점을 기억해라. 때로는 <font color="#464451">절망</font>이나 <font color="#EE1289">응석</font>의 위험을 감수하더라도, 노예가 받을 자격보다 더 크게 벌하거나 보상하는 편이 이치에 맞는 경우도 있다. 결정은 언제나 네가 내린다. 경험과 직감을 써라.'
	$text[10] = '이제 보상과 벌의 구체적인 종류와 형태로 넘어가자. 모든 자극의 강도는 노예가 무엇을 욕망하고 무엇을 두려워하는지에 달려 있다.'
	$text[11] = '벌은 고통, 무력감, 혐오감, 수치심, 정신적 취약성, 그리고 피, 어둠, 거미, 물, 불 같은 것들에 대한 공포증에 기반할 수 있다.'
	$text[12] = '보상은 인정받고 싶은 욕구, 안락에 대한 갈망, 사치에 대한 집착, 성적 쾌락, 혹은 그녀가 단것을 좋아한다면 음식에 기반할 수도 있다.'
	$text[13] = '각 노예에게는 저마다의 강점과 약점, 열망과 공포증이 있다. 그녀가 무엇을 원하고 무엇을 두려워하는지 알아내고, 그것을 네 목적을 위해 이용해라. 그것이 노예를 빠르게 통제하는 열쇠다.'
	$text[14] = '겁을 모르는, 전장에서 단련된 전사를 훈련시켜야 한다고 상상해 보자. 채찍질이나 피의 광경만으로는 그녀의 의지를 꺾을 수 없을 것이다. 하지만 심리적으로 압박하거나, 그녀가 네 앞에서 무력함을 느끼도록 묶어 둘 수는 있다.'
	$text[15] = '사람은 결국 모든 것에 익숙해진다는 점을 잊지 마라. 자극의 종류에도, 벌과 보상의 구체적인 방식에도 저항이 생겨난다. 예외는 노예의 타고난 공포증과 열망뿐이다. 그 외의 것들에 대해서는 창의적이 되어라. 같은 방법을 너무 자주 반복하지 않도록 해라. 모든 훈련에서 기억해야 할 것은, 다양성이 최고라는 점이다.'
	$text[16] = '말로 하는 보상과 벌에는 아주 큰 장점이 하나 있다. 너에게도, 노예에게도 많은 시간과 노력을 들이지 않는다는 점이다. 하지만 이 방법의 장점은 사실 거기까지다. 칭찬이든 욕설이든 금세 힘을 잃고, 위협과 약속도 실행하지 않으면 마찬가지로 무력해진다.'
	$text[17] = '아무 도구가 없어도, 그 자리에서 바로 노예를 벌할 수 있다. 빠르고 실용적이다. 하지만 도구는 벌의 효율을 높여 준다는 점을 기억해라. 또한 구타는 소녀 몸에 멍을 남길 수 있다. 상처는 결국 아물겠지만, 흔적만으로도 그녀의 평점과 매력은 깎인다.'
	$text[18] = '고통을 주려면 최소한의 도구라도 써 보는 것이 좋다. 체벌용 도구를 약한 것부터 나열하면 슬리퍼, 벨트, 회초리, 래시, 그리고 채찍이다. 래시나 채찍을 쓸 때는 상처가 영구적으로 남을 수 있으니 조심해라. 많은 것은 너의 숙련에 달려 있다. 실수했다면 의료 센터가 언제나 있다.'
	$text[19] = '노예를 구속하는 것의 큰 장점은 네 수고가 덜 든다는 점이다. 원하는 만큼 긴 시간 동안 고통을 줄 수 있다. 다만 평균적으로는, 같은 수준의 신체적 체벌보다 약간 덜 효과적이다.'
	$text[20] = '노예가 흥분한 상태라면, 애무로 보상해라. 그녀는 에너지를 잃지 않을 뿐 아니라, 좋은 마사지는 오히려 기력을 더 올려 줄 수도 있다. 다만 그녀의 흥분은 오르가즘을 맞아야만 내려간다는 점을 명심해라. 그렇지 않으면 흥분만 더 올려 주게 된다. 오르가즘을 금지하는 규칙을 걸어 두었다면, 그 점도 함께 주의해라.'
	$text[21] = '네 자신의 기력을 아끼려면, 노예에게 자유 시간을 보상으로 줄 수 있다. 그냥 쉬게만 해도 그녀의 남은 에너지를 다음 날 쓸 수 있을지 모른다. 하지만 놀고 즐길 기회를 주면, 노예는 더 기뻐할 것이다.'
	$text[22] = '여분의 스파크가 있고, 노예가 살이 찔까 두렵지 않다면 단것으로 보상할 수도 있다. 희귀한 음식은 매우 비쌀 수 있지만, 아무리 좋은 것이라도 연달아 여러 번 먹으면 질리기 마련이다. 노예를 단것으로 보상할 때는 다양성을 줘라.'
	$text[23] = '어떤 벌은 특별한 장비나 시설을 필요로 할 수도 있다. 시험에서는 고문 도구나 설비를 제공하지 않으니, 최소한의 것으로 버텨야 한다.'
	$text[24] = '어떤 보상은 노예를 데리고 도시 밖으로 나가야 할 수도 있다. 시험 훈련 중에는 길드의 벽 밖을 벗어나선 안 되므로, 그런 종류의 보상은 이용할 수 없다. 그래도 훈련에 필요한 기회는 충분하다고 우리는 확신한다.'
end

if lecture = 4:
	$text[1] = '훈련 중에는 여러 가정사도 신경 써야 한다. 그래서 대다수 노예상인들은 개인 조수를 둔다. 그 조수는 종종 자기 노예 가운데 하나이기도 하다. 조수는 집안일을 도와주고, 너를 즐겁게 하고, 노예들을 관리하며, 기술을 전수해 주는 역할도 한다.'
	$text[2] = '길드는 시험용 조수를 제공하지 않으므로, 너 혼자 해내야 한다. 물론 노예가 충분히 복종적이고 필요한 기술까지 갖췄다면, 집안일에 써먹을 수는 있다.'
	$text[3] = '가장 먼저 기억해야 할 것은 너 자신의 위생과 노예의 위생이다. 더러움은 질병을 불러오고 기분을 떨어뜨린다. 게다가 더러운 노예는 전투와 고문에서 더 큰 피해를 입는다. 상처가 감염될 수 있기 때문이다.'
	$text[4] = '더러움은 시간과 함께 쌓이고, 특히 노동, 청소, 요리, 더러운 섹스 같은 활동과 함께 더 빨리 쌓인다. 위생을 유지하려면 가끔 스스로 몸을 씻어야 한다. 집에 전용 욕실이 없다면, 온천의 온천이나 해변, 혹은 스파에 가야 한다.'
	$text[5] = '길드에는 시험 구역에 딸린 욕실이 있으니, 도시로 나갈 필요는 없다. 혼자 씻어도 되고, 노예와 함께 씻어도 된다. 두 번째 경우에는 에너지는 노예만 쓰지만, 둘 다 씻게 된다. 게다가 기분도 올라갈 것이다.'
	$text[6] = '네 집도 더러워진다. 시간이 지날수록 먼지와 때, 묵은 옷, 더러운 그릇 같은 것들이 쌓인다. 집 안 사람들의 기분을 떨어뜨리지 않으려면 정기적으로 청소하는 걸 잊지 마라. 그리고 기억해라. 어질러진 게 클수록 치우는 건 더 힘들어진다.'
	$text[7] = '집에서 만든 음식은 너 자신의 기분은 물론, 노예의 기분까지 크게 끌어올릴 수 있다. 하지만 준비에는 시간과 노력이 든다. 요리하고 싶지 않다면 통조림이나 반조리 식품을 구해도 된다.'
	$text[8] = '노예의 체중을 살펴라. 너무 뚱뚱해서도 안 되고, 너무 굶주려서도 안 된다. 일부러 바꾸려는 게 아니라면, 체중이 안정적으로 유지되도록 식사량을 정해라.'
	$text[9] = '중요한 요소 하나는 개인의 대사 특성이다. 대사가 좋은 노예는 정상보다 거의 두 배의 칼로리를 해 없이 흡수할 수 있고, 적어도 건강한 동안은 식사에서 더 많은 지구력을 얻는다. 대사가 약한 소녀는 금방 과체중이 되고, 살을 빼는 것도 어렵다.'
	$text[10] = '지구력이 부족한 노예라면 특히 더, 하지만 가장 유능한 노예라 해도, 근육을 과하게 혹사하면 스스로 몸을 망칠 수 있다는 점을 기억해라. 육체적으로 힘든 일을 시킬 때는 그녀의 한계를 염두에 둬라. 평소보다 기운이 없어 보인다면 계획을 조정해야 할 수도 있다.'
	$text[11] = '너 자신이 타고난 요리사나 집사가 아니라면, 집안일은 기분에 큰 부담이 될 것이다. 하지만 조수가 생기기 전까지는 가끔 네가 직접 해야 할 때도 있다. 노예에게 그 일을 맡기는 것이 생산적이지 않을 수도 있다. 특히 기술이 부족하거나 기력이 모자라면 더욱 그렇다. 반대로 집안일은 불복종하는 노예라도 그리 거부하지 않을 수 있는 단순한 과업이므로, 긍정적인 습관을 길러 주는 시작점으로는 좋다.'
end

if lecture = 5:
! JO9 MOD START J9M1458 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$text[1] = '<font color="#191970">어떤 시험입니까, 마님?</font>'
	$text[2] = '<font color="#8B0A50">과제는 판매용 노예를 훈련시키는 것이다. 우리는 기본 조건, 노예 선택권, 옷가지 한 벌, 가득 찬 냉장고, 그리고 800 스파크의 자금을 준다. 집세를 내고 노예를 먹이는 건 네 몫이다.</font>'
	$text[3] = '<font color="#8B0A50">이 스파크로는 대략 한 달 정도 버틸 수 있다. 얼마나 아껴 쓰느냐에 따라 조금 달라지겠지만. 어쨌든 그동안 네 노예의 평점을 최소 <<$rating[4]>> 등급까지 올려야 한다.</font>'
	$text[4] = '<font color="#8B0A50">스파크가 다 떨어질 때까지 소녀의 평점이 형편없다면 시험 실패다. 노예가 죽어도 역시 시험 실패다. 이해했느냐?</font>'
	$text[5] = '<font color="#191970">완전히 이해했습니다. 그리 어려워 보이진 않는군요.</font>'
! JO9 MOD END J9M1458
	if txt = 5: npc_attitude = 31
! JO9 MOD START J9M1457 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$text[6] = '<font color="#8B0A50">훌륭하다. 자신감은 이미 절반의 성공이다. 우리 직업에선 가장 중요한 자질이지. 이제 남은 건 네가 그것을 직접 해낼 수 있다는 걸 보여 주는 일뿐이다. 당장 시작해도 되고, 준비됐다고 느낄 때까지 더 훈련해도 된다.</font>'
! JO9 MOD END J9M1457
end

if lecture = 11:
	$text[1] = '안젤리카 마님은 내 노예를 뚫어지게 바라본다. 그리고 외눈에서 번쩍이는 빛을 보면, 그녀가 아우스펙스를 썼다는 게 분명하다.'
! JO9 MOD START J9M1456 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$text[2] = '노예의 오라를 살핀 뒤, 그녀는 몸을 검사하고 아마 백 개쯤 되는 질문을 쏟아 낸다. 그중 상당수는 너를 향한 질문이다. 당신은 최대한 솔직하게 대답하려 한다.'
! JO9 MOD END J9M1456
	if rating >= 4:
! JO9 MOD START J9M1455 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
		$text[3] = '안젤리카 마님은 만족스럽게 고개를 끄덕인다:<br>' + _
		'<font color="#8B0A50">그래, 네 작업은 받아들일 만하다고 본다. 네 기술은 우리 업으로 스스로 먹고살기에 충분하고, 무엇보다도 우리 길드의 좋은 이름에 먹칠하지는 않을 것이다.</font>'
		$text[4] = '<font color="#8B0A50">나는 마스터 평의회에 너를 추천하겠다. 내일이면 너도 우리 일원이 된다. 작은 공식 의식과 연회가 열릴 텐데, 그 비용은 네 노예를 팔아 충당할 것이다. 이제 쉬어도 좋다.</font>'
! JO9 MOD END J9M1455
		game_over = 1
	else
! JO9 MOD START J9M1454 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
		$text[3] = '안젤리카 마님은 실망한 듯 고개를 한쪽으로 기울인다:<br>' + _
		'<font color="#8B0A50">아니다, 당신은 아직 준비되지 않았다. 길드의 정식 일원이 되려면 훨씬 더 나은 결과를 내야 한다. 그렇게 어려운 일도 아닌데 말이다.</font>'
! JO9 MOD END J9M1454
		$text[4] = '안젤리카 마님은 시험이 끝날 때까지 돌아가 더 열심히 훈련하라고 말한다. 어쩌면 아직 만회할 수 있을지도 모른다.'
	end
end

if lecture = 12:
! JO9 MOD START J9M1453 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
		$text[1] = '네가 무슨 짓을 해도, 노예는 끝내 의식을 되찾지 못했다. 당신은 길드로 돌아갈 수밖에 없었다.'
		$text[2] = '안젤리카 마님은 엄한 눈으로 너를 바라보더니, 실망스럽다는 듯 고개를 한쪽으로 기울인다:<br>' + _
		'<font color="#8B0A50">그래서 네 노예를 죽여 버렸단 말이냐, <<$master_name>>? 고작 노예 하나의 건강조차 유지하는 게 그렇게 어려웠느냐? 길드의 정식 일원이 되려면 훨씬 더 나은 결과를 보여 줘야 한다. 그렇게 어려운 일도 아닌데 말이다.</font>'
		$text[3] = '<font color="#8B0A50">그리고 그 소녀는 어쩌지? 정육점으로 보내야겠군. 너에 관해서라면, 나는 마스터 평의회에 너를 추천할 수 없다. 원한다면 이의 신청은 할 수 있다.</font>'
! JO9 MOD END J9M1453
		game_over = 1
	end
end

if lecture = 13:
