if npc = 1:
! JO9 MOD START J9M1448 | 2026-10-08_persistent_image_cycle | changed block; context may be included
	*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\characters\mistress_angelika.png"></div>')
! JO9 MOD END J9M1448
	*p '<div id = "side_panel_main"><center><font size = 50%><<$npc_name[$npc_id]>></font>'
	*nl '<<$npc_status[$npc_id]>><br>'
	*nl'참고 정보:</center></div>'
	*p '<div id = "side_panel_text"><<$npc_attitude[npc_attitude]>><br>'
	*nl '<span class="jo9-reference-body"><<$npc_info[$npc_id]>></span><style>.jo9-reference-body,.jo9-reference-body *{font-size:20px !important;}</style></div>'
else
	*p '<div id = "side_panel_main"><center><font size = 50%><<$place_name[$place]>></font>'
	*nl '<<$place_location[$place]>><br>'
	*nl '참고 정보:</center></div>'
	*p '<div id = "side_panel_text"><span class="jo9-reference-body"><<$place_info[$place]>></span><style>.jo9-reference-body,.jo9-reference-body *{font-size:20px !important;}</style></div>'
end

! JO9 MOD START J9M1447 | 2026-10-15_z_inline_text_prefix | changed block; context may be included
! JO9_INLINE_TEXT_PREFIX_20261015
local $jo9_leading_empty = $strfind($text[txt], '^(\s|&nbsp;|<[bB][rR]\s*/?>)+')
if $jo9_leading_empty ! '': $text[txt] = $mid($text[txt], len($jo9_leading_empty) + 1, len($text[txt]))
! JO9 MOD END J9M1447
*p '<div id = "text"><<$text[txt]>></div>'

if lecture ! 100:
	if txt > 1:
		addobj '<img src = "content\pic\buttons\demo_back_button.png">'
	else
		addobj '<img src = "content\pic\buttons\demo_noback_button.png">'
	end
	addobj '<img src = "content\pic\buttons\demo_forward.png">'
end

