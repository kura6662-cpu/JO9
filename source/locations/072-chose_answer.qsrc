if interaction = 1115:
	killvar '$text'
	txt = 0
	if slave['obedience'] >= slave['intellect'] - slave['temperament']:
		if slave['nymphomania'] < 0 and slave['arousal'] > 0:
			$text[] = $dyneval($voice_native,'1115_nymphomania_dislike',$nymphomania_dislike)
		end
		if slave['homosexualism'] = -1 and slave['arousal'] > 0:
			$text[] = $dyneval($voice_native,'1115_homosexualism_dislike',$homosexualism_dislike)
