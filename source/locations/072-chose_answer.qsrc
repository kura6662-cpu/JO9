# chose_answer
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START ARGON_R2_NATIVE_TOPICS | preserve original native request/wish/dislike dispatch
! JO9 MOD START J9M2851 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'chose_answer': gs 'snk_room_bridge', 'guard', 'chose_answer'
! JO9 MOD END J9M2851
!The choice of answer to the question in the dialogue with slave

if interaction = 1113:
	killvar '$text'
	txt = 0
	if slave['passion_comfort'] = 1:
		$text[] = $dyneval($voice_native,'1113_comfort_need',$comfort_need)
	end
	if slave['passion_luxury'] = 1:
		$text[] = $dyneval($voice_native,'1113_luxury_need',$luxury_need)
	end
	if slave['passion_sweets'] = 1:
		$text[] = $dyneval($voice_native,'1113_sweets_need',$sweets_need)
	end
	if slave['passion_fame'] = 1:
		$text[] = $dyneval($voice_native,'1113_fame_need',$fame_need)
	end
	if slave['abuse_attitude'] = 2 and slave['custom'] > 1:
		$text[] = $dyneval($voice_native,'1113_abuse_need',$abuse_need)
	end
	if slave['darkness_attitude'] = 2 and slave['custom'] > 1:
		$text[] = $dyneval($voice_native,'1113_darkness_need',$darkness_need)
	end
	if slave['blood_attitude'] = 2 and slave['custom'] > 1:
		$text[] = $dyneval($voice_native,'1113_blood_need',$blood_need)
	end
	if slave['fire_attitude'] = 2 and slave['custom'] > 1:
		$text[] = $dyneval($voice_native,'1113_fire_need',$fire_need)
	end
	if slave['water_attitude'] = 2 and slave['custom'] > 1:
		$text[] = $dyneval($voice_native,'1113_water_need',$water_need)
	end
	if slave['vermin_attitude'] = 2 and slave['custom'] > 1:
		$text[] = $dyneval($voice_native,'1113_vermin_need',$vermin_need)
	end
	if slave['deprivation_attitude'] = 2 and slave['custom'] > 1:
		$text[] = $dyneval($voice_native,'1113_deprivation_need',$deprivation_need)
	end
	if slave['nymphomania'] > 0 and slave['arousal'] > 1 and slave['instinct'] > 2 and slave['sex_sum'] > 5:
		$text[] = $dyneval($voice_native,'1113_nymphomania_need',$nymphomania_need)
	end
	if slave['homosexualism'] = 2 and slave['arousal'] > 1 and slave['sex_sum'] > 0:
		$text[] = $dyneval($voice_native,'1113_homosexualism_need',$homosexualism_need)
	end
	if slave['exhibitionism'] = 2 and slave['arousal'] > 2 and slave['obedience'] > 20:
		$text[] = $dyneval($voice_native,'1113_exhibitionism_need',$exhibitionism_need)
	end
	if slave['perversion'] = 2 and slave['arousal'] > 3 and slave['obedience'] > 40:
		$text[] = $dyneval($voice_native,'1113_perversion_need',$perversion_need)
	end
	if arrsize('$text') = 0:
		if $slave_psy_status = 'obedient' or $slave_psy_status = 'servile' or $slave_psy_status = 'horny':
			$text[] = $dyneval($voice_native,'1113_no_need_gentle',$no_need_gentle) & jo9_vn_no_request=1
		else
			$text[] = $dyneval($voice_native,'1113_no_need',$no_need) & jo9_vn_no_request=1
		end
	end
end

