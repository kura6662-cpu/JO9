			$text[] = $dyneval($voice_native,'1115_abuse_dislike',$abuse_dislike)
		end
		if slave['darkness_attitude'] = -1 and slave['instinct'] > 0:
			$text[] = $dyneval($voice_native,'1115_darkness_dislike',$darkness_dislike)
		end
		if slave['blood_attitude'] = -1 and slave['instinct'] > 0:
			$text[] = $dyneval($voice_native,'1115_blood_dislike',$blood_dislike)
		end
		if slave['fire_attitude'] = -1 and slave['instinct'] > 0:
			$text[] = $dyneval($voice_native,'1115_fire_dislike',$fire_dislike)
		end
		if slave['water_attitude'] = -1 and slave['instinct'] > 0:
			$text[] = $dyneval($voice_native,'1115_water_dislike',$water_dislike)
		end
		if slave['vermin_attitude'] = -1 and slave['instinct'] > 0:
			$text[] = $dyneval($voice_native,'1115_vermin_dislike',$vermin_dislike)
		end
		if slave['deprivation_attitude'] = -1 and slave['instinct'] > 0:
			$text[] = $dyneval($voice_native,'1115_deprivation_dislike',$deprivation_dislike)
		end
	end
	if arrsize('$text') = 0:
		if slave['obedience'] >= slave['intellect'] - slave['temperament']:
			$text[] = $dyneval($voice_native,'1115_no_dislike',$no_dislike)
		else
			$text[] = $dyneval($voice_native,'1115_hide_dislikes',$hide_dislikes)
		end
	end
