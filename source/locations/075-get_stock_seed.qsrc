	stock["world_index"] = stock_world_index[stock_type]
	stock["nation_index"] = stock_nation_index[stock_type]
	stock["family_index"] = stock_family_index[stock_type]
	stock["work_index"] = stock_work_index[stock_type]
	stock["id"] = stock_id[stock_type]
	stock["relative_id"] = stock_id_relative[stock_type]
	$stock["relative_relations"] = $stock_relative_relations[stock_type]
	stock['tolerant_world'] = RAND (0,20) - (stock["world_index"] * 4) + 4
	stock['tolerant_nation'] = RAND (0,20) - (stock["world_index"] * 4) + 4
	stock['tolerant_family'] = RAND (0,20) - (stock["world_index"] * 4) + 4
	stock['tolerant_work'] = RAND (0,20) - (stock["world_index"] * 4) + 4
	if stock['tolerant_world'] <0: stock['tolerant_world'] = 0
	if stock['tolerant_nation'] <0: stock['tolerant_nation'] = 0
	if stock['tolerant_family'] <0: stock['tolerant_family'] = 0
	if stock['tolerant_work'] <0: stock['tolerant_work'] = 0
end

