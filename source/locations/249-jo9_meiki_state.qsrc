# jo9_meiki_state
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M3027 | 2026-10-15_zz_meiki_state, 2026-10-15_zzz_meiki_training | changed block; context may be included
! JO9_STATE_V2: state bookkeeping only; args[1]=1 permits the first-transition roll.
if $args[0] = 'slave' and func('jo9_meiki_checks', 'age', slave['age']) = 1:
 if slave['jo9_meiki_initialized'] = 0:
  slave['jo9_meiki_initialized'] = 1
  slave['jo9_meiki_prev'] = slave['virginity']
  if slave['virginity'] > 0:
   slave['jo9_meiki_checked'] = 1
  end
 end
 if slave['virginity'] = 4:
  slave['jo9_meiki_known'] = 1
  slave['jo9_meiki_checked'] = 1
 end
 if slave['virginity'] = 1:
  slave['jo9_meiki_checked'] = 1
 end
 if slave['jo9_meiki_prev'] = 0 and slave['virginity'] >= 2 and slave['jo9_meiki_checked'] = 0:
  slave['jo9_meiki_checked'] = 1
  if args[1] = 1:
   if rand(1, 100) <= 5:
    slave['jo9_meiki_known'] = 1
   end
  end
 end
 if slave['jo9_meiki_known'] = 1 and slave['virginity'] >= 2:
  slave['virginity'] = 4
  ! JO9_TRAINING_V3: one-time grant; reuse initialization revision, preserve higher existing ranks.
  if slave['jo9_meiki_initialized'] < 2:
   slave['sub_vaginal'] = max(slave['sub_vaginal'], 5)
   slave['sub_threesome'] = max(slave['sub_threesome'], 3)
   slave['sub_dp'] = max(slave['sub_dp'], 3)
   slave['sub_tp'] = max(slave['sub_tp'], 3)
   slave['sub_gangbang'] = max(slave['sub_gangbang'], 3)
   slave['sub_bukkake'] = max(slave['sub_bukkake'], 3)
   slave['jo9_meiki_initialized'] = 2
  end
 end
 slave['jo9_meiki_prev'] = slave['virginity']
end
