# stasis_cell
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1428 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'stasis_cell': gs 'snk_room_bridge', 'guard', 'stasis_cell'
! JO9 MOD END J9M1428
gs '$newloc' &! refresh features list for current occupant, if any

$stasis_cell = {
	$place = "stasis_cell"
	gs '_layout'

	if dynslave_state = CONST_INT['no_slave']:
		$text = '<<$cell_empty>>'
	else
! JO9 MOD START J9M1427 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
		$text = '<<$dynslave_name>>의 몸은, 동면관 안에 들어가 정체된 상태다. 당신이 스파크만 낼 수 있다면, 그녀는 엄청난 기간동안 살아 갈 수 있을 것이다.'
! JO9 MOD END J9M1427
	end

	if nsfw = 1:
! JO9 MOD START J9M1426 | 2026-10-08_persistent_image_cycle | changed block; context may be included
		*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\empty.png"></div>')
! JO9 MOD END J9M1426
	else
! JO9 MOD START J9M1425 | 2026-10-08_persistent_image_cycle | changed block; context may be included
		*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\<<$bg[$place]>>.png"></div>')
! JO9 MOD END J9M1425
	end

	if dynslave_state ! CONST_INT['no_slave']:
		if nsfw = 0:
! JO9 MOD START J9M1424 | 2026-10-08_persistent_image_cycle, 2026-10-15_z_inline_text_prefix | changed block; context may be included
			*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\<<$dynslave["fullimage"]>>.png"></div>')
			! JO9_INLINE_TEXT_PREFIX_20261015
local $jo9_leading_empty = $strfind($text, '^(\s|&nbsp;|<[bB][rR]\s*/?>)+')
if $jo9_leading_empty ! '': $text = $mid($text, len($jo9_leading_empty) + 1, len($text))
! JO9 MOD END J9M1424
*p '<div id = "text"><<$text>></div>'
		end
	end
	if dynslave_state ! CONST_INT['no_slave'] and slave_state = CONST_INT['no_slave']:
		*p '<div id = "cell"><a href = "EXEC: gs ''slave_to_iced'', <<cryo_cell_selected>> & gt $curloc"><img src="content\pic\buttons\release.png"></a></div>'
	end
	if dynslave_state = CONST_INT['no_slave'] and slave_state ! CONST_INT['no_slave']:
		*p '<div id = "cell"><a href = "EXEC: gs ''slave_to_iced'', <<cryo_cell_selected>> & gt $curloc"><img src="content\pic\buttons\imprison.png"></a></div>'
	end
	if dynslave_state ! CONST_INT['no_slave'] and slave_state ! CONST_INT['no_slave']:
		*p '<div id = "cell"><a href = "EXEC: gs ''slave_to_iced'', <<cryo_cell_selected>> & gt $curloc"><img src="content\pic\buttons\cell_exchange.png"></a></div>'
	end

	if dynslave_state > CONST_INT['no_slave']:
	$info_bar = '호 칭 : &nbsp;<<$dynslave_name>><br>연 령 대 : &nbsp;<<$slave_age_name[dynslave["age"]]>><br>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'beauty', dynslave['beauty'], 1)
	$info_bar += '<br><div style="line-height:25%"><br></div><font style="font-size:12px;"> 외모 </font><<$beauty[dynslave["beauty"]]>></a>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'stamina', dynslave['stamina'], 1)
	$info_bar += '<br><font style="font-size:12px;"> 체력 </font><<$stamina[dynslave["stamina"]]>></a>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'sensitivity', dynslave['sensitivity'], 1)
	$info_bar += '<br><font style="font-size:12px;"> 감수성 </font><<$sensitivity[dynslave["sensitivity"]]>></a><div style="line-height:25%"></div>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'temper', dynslave['temper'], 1)
	$info_bar += '<div style="line-height:25%"><br></div><font style="font-size:12px;"> 성격 </font><<$temper[dynslave["temper"]]>></a>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'intellect', dynslave['intellect'], 1)
	$info_bar += '<br><font style="font-size:12px;"> 지성 </font><<$intellect[dynslave["intellect"]]>></a>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'ego', dynslave['ego'], 1)
	$info_bar += '<br><font style="font-size:12px;"> 자아 </font><<$ego[dynslave["ego"]]>></a><div style="line-height:25%"></div>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'pride', dynslave['pride'], -1)
	$info_bar += '<div style="line-height:25%"><br></div><font style="font-size:12px;"> 태도 </font><<$pride[dynslave["pride"]]>></a>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'exotic', dynslave['exotic'], 1)
	$info_bar += '<br><font style="font-size:12px;"> 독특함 </font><<$exotic[dynslave["exotic"]]>></a>'
	$tooltip_text = func('$addon', 'dynslave_physique_tooltip_text', 'fat', dynslave['fat'])
	$info_bar += '<br><font style="font-size:12px;"> 체형 </font><<$fat[dynslave["fat"]]>></a><div style="line-height:25%"></div>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'style', dynslave['style'], 1)
	$info_bar += '<div style="line-height:25%"><br></div><font style="font-size:12px;"> 세련됨 </font><<$style[dynslave["style"]]>></a>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'fame', dynslave['fame'], 1)
	$info_bar += '<br><font style="font-size:12px;"> 인지도 </font><<$girl_fame[dynslave["fame"]]>></a><div style="line-height:25%"><br></div>'
	$info_bar += '죄수의 특성<div style="line-height:25%"><br></div><<$dynslave_features_list>>'
	else
		$info_bar = ''
		*p '<div id = "side_panel_text"><span class="jo9-reference-body"><<$place_info[$place]>></span><style>.jo9-reference-body,.jo9-reference-body *{font-size:20px !important;}</style></div>'
	
	end
	*p '<div id = "side_panel_location_2"><font style="font-family:경기천년제목 Medium">셀 No.<<cryo_cell_selected>></font></div>'
	*p '<div id = "interaction_stat_bar"><<$info_bar>></div>'
	*p '<div id = "logo3"><a class="tooltip-left-up" tooltip-data="돌아간다" href = "EXEC: gt $return_lock"><img src="content\pic\buttons\leave_quarter.png" style="width:75px;height:75px"></a></div>'

	if cryo_page <= 0 or cryo_page > 3: cryo_page = 1

	*p '<div id="cryo_page_btn_1"><a href = "EXEC: cryo_page = 1 & gt $curloc"><img src = "content\pic\ui\crushboss\white_1.png"></a></div>'
	*p '<div id="cryo_page_btn_2"><a href = "EXEC: cryo_page = 2 & gt $curloc"><img src = "content\pic\ui\crushboss\white_2.png"></a></div>'
	*p '<div id="cryo_page_btn_3"><a href = "EXEC: cryo_page = 3 & gt $curloc"><img src = "content\pic\ui\crushboss\white_3.png"></a></div>'

	if cryo_page = 1:
		if iced_1_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_1_name">№1. <<$iced_1_name>></div>'
			*p '<div id = "Sstasis_1_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_1_in"><a href = "EXEC: cryo_cell_selected = 1 & gt $curloc"><img src = "<<$iced_1[''ava_gray'']>>.png"></a></div>'
		end
		if iced_2_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_2_name">№2. <<$iced_2_name>></div>'
			*p '<div id = "Sstasis_2_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_2_in"><a href = "EXEC: cryo_cell_selected = 2 & gt $curloc"><img src = "<<$iced_2[''ava_gray'']>>.png"></a></div>'
		end
		if iced_3_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_3_name">№3. <<$iced_3_name>></div>'
			*p '<div id = "Sstasis_3_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_3_in"><a href = "EXEC: cryo_cell_selected = 3 & gt $curloc"><img src = "<<$iced_3[''ava_gray'']>>.png"></a></div>'
		end
		if iced_4_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_4_name">№4. <<$iced_4_name>></div>'
			*p '<div id = "Sstasis_4_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_4_in"><a href = "EXEC: cryo_cell_selected = 4 & gt $curloc"><img src = "<<$iced_4[''ava_gray'']>>.png"></a></div>'
		end
		if iced_5_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_5_name">№5. <<$iced_5_name>></div>'
			*p '<div id = "Sstasis_5_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_5_in"><a href = "EXEC: cryo_cell_selected = 5 & gt $curloc"><img src = "<<$iced_5[''ava_gray'']>>.png"></a></div>'
		end
		if iced_6_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_6_name">№6. <<$iced_6_name>></div>'
			*p '<div id = "Sstasis_6_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_6_in"><a href = "EXEC: cryo_cell_selected = 6 & gt $curloc"><img src = "<<$iced_6[''ava_gray'']>>.png"></a></div>'
		end
	elseif cryo_page = 2:
		if iced_7_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_7_name">№7. <<$iced_7_name>></div>'
			*p '<div id = "Sstasis_7_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_7_in"><a href = "EXEC: cryo_cell_selected = 7 & gt $curloc"><img src = "<<$iced_7[''ava_gray'']>>.png"></a></div>'
		end
		if iced_8_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_8_name">№8. <<$iced_8_name>></div>'
			*p '<div id = "Sstasis_8_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_8_in"><a href = "EXEC: cryo_cell_selected = 8 & gt $curloc"><img src = "<<$iced_8[''ava_gray'']>>.png"></a></div>'
		end
		if iced_9_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_9_name">№9. <<$iced_9_name>></div>'
			*p '<div id = "Sstasis_9_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_9_in"><a href = "EXEC: cryo_cell_selected = 9 & gt $curloc"><img src = "<<$iced_9[''ava_gray'']>>.png"></a></div>'
		end
		if iced_10_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_10_name">№10. <<$iced_10_name>></div>'
			*p '<div id = "Sstasis_10_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_10_in"><a href = "EXEC: cryo_cell_selected = 10 & gt $curloc"><img src = "<<$iced_10[''ava_gray'']>>.png"></a></div>'
		end
		if iced_11_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_11_name">№11. <<$iced_11_name>></div>'
			*p '<div id = "Sstasis_11_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_11_in"><a href = "EXEC: cryo_cell_selected = 11 & gt $curloc"><img src = "<<$iced_11[''ava_gray'']>>.png"></a></div>'
		end
		if iced_12_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_12_name">№12. <<$iced_12_name>></div>'
			*p '<div id = "Sstasis_12_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_12_in"><a href = "EXEC: cryo_cell_selected = 12 & gt $curloc"><img src = "<<$iced_12[''ava_gray'']>>.png"></a></div>'
		end
	elseif cryo_page = 3:
		if iced_13_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_13_name">№13. <<$iced_13_name>></div>'
			*p '<div id = "Sstasis_13_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_13_in"><a href = "EXEC: cryo_cell_selected = 13 & gt $curloc"><img src = "<<$iced_13[''ava_gray'']>>.png"></a></div>'
		end
		if iced_14_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_14_name">№14. <<$iced_14_name>></div>'
			*p '<div id = "Sstasis_14_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_14_in"><a href = "EXEC: cryo_cell_selected = 14 & gt $curloc"><img src = "<<$iced_14[''ava_gray'']>>.png"></a></div>'
		end
		if iced_15_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_15_name">№15. <<$iced_15_name>></div>'
			*p '<div id = "Sstasis_15_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_15_in"><a href = "EXEC: cryo_cell_selected = 15 & gt $curloc"><img src = "<<$iced_15[''ava_gray'']>>.png"></a></div>'
		end
		if iced_16_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_16_name">№16. <<$iced_16_name>></div>'
			*p '<div id = "Sstasis_16_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_16_in"><a href = "EXEC: cryo_cell_selected = 16 & gt $curloc"><img src = "<<$iced_16[''ava_gray'']>>.png"></a></div>'
		end
		if iced_17_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_17_name">№17. <<$iced_17_name>></div>'
			*p '<div id = "Sstasis_17_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_17_in"><a href = "EXEC: cryo_cell_selected = 17 & gt $curloc"><img src = "<<$iced_17[''ava_gray'']>>.png"></a></div>'
		end
		if iced_18_state = CONST_INT['slave_exist']:
			*p '<div id = "Sstasis_18_name">№18. <<$iced_18_name>></div>'
			*p '<div id = "Sstasis_18_out"><img src = "content\pic\Cryo_Outline.png"></div>'
			*p '<div id = "Sstasis_18_in"><a href = "EXEC: cryo_cell_selected = 18 & gt $curloc"><img src = "<<$iced_18[''ava_gray'']>>.png"></a></div>'
		end
	end
}


dynamic $replace($stasis_cell, 'dyn'+'slave', 'iced_<<cryo_cell_selected>>')

------------ stasis_cell ------------
