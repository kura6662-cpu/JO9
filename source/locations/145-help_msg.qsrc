$strength_chart += dyneval($vb_cycle_skill, 3, '건장함') + '<br>'
$strength_chart += dyneval($vb_cycle_skill, 4, '강력함') + '<br>'
$strength_chart += dyneval($vb_cycle_skill, 5, '초인적') + '</center>'
! JO9 MOD START J9M1733 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$strength_help = '[체력 TIPS]<br>&nbsp;훈련사의 힘은 매우 중요합니다. 전투중 공격, 행동력, 노예 지시력에 영향을 끼칩니다.<br><br>저급 식단을 피하고, 노예와 잦은 성교, 운동/전투술을 교육하세요. 과로도 좋지 않습니다.'
! JO9 MOD END J9M1733

! JO9 MOD START J9M1732 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$charisma_chart = '<br><center>통솔력 -<br><br>'
! JO9 MOD END J9M1732
$charisma_chart += dyneval($vb_cycle_skill, 0, '패배자') + '<br>'
$charisma_chart += dyneval($vb_cycle_skill, 1, '겁쟁이') + '<br>'
$charisma_chart += dyneval($vb_cycle_skill, 2, '평범함') + '<br>'
$charisma_chart += dyneval($vb_cycle_skill, 3, '의욕적임') + '<br>'
$charisma_chart += dyneval($vb_cycle_skill, 4, '주도적임') + '<br>'
