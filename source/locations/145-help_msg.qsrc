! JO9 MOD START J9M1758 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$красота_справка = '<br><center>외 모 -<br><br>'
! JO9 MOD END J9M1758
$красота_справка += dyneval($vb_cycle_skill, 0, '추함') + '<br>'
$красота_справка += dyneval($vb_cycle_skill, 1, '평범함') + '<br>'
$красота_справка += dyneval($vb_cycle_skill, 2, '귀여움') + '<br>'
$красота_справка += dyneval($vb_cycle_skill, 3, '예쁨') + '<br>'
$красота_справка += dyneval($vb_cycle_skill, 4, '아름다움') + '<br>'
$красота_справка += dyneval($vb_cycle_skill, 5, '눈부심') + '</center>'

$красота_справка_2 = '<br><br>외모는 특히 시장 가치가 높습니다.<br><br><font color="#911f9c"><u>육성 등급 상한은 외모 등급</u></font>과 같습니다.<br><br>등급이 높을수록 가격이 비쌉니다.(명성과 외모중 높은 것 우선)'
! JO9 MOD START J9M1757 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$красота_совет = '[외모 TIPS]<br>&nbsp;외모는 선천적인 비중이 가장 크며, 만약 상처나 폭행 자국이 있다면 등급이 떨어집니다.<br> 노예의 외모를 개선 시키고 싶다면, <b>기술 집약소</b>의 <b>의학 중심지</b>에서 성형수술을 한차례 받을 수 있습니다.<br> 노예를 꾸미거나 옷을 입히는 것은 외모 등급이 아닌, 세련됨 수치를 올리는 것임을 기억해두세요.'
! JO9 MOD END J9M1757

! JO9 MOD START J9M1756 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$здоровье_справка = '<br><center>체력 -<br><br>'
! JO9 MOD END J9M1756
$здоровье_справка += dyneval($vb_cycle_skill, 0, '죽어감') + '<br>'
$здоровье_справка += dyneval($vb_cycle_skill, 1, '쇠약함') + '<br>'
$здоровье_справка += dyneval($vb_cycle_skill, 2, '평범함') + '<br>'
$здоровье_справка += dyneval($vb_cycle_skill, 3, '건강함') + '<br>'
$здоровье_справка += dyneval($vb_cycle_skill, 4, '강인함') + '<br>'
$здоровье_справка += dyneval($vb_cycle_skill, 5, '근육질') + '</center>'
$здоровье_справка_2 = '<br><br>탄력적인 몸매를 가진 노예일수록<br>더 매력적으로 고객을 잘 이끕니다.<Br>치명적인 부상이나 낮은 체력은<br>노예를 죽음에 이르게 할 수도 있습니다 '
! JO9 MOD START J9M1755 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$здоровье_совет = '[체력 TIPS]<br>&nbsp;붉은별: 과로 보라별: 근육통 -<br>낮은 체력, 질병, 상처, 비만, 음수 열량 에는 불이익이 따릅니다. 과로와 근육통을 조심하세요.<br>체력은 근력·신체운동, 춤, 경마녀, 투기, 애완녀, 과한 성관계 로 오릅니다<br>상처 및 질병 치료는 조수의 간호기술, 약물,병원에서 가능합니다.'
! JO9 MOD END J9M1755

! JO9 MOD START J9M1754 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$экзотичность_справка = '<br><center>독특함 -<br><br>'
! JO9 MOD END J9M1754
$экзотичность_справка += dyneval($vb_cycle_skill, 0, '일반적') + '<br>'
$экзотичность_справка += dyneval($vb_cycle_skill, 1, '기이함') + '<br>'
$экзотичность_справка += dyneval($vb_cycle_skill, 2, '이국적임') + '<br>'
$экзотичность_справка += dyneval($vb_cycle_skill, 3, '매혹적임') + '<br>'
$экзотичность_справка += dyneval($vb_cycle_skill, 4, '신비로움') + '<br>'
$экзотичность_справка += dyneval($vb_cycle_skill, 5, '불가사의함') + '</center>'
$экзотичность_справка_2 = '<br><br><br>독특한 분위기를 연출할수록<br>고객들의 흥미를 더 잘 돋굽니다.'
! JO9 MOD START J9M1753 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$экзотичность_совет = '[독특함 TIPS]<br>&nbsp;가끔 타고난 독특함을 가진 노예도 있습니다.<br>문신, 피어싱, 신체 수술, 옷, 가발 등으로 올릴 수 있습니다'
! JO9 MOD END J9M1753

! JO9 MOD START J9M1752 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$жыр_справка = '<br><center>체형 -<br><br>'
! JO9 MOD END J9M1752
$жыр_справка += dyneval($vb_cycle_skill, 0, '비만') + '<br>'
$жыр_справка += dyneval($vb_cycle_skill, 2, '통통한') + '<br>'
$жыр_справка += dyneval($vb_cycle_skill, 3, '육감적인') + '<br>'
$жыр_справка += dyneval($vb_cycle_skill, 4, '날씬한') + '<br>'
$жыр_справка += dyneval($vb_cycle_skill, 5, '모델 체형') + '<br>'
$жыр_справка += dyneval($vb_cycle_skill, 1, '앙상한') + '</center>'
$жыр_справка_2 = '<br><br>뚱뚱할 수록 많은 고기 살점이,<br>마를수록 적게 나옵니다.<br>또 과하면 매력 없으니<br>적당 체형을 유지해주세요.<br>너무 마르게는 말구요.'
! JO9 MOD START J9M1751 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$жыр_совет = '[체형 TIPS]<br>&nbsp;몸매를 볼륨 좋게 유지하려면, 영양소 균형을 맞추어 잘 맞추어야 합니다.<br>등급비례 많은 음식이 필요하며 과식은 좋지 않습니다.<br>근력 운동이 열량 소모를 증가시킵니다.<br>강한 몸엔 많이, 약한 몸엔 적은 음식을 공급해 주세요.'
! JO9 MOD END J9M1751

! JO9 MOD START J9M1750 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$чувствительность_справка = '<br><center>감수성 -<br><br>'
! JO9 MOD END J9M1750
$чувствительность_справка += dyneval($vb_cycle_skill, 0, '무정함') + '<br>'
$чувствительность_справка += dyneval($vb_cycle_skill, 1, '냉담함') + '<br>'
$чувствительность_справка += dyneval($vb_cycle_skill, 2, '둔감함') + '<br>'
$чувствительность_справка += dyneval($vb_cycle_skill, 3, '민감함') + '<br>'
$чувствительность_справка += dyneval($vb_cycle_skill, 4, '다감함') + '<br>'
$чувствительность_справка += dyneval($vb_cycle_skill, 5, '여림') + '</center>'
$чувствительность_справка_2 = '<br><br>여릴수록 처벌 스트레스를 많이 받습니다.<br>하지만, 아이처럼 쉽게 기분 좋아집니다.<br>고객들은 그런 점을 매력으로 평가합니다.'
! JO9 MOD START J9M1749 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$чувствительность_совет = '[감수성 TIPS]<br>&nbsp;감수성은 학대 시에, 그것이 심할수록 더 발달됩니다<br>무신경 할수록 학대를 잘 견디어 기분 변화가 적습니다.<br>하지만, 그런 무신경한 노예는 가격도 낮습니다.<br> <u>좋은 애무와 쾌감만이 감수성을 발달</u>시킵니다.'
! JO9 MOD END J9M1749

! JO9 MOD START J9M1748 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$стиль_справка = '<br><center>세련됨 -<br><br>'
! JO9 MOD END J9M1748
$стиль_справка += dyneval($vb_cycle_skill, 0, '유행에 뒤쳐짐') + '<br>'
$стиль_справка += dyneval($vb_cycle_skill, 1, '흔한 스타일') + '<br>'
$стиль_справка += dyneval($vb_cycle_skill, 2, '유행하는 스타일') + '<br>'
$стиль_справка += dyneval($vb_cycle_skill, 3, '개성적인 스타일') + '<br>'
$стиль_справка += dyneval($vb_cycle_skill, 4, '세련된 스타일') + '<br>'
$стиль_справка += dyneval($vb_cycle_skill, 5, '화려한 스타일') + '</center>'
$стиль_справка_2 = '<br><br>세련됨은 대면 거래에서 가장 중요합니다.<br>구매자는 잘빠진 몸매와 세련됨을 선호합니다.<br>노예를 다른 조건에 부합 시키더라도,<br>구려보이면 판매를 거절하기도 합니다.'
! JO9 MOD START J9M1747 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$стиль_совет = '[세련됨 TIPS]<br>&nbsp;표현 방식: 수사학 모양새: 무용술 -<br>타고난 세련됨에도 꾸미는 기술이 필요합니다.<br>말하는 표현 방식과 움직이는 모양새도 영향 받습니다.<br>머리모양, 화장, 향수, 복장, 패물, 이 모두가 고객을 사로잡는 그 화려함의 영향입니다.<br>그렇다고 항상 화려하게 다닐 필요는 없습니다. 볼 때만 잘 하면 되니까요.'
! JO9 MOD END J9M1747

! JO9 MOD START J9M1746 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$ум_справка = '<br><center>지성 -<br><br>'
! JO9 MOD END J9M1746
$ум_справка += dyneval($vb_cycle_skill, 0, '정신지체') + '<br>'
$ум_справка += dyneval($vb_cycle_skill, 1, '우둔함') + '<br>'
$ум_справка += dyneval($vb_cycle_skill, 2, '평범함') + '<br>'
$ум_справка += dyneval($vb_cycle_skill, 3, '영리함') + '<br>'
$ум_справка += dyneval($vb_cycle_skill, 4, '총명함') + '<br>'
$ум_справка += dyneval($vb_cycle_skill, 5, '지적임') + '</center>'
$ум_справка_2 = '<br><br>지성이 높을수록 교육 성취율이 높습니다.<br>시장에서의 가치 또한 높습니다.<br>하지만, 머리나쁜 노예가 굴리기 쉽습니다.<br>몸의 교육이던, 머리의 교육이던 '
! JO9 MOD START J9M1745 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$ум_совет = '[지성 TIPS]<br>&nbsp;좋은 두뇌라고 항상 유용하진 않죠. 머리가 좋을수록 다루기는 쉽지 않습니다.<br>머리가 좋으니까 일을 합리적으로 처리하고 말을 잘 합니다.<br>노예에 자기 표현을 허용해주고 사무교육, 회계로 지능을 발달시켜 주세요.'
! JO9 MOD END J9M1745

! JO9 MOD START J9M1744 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$темперамент_справка = '<br><center>성격 -<br><br>'
! JO9 MOD END J9M1744
$темперамент_справка += dyneval($vb_cycle_skill, 0, '무관심함') + '<br>'
$темперамент_справка += dyneval($vb_cycle_skill, 1, '차가움') + '<br>'
$темперамент_справка += dyneval($vb_cycle_skill, 2, '내성적임') + '<br>'
$темперамент_справка += dyneval($vb_cycle_skill, 3, '수동적임') + '<br>'
$темперамент_справка += dyneval($vb_cycle_skill, 4, '적극적임') + '<br>'
$темперамент_справка += dyneval($vb_cycle_skill, 5, '열정적임') + '</center>'
$темперамент_справка_2 = '<br><br>적극적일 수록 교육 효과가 낮습니다.<br>반면 침대에서 격정적이기 때문에<bR>고객층 인기가 좋습니다.<br><br>쉽게 다루기에는 적극적이지 않을 수록 좋습니다.'
! JO9 MOD START J9M1743 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$темперамент_совет = '[성격 TIPS]<br>&nbsp;적극적인 노예는 대하기 어려우나, 차가운 건 값이 낮습니다.<br>우울하게 만들거나 입을 다물게 만들면, 어느새 성격이 나빠져 있을겁니다.<br>성격을 발달시키기 위해서는 노예의 표현을 받아주고, 서슴없이 대화하십시오.'
! JO9 MOD END J9M1743

! JO9 MOD START J9M1742 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$характер_справка = '<br><center>자아 -<br><br>'
! JO9 MOD END J9M1742
$характер_справка += dyneval($vb_cycle_skill, 0, '우유부단') + '<br>'
$характер_справка += dyneval($vb_cycle_skill, 1, '겁쟁이') + '<br>'
$характер_справка += dyneval($vb_cycle_skill, 2, '소심함') + '<br>'
$характер_справка += dyneval($vb_cycle_skill, 3, '주관적') + '<br>'
$характер_справка += dyneval($vb_cycle_skill, 4, '단호함') + '<br>'
$характер_справка += dyneval($vb_cycle_skill, 5, '완고함') + '</center>'
$характер_справка_2 = '<br><br>자아가 높은 노예들은 덜 순종적 입니다.<br>등급에 따라 기본 순종도가 낮기도 합니다.<br>노예는 억압을 할 수록 휘두르기 좋으나<br>단, 가치를 저하 시킬수 있습니다'
! JO9 MOD START J9M1741 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$характер_совет = '[자아 TIPS]<br>&nbsp;완고한 노예들은 키워내기 쉽지 않지만, 자아가 없으면 가격도 낮습니다.<br>노예가 싫어하는 일을 강요 할 수록 점점 더 휘둘릴 것 입니다.<br>한 번 떨어진 수치는 정말 회복하기 어렵습니다. 매 행동에 신중을 기하세요.<br>연습경기, 전투, 노예 개인실, 다른 노예 교육, 여가 시간이 이 자아를 키워줍니다.'
! JO9 MOD END J9M1741

! JO9 MOD START J9M1740 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$гордыня_справка = '<br><center>태도 -<br><br>'
! JO9 MOD END J9M1740
$гордыня_справка += dyneval($vb_cycle_skill, 0, '오만함') + '<br>'
$гордыня_справка += dyneval($vb_cycle_skill, 1, '건방짐') + '<br>'
$гордыня_справка += dyneval($vb_cycle_skill, 2, '당당함') + '<br>'
$гордыня_справка += dyneval($vb_cycle_skill, 3, '의존적') + '<br>'
$гордыня_справка += dyneval($vb_cycle_skill, 4, '솔직함') + '<br>'
$гордыня_справка += dyneval($vb_cycle_skill, 5, '개방적') + '</center>'
! JO9 MOD START J9M1739 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$гордыня_справка_2 = '<br><br>오만한 태도는 행위에 걸림돌이 됩니다.<br>심지어 때론, 당신 명령을 거부하기도.<br><br> 이 수치를 낮춰야만 등급이 오릅니다.'
$гордыня_совет = '[태도 TIPS]<br>&nbsp;건방진 태도는 판매와 교육에 있어 나쁩니다. 차라리 솔직하게 만드는 것이 좋습니다.<br>등급 상승을 위해 역겹고 더러운 일, 엄격한 규칙에 적응시켜 주세요.<br>그러면 어느 순간 개방적이 된 노예를 볼 수도 있습니다.<br>그렇다고 무리시키면 노예가 망가질 수 있습니다.'
! JO9 MOD END J9M1739

