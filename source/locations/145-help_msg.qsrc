$дворецкий_справка += dyneval($vb_cycle_skill, 2, '집안일꾼') + '<br>'
$дворецкий_справка += dyneval($vb_cycle_skill, 3, '살림꾼') + '<br>'
$дворецкий_справка += dyneval($vb_cycle_skill, 4, '살림의 대가') + '<br>'
$дворецкий_справка += dyneval($vb_cycle_skill, 5, '집사') + '<br>'
$дворецкий_справка += dyneval($vb_cycle_skill, 6, '수석 집사') + '</center>'
! JO9 MOD START RNL122 | 2026-10-17_zz_rank_display_labels
! RNL: 표시 등급 문자만 변경; 같은 대입문의 연결 줄은 원문을 유지한다.
$дворецкий_совет = '<div style="font-size: 90%;">  살림 능력은 요리, 집안 관리, 회계, 노예 관리 지식을 아우른다. 훌륭한 살림꾼은 직접 저녁을 만들거나 집을 청소할 수도 있지만, 더 중요한 것은 그 기술을 자기 노예들에게 전수할 수 있다는 점이다. 살림 능력은 관련 기술을 A 이상의 성과로 노예들에게 가르칠수록 향상된다.</div>'
! JO9 MOD END RNL122

