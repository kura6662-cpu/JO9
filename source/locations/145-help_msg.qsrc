lor="#6B0084"><b>C</b></font></td></tr><tr><td align="center">3</td><td align="center">전문</td><td align="center"><font color="#0000D8"><b>B</b></font></td></tr><tr><td align="center">4</td><td align="center">상등</td><td align="center"><font color="#009FEF"><b>A</b></font></td></tr><tr><td align="center">5</td><td align="center">최상</td><td align="center"><font color="#009900"><b>S</b></font></td></tr></table></td></tr></table>'
