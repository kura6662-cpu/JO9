! JO9 MOD START J9M1731 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$charisma_help = '[통송력 TIPS]<br>&nbsp;노예와 타인을 통제하는데 영향 끼칩니다. 겉모양을 꾸밈으로써도 통솔력이 오릅니다.<br>어떤 <b>구역</b>에서, 어떤 <b>생활수준</b>으로, <b>얼마나 유명한 사람</b>이냐가, 겉모양에 영향줍니다.'
! JO9 MOD END J9M1731

! JO9 MOD START J9M1730 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$allure_chart = '<br><center>매력 -<br><br>'
! JO9 MOD END J9M1730
$allure_chart += dyneval($vb_cycle_skill, 0, '역겨움') + '<br>'
$allure_chart += dyneval($vb_cycle_skill, 1, '불쾌함') + '<br>'
$allure_chart += dyneval($vb_cycle_skill, 2, '평범함') + '<br>'
$allure_chart += dyneval($vb_cycle_skill, 3, '인상적') + '<br>'
$allure_chart += dyneval($vb_cycle_skill, 4, '매력적') + '<br>'
$allure_chart += dyneval($vb_cycle_skill, 5, '치명적') + '</center>'
! JO9 MOD START J9M1729 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$allure_help = '[매력 TIPS]<br>&nbsp;매력이 곧 외모이고, 노예는 매력적인 주인을 더 잘 따릅니다. 그중에도 성적인 것이면 더욱.<br>인상깊은 외모는 고객과의 소통에 도움이 되고, 노예와 섹스를 강압적으로 할 필요도 없습니다.<br>긍정적인 기분, 미용, 복장으로 꾸며주고 과로를 피해주세요.'
! JO9 MOD END J9M1729

! JO9 MOD START J9M1728 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$libido_chart = '<br><center>욕정 -<br><br>'
