$слава_справка += dyneval($vb_cycle_skill, 0, '무명 노예') + '<br>'
$слава_справка += dyneval($vb_cycle_skill, 1, '알려진 노예') + '<br>'
$слава_справка += dyneval($vb_cycle_skill, 2, '유명한 노예') + '<br>'
$слава_справка += dyneval($vb_cycle_skill, 3, '저명한 노예') + '<br>'
$слава_справка += dyneval($vb_cycle_skill, 4, '스타 노예') + '<br>'
$слава_справка += dyneval($vb_cycle_skill, 5, '로마의 전설') + '</center>'
! JO9 MOD START J9M1737 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$слава_справка_2 = '<br><br><br>유명 노예의 가치는 훨씬 높습니다.<br>노예 최소 등급은 무조건 인지도와 같습니다.<br> 대회 우승시 오릅니다.'
$слава_совет = '[로마 인지도 TIPS]<br>&nbsp;인지도가 전부는 아닙니다. 이것에 개의치 않고도 훌륭한 노예를 육성할 수 있습니다.<br> 명성 영향 : 경주, 투기 대회'
! JO9 MOD END J9M1737

! JO9 MOD START J9M1736 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$калории_совет = '[열량 TIPS]<br>&nbsp;열 량 = 체력/체형 영향, 행동시 감소 &nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp임/산란/모유 배출 -> 익일 -100<br>체중 감소 = [-(100~500) + 2번)]×기초 대사 &nbsp&nbsp&nbsp 0미만&nbsp&nbsp&nbsp-> 익일 ±체력 <br>체중 증가 = (0초과 + 남은 행동)×기초 대사 &nbsp&nbsp&nbsp &nbsp&nbsp&nbsp굶주림 -> -500미만시<br>체중 가감 = 체형 영향'
! JO9 MOD END J9M1736

!CHARACTERISTICS HELP
!$wounds_chart is initialized with $wounds in #variative now - ImperatorAugustus
! JO9 MOD START J9M1735 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$wounds_help = '[부상 TIPS]<br>&nbsp;부상은 전투중 발생하며, 시간에 따라 회복됩니다.<br>부상중엔 기분이 저하되고 행동력 회복량이 감소합니다. 또 병원에서 치료 가능하며,<br>연금술로 <b>기적의 향유</b>을 제조하여 치유할 수도 있습니다. (재료: 추방자 영역, 미스트라의 진귀품점)'
! JO9 MOD END J9M1735

! JO9 MOD START J9M1734 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$strength_chart = '<br><center>힘 -<br><br>'
! JO9 MOD END J9M1734
$strength_chart += dyneval($vb_cycle_skill, 0, '무력함') + '<br>'
$strength_chart += dyneval($vb_cycle_skill, 1, '약골') + '<br>'
