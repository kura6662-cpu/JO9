$libido_chart += dyneval($vb_cycle_skill, 1, '부족함') + '<br>'
$libido_chart += dyneval($vb_cycle_skill, 2, '건강함') + '<br>'
$libido_chart += dyneval($vb_cycle_skill, 3, '열렬함') + '<br>'
$libido_chart += dyneval($vb_cycle_skill, 4, '왕성함') + '<br>'
