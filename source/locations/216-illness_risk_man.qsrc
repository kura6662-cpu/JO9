# $illness_risk_man
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2938 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '$illness_risk_man': gs 'snk_room_bridge', 'guard', '$illness_risk_man'
! JO9 MOD END J9M2938
!Рассчёт риска заразиться при контактном сексе для мастера-мужчины
!Для приямого секса мужчины и непрямого - женщины
 
 IF hero_choice < 100:
    IF slave['ill'] > 0:
        a = RAND (1,6)
        if a > master_str and master_ill = 0 and obereg_on = 0: master_ill = 1
    END
    IF master_ill > 0:
        a = RAND (1,6)
        if a > slave['stamina'] and slave['ill'] = 0: slave['ill'] = 1
    END
 ELSEIF guild_mercs_rule = 0:
    b = RAND (1,4)
    IF b = 1:
        a = RAND (1,6)
        if a > slave['stamina'] and slave['ill'] = 0: slave['ill'] = 1
    END
 END


