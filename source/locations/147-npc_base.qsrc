$npc_image['Ilariya'] = 'Ilariya'
$npc_name['Ilariya'] = '일라리야'
$npc_status['Ilariya'] = '후타랜드 수장의 고문'
$npc_alignment['Ilariya'] = 'Futaland'
$npc_info['Ilariya'] = '길드 상층부의 누군가에게 길러졌지만 낙인은 찍히지 않았다는 소문이 있다. 그녀를 주문한 사람이 자기 주문품에 또 다른 표식을 남기길 원치 않았기 때문이라고 한다. 그녀가 주인의 집으로 들어가자마자 곧 그의 정부 자리를 차지했고, 나중엔 아내가 되었다. 그리고 6개월 뒤, 그녀의 주인은 "노예 사파리" 도중 죽었다. 레이디 일라리야는 막대한 재산을 상속받았고, 이제 그 돈을 자신의 쾌락을 위해 거리낌 없이 쓰고 있다.'
demand_rating['Ilariya'] = 8
$interesting_specialisation['Ilariya'] = 'refferent'
$diary_mark['Ilariya'] = "   <<$npc_name['Ilariya']>>."
$npc_preferences['Ilariya'] = {
stat_importance['intellect'] > 3
stat_importance['ego'] > 3
stat_importance['penetration'] > 4
stat_importance['petting'] > 4
stat_importance['roleplay'] > 4
}
$buyer_demand['Ilariya'] = {
demand['min_beauty'] > 3
demand['notattoos'] = 1
demand['fertility'] = 1
}
! JO9 MOD START J9M1972 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Ilariya_pref[1] = '[일라리야]<br>&nbsp;내 집에 온 걸 환영해요, <<$master_name>>. 주변은 어때요? 지금은 고인이 된 내 남편이 이 모든 걸 지금 모습 그대로 만들려고 거금을 쏟아부었죠. 그를 기리는 뜻에서 전부 그대로 두고 있어요. 하지만 그건 중요하지 않죠. 들러 줘서 반가워요. 즐기자고 권했을 수도 있겠지만, 내가 아무리 그래도 노예 조련사가 내 안에 자기 물건을 넣게 둘 만큼 자존심이 없진 않거든요.'
! JO9 MOD END J9M1972

! JO9 MOD START J9M1971 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Ilariya_pref[2] = ' -… 그게 도대체 그 전에 얼마나 많은 구멍을 드나들었을지 누가 알겠어요? 어이, 잠깐, 가지 마요, 부탁할 일이 있어요, 정말로! 우리 집엔 창녀가 이미 가득해서, 조만간 나도 직접 거래를 할 수 있을 지경이에요. 하지만 제대로 된 조수는 아직도 없어요. 한 열둘쯤 사 봤는데, 아무도 마음에 안 들더군요. 하나같이 병든 달팽이처럼 굼뜨거나, 미쳐 버릴 만큼 멍청하거나. 무슨 말인지 알겠죠? 난 제대로 된 조수가 필요해요.'
! JO9 MOD END J9M1971

! JO9 MOD START J9M1970 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Ilariya_pref[3] = '  나쁜 구매로 너무 여러 번 데였으니, 이번 여자애는 <font color="#008080"><b>영리하고 의지가 강해야</b></font> 해요. 외모가 제일 중요한 건 아니지만, 내 돈을 쓰는 이상 내 곁엔 <font color="#008080"><b>미녀</b></font>가 있어야겠죠. 난 그녀를 데리고 리셉션에도 갈 거니까요! 그러니 문신은 안 되고, 하늘에 맹세코 피어싱이나 개조도 안 돼요. 문제를 피하려면 — 확실히 불임 처리를 해 두세요.'
! JO9 MOD END J9M1970

! JO9 MOD START J9M1969 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Ilariya_pref[4] = '  출장 때문에 며칠씩 집을 비울 때도 있고, 밤이면 외로워져요. 그러니 그녀에게 <font color="#008000"><b>손과 가슴을 쓰는 법</b></font>을 가르쳐 두세요… 그리고 그 계열로 이어지는 다른 것들도요. 사방에 남자들이 들끓고, 호르몬은 펄펄 타오르잖아요. 내 이익을 위해 <font color="#008000"><b>유혹하고 복종하는 법</b></font>을 아는 것도 쓸모 있을 거예요.'
! JO9 MOD END J9M1969

! JO9 MOD START J9M1968 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Ilariya_pref[5] = '  굳이 말할 필요도 없겠지만, <font color="#008000"><b>두 구멍 모두에서의 섹스</b></font>는 훌륭해야 해요. 이게 안 되는 노예를 판다는 건 바닥 없는 컵을 파는 것과 같으니까. 잘 해내면 — 후하게 쳐 줄게요. 가요, 할 일이 많을 테니까.'
$buy_quote['Ilariya'] = '[일라리야]<br>&nbsp;좋아요, 그녀를 받겠어요. 여기 대금이 있어요. 제 역할을 제대로 해내길 기대할게요!'
! JO9 MOD END J9M1968

! JO9 MOD START J9M1967 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_skill_quote['Ilariya'] = '[일라리야]<br>&nbsp;필요한 일에 훈련도 안 되어 있으면, 내겐 쓸모없어요.'
! JO9 MOD END J9M1967

! JO9 MOD START J9M1966 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_level_quote['Ilariya'] = '[일라리야]<br>&nbsp;이건 이 가격엔 못 미쳐요. 더 나은 사람을 찾아와요.'
! JO9 MOD END J9M1966

! JO9 MOD START J9M1965 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_charm_quote['Ilariya'] = '[일라리야]<br>&nbsp;기술적으로는 맞지만, 존재감이 없어요. 인상적이지 않네요.'
! JO9 MOD END J9M1965

! JO9 MOD START J9M1964 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_health_quote['Ilariya'] = '[일라리야]<br>&nbsp;약해 보이고, 이 일에 맞을 만큼 단단해 보이지도 않아요. 산산조각 나지 않는 걸 다행으로 알아요!'
! JO9 MOD END J9M1964

! JO9 MOD START J9M1963 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_pregnant_quote['Ilariya'] = '[일라리야]<br>&nbsp;임신한 노예는 받을 수 없어요.'
! JO9 MOD END J9M1963

! JO9 MOD START J9M1962 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_again_quote['Ilariya'] = '[일라리야]<br>&nbsp;안 된다는 건 안 되는 거예요!'
! JO9 MOD END J9M1962
   
! JO9 MOD START J9M1961 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_special_quote['Ilariya'] = '[일라리야]<br>&nbsp;내 특별 요구 조건은 어쩌고요?! 난 그녀를 받지 않을 거예요!'   
