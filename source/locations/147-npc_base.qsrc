$npc_image['Sisters'] = 'Sisters'
$npc_name['Sisters'] = '쌍둥이들'
$npc_status['Sisters'] = '후타랜드 (중립파)'
$npc_alignment['Sisters'] = 'futaland'
$npc_info['Sisters'] = '  부유한 아버지가 죽은 뒤 두 사람은 고아가 되었다. 그 직후 계모까지 알 수 없는 사정으로 사라져, 소녀들은 홀로 남겨졌다. 하지만 로마에서 벌어지는 우연한 죽음 따위는 이제 아무도 놀라지 않는다…'
demand_rating['Sisters'] = 3
$interesting_specialisation['Sisters'] = 'servant'
$diary_mark['Sisters'] = "   <<$npc_name['Sisters']>>. 후타랜드에 산다."
! JO9 MOD START J9M1979 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Sisters_pref[1] = "[쌍둥이들]<br>&nbsp;좋은 날이네요, <<$master_name>>. 저희는 완전히 둘뿐이라서, <<$rating[demand_rating['Sisters']]>> 등급 이상의 상냥한 하녀가 정말 필요해요. 그녀는 반드시 성인이어야 해요! 보상으로 <<common_price[demand_rating['Sisters']]>> 스파크를 드릴게요."
$buy_quote['Sisters'] = '[쌍둥이들]<br>&nbsp;좋아요, 그녀를 받겠어요. 여기 스파크예요, 고마워요! 우리 마음에 들었으면 좋겠네요!'
$refuse_skill_quote['Sisters'] = '[쌍둥이들]<br>&nbsp;해야 할 일을 하도록 훈련되지도 않았는데, 우리가 왜 그녀를 받겠어요? 그런 일꾼엔 관심 없어요.'
$refuse_level_quote['Sisters'] = '[쌍둥이들]<br>&nbsp;더 나은 사람은 없나요? 이 값엔 어울리지 않아요.'
$refuse_charm_quote['Sisters'] = '[쌍둥이들]<br>&nbsp;흠… 모르겠네요. 형식상으론 맞지만 볼품이 없어요. 저희 취향은 아니에요.'
$refuse_health_quote['Sisters'] = '[쌍둥이들]<br>&nbsp;뭘 저희한테 팔아넘기려는 거죠? 병약해 보이고, 충분히 튼튼해 보이지도 않아요. 산산조각 나지 않는 걸 다행으로 아세요!'
$refuse_pregnant_quote['Sisters'] = '[쌍둥이들]<br>&nbsp;임신한 여자를 우리한테 팔려고? 어림도 없지!'
$refuse_again_quote['Sisters'] = '[쌍둥이들]<br>&nbsp;안 된다는 건 안 되는 거예요!'
