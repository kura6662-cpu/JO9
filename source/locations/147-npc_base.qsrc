demand['min_stamina'] = 4
demand['min_beauty'] > 2
}
! JO9 MOD START J9M1885 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$vampire_hunter_pref[1] = '[뱀파이어 헌터]<br>&nbsp;흡혈귀 하나는 죽일 수 있다. 하지만 놈들을 모조리 죽일 수는 없지. 훨씬 더 중요한 건, 놈들이 인간과 평화롭게 공존하도록 돌이킬 수 없는 적응 과정을 시작하게 만드는 거다. 그건 결코 쉬운 일이 아니다. 그리고 내가 그걸 어떻게 해낼지 분명한 계획은 갖고 있지만, 그걸 실행할 고급 인력이 필요하다. 나는 자기 종족에게 치료제가 될 준비가 된 특별한 뱀파이어 여자애들이 필요하다.'
$vampire_hunter_pref[2] = '[뱀파이어 헌터]<br>&nbsp;그래서 원본 뱀파이어에게 요구되는 조건도 꽤 구체적이다. 우선, 흡혈귀들은 풍부하고 세월이 밴 피를 선호한다. 그리고 그녀가 감당해야 할 부담을 버텨 내려면, <font color="#008000"><b>신체적으로 강한</b></font>, <b>젊거나 성숙한</b> 여자만이 가능하다.'
$vampire_hunter_pref[3] = '[뱀파이어 헌터]<br>&nbsp;두 번째이자 매우 중요한 조건이 있다... 나는 <font color="#0000CD"><b>의학과 연금술</b></font>의 <font color="#008000"><b>전문가</b></font>가 필요하다. 이 지식은 뱀파이어 의식 이후 잃은 힘을 빠르게 회복하게 해 줄 뿐 아니라, 그녀 피 속에 필요한 은 농도를 감시하는 데도 도움이 된다. 이것은 그 여자애의 훈련에도 중요한 역할을 하게 될 거다.'
$vampire_hunter_pref[4] = '[뱀파이어 헌터]<br>&nbsp;원본이 자신의 상태를 현실적으로 보여 줄 수 있다면, 내 작업은 훨씬 수월해질 거고, 그녀가 필연적으로, 그것도 여러 번 겪게 될 금단 증상도 좀 더 쉽게 넘길 수 있게 된다... 그리고 이제 가장 좋은 부분이지...'
$vampire_hunter_pref[5] = '[뱀파이어 헌터]<br>&nbsp;흡혈귀들은 타락한 난교가 벌어지는 화려한 무도회를 특히 좋아한다. 그곳에서 희생양을 고르지. 그러니 그 여자애가 흡혈귀를 손쉽게 <font color="#0000CD"><b>유혹하고 끌어들일</b></font> 수 있는 게 중요하다. 그러려면 충분히 <font color="#0000CD"><b>예뻐야</b></font> 하고, 한 명이든 여러 명이든 동시에 상대하는 온갖 육체적 놀이에 잘 준비되어 있어야 한다.'
$vampire_hunter_pref[6] = '[뱀파이어 헌터]<br>&nbsp;그리고 그녀의 욕망과 성행위 능력은 피를 정화하는 과정을 앞당기는 데도 유용하다. 예를 들어 흡혈귀에게 우유를 마시게 하거나 견과류를 먹이게 만드는 건 쉽지 않다. 그렇다고 와인에 중독시키는 것도 최선은 아니지. 하지만 섹스를 통해서라면, 나는 여자애 몸에 눈에 띄지 않게 은을 채워 넣을 수 있고, 큰 저항도 마주치지 않을 것이다. 그러면 이후 작업에 드는 시간도 엄청나게 절약할 수 있지.'
$vampire_hunter_pref[7] = '[뱀파이어 헌터]<br>&nbsp;좋은 흡혈귀 치료제로 만들기 위해 내가 원본 재료에서 바라는 건 그게 전부다, <<$master_name>>. 인정해야 하지 않겠나, 그렇게 어려운 일도 아니야. 하지만 네가 내 일에 힘을 보태고 구울들과의 싸움을 도와준다면, 난 아주 고마워할 거고 스파크도 아끼지 않겠다.'
$buy_quote['vampire_hunter'] = '[뱀파이어 헌터]<br>&nbsp;딱 내가 필요로 하던 거다! 이 일에 완벽한 후보야! 이 여자애를 받겠다, <<$master_name>>! 네 스파크는 챙겨 둬라...'
! JO9 MOD END J9M1885

! JO9 MOD START J9M1884 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_skill_quote['vampire_hunter'] = '[뱀파이어 헌터]<br>&nbsp;솔직히 말해서, 그녀는 너무 약해, <<$master_name>>! 게다가 필요한 일조차 제대로 못 해...'
! JO9 MOD END J9M1884

! JO9 MOD START J9M1883 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_level_quote['vampire_hunter'] = '[뱀파이어 헌터]<br>&nbsp;좋긴 하다, 그건 인정하지! 하지만 네 노예들에겐 훈련 등급이 있지 않나? 내가 보기엔 완벽해지려면 한두 등급은 더 높아야 해. 그러니 계속 다듬어라, <<$master_name>>!'
! JO9 MOD END J9M1883

! JO9 MOD START J9M1882 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_charm_quote['vampire_hunter'] = '[뱀파이어 헌터]<br>&nbsp;미래의 흡혈귀인데 못생기기까지 하다고?! 놈들이 미남미녀는 아니라는 건 나도 안다. 하지만 놈들 스스로는 그렇게 생각하지 않아. 흡혈귀들은 자기 먹잇감이 맛있을 뿐 아니라 예쁘기까지 하길 바라지. 그 점을 해결해 와라...'
! JO9 MOD END J9M1882

! JO9 MOD START J9M1881 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_health_quote['vampire_hunter'] = '[뱀파이어 헌터]<br>&nbsp;너무 허약해, <<$master_name>>! 어쩌면 병까지 있을지도... 이건 안 된다!'
! JO9 MOD END J9M1881

! JO9 MOD START J9M1880 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_pregnant_quote['vampire_hunter'] = '[뱀파이어 헌터]<br>&nbsp;<<$master_name>>, 난 미래의 흡혈귀들을 위한 산부인과를 운영하는 게 아니다! 이걸 막는 게 그렇게 어려웠나?!...'
! JO9 MOD END J9M1880

! JO9 MOD START J9M1879 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_special_quote['vampire_hunter'] = '[뱀파이어 헌터]<br>&nbsp;나쁘진 않다! 하지만 뭔가 마음에 안 들어. 다른 애를 찾아와!'
! JO9 MOD END J9M1879


