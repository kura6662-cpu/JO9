! JO9 MOD START J9M1945 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Nimfadora_pref[1] = '[님파도라]<br>&nbsp;세상에나… <<$master_name>>. 길드에서 또 한 놈 왔네, 자기 다리 사이에 물건 하나 달고 태어났다는 이유만으로 세상 모든 문이 다 자기한테 열려 있다고 믿는 놈 말이야. 하지만 항구 쪽에서 네 평판은 좋더라. 너 자신뿐 아니라 네가 길러 내는 노예들에 대해서도 말이야. 그래서 네가 내 취향도 만족시킬 수 있는지 궁금해졌어. 내 지하실에 <font color="#008000"><b>여리고</b></font> <font color="#008000"><b>건강한</b></font> 여자애 하나를 두고 싶어...'
$Nimfadora_pref[2] = '  부드러운 작은 꽃들은 울고 애원하는 모습이 어찌나 진심 같던지, 내 피가 끓고 자지가 아프도록 선단 말이야. 또 <font color="#008000"><b>기질도 있어야</b></font> 해—침대에서 통나무 같은 건 필요 없어, 그런 년들 따먹는 건 지독하게 지루하거든. <<$master_name>>, 내 말 뜻을 제대로 이해해. 난 여자 수백 명은 박아 봤어, 어쩌면 그보다 더 많을지도. 날 놀라게 하는 건 거의 불가능하지만, 내가 뭘 좋아하는지는 누구보다 정확히 알지.'
$Nimfadora_pref[3] = ' 내가 주는 <font color="#008000"><b>고통이 클수록 더 갈망하는지</b></font>, 아니면 크리스마스 햄처럼 묶어 놓았을 때 절정하는지를 보고 싶어. 그런 건 가르칠 수 없어, 타고나야 하는 거야. 그 외에 뭘 할 줄 아는지는 상관없어—노래를 하든, 춤을 추든, 주문을 외우든, 전부 쓸모없어, 그런 기술은 필요 없거든. 그녀는 <font color="#008000"><b>섹스를 잘해야</b></font> 하고 내 자지를 끝까지 삼킬 수 있어야 해. 그러면 난 충분히 만족할 거야.'
$Nimfadora_pref[4] = '  하지만 젖꼭지에 바늘을 찌르거나 보지에 핀을 꽂는 것 같은 특별한 짓은 완벽하게, 그리고 열정적으로 사랑해야 해. 난 연기하는 년은 필요 없어. 진짜, 날것 그대로의 감정이 필요해. 무슨 뜻인지 알겠지, <<$master_name>>?'
$Nimfadora_pref[5] = '  내가 시키는 대로 다 해. 그러면 내 특별한 친구에 대해 말해 주지. 네 실력이 날 만족시킬 정도라면, 그 여자의 요구도 감당할 수 있을 거야. 그 여자는 늘 고급 노예가 필요하고, 돈도 아주 후하게 내거든. 가서 내 여자를 훈련시켜 와. 후회 안 할 거다.'
! JO9 MOD END J9M1945

! JO9 MOD START J9M1944 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['Nimfadora'] = '[님파도라]<br>&nbsp;좋아, <<$master_name>>, 그녀를 받겠어. 여기 스파크야, 고맙군. 내 마음에 들었으면 좋겠어!'
$refuse_skill_quote['Nimfadora'] = '[님파도라]<br>&nbsp;내가 요구한 건 아주 조금이었어, 거의 아무것도 아니지. 그런데 그것조차 겨우 해내는 수준이네. 날 실망시키지 마, <<$master_name>>. 난 엄연히 VIP 고객이니까.'
$refuse_level_quote['Nimfadora'] = '[님파도라]<br>&nbsp;말해 봐, 이 상품이 VIP에게 어울리나?'
$refuse_charm_quote['Nimfadora'] = '[님파도라]<br>&nbsp;흐음… 모르겠군. 형식상으론 맞지만, 좀 볼품없어. 내 취향을 끌지 못해.'
$refuse_health_quote['Nimfadora'] = '[님파도라]<br>&nbsp;뭘 나한테 팔아넘기려는 거지? 얘는 건강하지 못해 보이고, 힘든 일에 맞을 만큼 튼튼해 보이지도 않아. 난 이런 건 필요 없어!'
$refuse_pregnant_quote['Nimfadora'] = '[님파도라]<br>&nbsp;임신한 여자애를 나한테 팔아넘기고 내가 받아들일 거라 생각하나? 절대 안 돼!'
$refuse_special_quote['Nimfadora'] = '[님파도라]<br>&nbsp;다른 걸 찾아와! 이건 전혀 마음에 안 들어!'
! JO9 MOD END J9M1944

$$npc_image['ferma_futa'] = 'ferma_futa'
$npc_name['ferma_futa'] = '완다와 오니시아'
$npc_status['ferma_futa'] = '농부들 (중립파)'
$npc_alignment['ferma_futa'] = 'futaland'
$npc_info['ferma_futa'] = '완다와 오니시아는 이름난 농부들이다. 그들은 후타랜드 전체에 농산물을 공급한다. 주민들은 모든 게 바로 손닿는 곳에 있으니 백색 도시 상점에 갈 필요가 없다. 여자애들의 값은 꽤 비싸지만, 아무도 불평하지 않는다. 여기 농산물의 품질은 차원이 다르니까. 또 그들은 문제 많은 노예들을 기꺼이 축사로 받아들인다.'
demand_rating['ferma_futa'] = 6
$interesting_specialisation['ferma_futa'] = 'pet'
$npc_preferences['ferma_futa'] = {
stat_importance['intellect'] > 3
stat_importance['ego'] > 3
stat_importance['nurse'] > 2
stat_importance['service'] > 2
stat_importance['cook'] > 3
stat_importance['secretary'] > 3
stat_importance['oral'] > 3
stat_importance['penetration'] > 2
stat_importance['petting'] > 3
stat_importance['orgy'] > 2
}
npc_attitude['ferma_futa'] = 30
npc_reveal['ferma_futa'] = 1
npc_bennies['ferma_futa'] = 6
npc_reward['ferma_futa'] = 200
npc_advance['ferma_futa'] = 150
demand_rating['ferma_futa'] = 8
buying_temp['ferma_futa'] = 25
count_size['ferma_futa'] = 1
$buyer_demand['ferma_futa'] = {
demand['refuse_age'] = 1
demand['refuse_age'] = 2
demand['min_stamina'] = 4
demand['lactation'] = 1
}
! JO9 MOD START J9M1943 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$ferma_futa_pref[1] = '[완다]<br>&nbsp;좋은 날이네, <<$master_name>>. 그래, 당신은 확실히 남자답군. 길드 놈에게 뭘 더 바라겠어? 재능 있는 여자는 우리 쪽에도 넘치는데, 그런 얼간이들만 죄다 긁어모았잖아. 하지만 너 같은 남자들은 언제나 여자를 상품으로만 보지. 기회만 있으면 내 엉덩이에도 낙인 찍었겠지! 뭐, 얘기는 나중에 더 하고, 우린 주문을 넣고 싶어.'
$ferma_futa_pref[2] = '[오니시아]<br>&nbsp;우린 축사를 넓히고 있어서 특별한 노예가 하나 필요해. 다른 가축 여자애들을 감독할 어린 암소 말이야. <font color="#008080"><b>강한 성격</b></font>, 완벽한 <font color="#008080"><b>건강</b></font>, 그리고 물론 <font color="#008080"><b>머리</b></font>가 있어야 해. 안 그러면 나머지 가축들과 뭐가 다르겠어?'
! JO9 MOD END J9M1943
$ferma_futa_pref[3] = '  또 그녀는 <font color="#008080"><b>농장 장부를 관리</b></font>할 줄 알아야 하고, 전염병을 막기 위해 아픈 가축을 <font color="#0000CD"><b>치료</b></font>할 수 있어야 해. 게다가 맡을 일엔 <font color="#0000CD"><b>청소</b></font>와 <font color="#0000CD"><b>요리</b></font>도 포함되지. 이 부분은 너무 부담 갖지 마. 축사 청소가 어려운 일은 아니고, 암소들한테 미식가용 음식을 먹일 필요도 없으니까.'
! JO9 MOD START J9M1942 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$ferma_futa_pref[4] = '[완다]<br>&nbsp;<<$master_name>>, 알다시피 인생에서 일만 있는 건 아니지. 노예는 여러 일을 할 수 있어야 해. 그러니 <font color="#008080"><b>손과 입</b></font>을 쓸 줄도 알아야지. 그리고 주인이 둘이니, <font color="#0000CD"><b>두 구멍 모두 멀쩡히 써먹을 수 있어야</b></font> 해. 한꺼번에 두 자지를 받아들이는 건 당연한 걸로 봐야지.'
$ferma_futa_pref[5] = '[오니시아]<br>&nbsp;보기엔 아주 간단하지. 값은 후하게 치를 거야, 그건 믿어도 돼. 우린 너와 우리의 새 암소를 기다리고 있을게. 그리고 말이야, <<$master_name>>, 네 작업이 마음에 들면 농장 암소들의 주 공급자로 널 고려할 수도 있어.'
! JO9 MOD END J9M1942

$npc_image['Sisters_Menish'] = 'Sisters_Menish'
$npc_name['Sisters_Menish'] = '라다와 림마 메니시'
$npc_status['Sisters_Menish'] = '(중립파)'
$npc_alignment['Sisters_Menish'] = 'futaland'
$npc_info['Sisters_Menish'] = '라다와 림마 메니시 - 한 살 차이로 태어난 자매다. 이미 서른을 넘겼지만 성적 식탐은 점점 더 커지고 있고, 그들의 변태적인 극단성은 숙련된 조련사들조차 겁먹게 만든다. 새 주문을 낼 때마다 더욱 타락한 요구를 한다고 유명하다.'
npc_attitude['Sisters_Menish'] = 30

$npc_image['Adriana'] = 'Adriana'
$npc_name['Adriana'] = '아드리아나'
$npc_status['Adriana'] = '(중립파)'
$npc_alignment['Adriana'] = 'futaland'
$npc_info['Adriana'] = '매력적인 외모의 젊은 여자다. 로마에 갑자기 나타났고, 노예상 길드와 몇 차례 큰 추문을 일으킨 뒤 후타랜드에 정착했다. 소문에 따르면 바티칸과도 충돌이 있었다고 한다.'
npc_attitude['Adriana'] = 30
! JO9 MOD START J9M1941 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Adriana_quest[1] = '[아드리아나]<br>&nbsp;좋은 하루네, <<$master_name>>. 당신은 꽤 좋은 노예 조련사라고 소문이 났더라. 그리고 난 솔직히 여자가 여자를 훈련시킬 수 있다는 걸 별로 믿지 않지만... 그래도 기회는 한번 줄게.'
$Adriana_quest[2] = '[아드리아나]<br>&nbsp;빌어먹을 바티칸 창녀들이 내 노예들을 전부 끌고 갔어. 임신했다고 뭐? 나중 단계에서 낙태시키면 됐잖아, 그런데 내 말을 안 듣더라. 다 불타 죽어 버렸으면...'
$Adriana_quest[3] = '[아드리아나]<br>&nbsp;그러니, <<$master_name>>, 잘 들어. 살아 있는 사람에게 무엇이 필요하지? 물론, 강한 자지가 자기 안으로 들어오기를 너무도 갈망하는 <font color="#008080"><b>아름답고</b></font>, 다정하고, 젊은 여자지. 그녀가 나를 위해 <font color="#0000CD"><b>노래도 부르고</b></font> <font color="#0000CD"><b>뭔가 요리도 하게</b></font> 해. 난 가끔 로맨틱하게 저녁을 보내는 걸 좋아하거든, 안 그러면 침묵 속에 앉아 있는 건 지루하니까.'
$Adriana_quest[4] = '[아드리아나]<br>&nbsp;아무것도 못 하는 창녀가 무슨 쓸모야? 그녀는 <font color="#008080"><b>날 잘 만족시켜야</b></font> 하고, <font color="#008080"><b>날 받아 달라고 아름답게 애원할 줄</b></font> 알아야 하며, 물론 혀도 제대로 쓸 줄 알아야 해.'
$Adriana_quest[5] = '[아드리아나]<br>&nbsp;그리고 특별 요구 하나. 임신한 상태였으면 좋겠어. 물론 네가 직접 배를 불리라는 건 아니야, 길드 동료들한테 부탁하면 되잖아. 그런 부탁을 마다할 놈은 없을 거라 확신해. 다만 꼭 검사해 둬—네놈들 남자들이 무슨 더러운 병을 옮기고 다니는지 누가 알겠어?'
! JO9 MOD END J9M1941
$Adriana_win[1] = ' [<<$slave_name>>]
- Mistress, what an appetizing member you have! And so... big!!! Mmm! Even though I am pregnant, and must take care of the future child, but I can not resist my bitch nature at the sight of such a queen as you! Will you let a slut make you feel good?!... '
! JO9 MOD START J9M1940 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Adriana_win[2] = '[아드리아나]<br>&nbsp;<<$master_name>>, 당신은 날 정말 기분 좋게 놀라게 했어!!! 이렇게... 뜨겁고! 이렇게... 음! 뭐, 무슨 말인지 알겠지... 난 이 여자애를 받겠어!!! 생각할 것도 없어!!! 수고했어, <<$master_name>>! 너무 원망하진 마! 더 주고 싶긴 한데, 지금 스파크 사정이 안 좋아서 더는 도저히 못 쓰겠어...'
$Adriana_fail[1] = '[아드리아나]<br>&nbsp;내가 준비해 오라고 한 애는 어디 있어? 역시 당신은 믿을 수가 없군!'
! JO9 MOD END J9M1940



$npc_image['Isyagay'] = 'Isyagay'
$npc_name['Isyagay'] = '이샤가이'
$npc_status['Isyagay'] = '사업가 (중립파)'
$npc_alignment['Isyagay'] = 'futaland'
$npc_info['Isyagay'] = '영원의 도시에서 스스로 성공을 이뤘다고 자랑할 수 있는 여자는 아주 드물다. 하지만 이샤가이와 그녀의 가장 친한 친구 칼레리야는 예외다. 한때 모든 걸 걸고 위험을 감수한 뒤 손을 잡았고, 온갖 장애를 넘어 이제는 굳건하고 자신감 있게 자기 자리를 지키고 있다...'
