! JO9 MOD START J9M1934 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Amarida_pref[1] = '[아마리다]<br>&nbsp;안녕, <<$master_name>>! 널 만나길 기다리고 있었어! 너무 놀라진 마—여자들도 가끔은 장난을 치고 싶어 하니까… 게다가 이 도시에서 누가 누구와 자는지 누가 신경이나 쓰겠어?… 이 방탕의 왕국에선 동성 관계가 일상인걸! 너만큼 그걸 잘 아는 사람도 없지, 안 그래?… 하지만 뭐… 지금 중요한 건 그게 아니야.'
$Amarida_pref[2] = '[아마리다]<br>&nbsp;당신은 바보가 아니니까, 평범한 여자 하나가 인생에서 영향력 있는 후원 없이 앞서 나가기 쉽지 않다는 걸 완벽히 이해하겠지. 그리고 짐작했겠지만, 나에겐 그런 후원자가 있어… 난 정말 운이 좋았던 거 같아… 안개 속에 떨어졌을 때, 지금의 나를 만들어 준 존경받는 영주를 만났거든. "대디"는 아주 관대해… 지나칠 정도로…'
$Amarida_pref[3] = '[아마리다]<br>&nbsp;그가 없었다면 지금 이 모든 건 없었겠지… 그리고 난 내 "행운의 티켓"을 마다할 만큼 바보가 아니야… 당연히 그 대가로 난 그의 뜻대로 움직이고, 그가 원하는 건 뭐든 해야 해. 다행히도 그는 그렇게까지 많은 걸 요구하진 않아… 무슨 말인지 당신은 이미 눈치챘을 테고, 자세한 얘긴 넘어가자.'
$Amarida_pref[4] = '[아마리다]<br>&nbsp;그런데 최근엔 내가 그에게 충분하지 않게 됐고, 그는 아름다운 여자애들 무리를 원해. 달콤한 미소를 띠고 그의 모든 욕정 어린 바람을 들어줄 여자애들 말이야. 그는 원할 때마다 여기 와서 내 모델들과 놀고 가지. 논리적으로 보면 당연한 일이지… 어디 가서 이렇게 근사한 미녀들을 찾겠어?! 나도 반대하진 않아. 오히려 나한텐 더 편해… 하지만 한 가지 문제가 있어.'
$Amarida_pref[5] = '[아마리다]<br>&nbsp;내가 가장 아끼는 여자애가 그의 선택받은 무리에 들어가 버렸어. 그리고 난 그게 정말 싫어. 내 마리슈카를 누구와도 나누고 싶지 않아. 그 애는 오직 내 것이어야 해, 누구의 것도 아니고! 물론 이런 말을 그에게 대놓고 할 순 없어. "대디"는 자기 부름에 모든 게 첫 번째로 따라오는 것에 익숙하니까… 그리고 그와 이야기를 하려면, 난 그 대가로 뭔가를 내줘야 해.'
$Amarida_pref[6] = '[아마리다]<br>&nbsp;그래서 난 그의 정신을 흐리게 할 수 있는 <b>젊은</b> 여자가 필요해. 난 특별한 건 필요 없어. 그저 <font color="#008080"><b>놀라운 첩</b></font> 하나를 손에 넣고 싶을 뿐이야, 도저히 <font color="#008000"><b>눈을 뗄 수 없을</b></font> 정도의. 그리고 무엇보다 그녀는 우선 모델이 될 테니, 당연히 자기 몸을 <font color="#008000"><b>완벽하게 통제할 줄 알고</b></font>, <font color="#008080"><b>충분히 교육받았으며</b></font>, 완벽한 <font color="#008000"><b>예절 규범</b></font>을 갖추고 있어야 해.'
$Amarida_pref[7] = '[아마리다]<br>&nbsp;그리고 가장 중요한 건, <b>문신도 피어싱도 안 된다는 거야</b>. 몸에 새긴 어떤 장식도 언제나 어울리는 건 아니니까... 내가 필요한 건 이게 전부인 것 같네... 그리고 제발, 내가 필요로 하는 여자애를 준비하는 걸 미루지 마! 알겠지, 난... "대디"가 가끔 날 쓰는 건 익숙해... 하지만 내 사랑을 내 눈앞에서 그가 박는 건 정말 보고 싶지 않거든.'
$Amarida_pref[8] = '[아마리다]<br>&nbsp;난 질투가 엄청 심한 여자야. 내 것을 누구와도 나눌 생각은 없어. 그리고 내가 원하는 여자애를 더 빨리 손에 넣을수록, 더 빨리 "대디"와 흥정할 수 있고, 더 빨리 내 마리슈카를 온전히 내 것으로 만들 수 있어. 그러면 우린 서로에게만 속하게 되겠지... 그렇지, 내 사랑?... 흐음! 흐음! <<$master_name>>, 그리고 그다음엔, 허락해 준다면 우린 당신 없이 지내 볼게. 나중에 봐!'
$buy_quote['Amarida'] = '[대디]<br>&nbsp;와! 얘 정말 끝내준다! 아마리다, 이 여자애를 내 걸로 만들어! 당장!!!<br>[아마리다]<br>&nbsp;<<$master_name>>... 당신도 직접 다 들었잖아. 난 "대디"를 거절할 수 없어!... 그리고, 응... 정말 고마워! 이제 내 사랑하는 여자를 누구와도 나누지 않아도 되길 바랄게!.'
$refuse_skill_quote['Amarida'] = '[아마리다]<br>&nbsp;해야 할 일을 하도록 훈련도 안 되어 있는데, 내가 왜 그녀를 필요로 하지?'
$refuse_level_quote['Amarida'] = '[아마리다]<br>&nbsp;더 나은 상품은 못 구하겠어? 이건 이 돈을 받을 만한 수준이 아니야.'
$refuse_charm_quote['Amarida'] = '[아마리다]<br>&nbsp;흐음.... 모르겠네. 형식상으론 맞지만, 그다지 보기 좋진 않아. 내 시선을 끌지 못해.'
$refuse_health_quote['Amarida'] = '[아마리다]<br>&nbsp;뭘 나한테 팔아넘기려는 거야? 얘는 건강해 보이지도 않고, 무슨 일이든 할 만한 힘이 있어 보이지도 않잖아.'
$refuse_pregnant_quote['Amarida'] = '[아마리다]<br>&nbsp;임신했다고?! 제정신이야, <<$master_name>>?'
$refuse_again_quote['Amarida'] = '[아마리다]<br>&nbsp;안 된다는 건 안 되는 거야!'
$refuse_special_quote['Amarida'] = '[아마리다]<br>&nbsp;내 특별 요구 조건은 어쩌고?! 난 그녀를 받지 않을 거야!'
! JO9 MOD END J9M1934

