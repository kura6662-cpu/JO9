! JO9 MOD START J9M2084 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$bishop_shaitana_pref[1] = '[주교 샤이타나]<br>&nbsp;오 <<$master_name>>, 들어와. 거기 앉지. 알고 있나? 안개를 저지하면서도 우리 가문 영역을 넓히는데 필요한 것. 이 의식들엔 스파크가 들어, 맞아. 또 그걸 원숙하게 해내야지.</div>'
! JO9 MOD END J9M2084
$bishop_shaitana_pref[2] = '[주교 샤이타나]<br> 내가 신전용 처녀를 직접 골라야 해. 그 제한은 상당하지. 그러니, 도움에는 기꺼이 돈을 지불하겠어. 우리 의식엔 무조건 <br>아동 처녀</b>를 필요로 해. 아직 사랑을 안 나눠본 아이들.</div>'
! JO9 MOD START J9M2083 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$bishop_shaitana_pref[3] = '[주교 샤이타나]<br>&nbsp;동시에 <font color="#009900"><b>연금술의 대가</b></font>여야 해, 그 여자가 직접 성약을 만들테니까. 의식 최중요 작업이니 실수는 용납 못 해.</div>'
$bishop_shaitana_pref[4] = '[주교 샤이타나]<br>&nbsp;의식에 참여하려면, 그 처녀가 반드시 뛰어난 <font color="#009FEF"><b>곡조</b></font>로 <font color="#008080"><b>춤</b></font>을 추며 덜시머를 <font color="#009FEF"><b>연주</b></font>할거야. 그리고 신을 섬기는 마음도 필요할테지.</div>'
$bishop_shaitana_pref[5] = '[주교 샤이타나]<br>&nbsp;보다시피 쉬운 조건들이 아니야. 그렇다고 아무나 붙잡아다 신전에 데려갈 순 없는 노릇. 최고의 재료만 엄선하고 교육해서 데려와. 스파크가 기다릴테니.</div>'
$buy_quote['bishop_shaitana'] = '[주교 샤이타나]<br>&nbsp;나이도 적절하고 외모도 딱 이군.<br>네 말처럼 성약을 제대로 만드는거면 <<$master_name>>, 그럼 데려가겠어. 이제 네 스파크를 취하면 돼.</div>'
$refuse_skill_quote['bishop_shaitana'] = '[주교 샤이타나]<br>&nbsp;어떤 실수든 치루게될 댓가는 커. 난 이 여자를 신전 내부로 들일 수 없어, 교육 마무리가 안되었어. 네가 더 열심히 가르쳐보아.</div>'
$refuse_level_quote['bishop_shaitana'] = '[주교 샤이타나]<br>&nbsp;신들은 결례를 용서치 않아, 나 역시. 형식적 조건만으론 충분치 않아. 모든 면목에서 여유로워야지. 그 여자는 데려가, 그리고 스파크만큼 값나갈 때 다시 데려와.</div>'
$refuse_charm_quote['bishop_shaitana'] = '[주교 샤이타나]<br>&nbsp;안돼. 이 아이는 결함이 숨겨져 있다, 그 벌레 구멍, 네가 못 느끼는.<br>나에겐 보여. 신께서 탐탁지 않아 할거고, 우리 모두 불행해질거야. 갖다 치워.</div>'
$refuse_health_quote['bishop_shaitana'] = '[주교 샤이타나]<br>&nbsp;의식에는 체력이 필요해. 그 아인 이미 한계가 드러나있다.</div>'
$refuse_pregnant_quote['bishop_shaitana'] = '[주교 샤이타나]<br>&nbsp;우린 처녀가 필요해, <<$master_name>>. 이런 농담은 즐겁지 않아.</div>'
$refuse_special_quote['bishop_shaitana'] = '[주교 샤이타나]<br>&nbsp;이 아이는 맞지 않아. 요구한 조건이 있을텐데?</div>'
! JO9 MOD END J9M2083

$npc_image['general_carnis'] = 'general_carnis'
$npc_name['general_carnis'] = '카르니스'
$npc_status['general_carnis'] = '총사령관<br>카미라 가문 (아웃캐스트)'
$npc_alignment['general_carnis'] = 'kamira'
$npc_info['general_carnis'] = '   '
demand_rating['general_carnis'] = 8
$interesting_specialisation['general_carnis'] = 'refferent'
$npc_preferences['general_carnis'] = {
	stat_importance['intellect'] = 5
	stat_importance['secretary'] = 4
	stat_importance['oral'] = 3
	stat_importance['penetration'] = 3
	stat_importance['xenophily'] = 4
}
$buyer_demand['general_carnis'] = {
}
! JO9 MOD START J9M2082 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$general_carnis_pref[1] = '[카니스 장군]<br>&nbsp;평소에 체스 좀 하나, <<$master_name>>? 하는 걸 추천하네. 전사와 전략가 모두에게 훌륭한 게임이지. 대화하면서 체스 한판 두지.</div>'
$general_carnis_pref[2] = '[카니스 장군]<br>&nbsp;내 친구들이 자네의 노예를 굉장히 추천하더군. 그래서 내 노예도 자네에게 맡겨보기로 했지. 난 솔직히 노예를 가져본 적이 없네. 요리하고 청소하는 사람은 있지. 그러나 밤이 오면 참 외로워지더군. 나도 늙어가나봐.</div>'
$general_carnis_pref[3] = '[카니스 장군]<br>&nbsp;나의 <font color="#009900"><b>짐승 같은 본능을 충족</b></font>시킬 줄 아는 여자를 준비해주게. 내 안의 늑대를 다스리는 건 아주 중요하네. 평범한 <font color="#0000D8"><b>성행위</b></font>는 물론, <font color="#0000D8"><b>혀 기술</b></font>또한 능숙해야 하네.</div>'
$general_carnis_pref[4] = '[카니스 장군]<br>&nbsp;하지만 이런 것들은 중요치 않아. 가장 중요한 것은 <font color="#009900"><b>뛰어난 지성</b></font>이 있어야 하네. 체스 플레이어로써의 지능. 나는 이 게임이 사냥이나 사랑보다도 즐겁다고 생각하네.</div>'
$general_carnis_pref[5] = '[카니스 장군]<br>&nbsp;그리고 그녀가 <font color="#008080"><b>글을 읽고 쓸 줄</b></font> 알아야 해, 그래야 그녀가 여러 가지를 추측할 줄 알 것이고, 자네처럼 퀸을 넘겨주지 않겠지, 친구... 체크메이트.</div>'
$buy_quote['general_carnis'] = '[카니스 장군]<br>&nbsp;좋아. 완벽하게 만족스럽군. 이 여자의 체스실력을 빨리 알아보고 싶구만</div>'
$refuse_skill_quote['general_carnis'] = '[카니스 장군]<br>&nbsp;싫네. 나와 체스를 두기에는 아직 멀었어. 자네 더 노력해야겠구만.</div>'
$refuse_level_quote['general_carnis'] = '[카니스 장군]<br>&nbsp;나쁘진 않네만, 전반적으로 더 뛰어났으면 싶네. 내가 알기로는 자네 조합에서 그런 노예를 "A"랭크라고 부른다지?</div>'
$refuse_charm_quote['general_carnis'] = '[카니스 장군]<br>&nbsp;아마 여자가 자넬 설득했나본데 친구, 하지만 내 수엔 못 미쳤어. 두 눈에 열의가 없어. 별로 재미 없을것 같아.</div>'
$refuse_health_quote['general_carnis'] = '[카니스 장군]<br>&nbsp;체스를 두는데 체력이 필요 없다고 생각하지마. 친구. 튼실하진 못 해도 비실하진 말아야지.</div>'
$refuse_pregnant_quote['general_carnis'] = '[카니스 장군]<br>&nbsp;그래, 임신한 노예? 그럼 못 써, 젊은 친구.</div>'
$refuse_special_quote['general_carnis'] = '[카니스 장군]<br>&nbsp;전에도 이 숙녀를 봤지만, 눈가에 비치는 마음에 진보가 없어. 앞으로도 그러지 않을 것 같군그래.</div>'
! JO9 MOD END J9M2082

