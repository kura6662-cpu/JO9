$refuse_health_quote['krasnaya_shapochka'] = '[빨간 두건]<br>&nbsp;무슨 수작을 부리려는 거죠? 그녀는 있어야 할 만큼 건강하고 활기차 보이지 않아요. 매력도 부족하고요. 자칫하면 멀쩡히 못 나갈 줄 알아요!'
$refuse_pregnant_quote['krasnaya_shapochka'] = '[빨간 두건]<br>&nbsp;그래서, 임신한 노예를 저한테 팔고 그 처리까지 제가 하길 바라는 건가요? 절대 안 돼요!'
$refuse_again_quote['krasnaya_shapochka'] = '[빨간 두건]<br>&nbsp;안 된다는 건 안 되는 거예요!'
$krasnaya_shapochka_pref[1] = "[krasnaya_shapochka]<br>&nbsp;저는 <<$slave_type_name[$interesting_specialisation['krasnaya_shapochka']]>> 전공의 <<$rating[demand_rating['krasnaya_shapochka']]>> 등급 이상이 필요해요. <<common_price[demand_rating['krasnaya_shapochka']]>> 스파크를 낼게요."
! JO9 MOD END J9M2036

$npc_image['Masha_medved'] = 'Masha_medved'
$npc_name['Masha_medved'] = '마샤'
$npc_status['Masha_medved'] = '(중립파)'
$npc_alignment['Masha_medved'] = 'russiankvartal'
$npc_info['Masha_medved'] = '세월은 멈추지 않는다. 한때 어린 여자아이로서 미샤의 집에 자리 잡았던 마샤는 이제 자라고 더 예뻐졌다. 그리고 그 말은, 미샤에게 분명 더 많은 골칫거리가 생기리라는 뜻이기도 하다...'
demand_rating['Masha_medved'] = 3
$interesting_specialisation['Masha_medved'] = 'concubine'
$diary_mark['Masha_medved'] = " <<$npc_name['Masha_medved']>>. 러시아 구역의 마법의 숲에 산다."
! JO9 MOD START J9M2035 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['Masha_medved'] = '[마샤]<br>&nbsp;좋아, 그녀를 받겠어. 여기 네 스파크야, 고맙고. 내 마음에 들었으면 좋겠네!'
$refuse_skill_quote['Masha_medved'] = '[마샤]<br>&nbsp;해야 할 일을 해낼 수 없는데 내가 왜 그녀를 필요로 하지? 그런 상품엔 관심 없어.'
$refuse_level_quote['Masha_medved'] = '[마샤]<br>&nbsp;더 나은 여자애를 찾을 수 없나? 등급을 생각하면 너무 비싸군.'
$refuse_charm_quote['Masha_medved'] = '[마샤]<br>&nbsp;음… 모르겠네. 형식상으론 맞지만 너무 볼품없어 보여. 매력도 부족하고. 마음에 안 들어.'
$refuse_health_quote['Masha_medved'] = '[마샤]<br>&nbsp;무슨 수작을 부리려는 거지? 그녀는 있어야 할 만큼 건강하고 활기차 보이지 않아. 자칫하면 멀쩡히 못 나갈 줄 알아!'
$refuse_pregnant_quote['Masha_medved'] = '[마샤]<br>&nbsp;그래서, 임신한 노예를 나한테 팔고 그 처리까지 내가 하길 바라는 거야? 절대 안 돼!'
$refuse_special_quote['Masha_medved'] = '[마샤]<br>&nbsp;그녀는 내가 원한 게 아니야!'
$refuse_again_quote['Masha_medved'] = '[마샤]<br>&nbsp;안 된다는 건 안 되는 거야!'
$Masha_medved_pref[1] = "[마샤]<br>&nbsp;나는 <<$slave_type_name[$interesting_specialisation['Masha_medved']]>> 분야의 <<$rating[demand_rating['Masha_medved']]>> 등급 이상 노예가 필요해. <<common_price[demand_rating['Masha_medved']]>> 스파크를 낼게."
! JO9 MOD END J9M2035

$npc_image['leshiy'] = 'leshiy'
$npc_name['leshiy'] = '레시'
$npc_status['leshiy'] = '(중립파)'
$npc_alignment['leshiy'] = 'russiankvartal'
$npc_info['leshiy'] = '사람에게 중립적인 친절한 노인이다. 하지만 숲에 예의 있게 들어오고, 자연을 존중하며 대하면 그는 네 친구가 되어 줄 것이다 - 가장 아름다운 곳들을 보여 주고, 어떤 오지에서도 빠져나오게 이끌어 줄 것이다. 하지만 불을 잘못 피우거나 나무를 베어 버리기라도 하면, 하느님도 도와주지 못한다 - 너 자신이 뿌리내려 영원히 떡갈나무가 될 수도 있다.'
demand_rating['leshiy'] = 6
$interesting_specialisation['leshiy'] = 'refferent'
$diary_mark['leshiy'] = " <<$npc_name['leshiy']>>. 러시아 구역의 마법의 숲에 산다."
! JO9 MOD START J9M2034 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$leshiy_pref[1] = '[레시]<br>&nbsp;좋은 저녁이네, <<$master_name>>. 자네를 보니 내 마음이 기뻐지는군. 여기 다른 많은 놈들과 달리 얼마나 단정하고 성실한가. 와, 숲을 더럽히지 못하게 늪으로 끌고 가고 골짜기로 유인해 버려야 했던 것들이 도대체 몇이나 되는지.'
$leshiy_pref[2] = '[레시]<br>&nbsp;그리고 자네는 조용하고, 부드럽게 걷고, 가지도 꺾지 않고 꽃도 뜯지 않는군. 그래서 내가 직접 자네 앞에 나와 인사를 하기로 했지. <i>레시는 노예상 길드의 문장을 날카로운 눈길로 알아보며 흥미롭게 너를 바라본다</i>.'
$leshiy_pref[3] = '[레시]<br>&nbsp;정말로 자네가 그 길드의 저 무례하고 타락한 놈들 가운데 하나란 말인가? 이렇게 예의 바른 사람이 저런 깡패와 멍청이들 틈에 들어가게 됐다니 놀랍군. 하지만 운명이 우리를 만나게 했으니, 혹시 이 늙은이를 좀 도와줄 수 있겠나?'
$leshiy_pref[4] = '[레시]<br>&nbsp;날이 갈수록 내 숲으로 흘러드는 사람이 더 많아지고 있어. 아직은 내가 감당할 수 있지만, 모두를 지켜보긴 힘들지. 내 조수 하나 길러 줄 수 있겠나? <font color="#008080"><b>머리가 좋고</b></font>, <font color="#008080"><b>기질이 있으며</b></font>, <font color="#008080"><b>건강한</b></font> 아이 말이다. 내 힘의 일부를 그녀에게 불어넣을 예정이니, 그런 선물을 받아들이고도 살아남으려면 그녀는 <font color="#008000"><b>주술사</b></font>여야 한다. 반드시 그녀에게 <font color="#008080"><b>자기 몸을 지키는 법</b></font>과 <font color="#008080"><b>치유하는 법</b></font>을 가르쳐 두어야 한다.'
$leshiy_pref[5] = '[레시]<br>&nbsp;<font color="#009FEF"><b>인간의 병을 다룰 수 있다면</b></font> 나무와 짐승들도 보살필 수 있을 테지... 그리고 <font color="#0000D8"><b>너무 연약한 꽃 같은 건 데려오지 마라</b></font> - 숲에서 그런 애가 무슨 소용이 있겠나? 나머지는... 내 숲에 사는 어떤 짐승이든 <font color="#008000"><b>감당할 수 있게</b></font>만 해 두어라. 아름답든 못생겼든, 요리를 할 줄 알든 키스를 할 줄 알든... 그런 건 너무 사소하니 네 취향에 맡기겠다.'
$leshiy_pref[6] = '[레시]<br>&nbsp;다만 제발, <font color="#C71585"><b>아무에게도 그녀에 대해 알리지 마라</b></font>. 그 아이 때문에 숲으로 기어 들어오는 인간들이 더 늘어나는 것만큼은 절대 사양이거든. 그런 아이를 내게 데려오면, 후하게 쳐 줄 것이고 자네를 박대하지도 않겠다. 난 자네의 충실한 친구가 될 것이고, 자네는 다시는 숲에서 길을 잃지 않게 될 거다.'
! JO9 MOD END J9M2034

