$npc_image['kikimora'] = 'kikimora'
$npc_name['kikimora'] = '키키모라'
$npc_status['kikimora'] = '(중립파)'
$npc_alignment['kikimora'] = 'russiankvartal'
demand_rating['kikimora'] = 6
$interesting_specialisation['kikimora'] = 'custom'
$diary_mark['kikimora'] = "   <<$npc_name['kikimora']>>. 러시아 구역의 마법의 숲에 산다."
! JO9 MOD START J9M2032 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$kikimora_pref[1] = '[키키모라]<br>&nbsp;안녕. 지나치지 말고, 더 가까이 와. 어떻게 네 같은 사람이 우리 구역에 들어왔지? 살아 있고, 강하고, 매력적이네... <i>키키모라는 늪의 악령이라기보다 어린 여자아이에게나 어울릴 법한 밝고 경쾌한 웃음을 터뜨린다</i> 겁먹지 마, 널 물에 빠뜨리진 않을 거야. 그럴 이유가 없으니까. 늪에는 마브카가 필요 없거든, 그런 건 인어들에게나 가서 물어봐.'
$kikimora_pref[2] = '[키키모라]<br>&nbsp;더 가까이 와서 앉아. 여기, 나무가 있네. 거의 젖지도 않았어. 우리들 사이에선 노예상이 우리 구역에 나타났다는 말이 돌고 있어. 악령들은 널 즐겁게 하고 소원도 이뤄 준다지, 중요한 건 스파크로 대가를 치르는 거고. 그런데 그게 나랑 무슨 상관이람? 흥, 보기엔 예쁘게 빛나지만 먹을 수도 없고 어디 붙일 수도 없는데...'
$kikimora_pref[3] = '[키키모라]<br>&nbsp;내 동료들처럼 나를 도와준다면, 그걸 너에게 줄 준비가 되어 있어. 인간아, 키키모라가 되는 법을 알고 있니? 모르겠다고? 그럼 내가 알려주지. 인어 주간에 온갖 어둠이 깃든 영혼을 가진 무고한 아이를 물에 빠뜨려 죽이면… 내 말뜻을 알겠니?'
$kikimora_pref[4] = '[키키모라]<br>&nbsp;거봐, 좋잖아... 들어봐. 나는 <b>젊</b> <b>순진한</b> 여자가 필요해. 나이를 먹으면 인어가 되겠지만, 난 내 여자친구로 삼을 만한 애를 구하고 싶거든. 순진해야 하니까, 그 아이가 태어날 때부터 가진 그 선물을 감히 빼앗을 생각 따위는 마라! 그리고 타락한… 아주 끔찍하게 타락한 애여야 해.' 
$kikimora_pref[5] = '[키키모라]<br>&nbsp;그녀가 <font color="#008000"><b>온갖 불건전한 변태적 행위를 할 수 있고</b></font>, <font color="#008080"><b>스스로를 어루만질 줄 알아서</b></font>, 사람들이 알아서 그녀를 따라 물속으로 뛰어들 정도여야 하지.'
! JO9 MOD END J9M2032
$kikimora_pref[6] = ' [키키모라]
- 그녀<font color="#008000"><b>팔과 다리, 그리고 혀를 자유자재로 써서</b></font> 자기가 바닥으로 가라앉고 있다는 걸 사람들이 눈치채지 못하게 만들고, 나를 지루하지 않게 해줄 수 있어야 해... 그리고 그런 눈으로 보지 마. 난 누이이자 여자친구를 한 번에 찾고 있는 거니까, 왜 따로따로 찾아?! <font color="#008080"><b>아름답고</b></font>, 갈대처럼 <b>가냘프며</b>, <font color="#008080"><b>부드러우면서도</b></font> <font color="#008080"><b>열정적인</b></font> 아이여야 해. 이런 아이들의 피가 얼마나 뜨거운지 알아? 웃지 마. 알고 있다는 거 다 보이니까.'
! JO9 MOD START J9M2031 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$kikimora_pref[7] = '[키키모라]<br>&nbsp;<font color="#008000"><b>노래와 수다에도 능해야 해</b></font>. 사람들을 속여 넘겨야 할 때 아주 유용하거든. 왜 속이냐고? 인간은 아주 맛있거든, 알잖아. 개구리만 잡아먹는 건 지루하고 맛도 없단 말이지.'
$kikimora_pref[8] = '[키키모라]<br>&nbsp;내가 뭘 원하는지 이해했나? 왜 이렇게 복잡하냐고? 마음속에 타락을 품은 순결한 영혼만이, 내가 물에 빠뜨렸을 때 키키모라로 다시 태어날 수 있으니까! 그러지 마, 그렇게 보지 말라구. 그래, 난 그 아이를 물에 빠뜨릴 거고, 그럼 그 애는 나의 자매로 다시 태어날 거다. 가서 지체하지 마. 보상은 두둑이 줄테니.'
$buy_quote['kikimora'] = '[키키모라]<br>&nbsp;좋아, 그녀를 받겠어. 여기 네 스파크야, 고맙고. 내 마음에 들었으면 좋겠네!'
$refuse_skill_quote['kikimora'] = '[키키모라]<br>&nbsp;해야 할 일을 해낼 수 없는데 내가 왜 그녀를 필요로 하지? 그런 상품엔 관심 없어.'
$refuse_level_quote['kikimora'] = '[키키모라]<br>&nbsp;더 나은 여자애를 찾을 수 없나? 등급을 생각하면 너무 비싸군.'
$refuse_charm_quote['kikimora'] = '[키키모라]<br>&nbsp;음… 모르겠네. 형식상으론 맞지만 너무 볼품없어 보여. 매력도 부족하고. 마음에 안 들어.'
