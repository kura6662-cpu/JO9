$npc_image['doctor'] = 'doctor'
$npc_name['doctor'] = '의사'
$interesting_specialisation['doctor'] = 'witchdoctor'
$npc_status['doctor'] = '의료 센터 직원<br>세르피스 가문'
$npc_info['doctor'] = '<br> 그는 피로에 찌들은 얼굴을 하고 있다.<br><br> 명백한 이유겠지만, 일이 너무 많아 쉴 기회 조차도 별로 없어 보인다.<br><br> 오직 이 곳만이 기술 집약소의 기술력을 유용해 진료를 행하기 때문일 것 이다.'
npc_attitude['doctor'] = 12
demand_rating['doctor'] = 3
$interesting_specialisation['doctor'] = 'witchdoctor'

! JO9 MOD START J9M2144 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$doctor_pref[1] = '[의사]<br>&nbsp;예, 우리는 치유술사로 노예 고용을 선호하는 편 입니다. 구하기 쉽고 싸니까요.</div>'
$doctor_pref[2] = '[의사]<br>&nbsp;필요 정보는 원무과에서 얻으시면 됩니다만, 비교적 간단합니다. 간호사 <<$rating[demand_rating[''doctor'']]>>등급 이상 노예를 <<common_price[demand_rating[''doctor'']]>> 스파크, 고정가에 구하고 있습니다.</div>'
$doctor_pref[3] = '[의사]<br>&nbsp;제가 개인적으로 수술을 시켜 기술을 확인하고, 결과에 문제 없으면 당일에 지급 드립니다.</div>'
$doctor_pref[4] = '[의사]<br>&nbsp;인력은 늘 부족하니, 수요는 사실상 끝이 없을 겁니다.</div>'
$doctor_pref[5] = '[의사]<br>&nbsp;질문 사항은 언제든 들러 주십시오. 그래도 방해는 안됩니다, 우린 할 일이 정말로 많아요. 도시에서 괜찮은 병원이 여기 하나 뿐 아닙니까.</div>'
$buy_quote['doctor'] = '[의사]<br>&nbsp;좋아요, 채용 하겠습니다. 스파크를 받아 주십시오, 참 고맙습니다.<br><br>자넨 할 일이 아주 많아, 인턴. 따라오게.</div>'
$refuse_skill_quote['doctor'] = '[의사]<br>&nbsp;그정도 기술로는 바늘도 똑바로 못 넣을거요.</div>'
$refuse_level_quote['doctor'] = '[의사]<br>&nbsp;스파크 값에 맞질 않는데, 더 좋은걸로 부탁합니다.</div>'
$refuse_charm_quote['doctor'] = '[의사]<br>&nbsp;으음... 조건엔 들어 맞지만, 후줄근한 의사는 채용 않습니다.</div>'
$refuse_health_quote['doctor'] = '[의사]<br>&nbsp;그런 몸으로 진료하러 온 겁니까? 되려 진료를 받아야겠습니다만.</div>'
$refuse_pregnant_quote['doctor'] = '[의사]<br>&nbsp;임신한 노예는 받지 않습니다.</div>'
$refuse_again_quote['doctor'] = '[의사]<br>&nbsp;내키지 않는다 했죠, 다른걸 데려와 주십시오. 그건 못 본걸로 하겠습니다.</div>'
! JO9 MOD END J9M2144

$npc_image['realtor'] = 'realtor'
$npc_name['realtor'] = '글로리아'
$npc_status['realtor'] = '부동산 중개인<br>중립파'
$npc_alignment['realtor'] = 'neutral'
$npc_info['realtor'] = '   엄격하고 세련된 외모와는 달리, 이 여자는 노예다. 사무실 의자나 사무용품과 마찬가지로 임대 회사의 소유물이다. 그녀는 아주 잘 훈련된 것이 분명하다 - 전문적이면서도 동시에 꽤 개방적이고, 어떤 면에선 손님 응대에도 능숙하다고까지 할 수 있다. 소비 사회를 지닌 탈산업 세계의 관리 모델에 맞도록 준비된 게 분명하다. 그녀는 이 사무실의 분위기에 정확히 들어맞는다.'
npc_attitude['realtor'] = 32
demand_rating['realtor'] = 3
$interesting_specialisation['realtor'] = 'refferent'
$realtor_pref[1] = '[글로리아]<br>- 저희는 직원이 충분하지 않습니다. 일할 직원들이 특정 기준에 부합해야 하오나, 저희는 그걸 기반부터 다져줄 여유가 없습니다.</div>'
$realtor_pref[2] = '[글로리아]<br>-  대신 저희가 규격을 만들어 고정가에 매입하고 있습니다. 여기, 받으시길. (그녀가 규격이 적힌 종이를 건넨다.)</div>'
$realtor_pref[3] = '[글로리아]<br>- 보시다시피, 저희는 비서 기술을 갖춘 <<$rating[demand_rating[''realtor'']]>> 등급 이상의 노예를 매입하고, 한 명당 <<common_price[demand_rating[''realtor'']]>> 스파크를 지불합니다.</div>'
$realtor_pref[4] = '[글로리아]<br>- 사업이 계속 성장 중이라 노예를 많이 고용할 수 있어요. 사실 당신이 훈련할 수 있는 만큼 다요.</div>'
$realtor_pref[5] = '[글로리아]<br>- 협상은 하지 않으셔도 될 겁니다. 조건만 충족하면, 어떠한 번거로움 없이 전부 팔 수 있게 제가 직접 챙기겠습니다.</div>'
$buy_quote['realtor'] = '[글로리아]<br> 네 채용하겠습니다. 고맙습니다, 여기 스파크를 받으시길.</div>'
$refuse_skill_quote['realtor'] = '[글로리아]<br> 조건에 맞지 않는 노예는 채용하지 않습니다, 죄송합니다.</div>'
$refuse_level_quote['realtor'] = '[글로리아]<br> 더 좋은 상품 없을까요? 등급에 비해 가격이 높은 것 같습니다.</div>'
$refuse_charm_quote['realtor'] = '[글로리아]<br> 어음... 네. 조건엔 모두 맞으나 뭔가 겉보기에 부족한게... 부족합니다.</div>'
$refuse_health_quote['realtor'] = '[글로리아]<br> 체력이 부족한 노예는 채용하지 않습니다.</div>'
$refuse_pregnant_quote['realtor'] = '[글로리아]<br> 임신 노예는 채용하지 않습니다.</div>'
$refuse_again_quote['realtor'] = '[글로리아]<br> 재차 말씀드리지만 그 노예는 채용하지 않습니다. 죄송합니다.</div>'

$npc_image['jarik'] = 'jarik'
$npc_name['jarik'] = '야릭'
$npc_status['jarik'] = '목장 일꾼<br>카미라 가문'
$npc_info['jarik'] = ' 중간 크기의 수컷 미노타우르스. 그래도 사람보다는 거대하다.<br><br> 이런 아둔하고 짐승같은 괴물이, 인간 여성을 젖소마냥 다루는 건 정말 비정상적인 일이다.<br><br> 그래도 이 `동물원` 책임을 맡고 의무를 다 할 뿐이니, 그와 친해질 필요가 있다.'
npc_attitude['jarik'] = 30
demand_rating['jarik'] = 4
$interesting_specialisation['jarik'] = 'pet'

! JO9 MOD START J9M2143 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$jarik_pref[1] = '[야릭]<br>&nbsp;오 그래오, <<$master_name>>. 우린 어떤 암컷이든 삼니다오. 그것들이 그저 마구와 친하고 번식만 잘하면 신경 안써오. 말, 고양이, 개, 뭐든 여기랑 맞아오. 우리가 그리 만들어오. 소같은 경우 조금 까다로낀 하지오.</div>'
$jarik_pref[2] = '[야릭]<br>&nbsp;아아, 중요한게 있는데, 자기들이 뭔지 확씨리 인식해야 되오. 그러니까, 까딱 처신 잘못하면, 제가 조져오. 그럼, 그럼 제 주인이 서견찮아 할거오. 그것들이 좀 불쾌.. 아니 불합리... 그냥 조져질테니 말입니오. 여기 올 애들은, 처음부터 착실한게 좋을테지오.</div>'
$jarik_pref[3] = '[야릭]<br>&nbsp;또 가격은 내가 안정해오, 조련사님씨. 그리고 안돼오, 내 주인과는 말 못해오. 그 사람 바빠오. 다 간단해오. 제가 노옐 평가해오. 보기에 다 괜찮으면, 제가 <<common_price[demand_rating[''jarik'']]>> 스파크 낼거에오. 자연스레, 흥정하나 업씨.</div>'
$jarik_cow_pref[1] = '[야릭]<br>&nbsp;소 길러내긴 쉬운 일 아니잖아오, 조련사님씨. 동물 기술은 언제나 화녕하지만오. 캐도 무엇보다, 노예들이 그런 새 환경을 받아들이는게 최우선이겠지오. 우린 암컷 필요없어오, 소 필요해오...</div>'
$jarik_cow_pref[2] = '[야릭]<br>&nbsp;아 그래오, 찌찌 크기랑 체격도 무지 중요해오. 하지만 좋은 소는 우울해하지 않능 것...이지만, 때에 따라선 정신 가출한 애들도 받아오. 생산성만 좋으면오.</div>'
$jarik_cow_pref[3] = '[야릭]<br>&nbsp;호, 제가 항상 말해왔뜨시, 자기들이 뭔지 알아야돼오. 생겨먹은 건 신경 안써도, 훈육하는 건 생산에 안좋은데... 아 생산에 대해 말하자면은. 팔기전에 수태 안시켜도 되오, 그것도 우리가 해오. 번식할때 말만 잘듣게 해줘오. 사람들이랑만 말구오...</div>'
$buy_quote['jarik'] = '[야릭]<br>&nbsp;좋은 녀석이다! 저 암컷 그대로 제가 데려가지오, 훈련사님씨. 스파크 받아오. 맞는지 세봐오, 그래보고 싶으면.</div>'
$refuse_skill_quote['jarik'] = '[야릭]<br>&nbsp;이건 또 왜 두발로 걸어오? 다른 곳 데려가는게 좋으오. 여긴 동물농장이지, 전시장이 아니에오.</div>'
$refuse_level_quote['jarik'] = '[야릭]<br>&nbsp;아주 질 나쁜 암컷인디, 훈련사님씨? 더 가르치는게 좋지 않겠오? 그런거 들이면 주인이 내 대가릴 뜯어버릴거오.</div>'
$refuse_charm_quote['jarik'] = '[야릭]<br>&nbsp;후음... 괜찮네오, 괜찮으면서 괜찮지 않네오, 알아 들으시나. 그 아시나오, 가축이 변밭에 서있다도 잘 어울리는 소. 고객들을 위해서오.</div>'
$refuse_health_quote['jarik'] = '[야릭]<br>&nbsp;이건 여물도 똑바로 못십을거 같은데오? 불합리하게 만들어주기 전에 나가시오!</div>'
$refuse_pregnant_quote['jarik'] = '[야릭]<br>&nbsp;수태된 가축은 필요없어오, 그건 우리가 해오.</div>'
$refuse_again_quote['jarik'] = '[야릭]<br>&nbsp;훈련사님씨, 이미 말했잖습니오. 이건 필요 없어오. 다른거 가져와오, 그 때 얘기합시오.</div>'
! JO9 MOD END J9M2143

$npc_image['malifiscent'] = 'malifiscent'
$npc_name['malifiscent'] = '말리피센트'
$npc_status['malifiscent'] = '극장 주인<br>코르부스 가문'
$npc_info['malifiscent'] = '<br> 아주 이상한 괴짜 강령술사.<br><br> 아주 이상하지만, 네크로폴리스에선 또 아주 유명하다.<br><br> 극장의 얽히고 섥힌 복잡한 구조속에, 부엌, 식당과 영안실이 병립해 있다.'
npc_attitude['malifiscent'] = 11
demand_rating['malifiscent'] = 1
$interesting_specialisation['malifiscent'] = 'artist'

! JO9 MOD START J9M2142 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$malifiscent_pref[1] = '[말리피센트]<br>&nbsp;나는 필멸자가 예술을 이해할거라 생각치 않아. 그래도 중요 부분만큼은 언급해주지... 그것은 바로 삶. 따끈한, 숨쉬는 육신이 모든 불사자를 매료하는 원천이지.</div>'
$malifiscent_pref[2] = '[말리피센트]<br>&nbsp;우린 그걸 끊임없이 갈망. 허나, 가질 수 가 없어. 우린 생명을, 우리는 축복받은 온기의 조각들을. 그 필멸자의 것을 앗아야만 느낄 수가 있다고.</div>'
$malifiscent_pref[3] = '[말리피센트]<br>&nbsp;그렇지만, 내 고객들... 나의 관중들... 그자들은 아주 까다로운 성미의 관객. 단지 동물 본능만 존재하는 무념한 구울들이 아니기에. 그자들은 특유의 선보임이 필요해!</div>'
$malifiscent_pref[4] = '[말리피센트]<br>&nbsp;관객들을 위해, 나는 생사를 결합하지. 예술과, 생리를. 생기 넘치는 예술가와 나는, 내 연출에서 그들이 타고난 정수를, 그들 목숨의 정수를, 그들 육신의 정수를 규명해내어.</div>'
$malifiscent_pref[5] = '[말리피센트]<br>&nbsp;그 과정은, 돌이킬 수 없는, 파멸. 하나 그게 구경의 핵 심! 유감스럽게도, 난 끊임없이 새 인재를 모색해, 내 단원삼아 보충해야 하지.</div>'
$malifiscent_pref[6] = '[말리피센트]<br>&nbsp;뜻밖에도, 제품의 싱싱함을 요하던 고객은 겪지 못했나보군. 내 필멸자 동지여. 그렇다고 실책은 만들지 마! 나는 고기 안 사. 나는 생명을 매 수 한다고. 그 재능과 개성을!</div>'
$malifiscent_pref[7] = '[말리피센트]<br>&nbsp;컨대, 난 예술가 <<$rating[demand_rating[''malifiscent'']]>>이상 등급을 원해. 더 잘난 노예라면 그야 좋겠지만, 노예마다 <<common_price[demand_rating[''malifiscent'']]>> 스파크 이상 못 주겠군. 또 하나 더, 반드시 <font color="#0000D8"><b>자학에 능해야 돼</b></font>! 내 관객은 삼류를 취급 안 하니까.</div>'
! JO9 MOD END J9M2142

! JO9 MOD START J9M2141 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['malifiscent'] = '[말리피센트]<br>&nbsp;그래! 정확히 내가 원하던 거야. 소질, 영감, 불가사의. 그 감춰진 걸 파헤쳐 보자고. 객들이 즐길만 할겠어. 스파크 받지, <<$master_name>>.</div>'
$refuse_skill_quote['malifiscent'] = '[말리피센트]<br>&nbsp;내가 많은 걸 바라던가? 무용, 화법, 기악... 어떤 소질이던 받아주지. 하지만 아무것도 보이지 않아. 관객에 보여줄게 뭐 있는가? 이 숙녀는 명백히, 그 가치를 장만할 혁신적인 배움이 필요해.</div>'
$refuse_level_quote['malifiscent'] = '[말리피센트]<br>&nbsp;아니, 생각 없어. 더 가르치고 더 배워 만들어. 노예라는 이 뮤즈의 거처에 선보일 전시의 격을!</div>'
$refuse_charm_quote['malifiscent'] = '[말리피센트]<br>&nbsp;여긴 예술에 열광적인 자들만 출입하는 곳 이라고, <<$master_name>>! 어째서 이런 잡스럽고 천박한 인간을 데려왔지? 관객 중 누구 하나라도, 이 여자 내면미에 관심을 가질 것 같나? 절대!</div>'
$refuse_health_quote['malifiscent'] = '[말리피센트]<br>&nbsp;정수를 드러내며 채취함은, 이런 얄팍한 몸이 견뎌낼 것이 아니지, <<$master_name>>. 이런 시시껄렁한 농담하지 말고 사라져!</div>'
$refuse_pregnant_quote['malifiscent'] = '[말리피센트]<br>&nbsp;임신은 전혀 아름답지가 않아.</div>'
$refuse_again_quote['malifiscent'] = '[말리피센트]<br>&nbsp;또 온건가? 안 데려가!</div>'
$refuse_special_quote['malifiscent'] = '[말리피센트]<br>&nbsp;내 요구가 많던가? 난 자기 목을 그어버릴 여자가 필요해. 내 관객은 삼류 취급 안한다고.</div>'
! JO9 MOD END J9M2141
$buyer_demand['malifiscent'] = {
