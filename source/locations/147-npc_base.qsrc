$npc_image['Esfir'] = 'Esfir'
$npc_name['Esfir'] = '레이디 에스피르'
$npc_status['Esfir'] = '후타랜드 (중립파)'
$npc_alignment['Esfir'] = 'futaland'
$npc_info['Esfir'] = '  에스피르가 에밀리야와 가까운 사이라는 건 널리 알려져 있다. 둘이 친척 사이라는 말까지 있지만, 그걸 입증할 증거는 없다. 이 사교계 귀부인들이 공통으로 지닌 것은 부, 호화로운 파티에 대한 사랑, 그리고 섹스뿐이다.'
demand_rating['Esfir'] = 6
$interesting_specialisation['Esfir'] = 'artist'
$diary_mark['Esfir'] = "   <<$npc_name['Esfir']>>. 후타랜드에 산다."
! JO9 MOD START J9M1973 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Esfir_pref[1] = "[레이디 에스피르]<br>&nbsp;시간은 귀하니 바로 본론으로 가죠… 제가 가장 아끼는 노예가 다리를 부러뜨려서, 이제 저희 여자애들을 즐겁게 해 줄 사람이 없어요. <<$rating[demand_rating['Esfir']]>> 등급의 예인 하나를 길러 오세요. 값을 아끼진 않을 테니, 보수는 <<common_price[demand_rating['Esfir']]>> 스파크예요."
$buy_quote['Esfir'] = '[레이디 에스피르]<br>&nbsp;좋아요, 그녀를 받겠어요. 여기 스파크예요, 고마워요! 제 마음에 들었으면 좋겠네요!'
$refuse_skill_quote['Esfir'] = '[레이디 에스피르]<br>&nbsp;그 일에 필요한 훈련도 안 되어 있는데, 제가 왜 그녀를 받죠? 그런 일꾼은 제 관심을 끌지 못해요.'
$refuse_level_quote['Esfir'] = '[레이디 에스피르]<br>&nbsp;더 나은 애는 없나요? 이 값엔 어울리지 않아요.'
$refuse_charm_quote['Esfir'] = '[레이디 에스피르]<br>&nbsp;흠… 잘 모르겠네요. 형식상으론 맞지만 볼품이 없어요. 끌리지 않네요.'
$refuse_health_quote['Esfir'] = '[레이디 에스피르]<br>&nbsp;뭘 저한테 팔아넘기려는 거죠? 병약해 보이고, 충분히 튼튼해 보이지도 않아요. 산산조각 나지 않는 걸 다행으로 아세요!'
