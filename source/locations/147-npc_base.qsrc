$npc_image['anes'] = 'anes'
$npc_name['anes'] = '아네스'
$npc_status['anes'] = '카페 주인 (중립파)'
$npc_alignment['anes'] = 'redlight'
$npc_info['anes'] = '"신들의 선물" 카페의 주인으로, 정성스러운 플레이팅과 함께 정교한 요리들을 내놓는다. 몇몇 경쟁자들은 아네스가 미모와 몸매를 유지하기 위해 여러 엘릭서를 쓴다고 소문내지만, 그녀는 진정한 미식가는 자기 음식을 즐기면서도 건강하고 우아하며 활력이 넘친다고 주장한다.'
demand_rating['anes'] = 6
$interesting_specialisation['anes'] = 'servant'
