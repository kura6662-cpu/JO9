}
$buyer_demand['Venera'] = {
}
! JO9 MOD START J9M1850 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Venera_pref[1] = '[베네라]<br>&nbsp;정황을 보아하니, 당신은 클럽 명예 회원들의 반열에 오르고 싶은 모양이네, <<$master_name>>? 하지만 그렇게 쉬운 일은 아니야. 이 문제에 대해선 내가 결정권이 없어. 그건 클럽 주인 콘스탄틴의 특권이거든.'
$Venera_pref[2] = '[베네라]<br>&nbsp;하지만 내 부탁 하나만 들어주면, 그와 연결해 줄게. 당신도 알다시피 난 황제의 아내 펠라게야의 자매야. 그러니 나도 제법 힘이 있지. 그리고 난 내 말을 지켜.'
$Venera_pref[3] = '[베네라]<br>&nbsp;내가 여기서 뭘 하고 있는지 궁금하겠지, 그렇지? 난 그냥 거긴 지루해. 난 섹스가 하고 싶어... 잔뜩, 아주 많이... 불길 같은 것, 거친 열정, 감정의 폭풍이 필요해... 그리고 이곳은 그걸 즐기기에 딱 좋아. 하지만 그 광장에 있는 건 이제 지겨워졌어.'
$Venera_pref[4] = '[베네라]<br>&nbsp;내 유흥에 함께할 여자애가 필요해. 그리고 알다시피 그녀는 훌륭한 첩이어야 해. <font color="#008000"><b>집단 섹스</b></font>와 온갖 난교는 우리 클럽에서 아주 유행하거든. 그러니 거기에 대비되어 있어야 해.'
$Venera_pref[5] = '[베네라]<br>&nbsp;게다가 그녀는 <font color="#0000CD"><b>괴물와 하는 섹스</b></font>와 다른 존재들과 섹스하는 데에도 일가견이 있어야 한다. 나 자신도 "지네"와 노는 걸 좋아하니까. 그녀도 그 방법을 알아야 한다.'
$Venera_pref[6] = '[베네라]<br>&nbsp;전체적으로, 그녀는 어떤 종류의 섹스든 다 할 준비가 되어 있어야 해... 예술 훈련도 조금 있으면 좋겠네... 춤이랑 여러 쇼 같은 것들 — 나도 그런 데 참여하는 걸 좋아하거든. 하지만 가장 중요한 건, 기질이 있고 싸울 줄 안다는 거야.'
$Venera_pref[7] = '[베네라]<br>&nbsp;우리 손님들은 언제나 다르니까. 그러니 그녀는 맞서 싸울 수 있어야 해.'
$Venera_pref[8] = '[베네라]<br>&nbsp;해낼 수 있겠어? 그런 애를 데려오면, 콘스탄틴과의 만남을 주선해 줄게!'
$buy_quote['Venera'] = '[베네라]<br>&nbsp;이거야말로 제대로 해냈네, <<$master_name>>! 진짜 인형 같아! 생각도 안 하고 바로 받겠어!'
! JO9 MOD END J9M1850

! JO9 MOD START J9M1849 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_skill_quote['Venera'] = '[베네라]<br>&nbsp;아무것도 못 하는 여자애는 필요 없어.'
! JO9 MOD END J9M1849

! JO9 MOD START J9M1848 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_level_quote['Venera'] = '[베네라]<br>&nbsp;수준이 안 맞아, <<$master_name>>... 내겐 안 되겠어!'
! JO9 MOD END J9M1848

! JO9 MOD START J9M1847 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_charm_quote['Venera'] = '[베네라]<br>&nbsp;매력이 없네. 더 예쁜 애를 찾아와.'
