$mystra_pref[1] = "[미스트라]<br>&nbsp;<<$slave_type_name[$interesting_specialisation['mystra']]>> 능력을 가진 <<$rating[demand_rating['mystra']]>>이상 등급이 필요해요. <<common_price[demand_rating['mystra']]>> 스파크 낼거에요.</div>"
$buy_quote['mystra'] = '[미스트라]<br>&nbsp;좋아요, 데려가겠어요. 보답을 받으시죠.</div>'
$refuse_skill_quote['mystra'] = '[미스트라]<br>&nbsp;결격된 노예는 데려오지 말아주시죠.</div>'
$refuse_level_quote['mystra'] = '[미스트라]<br>&nbsp;너무 하등하네요. 이런건 데려오지 말아줘요.</div>'
$refuse_charm_quote['mystra'] = '[미스트라]<br>&nbsp;글쎄... 요. 조금 촌스럽지 않나요?</div>'
$refuse_health_quote['mystra'] = '[미스트라]<br>&nbsp;허약한 노예는 데려오지 말아줄래요.</div>'
$refuse_pregnant_quote['mystra'] = '[미스트라]<br>&nbsp;임신? 그냥 나가주시죠.</div>'
$refuse_again_quote['mystra'] = '[미스트라]<br>&nbsp;전 그걸로 거래 안해요.</div>'
! JO9 MOD END J9M2081

$npc_image['arbue'] = 'arbue'
$npc_name['arbue'] = '아르부에'
$npc_status['arbue'] = '분노한 대사<br>카미라 가문 (아웃캐스트)'
$npc_alignment['arbue'] = 'kamira'
$npc_info['arbue'] = '   이 극히 희귀한 인간형 식물은 채식주의자들에게 복수하는 일에 집착하고 있다. 그의 말에 따르면, 자기가 초식동물을 먹을 때마다 정의가 실현된다고 한다.'
demand_rating['arbue'] = 2
$interesting_specialisation['arbue'] = 'pet'
$diary_mark['arbue'] = "   <<$npc_name['arbue']>>. 그의 거처는 아웃캐스트 구역에 있다."
! JO9 MOD START J9M2080 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$arbue_pref[1] = '[아르부에]<br>&nbsp;너 같은 동물들이, <<$master_name>>, 얼마나 오랫동안 식물들을 노예로 삼고 먹어 왔는지 아느냐? 그리고 그건 지금도 사방에서 벌어지고 있다! 나는 복수를 원한다. 나는 동물 여자를 (<<$rating[demand_rating["arbue"]]>>) 내 노예이자 점심으로 원한다!'
! JO9 MOD END J9M2080
!not used
!$arbue_pref[2] = '  [ARBUE]<br>- Да! Пусть она ведет себя как настоящее животное, которыми вы и являетесь! Муахахахаха!!!'
!$arbue_pref[3] = '  [ARBUE]<br>- Обучи мне питомца of rank D или выше, и я заплачу пятьсот sparks.'
! JO9 MOD START J9M2079 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['arbue'] = '[아르부에]<br>&nbsp;좋아, 그녀를 받겠다. 여기 네 스파크다, 그리고 고맙다. 내 마음에 들었으면 좋겠군!'
$refuse_skill_quote['arbue'] = '[아르부에]<br>&nbsp;요구 조건도 못 맞추는데 내가 왜 그녀를 필요로 하지? 관심 없다.'
$refuse_level_quote['arbue'] = '[아르부에]<br>&nbsp;더 나은 여자를 찾을 수 없나? 등급을 생각하면 너무 비싸군.'
$refuse_charm_quote['arbue'] = '[아르부에]<br>&nbsp;음… 모르겠군. 형식상으론 맞지만, 너무 볼품없어 보여. 마음에 안 들어.'
$refuse_health_quote['arbue'] = '[아르부에]<br>&nbsp;무슨 수작을 부리려는 거지? 그녀는 있어야 할 만큼 건강하고 활기차 보이지 않는다. 자칫하면 멀쩡히 못 나갈 줄 알아라!'
$refuse_pregnant_quote['arbue'] = '[아르부에]<br>&nbsp;그래서, 임신한 노예를 나한테 팔고 그 처리까지 내가 하길 바라는 거냐? 절대 안 된다!'
$refuse_again_quote['arbue'] = '[아르부에]<br>&nbsp;안 된다는 건 안 되는 거다!'
! JO9 MOD END J9M2079

