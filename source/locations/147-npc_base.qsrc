$npc_image['sir_shelly'] = 'sir_shelly'
$npc_name['sir_shelly'] = '셸리 경'
$npc_status['sir_shelly'] = '클럽 주인<br>타우루스 가문'
$npc_info['sir_shelly'] = '   이 남자는 신사용 클럽 운영을 밀어붙이며 엄청난 영향력을 손에 넣는 데 성공했다. 셸리 경의 클럽을 찾는 이들 중에는 황소 대가문의 가장 영향력 있는 인사들도 포함되어 있어서, 클럽 밖에서 그들을 만나는 건 꽤 어려운 일이다.'
npc_attitude['sir_shelly'] = 11
demand_rating['sir_shelly'] = 6
$interesting_specialisation['sir_shelly'] = 'concubine'

! JO9 MOD START J9M2146 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$sir_shelly_pref[1] = '[쉘리 경]<br>&nbsp;내 모임은 여자로 유명하지, <<$master_name>>. 나는 직접 최고의 노예만 선발하고, 그중에도 수긍되는 애들만 접대를 시킨다고.</div>'
$sir_shelly_pref[2] = '[쉘리 경]<br>&nbsp;다양하게 접대하려면, <font color="#009FEF"><b>예쁜</b></font> 직원들이 아주 많이 필요해. 자네가 권할 수 있는만큼 내가 다 데려가지. 당연 내 맘에 드는 애들로.</div>'
$sir_shelly_pref[3] = '[쉘리 경]<br>&nbsp;자네 시간 허비하기 싫으면, 무조건 특출나게 <font color="#009FEF"><b>훈련되고</b></font> <font color="#6b0084"><b>잘 빠진</b></font> 애들로만 데려와. 물-론 신사를 어떻게 만족 시키는진 기본이고, 그 계통 다른 능력도 말이야.</div>'
$sir_shelly_pref[4] = '[쉘리 경]<br>&nbsp;난 흥정 싫어해, 그러니 가격을 정하자고. 싸구려는 필요 없어. 너무 비싼애라고 더 주지도 않을거고.</div>'
$sir_shelly_pref[5] = '[쉘리 경]<br>&nbsp;내 사항을 간단 요약해, 자네 조합이 정한 기준에 의거해주지. <b><<$rating[demand_rating[''sir_shelly'']]>></b>이상 등급 성노예를 데려오게. 거래가 이뤄지면, <<common_price[demand_rating[''sir_shelly'']]>> 스파크를 지불하지. 아주 합리적인 가격이야. 거기에 자네 평판에 크게 도움이 될 사람들도 보게 되겠지.</div>'
! JO9 MOD END J9M2146

! JO9 MOD START J9M2145 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['sir_shelly'] = '[쉘리 경]<br>&nbsp;좋아, 데려가지. 스파크를 받고, 내 감사도 받게.<br>마음에 드는군.</div>'
$refuse_skill_quote['sir_shelly'] = '[쉘리 경]<br>&nbsp;능력이 되는 애들 중 에서도, 직접 선발 하겠다고, 말 하지 않았던가?</div>'
$refuse_level_quote['sir_shelly'] = '[쉘리 경]<br>&nbsp;싸구려는 필요 없다고 했을텐데. 난 이런것과 상종 안 해.</div>'
$refuse_charm_quote['sir_shelly'] = '[쉘리 경]<br>&nbsp;뭐, 능력은 되어 보이는군. 그런데, 꼬락서니가 맞질 않아.</div>'
$refuse_health_quote['sir_shelly'] = '[쉘리 경]<br>&nbsp;그렇게 흐느적 대는건 춤 출때나 시키라고.<br>조용히 넘어갈 때 당장 나가!</div>'
$refuse_pregnant_quote['sir_shelly'] = '[쉘리 경]<br>&nbsp;임신해서 늘어진 배를 가진 노예를 받아줄 것 같나? 천만에!</div>'
$refuse_again_quote['sir_shelly'] = '[쉘리 경]<br>&nbsp;아니, 안받아. 말하지 않았나.</div>'
! JO9 MOD END J9M2145
