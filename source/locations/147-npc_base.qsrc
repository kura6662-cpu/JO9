! JO9 MOD START J9M1888 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Pelageya_pref[1] = '[펠라게야]<br>&nbsp;<<$master_name>>, 당신은 아주 유능한 전문가라고 추천받았어요. 마침 제가 찾는 것도 꽤 특별한 것이어서, 딱 잘됐네요.'
$Pelageya_pref[2] = '[펠라게야]<br>&nbsp;내겐 아들들이 있는데, 벌써 여자들에게 눈길을 주기 시작했지만, 난 그들을 매춘굴로 데려가고 싶지 않아. 그건 그들의 신분에 맞지 않아. 그래서 그들의 연인이자 스승이 되어 줄 노예가 필요해.'
$Pelageya_pref[3] = '[펠라게야]<br>&nbsp;아직 젊은 여자애가 필요해요. 그래야 제 아들들과도 잘 어울릴 수 있으니까요. <font color="#008080"><b>영리해야</b></font> 해요. 또 제 아들들과 시내에 함께 나가 <font color="#0000CD"><b>그들의 지출을 살필</b></font> 수 있으면 좋겠네요.'
$Pelageya_pref[4] = '[펠라게야]<br>&nbsp;그리고 <font color="#0000CD"><b>예절</b></font>도 익히게 해 주세요. 무례한 사람은 질색이거든요.'
$Pelageya_pref[5] = '[펠라게야]<br>&nbsp;당연히 그녀는 처녀여야 해, 그건 논의할 가치도 없어; 창녀는 내 아들들에게 어울리지 않으니까. 또한 그녀는 내 아들들을 단단히 휘어잡을 수 있을 만큼 <font color="#008080"><b>강한 성격</b></font>을 가져야 해, 안 그러면 내가 그들을 좀 소홀히 해 둔 셈이니까.'
$Pelageya_pref[6] = '[펠라게야]<br>&nbsp;<font color="#0000CD"><b>음악</b></font>, 학문... 그런 것도 알게 해 주세요. <font color="#008000"><b>아름답고</b></font>, 부드럽고, 순진한 여자애, 그게 제가 원하는 거예요. 나머지는 당신에게 맡길게요. 그렇게 해 준다면 남편과의 만남을 주선해 드릴게요.'
$buy_quote['Pelageya'] = '[펠라게야]<br>&nbsp;어머! 정말 인형 같네요! 너무 마음에 들어요! 받겠어요!'
$refuse_skill_quote['Pelageya'] = '[펠라게야]<br>&nbsp;괜찮긴 하지만, 할 줄 아는 게 많지 않은 게 분명하네요. <<$master_name>>, 좀 더 잘 훈련시켜서 다시 오세요.'
$refuse_level_quote['Pelageya'] = '[펠라게야]<br>&nbsp;아직 분명 준비가 안 됐어요. 수준이 맞지 않네요. 물론 가능성은 있어요. 계속 다듬어 오세요, <<$master_name>>.'
$refuse_charm_quote['Pelageya'] = '[펠라게야]<br>&nbsp;에휴. 제가 분명 말했잖아요 — 전 인형 같은 애를 보고 싶다고요. 그런데 이 애는 제가 원하는 게 전혀 아니에요. 받지 않겠어요!'
$refuse_health_quote['Pelageya'] ='[펠라게야]<br>&nbsp;<<$master_name>>, 조금 몸이 안 좋아 보이네요.'
$refuse_pregnant_quote['Pelageya'] = '[펠라게야]<br>&nbsp;<<$master_name>>, 분명 처녀를 데려오라고 했던 것 같은데, 당신이 데려온 애는 누가 봐도 임신했잖아요!'
$refuse_special_quote['Pelageya'] = '[펠라게야]<br>&nbsp;이건 제가 주문한 것과 전혀 다르잖아요!'
! JO9 MOD END J9M1888


