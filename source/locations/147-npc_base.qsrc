! JO9 MOD START J9M2019 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$BlackWarrior_pref[1] = '[블랙 워리어]<br>&nbsp;내 누추한 집에 온 걸 환영한다, <<$master_name>>! 너 같은 자와 오래 떠들 시간은 없지만, 마침 지금 우리에겐 공통의 일이 하나 생겼다.'
$BlackWarrior_pref[2] = '[블랙 워리어]<br>&nbsp;최근에 아는 자 하나 때문에 골치 아픈 일이 좀 생겨서 말이지, 그 문제를 해결하고 싶다. 자, 본론으로 들어가자.'
$BlackWarrior_pref[3] = '[블랙 워리어]<br>&nbsp;내 문제를 해결하는 데 도움이 될 노예가 필요하다. 그녀는 <font color="#0000CD"><b>영리하고</b></font>, <font color="#008000"><b>매력적이며</b></font>, <font color="#0000CD"><b>이국적이어야</b></font> 한다. 그리고 <font color="#008000"><b>춤출</b></font> 줄 알고 <font color="#008000"><b>움직임도 좋아야</b></font> 해서 내 친구의 시선을 사로잡아야 한다. 알다시피, 그자는 그런 노예를 아주 좋아하거든.'
$BlackWarrior_pref[4] = '[블랙 워리어]<br>&nbsp;또 그녀가 자기 몸을 <font color="#008080"><b>드러낼 줄</b></font> 알고, 보지와 엉덩이뿐 아니라 다른 부위들로도 <font color="#008080"><b>남자를 만족시킬 줄</b></font> 알길 바란다. 게다가 뛰어난 <font color="#008000"><b>전사</b></font>여야 한다. 그녀에게 의지는 필요 없다, 내가 명령하는 건 엄격하게 따르기만 하면 된다.'
$BlackWarrior_pref[5] = '[블랙 워리어]<br>&nbsp;한 가지 더... 우리 거래를 아무에게도 들키고 싶지 않다. 그냥 내가 너한테서 노예를 샀다는 사실이 알려지면 몹시 불쾌해질 거라고만 해 두지. 이 일을 해내면, 왕과의 만남을 보장해 주겠다.'
$buy_quote['BlackWarrior'] = '[블랙 워리어]<br>&nbsp;그래. 이게 내가 원하는 거다. 개성도 또렷하고 제대로 훈련되어 있군. 일은 나쁘지 않았어, <<$master_name>>! 약속대로 왕께 네 얘기를 해 두지.'
$refuse_skill_quote['BlackWarrior'] = '[블랙 워리어]<br>&nbsp;안 된다. 이 기술로는 부족하다. 계속 훈련시켜라.'
$refuse_level_quote['BlackWarrior'] = '[블랙 워리어]<br>&nbsp;다 훌륭하긴 하다. 하지만 이 상품이 내가 요구한 수준에 맞긴 하나? 수준이 맞지 않아!'
$refuse_charm_quote['BlackWarrior'] = '[블랙 워리어]<br>&nbsp;내가 필요한 이미지와는 좀 다르군. 내 옆이나 내 친구 옆에 서 있으면 그냥 우스워 보일 거다.'
$refuse_health_quote['BlackWarrior'] = '[블랙 워리어]<br>&nbsp;얘는 여기서 바로 산산조각 나 버리지나 않으면 다행이겠군. <<$master_name>>랑은 다르단 말이다!'
$refuse_pregnant_quote['BlackWarrior'] = '[블랙 워리어]<br>&nbsp;농담하나? 내가 왜 임신한 여자가 필요하지? 이건... 아무튼 저것부터 치워 버려. 그리고 날 화나게 하지 마!'
$refuse_special_quote['BlackWarrior'] = '[블랙 워리어]<br>&nbsp;내게는 안 맞는다. 특별 요구 조건을 충족하지 못했어. 이걸로 끝이다, <<$master_name>>.'
! JO9 MOD END J9M2019


