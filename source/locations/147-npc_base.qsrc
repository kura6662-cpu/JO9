! JO9 MOD START J9M2125 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$taurus_king_pref[1] = '[국왕 아르보리우스]<br>&nbsp;이런, <<$master_name>>, 내 경들이 자네에 참으로 요상한 요구들만 했었지, 엉? 때론 기괴해 보일때도 있지만, 뭐 괜찮지 않은가? 훌륭하신 전문가들께선, 이런 작은 괴벽 정도는 가뿐히 맞춰 줄 수 있잖나?</div>'
$taurus_king_pref[2] = '[국왕 아르보리우스]<br>&nbsp;걱정은 말게, 난 대단한 걸 바라지 않아. 그냥 <font color="#009900"><b>최고의</b></font> 여자가 필요해. 하나 골라잡아 가르키고, <b>최고</b>로 멋진 성노예로 구해주게. <font color="#0000D8"><b>인상적인</b>걸로 말야.</font></div>'
$taurus_king_pref[3] = '[국왕 아르보리우스]<br>&nbsp;뭐, <font color="#009900"><b>침대</b></font>에서는 끝내줘야지. <font color="#009900"><b>손과 입</b></font>으로도 할 줄 알아야 하고. 아, 자네가 나보다 잘 알겠군. 하지만 난 단순한 건 별로야.</div>'
$taurus_king_pref[4] = '[국왕 아르보리우스]<br>&nbsp;난 나와 <font color="#0000D8"><b>자아가 있는</b></font> 소통의 장을 열고, 그녀만의 <font color="#009FEF"><b>감성</b></font>을 보고싶네. 현실 여성. 알잖나, <font color="#009FEF"><b>두뇌</b></font>. 그저 자기 분수도 모르는 골빈 노예말고.</div>'
$taurus_king_pref[5] = '[국왕 아르보리우스]<br>&nbsp;다른 것이라? 흠, <b>잘 모르겠군.</b> 하나를 제외하곤. 바로 날 충족시키는 것. 데려오면 판단하지. 내 시간 허비말고 준비된 여자만 데려오게.</div>'
$buy_quote['taurus_king'] = '[국왕 아르보리우스]<br>&nbsp;축하하네 <<$master_name>>, 자네가 왕에게 어울리는 노예를 데려왔어. 사례는 재무관이 지급할걸세.</div>'
$refuse_skill_quote['taurus_king'] = '[국왕 아르보리우스]<br>&nbsp;아니야. 조예가 부족해, 다신 실수말게 <<$master_name>>.</div>'
$refuse_level_quote['taurus_king'] = '[국왕 아르보리우스]<br>&nbsp;왕이 <b><<$rating[demand_rating[''taurus_king'']]>></b> 하나 충당 못하면, 누가 사겠나? 난 정상급 노예가 필요해. 내 말 아니 했던가?</div>'
$refuse_charm_quote['taurus_king'] = '[국왕 아르보리우스]<br>&nbsp;확실한 일처리야, 여지없이. 그러니 쉽게 살 사람을 찾겠지. 그래도 난 안 사. 마음에 안들어. 왕의 변덕이라 여기어 두게.</div>'
$refuse_health_quote['taurus_king'] = '[국왕 아르보리우스]<br>&nbsp;체력이 없어 비틀대지 않는가. 살려 보내는 걸 다행으로 알아!</div>'
$refuse_pregnant_quote['taurus_king'] = '[국왕 아르보리우스]<br>&nbsp;임신 노예? 자네, 실로 죽음을 바라는가?</div>'
$refuse_special_quote['taurus_king'] = '[국왕 아르보리우스]<br>&nbsp;이미 말 했을텐데, 내가 마음을 바꿀 것 같나? 그럼 다시 말해주지, 이 여잔 적합치 않아.</div>'
! JO9 MOD END J9M2125

$npc_image['general_barabas'] = 'general_barabas'
