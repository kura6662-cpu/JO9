!Russian Quarter Buyers
$npc_image['nastia'] = 'nastia'
$npc_name['nastia'] = '나스탸'
$npc_status['nastia'] = '(중립파)'
$npc_alignment['nastia'] = 'russiankvartal'
$npc_info['nastia'] = '영리하고 아름답다. 자기 일을 잘 알고 집안도 훌륭히 꾸려 나간다. 스파크도 넉넉하지만, 개인적인 행복은 부족하다. 그리고 그녀는 노처녀로 남고 싶어 하지 않는다. 사람들은 그녀를 비웃을 것이다...'
demand_rating['nastia'] = 2
$interesting_specialisation['nastia'] = 'concubine'
$diary_mark['nastia'] = " <<$npc_name['nastia']>>. 러시아 구역에 산다."
! JO9 MOD START J9M2048 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$nastia_pref[1] = "[나스탸]<br>&nbsp;자, 안녕하세요, <<$master_name>>! 저는 <<$slave_type_name[$interesting_specialisation['nastia']]>> 전문화의 <<$rating[demand_rating['nastia']]>> 등급 이상 노예가 필요해요. <<common_price[demand_rating['nastia']]>> 스파크를 내겠어요. 하지만 그건 나중에 따져 보죠... 그보다 먼저 한잔하면서 서로 좀 더 알아 가요! 마침 새 깃털 침대도 있거든요... 솜털 침대요... 그러니 같이 길을 들여 보자고요..."
! JO9 MOD END J9M2048
!$nastia_pref[2] = " [Nastia]
- What are you muttering there?! You haven’t come to ask for my hand in marriage? Then why did you come?... To propose to me with a girl!... You shameless fellow!... Although, come what may. It’s better to fornicate with a slave than to remain an old maid... Bring your harlot! <<common_price[demand_rating['nastia']]>> I’ll pay you sparks... Rank <<$rating[demand_rating['nastia']]>> you say she will. I don’t care, as long as she loves me and lets me love her!!! "
!$nastia_otkaz[1] = " [Nastia]
- <<$master_name>>, I have nothing to ask of you. Maybe I'll need someone another time, but for now I don't need anyone... "
!$nastia_pref[1] = "  [Nastya]<br>- I need <<$slave_type_name[$interesting_specialisation['nastia']]>> of rank <<$rating[demand_rating['nastia']]>> or higher. I’ll pay <<common_price[demand_rating['nastia']]>> sparks."
! JO9 MOD START J9M2047 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['nastia'] = '[나스탸]<br>&nbsp;좋아요, 그녀를 받겠어요. 여기 당신 스파크예요, 고마워요. 내 마음에 들었으면 좋겠네요!'
$refuse_skill_quote['nastia'] = '[나스탸]<br>&nbsp;해야 할 일을 해낼 수 없는데 제가 왜 그녀를 필요로 하죠? 그런 상품엔 관심 없어요.'
$refuse_level_quote['nastia'] = '[나스탸]<br>&nbsp;더 나은 여자를 찾을 수 없나요? 등급을 생각하면 너무 비싸요.'
$refuse_charm_quote['nastia'] = '[나스탸]<br>&nbsp;음… 모르겠네요. 형식상으론 맞지만, 너무 볼품없어 보여요. 매력도 부족하고요. 마음에 안 들어요.'
$refuse_health_quote['nastia'] = '[나스탸]<br>&nbsp;무슨 수작을 부리려는 거죠? 그녀는 있어야 할 만큼 건강하고 활기차 보이지 않아요. 자칫하면 멀쩡히 못 나갈 줄 알아요!'
