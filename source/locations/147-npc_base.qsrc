$npc_alignment['barman'] = 'serpis'
$npc_info['barman'] = '<br> 엄청난 근조직을 가진 위협적인 드워프.<br><br> 그가 자신보다도 커다란 도끼를 카운터 밑에 숨기고 있다는 사실은, 그다지 비밀도 아니다. 덕분에 경비원도 이 술집에는 필요 없을 정도다.<br><br>물론 평상시의 작크는 좋은 남자이다.<br><br> 불평이 좀 많긴 하지만, 종업원 채용도 제안할 수 있다.'
demand_rating['barman'] = 2
!$interesting_specialisation['barman'] = 'servant' &! commented out so slaves with C- cooking skill will be accepted
$npc_preferences['barman'] = {
	stat_importance['expression'] = 2
	stat_importance['service'] = 2
	stat_importance['secretary'] = 2
	stat_importance['music'] = 3
	stat_importance['cook'] = 2
	stat_importance['oral'] = 1 &! intentionally lower than requirements text, which specifies specific skills, not category level
	stat_importance['petting'] = 1 &! intentionally lower than requirements text, which specifies specific skills, not category level
	stat_importance['calisthenics'] = 2
	stat_importance['orgy'] = 2 &! intentionally lower than requirements text, which specifies specific skills, not category level
}
npc_attitude['barman'] = 10
npc_reveal['barman'] = 1
npc_bennies['barman'] = 6
npc_reward['barman'] = 200
npc_advance['barman'] = 150
buying_temp['barman'] = 25
count_size['barman'] = 1
$npc_demand_list['barman'] = ""
npc_contract_time['barman'] = 31
$train_contract['barman'] = '<center>СТАНДАРТНЫЙ КОНТРАКТ НА ОБУЧЕНИЕ</center><br><br>' + _
'Наниматель: Бар "Бедро девственницы" (Великий Serpis House)<br>' + _
'Категория: D<br>' + _
'Срок обучения: 21 сутки<br>' + _
'Оплата содержания: 150 искр<br>' + _
'Оплата по факту: 200 искр<br>' + _
'Условия обучения: Подготовка официанток для заведения.<br><br>' + _
'Профессиональный уровень: обслуживание, общение<br>' + _
'Компетентный уровень: привлекательность, выносливость, арифметика, оральный секс'
$npc_contract_talk['barman'] = {
	$place = 'tavern'
	copyarr '$text', '$barman_pref'
	contractor_demand['min_stamina'] = 2
	contractor_demand['min_beauty'] = 2
}
$buyer_demand['barman'] = {
	demand['min_stamina'] = 2
	demand['min_beauty'] = 2
}
! JO9 MOD START J9M2090 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$barman_pref[1] = '[바텐더 작크]<br>&nbsp;들어보시게, <<$master_name>>. 난 항시 종업원이 필요해. 하지만 <<common_price[demand_rating[''barman'']]>> 스파크 넘게는 안줄거니 염두에 둬. 항상 건방진 태도로 게으름피우고, 까무러치고, 넘어지는 애들은 필요없어. <font color="#6b0084"></b>좆같이</b></font> 생긴애도 필요 없어. 다만 일에 필요한 최소한의 <font color="#6b0084"></b>근육</b></font>은 붙은 녀석으로.</div>'
$barman_pref[2] = '[바텐더 작크]<br>&nbsp;언제든 고객 만족이 우선이야. 그러니 <font color="#6b0084"></b>정중히 접대</b></font>하고, 재빨리 <font color="#6b0084"></b>나르고, 씻고, 닦아</b></font>야 돼. 여지껏 중요 부분. 더 중요한 건 글을 읽을 줄 알아야 지. 여긴 자선 사업체가 아니니 만큼, <font color="#6b0084"></b>요금 계산</b></font>도 시킬테니까. 아, 음식 헷갈려하면 안되니까 <font color="#6b0084"></b>요리</b></font>도 좀 해야지.</div>'
$barman_pref[3] = '[바텐더 작크]<br>&nbsp;만약 종업원이 손님을 접대 안 할거면, 빈둥대는 대신 흥이라도 돋궈야지. 우리가게 최고의 행사 나체쇼로. 거기서 <font color="#0000D8"></b>노래나 피아노 연주</b></font>를 시킬거야, 감이 좀 오나. <font color="#6b0084"></b>춤</b></font>출때는 <font color="#EA0090"></b>가슴으로 문대</b></font>주기도 해야 할거고, 그래야 랩댄스라고 부를수나 있겠지.</div>'
$barman_pref[4] = '[바텐더 작크]<br>&nbsp;지금은 우리가 따로 업소 운영은 안하지만, 팁이라도 받으면 그 즉시 테이블 아래에서 물건을 <font color="#EA0090"></b>빨아줘</b></font>야 하고.</div>'
$barman_pref[5] = '[바텐더 작크]<br>&nbsp;통 큰 손님들은 가끔 가게를 임대할때도 있는데, 그땐 입에 무는정도로는 안끝내. 다들 취해서 맛이 가기 시작하면 종업원이 풀어 줘야지. <font color="#6b0084"></b>혼자서 한꺼번에</b></font>. 이게 내 이야기 전부네, <<$master_name>></div>'
$buy_quote['barman'] = '[바텐더 작크]<br>&nbsp;채용하도록 하지, 스파크 받아가게. 거기 신입, 멀뚱거리지 말고 일 많으니 따라와.</div>'
$refuse_skill_quote['barman'] = '[바텐더 작크]<br>&nbsp;내가 곡예를 바라던가? 가게에 필요한 능력만 있으면 돼, 형씨. 난 그런 애송이엔 관심 없어.</div>'
$refuse_level_quote['barman'] = '[바텐더 작크]<br>&nbsp;이런 등급이어서야 어디 채용하겠나?</div>'
$refuse_charm_quote['barman'] = '[바텐더 작크]<br>&nbsp;막되먹게 생긴건 종업원뿐 아니라 어디서도 안 써. 무슨 말인지 잘 한 번 생각해보라고.</div>'
$refuse_health_quote['barman'] = '[바텐더 작크]<br>&nbsp;종업원은 예상외로 체력이 많이 드는 직업이야. 그건 부실해.</div>'
$refuse_pregnant_quote['barman'] = '[바텐더 작크]<br>&nbsp;어디 임산부여서야 손님 비위나 맞추겠나.</div>'
$refuse_again_quote['barman'] = '[바텐더 작크]<br>&nbsp;내가 채용 안 한다고 말하지 않았나, 형씨.</div>'
! JO9 MOD END J9M2090

$npc_image['chief'] = 'chief'
$npc_name['chief'] = '셰프'
$npc_status['chief'] = '주방장<br>세르피스 가문 (반역파)'
$npc_alignment['chief'] = 'serpis'
$npc_info['chief'] = '<br> 주방은 선술집의 핵심.<br><br> 주방장이 왕이고 주방의 신이다<br><br> 어쨌든, 두가지 이유에서 그와 친해지는게 좋다. 첫번째. 요리사가 돼지로 쓰일 노예를 구입한다는것, 두번째는 유료이긴 해도, 그에게 몇가지 훌륭한 요리 수업을 받을 수 있다는 것이다.'
$npc_preferences['chief'] = {
	stat_importance['animal'] = 3 &! condition satisfied by pet OR pony OR cow skill
	stat_importance['cook'] = 3
	stat_importance['expression'] = 2
	stat_importance['penetration'] = 2
	stat_importance['orgy'] = 3
}
npc_attitude['chief'] = 10
npc_reveal['chief'] = 0
npc_bennies['chief'] = 0 &! no brand rate increase from selling to this npc
demand_rating['chief'] = 1
count_size['chief'] = 1
buying_temp['chief'] = 25

$buyer_demand['chief'] = {
	demand['min_stamina'] = 3
	demand['min_fat'] = 3
	demand['virginity'] = 2 &! pay extra if virgin
}

! JO9 MOD START J9M2089 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$chief_pref[1] = '[셰프]<br>&nbsp;내 경고하는데, 쉰내나는 송장이나 들이밀면 당신 후회할거야. 우리 돼지들은 엄격한 기준들에 따르고 있고, 최고의 고기임을 자랑해야돼. 선보이기 전에, 꼬챙이로 꿰는 걸!</div>'
$chief_pref[2] = '[셰프]<br>&nbsp;돼지는 우선 <font color="#0000D8"><b>건강</b></font>해야지, 그게 가장 중요한거야. 그러려면 <font color="#0000D8"><b>잘 먹였어야지</b></font>. 난 푸석한 고기는 안내놓는다고. 다른 품질은 별로 중요치 않아. 뭐 성깔있는게 손님들한테 잘 먹히기는 한데.</div>'
$chief_pref[3] = '[셰프]<br>&nbsp;손님들은 각자 원하는 돼지를 고를수가 있지. 그러니 <font color="#0000D8"><b>동물 행세</b></font>를 잘 보이면 더 인기가 좋지. 거기서 죽을때는 확실히 충성해야하고. 손님들이 만찬들과의 토론을 즐겨하니, <font color="#0000D8"><b>요리 지식</b></font>은 물론이거니와 <font color="#6b0084"><b>공손</b></font>하면 인기가 좋아.</div>'
$chief_pref[4] = '[셰프]<br>&nbsp;일반 <font color="#6b0084"><b>체위술</b></font>도 필요 할거야. 돼지를 잡기전에, 손님들이 가끔 다른맛도 원하니까. 그땐 실망시키지 않아야지. 여자 하날 전부다 먹기 힘든 이상 고객은 집단으로 구매하니, <font color="#0000D8"><b>다 만족</b></font>시켜야 돼.</div>'
$chief_pref[5] = '[셰프]<br>&nbsp;또 우리 가게명에서 알 수 있듯 처녀고기를 선호해. 그건 특별히 부드러워 더 비싸. 그러니 처녀일 경우에는 스파크를 더 주겠어. 그렇다고 당신 평판에 영향줄거라 생각은 마. 맛좋은 고기로 받을 찬사는 마땅히 요리사 몫이라고!</div>'
! JO9 MOD END J9M2089

$npc_image['yôhanan_stiven'] = 'yôhanan_stiven'
$npc_name['yôhanan_stiven'] = '마스터 요하난 스티븐'
$npc_status['yôhanan_stiven'] = '서예가<br>세르피스 가문 (반역파)'
$npc_alignment['yôhanan_stiven'] = 'serpis'
$npc_info['yôhanan_stiven'] = '   세르피스 대가문 지도자들 중 한 사람의 궁정 서예 마스터다. 아주 높은 지위는 아니지만, 노예에 돈을 쓸 만큼은 충분히 부유할 것이다 - 이 늙은이는 변태처럼 보인다. 게다가 정말 중요한 사람들 몇몇에게 내 얘기를 좋게 전달해 줄 수도 있다. 그를 화나게 만드는 건 피하는 편이 좋다.'
demand_rating['yôhanan_stiven'] = 2
$interesting_specialisation['yôhanan_stiven'] = 'refferent'
$diary_mark['yôhanan_stiven'] = "   <<$npc_name['yôhanan_stiven']>>. 그는 뱀자리 구역 개미집에 산다."
! JO9 MOD START J9M2088 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$yôhanan_stiven_pref[1] = "[마스터 요하난 스티븐]<br>&nbsp;나는 <<$slave_type_name[$interesting_specialisation['yôhanan_stiven']]>> 분야의 <<$rating[demand_rating['yôhanan_stiven']]>> 등급 이상 노예가 필요하오. <<common_price[demand_rating['yôhanan_stiven']]>> 스파크를 내겠소."
$buy_quote['yôhanan_stiven'] = '[마스터 요하난 스티븐]<br>&nbsp;좋아, 그녀를 받겠소. 여기 당신 스파크요, 고맙소. 내 마음에 들었으면 좋겠군!'
$refuse_skill_quote['yôhanan_stiven'] = '[마스터 요하난 스티븐]<br>&nbsp;요구 조건을 충족하지 못하는데 내가 왜 그녀를 필요로 하겠소? 관심 없소.'
$refuse_level_quote['yôhanan_stiven'] = '[마스터 요하난 스티븐]<br>&nbsp;더 나은 여자를 찾을 수 없소? 등급을 생각하면 너무 비싸오.'
$refuse_charm_quote['yôhanan_stiven'] = '[마스터 요하난 스티븐]<br>&nbsp;음… 모르겠군. 형식상으론 맞지만, 너무 볼품없어 보여. 마음에 안 드오.'
$refuse_health_quote['yôhanan_stiven'] = '[마스터 요하난 스티븐]<br>&nbsp;무슨 수작을 부리려는 거지? 저 여자는 있어야 할 만큼 건강하고 활기차 보이지 않소. 자칫하면 멀쩡히 못 나갈 줄 아시오!'
$refuse_pregnant_quote['yôhanan_stiven'] = '[마스터 요하난 스티븐]<br>&nbsp;그래서, 임신한 노예를 나한테 팔고 그 처리까지 내가 하길 바라는 거요? 절대 안 되오!'
$refuse_again_quote['yôhanan_stiven'] = '[마스터 요하난 스티븐]<br>&nbsp;안 된다는 건 안 되는 거요!'
! JO9 MOD END J9M2088


!CAMIRA GREAT HOUSE
$npc_image['tiamath'] = 'tiamath'
$npc_name['tiamath'] = '티아마트'
$npc_status['tiamath'] = '여주인<br>카미라 가문 (아웃캐스트)'
$npc_alignment['tiamath'] = 'kamira'
demand_rating['tiamath'] = 10
$npc_info['tiamath'] = '고대 용 티아마트.<br><br>대적할 자 없는 키메라 가문의 절대적 지배자.<Br><br> 그 시간이 너무 오랜탓에, 그녀 과거를 기억하는 자가 남지 않았다.<br><br> 거스를 수 없는 막강함과 지혜가, 그녈 경쟁자가 없을 지배자로 만들었지만, 다행히도 그녀는 고독하지 않다.<br> 적어도 인간 아닌자들 기준에서는.'
$npc_preferences['tiamath'] = {
	stat_importance['sensitivity'] = 5
	stat_importance['pet'] = 5
	stat_importance['nurse'] = 4
	stat_importance['alchemy'] = 4
	stat_importance['enchanter'] = 4
	stat_importance['service'] = 4
	stat_importance['music'] = 4
	stat_importance['xenophily'] = 3
}
$buyer_demand['tiamath'] = {
}
! JO9 MOD START J9M2087 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$tiamath_pref[1] = '[가주 티아마트]<br>&nbsp;<font style="font-size:22px;">광명속의 아이, 보이는가 인간? 아이는 나의 후계자, 새천년 가문 기대주. 현재 과히 심약하나, 나의 보전속에 최강으로 성장한다. 이 곳 더럽혀진 도시에서.</font></div>'
$tiamath_pref[2] = '[가주 티아마트]<br>&nbsp;<font style="font-size:22px;">그럴 그가, 그의 사정. 그 미흡한 상하 분별. 관대함은 그를 무력하게 한다. 그러므로 그는, 소형 생물 분부함에 낯익어야 한다. 그 쪽 처럼.</font></div>'
$tiamath_pref[3] = '[가주 티아마트]<br>&nbsp;<font style="font-size:22px;">그를 위한 인간여성 조련하라. 구색하여, 여잔 전적으로 주인에게 맹종한다. 그에 더해 틀림없이 <font color="#009900">감각한다</font>. 고통, 슬픔.</font></div>'
$tiamath_pref[4] = '[가주 티아마트]<br>&nbsp;<font style="font-size:22px;">그 여성이 꼭 아이를 양육한다. <font color="#009FEF">씻기고</font>, <font color="#009FEF">치유하고</font>, 자장가를 <font color="#009FEF">노래하라</font>. 그의 <font color="#0000D8">겁탈</font>에도 처신하라.</font></div>'
$tiamath_pref[5] = '[가주 티아마트]<br>&nbsp;<font style="font-size:22px;">더욱이 간명하라, 이상적인 <font color="#009900">사족보행</font>. 인간 가칠 지교하되 면담 소통 않게하라. 떠나라, 내 의지를 들은자여.</font></div>'
! JO9 MOD END J9M2087

! JO9 MOD START J9M2086 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['tiamath'] = '[가주 티아마트]<br>&nbsp;<font style="font-size:31px;">옳다. 이건 해낼거다. 스파크를 네것으로 삼아라. 재무관에 접촉하라, 인간.</font></div>'
$refuse_skill_quote['tiamath'] = '[가주 티아마트]<br>&nbsp;<font style="font-size:31px;">아니! 학문이 한없이 부족하다. 일 가담에 너무도 부족하다.</font> <font style="font-size:40px;">형편없어. 나빠!</font></div>'
$refuse_level_quote['tiamath'] = '[가주 티아마트]<br>&nbsp;<font style="font-size:31px;">인간 기준으로라도 뛰어하게, 보다 훌륭하게, 더욱 좋게하라, 인간. 나의 인내심을 시험하지 마라.</font></div>'
$refuse_charm_quote['tiamath'] = '[가주 티아마트]<br>&nbsp;<font style="font-size:31px;">눈에 간교함이 묻어난다. 고로 허락치 않겠다. 그 여성을 치워버려!</font></div>'
$refuse_health_quote['tiamath'] = '[가주 티아마트]<br>&nbsp;<font style="font-size:31px;">강건함이 묻어나지 않고있다. 조용히 떠나라.</font></div>'
$refuse_pregnant_quote['tiamath'] = '[가주 티아마트]<br>&nbsp;<font style="font-size:31px;">더렵혀진 도시만큼 더렵혀진 여자이다. 떠나라, 살려준다.</font></div>'
$refuse_special_quote['tiamath'] = '[가주 티아마트]<br>&nbsp;<font style="font-size:40px;">저리가!</font></div>'
! JO9 MOD END J9M2086

$npc_image['pretor_tifaret'] = 'pretor_tifaret'
$npc_name['pretor_tifaret'] = '티파렛'
$npc_status['pretor_tifaret'] = '법무관<br>카미라 가문 (추방자들)'
$npc_alignment['pretor_tifaret'] = 'kamira'
$npc_info['pretor_tifaret'] = '뿔 달린 거대 괴물.<br><br> 고향에서 가장 강대한 자이며, 매일 바티칸으로부터 스파크를 운반하는 책임을 맡고있다.'
demand_rating['pretor_tifaret'] = 8
$interesting_specialisation['pretor_tifaret'] = 'pet'
$diary_mark['pretor_tifaret'] = "<<$npc_name['pretor_tifaret']>>. 그와 알현하려면 추방자 구역의 티에라 델 시타델을 찾아가야 한다."
$npc_preferences['pretor_tifaret'] = {
	stat_importance['temper'] = 3
	stat_importance['pet'] = 4
	stat_importance['penetration'] = 4
	stat_importance['xenophily'] = 4
}
$buyer_demand['pretor_tifaret'] = {
	demand['min_stamina'] = 5
}
! JO9 MOD START J9M2085 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$pretor_tifaret_pref[1] = '[법무관 티파렛]<br>&nbsp;아무리 어려운 작업도 해낼 수 있다던데. 내 크기가 보이시오, <<$master_name>>? 내 사랑을 감당할 수 있는 여자를 찾는 건 어려운 일이오. 그렇다고 털난 오우거 같은 여자는 싫소.</div>'
$pretor_tifaret_pref[2] = '[법무관 티파렛]<br>&nbsp;하지만 노력하는 게 좋을 거요. 난 따분함을 떨치기 위해 여러 가지가 필요하오. 난 할 게 아무것도 없소, 심지어 진심으로 누군가와 싸우는 것도 불가능하오. 여성의 애정만이 날 구원할 수 있소.</div>'
$pretor_tifaret_pref[3] = '[법무관 티파렛]<br>&nbsp;당신이 준비할 노예가 말과 할 수 있는지 체크해보시오. 그녀가 <font color="#009FEF"><b>말의 것을 감당</b></font>할 수 있다면, 나를 감당할 수 있을 거요. 그리고 가장 중요한 것, 그녀는 <font color="#009900"><b>건강하고</b></font> 강해야 하고, 아름다워야 하오.</div>'
$pretor_tifaret_pref[4] = '[법무관 티파렛]<br>&nbsp;그리고 그녀는 <font color="#009FEF"><b>남자와의 잠자리를</b></font> 거부하지 않아야 하오. 내가 크긴 하지만 사람이지 말은 아니오. 그리고 <font color="#0000D8"><b>뜨겁게 반응해야</b></font> 하오. 지루한 여자는 싫소. 내가 얼마나 지루한지 이야기했던가?</div>'
$pretor_tifaret_pref[5] = '[법무관 티파렛]<br>&nbsp;난 내가 일을 끝내고 집에 돌아왔을 때, 누군가가 <font color="#009FEF"><b>개처럼</b></font> 행복하게 반겼으면 좋겠소. 즉시 내 맘을 편하게 하겠지. 내 요구는 이게 끝이오.</div>'
$buy_quote['pretor_tifaret'] = '[법무관 티파렛]<br>&nbsp;딱 맞아 보이는군. 그 귀여운 얼굴에 한 방 갈긴다고 기절 않겠구만. 내 데려가겠어, 암. 여기 그대의 스파크요.</div>'
$refuse_skill_quote['pretor_tifaret'] = '[법무관 티파렛]<br>&nbsp;아니, 나빠. 그대 여잔 무엇도 못하잖소. 더 가르치시오.</div>'
$refuse_level_quote['pretor_tifaret'] = '[법무관 티파렛]<br>&nbsp;얼핏 보아도 수준이 좋지 않군. 더 가르치시오.</div>'
$refuse_charm_quote['pretor_tifaret'] = '[법무관 티파렛]<br>&nbsp;으으, 그건 아니야. 댁 눈엔 내가 미련하게 크기만 한 황소인간이라, 어떤 소든 충분할 것 같소? 난 좀 우아한 걸 원한다고.</div>'
$refuse_health_quote['pretor_tifaret'] = '[법무관 티파렛]<br>&nbsp;뭐하는 거요? 여자가 신체, 근력 모두 부족하잖아. 조용히 돌아가시오.</div>'
$refuse_pregnant_quote['pretor_tifaret'] = '[법무관 티파렛]<br>&nbsp;그래, 임신한 것으로 거래를 하려고? 하!</div>'
$refuse_special_quote['pretor_tifaret'] = '[법무관 티파렛]<br>&nbsp;너무 약해. 난 안 데려갈거요.</div>'
! JO9 MOD END J9M2085

