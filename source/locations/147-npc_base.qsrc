$npc_alignment['Emiliya'] = 'futaland'
$npc_info['Emiliya'] = '  에밀리야의 연회는 구역 전역에서 유명하고, 어떤 것은 로마 전역에 알려져 있기도 하다. 초대장을 받으려면 그녀 본인과 가까운 사이이거나 거액을 내야 한다.'
demand_rating['Emiliya'] = 5
