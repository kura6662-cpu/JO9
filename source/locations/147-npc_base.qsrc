! JO9 MOD START J9M2139 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$_pref[1] = '[구매자]<br>&nbsp;됐어.'
$buy_quote['sample'] = '[구매자]<br>&nbsp;좋아, 그녀를 받겠어. 여기 스파크, 그리고 고맙군. 내 마음에 들었으면 좋겠어!'
$refuse_skill_quote['sample'] = '[구매자]<br>&nbsp;해야 할 일을 해낼 수 없는데 내가 왜 그녀를 필요로 하지? 그런 상품엔 관심 없어.'
$refuse_level_quote['sample'] = '[구매자]<br>&nbsp;더 나은 여자를 찾을 수 없나? 그녀는 등급을 생각하면 너무 비싸.'
$refuse_charm_quote['sample'] = '[구매자]<br>&nbsp;음… 모르겠군. 형식상으론 맞지만 너무 볼품없어 보여. 마음에 안 들어.'
$refuse_health_quote['sample'] = '[구매자]<br>&nbsp;무슨 수작을 부리려는 거지? 저 여자는 있어야 할 만큼 건강하고 활기차 보이지 않는다. 자칫하면 멀쩡히 못 나갈 줄 알아라!'
$refuse_pregnant_quote['sample'] = '[구매자]<br>&nbsp;그래서, 임신한 노예를 나한테 팔고 그 처리까지 내가 하길 바라는 건가? 절대 안 된다!'
! JO9 MOD END J9M2139
!dont forget about this
