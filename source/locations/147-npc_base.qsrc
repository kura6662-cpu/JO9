! JO9 MOD START J9M1887 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Legat_pref[1] = '[레가트]<br>&nbsp;뭐라고 해야 할까, <<$master_name>>... 황제 가이우스를 찾아오다니, 당신은 아마 미쳤을 거다. 그의 측근이 아닌 이상 그에게 닿을 수 있는 자는 극소수뿐이니까. 하지만 네 탓은 안 하겠다.'
$Legat_pref[2] = '[레가트]<br>&nbsp;...도와줄 생각은 있다. 하지만 일종의 시험을 통과할 수 있다면 말이지... 어쨌든 당신은 노예상이니까... 그리고 평판을 보아하니 꽤 괜찮은 실력자인 것 같더군... 그러니...'
$Legat_pref[3] = '[레가트]<br>&nbsp;난 노예가 필요하다. 지금 보이는 저건 쓸모없다. 이미 망가진 년이야. 난 아름답고, <font color="#0000CD"><b>다정하고</b></font>, <font color="#008080"><b>날씬한</b></font> 여자애가 필요하다. 집안일도 잘해야 해: 요리와 청소 말이다. 또 훌륭한 치유사여야 해서, 치료도 하고 매혹도 할 줄 알아야 한다. 상황은 늘 다르니까.'
$Legat_pref[4] = '[레가트]<br>&nbsp;하지만 가장 중요한 건, 대주는 걸 아주 잘해야 한다는 거다. 그게 여자들이 제대로 할 수 있는 유일한 일이지. 그리고 고통도 견딜 수 있어야 한다. 때로는 여러 명이 한꺼번에 그녀를 가질 테고, 그놈들이 조심할 일은 절대 없을 테니까.'
! JO9 MOD END J9M1887

! JO9 MOD START J9M1886 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Legat_pref[5] = '[레가트]<br>&nbsp;그리고 기억해라, 난 뚱뚱한 고깃덩이는 필요 없다. 오직 날씬하고 아름다운 여자애만이 내 개인 소유물이라는 지위에 걸맞다. 너라면 그 정도쯤 어렵지 않겠지?! 그런 애를 찾아오면 가이우스와의 만남을 주선해 주겠다. 이제 가라! 난 다른 일도 많다.'
$buy_quote['Legat'] = '[레가트]<br>&nbsp;내게 어울릴 만하다고? 좋다! 아주 좋군! 받겠다!'
$refuse_skill_quote['Legat'] = '[레가트]<br>&nbsp;이런 무능한 것에게 뭘 맡기라고? 말도 안 된다. 제대로 훈련부터 시켜 와라!'
$refuse_level_quote['Legat'] = '[레가트]<br>&nbsp;내 지위로는 평범한 것으로 만족할 수 없다. 여자애라면 제 스파크 값은 해야지!'
$refuse_charm_quote['Legat'] = '[레가트]<br>&nbsp;매력이 없군. 내 눈앞에서 치워라!'
$refuse_health_quote['Legat'] = '[레가트]<br>&nbsp;그녀는 앞으로 겪게 될 일을 감당 못 할 것 같다. 정신이 약하든, 속이 약하든 둘 중 하나다. 아무튼 내게는 안 맞아.'
$refuse_pregnant_quote['Legat'] = '[레가트]<br>&nbsp;임신했군! 내 눈앞에서 치워라!'
$refuse_special_quote['Legat'] = '[레가트]<br>&nbsp;겉모습은 괜찮아 보인다. 하지만 내가 원하는 건 그게 아니다. 내 눈앞에서 치워라!'
! JO9 MOD END J9M1886


