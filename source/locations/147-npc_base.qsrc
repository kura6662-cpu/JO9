npc_bennies['madame_jofre'] = 100
npc_contract_time['madame_jofre'] = 31

$jofre_pref[1] = '[안주인 조프리]<br> 제 설립지에서, 모든 과정은 아주 세세한 것 까지도 잘 갖추어져 있죠. 그러니 최대한 완벽하게 설명드리죠, 우리 자기님. 처음엔 아이들의 성교육 일환으로 접대시켜요. 그 최우선 조건은 입으로, 그리고 성기를 다루는 기술.</div>'
! JO9 MOD START J9M2148 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$jofre_pref[2] = '[안주인 조프리]<br>&nbsp;물론, 손 기술이나 다른 여자들과 함께 집단으로 상대하면 더 도움이 되겠죠. 가끔 특별한 걸 원하는 고객도 있지만. 뭐 꼭 필요한 건 아니에요. 고용인들 성기술은 나도 당신만큼이나 잘 가르치니까.</div>'
$jofre_pref[3] = '[안주인 조프리]<br>&nbsp;우리 고객은 <font color="#0000D8"><b>예쁜 여자</b></font>를 찾으러들 오세요. 아무리 간음의 여신이라도 <b>상처</b>가 있으면 안 받아요. 또 <font color="#0000D8"><b>활발한 성격</b></font>도 필요해요. 나는 제재소를 운영하는게 아니니까요. 그러니 <font color="#6b0084"><b>통나무</b></font>는 필요 없어요. 무슨 말인지 당신 자신도 잘 아실테죠, 내 사랑.</div>'
$jofre_pref[4] = '[안주인 조프리]<br>&nbsp;직원 스스로들 <font color="#6b0084"><b>방 잡일과 청소</b></font>와 <font color="#6b0084"><b>끼니</b></font>를 번갈아가며 때우니, 가사일이 요구 될 거에요.<br>고객들과 <font color="#6b0084"><b>진심을 다해</b></font> 대하는 것 역시 중요하죠. 물론 <font color="#009FEF"><b>건강</b></font>해야죠. 개인적으로는 예술성도 있으면 좋겠지만, 일에 꼭 필요한건 아니에요.</div>'
$jofre_pref[5] = '[안주인 조프리]<br>&nbsp;조건을 축약해드리죠, <<$rating[demand_rating[''madame_jofre'']]>>등급 이상 <b>성노예</b>로 데려와줘요. 당신 준비할 수 있는만큼, 일 할 여자를 데려와도 좋아요. 제가 <<common_price[demand_rating[''madame_jofre'']]>>스파크에 전부 고용하죠.</div>'
$jofre_pref[6] = '[안주인 조프리]<br>&nbsp;그리고... 순결한 여자는 특별대우 드려야겠죠?<br><b>처녀</b>를 데려오면 스파크를 더 지불하죠. 안넣고 교육하긴 더 복잡할테니까. 이 정도면 되겠네요. 보시다시피, 조건은 간. 단.</div>'
$buy_quote['madame_jofre'] = '[안주인 조프리]<br>&nbsp;좋아요 데려가죠. 고마워요, 스파크를 받아가요.<br><br> 얘야 네가 해줄일이 많단다.</div>'
$refuse_skill_quote['madame_jofre'] = '[안주인 조프리]<br>&nbsp;조건은요? 난 그런거 관심 없답니다.</div>'
$refuse_level_quote['madame_jofre'] = '[안주인 조프리]<br>&nbsp;더 나은 애 없나요? 값이 안 돼보이는데.</div>'
$refuse_charm_quote['madame_jofre'] = '[안주인 조프리]<br>&nbsp;흠.... 나도 모르겠군요. 일단 조건에 맞더라도, 행색이 좀?</div>'
$refuse_health_quote['madame_jofre'] = '[안주인 조프리]<br>&nbsp;체력도 안되는 애는 데려오지 말아줘요. 비켜주시죠, 바쁩니다.</div>'
$refuse_pregnant_quote['madame_jofre'] = '[안주인 조프리]<br>&nbsp;임신한 애를 데려다? 여긴 그런 영업 안해요.</div>'
$refuse_again_quote['madame_jofre'] = '[안주인 조프리]<br>&nbsp;또요? 이 아이는 필요 없다고 하지 않았나요? 다른 곳 알아보시죠.</div>'
! JO9 MOD END J9M2148
$buyer_demand['madame_jofre'] = {
	demand['min_stamina'] = 4
	demand['max_fat'] = 2
	demand['min_beauty'] = 3
}

$npc_image['brina'] = 'brina_the_red'
$npc_name['brina'] = '적발의 브리나'
$npc_status['brina'] = '라니스타<br>백색 도시 (중립파)'
$npc_alignment['brina'] = 'нейтралы'
$npc_info['brina'] = '<br> 브리나는 원래 단순한 여성 투사였다.<br><br> 하지만 언젠가 결투장에서 보여주었던 모습이 너무나 인상적 이었기에, 시민으로 신분 상승과 동시에 자유를 덤으로 얻었다.<br><br> 그래도 브리나는 콜로세움을 떠나지 않고, 노예나 여자들에게 경기장 싸움을 가르치고 있다. 이 여자는 웬만한 남성보다 강하다.'
demand_rating['brina'] = 4
$interesting_specialisation['brina'] = 'gladiatrix'

