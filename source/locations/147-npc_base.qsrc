! JO9 MOD START J9M2131 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$kagami_pref[1] = '[카가미 씨]<br>&nbsp;제 용건을 들어주시면 굉장히 기쁠겁니다, <<$master_name>>씨 들어 주시면, 필요한 몇가지 요구 사항을 안내 하겠습니다.</div>'
$kagami_pref[2] = '[카가미 씨]<br>&nbsp;제 고향에선 공손과 접대를 가장 귀히 여겨, 때문에 절 욕보이지 않았으면 좋겠습니다. 부디 잘 가르쳐주시길, <<$master_name>>씨. 그렇게 제게 베풀어주시면 됩니다.</div>'
$kagami_pref[3] = '[카가미 씨]<br>&nbsp;직원에게 있다 특정 몇 능력들이 필수적입니다. 반드시 고객과 <font color="#0000D8"><b>정중히 소통</b></font>하고, 가게를 완벽하게 <font color="#0000D8"><b>정리</b></font>할 줄 알아야 합니다. 당연히 식품점이니 만큼, <font color="#0000D8"><b>요리</b></font>와 <font color="#0000D8"><b>문서</b></font>도 다룰 줄 알아야 합니다.</div>'
$kagami_pref[4] = '[카가미 씨]<br>&nbsp;혹시 다른 능력을 꼽자면, 제 직원들이 <font color="#6b0084"><b>동작의 예절</b></font>과 <font color="#6b0084"><b>곡</b></font>을 배웠으면 더할 나위 없이 기쁠겁니다 <<$master_name>>씨. 직원에게 같은 말을 반복해 가르치고싶지 않사오니, <font color="#0000D8"><b>빨리 배웠으면</b></font> 좋겠습니다.</div>'
$kagami_pref[5] = '[카가미 씨]<br>&nbsp;그래만 주신다면 사적 교육은 따로 언급 않겠습니다. <<$master_name>>씨의 경험이 완벽히 이끄리라 믿고 있으니까요. 부디 다른 능력들이 우선 순위인 것을 유념하여 주십시오. 힘내주세요. <<$master_name>>씨.</div>'
! JO9 MOD END J9M2131


