    demand['notattoos'] = 1
    demand['max_fat'] ! 99
}

! JO9 MOD START J9M1868 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$anes_pref[1] = '[아네스]<br>&nbsp;자, 드셔 보세요, <<$master_name>>... 안 드시겠다고요? 아쉽네요. 음식은 삶이고, 훌륭한 음식은 놓쳐선 안 될 즐거움이에요. 자, 이 한 조각 드셔 보세요. 맛있죠? 하하, 걱정 마세요. 제 여자애들은 완벽한 보조가 되도록 훈련받았어요. 서빙 자체가 하나의 예술이거든요.'
! JO9 MOD END J9M1868

! JO9 MOD START J9M1867 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$anes_pref[2] = '[아네스]<br>&nbsp;물론 손님 중엔 포크질이 서툰 사람도 있고, 진짜 미식가들도 있죠. 그래서 전 언제나 새로운 보조들을 기꺼이 맞이해요, 친애하는 <<$master_name>>. 걱정 마세요, 일 얘기는 식사를 즐긴 뒤에 하죠.'
! JO9 MOD END J9M1867

! JO9 MOD START J9M1866 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$anes_pref[3] = '[아네스]<br>&nbsp;잘 들으세요… 난 거리에서 굴러온 지저분한 일꾼은 안 받아요. 내 보조들은 언제나 <font color="#008080"><b>매력적이고</b></font>, <font color="#008080"><b>다정하고</b></font>, <font color="#0000CD"><b>건강하고</b></font>, 몸도 잘 단련되어 있고, <font color="#008000"><b>보기 좋게 단정해야</b></font> 해요. 문신이나 피어싱은 사양이에요 — 이런 환경에선 깔끔함이 핵심이니까.'
! JO9 MOD END J9M1866

! JO9 MOD START J9M1865 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$anes_pref[4] = '[아네스]<br>&nbsp;나이요? 그건 중요하지 않아요 — 일은 누구에게나 있을 수 있으니까요. 잊지 마세요, 보조들은 <font color="#4B0082"><b>요리도 잘할 줄 알아야</b></font> 할 뿐 아니라 <font color="#0000CD"><b>가게를 깨끗하게 유지</b></font>해야 하고, 이상적으론 자기 <font color="#008080"><b>외모와 위생도 잘 관리</b></font>해야 해요. 더러운 잔에 와인을 따라 내고 싶진 않겠죠?'
! JO9 MOD END J9M1865

! JO9 MOD START J9M1864 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$anes_pref[5] = '[아네스]<br>&nbsp;그게 제 요구 조건의 전부예요. 유능한 보조들을 데려와 주세요. 그러면 제가 특별 손님들에게 내는 요리들로 당신을 즐겁게 해 드릴게요.'
! JO9 MOD END J9M1864



