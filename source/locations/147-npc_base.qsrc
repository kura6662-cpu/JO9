$don_bobrit_pref[1] = "[돈 보브릿]<br>&nbsp;나는 <<$slave_type_name[$interesting_specialisation['don_bobrit']]>> <<$rating[demand_rating['don_bobrit']]>>급 이상이 필요하네. <<common_price[demand_rating['don_bobrit']]>> 스파크 지불하겠소.</div>"
$buy_quote['don_bobrit'] = '[돈 보브릿]<br>&nbsp;좋아, 데려가도록 하겠어. 내 감사와 스파크를 받아가시지.<br><br> 날 충족시키길 기대해보지!</div>'
$refuse_skill_quote['don_bobrit'] = '[돈 보브릿]<br>&nbsp;이딴 조건도 안맞는 걸 어디에 쓰나?</div>'
$refuse_level_quote['don_bobrit'] = '[돈 보브릿]<br>&nbsp;훨씬 나은 여자가 필요해, 이런 급 안맞는 거 말고.</div>'
$refuse_charm_quote['don_bobrit'] = '[돈 보브릿]<br>&nbsp;흐음... 고민되는군. 형식상은 맞아, 형식상은. 형식만 맞아. 형태가 맞질 않아.</div>'
$refuse_health_quote['don_bobrit'] = '[돈 보브릿]<br>&nbsp;이런 빈약한 몸으로 내게 제대로 이바지나 할 것 같나? 좋게 말할때 나가시지!'
$refuse_pregnant_quote['don_bobrit'] = '[돈 보브릿]<br>&nbsp;그래서, 자네는 나에게 임신한 노예를 팔려고 하는 것인가? 절대 안돼!'
$refuse_again_quote['don_bobrit'] = '[돈 보브릿]<br>&nbsp;아닌건 아니야.</div>'
! JO9 MOD END J9M2121

