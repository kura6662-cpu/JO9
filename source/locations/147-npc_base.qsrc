$npc_status['johanna'] = '교황 이오안 1세의 비서<br>바티칸'
! JO9 MOD START J9M2137 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$npc_info['johanna'] = '   상냥해 보이는 성숙한 수녀다. 그녀는 교황 이오안 1세의 개인 비서지만, 명령은 드 뮈즐롱 추기경에게서 받는다. 친절한 태도 아래에, 당신은 어딘가 날카로운 면과 유능함의 기운을 느낀다. 노예이면서도 그녀는 너를 동등한 존재처럼 대한다.'
! JO9 MOD END J9M2137
npc_attitude['johanna'] = 12

$npc_image['cardinal_de_mujlon'] = 'cardinal_de_mujlon'
$npc_name['cardinal_de_mujlon'] = '제라르 드 뮈즐롱'
$npc_status['cardinal_de_mujlon'] = '추기경<br>바티칸'
$npc_alignment['cardinal_de_mujlon'] = 'нейтралы'
$npc_info['cardinal_de_mujlon'] = '   추기경치고는 매우 젊고 교활한 인물이다. 그는 교황의 오른팔 자리를 차지했다. 교황의 일정을 정하고, 누가 교황을 알현할 수 있는지 없는지를 결정하는 것도 그다.'
demand_rating['cardinal_de_mujlon'] = 8
$npc_preferences['cardinal_de_mujlon'] = {
	stat_importance['intellect'] = 5
	stat_importance['secretary'] = 5
	stat_importance['oral'] = 5
	stat_importance['penetration'] = 5
	stat_importance['petting'] = 5
}
$buyer_demand['cardinal_de_mujlon'] = {
	demand['noperversion'] = 1
}
! JO9 MOD START J9M2136 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$cardinal_de_mujlon_pref[1] = '[드 뮈즐롱 추기경]<br>&nbsp;그래 <<$master_name>>. 교황님, 그 분께 직접 상품을 보이고 싶다고? 자네가 훌륭한 노옐 구비했음에 여부는 없지만, 이해해주게...</div>'
$cardinal_de_mujlon_pref[2] = '[드 뮈즐롱 추기경]<br>&nbsp;자넨, 명색이 교황님께서 더 급한 용무를 보시리라 생각 않는건가? 글쎄... 교황님을 직접 보좌하는 수녀 정예 노예 부대에는 이미 공식 유통자가 있다네.</div>'
$cardinal_de_mujlon_pref[3] = '[드 뮈즐롱 추기경]<br>&nbsp;그럼 이렇게 하지. 내가 시범삼아 자네 일을 겪고, 교황님께 청을 얻어보도록 하지. 물론 내가 만족한다면. 날 <font color="#009900"><b>보좌</b></font>할 역이 필요해.</div>'
$cardinal_de_mujlon_pref[4] = '[드 뮈즐롱 추기경]<br>&nbsp;자네도 이미 깨달았듯, 여기까지 닿기엔 부동의 끈기와 <font color="#009900"><b>지적 능력</b></font>을 필요로 했겠지. 아무튼, 우리도 노예따위 것 필요를 납득하고는 있다. 난 <font color="#009900"><b>순수한 사랑 능력</b></font>을 보겠네.<br><b>이상성욕 없이</b>, 부탁하네.</div>'
$cardinal_de_mujlon_pref[5] = '[드 뮈즐롱 추기경]<br>&nbsp;반드시, 자네가 유념하고 또 받아들여야 할 것. 난 지불은 안 할거야. 교황님께로 닿는 길, 그게 네 포상. 그 분께도 스파크 같은 건 막연히도 기대말게. 자네가 교황님 후광을 얻고 싶은거라면, 참으로 걸작을 헌사해야 할거야.</div>'
! JO9 MOD END J9M2136

! JO9 MOD START J9M2135 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['cardinal_de_mujlon'] = '[드 뮈즐롱 추기경]<br>&nbsp;이건 또 뭐야? 아주 훌륭한 보좌관 아닌가! 내 집무실에 딱 이겠어. 자네 수고 댓가로 교황님 알현자릴 마련해 보지, <<$master_name>>..</div>'
$refuse_skill_quote['cardinal_de_mujlon'] = '[드 뮈즐롱 추기경]<br>&nbsp;저 여잔 내가 말했던 일 능력에 한 참 도 못 미치잖나. 저건 못 쓴다고, <<$master_name>></div>'
$refuse_level_quote['cardinal_de_mujlon'] = '[드 뮈즐롱 추기경]<br>&nbsp;나를 아주 잘 보필해줄 것 같군, <<$master_name>>. 헌데, 교황님께 닿을 등급엔 명확히 못 미쳐. 작업을 계속 시행하게.</div>'
$refuse_charm_quote['cardinal_de_mujlon'] = '[드 뮈즐롱 추기경]<br>&nbsp;감명이 없어. 능력은 되지만, 뭐랄까... 모르겠군. 자네가 상상해낼 만한 것이 아니야. 이걸론 난 교황님께 자넬 천예할 수 없겠네.</div>'
$refuse_health_quote['cardinal_de_mujlon'] = '[드 뮈즐롱 추기경]<br>&nbsp;끈기가 있어야 한다, 말 안했던가? 날 무시하고 이런 걸 가져왔음에도, 그냥 보내는 걸 감사히 알게.</div>'
$refuse_pregnant_quote['cardinal_de_mujlon'] = '[드 뮈즐롱 추기경]<br>&nbsp;사랑할 능력은 임신 상태를 말한게 아니야, <<$master_name>>.</div>'
