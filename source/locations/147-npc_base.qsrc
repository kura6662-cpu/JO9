! JO9 MOD START J9M2017 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Varvar_pref[1] = '[Varvar]<br>&nbsp;누가 왔나 봐라! <<$master_name>>! 네 얘기는 들었다. 노예 조련사지? 좀 약해 보이는군. 네 노예들이 널 패지는 않나? 아하하! 찡그리지 마! 농담이다.'
$Varvar_pref[2] = '[Varvar]<br>&nbsp;뭐, 그렇다는 거다! 난 내 "고양이들"을 사랑해, 씨발 정말 사랑하지. 그래서 그 애들을 잘 돌봐 줄 노예가 필요하다. 내 얘기를 해 주지. 여기서 존중받고 싶나? 그럼 내 "고양이들" 곁에 안심하고 풀어놔도 될 노예를 데려와라.'
$Varvar_pref[3] = '[Varvar]<br>&nbsp;아름다움은 중요하지 않다. 제일 중요한 건 가슴이 크고 젖이 나와야 한다는 거야. 안 그러면 내 "고양이들" 중 몇몇은 새끼들한테 젖을 안 물리거든. 그 여자가 대신해 줘야 해. <font color="#008080"><b>건강해야</b></font> 한다. 금방 죽어 버릴 고양이를 내가 왜 필요로 하겠나?!'
$Varvar_pref[4] = '[Varvar]<br>&nbsp;<font color="#008000"><b>비위도 강하고</b></font> <font color="#008080"><b>응급처치도 할 수 있어야</b></font> 하고, 필요하면 내 고양이 우리의 짐승들을 <font color="#008000"><b>상대해 줄</b></font> 수도 있어야지, 그렇지 않으면 걔들한테는 암컷이 부족하니까. 내 "고양이들"은 가끔 <font color="#0000CD"><b>놀기</b></font>를 좋아하거든. 그리고 <font color="#0000CD"><b>배불리 먹게</b></font> 하려고, 내가 질리면 걔들한테 먹이로 줄 거야 - 말하자면 폐기물 없는 생산이지!'
$Varvar_pref[5] = '[Varvar]<br>&nbsp;내 부탁이 네겐 불가능한 일은 아니겠지?! 그럼 난 네 노예를 기다리겠다! 제대로 된 걸 데려와라... 그러면 왕과의 만남을 주선해 주지.'
$buy_quote['Varvar'] = '[Varvar]<br>&nbsp;뭐야? 멀쩡한 여자잖아! 훌륭한 일이다, <<$master_name>>! 받겠다!'
$refuse_skill_quote['Varvar'] = '[Varvar]<br>&nbsp;필요한 걸 못 하는 여자들은 더 이상 들이밀지 마라.'
