	demand['artist'] = 1 &! require D- in dance, music or art
}

$npc_image['sergant'] = 'sergant'
$npc_name['sergant'] = '상사'
$npc_status['sergant'] = '군 부사관<br>타우루스 가문'
$npc_info['sergant'] = '<br> 상처 자국이 가득한 군인.<br><br>안개 구역 경계선에 있는 군막사의 책임자.<br><br>그와 병사들은 다른 세계로부터 오는 모든 위협을 막는 선봉대 역할을 하고있다.<br><br> 타락으로 물들여진 로마이지만, 적어도 이 부근을 지휘하고 있다는 것은 그가 상당한 능력과 성실성을 가지고 있다는 것을 유추할 수 있다.'
npc_attitude['sergant'] = 10
demand_rating['sergant'] = 1
count_size['sergant'] = 50
buying_temp['sergant'] = 25
$interesting_specialisation['sergant'] = 'witchdoctor'

! JO9 MOD START J9M2140 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$sergant_pref[1] = '[사관]<br>&nbsp;노예? 들어라, <<$master_name>>. 여긴 군막사지 창관이 아니다. 당신 눈으로 봐도 여기에 즐길 여유따윈 없어보일 것이다. 다만, 병사들을 치료해 다시 참전시킬 간호사는 필요하다</div>'
$sergant_pref[2] = '[사관]<br>&nbsp;전투 물약이 항상 부실했으니, 바로바로 필요한 약을 제조할 줄 아는 자에겐 기꺼이 지불하겠다. 내 개인 자금이 아닌, 용병 고용에 쓰이는 약간의 보조금으로 지불한다.</div>'
$sergant_pref[3] = '[사관]<br>&nbsp;등급은 고려 않겠다. 복종적이고 고심할 줄 아는, 치료 목적의 <font color="#0000D8"><b>마법과 연금</b></font> 능력자가 필요하다. 그럴시 즉시 <<common_price[demand_rating[''sergant'']]>> 스파크 지불하겠다.</div>'
$buy_quote['sergant'] = '[사관]<br>&nbsp;뭐, 데려간다. (<<common_price[demand_rating[''sergant'']]>>$) 받아라, 노예상. 이제 어서 로마로 복귀하길 권고한다. 여긴 안전하지 않다.</div>'
$refuse_skill_quote['sergant'] = '[사관]<br>&nbsp;우린 마법과 연금 능력자가 필요하다. 그런것엔 관심 없다.'
$refuse_level_quote['sergant'] = '[사관]<br>&nbsp;이런 하찮은 능력은 허용할 수 없다. <<common_price[demand_rating[''sergant'']]>> 스파크가 아쉬울 뿐이다. 액수에 적합한 상품이 필요하다.</div>'
$refuse_charm_quote['sergant'] = '[사관]<br>&nbsp;흐음... 능력들에 차질은 없다, 잘 훈련되고 노련해 보인다. 다만, 안개 괴물을 처음 대면했을 때, 발작을 일으킬 것처럼 생겼다는 것 뿐이다.</div>'
$refuse_health_quote['sergant'] = '[사관]<br>&nbsp;이런 몸은 막사가 아닌 병원으로 데려가라.</div>'
$refuse_pregnant_quote['sergant'] = '[사관]<br>&nbsp;출산은 막사가 아닌 바티칸에 데려가라.</div>'
$refuse_again_quote['sergant'] = '[사관]<br>&nbsp;내 시간을 허비토록 작정한 것인가, 노예상? 더 대응 않겠다.</div>'
! JO9 MOD END J9M2140

