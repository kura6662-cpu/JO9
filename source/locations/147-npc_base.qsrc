!SERPIS GREAT HOUSE
$npc_image['serpis_prince_first'] = 'serpis_president'
$npc_name['serpis_prince_first'] = '알타이르'
$npc_status['serpis_prince_first'] = '대통령<br>세르피스 가문 (반역파)'
$npc_alignment['serpis_prince_first'] = 'serpis'
$npc_info['serpis_prince_first'] = ' 세르피스 가문의 권력 구조는 혼잡하다.<br><br>당신이 알고 있는 건, 이 떠버리는 어느 부문에서도 강세가 없다는 것.<br><br> 그런데도 뱀자리의 정당한 주인이며 자산이 아주, 또, 아주, 엄청나게, 많다.<br><br> 때문에 의장의 하렘은 로마에서 월등함을 자랑한다.'
demand_rating['serpis_prince_first'] = 10
$npc_preferences['serpis_prince_first'] = {
	stat_importance['sensitivity'] = 3
	stat_importance['expression'] = 3
	stat_importance['oral'] = 4
	stat_importance['penetration'] = 5
	stat_importance['petting'] = 4
}
$buyer_demand['serpis_prince_first'] = {
}
! JO9 MOD START J9M2109 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$serpis_prince_first_pref[1] = '[의장 알타이르]<br>&nbsp;바티칸의 빌어먹을 놈들이 모든 임산부를 끌고가 독점하는걸 당신은 알고있나? 나는 그런 짓거리를 계속 방관하지 않을거야.</div>'
$serpis_prince_first_pref[2] = '[의장 알타이르]<br>&nbsp;하지만 어떤 이유에서인지 "아무리" 해봐도 출생시엔 모두 죽어. 그렇다고 포기하지는 않아. 우리가 이룰 것들을 생각하면 충분히 시도할만한 일이지. 네가 후환이 남지 않도록 잘 처리하면 말야. 물론 그럴테지?</div>'
$serpis_prince_first_pref[3] = '[의장 알타이르]<br>&nbsp;실험은 내가 해. 하지만 성공적인 임신엔 뭐가 꼭 필요한지 난 아는게 없으니 당신은, 너 뜻대로 그 노예를 준비해 둬. 듣기로는 다른 것들과 달리 당신은 고객 바램을 아주 파악한다고 들었어.</div>'
$serpis_prince_first_pref[4] = '[의장 알타이르]<br>&nbsp;내 부탁은, 그 여자가 다른 여자들과 <font color="#0000D8"><b>어울리며 교류</b></font>하는 것. 그리고 <font color="#0000D8"><b>감각적</b></font>이면 좋겠군, 조잡한거 말고. 난 거칠게 다듬어진 년들은 딱 질색이니까.</div>'
$serpis_prince_first_pref[5] = '[의장 알타이르]<br>&nbsp;당연히 성적 부분도 기대하고 있다. <font color="#009FEF"><b>입</b></font>, <font color="#009FEF"><b>손</b></font>, <font color="#009900"><b>몸</b></font> 재주가 필요해. 말 안해도 할테지만 뭐, 나머진 네 손에 맡기겠어. 기다리도록 하지!</div>'
$buy_quote['serpis_prince_first'] = '[의장 알타이르]<br>&nbsp;한눈에 알아보겠군, 딱 필요한 것. 하얀 웨딩드레스만 입히면 정말 완벽해. 고맙네 친구. 재무관이 스파크를 지급 할거야. 그리고 내겐 신혼여행이 기다리고 있거든.</div>'
$refuse_skill_quote['serpis_prince_first'] = '[의장 알타이르]<br>&nbsp;난 그리 까다로운 사람 아니야. 거의 요구한 게 없어. 그런데도 내 지시 무엇 하나 똑바로 해내질 못하는군. 날 실망시키지 마, <<$master_name>>. 내가 VIP 고객인 이상.</div>'
$refuse_level_quote['serpis_prince_first'] = '[의장 알타이르]<br>&nbsp;말해봐, 이 상품이 VIP 에 어울려 보이세요? 아니! 왜 내가 저 여자에 스파크를 내는데? 바라지 마.</div>'
$refuse_charm_quote['serpis_prince_first'] = '[의장 알타이르]<br>&nbsp;너 아냐, <<$master_name>>. 난 아름다운 여성을 볼 때, 웨딩드레스 입은 걸 상상해. 그래서 느낌 오면, 그게 내가 원하는 것. 하지만 아니야. 저 여자는 느낌이 안와.</div>'
$refuse_health_quote['serpis_prince_first'] = '[의장 알타이르]<br>&nbsp;고객 바람을 파악은 해도, 자기 노예 체력 파악은 못하나보군. 이런 장난질 할 시간에 어서 도망가는게 좋을걸!</div>'
$refuse_pregnant_quote['serpis_prince_first'] = '[의장 알타이르]<br>&nbsp;내가 할 실험을 네가 해오면, 난 무얼하지?</div>'
$refuse_special_quote['serpis_prince_first'] = '[의장 알타이르]<br>&nbsp;거절.</div>'
! JO9 MOD END J9M2109

$npc_image['pretor_diabaz'] = 'pretor_diabaz'
$npc_name['pretor_diabaz'] = '디아바즈'
$npc_status['pretor_diabaz'] = '법무관<br>세르피스 가문 (반역파)'
$npc_alignment['pretor_diabaz'] = 'serpis'
$npc_info['pretor_diabaz'] = ' 법무관의 역할은 매일 바티칸으로 스파크를 운송 하는 것이다.<br><br> 이 역할이 가문의 생존성에 치명적일 만큼 영향을 끼치기에, 법무관은 중대한 자들로만 선출한다.<br><br> 고로 비싼 노예를 판매할 수 있다.'
demand_rating['pretor_diabaz'] = 8
$interesting_specialisation['pretor_diabaz'] = 'gladiatrix'
$diary_mark['pretor_diabaz'] = "   <<$npc_name['pretor_diabaz']>>. 그와 알현하려면 세르피스 가문의 행정 첨탑으로 가야 한다."
$npc_preferences['pretor_diabaz'] = {
	stat_importance['expression'] = 3
	stat_importance['nurse'] = 3
	stat_importance['alchemy'] = 3
	stat_importance['enchanter'] = 3
	stat_importance['gladiatrix'] = 5
}
$buyer_demand['pretor_diabaz'] = {
	demand['min_stamina'] = 4
	demand['min_exotic'] = 4
}
! JO9 MOD START J9M2108 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$pretor_diabaz_pref[1] = '[법무관 디아바즈]<br>&nbsp;기뻐하라(Gaudete). <<$master_name>>. 단도직입적으로 말하겠소. 내 신변 용품을 보충했으면 싶소. 스파크를 소모해 어떻게든 퍼뜨리고 싶으니.</div>'
$pretor_diabaz_pref[2] = '[법무관 디아바즈]<br>&nbsp;잘 싸우는 계집종이 필요하겠소. 내 작전에 따라 나서길 겁내면 안될거요. 그리고 그, 우리 가문은 좀... 특이한 인상인 것을 자네도 알거요. 덕택에 우리를 두려워 하는 것이기도 하지만.</div>'
$pretor_diabaz_pref[3] = '[법무관 디아바즈]<br>&nbsp;그래서, 내가 필요한 여자는 <font color="#008080"><b>육체</b></font>적으로도 강하고, <font color="#008080"><b>특이한 인상</b></font>을 갖춰 주어야 겠소. 헤비볼터나 플라즈마 라이플을 들어도 멋져 보일 수 있게.</div>'
$pretor_diabaz_pref[4] = '[법무관 디아바즈]<br>&nbsp;그에 따라 <font color="#009900"><b>잘 싸우는</b></font> 것도 필수적일거요. 내가 매일 대치하진 않아도, 일이 위험할 건 마찬가지일 것이니. 난 함께하는 자가 누구든 뒤를 맡겨왔고, 뒤돌아 볼 생각한 적 없소.</div>'
$pretor_diabaz_pref[5] = '[법무관 디아바즈]<br>&nbsp;여자에 전장에서 <font color="#009FEF"><b>응급 처치</b></font>를 하달할 예정이니 <font color="#0000D8"><b>존재감</b></font>도 필요할거요. 나머진 노예상인 당신 경험에 맡겨두겠소. 날 만족시키면, 내가 당신 노고를 부디 가치있게 만들겠소.</div>'
! JO9 MOD END J9M2108

! JO9 MOD START J9M2107 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['pretor_diabaz'] = '[법무관 디아바즈]<br>&nbsp;그으으으으래, 이게 내가 바로 원하던 것! 그녀의 개성이 뚜렷이 빛나고 아주 인상깊게 생겼소. 심지어 위협적일 줄이야. 당신이 언급했 듯 잘 싸울줄만 알면, 더 바랄것이 없소. 당신 스파크를 받아가시오.</div>'
$refuse_skill_quote['pretor_diabaz'] = '[법무관 디아바즈]<br>&nbsp;아니야. 그녀 재량은 충분하지 못해. 난 이 여자가 해내지 못할것만 같소, 단 한 번의 고비에도. 난 물어볼 새 없이 그녀에 의지해야 할거요. 그러려면 더 많은 훈련이 필요하겠소.</div>'
$refuse_level_quote['pretor_diabaz'] = '[법무관 디아바즈]<br>&nbsp;맞소, 물론 멋진 여자요. 하지만 스파크 만큼 가치 있을까? 난 특별함을 언급했었소. 이 여자의 상은 뚜렷하지 않아.</div>'
$refuse_charm_quote['pretor_diabaz'] = '[법무관 디아바즈]<br>&nbsp;내가 그려오던 것과는 다른 인상. 나란히 서면 비웃음만 살 것이오. 이전에도 언급했 듯, 외관이 최고의 방어 수단이요. 다른 걸 찾아오시오. 더 인상깊은걸로.</div>'
$refuse_health_quote['pretor_diabaz'] = '[법무관 디아바즈]<br>&nbsp;전장에 필요한 건 보다 강인함. 내 강인함을 여기서 시험하지 않는게 좋을거요.</div>'
$refuse_pregnant_quote['pretor_diabaz'] = '[법무관 디아바즈]<br>&nbsp;임신한 노예. 허튼 수작 부리지 말고 어서 자릴 뜨는게 좋을거요.</div>'
$refuse_special_quote['pretor_diabaz'] = '[법무관 디아바즈]<br>&nbsp;나와는 맞지 않소. 내 특별 조건에 달하지도 않고. 판결 종료요, <<$master_name>>.</div>'
! JO9 MOD END J9M2107

$npc_image['bishop_porter'] = 'bishop_porter'
$npc_name['bishop_porter'] = '포터 신부'
$npc_status['bishop_porter'] = '대주교<br>세르피스 가문 (반역파)'
$npc_alignment['bishop_porter'] = 'serpis'
$npc_info['bishop_porter'] = ' 대주교란 이름이지만, 종교적인 영향력을 가진 호칭이 아닌, 전통적인 계승에 따른 일이다.<br><br> 포터 신부는 가문의 신전 관리를 책임지고 있으며, 그 신전들에서 매일 종교 의례를 치룬다.<br><br> 의례중 스파크를 불태움으로써, 가문 집들에 안개가 붙지 않도록 보호한다.'
demand_rating['bishop_porter'] = 8
$interesting_specialisation['bishop_porter'] = 'servant'

$npc_preferences['bishop_porter'] = {
	stat_importance['intellect'] = 3
	stat_importance['ego'] = 3
	stat_importance['expression'] = 5
	stat_importance['oral'] = 4
	stat_importance['petting'] = 4
}
$buyer_demand['bishop_porter'] = {
	demand['refuse_age'] = 1
	demand['virginity'] = 1
}
! JO9 MOD START J9M2106 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$bishop_porter_pref[1] = '[대주교 포터]<br>&nbsp;난 군인이 아님에도 내 일은 여전히 위험에 시달리고 있다, <<$master_name>>. 온 가문의 위험을 감당하는 단 하나의 대주교, 그건 매우 중요한 것. 내게 무슨일이 일어나면, 머지않아 세르피스 가문 전체가 안개에 흡수될테지.</div>'
$bishop_porter_pref[2] = '[대주교 포터]<br>&nbsp;그런 나를 해하려는 자객들을 혼란주기 위해, 나로 둔갑한 가짜를 쓰곤해. 자주. 그 수준은 매우 높아. 그런 가짜를 준비하려면 당신같은 숙련자가 필요했어.</div>'
$bishop_porter_pref[3] = '[대주교 포터]<br>&nbsp;입지 조건은, 변장의 달인이며 <font color="#009900"><b>대화에 교양이</b></font> 있어야 해. 내 행세를 하려면, 여자가 <font color="#0000D8"><b>총명하고</b></font> <font color="#0000D8"><b>강한 잣대</b></font>를 가져야 하지.</div>'
$bishop_porter_pref[4] = '[대주교 포터]<br>&nbsp;너무 <b>어려</b>서도 안될테고, 십중팔구 내 체형과 닮아야지. 그래 또... 그녀 <b>순결</b>을 빼앗으려 시도는 말아. 내 행세가 더럽혀진 느낌을 받긴 싫으니.</div>'
$bishop_porter_pref[5] = '[대주교 포터]<br>&nbsp;그 여자는 분명 다정하고 감각적일거야, 거반의 남성과 달리. 네가 타인의 말마따나 진짜 전문가라면, 그런 여자가 <font color="#009FEF"><b>손</b></font>과 <font color="#009FEF"><b>혀</b></font>를 능숙히 다루도록 하는 정돈 해내올테지.</div>'
$buy_quote['bishop_porter'] = '[대주교 포터]<br>&nbsp;척 봐서는... 날 닮진 않지만, 화장에 가발, 옷만 입혀두면 쓸만 하겠어. 완벽히 교육된 것 역시 중요한 부분이야. 기쁘구나, <<$master_name>>. 사례를 받아가도록 해.</div>'
$refuse_skill_quote['bishop_porter'] = '[대주교 포터]<br>&nbsp;내 소망을 나름 세밀히 표현했다 생각했거늘, 나의 착각이었나? 저딴게 뭐가 되었든 사례는 않겠어. 이 저급한 가짜가 날 종말로 이끌거야. 이건 나와 어울리지 않아.</div>'
$refuse_level_quote['bishop_porter'] = '[대주교 포터]<br>&nbsp;난 확실한 수준의 여자가 필요해, <<$masteR_name>>. 난 과불은 않으니 이런 가소로운 것은 데려오지 말아. 그게 흠잡을 곳 없는 때에서야 내게 다시 찾아와. 그럼 스파크를 지불하지.</div>'
$refuse_charm_quote['bishop_porter'] = '[대주교 포터]<br>&nbsp;아니, 아니야. 모든 용모가 나와 다르잖아. 어떤 노심을 해도 절대 나와같지 않을거야. 데려가지 않겠어. 다른 사람을 찾는것이 좋겠어, <<$masteR_name>>.</div>'
$refuse_health_quote['bishop_porter'] = '[대주교 포터]<br>&nbsp;나는 보기보다 꽤 훤칠한 편이지, 매끈하고. 이런 약골 나부랭이가 내 변장이 가당키나 하겠어? 죽고싶지 않으면 빨리 나가!</div>'
$refuse_pregnant_quote['bishop_porter'] = '[대주교 포터]<br>&nbsp;네녀석은 내가 더럽혀지길 원하는가? 그 더러운 고깃덩일 치워버려!</div>'
$refuse_special_quote['bishop_porter'] = '[대주교 포터]<br>&nbsp;그런 노예는 필요가 없어. 내 요구가 까다롭던가? 그딴건 필요 없으니 꺼져.</div>'
! JO9 MOD END J9M2106

$npc_image['general_drago'] = 'general_drago'
$npc_name['general_drago'] = '드라고 장군'
$npc_status['general_drago'] = '총사령관<br>세르피스 가문 (반역파)'
$npc_alignment['general_drago'] = 'serpis'
$npc_info['general_drago'] = ' 혐오스러운 이 장군은 잔인하기로 유명하다.<br><br> 동시에 그의 산하 군인들에게 전적으로 헌신한다고도 알려져있다.<br><br> 세르피스 가문의 군인은 중세의 잔인함과 스파크 연료의 기이한 신공학 무기로 무장한다.<br><br> 드라고 장군은 마치 군주처럼 이 부대를 통솔한다.'
demand_rating['general_drago'] = 8
$interesting_specialisation['general_drago'] = 'gladiatrix'
$diary_mark['general_drago'] = "   <<$npc_name['general_drago']>>. 그와 알현하려면 세르피스 가문의 행정 첨탑으로 가야 한다."
$npc_preferences['general_drago'] = {
	stat_importance['temper'] = 4
	stat_importance['gladiatrix'] = 5
	stat_importance['orgy'] = 5
	stat_importance['xenophily'] = 3
	stat_importance['fetishism'] = 3
}
$buyer_demand['general_drago'] = {
}
! JO9 MOD START J9M2105 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$general_drago_pref[1] = '[드라고 장군]<br>&nbsp;장군의 힘이 무엇인지 아는가, <<$master_name>>? 바로 군사. 그 군사의 힘이 무엇인지 아는가, <<$master_name>>? 그들의 충성심. 병사들이 네 일에 충성하면 무엇이든 이루어낼 수 있지, 적군이 대항할 기회조차 없이.</div>'
$general_drago_pref[2] = '[드라고 장군]<br>&nbsp;그럼 병사를 일반인과는 다르게 만드는 것은 무엇인가? 그들을 지휘하는 자들은 어떻게 그 충성심을 격려해왔는가? 좋은 와인 그리고 여자. 이런 소박한 것들이 나를 따르게 하는데엔 충분하지.</div>'
$general_drago_pref[3] = '[드라고 장군]<br>&nbsp;그래서 내가 병사들에게 호언장담해둔 것이 있지... 그 너저분한 군인들에게 교황도 탐낼만한 여성을 안겨 주리라. 스파크는 걱정말게, 난 포상하는 법을 알고 있으니.</div>'
$general_drago_pref[4] = '[드라고 장군]<br>&nbsp;품위있는 여자도 나쁘진 않겠지만, 자네가 데려와야 할 여자는 <font color="#009900"><b>군사들</b></font>을 상대 하는가를 알아야지. 빠짐없이 모조리 황홀하게. 아마 <font color="#0000D8"><b>말이나 개</b></font>들 처럼 <font color="#0000D8"><b>비상식적</b></font>인 성행위도 하게 될테지.</div>'
$general_drago_pref[5] = '[드라고 장군]<br>&nbsp;주요 사항으론 <font color="#009900"><b>적극적인</b></font> 여자면 더 좋겠군, 흐느적대지 말고. 또 추가로 <font color="#009900"><b>싸움에 숙달</b></font>되면 좋겠고. 녀석들은 강제로 진흙탕에 던져두고 싸우게 만들지. 승자는 하루 휴식이 주어지고 말야. 그러니 그 계집이 싸움을 철저히 하도록 만들어!</div>'
! JO9 MOD END J9M2105

! JO9 MOD START J9M2104 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['general_drago'] = '[드라고 장군]<br>&nbsp;끗발있는 년이로군, <b>그렇지들 않나?!</b> 마치 그 여왕같은 자태로 내 병사들을 만족시켜줘야 할테지. 훤히 보이는군, 발정난 여단급 병사들을 상대하며 희락에 젖은 모습이. 우리가 자네 여자를 데려가지, <<$master_name>>. <b>경례!</b></div>'
$refuse_skill_quote['general_drago'] = '[드라고 장군]<br>&nbsp;내 병사가 막사하나 못 세우면, 그 땐 우리가.... 좀 가르침을 주지. 처음이니 가르치지 않고 충고하건대, 말한 여자가 아니면 데려오지 않는게 좋아.</div>'
$refuse_level_quote['general_drago'] = '[드라고 장군]<br>&nbsp;상급수의 여자만 데려오라 말 했을텐데, <<$master_name>>. 이런 선창걸레 말고. 이런 년들은 어느 창관에 가더라도 먹을수 있고, 그 계집은 후져. 가 임마!</div>'
$refuse_charm_quote['general_drago'] = '[드라고 장군]<br>&nbsp;저 년 문제있나? 무얼하든 내 병사들 질병이나 주게 생겼어. 난 그러길 전혀 원치않아. 다른 걸 가져와.</div>'
$refuse_health_quote['general_drago'] = '[드라고 장군]<br>&nbsp;그리 나약해서 한 소대는 상대하겠나? 다른 걸 가져오지 그래.</div>'
$refuse_pregnant_quote['general_drago'] = '[드라고 장군]<br>&nbsp;그래, 임신한 걸 내 병사들에 떠맡기고 스파크만 챙기시겠다? 새로 내세운 자네 전략인가?</div>'
$refuse_special_quote['general_drago'] = '[드라고 장군]<br>&nbsp;이미 받지 않겠다고 전했다만. 아니면, 새길 수 있도록 두쪽 알 잘라주길 바라나?</div>'
! JO9 MOD END J9M2104

