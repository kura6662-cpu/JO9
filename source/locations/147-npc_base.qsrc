! JO9 MOD START J9M1889 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$ImperatorGay_pref[1] = '[황제 가이우스]<br>&nbsp;글쎄, <<$master_name>>. 내 아래서 반쯤 죽은 몸으로 버둥거리는 저게 보이나? 황제 가이의 장난감답게 굴지 못한다면, 저년은 내일까지 살아 있지 못할지도 모른다. 그리고 그 자리를 메울 새 창녀가 필요해지겠지... 그래서 네가 여기 있는 거다.'
$ImperatorGay_pref[2] = '[황제 가이우스]<br>&nbsp;난 대단한 걸 원하는 게 아니다. 최고면 충분하다. 그냥 네가 찾을 수 있는 것 중 가장 뛰어난 노예를 내게 찾아와 훈련시켜라.'
$ImperatorGay_pref[3] = '[황제 가이우스]<br>&nbsp;물론 그녀는 <font color="#008000"><b>완벽한 창녀</b></font>여야 한다. <font color="#008000"><b>손</b></font>과 <font color="#008000"><b>입</b></font>. <font color="#008000"><b>아래 구멍들도 제 구실을 해야 한다.</b></font> 하지만 뭘 굳이 설명하겠나, 당신은 이미 알고 있잖아!.'
$ImperatorGay_pref[4] = '[황제 가이우스]<br>&nbsp;하지만 난 그저 <font color="#0000CD"><b>아름답기만 한</b></font>, 영혼 없는 인형이 필요한 게 아니다.'
$ImperatorGay_pref[5] = '[황제 가이우스]<br>&nbsp;난 <font color="#0000CD"><b>말이 통하고</b></font> <font color="#0000CD"><b>자기 개성도 보일 줄 아는</b></font> 여자애가 필요하다. 그러니까 전반적으로 <font color="#0000CD"><b>영리하고</b></font>, <font color="#0000CD"><b>강인하고</b></font>, 뚱뚱하지 않으며, 약간 <font color="#0000CD"><b>이국적인</b></font> 여자 말이다. 하지만 물론, 제 자리는 알아야지.'
$ImperatorGay_pref[5] = '[황제 가이우스]<br>&nbsp;펠라게야가 이 일에 대해 어떻게 느끼는지 알고 싶나?... 아, 전혀 아니야!... 그녀가 내 아내 자리를 유지하는 건, 그녀 아들인 내 양자들이 어느 시점까지는 자기 어머니가 그저 평범한 궁정 창녀였다는 걸 알면 안 됐기 때문이지. 이제 그들도 전부 알게 됐고, 펠라게야는 언제든 그 지위를 잃을 수 있다. 그러니 그녀에 대해선 생각도 하지 마라!'
$ImperatorGay_pref[6] = '[황제 가이우스]<br>&nbsp;그냥 내게 맞는 여자 하나를 데려와라. 내가 직접 보고, 마음에 들면 네게 빚을 지지.'
$buy_quote['ImperatorGay'] = '[황제 가이우스]<br>&nbsp;축하한다, <<$master_name>>. 네가 로마 황제에게 어울리는 노예를 길러 냈구나. 보상은 금고지기에게서 받아 가면 된다.'
$refuse_skill_quote['ImperatorGay'] = '[황제 가이우스]<br>&nbsp;안 된다. 너무 서툴렀다. 다시는 이런 실수를 하지 마라, <<$master_name>>.'
$refuse_level_quote['ImperatorGay'] = '[황제 가이우스]<br>&nbsp;황제조차 S+ 등급을 못 누린다면 그게 무슨 의미가 있지? 난 최고 품질의 노예가 필요하다. 분명히 말하지 않았나?'
$refuse_charm_quote['ImperatorGay'] = '[황제 가이우스]<br>&nbsp;수고는 인정하지. 그리고 이런 여자애라면 아마 별 문제 없이 다른 구매자를 찾을 수도 있겠지. 하지만 난 받지 않겠다. 마음에 안 든다. 변덕이라고 불러도 좋다.'
$refuse_health_quote['ImperatorGay'] = '[황제 가이우스]<br>&nbsp;당장 데려가라. 그리고 뭐가 문제인지 네가 직접 알아내라!'
$refuse_pregnant_quote['ImperatorGay'] = '[황제 가이우스]<br>&nbsp;도대체 네 머릿속에 뭐가 들어 있었기에, <<$master_name>>, 황제가 출처도 알 수 없는 임신한 여자를 후궁으로 받아들일 거라 생각한 거지?!'
$refuse_special_quote['ImperatorGay'] = '[황제 가이우스]<br>&nbsp;안 된다! 이 여자애는 적합하지 않다.'
! JO9 MOD END J9M1889

