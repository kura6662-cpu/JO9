$npc_image['magister_vailos'] = 'magister_vailos'
$npc_name['magister_vailos'] = '술사 발리오스'
$npc_status['magister_vailos'] = '강령술사<br>코르부스 가문'
$npc_info['magister_vailos'] = '   코르부스 가문의 가장 강력한 강령술사들 중 하나로, 네가 아는 한 안개 악마의 생리학 연구 분야 작업에 매달려 있다. 악마들이 어떻게든 물질 보존 법칙을 무시한 채 공허에서 무한한 양의 정액을 만들어 내는 데 성공한다는 점을 감안하면, 로마의 많은 학자들이 악마 연구에 관심을 보이고 있다.'
npc_attitude['magister_vailos'] = 11

