stat_importance['sensitivity'] > 3
stat_importance['temper'] > 3
stat_importance['pet'] > 3
stat_importance['calisthenics'] > 3
stat_importance['music'] > 2
stat_importance['oral'] > 4
stat_importance['penetration'] > 4
stat_importance['petting'] > 4
stat_importance['orgy'] > 4
stat_importance['roleplay'] > 3
}
npc_attitude['Isyagay'] = 30
npc_reveal['Isyagay'] = 1
npc_bennies['Isyagay'] = 8
npc_reward['Isyagay'] = 200
npc_advance['Isyagay'] = 150
demand_rating['Isyagay'] = 8
buying_temp['Isyagay'] = 25
