$npc_image['Megera'] = 'Megera'
$npc_name['Megera'] = '메게라'
$npc_status['Megera'] = '(중립파)'
$npc_alignment['Megera'] = 'russiankvartal'
$npc_info['Megera'] = '타티야나는 부유한 영지를 물려받았다. 하지만 불행하게도 그녀는 자기 하녀 바랴를 애지중지하는 멋진 젊은 남자에게 짝사랑에 빠지고 말았다. 그 젊은 커플을 갈라놓기 위해 그녀가 그 여자애에게 무슨 계략을 꾸미지 않았겠는가. 하지만 전부 소용없었다. 이제 그녀는 그 경쟁자를 세상에서 지워 버리기로 마음먹었고, 그래서 여자애들은 그녀에게 메게라라는 별명을 붙였다...'
demand_rating['Megera'] = 4
$interesting_specialisation['Megera'] = 'gladiatrix'
$diary_mark['Megera'] = " <<$npc_name['Megera']>>. 러시아 구역에 산다."
! JO9 MOD START J9M2043 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Megera_pref[1] = "[메게라]<br>&nbsp;너희 같은 년들은 도무지 통제가 안 돼! 하지만 내가 이 세상을 너희에게 지옥으로 만들어 주겠어! 채찍질해 줄 테다!... 그런데 당신은 뭘 원하지, <<$master_name>>?!... 싸울 줄 아는 여자애면 충분해, 등급은 <<$rating[demand_rating['Megera']]>> 이상. 그리고 <<common_price[demand_rating['Megera']]>> 스파크면 비싼 것도 아니지. 그러니 어서 가서 그 여자애를 준비시켜!"
! JO9 MOD END J9M2043
!$Megera_pref[2] = " [Megera]
- You can train me a fighting girl who won't be afraid to use the rod, if necessary, to teach a lesson to silly fools like these two, and who is capable of biting out the throats. I want everyone to be afraid of her and walk around like silk! How do you rate your skill level there?... Yeah... A rank of <<$rating[demand_rating['Megera']]>> or higher will be enough. And the <<common_price[demand_rating['Megera']]>> sparks aren't that big expenses. So, come on, get the girl ready!"
! JO9 MOD START J9M2042 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['Megera'] = '[메게라]<br>&nbsp;좋아, 그녀를 받겠다. 여기 네 스파크다, 그리고 고맙다. 내 마음에 들었으면 좋겠군!'
$refuse_skill_quote['Megera'] = '[메게라]<br>&nbsp;해야 할 일을 해낼 수 없는데 내가 왜 그녀를 필요로 하지? 그런 상품엔 관심 없다.'
