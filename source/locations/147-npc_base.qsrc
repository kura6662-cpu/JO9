$buy_quote['lady_edna'] = '[레이디 에드나]<br>&nbsp;제가 데려가지요, 스파크와 내 감사를 받아요.<br><br>네가 날 충족시켜 줄거란다!</div>'
$refuse_skill_quote['lady_edna'] = '[레이디 에드나]<br>&nbsp;능력 부족이잖아요? 쓸 수 있는 아이를 데려오세요.</div>'
$refuse_level_quote['lady_edna'] = '[레이디 에드나]<br>&nbsp;더 나은 여자 없어요? 급치고 너무 비싼거 같은데.</div>'
$refuse_charm_quote['lady_edna'] = '[레이디 에드나]<br>&nbsp;음... 느낌이, 느낌이 별로에요. 뭐랄까, 끌리질 않네요.</div>'
$refuse_health_quote['lady_edna'] = '[레이디 에드나]<br>&nbsp;빈약한 신체로 뭘 시키겠어요? 좋은 말로할 때 나가시죠!</div>'
$refuse_pregnant_quote['lady_edna'] = '[레이디 에드나]<br>&nbsp;네, 그러니 임신한 걸 사고, 나보고 바티칸에 되넘기라구요?</div>'
$refuse_again_quote['lady_edna'] = '[레이디 에드나]<br>&nbsp;싫다면 싫은 거에요!</div>'
! JO9 MOD END J9M2113

