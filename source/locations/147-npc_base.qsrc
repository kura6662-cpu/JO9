! JO9 MOD START J9M1863 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Konstantin_pref[1] = '[콘스탄틴]<br>&nbsp;자, 안녕하신가, <<$master_name>>... 우리 클럽에 들어오고 싶다면서?! 하지만 우린 아무나 받지 않아... 먼저 네 전문성을 증명해 봐라...'
$Konstantin_pref[2] = '[콘스탄틴]<br>&nbsp;네가 여자애들을 잘 훈련시킨다는 얘길 들었다. 그렇다면 내 요구도 놀랍진 않겠지. 난 클럽을 위한 특별한 노예 하나를 들이고 싶다. 그녀는 강하고 <font color="#008080"><b>튼튼해야</b></font> 해. 어디에 써먹게 될지는 누가 알겠나...'
$Konstantin_pref[3] = '[콘스탄틴]<br>&nbsp;또 <font color="#0000CD"><b>예절 훈련도 되어 있어야</b></font> 한다. 내 손님들은 무례한 여자애들과 어울리는 걸 좋아하지 않거든. 그리고 말만이 아니라 때론 섹스도 해야 할 수 있으니, 감도도 좋아야 해. 펠라, 애무, 섹스, 전부 최고 수준이어야 하지!'
$Konstantin_pref[4] = '[콘스탄틴]<br>&nbsp;영혼 없는 로봇 따위는 필요 없다. 그러니 교양도 갖추게 해라. 계산도 할 줄 알고 글도 쓸 줄 알아야 하며, 필요하다면 손님들을 즐겁게도 할 수 있어야 한다 — 노래를 하든, 즉흥적으로 뭔가를 하든. 춤추는 걸 즐길 수도 있겠지!... 나머지는 네게 맡긴다.'
$Konstantin_pref[5] = '[콘스탄틴]<br>&nbsp;그런 노예를 준비해 오면, 기꺼이 우리 클럽에 받아 주지. 그건 곧 로마 최고의 창녀들, 도시에서 가장 고급스러운 오락과 파티가 네 것이 된다는 뜻이다. 그러니 서둘러라!'
$buy_quote['Konstantin'] = '[콘스탄틴]<br>&nbsp;잘했다! 딱 내가 꿈꾸던 거다! 돈과 명예 회원 카드는 루크레치야에게서 받아라.'
$refuse_skill_quote['Konstantin'] = '[콘스탄틴]<br>&nbsp;날 실망시키지 마라, <<$master_name>>. 얘는 아무것도 못 하잖아! 필요 없다!'
! JO9 MOD END J9M1863

! JO9 MOD START J9M1862 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_level_quote['Konstantin'] = '[콘스탄틴]<br>&nbsp;네가 이런 상품을 직접 받겠나? – 아니겠지! 그러니 내가 요구한 걸 가져와라!'
! JO9 MOD END J9M1862

! JO9 MOD START J9M1861 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_charm_quote['Konstantin'] = '[콘스탄틴]<br>&nbsp;있잖나, <<$master_name>>... 예쁜 여자애인 건 맞다. 하지만 내가 원한 애는 아니야...'
! JO9 MOD END J9M1861

! JO9 MOD START J9M1860 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_health_quote['Konstantin'] = '[콘스탄틴]<br>&nbsp;겉모습을 보니 건강하지 못해 보여... 난 절대 원치 않는다.'
! JO9 MOD END J9M1860

! JO9 MOD START J9M1859 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_pregnant_quote['Konstantin'] = '[콘스탄틴]<br>&nbsp;왜 임신한 여자애를 데려온 거지?! 미쳤나?!'
! JO9 MOD END J9M1859

! JO9 MOD START J9M1858 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
