$quinta_pref[1] = '[세르빌리아 퀸타]<br>&nbsp;우선 확실히 말씀드리죠, <<$master_name>>. 전 제 일에 매우 진지하게 임하고 있고, 다른 직원도 마찬가지로 따랐으면 하니 잘 들어주세요. 전 제 직원들에 직접 재봉을 가르쳐요, 그걸 도와주셨으면 하는데. 등급은 <<$rating[demand_rating["servilia_quinta"]]>>면 충분해요.</div>'
$quinta_pref[2] = '[세르빌리아 퀸타]<br>&nbsp;당신 결과물이 상벌에 개의치않고 아주 효율적으로 일 했으면 좋겠어요. 전 관리감독은 안하니까, 직접 <b>당신</b>이 잘 훈련된 직원을 데려왔음 하는군요. 애들은 <font color="#6b0084"><b>확실히 조용</b></font>히 만드세요. 성질 터뜨리고 다니는 애들은 다른 직장 알아보는게 좋아요.</div>'
! JO9 MOD END J9M2129
$quinta_pref[3] = '[세르빌리아 퀸타]<br> 특이해도 상관은 없어요, 그건 감점 요인이 아니에요. 여기 고객은 여자나 힐끔대러 오는게 아니니까 <font color="#EA0090""><b>눈 버리지만 않게</b></font> 해 주세요. 정작 중요한 건, 무거운 원단 갖고도 일 할 <font color="#0000D8"><b>충분한 체력</b></font>, 섬세한 작업에 맞는 <font color="#0000D8"><b>예민한</b></font> 손놀림. 거기에 손님들을 대처할 <font color="#0000D8"><b>화술</b></font>도.</div>'
! JO9 MOD START J9M2128 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$quinta_pref[4] = '[세르빌리아 퀸타]<br>&nbsp;<font color="#0000D8"><b>문해력</b></font>이 있으면 <font color="#6b0084"><b>다양한 지식</b></font> 교육에 도움이 되죠. 그래야 옷을 어떻게 자를지 알테니까요. 또 직원들과 같이 살 예정이니, 집안일을 했으면 좋겠네요. <font color="#6b0084"><b>집정리와 요리</b></font> 기술도 정도껏 익혀주세요.</div>'
$quinta_pref[5] = '[세르빌리아 퀸타]<br>&nbsp;거기에 사적인 관계는 허용 안할거에요, 특히 남자랑은. 그러니 <font color="#6b0084"><b>서로가 만족</b></font>시킬 교육을 해서, 작업중 야한 잡념에 방해 않게 해주세요. 이 정도면 되겠네요.</div>'
! JO9 MOD END J9M2128

$npc_image['estelindel'] = 'estelindel'
