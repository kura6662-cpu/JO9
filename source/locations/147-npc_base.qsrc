$Voland2_pref[1] = '[볼란드]<br>&nbsp;오, 왔군! 네 얘기는 들었다, <<$master_name>>. 내 친구 몇이 널 훌륭한 노예 조련사라고 추천했지. 알다시피 영원한 삶에도 단점은 있다. 모든 게 지루해져. 역겹도록 물리게 되지.'
$Voland2_pref[2] = '[볼란드]<br>&nbsp;그래서 내 여흥에 변화를 좀 주고 싶다. 새롭고, 색다른 게 필요해. 지금 시장에 나와 있는 건 전부 마음에 안 들어. 요즘 로마의 조련사들은 게을러져서 맨날 뻔한 길만 따라가거든.'
$Voland2_pref[3] = '[볼란드]<br>&nbsp;내 요구를 완벽히 충족하는 노예를 하나 데려와라. 난 난교를 좋아하니, 그 자리에 참여할 자들을 <font color="#008000"><b>성적으로 상대하고</b></font> 흥분시킬 수 있어야 한다. 또 <font color="#008080"><b>건강해야</b></font> 해. 내 오락은 며칠씩 이어질 수도 있으니까.'
$Voland2_pref[4] = '[볼란드]<br>&nbsp;<font color="#008080"><b>아름다워야</b></font> 한다. 보고 나서 얼굴을 잘라 버리고 싶어지지 않을 정도로. 그리고 <font color="#0000CD"><b>예의 바르고</b></font> <font color="#008000"><b>열정적이어야</b></font> 한다. 아, 그리고 난 피어싱 같은 건 질색이다. 그러니 노예 몸에 쓸데없는 게 달려 있으면 바로 도살자에게 넘겨라. 또 하나, 내 사랑, 그녀는 <font color="#008080"><b>똑똑해야</b></font> 한다.'
$Voland2_pref[5] = '[볼란드]<br>&nbsp;열정이 오르면 사람들은 말을 너무 많이 하지. 하지만 난 누가 무슨 생각을 하는지 듣는 게 아주 흥미롭다. 그런 걸 하나 준비해 온다면, 당신은 내게서 영예와 찬사를 받게 될 것이고, 위쪽에도 좋게 말해 두겠다.'
$buy_quote['Voland'] = '[볼란드]<br>&nbsp;만족스럽군, <<$master_name>>. 네 스파크를 받게 될 거다.'
$refuse_skill_quote['Voland'] = '[Voland]<br>&nbsp;내가 내 바람을 충분히 분명하게 말했다고 생각했는데, 아니었나? 이런 서투른 것에게 돈을 낼 생각은 없다. 이건 안 된다.'
$refuse_level_quote['Voland'] = '[Voland]<br>&nbsp;내게는 일정한 수준의 노예가 필요하다, <<$master_name>>. 그녀가 진짜로 흠잡을 데 없어졌을 때 다시 와라. 그러면 네 스파크를 주겠다.'
$refuse_charm_quote['Voland'] = '[Voland]<br>&nbsp;아니, 아니. 그녀는 받지 않겠다. 더 나은 걸 찾아와라, <<$master_name>>.'
$refuse_health_quote['Voland'] = '[Voland]<br>&nbsp;날 봐라, <<$master_name>>. 내가 정말 네 노예처럼 저렇게 병약하고 무기력해 보이기라도 하나?!'
$refuse_pregnant_quote['Voland'] = '[Voland]<br>&nbsp;<<$master_name>>, 네가 내게 임신한 계집을 데려왔군. 그냥 꺼져라. 나중에 다시 생각이나 해 봐.'
$refuse_special_quote['Voland'] = '[Voland]<br>&nbsp;내게는 그런 건 필요 없다. 특별 요구 조건을 기억하는 게 그렇게 어렵나?'
! JO9 MOD END J9M2018
   
   
