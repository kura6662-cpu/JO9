$VERWOLF_pref[1] = "[베르볼프]<br>&nbsp;나는 <<$slave_type_name[$interesting_specialisation['VERWOLF']]>> 전공의 <<$rating[demand_rating['VERWOLF']]>> 등급 이상이 필요해. <<common_price[demand_rating['VERWOLF']]>> 스파크를 낼게."
$buy_quote['VERWOLF'] = '[베르볼프]<br>&nbsp;좋아, 그녀를 받겠다. 여기 네 스파크다, 고맙다. 내 마음에 들었으면 좋겠군!'
$refuse_skill_quote['VERWOLF'] = '[베르볼프]<br>&nbsp;해야 할 일을 해낼 수 없는데 내가 왜 그녀를 필요로 하지? 그런 상품엔 관심 없다.'
$refuse_level_quote['VERWOLF'] = '[베르볼프]<br>&nbsp;더 나은 여자애를 찾을 수 없나? 그 값어치를 못 한다.'
$refuse_charm_quote['VERWOLF'] = '[베르볼프]<br>&nbsp;흠… 모르겠군. 형식상으론 맞지만, 너무 볼품없어 보여. 매력도 부족해.'
$refuse_health_quote['VERWOLF'] = '[베르볼프]<br>&nbsp;뭘 나한테 팔아넘기려는 거지? 얘는 병약해 보이고, 이 일에 쓸 만큼 튼튼해 보이지도 않는다. 당장 산산조각 나지 않으면 다행이겠군!'
$refuse_pregnant_quote['VERWOLF'] = '[베르볼프]<br>&nbsp;임신한 여자를 나한테 팔면서 내가 동의할 거라고 기대하는 건가? 절대 안 되지!'
$refuse_again_quote['VERWOLF'] = '[베르볼프]<br>&nbsp;안 된다는 건 안 되는 거다!'
! JO9 MOD END J9M1983

