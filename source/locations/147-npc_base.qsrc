! JO9 MOD START J9M1857 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Lukreciya_pref[1] = '[루크레치야]<br>&nbsp;당신이 콘스탄틴을 만나고 싶어 한다고 들었어요? 도와드릴게요, <<$master_name>>. 하지만 부탁 하나를 들어주는 대가로만요... 당신, 노예 조련사 맞죠?! 그러니 절 좀 도와줘요...'
$Lukreciya_pref[2] = '[루크레치야]<br>&nbsp;클럽에서 쓸 조수가 하나 필요해요. 그 여자애는 <font color="#0000CD"><b>영리하고</b></font> <font color="#0000CD"><b>의지가 강해야</b></font> 해요. 찡찡대는 약골은 필요 없어요. 그리고 예술 감각이 있고, 훌륭한 <font color="#008000"><b>예절</b></font>을 갖추는 것도 아주 중요해요.'
$Lukreciya_pref[3] = '[루크레치야]<br>&nbsp;결국 전 지역의 쇼와 VIP 손님들과의 응대를 제가 책임지고 있으니까요. 뚱뚱하거나 나이 든 여자애들은 싫어요. 그리고 가장 중요한 건, 그녀의 처녀성에는 손대지 마세요. 처녀들은, 뭐랄까, 더 부드럽잖아요. 그리고 그런 애들에겐 특별한 수요도 있거든요.'
$Lukreciya_pref[4] = '[루크레치야]<br>&nbsp;그리고 물론, <font color="#008080"><b>손으로도</b></font> <font color="#008080"><b>혀로도</b></font> 잘해야 해요. 실력이 좋으면 가끔은 저도 상대해 줄 수 있겠죠.'
$Lukreciya_pref[5] = '[루크레치야]<br>&nbsp;그런 애를 만들어 주면, 콘스탄틴을 만나게 해 줄게요...'
$buy_quote['Lukreciya'] = '[루크레치야]<br>&nbsp;잘했어요, <<$master_name>>! 여기 스파크예요. 콘스탄틴과의 만남은 제가 알아서 손써 둘게요.'
! JO9 MOD END J9M1857

! JO9 MOD START J9M1856 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_skill_quote['Lukreciya'] = '[루크레치야]<br>&nbsp;전 무능한 여자애에게 돈을 내고 싶지 않아요. 제겐 안 맞아요.'
! JO9 MOD END J9M1856

! JO9 MOD START J9M1855 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_level_quote['Lukreciya'] = '[루크레치야]<br>&nbsp;난 일정 수준의 노예가 필요해요, <<$master_name>>. 이 애는 아직 거기에 못 미쳐요.'
! JO9 MOD END J9M1855

! JO9 MOD START J9M1854 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_charm_quote['Lukreciya'] = '[루크레치야]<br>&nbsp;아니, 안 돼요. 더 나은 사람을 찾아와요, <<$master_name>>.'
! JO9 MOD END J9M1854

! JO9 MOD START J9M1853 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_health_quote['Lukreciya'] = '[루크레치야]<br>&nbsp;당신은 노예들 건강은 좀 챙기나요, <<$master_name>>? 아닌 것 같네요. 이 애는 분명 아파요!'
! JO9 MOD END J9M1853

! JO9 MOD START J9M1852 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$refuse_pregnant_quote['Lukreciya'] = '[루크레치야]<br>&nbsp;<<$master_name>>, 전 순결한 노예를 부탁했는데, 당신은 임신한 여자애를 데려왔네요… 이걸 제가 어떻게 받으라는 거죠?'
! JO9 MOD END J9M1852

! JO9 MOD START J9M1851 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
