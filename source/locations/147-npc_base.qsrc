$npc_info['sir_aramus'] = '<br> 타우루스 가문의 보급품을 관리하는 기사.<br><br> 얼핏 봐서는 소박하고 순진한 사람 같지만, 당신은 어떤 세계에서도 "정직한 병참장교" 가 없다는 것을 잘 알고 있다.'
npc_attitude['sir_aramus'] = 30

$npc_image['lanista_grakh'] = 'lanista_grakh'
$npc_name['lanista_grakh'] = '라니스타 그라쿠스'
$npc_status['lanista_grakh'] = '라니스타 백색 도시'
$npc_info['lanista_grakh'] = '퇴역 군단병. 마땅한 생계를 찾지 못해 검투사 양성업자(라니스타)의 길에 들어섰다. 처음에는 사업도 순조롭게 풀렸지만, 결국 "암흑기"를 맞이한 뒤로는 그 수렁에서 좀처럼 벗어나지 못하고 있다.'
npc_attitude['lanista_grakh'] = 30

$npc_image['wujen'] = 'wujen'
$npc_name['wujen'] = '현명한 부셴'
$npc_status['wujen'] = '고위 마법사<br>세르피스 가문'
$npc_info['wujen'] = '   네가 아는 한, 귀가 수상하게 생긴 이 늙은이는 세르피스 가문에서 마법 유물 분야 최고의 전문가들 중 하나다. 그는 스파크의 도움으로 불멸의 로마에서뿐만 아니라 안개 너머 어느 세계에서든 잘 작동하는 부적을 만들어 낸다.'
npc_attitude['wujen'] = 30

$npc_image['lord_spectre'] = 'lord_spectre'
$npc_name['lord_spectre'] = '스펙터 경'
$npc_status['lord_spectre'] = '백색 가문의 영주<br>백색 가문'
$npc_info['lord_spectre'] = '   백색 도시의 영주들 가운데 한 사람으로, 백색 가문의 통치자이자 귀족 중 하나다. 그는 불멸의 로마에서 부유하고, 강력하며, 존경받고, 영향력도 크다. 높은 곳에 영향력 있는 친구들을 많이 두고 있는데다 그 자신도 위험하고 강력한 인물이므로, 그를 거스르는 건 대체로 현명하지 못한 일로 여겨진다.'
npc_attitude['lord_spectre'] = 30

