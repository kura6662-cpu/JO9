! JO9 MOD START J9M2124 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$general_barabas_pref[1] = '[바라바스 장군]<br>&nbsp;꽤 실력있는 전문가로 명성이 자자하더군, <<$master_name>>. 그 정돈 요하지, 내가 흔치 않은걸 찾고 있으니까. 요점은 내게 온블라밀사라는 아들이 있다, 혈연 관계는 아니지만, 뭐...</div>'
$general_barabas_pref[2] = '[바라바스 장군]<br>&nbsp;내 유일한 아들은 과거 안개에서 숨어 살고 있었네. 허나 내 혈통을 지키려고 입양했지. 아주 잘생긴 아이야, 대담하고, 그저 버릇이 개같이 없고 좀... 덜떨어져서 그렇지. 하지만 난 그 아이를 교육할 시간이 없네.</div>'
$general_barabas_pref[3] = '[바라바스 장군]<br>&nbsp;그 애는 군인과 시종들 사이에서 자라서, 그 또래의 친구들이 없네. 그래서 내 생각에 그 아이 또래의 여자애를 붙여주면 어떨까 싶네. 같이 놀기만 하는 상대가 아니라 교육까지 시킬 수 있는 친구로!</div>'
$general_barabas_pref[4] = '[바라바스 장군]<br>&nbsp;그래서 말 잘듣는 <b>미성숙</b>한 소녀가 필요해, <font color="#009FEF"><b>강인한 자아</b></font>에 <font color="#009FEF"><b>영리</b></font>한 아이로. 온블라밀사에게 <font color="#009FEF"><b>예의범절</b></font>과 <font color="#009FEF"><b>과학</b></font>도 가르쳤으면 좋겠군. 또 미학적인것도 조금. <font color="#009FEF"><b>음악</b></font>기술은 반드시 뛰어나야해. 피아노든... 류트든...</div>'
$general_barabas_pref[5] = '[바라바스 장군]<br>&nbsp;둘은 분명히 사랑에 빠져버릴테니, 아이는 처녀여야지. 창녀따윈 내 아들과 맞지 않아. 외모가 <font color="#009900"><b>아름다워야</b></font>하는건 당연지사, 곱슬머리에 큰 눈, 또 인형같은 얼굴이 좋겠어.</div>'
$buy_quote['general_barabas'] = '[바라바스 장군]<br>&nbsp;오! 사랑스런 소녀로군. 거의 인형 같아. 그리고 저 뾰루퉁하고 우아한 모습 좀 보게.. 흐흐.. 엄격하기도 하군. 그녀는 내 콧대를 꺾을 수도 있겠어. 하... 좋아! 그녀를 받지. 만족스럽군. 여기 자네가 받아 마땅한 돈이 있네.</div>'
$refuse_skill_quote['general_barabas'] = '[바라바스 장군]<br>&nbsp;괜찮긴 한데, 아는게 너무 적어. 아들을 가르칠 순 있겠지만, 부족해. 구매에 흥미가 생길지도 모르겠군 <<$master_name>>, 자네가 조금 더 가르쳐온다면 말이야.</div>'
$refuse_level_quote['general_barabas'] = '[바라바스 장군]<br>&nbsp;여자 아이의 자질을 훑어봤네만, 명백하게 준비가 덜 되었어. 할 <b>수준</b>이 아니야, 그래도 장래는 있다보이는군. 뭐, 계속 해보게, <<$master_name>>.</div>'
$refuse_charm_quote['general_barabas'] = '[바라바스 장군]<br>&nbsp;에... 내가 말했잖나? 동그랗게 말린 머리에! 인형처럼 입어야 한다고. 그녀는 내 아들의 파트너가 돼야 해. 인형이나 천사처럼 보여야 한다고. 이건 내가 원한 게 아니야!</div>'
$refuse_health_quote['general_barabas'] = '[바라바스 장군]<br>&nbsp;체력 부족이 웬말인가, 아무일 없이 떠나는걸 고맙게 여기도록!</div>'
$refuse_pregnant_quote['general_barabas'] = '[바라바스 장군]<br>&nbsp;임신?! 웃기는군, 그게 내 아들의 씨받이인가?!</div>'
$refuse_special_quote['general_barabas'] = '[바라바스 장군]<br>&nbsp;이건 내가 주문한 게 전혀 아니잖아! 자네 살기가 피곤한가? 내가 후회스런 결단을 내리기 전에 여기서 당장 나가는게 좋을거야. 말한 여자애가 아니면 얼씬도 하지마!!!</div>'
! JO9 MOD END J9M2124

$npc_image['pretor_siegfrid'] = 'pretor_siegfrid'
$npc_name['pretor_siegfrid'] = '지크프리트'
$npc_status['pretor_siegfrid'] = '법무관<br>타우루스 가문 (신자들)'
$npc_alignment['pretor_siegfrid'] = 'taurus'
$npc_info['pretor_siegfrid'] = ' 법무관.<br><br> 타우루스가문 최고의 전사이며, 황소 영역의 치안과, 매일 바티칸에 돈을 바치는 일을 책임지고 있다.<br><br> 공고하고 영광스러운 직책이지만, 법무관들은 자기 자신들만을 위해 일한다.'
demand_rating['pretor_siegfrid'] = 8
$interesting_specialisation['pretor_siegfrid'] = 'pet'
$diary_mark['pretor_siegfrid'] = "   <<$npc_name['pretor_siegfrid']>>, 접견을 위해선 황소자리 새하얀 궁전에 출입해야 한다."
$npc_preferences['pretor_siegfrid'] = {
	stat_importance['temper'] = 3
	stat_importance['dressage'] = 5
	stat_importance['service'] = 5
	stat_importance['xenophily'] = 5
}
$buyer_demand['pretor_siegfrid'] = {
	demand['agree_age'] = 2
	demand['min_stamina'] = 3
}
! JO9 MOD START J9M2123 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$pretor_siegfrid_pref[1] = '[법무관 지크프리트]<br>&nbsp;이 말이 보이는가, 노예상? 이 녀석은 믿음직한 부세팔루스. 도시 최고의 말이고, 난 이 녀석만 타고다녀. 부세팔루스 덕분에 스파크를 안전히 운송할 수 있기 때문이지.</div>'
$pretor_siegfrid_pref[2] = '[법무관 지크프리트]<br>&nbsp;이 종마가 내 목숨을 수 차례나 구했지만, 이 엿같은 도시에선 이녀석이 그다지 행복해 보이지 않아. 늘 힘이 넘치고 만족할 줄 모르는 녀석인데, 성 안에는 암말을 들일 수가 없거든. 그러던 중, 누군가가 노예를 적절히 가르친다 들었네만. 짐승을 아주 만족시켜 준다고 말이야.</div>'
$pretor_siegfrid_pref[3] = '[법무관 지크프리트]<br>&nbsp;네가 이녀석을 제대로 돌봐주고 보살필 노예를 데려오면, 녀석을 아주 행복하게 해줄수 있을거야. 허나 명심해, 부세팔루스처럼 난폭한 말을 다룰 자는 몇 없다는 걸!</div>'
$pretor_siegfrid_pref[4] = '[법무관 지크프리트]<br>&nbsp;그러니 어떻게 <font color="#009900"><b>이종 교배를</b></font>해야 하는지, 어떻게 <font color="#009900"><b>암말 행세</b></font>를 하는지 알아야겠지... 얘가 어색해하지 않도록 말이야. 당연히 마구간을 <font color="#009900"><b>청소</b></font> 해야하고 말이야.</div>'
$pretor_siegfrid_pref[5] = '[법무관 지크프리트]<br>&nbsp;내게 박약한 어린 몸뚱이를 떠넘기진 말고! 암말은 <b>성숙하며</b>, 물도 많고 튼튼해야지. <font color="#009FEF"><b>건강</b></font>하고 <font color="#009FEF"><b>고집 센</b></font> 것으로!</div>'
$buy_quote['pretor_siegfrid'] = '[법무관 지크프리트]<br>&nbsp;와후! 진짜 암말이구만, 하?! 내가 데려가도 죄가 되진 않겠지, 그렇지 <<$master_name>>!? 그러니 내 존슨이 먼저 맛보도록 해봐야겠군. 어쨌든 마지막에는 부세팔로스 것이 되겠지만!! 스파크를 받게 <<$master_name>>.</div>'
$refuse_skill_quote['pretor_siegfrid'] = '[법무관 지크프리트]<br>&nbsp;네 생각엔 이 여자가 해낼수 것 같아보이나? 조예가 없어 보이는군, 좀 더 갈고 닦아주어. 준비 되는대로 서두르도록.</div>'
$refuse_level_quote['pretor_siegfrid'] = '[법무관 지크프리트]<br>&nbsp;그래서, 말이라고 이류 노예로 단정지은건가? 난 일류가 필요해. <b><<$rating[demand_rating[''pretor_siegfrid'']]>></b>, 그 밑은 아니야! 나가!</div>'
$refuse_charm_quote['pretor_siegfrid'] = '[법무관 지크프리트]<br>&nbsp;이 암마는 꽤 괜찮다만, 보다시피 부세팔루스가 고개를 돌려 버렸어. 냄새든 외모든 뭔가 내키지 않는 모양이야. 나도 잘 모르겠네. 그래도 부세팔루스가 마음에 안 든다면, 나 역시 안들어!</div>'
$refuse_health_quote['pretor_siegfrid'] = '[법무관 지크프리트]<br>&nbsp;부세팔루스의 힘 만으로도 벅차다 했을텐데!? 나가!</div>'
$refuse_special_quote['pretor_siegfrid'] = '[법무관 지크프리트]<br>&nbsp;내 요구는 어디로 증발해 버린거지? 다른 곳 알아보게. 다른 거!</div>'
$refuse_pregnant_quote['pretor_siegfrid'] = '[법무관 지크프리트]<br>&nbsp;임신한 암마에 저녀석이 관심줄 것 같나?</div>'
! JO9 MOD END J9M2123

$npc_image['bishop_molaru'] = 'bishop_molaru'
$npc_name['bishop_molaru'] = '몰라루 대주교'
$npc_status['bishop_molaru'] = '대주교<br>타우루스 가문 (신자들)'
$npc_alignment['bishop_molaru'] = 'taurus'
$npc_info['bishop_molaru'] = '사제의 의무는 가문 인근의 안개를 걷어내는 것.<br>매일같이, 성당 제단에서 창조의 스파크를 의식 행위로써 불태워 안개를 물린다.<br><br>대주교는 그런 사제들을 지휘하고, 개인 임무로는 안개 구역의 복지를 책임지고 있다.'
demand_rating['bishop_molaru'] = 8
$interesting_specialisation['bishop_molaru'] = 'refferent'
$diary_mark['bishop_molaru'] = "   <<$npc_name['bishop_molaru']>>. 알현하려면 황소 구역의 백색 궁전에 들어가야 한다."
$npc_preferences['bishop_molaru'] = {
	stat_importance['nurse'] = 5
	stat_importance['service'] = 5
	stat_importance['fetishism'] = 4
}
$buyer_demand['bishop_molaru'] = {
	demand['virginity'] = 1
	demand['max_fat'] = 2
}
! JO9 MOD START J9M2122 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$bishop_molaru_pref[1] = '[몰라루 대주교]<br>&nbsp;이보게 젊은이, 자네 <b>청결함</b>에 대해서 무엇을 알고 있나? 아... 그렇다면 자네의 직업에 비춰봤을 때 <b>순수함</b>은 뭐라고 생각하나? 이 세상의 모든 먼지, 진흙, 모든 것들은 죄악이라네. 이 모든 것들은 불태워버려야 해! 나는 하루에 3번 씻는다네. <b>세 차례</b>!!!</div>'
$bishop_molaru_pref[2] = '[몰라루 대주교]<br>&nbsp;나는 또한 하루에 세 번 관장을 한다네, 기도드릴 때에 한해서 시온에서 떠 온 성수로 말일세. 관장 얘기를 듣는 게 불편한가, 응? 그러나 자네들 모두가 안에서부터 썩어 들어갈 때, 나는 관장으로 청결을 유지할 수 있네. 창녀, 먼지, 부패는 모두 악마의 씨앗이야!!!</div>'
$bishop_molaru_pref[3] = '[몰라루 대주교]<br>&nbsp;몸은 영혼의 신전이라네. 나는 순수하고 깨끗한 처녀가 필요하네. 그녀는 순결함을 담은 그릇이어야 한다네. 오직 그런 여인만이 내 소중한 몸을 제대로 씻어낼 수 있으니 말이네. 그래, 그녀는 날 씻겨야 하네, 그리고 수도실을 완벽하게 <font color="#009900"><b>청소</b></font>해야 하고, 관장에 <font color="#009900"><b>어떠한 의학적 사고</b></font>도 일어나지 말아야 해.</div>'
$bishop_molaru_pref[4] = '[몰라루 대주교]<br>&nbsp;나는 이 죄 많은 도시에 나의 흔적조차 남기지 않을 걸세. 그 처녀는 나의 불결함을 밀봉할 그릇 역할도 해야 해. 그녀는 한 방울도 흘리지 않고 감사하는 마음으로 모두 <font color="#009FEF"><b>받아 마셔야</b></font> 한다네.</div>'
$bishop_molaru_pref[5] = '[몰라루 대주교]<br>&nbsp;그리고 기억해두게, <font color="#6b0084"><b>뚱뚱하고 늘어진 몸</b></font>은 끔찍한 성욕과 과식의 상징이라는 것을. 진실한 신념의 불꽃은 오직 날씬한 몸에서만 머물 수 있다네! 그리고 그런 처녀가 나에게 어울리고. 가보게, 젊은이, 내 말을 잊지 말게.</div>'
$buy_quote['bishop_molaru'] = '[몰라루 대주교]<br>&nbsp;그녀가 순결하다고? 좋아. 아주 좋군. 부서진 곳을 떼운 그릇은 부서진 그릇보다 더 최악일세. 사탄이 더러운 씨앗을 넣었는지, 그 속이 벌레로 가득 차 있을지 당최 알 수 없으니까 말일세. 이 순수한 메이드를 받도록 하지.</div>'
$refuse_skill_quote['bishop_molaru'] = '[몰라루 대주교]<br>&nbsp;내 순결성을 이 무능력한 아이에게 맡기는 걸 상상하면... 안 돼. 상상할 수가 없네. 내 눈앞에서 썩 꺼지게. 그녀는 한참 모자라네!</div>'
$refuse_level_quote['bishop_molaru'] = '[몰라루 대주교]<br>&nbsp;내 지위가 하등한 것들을 허락치 않아. 이 시계가 보이나? 자그마치 3000 스파크 씩 이야! 내 <b>순수함</b>을 담을 처녀도 최소 그정돈 되어야지!</div>'
$refuse_charm_quote['bishop_molaru'] = '[몰라루 대주교]<br>&nbsp;이 초졸한 아이에 내 <b>순수함</b>을 맡긴다 생각해보게. 안돼, 상상이 안돼. 내 앞에서 사라져.</div>'
$refuse_health_quote['bishop_molaru'] = '[몰라루 대주교]<br>&nbsp;이런 몸뚱아린, 내 굵은 순결함을 받아 들이기에 역부족이지.</div>'
$refuse_pregnant_quote['bishop_molaru'] = '[몰라루 대주교]<br>&nbsp;봉인이 뚫려있지 않나!</div>'
$refuse_special_quote['bishop_molaru'] = '[몰라루 대주교]<br>&nbsp;겉보기에는 순결해 보이는군. 그러나 자네, 이 모습에 속지 마시게나. 이것은 음마의 매력이네. 죄악의 창녀 같은 심지에 썩은 것들과 벌레가 득실거리는군. 내 눈앞에서 썩 꺼지게!</div>'
! JO9 MOD END J9M2122


