$npc_image['uncle_bo'] = ''
$npc_name['uncle_bo'] = '보 아저씨'
$npc_status['uncle_bo'] = '문신 마스터<br>카미라 가문 (아웃캐스트)'
$npc_alignment['uncle_bo'] = 'kamira'
$npc_info['uncle_bo'] = '<br> 엄청나게 배가 나오고 팔이 굵은, 수염 난 건장한 남자이다.<br><br> 그가 굵은 손가락으로 어떻게 이렇게 얇고 아름다운 문신을 새기는지는 수수께끼지만, 문신을 새기는 것에 있어서만큼은 진정한 장인이다.<br><br> 아니, 장인을 넘어서 마법과도 같은 기술을 가지고 있다. 그의 외모만 보면 인상 좋은 아저씨 같지만, 속으면 안 된다.<br><br> 키메라 가문에 소속되어 있다는 뜻은, 그가 <i>사람</i>이 아니라는 뜻이기 때문이다.'
$npc_preferences['uncle_bo'] = {
	stat_importance['sensitivity'] = 3
	stat_importance['cook'] = 4
	stat_importance['enchanter'] = 3
	stat_importance['alchemy'] = 2
	stat_importance['music'] = 3
	stat_importance['calisthenics'] = 3
}
npc_attitude['uncle_bo'] = 10
npc_reveal['uncle_bo'] = 1
npc_bennies['uncle_bo'] = 6
npc_reward['uncle_bo'] = 300
npc_advance['uncle_bo'] = 150
demand_rating['uncle_bo'] = 2
buying_temp['uncle_bo'] = 25
count_size['uncle_bo'] = 1
npc_contract_time['uncle_bo'] = 31
$train_contract['uncle_bo'] = '<center>СТАНДАРТНЫЙ КОНТРАКТ НА ОБУЧЕНИЕ</center><br><br>' + _
'Наниматель: Дядюшка Бо (Великий Camira House)<br>' + _
'Категория: D<br>' + _
'Срок обучения: 21 сутки<br>' + _
'Оплата содержания: 150 искр<br>' + _
'Оплата по факту: 200 искр<br>' + _
'Условия обучения: Индивидуальная программа, по договоренности с нанимателем.<br><br>' + _
'Профессиональный уровень: чувствительность, кулинария<br>' + _
'Компетентный уровень: пение, танцы, чародейство<br><br>' + _
'Особые требования: неполовозрелая, девственница, без татуировок и пирсинга'
$npc_contract_talk['uncle_bo'] = {
	$place = 'uncle_bo'
	copyarr '$text', '$bo_pref'
	contractor_demand['agree_age'] = 1
	contractor_demand['virginity'] = 1
	contractor_demand['min_stamina'] = 2
	contractor_demand['min_sensitivity'] = 3
	contractor_demand['min_beauty'] = 3
}
$buyer_demand['uncle_bo'] = {
	demand['agree_age'] = 1
	demand['virginity'] = 2 &! pay extra if virgin
	demand['notattoos'] = 1
	demand['pure'] = 1
}

$bo_pref[1] = '[보 아저씨]<br> 퓨후, 친구야. 내가 말해줄 거? 보는 다 닳은 창녀같은건 필요 아니해, 절대. 보는 점잖은 남자야. 보는 좋아해. 섬세한 거, 깨끗한 아름다움. 오로지 아이들만 소유하고 있다. 걱정은 마, 보가 추가요금 줄게. 그 아이 <b>꽃망울</b>이 안찢어져 있으면(웃음소리).</div>'
! JO9 MOD START J9M2066 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$bo_pref[2] = '[보 아저씨]<br>&nbsp;<font color="#0000D8"><b>다정함</b></font>! 다정함과 깊은 감수성이 주요 품질이야 보는. 다른 것들은 문제없어. 특이한 건 말고. 보씨가 필요한건 깔끔한거, 하얀 피부. 어여쁜 색깔무늬 만들려면 말이야.</div>'
$bo_pref[3] = '[보 아저씨]<br>&nbsp;보는 신경 안 써, 소녀 아이가 통통하고 응석부려도. 그게 훨씬 먹음직스럽거든(웃음 소리). 그 아이 침대에선 아무것도 안해도 돼. <font color="#0000D8"><b>어여쁘고</b></font>, 섬세한, <font color="#cd0000"><b>순수</b></font>한 소녀. 보는 그게 원하는거 전부야 .</div>'
$bo_pref[4] = '[보 아저씨]<br>&nbsp;오 맞다, 보는 <font color="#0000D8"><b>건강한</b></font> 아이를 사랑해. 아이가 <font color="#009FEF"><b>요리</b></font>도 할줄도 알면, 무지 좋은거야. 그리고 마법 물감을 섞어야 하니, 아이는 <font color="#0000D8"><b>요술</b></font>과 <font color="#6b0084"><b>화학품</b></font> 무서워하면 안 돼! 또 보씨 <font color="#0000D8"><b>음악</b></font>도 좋아해, <font color="#0000D8"><b>노래</b></font>랑 <font color="#0000D8"><b>춤</b></font>도.</div>'
$bo_pref[5] = '[보 아저씨]<br>&nbsp;그게 전부야, 아저씨. 가서 준비해 줘. 궁금한건 다 들은거지? 보가 원하는걸 가져다 주면 스파크를 주도록 할게.</div>'
! JO9 MOD END J9M2066

!KORVUS GREAT HOUSE
$npc_image['korvus_knyaz'] = 'korvus_knyaz'
$npc_name['korvus_knyaz'] = '대공'
$npc_status['korvus_knyaz'] = '군주<br>코르부스 가문 (저주받은 자들)'
$npc_alignment['korvus_knyaz'] = 'korvus'
$npc_info['korvus_knyaz'] = '당신은 이 고대 흡혈귀의 이름을 모른다.<br><br>모두가 대공이라 칭할 뿐.<br><br>정말 까마귀자리의 온전한 가주인가 혹은 놀이를 하는것인가?<br><br>의문일 만큼 안뜰은 술로 무성하고, 공식 연회마저 휘황찬란하다.'
demand_rating['korvus_knyaz'] = 10
$interesting_specialisation['korvus_knyaz'] = 'artist'

$npc_preferences['korvus_knyaz'] = {
	stat_importance['sensitivity'] = 4
	stat_importance['expression'] = 4
	stat_importance['calisthenics'] = 5
	stat_importance['art'] = 5
	stat_importance['music'] = 5
}
$buyer_demand['korvus_knyaz'] = {
	demand['virginity'] = 1
}
! JO9 MOD START J9M2065 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$korvus_knyaz_pref[1] = '[대공]<br>&nbsp;우리 모두 당신이 반가워, <<$master_name>>. 당신의 이례적 능력으로 노예를 교육해, 실로 엄청난 거래를 해왔다고 들었어. 보다시피 여긴, 조합 최고의 명품으로 가득해. 허나 당신것이 없어. 참 불쾌한 과오로군.</div>'
$korvus_knyaz_pref[2] = '[대공]<br>&nbsp;우리가 이 과오를 바로 잡도록, 최고의 여자를 마련해, 우리의 향연에서 당신 능력을 증명해 보이도록.</div>'
$korvus_knyaz_pref[3] = '[대공]<br>&nbsp;우리 친애하는 손님들의 여흥을 위해, 여자에게 으뜸기술만 가르쳐주지. <font color="#009900"><b>그림</b></font>, <font color="#009900"><b>연주</b></font>, <font color="#009900"><b>무용</b></font>, 거기에 가장 큰 기쁨을 선사할 <font color="#009FEF"><b>암송</b></font>까지.</div>'
$korvus_knyaz_pref[4] = '[대공]<br>&nbsp;거기에 더해, <font color="#009FEF"><b>부드러움</b></font>과 우리의 연회 방식에 꼭 맞는 세련됨. <u>처녀</u>로 기대하겠어. 순수한 처녀의 피는 고유의 향취와 맛이 있으니.</div>'
$korvus_knyaz_pref[5] = '[대공]<br>&nbsp;나머진 당신 도량을 발휘해 봐, <<$master_name>>. 분명 우리 모두가 놀랄 뜻 밖의 특별함을 기대해보지. 이제 떠나라.</div>'
! JO9 MOD END J9M2065

! JO9 MOD START J9M2064 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['korvus_knyaz'] = '[대공]<br>&nbsp;이 얼마나 아름다운가? 우린 흡족스러워, <<$master_name>>. 아니, 경이로워! 저 행동은 이건 놀라움 그 자체로군. 부디 우리의 보답인 스파크를 거절 않길 바라.</div>'
$refuse_skill_quote['korvus_knyaz'] = '[대공]<br>&nbsp;오, 훌륭해 질거야. 저 여자가 교육을 끝마친다면 말이지. 그렇다고 이런 걸 미리 선보이지는 말고. 기다리고 있겠어.</div>'
$refuse_level_quote['korvus_knyaz'] = '[대공]<br>&nbsp;우리의 장에 과시할 수준에 다다를 쯤 그 때에도 영광스런 당신 상표를 지녔다면 <<$master_name>>, 기꺼이 그녀를 구매하겠어.</div>'
$refuse_charm_quote['korvus_knyaz'] = '[대공]<br>&nbsp;이런건 저 여자에 도무지 어울리지 않아. 최저인 건, 도대체가 심미란 걸 음미할 수 없다는 거야. 우리가 충고해주지.<br>저 여자를 구제해줘, 저 존재 의의없는 고통으로부터. 그리고 더 명료한 후보에 집중을 해.</div>'
$refuse_health_quote['korvus_knyaz'] = '[대공]<br>&nbsp;좋아, 아주 휘청대며 과시하고 있다. 주춤대는 저 몸짓은 새로 익힌 무용인가 보지, <<$master_name>>?</div>'
$refuse_pregnant_quote['korvus_knyaz'] = '[대공]<br>&nbsp;임신. 그래, 축하해주지.</div>'
$refuse_special_quote['korvus_knyaz'] = '[대공]<br>&nbsp;놀라워 경악을 금치 못 하겠군, 어찌 이리 여자가 천박할 수 있는지.</div>'
! JO9 MOD END J9M2064

$npc_image['hand_of_the_knyaz'] = 'hand_of_the_knyaz'
$npc_name['hand_of_the_knyaz'] = '대공의 손'
$npc_status['hand_of_the_knyaz'] = '고문<br>코르부스 가문 (저주받은 자들)'
$npc_alignment['hand_of_the_knyaz'] = 'korvus'
$npc_info['hand_of_the_knyaz'] = '까마귀자리엔 군대가 전혀 없다. 하지만, 어떻게든, 잘 대처할 수 있는 이유는 수백명의 병상보다 가치있는 이들의 존재 때문이다.<br><br> 이들은 `대공의 손`이라는 명칭을 받고, 외부 문제에 간섭해 무슨 수를 써서라도 해결하는 자들이다.'
demand_rating['hand_of_the_knyaz'] = 8
$interesting_specialisation['hand_of_the_knyaz'] = 'artist'
$npc_preferences['hand_of_the_knyaz'] = {
	stat_importance['ego'] = 4
	stat_importance['expression'] = 5
	stat_importance['calisthenics'] = 4
	stat_importance['orgy'] = 3
}
$buyer_demand['hand_of_the_knyaz'] = {
	demand['virginity'] = 1
	demand['min_stamina'] = 3
}
! JO9 MOD START J9M2063 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$hand_of_the_knyaz_pref[1] = '[대공의 손]<br>&nbsp;환영합니다, <<$master_name>>. 다들 그러더군요, 당신이 빼어난 노예를 만들어낸다고. 저도 가졌으면 했지만, 보다시피 대공께서 일반인들 삶에 집착하십니다. 전 항상 그 분 무도회에 참석해야만 하고요.</div>'
$hand_of_the_knyaz_pref[2] = '[대공의 손]<br>&nbsp;우리쪽 사람 통틀어 몇 안되는 자만 이런 행사들에 수긍하죠. 경외를 내비치려 참석해야 함에도, 가문 입지를 치켜줌에도, 받는 시선이 좋아짐에도, 웬만한 흡혈귀에 맞는 행사임에도, 말이죠. 거기에 가문 흡혈귀도 증가 추세이고.</div>'
$hand_of_the_knyaz_pref[3] = '[대공의 손]<br>&nbsp;문제될 건 오직, 때맞춰 함께 참석할 여성. 전 그 꽁무니나 쫒을 시간이 없어요. 그렇다고 비웃음만 살테니 아무나 데려갈 순 없고, 적어도 체면은 세워야겠죠. 말 하자면, <font color="#009900"><b>직설적인</b></font>암사자가 필요해요.</div>'
$hand_of_the_knyaz_pref[4] = '[대공의 손]<br>&nbsp;<font color="#009FEF"><b>무용</b></font>엔 능수능란하고, <font color="#009FEF"><b>자아</b></font>가 있어야 하죠. 아니면 필시 조롱당할 겁니다.<br>행사의 끝은 <font color="#0000D8"><b>난교</b></font>와 함께 장식하니, 준비되어 있어야 해요.</div>'
$hand_of_the_knyaz_pref[5] = '[대공의 손]<br>&nbsp;물론 흡혈귀가 피를 마시는건 자연스러우니, <font color="#0000D8"><b>건강</b></font>한 <u>처녀</u>여야 할 겁니다. 흡혈귀는 처녀 피에 눈 돌아간다구요. 이유는 묻지 말아요. <u>예술가</u>면 좋겠으나, 나머진 당신에게 달려있습니다.</div>'
! JO9 MOD END J9M2063

! JO9 MOD START J9M2062 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$buy_quote['hand_of_the_knyaz'] = '[대공의 손]<br>&nbsp;맞아요. 적당한 옷만 입히면 무도회에 딱 어울리겠네요.<br>문제가 하나 줄었군요. 고맙습니다, <<$master_name>>. 재무관에게서 스파크를 취하시면 됩니다.</div>'
$refuse_skill_quote['hand_of_the_knyaz'] = '[대공의 손]<br>&nbsp;무도회에 가 내 위신이나 떨어뜨리진 않을까 걱정이네요.<br>더 교육하지 않으면 해내지 못할겁니다.</div>'
$refuse_level_quote['hand_of_the_knyaz'] = '[대공의 손]<br>&nbsp;제가 A급 미만 노예의 팔을 맞댄채 입장하면, 웃어댈 겁니다. 그럴 기횐 안 줄거에요.</div>'
$refuse_charm_quote['hand_of_the_knyaz'] = '[대공의 손]<br>&nbsp;끌리지 않아요, 색기가 없어. 무도회 참석 신인 여배우는 반드시, 또 즉시, 야한 생각 가득한 대화를 이끌어 내야죠. 그런데 이건... 눈앞에서 좀 치워줘요.</div>'
$refuse_health_quote['hand_of_the_knyaz'] = '[대공의 손]<br>&nbsp;구두 하나 똑바로 못신어서 비틀대듯 입장하면, 누구든 웃어댈 겁니다.</div>'
$refuse_pregnant_quote['hand_of_the_knyaz'] = '[대공의 손]<br>&nbsp;임신이라, 축하해야 겠군요.</div>'
$refuse_special_quote['hand_of_the_knyaz'] = '[대공의 손]<br>&nbsp;아뇨, 데려가지 않을겁니다. 내 특별 요건들을 완벽히 잊었군요 당신은.</div>'
! JO9 MOD END J9M2062

$npc_image['bishop_nerilis'] = 'bishop_nerilis'
$npc_name['bishop_nerilis'] = '니릴리스'
$npc_status['bishop_nerilis'] = '대주교<br>코르부스 가문 (저주받은 자들)'
$npc_alignment['bishop_nerilis'] = 'korvus'
$npc_info['bishop_nerilis'] = '이 미이라는 걷기만 해도 붕대가 풀릴만큼 오래됐다. 하지만 강력한 마법으로 끈의 형태를 유지하고 있다.<br><br>그의 일은 신전을 관리하는 것, 말미암아 가문 지역경계 부근의 안개를 제거한다.'
demand_rating['bishop_nerilis'] = 8
$interesting_specialisation['bishop_nerilis'] = 'witchdoctor'
$npc_preferences['bishop_nerilis'] = {
	stat_importance['intellect'] = 3
	stat_importance['nurse'] = 5
	stat_importance['alchemy'] = 5
	stat_importance['enchanter'] = 5
	stat_importance['service'] = 5
	stat_importance['secretary'] = 3
}
$buyer_demand['bishop_nerilis'] = {
}
! JO9 MOD START J9M2061 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$bishop_nerilis_pref[1] = '[대주교 니릴리스]<br>&nbsp;몸 잘 부패해, 말 힘들어.</div>'
$bishop_nerilis_pref[2] = '[대주교 니릴리스]<br>&nbsp;물 잘 <font color="#009900"><b>뿌리고, 붕대 잘 감는애</b></font>. 안부숴지게.</div>'
$bishop_nerilis_pref[3] = '[대주교 니릴리스]<br>&nbsp;약초로 <font color="#009900"><b>마법약</b></font>, 내 무덤 안 <font color="#009900"><b>깔끔</b></font> 유지.</div>'
$bishop_nerilis_pref[4] = '[대주교 니릴리스]<br>&nbsp;모든 <font color="#0000D8"><b>문서</b></font>, 순서대로 정리.</div>'
$bishop_nerilis_pref[5] = '[대주교 니릴리스]<br>&nbsp;<font color="#0000D8"><b>개념</b></font> 필요, 헷갈려서 안망치게. 이거 가져와.</div>'
$buy_quote['bishop_nerilis'] = '[대주교 니릴리스]<br>&nbsp;수락.</div>'
$refuse_skill_quote['bishop_nerilis'] = '[대주교 니릴리스]<br>&nbsp;실패.</div>'
$refuse_level_quote['bishop_nerilis'] = '[대주교 니릴리스]<br>&nbsp;스파크 값 미달.</div>'
$refuse_charm_quote['bishop_nerilis'] = '[대주교 니릴리스]<br>&nbsp;눈에 써있다, 열등한 도둑년.</div>'
$refuse_health_quote['bishop_nerilis'] = '[대주교 니릴리스]<br>&nbsp;그건 허물어 간다.</div>'
$refuse_pregnant_quote['bishop_nerilis'] = '[대주교 니릴리스]<br>&nbsp;배불뚝이.</div>'
$refuse_special_quote['bishop_nerilis'] = '[대주교 니릴리스]<br>&nbsp;안해.</div>'
! JO9 MOD END J9M2061

$npc_image['pretor_kamael'] = 'pretor_kamael'
$npc_name['pretor_kamael'] = '카마엘'
$npc_status['pretor_kamael'] = '법무관<br>코르부스 가문 (저주받은 자들)'
$npc_alignment['pretor_kamael'] = 'korvus'
$npc_info['pretor_kamael'] = '법무관의 직무는 바티칸으로부터 스파크 운송이다.<br><br>카마일의 미친듯이 큰 검은 날개는 그 일을 맡기에 최적합하다.'
demand_rating['pretor_kamael'] = 8
$interesting_specialisation['pretor_kamael'] = 'refferent'
$diary_mark['pretor_kamael'] = "   <<$npc_name['pretor_kamael']>>. 그를 만나려면 네크로폴리스의 레이븐 타워 안으로 들어가야 한다."
$npc_preferences['pretor_kamael'] = {
	stat_importance['intellect'] = 5
	stat_importance['ego'] = 3
	stat_importance['expression'] = 5
	stat_importance['secretary'] = 3
	stat_importance['roleplay'] = 4
}
$buyer_demand['pretor_kamael'] = {
}
! JO9 MOD START J9M2060 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$pretor_kamael_pref[1] = '[법무관 카마엘]<br>&nbsp;아는 사람은 적지만 로마는 전쟁 중입니다, <<$master_name>>. 멈추지 않을 거에요. 그리고 전쟁에서 가장 중요한 건 적의 계획을 미리 아는 것이지요. 나는 스파이가 많지만 그들은 너무 알려져서 쓸 수가 없습니다.</div>'
$pretor_kamael_pref[2] = '[법무관 카마엘]<br>&nbsp;사람들은 노예를 전혀 알아보지 못합니다. 하인들은 사람들의 삶을 편하게 해주므로 더 인정받습니다. 하지만 하인들은 눈과 귀가 있지요. 내겐 적의 지식을 훔쳐 올 노예가 필요합니다.</div>'
$pretor_kamael_pref[3] = '[법무관 카마엘]<br>&nbsp;그녀는 <font color="#009900"><b>대화 기술</b></font>이 뛰어나야 하고, 사람들의 신뢰를 얻어야 합니다. 또는 유혹하거나요</div>'
$pretor_kamael_pref[4] = '[법무관 카마엘]<br>&nbsp;그녀는 다른 노예의 입에서 나오는 루머와 가십을 주의 깊게 살펴야 합니다. 그리고 <font color="#0000D8"><b>보고서를 작성</b></font>해야 합니다. 이런 작업은 <font color="#009900"><b>높은 지능</b></font>이 요구되지요.</div>'
$pretor_kamael_pref[5] = '[법무관 카마엘]<br>&nbsp;그리고 물론 그녀는 비밀 엄수를 위해 <font color="#0000D8"><b>굳은 심지</b></font>을 가져야 합니다. 그렇지 않다면 오래 살지 못할 겁니다.</div>'
$buy_quote['pretor_kamael'] = '[법무관 카마엘]<br>&nbsp;내 생각엔 그녀는 임무를 잘 수행할 수 있을 것 같군요. 여기 당신의 스파크입니다, <<$master_name>>.</div>'
$refuse_skill_quote['pretor_kamael'] = '[법무관 카마엘]<br>&nbsp;그녀의 기본 스킬을 높이는 것에 더 신경 쓰셔야 할 것 같습니다, <<$master_name>>. 지금으로서는 그녀는 임무를 수행하지 못할 것입니다.</div>'
$refuse_level_quote['pretor_kamael'] = '[법무관 카마엘]<br>&nbsp;내가 제시하는 스파크에 합당한 등급의 상품이 필요합니다.</div>'
$refuse_charm_quote['pretor_kamael'] = '[법무관 카마엘]<br>&nbsp;안됩니다. 그녀는 신뢰성이 부족합니다, 그리고 그건 스파이로서 치명적입니다.</div>'
$refuse_health_quote['pretor_kamael'] = '[법무관 카마엘]<br>&nbsp;나를 속이려는겁니까? 그녀는 건강하지도, 강인하지도 않군요.</div>'
$refuse_pregnant_quote['pretor_kamael'] = '[법무관 카마엘]<br>&nbsp;그래서, 임신한 노예를 나에게 파려는겁니까? 절대 안됩니다!</div>'
$refuse_special_quote['pretor_kamael'] = '[법무관 카마엘]<br>&nbsp;안맞아요.</div>'
! JO9 MOD END J9M2060

$npc_image['baron_imladis'] = 'baron_imladis'
$npc_name['baron_imladis'] = '이믈라디스'
$npc_status['baron_imladis'] = '남작<br>코르부스 가문 (저주받은 자들)'
$npc_alignment['baron_imladis'] = 'korvus'
$npc_info['baron_imladis'] = '   '
