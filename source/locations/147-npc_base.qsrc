    stat_importance['sensitivity'] = 4
    stat_importance['fetishism'] = 0
    stat_importance['service'] = 3
    stat_importance['beauty'] = 4
    stat_importance['stamina'] = 3
    stat_importance['cook'] = 2
}
npc_attitude['anes'] = 11
npc_reveal['anes'] = 1
npc_bennies['anes'] = 6
buying_temp['anes'] = 25
count_size['anes'] = 20
