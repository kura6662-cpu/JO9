! JO9 MOD START J9M2132 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$moneylender_pref[1] = '[고리대금업자]<br>&nbsp;호오, 뭘 전하러 왔나 <<$master_name>>... 보이나, 내 사타구니 속에서 일하는 썅년이. 내가 노예로 뭘 할지는 자네도 잘 알겠지 적당한 물품만 가져오면, 내가 몇 마리 사지.</div>'
$moneylender_pref[2] = '[고리대금업자]<br>&nbsp;잘 하는 전공을 따지진 않아. 뭔 능력이던 쓸데만 있으면, 품질이 뭐든 값을 주지.</div>'
$moneylender_pref[3] = '[고리대금업자]<br>&nbsp;하지만 난 <b><font color="#cd0000">마녀는 싫어</b></font>. 이미 독살 안 당하게 조심하고 있으니, 노예까지 우려하긴 싫어.</div>'
$moneylender_pref[4] = '[고리대금업자]<br>&nbsp;마지막으로 가장 중요한것. 내가 바라는 유일한 조건은 바로 <b><font color="#009900"> 완벽히 빠는 년이야</b></font>! 나는 암컷년들이 지들 분수에 맞게 가랑이에 매달려 있는걸 좋아하지.</div>'
$moneylender_pref[5] = '[고리대금업자]<br>&nbsp;명심해. 조잡한 품질은 생각도 마, 돈은 확실히 줄테니. 난 급 안맞는 것들로 사치부릴만큼 낭비벽이 있지 않아. 출중한 여자만 날 둘러쌓았음 좋겠군.</div>'
! JO9 MOD END J9M2132


