$npc_alignment['Venera'] = 'RedLight'

$npc_info['Venera'] = '황제의 아내 펠라게야의 자매다. 그녀는 따분한 궁정 생활에 완전히 흥미를 잃었다. 그녀의 영혼은 언제나 자유와 유흥, 방탕을 갈망했다. 그래서 그녀는 프라이빗 클럽을 드나들며 뒤틀린 욕망을 마음껏 채운다.'
demand_rating['Venera'] = 8
$interesting_specialisation['Venera'] = 'concubine'
$diary_mark['Venera'] = "   <<$npc_name['Venera']>>."
$npc_preferences['Venera'] = {
stat_importance['temper'] = 4
