! JO9 MOD START J9M1975 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Emiliya_pref[1] = "[레이디 에밀리야]<br>&nbsp;우리 집에 온 걸 환영해요, <<$master_name>>. 생각해 보니… 내 화려한 파티가 끝나고 나면 언제나 난장판과 얼룩이 잔뜩 남거든요, 무슨 뜻인지 알죠. <<$rating[demand_rating['Emiliya']]>> 등급 이상의 하녀 하나를 사려고 해요. <<common_price[demand_rating['Emiliya']]>> 스파크면 충분하겠죠."
$buy_quote['Emiliya'] = '[레이디 에밀리야]<br>&nbsp;좋아요, 그녀를 받겠어요. 여기 스파크예요, 고마워요! 제 마음에 들었으면 좋겠네요!'
$refuse_skill_quote['Emiliya'] = '[레이디 에밀리야]<br>&nbsp;그 일에 필요한 훈련도 안 되어 있는데, 제가 왜 그녀를 받죠? 그런 일꾼엔 관심 없어요.'
$refuse_level_quote['Emiliya'] = '[레이디 에밀리야]<br>&nbsp;더 나은 사람은 없나요? 이 값엔 어울리지 않아요.'
$refuse_charm_quote['Emiliya'] = '[레이디 에밀리야]<br>&nbsp;흠… 잘 모르겠네요. 형식상으론 맞지만 볼품이 없어요. 끌리지 않네요.'
$refuse_health_quote['Emiliya'] = '[레이디 에밀리야]<br>&nbsp;뭘 저한테 팔아넘기려는 거죠? 병약해 보이고, 충분히 튼튼해 보이지도 않아요. 산산조각 나지 않는 걸 다행으로 아세요!'
$refuse_pregnant_quote['Emiliya'] = '[레이디 에밀리야]<br>&nbsp;임신한 여자애를 저한테 팔아넘기려는 건가요? 어림도 없어요!'
