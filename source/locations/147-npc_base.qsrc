demand['min_beauty'] > 3
demand['min_stamina'] > 3
}
! JO9 MOD START J9M1939 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Isyagay_pref[1] = '[이샤가이]<br>&nbsp;반가워, <<$master_name>>! 정말 딱 좋은 때 왔네! 네 도움이 필요하거든. 하지만 순서대로 얘기하자... 칼레리야와 나는 우리 사업을 번창시키려고 엄청난 노력을 들였어. 그런데 경쟁자들과 해변에 몰려드는 싸구려 걸레들이 우리 수입을 크게 깎아 먹고 있지. 이 성가신 파리 떼를 어떻게 치워 버릴까 계속 생각해 왔어...'
$Isyagay_pref[2] = '[이샤가이]<br>&nbsp;생각해 낸 게 있어... 그런데 그걸 제대로 굴리려면 좋은 연기자들이 필요해. 바로 거기서 네 도움이 필요한 거야! 나는 우리 해안을 따라 인어들이 헤엄치게 만들고 싶어. 그래, 진짜로! 웃지 마! 정욕에 차 있고, 아주 귀엽고, 기질도 있는 인어들 말이야. 손님의 어떤 소원도 들어줄 준비가 된...'
$Isyagay_pref[3] = '[이샤가이]<br>&nbsp;이 계획은 성공할 거고, 손님이 모자랄 일도 절대 없을 거야! 난 확신해! 자, 좋아... 그럼 인어들 자체에 대해 몇 마디 하자... 아까도 말했듯이—그 애들은 <font color="#008080"><b>아름답고, 섬세하고, 아주 기질이 강한</b></font> <font color="#008000"><b>창녀들</b></font>이어야 해. <font color="#008000"><b>섹스에 관해서는 뭐든 알아야</b></font> 하고, 그 이상도 알아야지! 그걸 위해 살아야 해!'
$Isyagay_pref[4] = '[이샤가이]<br>&nbsp;그 못지않게 중요한 건 시선을 끌 줄 안다는 거야. 그러려면 우아하고, <font color="#0000CD"><b>목소리도 좋고</b></font>, 뛰어난 <font color="#008080"><b>배우이자 무용수</b></font>여야 해. <font color="#008080"><b>어떤 역할이든 연기</b></font>할 수 있어야 해. 아메바에서 작은 물고기, 강아지, 새끼고양이, 그 밖의 온갖 흐물흐물한 생물까지... 그리고 물속에서 <font color="#008000"><b>자기 가장 좋은 면을 뽐내며</b></font> 너무도 아름답게 첨벙거려서, 누구도 눈을 뗄 수 없어야 해!'
$Isyagay_pref[5] = '[이샤가이]<br>&nbsp;그리고 이 일이 쉬운 일이 아닌 만큼, <font color="#008080"><b>지구력</b></font>도 높아야 해. 아마 이 정도면 다인 것 같네... 내 부탁, 맡아 줄 거지? 난 이런 인어가 많이 필요할 거야. 하지만 모든 건 차근차근이지. 일단 하나부터 시작해서, 어떻게 되는지 보자고...'
! JO9 MOD END J9M1939
!Курсив

