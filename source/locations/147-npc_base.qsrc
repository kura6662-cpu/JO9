! JO9 MOD START J9M1842 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Sabrina_pref[1] = "[당신]<br>&nbsp;혹시 그 전설적인 노예상 길드의 사브리나 맞아?<br>[사브리나]<br>&nbsp;아마도... 우리 아는 사이였나?<br>[당신]<br>&nbsp;직접은 아니었지... 나, <<$master_name>>, 길드 소속 노예상이야..."
$Sabrina_pref[2] = "[당신]<br>&nbsp;그래! 길드 교실마다 초상화가 붙어 있는 그 처녀 사브리나를 보는 게 오랜 꿈이었거든. 안젤리카가 모든 수습생들한테 널 본보기로 내세우잖아. 그리고 넌 진짜 독보적이야! 그렇게까지 크게 망치다니... 길드 수석 고문이 가볍게 한 판 하자는 걸 거절해서, 길드 평의회 자리뿐 아니라 시험조차 볼 수 없게 되다니..."
$Sabrina_pref[3] = "[당신]<br>&nbsp;그런데 진짜야? 길드에서 훈련받을 때도 넌 아직 처녀였다는 게?... 내 동료들이 지금의 네 모습을 알면 좋겠다 - 수수한 옷만 입는 고지식한 년 말이야. 절대 안 믿을걸... 진짜 나쁜... 흐음!!! ... 나쁜 여자!..."
$Sabrina_pref[4] = "[사브리나]<br>&nbsp;제 직원들 앞에서 절 그렇게 모욕하지 말아 줄래요, <<$master_name>>?! 제 결점까지 모두 알 필요는 없잖아요..."
$Sabrina_pref[5] = "[당신]<br>&nbsp;하지만 내가 보기엔, 길드의 그 처녀 모습은 흔적도 없네. 그래서 다 어디로 간 거지? 말해 봐! 흥미롭잖아? 그러면 나중에 맥주 한잔하면서 사람들하고 떠들 거리도 생기고..."
$Sabrina_pref[6] = "[사브리나]<br>&nbsp;좋아요, <<$master_name>>... 설득됐네요... 말해 줄게요... ... 동화 같은 걸 믿기나 해, <<$master_name>>... 하지만 난... 난 믿어. 태어날 때부터 산타클로스가 진짜라고 믿었어. 언젠가 그를 만나게 되리라 믿었고... 그를 만지게 되리라 믿었어. 그래, 뭐 어쩌겠어... 난 그 거칠고 불같은 남자에게 나를 전부 바칠 거야..."
! JO9 MOD END J9M1842
$Sabrina_pref[7] = " [사브리나]
- 그리고 이제 그가 백 퍼센트 진짜이고, 그것도 가까이에 있다는 확신이 거의 들면서, 내 소녀 시절 꿈은 완전히 다른 색을 띠게 됐어... 뭐랄까, 그를 생각하면 난 걸레처럼 흠뻑 젖어 버려... 언젠가 그가 내 가게 문을 열고 들어올 거라고 믿어... 그리고 그다음엔... 음!... 뭐, 그건 네가 알 필요 없겠지. 그러니 그 부분은 그냥 넘어가자... "
! JO9 MOD START J9M1841 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Sabrina_pref[8] = "[사브리나]<br>&nbsp;그리고 난 그 중대한 순간을 위해 준비도 해 뒀어. 정기적으로 미용실도 다니고... 유행하는, 언제나 새것 같은, 미친 듯이 섹시한 란제리만 입어... 트레이너들도 붙였지. 안무랑 예절도 배웠고. 섹스 쪽으로도, 이미 이것저것 좀 할 줄 알아... 영원의 도시가 욕정과 방탕의 소굴이라는 건 나도 아주 잘 알아. 그리고 여기서 처녀인 건 전혀 유행이 아니니까..."
! JO9 MOD END J9M1841

! JO9 MOD START J9M1840 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Sabrina_pref[9] = "[사브리나]<br>&nbsp;그리고 난 네가 생각하는 그런 고지식한 여자도 아니야... 펠라는 꽤 잘 익혔어. 아는 남자 둘이랑 고무 장난감으로 꾸준히 연습한 게... 그래, 놀라지 마, 나도 그런 거 갖고 있어... 제대로 먹혔거든. 그러니까 난 제법 잘 빠는 편이야... 그리고 내 조그만 보지도 언제나 준비되어 있어. 늘 상태를 유지하고, 관리하는 것도 잊지 않으니까..."
$Sabrina_pref[10] = "[사브리나]<br>&nbsp;하지만 내 엉덩이는 내 영웅을 위해 남겨 뒀어. 뭐니 뭐니 해도 넉넉한 선물을 줘야 하니까... 산타클로스를 놀라게 해 줄 만한 건 분명 있을 거야. 그 정도 실력은 충분히 되지..."
$Sabrina_pref[11] = "[당신]<br>&nbsp;그래, 그래! 진짜 난잡함의 여왕이군!...<br>[사브리나]<br>&nbsp;제 능력을 의심하는 거야, <<$master_name>>?... 그 비꼼은 또 무슨 뜻인데? 당신은 그냥 거칠고 무정한 촌놈일 뿐이야. 그리고 여자가 열정에 휩싸였을 때 뭘 해낼 수 있는지 네가 어떻게 아는데? 그러니 그 열 좀 식혀!..."
$Sabrina_pref[11] = "[사브리나]<br>&nbsp;... 하지만 어쩌면 네 말이 맞을지도 모르겠어, <<$master_name>>. 아직도 거리마다 넘쳐나는 그 숙련된 창녀들만큼 되려면 갈 길이 멀지... 그리고 뭐랄까... 지금 우리 앞에 있는 살아 있는 테이블이 나보다 더 쉽고 더 욕정에 찬 것처럼 보이네. 물론 걘 딱히 자길 성공적으로 내놓기 위해 뭘 하진 않지만... 혹시 모르니 안전하게 예비책 하나쯤 마련해 두는 게 좋을지도..."
$Sabrina_pref[12] = "[사브리나]<br>&nbsp;내 주문쯤은 어렵지 않게 받아 줄 수 있지, 그렇지? 내 생각엔 <<$slave_type_name[$interesting_specialisation['Sabrina']]>>면 <<$rating[demand_rating['Sabrina']]>> 등급이면 돼. 너한텐 식은 죽 먹기잖아! 그렇지, <<$master_name>>?! <<common_price[demand_rating['Sabrina']]>> 스파크 정도는 그런 여자애한텐 언제든 있어. 최고의 여자애를 준비해 줘!"
$Sabrina_pref[13] = "[사브리나]<br>&nbsp;맨날 나 얘기만 하네... 나도 그 잘났다는 노예상 길드원이 뭘 할 수 있는지 꽤 궁금하거든. 안 그러면, 누가 알아, 언젠간 네 전설을 내가 퍼뜨리게 될지도 모르잖아. 그것도 별로 듣기 좋지 않은 쪽으로 말이야..."
$Sabrina_otkaz[1] = "[사브리나]<br>&nbsp;<<$master_name>>, 네 지난 작업은 인상적이었어. 그렇다고 쓸데없이 스파크를 뿌릴 이유는 없지. 조금 뒤에 다시 와. 어쩌면 내 마음이 바뀔지도 모르니까. 잘 가. 아무튼 내 대답은 아니야..."
$buy_quote['Sabrina'] = '[사브리나]<br>&nbsp;어디, 네가 준비한 걸 좀 보자, <<$master_name>>!... 흠! 아주 좋네. 흠잡을 데가 없어... 흠이라도 하나 잡고 싶지만, 잡을 게 없네. 이 여자애는 훌륭해. 그리고 난 그녀를 데려갈 거야. 네 스파크나 챙겨...'
$refuse_skill_quote['Sabrina'] = '[사브리나]<br>&nbsp;당신은 그냥 날로 먹으려는 놈이 분명해, <<$master_name>>! 이 여자애 실력은 분명 더 다듬어야 해. 계속 이따위면 네 실력에 대해 친구들한테 꼭 말해 줄 거야. 그리고 당신은 그걸 원하지 않겠지, 내가 보기엔... 가서 일해!'
$refuse_level_quote['Sabrina'] = '[사브리나]<br>&nbsp;이 여자애의 전체 수준이 요구 수준에 못 미쳐. 내가 무슨 길거리 걸레를 요구하는 것도 아닌데. 그래도...'
$refuse_charm_quote['Sabrina'] = '[사브리나]<br>&nbsp;다 괜찮아 보이긴 하는데, 매력이 부족해. 물론 이게 보기만큼 치명적인 건 아니지만. 그래도 난 내 적지 않은 스파크 값은 하는 물건을 받고 싶거든...'
$refuse_health_quote['Sabrina'] = '[사브리나]<br>&nbsp;미안하지만, 건강해 보이지 않네, <<$master_name>>! 그리고 난 그녀 치료까지 떠맡고 싶진 않아. 할 일이 따로 있거든...'
$refuse_pregnant_quote['Sabrina'] = '[사브리나]<br>&nbsp;이 여자라면 출산하고 아이를 키워야 한다는 건 나도 알아. 하지만 여기서는 안 돼, 지금도 안 되고, 무엇보다 내 스파크로는 더더욱 안 돼...'
$refuse_again_quote['Sabrina'] = '[사브리나]<br>&nbsp;그래, 네 여자애는 꽤 괜찮아... 하지만 인정하자면, 난 마음에 안 들어. 그리고 그건 어떻게 해도 바꿀 수 없지...'
! JO9 MOD END J9M1840

$npc_image['goblin'] = 'goblin'
$npc_name['goblin'] = '고블린'
$npc_status['goblin'] = '행복한 고블린'
$npc_alignment['goblin'] = '중립파'
$npc_info['goblin'] = '  명랑한 고블린들은 크리스마스 장터에서 온갖 쇼로 아이들과 그 부모들을 즐겁게 하는 우스꽝스럽고 별난 존재들이다. 하지만 일상에서도, 이 생물들은 아름답고 순종적인 설녀들과 약간 즐기는 걸 마다하지 않는다...'
demand_rating['goblin'] = 6
$interesting_specialisation['goblin'] = 'concubine'
$diary_mark['goblin'] = "   <<$npc_name['goblin']>>. 겨울 동화."
! JO9 MOD START J9M1839 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$goblin_pref[1] = "[고블린]<br>&nbsp;나쁜 파이크! ... 혹 없는 파이크!... 파이크는 혹이 작다... 좆도 아닌 파이크!... 엉성한 파이크!... 좋은 파이크 아니다!... 아빠는 좋은 파이크 원한다!... 파이크는 혹이 크다!... 그리고 박히는 파이크... 파이크 <<$rating[demand_rating['goblin']]>> - 좋은 파이크! 파이크 있으면, 파이크한테 쓰쉬크라도 있다!"
$goblin_otkaz[1] = "[고블린]<br>&nbsp;그 파이크는 좋은 파이크. 좋은 파이크는 쉰다! 하지만 나쁜 파이크는 일한다... 더는 파이크 없다..."
$buy_quote['goblin'] = '[고블린]<br>&nbsp;좋은 파이크! 파이크 가져가라! 하하하! 하하하! 나쁜 파이크랑 좋은 파이크! 둘 다 가 보자!!!...'
$refuse_skill_quote['goblin'] = '[고블린]<br>&nbsp;나쁜 파이크. 약한 파이크! 파이크 안 가져간다!!!...'
$refuse_level_quote['goblin'] = '[고블린]<br>&nbsp;파이크는 품질 없다! 파이크 더 손봐야 한다!...'
$refuse_charm_quote['goblin'] = '[고블린]<br>&nbsp;무서운 파이크! 에휴, 나쁜 파이크!!!...'
$refuse_health_quote['goblin'] = '[고블린]<br>&nbsp;파이크 아프다?! 그럼 파이크가 어찌 되나?...'
$refuse_pregnant_quote['goblin'] = '[고블린]<br>&nbsp;파이크는 섹스 많이 하고 뚱뚱한 파이크 된다! 아니, 그건 아니다!!!...'
$refuse_again_quote['goblin'] = '[고블린]<br>&nbsp;그 파이크는 마음에 안 든다! 다른 파이크 찾아라.'
! JO9 MOD END J9M1839

$npc_image['Don_Darmidon'] = 'Don_Darmidon'
$npc_name['Don_Darmidon'] = '돈 다르미돈'
$npc_status['Don_Darmidon'] = '장터의 상인'
$npc_alignment['Don_Darmidon'] = '중립파'
$npc_info['Don_Darmidon'] = ' 일상적으로는 다르미돈 같은 사람을 "장삿꾼"이라 부른다. 사고, 팔고, 이문 남는 교환을 하는 것 — 그게 그의 전문이다. 이익을 좇다가 그는 새로운 돈벌이 방식 하나를 생각해 냈다 — 거리 쇼 "멍청한 설녀"이다. 지금 그는 그걸 더 키우고 있다.  '
demand_rating['Don_Darmidon'] = 8
$interesting_specialisation['Don_Darmidon'] = 'refferent'
$diary_mark['Don_Darmidon'] = "   <<$npc_name['Don_Darmidon']>>. 겨울 동화."
! JO9 MOD START J9M1838 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[1] = "[돈 다르미돈]<br>&nbsp;반갑군, <<$master_name>>! 네게 보여 줄 게 좀 있다. 하지만 먼저 네 도움이 필요해... 어려운 건 아니야... 그냥 곁에만 서 있어. 원하면 네가 직접 참여해도 되고. 그건 네 자유지... 어때, 거래할까?... 좋아, 훌륭하군!..."
$Don_Darmidon_pref[2] = "[돈 다르미돈]<br>&nbsp;자, 이년아, 네가 뭘 할 수 있는지 보여 봐! 내가 괜히 파리드한테서 널 산 게 아니야. 그러니 가서 내가 네게 쓴 스파크 값을 해내! 다만 까불지 마! 알다시피 난 배은망덕한 노예는 별로 안 좋아하거든... 그러니 네 매력 켜고 가서 해내!!!"
$Don_Darmidon_pref[3] = "[노예]<br>&nbsp;원하시는 대로, 주인님...<br>[돈 다르미돈]<br>&nbsp;바로 그거야! 난 다루기 쉬운 여자애들이 좋더라고!... 자, 이제 사람들이 몰려오기 시작하네... 전부 계획대로야! 필요하면 즉흥적으로 해도 돼! 알겠지? 가슴 내밀고, 엉덩이도 빼고, 일하러 가, 인형아!... 어서! 어서!..."
$Don_Darmidon_pref[4] = "[노예]<br>&nbsp;네, 주인님... ...신사숙녀 여러분! 신사숙녀 여러분! 그냥 지나치지 마세요! 어서요! 부끄러워하지 마세요! 우리가 가장 좋아하는 명절을 진정으로 잊을 수 없고 눈부시게 만들어 봐요."
$Don_Darmidon_pref[5] = "[지나가던 사람]<br>&nbsp;보기 좋네, 아가씨! 그런데 무슨 파티가 열리는 거지? 내가 뭐 놓친 거라도 있나?...<br>[다른 지나가던 사람]<br>&nbsp;와! 이거지! 저게 바로 가슴이지!!!... 난 여기 남아서 대체 무슨 파티를 벌이는지 좀 봐야겠는데!!!..."
$Don_Darmidon_pref[6] = "[돈 다르미돈]<br>&nbsp;여러분, 모두 와 주셔서 기쁩니다. 특히 이렇게 멋지고, 경이롭고, 새해 같은 시기에 말이죠. 기적을 믿으십니까? 아니라고요? 틀렸습니다! 우리 설녀는 믿거든요... 그리고 기적이 진짜 이루어진다는 걸 누구보다 잘 아는 사람이 바로 그녀죠. 정말로 바라고만 있으면 돼요. 그리고 더 좋은 건, 사람들에게 친절과 긍정을 주는 거예요. 축제를 선물하는 거죠... 그러면 계획한 건 분명 이루어질 겁니다..."
$Don_Darmidon_pref[7] = "[돈 다르미돈]<br>&nbsp;사실, 그래서 그녀가 우리와 함께 여기 있는 겁니다... 그녀는 자기 소원이 이루어지길 정말 바라고 있어요. 그리고 그걸 위해서라면 우리와 자기 자신을 위해 진짜 축제를 만들어 내기 위해 뭐든 할 준비가 되어 있죠. 긍정적이고, 눈부시고, 불꽃이 번쩍이는 그런 축제 말입니다! 그리고 이 축제를 정말 기억에 남게 만드는 건 바로 우리 손에 달렸어요. 문제는 단 하나..."
$Don_Darmidon_pref[8] = "[돈 다르미돈]<br>&nbsp;우리에겐 포병 예포가 없다는 겁니다. 하지만 그건 당신들과 내가 고칠 수 있죠. 필요한 건 발딱 선 자지들뿐이니까요. 그걸로 우린 진짜 광란의 불꽃놀이를 만들 수 있어요. 그리고 우리 설녀가 우리 포들이 헛방이 아니라 제대로 목표를 맞히게 해 줄 겁니다..."
$Don_Darmidon_pref[9] = "[돈 다르미돈]<br>&nbsp;이 넘치지 않는 양동이 보이시죠?! 이건 스네구로치카가 세상에 가져다주는 선함의 디스펜서 같은 겁니다. 여자가 이 축제용 양동이를 재미와 기쁨과 행복의 향기로 채워 넣는다면, 그녀 소원은 분명 이루어질 거예요. 그리고 그걸 하는 데 우리 불꽃놀이의 잔재보다 더 좋은 게 뭐가 있겠습니까?!..."
$Don_Darmidon_pref[10] = "[돈 다르미돈]<br>&nbsp;가장 중요한 건, 양동이를 채우는 걸 잊지 않는 겁니다. 아직도 동화를 믿는 이 순진한 바보를 기쁘게 해 주고 싶잖아요, 그렇죠?! 물론, 누가 알겠습니까... 어쩌면 스네구로치카 말이 맞아서 진짜 기적이 일어날지도 모르죠. 그건 직접 알아보도록 합시다... 그러니 망설이지 말고, 여자가 마법의 양동이를 채우고 자기가 원하는 걸 얻게 도와줍시다..."
$Don_Darmidon_pref[11] = "[설녀]<br>&nbsp;자, 그럼 이 멋진 하루를 불꽃놀이로 터뜨려 봐요! 당신들 한 사람 한 사람을 만족시키고, 오늘을 당신들 인생 최고의 명절로 만들기 위해 내가 할 수 있는 건 전부 다 하겠어요. 그리고 가장 큰 자지의 주인인 산타 할아버지가 날 도와줄 거예요..."
$Don_Darmidon_pref[12] = "[설녀]<br>&nbsp;하지만 단 몇 개의 스파크만, 이 멋진 수정이 달린 내 가슴에 모아 주면, 당신들 중 누구든 우리 행동에 직접 수정을 가할 수 있어요. 그리고 단 20스파크면, 절 조종하는 것뿐 아니라 산타클로스 복장을 하고 직접 저를 맛볼 수도 있어요..."
$Don_Darmidon_pref[13] = "[설녀]<br>&nbsp;모두 준비됐다면, 더 미룰 이유가 없겠죠... 당신들의 여자는 준비됐어요. 아래도 벌써 이렇게 흠뻑 젖어 있잖아요! 음! 짜내면 나올 정도예요!... 난 벌써부터 너무 많은 재밌는 일이 기대돼요. 흥분으로 너무 뜨거워졌어!!!... 다들 흔들 준비됐어?!... 그럼 뭘 기다리는 거야?! 산타클로스, 명령을 내려!!!..."
$Don_Darmidon_pref[14] = "[돈 다르미돈]<br>&nbsp;하나! 둘! 셋! ... 멍청한 설녀아, 우리에게 몸을 맡겨라!!!..."
$Don_Darmidon_pref[15] = "[설녀]<br>&nbsp;사랑하는 프로스트 할아버지, 당신의 마법 지팡이로 손녀의 보지에 난 불을 꺼 주실래요? 손녀가 기대에 떨고 있는 게 느껴지나요?! 어서요, 어서, 거기서 움직이는 그건 뭐죠? 음mmmm!!!... 그리고 얼마나 큰지!!! 그리고 단단해... 정말, 진짜 지팡이 같잖아... 그리고 벌써 자유로워지고 싶어 터질 것만 같아요..."
$Don_Darmidon_pref[16] = "[설녀]<br>&nbsp;오, 네! 정말 대단한 크기예요! 우리 할아버지가 그쪽으론 모자란 적이 없다는 건 알고 있었지만... 이렇게까지 클 줄은 저도 상상도 못 했어요. 할아버지, 당신의 뱀님을 보기만 해도 제 멜론에서는 즙이 차오르고 젖꼭지는 딱딱해져 버렸어요. 이 못된 계집애들은 제대로 된 매질을 받아야 할 것 같죠. 그렇죠, 할아버지?"
$Don_Darmidon_pref[17] = "[설녀]<br>&nbsp;그리고 여기 있네요... 내 달콤하고, 촉촉한 멜론들... 할아버지 자지가 이 애들과 좀 더 가까워지고 싶어 하는 것 같지 않나요? 바로 그렇게요! 응응! 너무 좋아요!!! 할아버지 피스톤이 제 딱딱해진 젖꼭지에 닿을 때면, 마치 번개가 저를 때리는 것 같아요... 그리고 그게 저를 너무 흥분시켜요... 음mm!!!"
$Don_Darmidon_pref[18] = "[설녀]<br>&nbsp;와! 내 크리스털이 얼마나 예쁘게 반짝이는지! 누가 스파크를 채워 넣기로 한 걸까? 이 친절한 분은 누구죠? 모습을 보여 주세요!...<br>[구경꾼 1]<br>&nbsp;나다! 저렇게 끝내주는 젖가슴이라면 스파크 열 개쯤은 하나도 안 아깝지! 그리고 그냥 보여 주는 것뿐만 아니라, 그걸로 뭘 할 수 있는지도 확실히 보여 주면 더 좋겠군..."
$Don_Darmidon_pref[19] = "[구경꾼 2]<br>&nbsp;맞는 말이야, 친구. 저런 호박 같은 젖가슴이 아직도 제대로 박혀 보지도 않았다니!!! 그건 전혀 옳지 않아! 자, 할아버지, 이 여자애를 저 촉촉한 젖가슴 사이에 박아 넣어!!!... 혹시 몰라서 말하는데, 내 소원용 스파크 값은 벌써 냈거든. 그러니 난 그럴 권리가 충분해. 저 계집의 가슴알들이 네 곤봉을 어떻게 버티는지 어서 보고 싶다고..."
$Don_Darmidon_pref[20] = "[돈 다르미돈]<br>&nbsp;자, 손녀야, 준비됐지? 이제 거칠어질 거다!!!...<br>[설녀]<br>&nbsp;그럼요, 할아버지, 준비됐어요. 제 수박 사이를 박아 주세요!!! 네!!! 바로 그거예요!!! 후! 후! 더 거칠게도?!..."
$Don_Darmidon_pref[21] = "[설녀]<br>&nbsp;오, 네에에에! 맞아요!!! 이렇게 거대한 자지에 거칠게 박히는 게 너무 좋아요!...<br>[구경꾼 3]<br>&nbsp;...그런데 네 젖가슴은 그걸 감당하기엔 너무 확실하게 작잖아!... 히히!!!"
$Don_Darmidon_pref[22] = "[설녀]<br>&nbsp;전 늘 입구가 좁을수록 남자들이 더 좋아한다고 생각했는데... 제가 틀렸나요?<br>[구경꾼 3]<br>&nbsp;그건 사이가 아니라 위잖아! 그리고 이건 좁은 게 아니라 넓다고! 흠! 그러니 그 잘난 척은 그만두고, 정상적인 걸 보여 줘!..."
$Don_Darmidon_pref[23] = "[구경꾼 1]<br>&nbsp;여자의 입은 쓸데없는 수다용이 아니지! 그러니 더 나은 데 써 먹어, 계집아!!!...<br>[구경꾼 4]<br>&nbsp;그래!!! 이제 슬슬 그럴 때지! 자, 설녀, 그 달콤한 입이 대체 뭘 위해 달렸는지 보여 줘!..."
! JO9 MOD END J9M1838
$Don_Darmidon_pref[24] = " <p><i>노예에게는 남자들의 소원을 들어주는 수밖에 없었다. 게다가 크리스털 위로는 계속 스파크가 떨어지고 있었고, 그건 기본적으로 그녀가 그들이 원하는 건 뭐든 해야 한다는 뜻이었다.</i></p> <p><i> 설녀가 펠라를 하려고 무릎을 꿇어 조금이라도 편한 자세를 잡자마자, 다르미돈의 무서울 정도로 거대한 자지가 문자 그대로 눈앞 몇 센티미터 거리에 나타났다. </i></p>"
$Don_Darmidon_pref[25] = " <p><i>훈련 중엔 이 거인의 거대한 귀두를 입안에 거의 완전히 밀어 넣는 데 몇 번인가 성공한 적이 있었다. 하지만 지금은 훈련이 아니었다... 그리고 가장 혹독하진 않더라도 겨울 날씨의 현실은 나름의 조정을 강요했다. 그래서 여자는 가벼운 서리 때문에 바싹 마른 자기 도톰한 입술을, 적어도 불쾌한 균열이 생길 위험이라도 줄이기 위해, 넉넉히 핥아 적셔야 했다...</i></p>"
$Don_Darmidon_pref[26] = " <p><i>거칠게 숨을 내쉰 뒤, 지금 자기 앞에 아주 가혹한 시험이 기다린다는 걸 마음속으로 받아들인 스네구로치카는 얼굴에 옅은 미소를 띠고 주인의 물건을 향해 혀를 뻗었다...</i></p> <p><i> 그녀가 프로스트 할아버지의 피스톤에 가볍게 닿는 데 성공하자마자, 구경꾼들 사이에서 또 다른 지시가 쏟아졌다.</i></p>"
! JO9 MOD START J9M1837 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[27] = "[구경꾼]<br>&nbsp;이봐, 기쁨을 가져오는 계집아, 이제 슬슬 치마를 걷어 올리고 네 몸을 남김없이 보여 줄 때가 됐다고 생각 안 하냐!... <p><i>그 여자는 글자 그대로 모든 사소한 것까지 트집 잡는 남자들을 지옥으로 보내고 싶었다. 하지만 지금도 여기서도 그럴 수는 없었다... 모든 게 이미 지불됐고, 그건 곧 모든 걸 해야 한다는 뜻이었으니까...</i></p>"
! JO9 MOD END J9M1837
$Don_Darmidon_pref[28] = " <p><i>스네구로치카는 순순히 양손으로 짧디짧은 드레스 자락을 움켜쥐었다.</i></p> <p><i> 원래부터도 여자의 야릇한 곳 어느 하나도 제대로 가리지 못하던 드레스는 천천히 위로 말려 올라갔다. 그리고 곧, 구경꾼 무리의 욕정 어린 시선 앞엔 가벼운 추위로 살짝 달아오른 스네구로치카의 엉덩이가 모습을 드러냈다. </i></p>"
$Don_Darmidon_pref[29] = " <p><i> 공연을 더욱 강조하듯, 다르미돈의 노예는 통통한 궁둥이를 장난스럽게 흔들며 아직 다른 데 쓰지 않은 손으로 양쪽 엉덩이에 찰지게 몇 대를 갈겨 넣었다... 그리고 완전히 우연히, 하지만 아주 때맞춰 스네구로치카의 머릿속에 떠오른 즉흥 연기가 딱 맞아떨어졌다... </i></p>"
! JO9 MOD START J9M1836 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[30] = "[스네구로치카]<br>&nbsp;받아라! 받아라! 받아, 이 멍청하고 바보 같은 스네구로치카야! 당신은 그럴 만해!... 네 탓이잖아!... 뭐, 더 원해?!... 받아!... 받아!... 만족했어?! 그럼 이제 계속 빨아, 이 어린 걸레야!"
! JO9 MOD END J9M1836
$Don_Darmidon_pref[31] = " <p><i> 능숙하게 연기된 장면과, 거센 매질 덕분에 한층 더 분홍빛을 띠게 된 그 여자의 엉덩이는 제 몫을 다했다. 군중은 설녀의 행동을 넋을 잃고 바라보았고, 한동안은 끼어들 생각조차 하지 않았다. 덕분에 그녀는 남자들과의 끊임없는 대화에서 잠시 벗어나, 애정을 갈구하는 산타클로스의 자지로 차분히 돌아갈 수 있었다. </i></p>"
$Don_Darmidon_pref[32] = " <p><i> 그리고 스네구로치카가 정말 잘할 줄 아는 게 하나 있다면, 그건 혀였다. 여자는 산타클로스의 자지 위를 혀로 부지런히 훑었다. 앞뒤로, 좌우로. 때때로 가볍지만 아주 기분 좋은 간질임과 키스도 섞어 넣었다. 그리고 곧 그건 예상한 결과를 낳았다. 프로스트 할아버지의 단단히 선 자지는 그저 단단한 수준으로 바뀌었다... </i></p>"
$Don_Darmidon_pref[33] = " <p><i> 곧장 곧고 긴 막대기처럼 뻗은 그것은, 고드름처럼 스네구로치카 얼굴 앞에 멈춰 섰다. </i></p> <p><i> 여자는 어떻게든 그것에 제대로 빨려 들어가는 상황을 피하려 애썼다. 그게 큰 곤란으로 이어질 수 있다는 걸 누구보다 잘 알고 있었기 때문이다. 그래서 그녀는 떠오르는 건 뭐든 자기 놀이에 활용하려 했다...</i></p>"
$Don_Darmidon_pref[34] = " <p><i> 끈질긴 손님들을 만족시키고, 그들의 열기를 조금이라도 가라앉히려 애쓰며, 그녀는 신음하고, 콧소리를 내고, 거짓 쾌락에 겨운 듯 끙끙거리며, 이 과정에 푹 빠져 있는 척을 해냈다. 주인의 자지를 향한 찬사도 아끼지 않았다. 자기가 아는 가장 상스러운 단어들까지 동원해 자신을 가장 타락한 여자에 비유했고, 동시에 엉덩이를 장난스럽게 좌우로 흔들었다... </i></p>"
! JO9 MOD START J9M1835 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[35] = "[설녀]<br>&nbsp;음!... 얼마나 맛있는 막대사탕이야!... 어떤 계집도 이런 사탕을 그냥 못 참지.. 그리고 당신 여자는 진짜 걸레잖아, 그렇지?! 그리고 그런 진미를 군침 흘리며 핥을 사람이라면 당연히 바로 그녀지! 오, 네! 음mmmm! 아아아아아! 그리고 이렇게 많은 사람들이 자길 보고 있을 때 이 걸레가 얼마나 좋아하는지!!! 너무 흥분돼!.. 나, 이렇게 가면 싸 버릴 것 같아!!!... 아아아!!! 음mm!!!..."
! JO9 MOD END J9M1835
$Don_Darmidon_pref[36] = " <p><i> 노예의 노력은 어느 정도의 국지적 성공으로 끝날 수도 있었고, 그녀는 적어도 당분간은 산타클로스 자지에 입을 꿰인 채 늘어나지 않고 버틸 수도 있었을 것이다. 하지만 구강 섹스에 대한 당신의 특별한 사랑이 그녀 계획을 전부 망쳐 버렸다.</i></p> <p><i> 그래, 네 경험상 이런 공연은 거의 매일 벌어지는 일이고, 그래서 이 광경은 네게 너무도 익숙한 것이어서 아무런 인상도 남기지 못했다... 하지만...</i></p>"
! JO9 MOD START J9M1834 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[37] = " <p><i> ...그 여자애가 네가 가장 좋아하는 성적 즐거움, 즉 구강 섹스를 시작하기 전까진 말이다... 이제 당신은 더는 무심할 수 없었고, 머릿속에선 어느새 자신을 산타클로스 자리에 겹쳐 놓았다. 환상 속에서 당신은 벌써 그 여자가 네 자지에 입을 꿰는 장면을 기대하고 있었다... 하지만 환상과 현실을 화해시킬 순 없었다. 그래서 당신은 가장 단순하고도 예상 가능한 방식으로 그걸 바로잡기로 했다... </i></p>"
$Don_Darmidon_pref[38] = "[당신]<br>&nbsp;이봐, 엉덩이 발그레한 빨간 모자야, 빨 거야 말 거야?! 예쁘게 핥을 줄 안다는 건 다들 이미 알겠어. 여자애들이라면 분명 좋아하겠지. 하지만 우린 여자애들이 아니야... 그리고 우리 남자들은 자지가 핥기만 당하는 게 아니라, 느긋하게 빨리는 걸 좋아한다고. 그러니 뭘 기다리는 거야, 기쁨을 가져오는 계집아? 어서 네가 얼마나 잘 빠는지 모두에게 보여 줘!..."
! JO9 MOD END J9M1834
$Don_Darmidon_pref[39] = " <p><i> 네 말에 스네구로치카는 움찔 몸을 떨었다. 너를 향해 자기가 아는 모든 저주와 욕설을 쏟아붓고 싶었지만, 가슴에 달린 크리스털이 거기 떨어지는 스파크로 밝게 반짝이며 그런 생각조차 하지 말라고 재촉하고 있었다... 그래서 그녀는 어쩔 수 없이 달콤한 미소를 띠고, 산타클로스의 자지를 향해 유혹적으로 입을 벌렸다...</i></p>"
$Don_Darmidon_pref[40] = " <p><i> 여자의 눈에는 공포와 혼란이 뚜렷이 비쳤고, 그것은 곧 그녀 온몸으로 번져 갔다. 맑게 생각할 수 있는 능력조차 이 가벼운 황망 상태에 종속되어 버렸다. 그리고 목구멍까지 치밀어 오른 절망의 덩어리는 그녀에게서 말까지 앗아가고, 산소 공급까지 완전히 끊어 버렸다. 그녀는 허겁지겁 공기를 삼키며, 자기 입 안으로 빨려 들어오라고 집요하게 재촉하는 주인의 거대한 물건을 절망적으로 바라보았다. </i></p>"
$Don_Darmidon_pref[41] = " <p><i> 노예는 두려워해 봐야 소용없다는 걸 너무도 잘 알고 있었다. 어차피 돌아갈 길은 없고, 어떤 식으로든 이걸 견뎌 내야 했기 때문이다. 그녀는 어떻게든 진정하고 생각을 추슬러 보려 했다. 이 고통을 조금이라도 덜어 줄 무언가를 당장 떠올려야 했다.</i></p>"
! JO9 MOD START J9M1833 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[42] = " 젠장! 젠장! 입을 찢어 버리지 않고 어떻게든 방법을 떠올려야 해?... 그래!!! 당장 어떤 윤활제라도 필요해. 그러면 적어도 조금은 낫겠지... 어디서 구하지, 주변엔 아무것도 없잖아?... 침! 맞아! 침이지!!!... 자, 해, 계집아, 해!.. <i>스네구로치카는 자기 머릿속을 지배하는 쓸모없는 생각의 혼란 속에서, 어떻게든 조금은 논리적이고 일관된 다음 행동의 사슬을 만들어 보려 애쓰며 스스로에게 말했다.</i>"
! JO9 MOD END J9M1833
$Don_Darmidon_pref[43] = " <p><i> 지금 상황에 도움이 될 다른 방법은 아무리 생각해도 없었다. 결국 스네구로치카는 이게 유일하게 옳은 결정이라고 스스로를 설득했다. 게다가 더는 미룰 수도 없었다. 사람들은 이미 공연이 계속되길 기다리고 있었으니까. </i></p> <p><i> 한 번 더 마음속으로 스스로를 다독인 뒤, 여자는 마침내 일을 시작했다...</i></p>"
$Don_Darmidon_pref[44] = " <p><i> 최근의 스트레스로 바싹 말라 버린 입 안에 침을 조금이라도 모으는 일은 생각보다 쉽지 않았다. 하지만 그녀는 어떻게든 약간은 긁어모을 수 있었다... 이제 남은 건 그 얼마 안 되는 윤활을 현명하게 쓰는 일뿐이었다...</i></p>"
$Don_Darmidon_pref[45] = " <p><i> 프로스트 할아버지 자지의 귀두에 바짝 붙은 스네구로치카는 어렵게 모은 윤활을 모조리 그 위에 조심스럽게 뱉어 냈다. 그리고 다음은 그 여자애의 혀 차례였다. 혀는 자기 몫을 훌륭하게 해냈다. 거품 섞인 윤활로 넉넉히 코팅된 프로스트 할아버지의 창끝은 곧 반짝이며 번들거렸다. 하지만 서리가 엷게 낀 공기 속에서 그런 윤활은 성질을 금방 잃는다. 그걸 깨달은 스네구로치카는 가능한 한 입을 크게 벌리고 산타클로스의 자지에 스스로를 꿰어 넣으려 했다... </i></p> "
$Don_Darmidon_pref[46] = " <p><i> 첫 번째 시도는 완전히 실패였다. 자지 귀두의 극히 작은 일부만 여자의 입에 들어갔다. 다음 몇 번의 시도는 더 생산적이었다. 때로는 스네구로치카가 산타클로스 자지의 절반이 넘는 부분까지 밀어 넣는 데 성공하기도 했다. 그리고 이제 아무도 그녀가 그렇게 악착같이 원하던 걸 해낼 거라 믿지 않던 순간, 그녀는 마침내 원하는 걸 이루는 데 성공했다... </i></p>"
$Don_Darmidon_pref[47] = " <p><i> 약간 서리가 낀 윤활 부위는 오히려 더 미끄러워졌다. 그리고 그게 결정적인 역할을 했다. 목표를 반드시 이루겠다고 마음먹은 스네구로치카는 다르미돈의 자지에 온 힘을 쏟아부었다. 여자의 입은 문자 그대로 터질 듯 벌어지고 있었지만, 그 미끈해진 윤활층을 타고 그녀의 입술은 마침내 귀두의 가장 민감한 지점을 넘어섰고, 동시에 귀두의 남은 절반까지 완전히 스스로 안에 꿰어 넣는 데 성공했다...</i></p>"
$Don_Darmidon_pref[48] = " <p><i> 훈련 중에도 그녀는 이미 이런 결과에 도달한 적이 있었다. 그래서 다음에 무슨 일이 벌어질지 누구보다 잘 알고 있었고, 이미 그걸 견딜 준비도 되어 있었다. 얼굴 근육 전체에 걸친 긴장과, 거의 튀어나올 듯 눈물을 가득 머금은 눈에도 불구하고, 노예는 패닉에 빠지지 않고 새 감각에 적응하려 애썼다... 다행히 전반적으로 수동적인 산타클로스는 손녀에게 별다른 추가 문제를 만들지 않았다...</i></p>"
$Don_Darmidon_pref[49] = " <p><i> 재갈은 여자의 입안에 단단히 자리 잡았고, 기회만 된다면 더 깊이 파고들고 싶어 안달이 나 있었지만, 목구멍이라는 장벽은 이미 절대 넘어설 수 없는 것이었다. 다른 선택지가 없었던 스네구로치카는 어떻게든 코로 숨을 쉬어 보려 했다. 잘되진 않았지만, 그래도 어느 정도 공기 공급은 가능했다. 이제 남은 건 입 안을 점점 확실하게 채워 가는 침을 어떻게 처리할지 결정하는 것뿐이었다... </i></p>"
$Don_Darmidon_pref[50] = " <p><i> 입술의 고리는 귀두 아래 목 부분에 단단히 걸려 있었다. 그리고 넘쳐나는 침이 빠져나갈 틈 같은 건 단 하나도 없었다. 삼키는 것도 불가능했다. 여자의 입 안 모든 통로는 이미 꽉 막힌 밸브에 의해 봉쇄되어 있었다. 이대로는 오래 버틸 수 없었다. 입 안의 침은 점점 차올랐다. 그녀는 그대로 목이 막혀 죽을 수도 있었고, 물론 그런 건 전혀 원하지 않았다...</i></p>"
$Don_Darmidon_pref[51] = " <p><i> 시간이 지날수록 산소 부족은 점점 더 분명하게 느껴졌다. 스네구로치카의 힘은 조금씩 빠져나가기 시작했다. 전신을 휘감는 무력감은 팔을 거의 마비시켰고, 첫 번째 헛구역질의 기미가 목을 때렸다... 당장 뭔가를 해야 했다...</i></p>"
! JO9 MOD START J9M1832 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[52] = " 빨아 준 다음 이 뱀 같은 걸 또 내 입에 꿰라고?... 절대 싫어! 이런 부착은 한 번이면 충분해... 차라리 이 사람이 싸게 만들고, 난 그 틈에 어떻게든 빠져나가겠어! - <i>그녀는 속으로 그렇게 생각했고, 입술을 찢어 버릴 듯한 고통을 억누르며 자기 놀이를 시작했다... 그녀는 가능한 한 적극적으로 머리를 흔들기 시작했다. 다행히 부드럽게 움직이기엔 윤활이 넉넉했다. 동시에 손까지 써 가며, 그녀는 산타의 자지를 자위시켜 주었다...</i>"
! JO9 MOD END J9M1832
$Don_Darmidon_pref[53] = " <p><i> 다행히도 그 여자는 입을 혹사시키며 오래 버틸 필요는 없었다. 기분 좋은 조임에 단단히 붙잡힌 산타의 자지는 뇌에 황홀한 쾌락의 신호를 보내고 있었다. 산타의 숨결은 점점 빨라졌고, 얼마 지나지 않아 그의 발기는 떨리기 시작했다... 맥동의 리듬은 점점 더 빨라졌다. 그리고 곧, 다르미돈의 자지는 강력한 정액 분수를 터뜨릴 준비를 마쳤다... </i></p>"
! JO9 MOD START J9M1831 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[54] = " 자, 어서! 어서 싸 버려! <i>스네구로치카는 속으로 프로스트 할아버지를 재촉하며, 그의 자지가 끈적한 흰 액체로 가득 차고, 그걸 쏘아 내기 전에 한순간 힘을 모으려 수축하는 그 순간을 놓치지 않으려 했다.</i>"
! JO9 MOD END J9M1831
$Don_Darmidon_pref[55] = " <p><i> 대부분의 노예들처럼 스네구로치카 역시 펠라 경험이 꽤 많았기 때문에, 이 순간이 자기 입에 너무 큰 상처를 내지 않고도 주인 자지의 거대한 귀두에서 빠져나갈 수 있는 유일한 기회라는 걸 누구보다 잘 알고 있었다. 그리고 그 순간이 오자, 그녀는 능숙하게 그걸 활용했다...</i></p>"
$Don_Darmidon_pref[56] = " <i> 프로스트 할아버지의 자지가 잠시 굳어 멈추자, 스네구로치카는 온 힘을 다해 그것을 움켜쥐었고, 산타클로스 자지 안에 모인 모든 정액이 이 조여진 곳 앞에 한데 몰린 그 틈을 타, 남아 있던 힘을 모조리 짜내 빠져나왔다...
마침내 그 굴레에서 벗어나 절실히 원하던 신선한 공기를 제대로 들이마실 수 있게 되자, 소녀의 입에서는 날카로운 으으으으음마아아아아!!! 하는 소리가 크게 터져 나왔다...</i>"
$Don_Darmidon_pref[57] = " <i> 스네구로치카는 이 오래 기다려 온 자유를 게걸스럽게 만끽했고, 무의식적으로 손의 힘도 풀어 버렸다. 그리고 그녀가 산타클로스 자지를 놓아 주자마자, 강력한 정액의 일제 사격이 순식간에 그녀에게 퍼부어졌다. 한 번, 또 한 번... 그리고 또 한 번... 두터운 흰 얼룩들이 여자의 가슴을 아름답게 장식했다...</i>"
! JO9 MOD START J9M1830 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[58] = "[설녀]<br>&nbsp;만세!!! 자, 이게 축제용 불꽃놀이의 첫 번째 포성이에요!!! 축제는 아름다워야 하잖아요!!! 그리고 당신의 손녀, 정말 대단한 여자죠, 그렇죠 프로스트 할아버지! 나 말고 누가 사람들에게 이런 축제를 줄 수 있겠어요?! 그리고 이건 겨우 시작일 뿐이에요... 설녀는 아직도 열심히 일해서, 자기 넘치지 않는 양동이에 들어갈 수 있을 만큼 많은 불꽃놀이를 모아야 하거든요... 그러니 축제를 계속합시다!!!"
! JO9 MOD END J9M1830
$Don_Darmidon_pref[59] = " <i> 설녀의 즉흥 연기는 어느 정도 성공이었다. 그리고 그녀의 크리스털은 다시금 형형색색의 스파크로 빛나기 시작했다. 하지만 설녀는 아직 멈출 때가 아니고, 이 공연에 매료된 관객들로부터 계속 스파크를 짜내야 한다는 걸 알고 있었다. 다행히 프로스트 할아버지의 자지는 아직 단단히 서 있긴 했지만 약간은 힘이 빠져 있었고, 덕분에 이후 놀이에서 쓸 수 있는 선택지도 조금은 생겼다...</i>"
! JO9 MOD START J9M1829 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[60] = "[설녀]<br>&nbsp;프로스트 할아버지, 아무래도 아직 우리를 완전히 만족시키지 못하신 것 같고, 몇 발은 불발이 난 것 같아요. 그러니 손녀가 깨끗이 정리하고, 당신 자지를 그 불발 껍데기에서 벗겨 드리게 하는 게 어때요?! 게다가 그건 손녀 잘못이기도 하잖아요. 분명 충분히 잘하지 못해서 모든 도화선에 불을 붙이질 못한 거예요. 그러니 벌도 받아야죠... 하지만 먼저 대청소부터!!!..."
! JO9 MOD END J9M1829
$Don_Darmidon_pref[61] = " <i> 노예로 살아온 경험은 지금 어떤 인상을 줘야 제대로 먹힐지를 정확히 알려 주었다. 어쩌면 주인에게서 스파크를 몇 개 더 받을 수도 있었다. 그래서 그녀는 곧바로 일에 들어갔다. 장난스럽게 다르미돈 자지의 귀두를 자기 가슴에 흩뿌려진 정액 덩어리들 속에 적신 뒤, 그녀는 창끝으로 자기 발그레한 뺨도 툭툭 두드렸다. 이제 그 여자의 가슴뿐 아니라 예쁜 얼굴까지도 흰 끈적한 액체로 아름답게 장식되었다...</i>"

$Don_Darmidon_pref[62] = " <i> 축제용 분장이 끝나자, 스네구로치카는 이제 자신 있게 프로스트 할아버지의 아직 완전히 짜내지 못한 자지를 정리할 수 있게 되었다... 조금 힘이 빠지고 살짝 부어 오른 다르미돈의 자지는, 여전히 완전한 전투 태세이긴 했지만 더는 처음처럼 거대한 크기가 아니었다. 그래서 스네구로치카는 이전에 상처 입은 입으로도 별다른 문제 없이 그것에 스스로를 꿰어 넣을 수 있었다...</i>"

$Don_Darmidon_pref[63] = " <i> 노예의 입 안에는 심지어 약간의 여유 공간까지 남았고, 덕분에 그녀의 혀는 주인의 자지를 애무할 수 있었다. 스네구로치카 자신도 더는 자지에 단단히 꿰여 있는 상태가 아니라, 그 위에서 약간은 움직일 수도 있었다... 그 여자의 손은 자지 위를 앞뒤로 움직이며, 안에 남은 것들을 빠르고 능숙하게 끌어모았다. 그리고 곧 남아 있던 정액도 전부 노예의 입 안으로 짜내졌다...</i></p>"
$Don_Darmidon_pref[64] = " <i> 몇 번 조절하듯 빠는 움직임을 더 해 준 뒤, 스네구로치카는 프로스트 할아버지의 자지에서 몸을 빼고, 방금 짜낸 정액이 잔뜩 묻어 있는 자기 혀를 모두에게 과시하듯 보여 주었다.
그 흰 별미를 자기 가슴 위에 뱉어 놓은 소녀는, 느긋하게 미소 지으며 장난스럽게 입술을 핥았다... </i>"
! JO9 MOD START J9M1828 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[65] = "[설녀]<br>&nbsp;자, 프로스트 할아버지, 손녀가 잘했나요?! 이 못된 계집애, 정말 열심히 했잖아요! 할아버지 자지를 그렇게 게걸스럽게 빨아서, 축제 불꽃놀이를 세 번이나 강하게 받아 냈는걸요... 그리고 자기 작은 실수도 바로잡았죠, 안 그래요?! 아니면 이 조그만 죄값으로 매를 좀 맞아야 하나요?... 일단 할아버지는 쉬면서 저를 어떻게 할지 생각해 보세요, 전 아주 중요한 일을 좀 처리할게요!..."
! JO9 MOD END J9M1828
$Don_Darmidon_pref[66] = " <i> 스네구로치카는 엉덩이를 천천히 흔들며 달콤하게 웃고는, 구경꾼들이 만든 기묘한 원의 한가운데에 자리를 잡았다. 소녀가 넘어간 다음 단계의 놀이는 전적으로 그들과의 상호작용에 집중된 것이었고, 이미 적지 않게 벌어들인 스파크를 더 끌어내기 위한 것이었다. 드레스 끈을 장난스럽게 당기며, 그녀는 놀이를 시작했다... </i>"
! JO9 MOD START J9M1827 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[67] = " <i>계획된 시나리오에 따르면, 이 시점에서 프로스트 할아버지는 잠시 휴식에 들어가야 했고, 실제로도 그렇게 했다.</i><br>[설녀]<br>&nbsp;아, 이 엉망진창! 내 예쁜 축제용 드레스가 더러워져 버렸잖아. 이 바보 같은 것!... 아니, 진짜 바보는 나지!... 내 양동이가 완전히 비어 있다는 걸 까맣게 잊고 있었어. 이제 내 새해 소원은 어떻게 이루지?!... "
$Don_Darmidon_pref[68] = "[설녀]<br>&nbsp;그럼 이제 어떡하죠?! 이 바보 같으니! 프로스트 할아버지가 내가 얼마나 덤벙대고 칠칠맞은지 알게 되면 뭐라고 하실까... 그런데 정작 그 할아버지는 어디 갔죠? 가 버렸나?... 흐음!..."
$Don_Darmidon_pref[69] = "[설녀]<br>&nbsp;여러분, 제가 좀 난처한 제안을 하나 드려야 할 것 같아요... 물론 제겐 엄청 민망한 일이에요... 전 길거리 창녀 같은 여자가 아니라, 평범하고 얌전한 여자아이니까요. 하지만 정말로 제 작은 흠들은 산타클로스께 숨겨야 해요, 안 그러면 절 아주 심하게 벌하실 거예요..."
$Don_Darmidon_pref[70] = "[설녀]<br>&nbsp;아름답고 젊은 여자아이가 벗는 걸 좋아하시죠, 그렇죠?! 그럼 지금부터, 여러분 즐겁게 해 드리려고 제가 직접 그렇게 할게요. 그리고 나서 여러분 도움으로, 이 넘치지 않는 양동이에 불꽃놀이의 남은 것들을 모을 거예요... 그러니까 제발 이 일은 산타클로스께 비밀로 해 주세요! 아시겠죠?!... 자, 그럼 축제를 계속해요!!!... 부끄러워하지 마세요! 절 도와주세요! 그리고 스네구로치카를 스파크로 응원해 주세요!..."
! JO9 MOD END J9M1827
$Don_Darmidon_pref[71] = " <i> 구경꾼들의 흥미는 충분히 끌렸고, 그들은 소녀의 행동을 활발히 논의하면서도 그녀의 크리스털에 새 스파크를 채워 넣는 걸 잊지 않았다. 그 사이 스네구로치카는 스트립쇼를 시작했다... 수줍게 엉덩이를 흔들고 자유로운 손으로 자신을 어루만지며, 소녀는 태연하게 드레스 끈을 풀기 시작했다. 그리고 얼마 지나지 않아, 가슴을 받쳐 주던 일종의 코르셋이었던 그것은 그저 소녀의 엉덩이에 걸쳐진 평범한 천 조각이 되어 버렸다.</i>"
$Don_Darmidon_pref[72] = " <i> 우아하게 엉덩이를 두어 번 더 움직이자, 소녀의 드레스는 마침내 미끄러져 바닥으로 떨어졌다. 그것을 발로 밀어낸 벌거벗은 노예는 잠시 더 스스로를 가지고 놀다가, 아까 약속했던 관객 상대 일로 넘어갔다...</i>"
$Don_Darmidon_pref[73] = " <i> 나른하게 신음하며 꽤 요염하게 자기 가슴을 가지고 놀던 스네구로치카는 구경꾼 한 사람 한 사람에게 다가가, 자기 가슴과 얼굴을 장식하고 있는 정액의 줄기와 얼룩에 손가락을 담가 보라고 권했다. 그리고 더럽혀진 그 손가락은 소녀의 달콤한 입 안으로 보내졌다... 그녀는 손가락이 밑동까지 들어오도록 장난스럽게 스스로 몸을 꿰어 넣고, 혀로 살짝 놀리듯 애무했다. 정성껏 핥아 낸 뒤, 그 손가락들은 놓여났다... </i>"
$Don_Darmidon_pref[74] = " <i> 그렇게 대접받은 정액은 조심스럽게 받이통에 뱉어졌고, 통은 벌써 거의 3분의 1쯤 차 있었다.
이런 식으로 구경꾼 전부를 상대하고 나자, 스네구로치카는 몸에 묻은 정액을 거의 다 털어냈다. 오직 작은 덩어리 하나만 소녀의 탐스러운 사타구니 사이에 가지런히 매달려 남아 있었을 뿐이었다...</i>"
$Don_Darmidon_pref[75] = " <i> 구경꾼들 무리를 둘러보던 스네구로치카는 일반 군중에서 조금 떨어진 곳에 있는 매우 젊은하고 수줍은 소년 하나를 발견했다. 그의 수줍음과 경험 부족 때문에, 그는 그저 더 가까이 오기를 두려워했고 멀리서 공연을 지켜보았다. 주머니 속에 손을 숨긴 채, 아무도 눈치채지 않기를 헛되이 바라면서 그는 미친 듯이 자기 자지를 문질러대고 있었다. 눈에 띄는...</i>"
! JO9 MOD START J9M1826 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[76] = "[설녀]<br>&nbsp;이봐, 꼬마야, 누구 앞에서 쑥스러워하는 거야?! 이리 와!... 그 여자애랑 좀 놀고 싶지 않아? 나… 나…! - 아이가 소심하게 말하며 주저하는 듯 스네구로치카 쪽으로 걸어갔다.</i><br>[설녀]<br>&nbsp;자, 거 봐요! 이제 이렇게 컸으면서도 아직도 부끄러워하네..."
$Don_Darmidon_pref[77] = "[설녀]<br>&nbsp;그 여자랑 잠자리를 했어?<br>[소년]<br>&nbsp;아직은 아니야. 하지만 크리스마스에는 나만의 노예가 생길 거라는 건 확실해. 그때는 정말 마음껏 즐기겠지...<br>[설녀]<br>&nbsp;와! 그럼 네 소원이 이루어졌다고 해도 되겠네..."
! JO9 MOD END J9M1826
$Don_Darmidon_pref[78] = " [소년]
- 뭐, 비슷하긴 해...
[설녀]
- 하지만 난 아니야. 설녀를 도와줄래? 나도 내 소원이 이루어졌으면 좋겠어... 어서, 바지 속에서 뻣뻣해진 거 꺼내 봐! 내가 좀 놀아줄게. 그리고 이 양동이를 채우는 걸 도와줘. 알겠지?! 자, 내 가슴에 묻은 이 정액 좀 봐?..."
$Don_Darmidon_pref[79] = " [설녀]
- ...손가락으로 쓸어내서 내가 즐길 수 있게 해줘!... 정말 기분 좋을 거야. 약속할게!
<i>그 소년은 쌀 준비가 되어 있었다. 하지만 그는 딸딸이 치는 놈처럼 보이고 싶지 않았고 가능한 온갖 방법으로 그걸 미루려 했다. 하지만 그의 손가락이 스네구로치카의 입안에 들어가자마자, 그는 더는 참을 수 없었다. 그는 말 그대로 안에서부터 터져 버렸고, 그의 나른한 신음과 함께 제법 많은 몇 줄기의 정액이 빨대컵 안으로 튀어 들어갔다.</i>"
$Don_Darmidon_pref[80] = " <i> 설녀는 자기 일을 끝냈다. 하지만 마지막 정액 방울을 양동이에 뱉어 넣자마자, 그녀의 크리스털이 밝게 번쩍였다.</i>
- 난 20 스파크를 냈고 소원을 빌 권리가 있어... - <i>갑자기, 더 큰 목소리가 울려 퍼졌다. 그 소년의 자신감 있는 목소리였다.</i> - 네 발로 기어서 네 젖은 보지를 어떻게 어루만질 수 있는지 우리에게 보여 줘. 젖어 있지, 그렇지?..."
! JO9 MOD START J9M1825 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[81] = "[구경꾼]<br>&nbsp;잘했어, 꼬마! 더러운 걸레들은 그렇게 다뤄야 해... 그리고 네가 지금 아무리 부정해도, 설녀, 우린 네가 영원의 도시의 대부분 여자들처럼 단골 걸레라는 걸 확실히 알고 있어. 그러니 그 소년의 소원을 들어주고, 네가 어떻게 스스로를 문질러대는지 보여 줘! 그리고 나는 정말로 산타클로스가 자기가 얼마나 더러운 손녀를 두고 있는지 보고 네게 제대로 박아 줬으면 좋겠어!..."
! JO9 MOD END J9M1825
$Don_Darmidon_pref[82] = " <i> 소년은 스스로에 대한 만족감을 숨기지 않은 채 한 걸음 물러섰다. 설녀를 비롯해, 그 자리에 있던 이들 중 그 누구도 이런 전개가 펼쳐질 줄은 예상하지 못했다. 하지만 공연이 시작될 때부터 게임의 규칙이 정해져 있었기에, 노예는 소년의 소원을 들어줄 수밖에 없었다...</i>"
$Don_Darmidon_pref[83] = " <i> 시작 자세를 취한 소녀는 다리를 벌리고 천천히 손을 사타구니로 가져갔다.
자기 보지를 부드럽게 어루만지자, 소녀는 정말로 흠뻑 젖기 시작했다. 조금만 더하면 오늘의 첫 오르가슴을 맞이할 참이었다. 온몸을 휩쓰는 강렬한 흥분의 물결에 굴복한 설녀는, 들끓는 보지를 손으로 거리낌 없이 후벼 팠다. 하지만 뜻밖에 돌아온 프로스트 할아버지는 그녀가 그 계획을 끝내도록 내버려 두지 않았다.</i>"

! JO9 MOD START J9M1824 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[84] = "[돈 다르미돈]<br>&nbsp;이게 다 뭐지?! 넌 설녀잖아, 사람들에게 축제를 선사해야지. 그런데 너는... 너는 마치 네 몸을 파는 년처럼, 네 자신을 내주고 있잖아...<br>[설녀]<br>&nbsp;내 잘못이 아니야! 다 그 말썽꾸러기 녀석 때문이야. 그 녀석이 선물을 원하길래 내가 그냥 들어줬을 뿐인데..."
$Don_Darmidon_pref[85] = "[돈 다르미돈]<br>&nbsp;내게 거짓말하지 마!... 너..., 당신은 걸레처럼 굴고 있어. 그리고 호되게 매를 맞을 자격이 있지! 너무 창피해요!.. - <i>설녀는 자기 변명을 좀 해 보려 했다. 하지만 다르미돈의 자지가 무례하게, 어떤 초대도 없이, 그녀의 젖은 보지 안으로 들이쳐 들어오며 그 뻔히 소용없을 시도를 끊어 버렸다. </i>"
! JO9 MOD END J9M1824
$Don_Darmidon_pref[86] = " <i> 프로스트 할아버지는 손녀에게 조금도 사정을 봐주지 않았고, 약속한 대로 단호하고 거칠게 벌을 집행하기 시작했다.
새로운 찌르기가 이어질 때마다 프로스트 할아버지의 자지는 소녀 안으로 점점 더 거칠게 파고들었다. 속도도 꾸준히 빨라졌다. 하지만 설녀는 이 벌을 그저 즐기고 있었다. 흥분의 물결이 프로스트 할아버지의 손녀를 다시 한 번 휩쓸었다. 그리고 그 벌은 그녀에게 아주 기분 좋은 경험이 되었다.</i>"

$Don_Darmidon_pref[87] = " <i> 나른함에 몸을 맡긴 설녀는, 자기 쪽에서도 프로스트 할아버지에게 맞춰 움직이기 시작했다. 기분 좋게 자기를 어루만지는 감각 하나하나에 귀 기울이던 소녀의 몸은 바람 속 사시나무 잎처럼 떨렸다. 그녀는 자기를 감싸는 황홀 속에 완전히 항복할 준비가 되어 있었다. 거칠어진 숨결에는 끝없는 쾌락의 나른한 신음이 섞여 들었다. 시간이 흐를수록, 노예는 점점 더 자기 통제를 잃어 갔다...</i>"
$Don_Darmidon_pref[88] = " <i> 방탕과 욕정, 그리고 수치심 없는 타락이 소녀를 완전히 집어삼켰다. 그리고 자기 안의 자연스러운 본능을 거스를 수 없게 된 그녀는, 자기 흠뻑 젖은 구멍에 자지를 더 깊이 받아들이기 위해서라면 뭐든 할 준비가 된 음탕한 걸레로 변해 버렸다...</i>
[설녀]
- 네에에!... 네에에!... 더!... 으으음! 너무 좋아요오오오!!! 네 년을 박아, 산타클로스! 더 깊게! 바로 그거예요!"
$Don_Darmidon_pref[89] = " <i>스네구로치카의 애처로운 신음은 프로스트 할아버지를 더욱 흥분시켰다. 그는 소녀에게 두 배는 더 거칠게 밀착했다. 그 찌르기는 너무도 강해서, 스네구로치카는 아까 손을 짚고 버티던 차가운 벽에 그대로 내동댕이쳐지듯 부딪혔다. 불타는 듯한 소녀의 몸과, 단단히 선 젖꼭지가 맛있게 눌린 차가운 감촉 사이의 대비는 순식간에 오래 기다리던 해방을 불러왔다...</i>"
! JO9 MOD START J9M1823 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[90] = " 나 싸요! - <i> 스네구로치카는 오르가슴을 즐기며 저도 모르게 신음했다. 하지만 프로스트 할아버지는 그 마법 같은 감각을 즐길 시간조차 소녀에게 허락하지 않았다. 그는 기운이 조금 풀린 스네구로치카를 벽에서 떼어 다른 자리로 옮긴 뒤, 계속해서 그녀의 벌을 집행했다. </i>"
! JO9 MOD END J9M1823
$Don_Darmidon_pref[91] = " <i> 산타 할아버지가 손녀를 무자비하게 따먹던 장소는 바뀌었고, 다음 성교가 시작되기 전 소녀가 취하게 된 자세도 달라졌다. 하지만 한 가지는 변함없이 그대로였다. 스네구로치카는 매번 또 다른, 그리고 또 다른 오르가즘의 파도에 휩쓸렸다. 그리고 매번, 이전의 황홀함에서 잠시 깨어나 나른하게 신음하며, 그녀는 말 그대로 산타 할아버지에게 완전한 창녀처럼 자신을 박아달라고, 그리고 다시 한번 그 갈망하던 망각의 세계로 빠져들 기회를 달라고 애원했다... </i>"
$Don_Darmidon_pref[92] = " <i> 이런 일은 스네구로치카가 어떻게든 그의 거친 정사에 다시 맞춰 움직일 수 있을 때까지 계속됐다. 그리고 또 한 번 난폭한 오르가슴을 받아낸 뒤 그녀가 그대로 기절해 버리자, 더 이어지는 집행은 완전히 쓸모없는 일이 되고 말았다. </i>"
$Don_Darmidon_pref[93] = " <i> 소녀가 자기에게 무슨 일이 벌어지고 있는지 천천히 다시 자각하기 시작했을 때, 그녀는 짧은 휴식이 주어졌다는 걸 깨달았다. 그리고 그건 오직 하나만을 뜻했다. 자신에게 뭔가 심각하고, 그다지 즐겁지 않은 일이 더 준비되고 있다는 뜻이었다... 정신을 차리자마자 스네구로치카가 가장 먼저 느낀 감각은, 그리 크진 않지만 꽤 단단한 무언가가 자기 엉덩이 안으로 기분 좋게 파고드는 느낌이었다.</i>"
! JO9 MOD START J9M1822 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[94] = "[돈 다르미돈]<br>&nbsp;내가 그 달콤하고, 거의 처녀 같은 엉덩이에 손을 댔을 때 그녀가 정신을 차릴 거라고 말했잖아... 자, 자기야, 네 엉덩이가 새해 선물을 받을 준비가 됐니?"
$Don_Darmidon_pref[95] = " 네! 하고 싶어요! 산타 할아버지, 제 달콤한 엉덩이를 박아 주세요! … 스네구로치카는 무슨 일이 벌어지고 있는지 여전히 어렴풋이만 깨닫고 있었지만, 꽤 당당한 어조로 말했다. 그리고서야 비로소 그녀는 방금 산타 할아버지에게 무엇을 부탁했는지 깨달았다.</i> 멈춰! 이 엉덩이 좀 봐! 하지만 이미 늦었다... 다르미돈은 단호하게 자기 창을 노예의 조여진 엉덩이에 밀어붙였다. 소녀의 저항은 순식간에 부서졌다..."
$Don_Darmidon_pref[96] = " <i> 소녀는 자기 엉덩이를 갈기갈기 찢는 듯한 지옥 같은 고통에 미쳐 버릴 것 같았다...</i> 아, 신이시여, 너무 아파요! 제발, 안 돼요!!! <i>그녀는 애원하듯 울부짖었다. 하지만 그녀의 비명으로 달라질 건 아무것도 없었다. 다르미돈은 스네구로치카의 가장 조여진 구멍을 더욱더 깊이 집요하게 뚫고 들어갔다...</i>"
! JO9 MOD END J9M1822
$Don_Darmidon_pref[97] = " <i> 소녀가 고통 속에서 절망적으로 몸을 비트는 동안에도, 주인의 자지는 천천히 그녀 안으로 가라앉아, 거의 배 근처쯤에서야 멈췄다...
뒤를 돌아본 소녀는 자기 엉덩이가 다르미돈의 거대한 물건을 완전히 삼켜 버렸다는 걸 깨달았다. 이제 주인은 그저 그녀가 이 뜻밖의 손님에게 익숙해지길 기다리고 있을 뿐이었다.</i>"
$Don_Darmidon_pref[98] = " <i> 짧은 멈춤 뒤, 다르미돈의 자지는 앞뒤로 움직이기 시작했다. 찌르기의 진폭은 점점 커졌고, 소녀의 엉덩이를 찢는 고통은 눈에 띄게 줄어들었다. 그리고 주인의 자지가 이미 버터 속 칼처럼 노예의 엉덩이 안을 드나들게 되었을 때, 소녀는 뜻밖에도 자기 자신조차 놀랄 만큼 약간의 쾌감까지 느끼기 시작했다... </i>"
$Don_Darmidon_pref[99] = " <i> 점차 프로스트 할아버지는 속도를 올렸다. 설녀도 그 리듬에 익숙해져, 심지어는 그를 도와주려까지 했다. 썩 잘하진 못했지만, 목적은 이뤘다. 프로스트 할아버지는 증기기관차처럼 헐떡였고, 그의 자지는 떨리기 시작했다. 그리고 그는 기적적으로 정액이 강력한 분사로 터지기 직전에 소녀의 엉덩이에서 그것을 빼낼 수 있었다. </i>"
$Don_Darmidon_pref[100] = " <i> 오늘의 가장 큰 난관은 넘어갔다고 생각한 노예는 좀 쉬고 싶었다. 하지만 다르미돈은 그녀의 모든 계획을 망쳐 버렸다... </i>"
! JO9 MOD START J9M1821 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[101] = "[돈 다르미돈]<br>&nbsp;자, 손녀야, 참 잘했구나. 파티는 대성공이었어. 하지만 네 양동이는 반밖에 차지 않았어. 이건 안 되겠어! 여러분, 이 아이를 도와서 양동이를 가득 채워 줘. 그러면 이 아이도 여러분을 도와줄 거야! 이건 너희 거야! 마음껏 즐겨!!!"
! JO9 MOD END J9M1821
$Don_Darmidon_pref[102] = " <i> 말 그대로 바로 그 자리에서, 수십 개는 되는 단단한 남근들이 노예의 얼굴 앞에 모습을 드러냈다. 소녀에게 남은 선택지는 달콤하게 웃으며 입을 벌려 새로운 모험을 맞이하는 것뿐이었다... </i>"
! JO9 MOD START J9M1820 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[103] = " <i> 당신은 이 공연에 꽤 질려 있었다. 이제는 떠날 준비가 되어 있었다. 다르미돈을 언제까지 기다려야 할지 알 수 없었기 때문이다. 그래서 당신은 광장 출구 쪽으로 향했다... </i>"
$Don_Darmidon_pref[104] = "[돈 다르미돈]<br>&nbsp;잠깐, <<$master_name>>! 이렇게 오래 기다리게 해서 정말 미안하군. 하지만 내 사정도 이해해 줘... 힘과 돈이 모든 걸 결정하는 세상에서, 평범한 상인에게 스파크 하나하나는 너무도 소중하니까. 그리고 지금 당신과 이야기하기에 아주 편한 때는 아니지만, 더 지체시키지 않기 위해서라도, 나... 내가 해 보지... 짧게 말하겠네..."
$Don_Darmidon_pref[105] = "[돈 다르미돈]<br>&nbsp;내겐 <<$slave_type_name[$interesting_specialisation['Don_Darmidon']]>> 분야의 <<$rating[demand_rating['Don_Darmidon']]>> 등급 이상 여자애가 필요해. 이 쇼가 내 시간을 너무 잡아먹어서, 고급 노예를 직접 준비할 시간이 없거든. 네가 훈련한 여자애라면 그 역할을 해낼 수 있지. 그리고 난 그녀의 값으로 <<common_price[demand_rating['Don_Darmidon']]>> 스파크를 낼 생각이야. 한 스파크도 더는 안 돼. 이제 남은 건 물건을 보는 것뿐이지.."
$Don_Darmidon_pref[106] = "[돈 다르미돈]<br>&nbsp;사실 너와 얘기하고 싶었던 건 그게 전부였어... 이젠 나도 가 봐야 하고... 적당한 여자애가 있으면 와, <<$master_name>>! 아, 그리고... 난 날 도와준 사람에게 어떻게 보답해야 하는지도 알아. 네 여자애가 마음에 들면, 우리 거래에 괜찮은 보너스도 얹어 주지..."
! JO9 MOD END J9M1820
$Don_Darmidon_pref[107] = " <p><i>네가 다르미돈과 이야기를 나누는 동안, 스네구로치카는 대략 스무 명쯤 되는 남자들에게 박혔다. 자기 욕구를 푼 그들은 만족스럽고 행복한 얼굴로 자리를 떠났다. 마지막 손님이 소녀의 구멍들을 실컷 즐기고 떠났을 때, 머리부터 발끝까지 정액으로 뒤덮인 노예는 겨우 발 위에 서 있을 수 있을 정도였다...</i></p>"
! JO9 MOD START J9M1819 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Don_Darmidon_pref[108] = "[설녀]<br>&nbsp;산타클로스, 스네구로치카는 당신 명령을 다 해냈고 모두에게 축제를 선물했어요! 저 자신에게도요... 넘치지 않는 양동이는 완전히 가득 찼어요! 그리고 가장 중요한 건, 제 소원도 이루어졌다는 거예요... 전 진짜 여자처럼 새해를 보내고 싶었거든요... 이제 전 뭐든 할 수 있어요. 구멍이든, 여자든... 그리고 이 크리스털이 얼마나 빛나는지 좀 보세요! 안에 스파크가 엄청 많아요!!!"
$Don_Darmidon_pref[109] = "[돈 다르미돈]<br>&nbsp;진정해, 쇼는 끝났어! 크리스털을 내게 넘기고, 네 몸부터 좀 추슬러. 그다음 집에 가자! 오늘은 끝이다..."
$Don_Darmidon_otkaz[1] = "[돈 다르미돈]<br>&nbsp;<<$master_name>>, 네가 전에 내게 맡긴 여자애가 아주 잘하고 있어. 그러니 지금은 다른 애가 필요 없어. 나중에 다시 와. 어쩌면 추가 일거리를 좀 찾아 줄 수도 있으니까..."
$buy_quote['Don_Darmidon'] = '[돈 다르미돈]<br>&nbsp;고마워, <<$master_name>>! 이 여자애야말로 내가 딱 필요로 하던 애야! 받겠어. 네 스파크는 챙겨 둬... 그리고 내 약속도 기억하고 있어... 집으로 와, <<$master_name>>! 우리 거래의 보너스를 조정 중이니까, 곧 받게 될 거야! 메리 크리스마스야, <<$master_name>>, 그리고 새해 복 많이 받아!...'
$refuse_skill_quote['Don_Darmidon'] = '[돈 다르미돈]<br>&nbsp;실력을 더 키워야겠군. 네 여자애는 필요한 걸 아무것도 할 줄 모르잖아...'
$refuse_level_quote['Don_Darmidon'] = '[돈 다르미돈]<br>&nbsp;이 여자애의 전체 수준이 요구 수준에 못 미친다. 그래도 난 제값 하는 상품값은 내는 거라고...'
$refuse_charm_quote['Don_Darmidon'] = '[돈 다르미돈]<br>&nbsp;전반적으로는 괜찮아 보이지만, 내 눈길을 딱히 끌진 않는군...'
$refuse_health_quote['Don_Darmidon'] = '[돈 다르미돈]<br>&nbsp;건강해 보이지 않잖아, <<$master_name>>! 그리고 난 저 애를 치료해 줄 처지도 아니야. 난 스파크를 벌어야지, 치료에 낭비할 순 없다고...'
$refuse_pregnant_quote['Don_Darmidon'] = '[돈 다르미돈]<br>&nbsp;<<$master_name>>, 제정신이야?! 내가 임신한 여자를 왜 필요로 하겠나?!...'
$refuse_again_quote['Don_Darmidon'] = '[돈 다르미돈]<br>&nbsp;솔직히 말하지. 마음에 안 들어. 그러니 이 여자애는 받지 않겠다.'
! JO9 MOD END J9M1819
!Сказочный лес
$npc_image['fabrika'] = 'fabrika'
$npc_name['fabrika'] = '파브리카'
$npc_status['fabrika'] = '선물 창고'
$npc_alignment['fabrika'] = 'Neutrals'
$npc_info['fabrika'] = '  크리스마스이브에는 선물 공장의 일이 밤낮없이 한창이다. 부지런한 엘프들은 산타의 선물들이 제때, 완벽한 상태로 준비되고 검사되고 수령인들에게 전달되도록 해야 해서 할 일이 산더미다... '
demand_rating['fabrika'] = 6
$interesting_specialisation['fabrika'] = 'pet'
$diary_mark['fabrika'] = "   <<$npc_name['fabrika']>>. Зимняя сказка."
! JO9 MOD START J9M1818 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$fabrika_pref[1] = "[엘프]<br>&nbsp;안녕, <<$master_name>>! 보다시피 로마 전체가 새해 축제를 준비하고 있어. 크리스마스이브에 가장 눈길을 끄는 게 뭔지 알아? 아니라고? 당연히 새해 썰매지! 그런데 올해는 순록들 때문에 골치가 좀 아프거든... 저기, 혹시 우리 좀 도와줄 수 있을까? <<$rating[demand_rating['fabrika']]>> 등급 이상의 여자애를 훈련시켜 줘. 어떤 순록이랑도 맞먹을 만큼 말이야. 예쁘고, 훌륭한 썰매 끄는 애로!"
$fabrika_pref[2] = "[엘프]<br>&nbsp;보수는 후하게 줄 테니 걱정 마!"
$fabrika_otkaz[1] = "[엘프]<br>&nbsp;<<$master_name>>, 전에 맡긴 여자애가 아직은 아주 잘하고 있어. 그러니 지금은 새 애가 필요 없네. 그래도 가끔 다시 들러 줘... 뭐가 달라질지는 아무도 모르잖아..."
$buy_quote['fabrika'] = '[엘프]<br>&nbsp;고마워, <<$master_name>>! 이 여자애면 딱 맞겠어. 받겠네. 여기 네 스파크야...'
$refuse_skill_quote['fabrika'] = '[엘프]<br>&nbsp;실력을 더 키워야겠군. 네 여자애는 필요한 걸 아무것도 할 줄 모르잖아...'
$refuse_level_quote['fabrika'] = '[엘프]<br>&nbsp;이 여자애의 전체 수준이 요구 수준에 못 미친다. 그래도 난 제값 하는 상품값은 내는 거라고...'
$refuse_charm_quote['fabrika'] = '[엘프]<br>&nbsp;전반적으로는 괜찮아 보이지만, 내 눈길을 딱히 끌진 않는군...'
$refuse_health_quote['fabrika'] = '[엘프]<br>&nbsp;건강해 보이지 않잖아, <<$master_name>>! 우린 아픈 사람이나 약골은 필요 없어...'
$refuse_pregnant_quote['fabrika'] = '[엘프]<br>&nbsp;임신한 암사슴이라고?! 그걸 대체 어떻게 상상한 거야, <<$master_name>>...'
$refuse_again_quote['fabrika'] = '[엘프]<br>&nbsp;솔직히 말하지. 마음에 안 들어. 그러니 이 여자애는 받지 않겠네.'
! JO9 MOD END J9M1818

$npc_image['tf_teatr'] = 'tf_teatr'
$npc_name['tf_teatr'] = '마샤'
$npc_status['tf_teatr'] = '동화 숲 극장의 예술감독'
$npc_alignment['tf_teatr'] = 'Neautrals'
$npc_info['tf_teatr'] = '  마샤는 예전부터 지나치게 활동적이었고, 말 그대로 모든 일에 엄청난 재능이 있었다. 그 노력 덕분에 그녀는 동화 숲 극장의 예술감독 자리를 얻었고, 그곳에서 그녀의 재능은 제대로 쓰이고 있다... '
demand_rating['tf_teatr'] = 7
$interesting_specialisation['tf_teatr'] = 'concubine'
$diary_mark['tf_teatr'] = "   <<$npc_name['tf_teatr']>>. Зимняя сказка."
! JO9 MOD START J9M1817 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$tf_teatr_pref[1] = "[당신]<br>&nbsp;똑똑! 안녕하세요, 여러분!... ... 오! 정말 멋진 광경인데요!!!...<br>[마샤]<br>&nbsp;안녀어어어엉, <<$master_name>>! 좀 실례할게! 우리 지금 리허설 중이거든..."
$tf_teatr_pref[2] = "[마샤]<br>&nbsp;저 사냥꾼들이 안개 너머에서 뭘 데려왔는지 상상이나 가? ... 서리 트롤이야!... 맙소사 ... 저 선물로 벌써 둘이나 찢어 놨어..."
$tf_teatr_pref[3] = "[마샤]<br>&nbsp;그런데도 둘이나 더 남았어... 오오오, 난 아직도 세 번째 애를 교체 중이야... 나한테 어울리는 설녀 하나 준비해 줘. 튼튼하고 잘 늘어나는 애로. 알겠지?! <<$slave_type_name[$interesting_specialisation['tf_teatr']]>> 전공의 <<$rating[demand_rating['tf_teatr']]>> 등급이면 돼. 관객들 앞에서 조금 날아다니게 해 줘... 아야! 오오오! 아아아! 나 이제 막 갈 것 같아!!! 얘들아, 아리아 부분에서는 무대에 뭐가 올라가?" 
$tf_teatr_pref[4] = "[첫 번째 설녀]<br>&nbsp;세 번째 설녀이 가고 싶어질 때, 첫 번째가 그녀의 ... 막대사탕을 입에 넣어요. 세 번째 설녀은 그 막대사탕을 빨면서 가고, 계속 할아버지 자지 위를 타요. 할아버지는 설녀을 자기 불알까지 끌어당기고, 안에 거칠게 싸 버려요. 그러면 설녀은 풍선처럼 부풀어 올랐다가 사탕 불꽃놀이처럼 터져 버리고, 그 사탕들은 관객들에게 나눠 줘요..."
$tf_teatr_pref[5] = "[마샤]<br>&nbsp;그러니까 뭐 하고 이이이이써! 얼른 네 막대사탕 넣어!... 멈춰!!! 저 폭발은 또 뭐야?! 무슨 불꽃놀이?! 누가 이런 말도 안 되는 걸 생각해낸 거야?<br>[두 번째 설녀]<br>&nbsp;네가...<br>[마샤]<br>&nbsp;좋아! 얘들아, 다들 내 사무실로 와서 대본 다시 쓰자!!!"
 $tf_teatr_otkaz[1] = "[마샤]<br>&nbsp;<<$master_name>>, 우리 방식이 통하지 않아. 할아버지가 첫 리허설부터 네 설녀을 부풀려 놓고 풍선처럼 터뜨려 버렸어. 네 잘못은 아니지만, 이제부턴 내가 어떻게든 해 볼게..."
$buy_quote['tf_teatr'] = '[마샤]<br>&nbsp;고마워, <<$master_name>>! 이 여자애면 완벽하겠어. 내가 데려갈게!...'
$refuse_skill_quote['tf_teatr'] = '[마샤]<br>&nbsp;네 여자애는 내가 필요한 걸 아무것도 할 줄 모르잖아...'
$refuse_level_quote['tf_teatr'] = '[마샤]<br>&nbsp;이 여자애의 전체 수준이 요구 기준에 못 미쳐. 게다가 난 질 좋은 상품에 돈을 내는 거고...'
$refuse_charm_quote['tf_teatr'] = '[마샤]<br>&nbsp;전반적으로는 괜찮아 보이지만, 내 눈길을 딱히 끌진 않네...'
$refuse_health_quote['tf_teatr'] = '[마샤]<br>&nbsp;건강해 보이지 않잖아, <<$master_name>>! 게다가 난 저 애를 치료해 줄 처지도 아니야. 이 애는 안 되겠어...'
$refuse_pregnant_quote['tf_teatr'] = '[마샤]<br>&nbsp;임신한 설녀을 저 괴물 자지에 태운다고... 농담하는 거야, <<$master_name>>?'
$refuse_again_quote['tf_teatr'] = '[마샤]<br>&nbsp;솔직히 말하지. 마음에 안 들어. 그러니 이 여자애는 받지 않겠어.'
! JO9 MOD END J9M1817

$npc_image['Snegurka'] = 'Snegurka'
$npc_name['Snegurka'] = '스네구르카'
$npc_status['Snegurka'] = '산타클로스의 손녀'
$npc_alignment['Snegurka'] = 'Neutrals'
$npc_info['Snegurka'] = '  처음 스네구르카가 안개에 삼켜졌을 때, 그녀는 몹시 힘든 시간을 보냈다. 한동안은 이리저리 사람 손을 떠돌아다녔다. 기쁨과 축제를 가져다주던 수수하고 얌전한 여자애는, 거의 욕정에 찬 길거리 창녀로 변할 뻔했다. 오직 할아버지의 때맞춘 개입과 몇몇 영향력 있는 후원 덕분에 설녀은 비극적인 운명을 피할 수 있었고, 그것이 지금의 존중받는 지위에도 도움이 되었다....'
demand_rating['Snegurka'] = 8
$interesting_specialisation['Snegurka'] = 'refferent'
$diary_mark['Snegurka'] = "   <<$npc_name['Snegurka']>>. 겨울 동화."
! JO9 MOD START J9M1816 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Snegurka_pref[1] = "[스네구로치카]<br>&nbsp;안녕, <<$master_name>>! 그런데 당신은 어떻게 도미나 설녀의 고통의 방까지 오게 된 거야?!<br>[당신]<br>&nbsp;재밌네! 세상에 기쁨과 축제를 가져다주던 달콤하고 수수한 생물이 잔혹한 도미나가 되다니?! 뭐, 인정하자면 그 복장은 꽤 괜찮아... 게다가 어디서 본 적도 있는 것 같고..."
$Snegurka_pref[2] = "[스네구로치카]<br>&nbsp;이건 제 좋은 친구이자 멘토에게 받은 선물이야. 그런데 너도 그녀를 알걸. 이름은 안젤리카. 네 동료지.<br>[당신]<br>&nbsp;진심이야?! 안젤리카 친구들은 전부 자기 개인 아첨꾼들뿐이잖아! 다른 친구는 없다고... 아아아! 아, 물론이지!!! 이제야 전부 기억났어!..."
$Snegurka_pref[3] = "[당신]<br>&nbsp;혹시 길드 신년 기업 파티에서 자기 친구를 직접 시중들던 애가 너 아니야?! 그때는 고문들마다 개인 설녀 하나씩 배정됐고, 다들 딱 이런 복장을 입고 있었지... 그리고 그 설녀들 가운데, 그날 밤 내내 오직 안젤리카에게만 몸을 대주던 수줍은 금발 여자애가 하나 있었잖아..."
$Snegurka_pref[4] = "[당신]<br>&nbsp;...게다가 그때, 홍등가 어딘가에서 새 보지 핥개 하나를 구했다는 소문도 돌았지...<br>[스네구로치카]<br>&nbsp;쉿, <<$master_name>>! 그렇게 크게 말하지 마... 누가 들을 수도 있잖아... 맞아. 그게 나였어. 그리고 그 소문도 부분적으로는 사실이야..."
$Snegurka_pref[5] = "[당신]<br>&nbsp;...그런데 잠깐만! 얼굴 좀 보여 봐!... 역시!!! 내가 왜 이걸 바로 생각 못 했을까!!! 그때 경매에서 널 위해 50,000 스파크를 낸 그 수수께끼 같은 인물이 안젤리카였잖아! 네 할아버지랑 걔가 모두를 속인 거였어... 그리고 솔직히 고백하자면, 다시 널 보게 될 줄은 전혀 몰랐지. 그 순간 전까진, 난 네가 진짜 그 애가 아니라고 생각했거든..."
$Snegurka_pref[6] = "[스네구로치카]<br>&nbsp;나도 널 바로 기억해 내진 못했어, <<$master_name>>!... 그리고 어쨌든 난 그 모든 일들을 나쁜 꿈처럼 잊고 싶어! 물론 이제 기억을 전부 지워 버릴 순 없고, 슐랴프킨 덕분에 난 그때 많이 변했지만, 그래도 아직 잊을 수 있는 건 절대 떠올리고 싶지 않아. 그리고 그때 내게 무슨 일이 있었는지 아무도 알아선 안 된다는 건, 너도 완벽하게 이해하고 있잖아!..."
$Snegurka_pref[7] = "[스네구로치카]<br>&nbsp;그러니 그런 거야. 그리고 당신은 내 작은 비밀들을 알고 있지, <<$master_name>>. 그래서 제안 하나 할게. 내가 네게 펠라를 해 줄게.. 정말 끝내주는 펠라를. 누구도 네게 그런 펠라는 해 준 적 없을 거야... 그 대신, 당신은 아무것도 모르는 척하는 거야! 어때, 합의?!... 아니라고?!... 좋아, 그럼 내가 해 줄게... 뭐, 그것도 안 돼?!... 좋아... 기억이 돌아오면 우리 한 번 더 하자... 어때, 합의?!... 좋아, 아주 훌륭해!"
$Snegurka_pref[8] = "[스네구로치카]<br>&nbsp;뭐, 기왕 일 얘기가 나왔으니, 작고 소박한 부탁 하나만 더 해도 될까... 난 <<$slave_type_name[$interesting_specialisation['Snegurka']]>> 전공의 <<$rating[demand_rating['Snegurka']]>> 등급 이상의 여자애가 필요해. 그런 여자애라면 <<common_price[demand_rating['Snegurka']]>> 스파크쯤은 얼마든지 구할 수 있어. 난 정말 그 애가 필요해. 내 작은 크리스마스 트리들, 내 사랑스러운 제자들 말이야. 걔들은 정말 멋져! 분명 수요도 엄청날 거야..."
$Snegurka_pref[9] = "[스네구로치카]<br>&nbsp;난 사무적인 일은 정말 하나도 몰라. 그러니까 협상을 이해하는 조수가 있으면 이 문제에 큰 도움이 될 거야... 설마 너한텐 그게 그렇게 큰 골칫거리도 아니겠지? 그런 여자애 하나 준비해 줄 수 있지? 정말 네 도움을 기대하고 있어, <<$master_name>>!..."
$Snegurka_pref[10] = "[스네구로치카]<br>&nbsp;자, 이제 우리 첫 번째 약속으로 돌아가자... 욜카, 문 잠가! 아무도 우릴 방해하지 않았으면 좋겠어... 바지 벗어, <<$master_name>>! 아니면... 내가 직접 벗겨 줄까..."
$Snegurka_otkaz[1] = "[스네구로치카]<br>&nbsp;<<$master_name>>, 난 아직 새 여자애는 필요 없어. 네가 전에 붙여 준 애 하나면 충분하거든... 아니면, 설마 네가 온 이유가 그게 아니었던 거야?!..."
$buy_quote['Snegurka'] = '[스네구로치카]<br>&nbsp;고마워, <<$master_name>>! 좋은 여자애라는 게 딱 보여. 겉모습도 단정하고. 받겠어!'
$refuse_skill_quote['Snegurka'] = '[스네구르카]<br>&nbsp;기술을 더 다듬어야겠네. 네 여자애는 필요한 걸 아무것도 할 줄 모르잖아...'
$refuse_level_quote['Snegurka'] = '[스네구르카]<br>&nbsp;이 여자애의 전체 수준이 요구 수준에 못 미쳐. 그래도 난 질 괜찮은 상품값은 내는 거라고...'
$refuse_charm_quote['Snegurka'] = '[스네구로치카]<br>&nbsp;전반적으로는 괜찮아 보여도, 딱히 내 시선을 붙잡진 못하네...'
$refuse_health_quote['Snegurka'] = '[스네구로치카]<br>&nbsp;건강해 보이지 않잖아, <<$master_name>>! 게다가 난 저 애를 치료해 줄 처지도 아니야. 난 여자애를 사서 스파크를 벌려는 거지, 낭비하려는 게 아니라고...'
$refuse_pregnant_quote['Snegurka'] = '[스네구로치카]<br>&nbsp;모든 여자의 꿈이 아이를 갖는 거라는 건 나도 알아. 하지만 난 지금 그건 정말 필요 없어...'
$refuse_again_quote['Snegurka'] = '[스네구로치카]<br>&nbsp;솔직히 말할게. 난 마음에 안 들어. 그리고 그건 어쩔 수 없을 것 같아. 그러니 이 여자애는 받지 않겠어.'
! JO9 MOD END J9M1816

$npc_image['Santa'] = 'Santa'
$npc_name['Santa'] = '산타클로스'
$npc_status['Santa'] = '새해를 지키는 할아버지들 중 하나.'
$npc_alignment['Santa'] = 'Neutrals'
$npc_info['Santa'] = ' '
demand_rating['Santa'] = 5
$interesting_specialisation['Santa'] = 'custom'
$diary_mark['Santa'] = "   <<$npc_name['Santa']>>."
$npc_preferences['Santa'] = {
stat_importance['cook'] > 3
stat_importance['calisthenics'] > 3
stat_importance['music'] > 3
stat_importance['oral'] > 4
stat_importance['penetration'] > 4
stat_importance['petting'] > 4
stat_importance['roleplay'] > 4
}
$buyer_demand['Santa'] = {
demand['min_beauty'] > 3
demand['min_stamina'] > 3
demand['max_boobs'] = 3
}
! JO9 MOD START J9M1815 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Santa_pref[1] = '[산타클로스]<br>&nbsp;안녕, <<$master_name>>! 널 보게 돼서 정말 반갑구나! 새해와 크리스마스가 코앞인데, 여기 완전히 난장판이야. 얼마나 심각한지 당신은 상상도 못 할 거다...'
$Santa_pref[2] = ' 얼마 전, 나와 내 동료들은 어쩌다 보니 여기 오게 됐지. 뭐, 각자 생활도 어느 정도 정리하고, 할 일도 나눴어. 말하자면 이 새로운 현실에 적응한 거지... 그런데 그러고 나니, 이번만큼은 일을 하며 명절을 보내는 게 아니라 우리끼리 오붓하게, 제대로 즐길 좋은 기회라는 게 분명해졌단 말이야...'
$Santa_pref[3] = ' 뭐... 난 순록들과 말들에게 할 일을 내려놨고, 이젠 마음 놓고 잘 수 있어. 걔들은 다행히도 기본적인 지시는 충분히 해낼 만큼 똑똑하거든. 우린 크리스마스 트리 몇 개에 불이나 켜고, 손님 맞이할 마당만 좀 깨끗이 해 두면 돼... 그러니 좀 쉬어도 되지 않겠나...'
$Santa_pref[4] = ' 그래서 우린 이번엔 아주 근사하게 해 보자고 했어. 그런데 시작부터 다 꼬여 버렸지... 제일 먼저 그 러시아 구울 놈이 나타났어... 명절용 고급 술을 사 온다면서 우리한테서 5,000스파크를 걷어 가더니, 그대로 감쪽같이 사라져 버린 거야... 순록들이 걜 시내 어디선가, 동네 걸레들이랑 어울려 있는 걸 봤다더군. 엄청 취해 있었다고 해. 목욕탕에 갈 준비를 하고 있었다나 봐. 그런데 아직도 안 간 모양이야. 난 목욕탕은 다 뒤졌는데, 어디에도 없더라고.'
$Santa_pref[5] = ' 그리고 그 착한 양반들 말이지... 욜루푸키와 바보 나탈레 말이야, 걔들은... 이사 오자마자 바로 꼬여 버렸어. 걔들은 무슨 스케줄표대로 사는 사람들 같아. 그러니까, 모든 일엔 때가 있다 이거지. 남들이 다 잘 때 깨어 있고, 술도 핀란디아랑 마르티니 비앙코만 마셔... 한마디로, 완전히 답이 없어... '
$Santa_pref[6] = ' 그리고 그 아시아 동료들도 완전 난장판이야... 셩단 라오런과 오지상은 저택에서도 제일 외진 구석을 골라, 거길 초랑 이상한 조각상이며 잡동사니로 채워 놨어. 둘이 마주 보고 요가 자세로 앉아 웅웅거리고만 있지... 불러도 눈 하나 깜빡 안 해. 눈길 한 번 안 주고 있어. 벌써 두 달째 저렇게 웅웅대고만 있다고... '
$Santa_pref[7] = ' 그리고 집에 멀쩡한 여자도 하나도 안 남았어. 그 러시아 놈은 자기 손녀를 도미나로 만들어 버렸지. 그 얘긴 너도 벌써 들었을 거다. 이젠 작은 탑에 틀어박혀서 작은 크리스마스 트리 여자애들을 훈련시키고 있어. 그리고 내 손녀는 핀란드 여자랑 이탈리아 여자하고 어울리다가 된통 망가졌고. 둘이 어딘가에 내다 버려 놨는데, 지금은 행방도 몰라. 집안일 도와줄 사람도 하나 없어서 나 혼자 뛰어다니고 있다니까... '
$Santa_pref[8] = ' 그래서, 내가 왜 널 필요로 하느냐 하면... 아무튼, 최근에 우리한테 흑인 동료가 있다는 걸 알게 됐어. 이름은 자르 할아버지라고 하더군. 그래, 그도 안개 어딘가에서 어슬렁대고 있대. 난 올드 스파이스 냄새를 분명히 맡을 수 있어. 말로는 그 사람 말이 거꾸로 달린다더군. 아마 그래서 안개를 못 빠져나오는 거겠지. 하지만 언젠간 어떤 식으로든 우리 영지에 도착할 거라고 생각해... 그리고 바로 거기서 네 도움이 필요해... '
$Santa_pref[9] = ' 우리에겐 명절을 자기 여자들과 함께 보내는 전통이 있어. 평범한 사람들처럼 자리에 앉고, 그다음엔... 뭐, 알잖아... 문제는 자르에겐 자기 여자 하나 없다는 거야. 그래서 내가 선물 하나 해 주려는 거지... 도와줄 수 있겠나? '
$Santa_pref[10] = ' 난 젊고, 적당히 <font color="#008000"><b>매력적이고</b></font>, <font color="#008000"><b>강하고</b></font>, 무엇보다 <font color="#008000"><b>잘 대주는</b></font> 여자애가 필요해. 경험 없는 애는 그 사람한테 문제가 생길 수도 있을 것 같거든. 괜히 자기 여자가 없는 게 아니니까. 가슴도 풍만해야 하고, 약간이라도 <font color="#008080"><b>예술 감각</b></font>이 있으면 좋겠어. 온갖 노래도 부를 줄 알아야 하고, 몸도 잘 움직여야 해. 그리고 뭐, <font color="#008080"><b>요리도 할 줄 알아야</b></font> 하고... 적어도 집에서 누군가는 제대로 된 음식을 해 줘야 하지 않겠나. 코카콜라랑 맥도날드 때문에 속이 쓰려 죽겠어. 대충 이 정도다.'
$Santa_pref[11] = ' 이런 주문, 해낼 수 있겠나? 난 꼭 은혜를 갚겠다...'
$buy_quote['Santa'] = '[산타클로스]<br>&nbsp;이 설녀라면 산타클로스를 분명 만족시킬 거다! 받겠어!... 이 스파크로 네 모든 수고가 조금은 보상되겠지. 올해 당신은 착한 아이였으니, 집에 가면 크리스마스 트리 아래 내 특별한 선물이 널 기다리고 있을 거다... 새해 복 많이 받고 메리 크리스마스다, <<$master_name>>!'
$refuse_skill_quote['Snegurka'] = '[산타]<br>&nbsp;기술을 더 다듬어야겠군. 네 여자애는 필요한 걸 아무것도 할 줄 모르잖아...'
$refuse_level_quote['Snegurka'] = '[산타]<br>&nbsp;이 여자애의 전체 수준이 요구 수준에 못 미쳐. 그래도 난 질 괜찮은 상품값은 내는 거라고...'
$refuse_charm_quote['Snegurka'] = '[산타]<br>&nbsp;전반적으로는 괜찮아 보여도, 딱히 내 시선을 붙잡진 못하네...'
$refuse_health_quote['Snegurka'] = '[산타]<br>&nbsp;건강해 보이지 않잖아, <<$master_name>>! 게다가 난 저 애를 치료해 줄 처지도 아니야. 난 여자애를 사서 스파크를 벌려는 거지, 낭비하려는 게 아니라고...'
$refuse_pregnant_quote['Snegurka'] = '[산타]<br>&nbsp;모든 여자의 꿈이 아이를 갖는 거라는 건 나도 알아. 하지만 난 지금 그건 정말 필요 없어...'
$refuse_again_quote['Snegurka'] = '[산타]<br>&nbsp;솔직히 말할게. 난 마음에 안 들어. 그리고 그건 어쩔 수 없을 것 같아. 그러니 이 여자애는 받지 않겠다.'
