$Varvar_king_pref[1] = '[바르바르 왕]<br>&nbsp;반갑다, <<$master_name>>! 내 조언자들이 자네를 어떤 대가를 치르더라도 결과를 내는 숙련된 조련사라고 추천하더군. 마음에 드는군.'
$Varvar_king_pref[2] = '[바르바르 왕]<br>&nbsp;나는 역사에 남을 왕국을 세우고 싶지만, 후계자가 없다. 내 왕비가 되겠다는 것들은 허세만 가득한 멍청이거나, 정상적인 아들을 낳을 수조차 없을 만큼 왜소한 것들뿐이더군.'
$Varvar_king_pref[3] = '[바르바르 왕]<br>&nbsp;한 가지 일에서 자네 도움이 필요하다. 내게는 후계자가 필요하지만, 그걸 신들의 뜻이나 자기가 나보다 똑똑하다고 여기는 다른 존재들의 뜻에 맡기고 싶진 않다! 더구나 내 후계자를 낳은 여자가 나를 좌지우지하게 두고 싶지도 않고.'
$Varvar_king_pref[4] = '[바르바르 왕]<br>&nbsp;그래서 내 아이를 낳을 수 있는 <font color="#008080"><b>건강한</b></font> 노예가 필요하다. 그에 더해, 그녀가 <font color="#0000CD"><b>쓸모 있고</b></font>, <font color="#008080"><b>노래하고 춤출</b></font> 줄 알며, <font color="#008080"><b>아름다움</b></font>과 <font color="#0000CD"><b>이국적인 외모</b></font>로 내 눈을 즐겁게 해 주길 바란다.'
$Varvar_king_pref[5] = '[바르바르 왕]<br>&nbsp;아, 그래! 우리 법에 따르면 결백한 여자에게서 태어난 아이만이 후계자로 인정될 수 있다. 그리고 또 하나, 나는 미숙한 어린 여자는 필요 없다. 전성기의, 강하고 건강한, <font color="#008080"><b>숙련되고</b></font> 순종적인 노예가 필요하다.'
$buy_quote['Varvar_king'] = '[바르바르 왕]<br>&nbsp;첫눈에 봐도 알겠군 - 이게 바로 내가 원하는 거다. 금고지기가 자네에게 필요한 만큼 지불할 것이다.'
$refuse_skill_quote['Varvar_king'] = '[바르바르 왕]<br>&nbsp;난 많은 걸 요구한 것도 아니다. 거의 아무것도 아니지. 그런데 그것조차 못 한다니. 날 실망시키지 마라, <<$master_name>>. 난 엄연한 VIP 손님이니까.'
$refuse_level_quote['Varvar_king'] = '[바르바르 왕]<br>&nbsp;말해 봐라, 이게 VIP에게 어울리는 상품이냐? 아니지, 당연히 아니야. 내가 왜 이렇게 많은 스파크를 내야 하지? 적어도 이런 것 때문은 아니다. 꿈도 꾸지 마라.'
$refuse_charm_quote['Varvar_king'] = '[바르바르 왕]<br>&nbsp;말하자면, <<$master_name>>, 그녀는 예쁜 여자다... 하지만 내가 원하는 건 아니군.'
$refuse_health_quote['Varvar_king'] = '[바르바르 왕]<br>&nbsp;얘가 출산을 버텨 내긴 하겠나? 좀 창백하고 상태도 그리 좋아 보이지 않는군... 난 이런 건 확실히 필요 없다.'
$refuse_pregnant_quote['Varvar_king'] = '[바르바르 왕]<br>&nbsp;내가 여자에게 바란 건 오직 하나다 - 내게 건강한 후계자를 낳아 주는 것... 그런데 이미 임신한 걸 데려오다니?! 대체 이게 무슨 소리냐?!'
$refuse_special_quote['Varvar_king'] = '[바르바르 왕]<br>&nbsp;안 된다.'
! JO9 MOD END J9M2020
 
 
