$npc_image['rafael'] = 'rafael'
$npc_name['rafael'] = '라파엘'
$npc_status['rafael'] = '(중립파)'
$npc_info['rafael'] = '선원이자 항구 대장의 아들이다. 항구 업무를 실질적으로 관리하면서 자기 사업도 운영하고 있다.'
npc_attitude['rafael'] = 11

$npc_image['ledy_karina'] = 'ledy_karina'
$npc_name['ledy_karina'] = '레이디 카리나'
$npc_status['ledy_karina'] = '(중립파)'
$npc_info['ledy_karina'] = ''
npc_attitude['ledy_karina'] = 30

$npc_image['vampire_twins'] = 'vampire_twins'
$npc_name['vampire_twins'] = '뱀파이어 쌍둥이'
$npc_status['vampire_twins'] = '(중립파)'
$npc_info['vampire_twins'] = '소문에 따르면, 마음에 들지 않는 외모의 노예는 처벌한다고 한다.'
npc_attitude['vampire_twins'] = 11

$npc_image['dumak'] = 'dumak'
$npc_name['dumak'] = '두막'
$npc_status['dumak'] = '(중립파)'
$npc_info['dumak'] = '포션 거래에 실패한 뒤 빈민가에 숨어 지내는 고블린 연금술사다.'
npc_attitude['dumak'] = 30

$npc_image['moranga'] = 'moranga'
$npc_name['moranga'] = '모랑가'
$npc_status['moranga'] = '(중립파)'
$npc_info['moranga'] = '영혼을 수집하고 기이한 것을 사랑하는 자다. 한때 절망한 마법사 하나가 악마에게서 힘을 구했다. 그가 어떻게 되었는지는 아무도 모르지만, 그가 소환한 존재가 지금 네 앞에 서 있다.'
npc_attitude['moranga'] = 11

$npc_image['ladonna'] = 'ladonna'
$npc_name['ladonna'] = '라도나'
$npc_status['ladonna'] = '(중립파)'
$npc_info['ladonna'] = '이국적인 취향을 지닌 부유한 과부다. 소문에 따르면 그녀의 남편은 결혼 첫날밤에 죽었다고 한다—늙은 심장이 그녀의 뜨거운 기질을 버티지 못했던 것이다. 영원의 도시 로마에서는 이런 "우연"이 드문 일이 아니다.'
npc_attitude['ladonna'] = 30

$npc_image['yagishna'] = 'yagishna'
$npc_name['yagishna'] = '노파 야기슈나'
$npc_status['yagishna'] = '(중립파)'
$npc_info['yagishna'] = '"뼈다리" 상점의 주인이다. 한때 강력한 마녀였지만, 안개 속에 들어오며 힘을 잃었다. 교활함으로 언데드들의 비호를 얻어 네크로폴리스에 정착했고, 자신의 가게를 열었다. 산 자들과의 거래는 더뎌서, 지금은 잠시 빈민가로 자리를 옮겼다.'
npc_attitude['yagishna'] = 30

$npc_image['dragon'] = 'dragon'
$npc_name['dragon'] = '사나운 코린스트라즈'
$npc_status['dragon'] = '(중립파)'
$npc_info['dragon'] = '중간 크기의 검은 드래곤이다. 머리는 굽은 뿔로 보호되고 있고, 긴 꼬리 끝에는 치명적인 독침이 달려 있다. 소문에 따르면 코린스트라즈는 드래곤 여왕에게 반역해 씨족에서 추방되었다고 한다. 야심가인 그는 필요하다면 필멸자들을 이용해서라도 자신만의 대가문을 세우려 한다.'
npc_attitude['dragon'] = 21

$npc_image['mouse_king'] = 'mouse_king'
$npc_name['mouse_king'] = '생쥐 왕'
$npc_status['mouse_king'] = '(중립파)'
$npc_info['mouse_king'] = '"회색" 민족의 진정한 지배자이자 "일곱 머리와 세 꼬리" 기사단의 대마스터라고 자처한다. 그는 스파크를 다루며 빈민가에서도 멀쩡히 살아 있다. 그게 진실의 증거인지, 단순한 행운인지는 알 수 없지만.'
npc_attitude['mouse_king'] = 11

$npc_image['markel'] = 'markel'
$npc_name['markel'] = '마르켈'
$npc_status['markel'] = '(중립파)'
$npc_info['markel'] = '황소 구역에서 명성을 얻은 치유사다. 왕조차 그의 도움을 구했다는 말이 있다. 그의 저택이 공격당해 모든 시종이 죽은 뒤, 그는 동방 구역으로 옮겨 갔다. 지금 무슨 일을 하는지는 알려지지 않았지만, 스파크가 모자라진 않는다.'
npc_attitude['markel'] = 11

$npc_image['baldita'] = 'baldita'
$npc_name['baldita'] = '발디타'
$npc_status['baldita'] = '(중립파)'
$npc_info['baldita'] = '강령술사이자 안개의 신봉자다. 그녀는 안개를 신성한 것으로 여기며, 기도와 희생을 바친다. 그녀는 배교자들을 되살려 부린다. 소문에 따르면 동방 구역의 부유한 주민 하나를 도와준 덕분에, 그곳에 살며 가르칠 수 있는 허가를 얻었다고 한다.'
npc_attitude['baldita'] = 11

$npc_image['Gennay'] = 'Gennay'
$npc_name['Gennay'] = '겐나이'
$npc_status['Gennay'] = '(중립파)'
$npc_info['Gennay'] = '어떤 계층에서는 제법 유명한 작가다. 매력적인 소설가와 낭만적인 불장난을 꿈꾸는 부유한 여자들(그리고 그만큼 부유하지 않은 여자들) 사이에서 인기가 많다.'
npc_attitude['Gennay'] = 30

$npc_image['oilokan'] = 'oilokan'
$npc_name['oilokan'] = '오일로칸'
$npc_status['oilokan'] = '(중립파)'
$npc_info['oilokan'] = '부유한 상인의 아내로, 매력적인 여자들을 싫어하며 온갖 독에 능하다.'
npc_attitude['oilokan'] = 30

$npc_image['Deming'] = 'Deming'
$npc_name['Deming'] = '데밍'
$npc_status['Deming'] = '(중립파)'
$npc_info['Deming'] = '자신이 직접 만든 흡연 혼합물을 파는 가게의 주인이다. 예전에는 밀수꾼이었지만, 몇 번의 성공적인 거래 뒤에 은퇴했다. 가끔은 그 선택을 후회하기도 한다.'
npc_attitude['Deming'] = 30
$npc_image['anameleh'] = 'anameleh'
$npc_name['anameleh'] = '아나멜레'
$npc_status['anameleh'] = '(중립파)'
$npc_info['anameleh'] = '원래 세계에서 아나멜레와 그의 어린 여동생은 신들의 마지막 살아남은 후손이었고, 필멸자들에게 악마로 사냥당했다. 그들의 마지막 피난처를 집어삼킨 안개는 저주가 아니라 축복이 되었다. 로마에서 아나멜레와 하사는 귀족들과 파트리키들 사이에서 호의를 얻었다. 그들은 어떤 상인 길드와 연결되어 있으며, 비밀스러운 클럽에 속해 있다.'
npc_attitude['anameleh'] = 30

$npc_image['Hassa'] = 'Hassa'
$npc_name['Hassa'] = '하사'
$npc_status['Hassa'] = '(중립파)'
$npc_info['Hassa'] = '원래 세계에서 하사와 그녀의 오빠는 신들의 마지막 살아남은 후손이었고, 필멸자들에게 악마로 사냥당했다. 그들의 마지막 피난처를 집어삼킨 안개는 저주가 아니라 축복이 되었다. 로마에서 아나멜레와 하사는 귀족들과 파트리키들 사이에서 호의를 얻었다. 그들은 어떤 상인 길드와 연결되어 있으며, 비밀스러운 클럽에 속해 있다.'
npc_attitude['Hassa'] = 30

$npc_image['Fyrgin'] = 'Fyrgin'
$npc_name['Fyrgin'] = '피르긴'
$npc_status['Fyrgin'] = '(중립파)'
$npc_info['Fyrgin'] = '거만한 강령술사와 불화를 겪은 뒤 동방 구역으로 옮겨 온 젊은 마녀다. 사람보다 자신이 돌보는 대상들을 더 좋아하며, 새들이 그녀 주변에서 자유롭게 돌아다니도록 내버려 둔다.'
npc_attitude['Fyrgin'] = 30

$npc_image['Uzeji'] = 'Uzeji'
$npc_name['Uzeji'] = '우제지'
$npc_status['Uzeji'] = '(중립파)'
$npc_info['Uzeji'] = '동방 구역에서 존경받는 고대 여우 정령의 조수이자 대변인이다. 어떤 이들은 그녀가 사람들을 속이고 있다고 말한다. 그 여우는 진짜 변신술사가 아니라 잘 길들여진 동물일 뿐일 수도 있기 때문이다.'
npc_attitude['Uzeji'] = 30

$npc_image['Ritegreu'] = 'Ritegreu'
$npc_name['Ritegreu'] = '이르구테긴 & 리테그레우'
$npc_status['Ritegreu'] = '(중립파)'
$npc_info['Ritegreu'] = '이르구테긴의 부모는 수수께끼 같은 죽음을 맞았다—그의 어머니는 공식 만찬 도중 실신한 뒤 다시 의식을 찾지 못했고, 아버지는 빈민가에서 시체로 발견되었다. 리테그레우는 그의 하인 노릇을 하고 있지만, 실제로는 그를 돌보고 있는 먼 친척이다.'
npc_attitude['Ritegreu'] = 12

$npc_image['Netsumi'] = 'Netsumi'
$npc_name['Netsumi'] = '네츠미'
$npc_status['Netsumi'] = '(중립파)'
$npc_info['Netsumi'] = '대부분의 비인간들과 달리 평범한 인간들에게 공감하는 젊은 여우 변신술사다. 그녀는 인간들을 우습고 흥미로운 존재로 여긴다. 지금 동방 구역에서 찻집을 열려고 애쓰고 있지만, 아직은 잘 풀리지 않고 있다.'
npc_attitude['Netsumi'] = 30

$npc_image['Gadanfar'] = 'Gadanfar'
$npc_name['Gadanfar'] = '가단파르'
$npc_status['Gadanfar'] = '(중립파)'
$npc_info['Gadanfar'] = '말과 전차 경주에 빠진 열광자다. 한때는 난코스를 정복하고 경쟁자들을 뒤에 남겨 두는 것으로 유명했지만, 심각한 사고에서 살아남은 뒤로는 큰 부상을 안고 있다.'
npc_attitude['Gadanfar'] = 11

$npc_image['veineut'] = 'veineut'
$npc_name['veineut'] = '베이네우트'
$npc_status['veineut'] = '(중립파)'
$npc_info['veineut'] = '"BPHMT" 갱 소속 현상금 사냥꾼이다. 영리하고 고집이 세며, 곤란한 처지의 젊은 여자들을 돕는 걸 즐긴다. 남자 상대는 좀 더 까다롭지만, 스파크가 있으면 대개 다 풀린다.'
npc_attitude['veineut'] = 11

