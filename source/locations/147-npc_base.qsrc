 gs '$newloc'
 copyarr '$text', '$doagirls_branded'
END


$npc_image['noemi'] = 'noemi'
$npc_name['noemi'] = '노에미'
$npc_status['noemi'] = '제빵사 (중립파)'
$npc_alignment['noemi'] = 'centralkvartal'
$npc_info['noemi'] = '"갓 구운 빵" 제과점의 총주방장이다. 겉보기엔 그저 제빵과 우스운 노래에만 신경 쓰는 순진하고 걱정 없는 여자아이처럼 보인다. 하지만 그녀를 괴롭히던 사람들은 결국 하나둘 사라지고, 심지어 제과점 주인들조차 그녀를 조금 무서워하는 듯하다. 여기서 고기 파이는 안 사 먹는 게 좋을지도 모른다.'
demand_rating['noemi'] = 8
$interesting_specialisation['noemi'] = 'servant'
$npc_preferences['noemi'] = {
stat_importance['service'] = 4
stat_importance['cook'] = 5
stat_importance['intellect'] = 4
}
npc_attitude['noemi'] = 30
npc_reveal['noemi'] = 1
npc_bennies['noemi'] = 6
npc_reward['noemi'] = 200
npc_advance['noemi'] = 150
demand_rating['noemi'] = 8
buying_temp['noemi'] = 25
count_size['noemi'] = 1
$buyer_demand['noemi'] = {
demand['refuse_age'] = 1
demand['min_stamina'] = 4
}
! JO9 MOD START J9M1891 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$noemi_pref[1] = '[노에미]<br>&nbsp;밤낮으로 맷돌은 돌아가네... 아, 안녕, <<$master_name>>, 네 더 진지한 일을 방해해서 미안하지만, 보다시피 우리 빵은 수요가 엄청나고 일손은 부족해. 하하, 수요는 엄청나고 부족하다니? 참 아이러니하지.'
$noemi_pref[2] = '[노에미]<br>&nbsp;맞아, 짐작했겠지만, 난 그저 통조림을 접시에 퍼 담는 여자애가 아니라, <font color="#008000"><b>진짜로 요리할 줄 아는</b></font> 여자애들을 찾고 있어. 아, 그리고 가능하면 <font color="#008080"><b>걸레 쥐는 것도 겁내지 않는</b></font> 애들이면 좋겠고. 무슨 뜻이냐고? 주방은 티 하나 없이 깨끗해야 하니까!'
$noemi_pref[3] = '[노에미]<br>&nbsp;난 <font color="#008080"><b>영리하고</b></font>, <font color="#008080"><b>끈질긴</b></font> 젊은 여자애들이나 성숙한 여자들이 필요해. 아이들은 안 써, 미안하지만. 그리고 멍청하지만 예쁘기만 한 애들도 안 돼... 하지만 주인은 쓸데없는 말엔 인색하거든. 뭐라고? 응, 응, 그게 다야. 가, 가. 요즘은 시간이 없어.'
! JO9 MOD END J9M1891


