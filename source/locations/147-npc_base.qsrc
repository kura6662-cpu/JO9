$Marquis_de_s_pref[1] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;순수함을 타락시키는 건 궁극의 쾌락이지. 그러니 네가 왜 이 일을 택했는지 난 이해한다. 너와 나는 거의 동업자나 마찬가지야. 다만 당신은 돈 때문에 하고, 난 내 즐거움을 위해 할 뿐이지.'
$Marquis_de_s_pref[2] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;다른 때였다면 직접 악덕의 세계로 입문시켜 그 추락을 내 눈으로 보고 싶어서 순진한 여자아이를 하나 주문했겠지. 하지만 난 최근에 하나 손에 넣었다. 그러니 대신 이런 경쟁을 제안하지. 네가 길러 낼 수 있는 한 최대한 <font color="#008080"><b>사악한 여자애</b></font>를 내게 줘. 그동안 누가 더 많은 걸 해내는지 비교해 보자고.'
$Marquis_de_s_pref[3] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;네가 상상할 수 있는 가장 <font color="#008000"><b>더러운 것들</b></font>을 그녀에게 훈련시켜라. 하지만 <font color="#008000"><b>평범한 성적 기술</b></font>도 잊지 마라. 동시에 그녀는 너무 성숙해서도, 너무 어려서도 안 되며, <font color="#008080"><b>아름다워야</b></font> 하고, <font color="#008000"><b>거리낌이 없어야</b></font> 하며, <font color="#008000"><b>예절</b></font>과 <font color="#008000"><b>음악 연주</b></font>도 익혀야 한다.'
$Marquis_de_s_pref[4] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;게다가 그녀는 <font color="#008000"><b>최대한 자유분방한 시각</b></font>을 가져야 해. 사소한 일로 내 다른 학생들과 충돌하는 건 원치 않으니까. 아, 맞다. 이름은 <b>줄리엣</b>이어야 한다.'
$Marquis_de_s_pref[5] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;날 놀라게 해 봐라, <<$master_name>>. 난 그 여자애를 위해 스파크를 아끼지 않을 거고, 백색 궁전에서 네 얘기도 몇 마디 해 주지! 너도 그런 게 필요하지?!...'
$buy_quote['Marquis_de_s'] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;흐음!... 오, <<$master_name>>, 제법 날 놀라게 했군! 이 여자애 마음에 들어! 트집 잡을 데도 없고! 난 확실히 데려가겠다! 자, 네 스파크다!...'
$refuse_skill_quote['Marquis_de_s'] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;글쎄, 솔직히 말해서 이런 여자애라니, <<$master_name>>! 게다가 아는 것도 너무 적군!...'
$refuse_level_quote['Marquis_de_s'] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;좋긴 하지, 그건 의심할 여지가 없어! 하지만 수준은 더 높을 수 있고, 그래야만 해! 가능성은 분명히 보이는군. 그러니 계속 다듬어라, <<$master_name>>!'
$refuse_charm_quote['Marquis_de_s'] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;아무리 내 말이 없어도, 모든 상품은 무엇보다 먼저 외형적으로 매력적이어야 한다는 걸 당신은 완벽히 이해하고 있을 줄 알았다! 설령 이 여자애가 완벽하게 준비되어 있다 해도, 난 개인적으로 쳐다보고 싶지도 않군...'
$refuse_health_quote['Marquis_de_s'] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;이 여자애는 분명 몸 상태가 좋지 않군, <<$master_name>>! 상태를 바로잡고 나서 다시 데려와라!...'
$refuse_pregnant_quote['Marquis_de_s'] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;<<$master_name>>, 내가 더러운 것에 잘 빠지는 사악한 여자애를 원한다고 했지, 대체 누구 씨인지도 모를 아이를 임신한 여자를 원한다고 한 건 전혀 아니야! 그런 건 나 혼자서도 충분히 할 수 있다고.!...'
$refuse_special_quote['Marquis_de_s'] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;나쁘지 않은 여자애군! 하지만 날 흥미롭게 만들 줄리엣은 아니야. 다른 애를 찾아와라!'
$Marquis_de_s_otkaz[1] = '[마르키 도나시앵 알퐁스 드 S]<br>&nbsp;지금은 새 여자애가 필요 없다, <<$master_name>>! 하지만 예를 들어 내일 무슨 일이 생길지는 알 수 없는 법이지. 가끔 들러라! 어쩌면 네게 일거리를 줄 수도 있으니까!...'
! JO9 MOD END J9M1814

