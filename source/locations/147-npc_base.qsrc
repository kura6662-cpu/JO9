npc_reveal['penelope'] = 1
npc_bennies['penelope'] = 6
npc_reward['penelope'] = 200
npc_advance['penelope'] = 150
demand_rating['penelope'] = 5
buying_temp['penelope'] = 25
count_size['penelope'] = 1
