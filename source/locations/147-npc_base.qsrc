$Barynya_pref[1] = '[바리냐]<br>&nbsp;뭐야, 내 남편이랑 수다 떨었나? 그 인간은 저런 창녀들도 모자라는 모양이더군, 알아. 근데 뭘 그렇게 쳐다봐, 착한 일이라도 하고 싶은 거야? 내겐 <font color="#0000CD"><b>여자</b></font>가 하나 필요해: <b>성숙하고</b>, <font color="#008080"><b>영리하고</b></font>, <font color="#008080"><b>기질도 있는</b></font> 여자로. 내가 두 번 말할 필요 없고, 모두를 손아귀에 넣을 수 있게 말이야. 제대로 된 보조가 필요해. <font color="#008000"><b>장부도 보고</b></font>, <font color="#008000"><b>청소도 하고</b></font>, <font color="#008000"><b>요리도 하고</b></font> 다른 것들도 가르칠 수 있게.'
$Barynya_pref[2] = '[바리냐]<br>&nbsp;그리고 가장 중요한 거. 머리에 똑똑히 넣어 둬. 난 <b>못생긴</b> 여자가 필요해. 이상하면 이상할수록 좋아. 우리 남편은 어떤 <font color="#0000CD"><b>이국적인</b></font> 것도 못 견디고, 못생긴 여자 근처엔 절대 안 가. 그게 내겐 더 낫거든.'
$buy_quote['Barynya'] = '[바리냐]<br>&nbsp;좋아, 그녀를 받겠어요. 여기 당신 스파크예요, 고마워요. 내 마음에 들었으면 좋겠네요!'
$refuse_skill_quote['Barynya'] = '[바리냐]<br>&nbsp;해야 할 일을 해낼 수 없는데 제가 왜 그녀를 필요로 하죠? 그런 상품엔 관심 없어요.'
$refuse_level_quote['Barynya'] = '[바리냐]<br>&nbsp;더 나은 여자애를 찾을 수 없나요? 등급을 생각하면 너무 비싸요.'
$refuse_charm_quote['Barynya'] = '[바리냐]<br>&nbsp;음… 모르겠네요. 형식상으론 맞지만, 너무 볼품없어 보여요. 매력도 부족하고요. 마음에 안 들어요.'
$refuse_health_quote['Barynya'] = '[바리냐]<br>&nbsp;무슨 수작을 부리려는 거죠? 그녀는 있어야 할 만큼 건강하고 활기차 보이지 않아요. 자칫하면 멀쩡히 못 나갈 줄 알아요!'
$refuse_pregnant_quote['Barynya'] = '[바리냐]<br>&nbsp;그래서, 임신한 노예를 저한테 팔고 그 처리까지 제가 하길 바라는 건가요? 절대 안 돼요!'
