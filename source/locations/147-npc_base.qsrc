! JO9 MOD START J9M2133 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$manhunter_talk[1] = '[맨 헌터]<br>&nbsp;가게 운영이 좋아지고 있으니, 슬슬 배달 사업을 해야겠네. <font color="#0000D8"><b>튼튼</b></font>하고, <font color="#0000D8"><b>영리</b></font>하고, <font color="#0000D8"><b>주관</b></font>있고 <font color="#6b0084"><b>매력적인</b></font> 여자로 말이지. 자세히 알려 달라고?</div>'
$manhunter_talk[2] = '[맨 헌터]<br>&nbsp;우선, 종일 서있어야 되니 <font color="#0000D8"><b>체형이</b></font> 좋으면 좋겠군. 과체중 저체중 노예는 이 일을 하기 좋지않아. 또 너무 감정적이지 않았으면, 지저분하고 무례한 고객을 많이 볼 테니까.</div>'
$manhunter_talk[3] = '[맨 헌터]<br>&nbsp;자신있고 오차없이 <font color="#0000D8"><b>사무 처리</b></font>하는 것도 중요하네. 거기에 떠듬대지 않고서 <font color="#0000D8"><b>명확히 말</b></font>해야 하고. 그래야 고객들이 배달원 태도에 만족할테지, 배달원이 내 가게 얼굴이잖나.</div>'
$manhunter_talk[4] = '[맨 헌터]<br>&nbsp;다른것에 구애받지 않고 배달원의 규칙을 준수하는, 그런 교육 상태도 중요해. 위험할 지 모르니 <font color="#6b0084"><b>호신술</b></font>도 필요할거야.</div>'
$manhunter_talk[5] = '[맨 헌터]<br>&nbsp;그래, 하나 더 있군. 난 대량 구매자에게 무료 <font color="#6b0084"><b>좆물리기</b></font>를 특별 제공할 생각이네. 그러니 할 줄 알아야만 해. 배달원의 입이 뭔지, 또 어디에 쓰는지 말이야.</div>'
$manhunter_talk[6] = '[맨 헌터]<br>&nbsp;작은 소망이 있는데, 간단하네. 그간 여유 자금이 없어 노예를 가질수가 없었으니 <font color="#6b0084"><b>요리와 가사일</b></font>을 할 줄 알고 <font color="#6b0084"><b>남자를 침대에서 다루는 법</b></font>과 재미를 위해 <font color="#6b0084"><b>음악</b></font>, <font color="#6b0084"><b>무용</b></font>도 할줄 알면 좋겠는 것.</div>'
$manhunter_talk[7] = '[맨 헌터]<br>&nbsp;뭐 피해야 할 것이라면, 다들 싫어하는. 뭔지 알잖나. 그래도 확실히 해주지. 이상 성욕자에는 관심없어. 마법을 부리는 년, 말과 치는 년, 뇌수술 받은 년들은 절대 안받아. 난 그저 평범한 배달원이 필요해.</div>'
! JO9 MOD END J9M2133
