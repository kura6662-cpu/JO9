! JO9 MOD START J9M2030 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$kotshey_pref[1] = '[불사의 코셰이]<br>&nbsp;<<$master_name>>, 공주를 훌륭하게 키워냈으니 내 주문을 또 하나 하지! 나한테 이렇게 아름다운 하녀가 생겼으니, 그 아이한테도 수발들 개인 노예가 하나쯤은 있어야지! 뭘 그렇게 빤히 봐, 시종이라고 부르면 될 것을... 쯧, 요즘 젊은것들은 당최 단어 쓸 줄을 몰라...'
$kotshey_pref[2] = '[불사의 코셰이]<br>&nbsp;잘 들어. <font color="#008080"><b>A등급</b></font>, 그 밑으로는 어림도 없다. 그녀는 우리 공주님을 모시게 될 몸이니까. <font color="#008080"><b>요리</b></font>도 훌륭해야 하고 <font color="#008080"><b>청소</b></font>도 잘해야 하며, 내가 어여뻐하는 그 아이를 <font color="#008080"><b>노래와 춤으로 즐겁게</b></font> 해줄 줄도 알아야 해.'
$kotshey_pref[3] = '[불사의 코셰이]<br>&nbsp;<font color="#008080"><b>아름답고</b></font>, <font color="#008000"><b>영리하고</b></font>, <font color="#0000D8"><b>순종적이어야</b></font> 한다. 또 <font color="#008000"><b>얌전하고</b></font>, <font color="#0000CD"><b>조용하며</b></font>, <font color="#008000"><b>날씬해야</b></font> 할 게야.' 
$kotshey_pref[4] = '[불사의 코셰이]<br>&nbsp;침대 속 사정이야... 그녀가 뭘 할 줄 알든 내 상관할 바 아니다만, 네놈이 요즘 유행시키는 그 기괴한 <font color="#cd0000"><b>변태 짓거리</b></font>만 없으면 돼. 그런 음탕한 기술 따위는 필요 없다. 난 정당하게 값을 치를 테니, 자네도 날 알지 않나. 여자애나 데려오게나 — 그러면 스파크(Spark)로 보상하지.'
$buy_quote['kotshey'] = '[불사의 코셰이]<br>&nbsp;호오, 대단한 여자로군! 아주 마음에 들어. 여기 네 스파크다. 수고했네.'
$refuse_skill_quote['kotshey'] = '[불사의 코셰이]<br>&nbsp;제 몫의 일도 제대로 못 해내는 녀석을 내가 뭐 하러 거두겠나? 그런 함량 미달인 상품엔 관심 없다.'
$refuse_level_quote['kotshey'] = '[불사의 코셰이]<br>&nbsp;더 나은 여자애는 없는 건가? 이딴 등급을 가지고 그 값을 받으려 들다니, 터무니없이 비싸군!'
$refuse_charm_quote['kotshey'] = '[불사의 코셰이]<br>&nbsp;음… 글쎄다. 형식상 조건이야 맞췄다지만 너무 볼품이 없지 않나. 매력이라고는 눈 씻고 찾아볼 수도 없군. 마음에 안 들어!'
$refuse_health_quote['kotshey'] = '[불사의 코셰이]<br>&nbsp;감히 나한테 무슨 뻔뻔한 수작을 부리려는 거냐?! 그 아이는 건강하지도, 활기차 보이지도 않는군. 섣부르게 놀렸다간 멀쩡히 걸어나가지 못할 줄 알아라!'
$refuse_pregnant_quote['kotshey'] = '[불사의 코셰이]<br>&nbsp;그러니까 지금, 배가 부른 노예를 나한테 떠넘기고 뒷처리까지 나더러 하라는 말이냐? 절대 안 된다!'
$refuse_special_quote['kotshey'] = '[불사의 코셰이]<br>&nbsp;내가 데려오라고 한 건 이런 녀석이 아니다!'
$refuse_again_quote['kotshey'] = '[불사의 코셰이]<br>&nbsp;안 된다는 건 안 되는 거다! 작작 굴어라!'
$refuse_special_quote['kotshey'] = '[불사의 코셰이]<br>&nbsp;내가 특별히 요구했던 조건들은 다 어디로 처먹었나?! 난 이런 녀석을 거둘 생각 없다!'
