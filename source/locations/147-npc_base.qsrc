$npc_image['master_skups'] = 'master_scoops'
$npc_name['master_skups'] = '마스터 스컵스'
$npc_status['master_skups'] = '노예상 조합 중역<br>중립'
$npc_info['master_skups'] = '   그는 감정 부서의 대표다. 그들은 노예를 직접 훈련하지는 않지만 시장을 아주 잘 알고 있으며, 어떤 고객에게든 가장 알맞은 노예를 고르는 법을 안다. 감정사들은 보통 노예를 팔지 않고 자문료만 받는다. 하지만 때때로 다른 이들보다 먼저 특별한 노예를 손에 넣어, 다른 노예상들에게 되팔기도 한다.'
npc_attitude['master_skups'] = 11

$npc_image['master_vong'] = 'master_vong'
$npc_name['master_vong'] = '웡 나으리'
$npc_status['master_vong'] = '노예상 조합 중역<br>중립'
$npc_info['master_vong'] = '<br> 판매부 대표.<br><br> 이 부서의 일원들은 노예 조교와 관련이 없다.<br><br> 그들은 상품간의 가격차에 투기를 하거나 도매계약을 맺거나 하는 쪽을 선호한다.<br><br> 뿐만 아니라, 이 부서는 경매를 주최하고 누구도 마음에 들어 하지 않는 값싼 노예들을 사들이기도 한다.'
npc_attitude['master_vong'] = 11
$npc_image['ваша_ассистентка'] = ''
$npc_name['ваша_ассистентка'] = '당신의 보조'
$npc_status['ваша_ассистентка'] = '노예<br>중립'
$npc_info['ваша_ассистентка'] = '   당신의 개인 보조다. 그저 노예일 뿐이지만, 제법 충성스럽고 믿을 만하다. 당신은 그녀에게 거의 어떤 명령이든 내릴 수 있다. 직접 훈련시켰기 때문에, 그녀의 강점과 약점을 당신은 이미 모두 알고 있다. 남들에게 개인 보조는 주인의 얼굴과도 같으니, 그녀는 가능한 한 최고의 인상을 줘야 한다.'
npc_attitude['ваша_ассистентка'] = 32

$npc_image['butcher'] = ''
