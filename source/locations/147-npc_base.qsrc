$Barin_pref[1] = '[바린]<br>&nbsp;뭐, 나리, 난 단순한 사람이오. 내 <font color="#008080"><b>여자애들</b></font> 봤지 않소? 다들 <font color="#008080"><b>혈색 좋고</b></font>, <font color="#008080"><b>건강하고</b></font>, 노래도 기막히오! 그런데 집사람이, 하느님 용서하시길, 애들을 너무 들들 볶는 바람에 늘 누가 하나씩 모자라오. 그러니 <b>젊은 여자애</b> 하나 데려오시오, 머리 땋은 게 허리까지 내려오고, 뭐든 제자리에 딱 갖춰져 있고, <font color="#008000"><b>노래도 하고</b></font> <font color="#008000"><b>춤도 추는</b></font> 애로.'
$Barin_pref[2] = '[바린]<br>&nbsp;그리고 봐, 여자는 많고 나는 혼자야, <b>우린 서로를 만족시킬 수 있어야</b> 해, 난 상관없고, 그들도 행복하지. 아, 그리고 <font color="#008000"><b>청소</b></font>, <font color="#008000"><b>요리</b></font>도, 물론이지, 그래야 내 충실한 이가 흠을 잡지 않으니까. 그래, 그리고 가장 중요한 건, <b>그녀는 개들을 사랑해야 해</b>. 그 암캐들이 자기 강아지들과 함께 있는 동안, 내 소년들은 지루하지 않을 테니까. 그럼, 잘 가.'
$buy_quote['Barin'] = '[바린]<br>&nbsp;좋아, 그녀를 받겠소. 여기 당신 스파크요, 고맙소. 내 마음에 들었으면 좋겠군!'
$refuse_skill_quote['Barin'] = '[바린]<br>&nbsp;해야 할 일을 해낼 수 없는데 내가 왜 그녀를 필요로 하겠소? 그런 상품엔 관심 없소.'
$refuse_level_quote['Barin'] = '[바린]<br>&nbsp;더 나은 여자애를 찾을 수 없소? 등급을 생각하면 너무 비싸오.'
$refuse_charm_quote['Barin'] = '[바린]<br>&nbsp;음… 모르겠군. 형식상으론 맞지만, 너무 볼품없어 보여. 매력도 부족하오. 마음에 안 드오.'
$refuse_health_quote['Barin'] = '[바린]<br>&nbsp;무슨 수작을 부리려는 거지? 그녀는 있어야 할 만큼 건강하고 활기차 보이지 않소. 자칫하면 멀쩡히 못 나갈 줄 아시오!'
$refuse_pregnant_quote['Barin'] = '[바린]<br>&nbsp;그래서, 임신한 노예를 나한테 팔고 그 처리까지 내가 하길 바라는 거요? 절대 안 되오!'
$refuse_special_quote['Barin'] = '[바린]<br>&nbsp;그녀는 내가 원한 게 아니오!'
$refuse_again_quote['Barin'] = '[바린]<br>&nbsp;안 된다는 건 안 되는 거요!'
! JO9 MOD END J9M2027

