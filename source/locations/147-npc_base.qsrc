$npc_flirt['poison'] = {
 	$text[1] = '   Вы осматриваете места у барной стойки и замечаете Поизон - владелицу магазина телесных модификаций в Некрополисе. Заказав себе для смелости пару стопок коньяку, вы идете на штурм соблазнительной мертвячки.'
 	$text[2] = '  [<<$master_name>>]<font color="#191970"><br>- Поизон, привет! Я думал мертвые не питают пристрастия к алкоголю. Неужели ты меня тут ждешь?</font>'
 	$text[3] = '     [POISON]<br>- Я действительно не пить сюда пришла. Просто в квартале змеи часто попадаются интересные татухи и моды. Вот оглядываюсь, ищу вдохновение.'
 	$text[4] = '  [<<$master_name>>]<font color="#191970"><br>- Думаю, я мог бы немного… ммм… вдохновить тебя, детка. Холодные женщины - моя страсть.</font>'
 	$text[5] = '     [POISON]<br>- Даже не надейся. Максимум что ты можешь мне дать это литр-другой крови, живчик.'
 	$text[6] = '   Вы резко меняете подход и решаете уйти от греха подальше. Мало ли что на уме у этих живых мертвецов. Может и правда с клыками накинется. Должны быть в этом кабаке цели и поинтересней, и побезопасней.'
}


! JO9 MOD START J9M1811 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$poison_pref[1] = '[포이즌]<br>&nbsp;내가 원하는 노예의 조건? 좋아. 첫 째, 확실히 <font color="#009FEF"><b>건강</b></font>해야하고 자아도 좀 있어야 돼. 반드시. 걔는 몸에 엄청나게 많은 구멍을 내야되고, 난 그걸 조금이라도 더 오래 살게하고 싶으니까. 이미 너무 자주 노예를 갈아치워서 슬슬 바꾸는 것도 지겹다고.</div>'
$poison_pref[2] = '[포이즌]<br>&nbsp;둘 째, 둘째라고 덜 중요하지 않아. <font color="#0000D8"><b>민감</b></font>한 것. 내가 고통을 종류별로 다양하게 줘도, 통각 마비된 통나무마냥 안 느끼는 것 따윈 필요없어. 거기에 비서로 시중할 <font color="#6b0084"><b>최소한의 머리</b></font>. 성깔있고 자부심에 쩔어있는 애들? 그런 건 걱정도 아니야.</div>'
! JO9 MOD END J9M1811
$poison_pref[3] = '[포이즌]<br> <font color="#6b0084"><b>이미 특이한 건 주지 말아</b></font>줄래? 특히 문신이나 내가 직접 작업했던 애들은. 난 새하얀 백지에다 그리고 싶으니까. 내 도안에 손기술이면 평범한 사람도 무시무시한 생물체로 새롭게 바꿀 수 있을 정도라고. 아 나는 <b>미성년 필요 없어</b>, 걔넨 몸이 너무 약해.</div>'
! JO9 MOD START J9M1810 | 2026-10-09_dialogue_format_and_protagonist, 2026-10-10_reference_info_crlf_runtime_fix | changed block; context may be included
$poison_pref[4] = '[포이즌]<br>&nbsp;당연히 주변 엉망으로 두면 안되니까 작업실 주변 일 돕는 기술이 필요해. 서류 정리하는 기술이랑 고객들 접대하고 정중히 대화하는거 말이야. 또 <font color="#0000D8"><b>상처 치료, 마법력, 연금</b></font>에 일 끝나면 <font color="#6b0084"><b>재고 정리하는 것.</b></font> 모두 중요해.</div>'
$poison_pref[5] = '[포이즌]<br>&nbsp;난 고객들한테 내 작업 기기랑 복장 보여주는 것도 꽤 좋아하거든. 그러니까 <font color="#6b0084"><b>독특한 분위기에 맞게 움직이고</b></font> 자세도 취할 줄 알아야돼, <font color="#6b0084"><b>애완녀</b></font> 하듯 말야. 평소엔 <font color="#6b0084"><b>특별한 섹스 활동</b></font>에 익숙토록 만들어줘, 평범한 섹스 쓸데 없을테니까.</div>'


gs 'jo9_reference_info'
! JO9 MOD END J9M1810

