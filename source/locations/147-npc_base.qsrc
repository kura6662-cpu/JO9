$buy_quote['prince_charming'] = '[프린스 차밍]<br>&nbsp;좋아, 그녀를 받겠다. 여기 네 스파크다, 고맙다. 내 마음에 들었으면 좋겠군!'
$refuse_skill_quote['prince_charming'] = '[프린스 차밍]<br>&nbsp;요구 조건도 못 맞추는데 내가 왜 그녀를 필요로 하지? 관심 없다.'
$refuse_level_quote['prince_charming'] = '[프린스 차밍]<br>&nbsp;더 나은 여자를 찾을 수 없나? 등급을 생각하면 너무 비싸군.'
$refuse_charm_quote['prince_charming'] = '[프린스 차밍]<br>&nbsp;음… 모르겠군. 형식상으론 맞지만, 너무 볼품없어 보여. 마음에 안 들어.'
$refuse_health_quote['prince_charming'] = '[프린스 차밍]<br>&nbsp;무슨 수작을 부리려는 거지? 그녀는 있어야 할 만큼 건강하고 활기차 보이지 않는다. 자칫하면 멀쩡히 못 나갈 줄 알아라!'
$refuse_pregnant_quote['prince_charming'] = '[프린스 차밍]<br>&nbsp;그래서, 임신한 노예를 나한테 팔고 그 처리까지 내가 하길 바라는 거냐? 절대 안 된다!'
$refuse_again_quote['prince_charming'] = '[프린스 차밍]<br>&nbsp;안 된다는 건 안 되는 거다!'
! JO9 MOD END J9M2069

