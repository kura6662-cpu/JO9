$diary_mark['Amaya'] = "   <<$npc_name['Amaya']>>. 후타랜드에 산다."
! JO9 MOD START J9M1976 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Amaya_pref[1] = "[아마야]<br>&nbsp;야옹, 좋은 하루야, 인간! 지금 있는 노예들엔 질렸어… <<$rating[demand_rating['Amaya']]>> 등급 이상의 새 첩 여자애가 필요해. 공정하게 <<common_price[demand_rating['Amaya']]>> 스파크를 낼게. 서둘러, 알겠지?!"
$buy_quote['Amaya'] = '[아마야]<br>&nbsp;좋아, 그녀를 받겠어. 여기 스파크야, 고마워! 내 마음에 들었으면 좋겠네!'
$refuse_skill_quote['Amaya'] = '[아마야]<br>&nbsp;그 일에 필요한 훈련도 안 되어 있는데, 내가 왜 그녀를 받지? 그런 일꾼엔 관심 없어.'
$refuse_level_quote['Amaya'] = '[아마야]<br>&nbsp;더 나은 사람은 없나? 이 값엔 어울리지 않네.'
$refuse_charm_quote['Amaya'] = '[아마야]<br>&nbsp;흠… 잘 모르겠네. 형식상으론 맞지만 볼품이 없어. 끌리지 않아.'
$refuse_health_quote['Amaya'] = '[아마야]<br>&nbsp;뭘 나한테 팔아넘기려는 거지? 병약해 보이고, 충분히 튼튼해 보이지도 않잖아. 산산조각 나지 않는 걸 다행으로 알아!'
$refuse_pregnant_quote['Amaya'] = '[아마야]<br>&nbsp;임신한 여자애를 나한테 팔아넘기려는 거야? 어림도 없어!'
$refuse_again_quote['Amaya'] = '[아마야]<br>&nbsp;안 된다는 건 안 되는 거야!'
! JO9 MOD END J9M1976

