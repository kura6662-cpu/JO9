$npc_alignment['penelope'] = 'redlight'

$npc_info['penelope'] = '페넬로페의 사연은 흥미롭다. 한편으론 그녀도 평범한 노예다. 하지만 다른 한편으론, 그녀의 직접적인 임무는 상점에서 수익을 올리는 것이다. 그녀는 그 목표를 이루기 위해 어떤 방법이든 쓸 수 있다. 언제나 세련되게 차려입고, 잘 단장되어 있으며, 다른 잡무에도 얽매이지 않는 그녀는 무엇보다 평범한 시민처럼 보인다. 때로는 그녀가 노예라는 사실을 떠올리게 하는 건 은밀한 곳에 찍힌 낙인뿐이다.'
demand_rating['penelope'] = 5
$interesting_specialisation['penelope'] = 'refferent'
$npc_preferences['penelope'] = {
stat_importance['intellect'] = 3
stat_importance['expression'] = 3
stat_importance['nurse'] = 2
stat_importance['oral'] = 2
}
