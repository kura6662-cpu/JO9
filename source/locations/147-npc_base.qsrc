$interesting_specialisation['baron_imladis'] = 'servant'
$diary_mark['baron_imladis'] = "   <<$npc_name['baron_imladis']>>. 그의 성은 네크로폴리스 거주 구역에 있다."
! JO9 MOD START J9M2059 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$baron_imladis_pref[1] = "[이믈라디스 남작]<br>&nbsp;나는 <<$slave_type_name[$interesting_specialisation['baron_imladis']]>> 전문화의 <<$rating[demand_rating['baron_imladis']]>> 등급 이상 노예가 필요하오. <<common_price[demand_rating['baron_imladis']]>> 스파크를 내겠소."
$buy_quote['baron_imladis'] = '[이믈라디스 남작]<br>&nbsp;좋아, 그녀를 받겠소. 여기 당신 스파크요, 고맙소. 내 마음에 들었으면 좋겠군!'
$refuse_skill_quote['baron_imladis'] = '[이믈라디스 남작]<br>&nbsp;해야 할 일을 해낼 수도 없는데 내가 왜 그녀를 필요로 하겠소? 그런 상품엔 관심 없소.'
$refuse_level_quote['baron_imladis'] = '[이믈라디스 남작]<br>&nbsp;더 나은 여자를 찾을 수 없소? 등급을 생각하면 너무 비싸오.'
$refuse_charm_quote['baron_imladis'] = '[이믈라디스 남작]<br>&nbsp;음… 모르겠군. 형식상으론 맞지만, 너무 볼품없어 보여. 마음에 안 드오.'
$refuse_health_quote['baron_imladis'] = '[이믈라디스 남작]<br>&nbsp;무슨 수작을 부리려는 거지? 그녀는 있어야 할 만큼 건강하고 활기차 보이지 않는다. 자칫하면 멀쩡히 못 나갈 줄 알아라!'
$refuse_pregnant_quote['baron_imladis'] = '[이믈라디스 남작]<br>&nbsp;그래서, 임신한 노예를 나한테 팔고 그 처리까지 내가 하길 바라는 거냐? 절대 안 된다!'
$refuse_again_quote['baron_imladis'] = '[이믈라디스 남작]<br>&nbsp;안 된다는 건 안 되는 거요!'
! JO9 MOD END J9M2059

