! JO9 MOD START J9M2024 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Alesha_pref[1] = '[알료샤]<br>&nbsp;자, 안녕하시오, <<$master_name>>! 공과 나는 우리 민족을 위해 자네가 세운 공적에 대해 들었지... 자넨 우리에게 흥미로운 사람이 되었어, 숨기진 않겠네. 그리고 자네 의도도 우리에겐 분명하지. 누구나 권력에 가까워지고 싶어 하니까... 하지만 누구나 우리 원 안에 들 수 있는 건 아니지. 말과 행동이 일치하는 사람만이 우리의 벗이자 동업자가 될 수 있다...'
$Alesha_pref[2] = '[알료샤]<br>&nbsp;자네가 스스로 가치 있는 사람임을 증명한다면, 내가 자네를 공께 들여보내겠다. 그러면 공이 자네를 우리 원 안에 들일지 말지 결정하실 거야. 그리고 자네가 추태를 부리면, 두 번째 기회는 없다... 자, 우리에게 자기 가치를 증명할 준비는 됐나? 그럼 들어라!...'
$Alesha_pref[3] = '[알료샤]<br>&nbsp;내가 최근 뱀 구역에서 아주 성공적인 매입 하나를 했지. 정말 인상적이야. 아니, 아니! 평범한 노예 따위가 아니야! 그보다 훨씬 대단한 거지! 로봇 보조야, 인간 사유의 진짜 걸작이라고!...'
$Alesha_pref[4] = '[알료샤]<br>&nbsp;그녀의 제작자는 엄청난 공을 들여 금속 케이스 안에서 여자의 뇌가 작동하게 만드는 데 성공했지. 하지만 난 뭐든 손을 좀 대 보고 싶어 하는 사람이거든. 내 지식을 적용해서 그녀의 설정도 손봤고, 내 입맛에 맞게 조정도 했지, 말하자면. 이제 내 마루샤는 진짜 걸작이야! 하지만...'
$Alesha_pref[5] = '[알료샤]<br>&nbsp;괜히 모든 여자는 저마다 자기만의 향미와 광기와 바퀴벌레를 가져야 한다는 말이 있는 게 아니지. 마루샤는 로봇이고 거의 대체 불가능한 보조지만, 여자 뇌를 갖고 있어. 그래서 여자처럼 생각하고 여자처럼 행동하지... 물론 그건 내겐 큰 기쁨이지만, 동시에 정말 큰 재앙이기도 해!...'
$Alesha_pref[6] = '[알료샤]<br>&nbsp;똑똑하고, 호기심 많고, 일 잘하는 기계인 건 맞지만, 가끔은 완전히 애가 돌아 버려. 모든 여자애와 친구가 되겠다고 들러붙지. 하나하나 붙잡고 충고하고, 옷도 입어 보고. 마음에 드는 게 있으면 제 걸로 가져가 버리기까지 해. 여자애들은 걔를 피해 어디로 숨어야 할지 몰라...'
$Alesha_pref[7] = '[알료샤]<br>&nbsp;게다가 그런 기술쟁이는 또 없을 거다! 가끔은 자기 펌웨어랑 개조안까지 직접 개발하지. 최근엔 자기 가슴이 너무 작고 안 예쁘다고 판단하더군. 그래서 키우기로 했어... 모델까지 설계해서 직접 개발자한테 들고 갔다니까. 조만간 새 가슴을 달아 오겠지...'
$Alesha_pref[8] = '[알료샤]<br>&nbsp;그리고 그녀는 진짜 여자처럼 관심과 애정을 좋아해. 가끔은 한밤중에 내 침대로 기어들어 와서 자길 데워 주고 끌어안아 달라고 하기도 하지! 뭐라 더 말하겠나... 한마디로 여자야. 그런데 난 그녀를 어떻게 해야 할지 모르겠어. 꺼 버리기엔 아깝지만, 그렇다고 이 상태가 더 오래 계속될 수는 없어...'
$Alesha_pref[9] = '[알료샤]<br>&nbsp;그녀는 자기 자리를 알고 나를 주인으로 여기긴 하지만, 난 그녀에게 어떤 영향도 줄 수가 없어. 어째선지 그녀는 우리 여자애들 말만 듣거든. 하지만 알다시피, 난 아직 나만의 유일무이한 사람을 찾지 못했어. 그렇다고 마루샤 하나 달래자고 기생충 떼거리를 먹여 살리고 싶지도 않고. 하나면 충분해. 그래서 자네에게 부탁이 하나 있어.'
$Alesha_pref[10] = '[알료샤]<br>&nbsp;내게 필요한 건 <font color="#008080"><b>여자</b></font>야. 진짜 여자. <b>아이 말고</b>. <font color="#008000"><b>집안의 모든 일</b></font>을 할 줄 아는 여자가 필요해. 십대는 쓸모가 없어. 인생 교훈까지 가르쳐야 할 텐데, 내겐 그럴 시간이 없거든. 난 성인의 삶에 준비된 여자가 필요해. 그리고 영혼 없는 인형은 데려오지 마. "식물" 같은 것도 필요 없어. 영혼이 있고, <font color="#008000"><b>기질</b></font>이 있고, <font color="#008080"><b>안에 불꽃이 있는</b></font> 여자를 원해...'
$Alesha_pref[11] = '[알료샤]<br>&nbsp;멍청한 여자도 필요 없지. 하지만 <font color="#0000CD"><b>너무 똑똑한 여자도 안 돼</b></font>. 그런 건 하나만으로도 충분하거든. 둘이면 너무 많아. 그리고 그녀는 귀족의 집에서 살게 될 테니 그에 걸맞게 <font color="#008000"><b>처신</b></font>할 줄 알아야 해. 대화를 이어 가는 것뿐 아니라, 손님들을 <font color="#008080"><b>노래와 춤으로</b></font> 즐겁게 할 수 있다면 더 좋겠지.'
$Alesha_pref[12] = '[알료샤]<br>&nbsp;또 내가 어떤 일이든 맡길 수 있어야 한다는 것도 똑같이 중요해. 물론 어떤 여자든 걸레질하고 부엌일 정도는 알지. 하지만 <font color="#008080"><b>더 복잡한 일들</b></font>은 다들 못 해. 내 여자는 그걸 완벽하게 해낼 수 있어야 해. 그리고 침대에선 그저 진짜 여신이어야 하지. 난 아직 젊고 온갖 놀이를 할 힘도 넘치거든. 그래서 내게 필요한 건 <font color="#008000"><b>전천후 애인</b></font>이야...'
$Alesha_pref[13] = '[알료샤]<br>&nbsp;그리고 그녀가 어떻게든 마루샤 문제도 해결해야 한다는 걸 잊지 마. 마루샤가 관심과 애정을 좋아한다는 건 기억하지? 그러니 그 여자는 적당히 변태적이어야 하고, 자기 모든 면을 드러낼 준비가 되어 있어야 하며, <font color="#008000"><b>어떤 역할이든 연기할</b></font> 수 있어야 해. 최소한 <font color="#008000"><b>온갖 극단적인 행위들</b></font> 정도에는 숨이 턱 막힐 만큼 익숙해야 하지. 그게 다야.'
$buy_quote['Alesha'] = '[알료샤]<br>&nbsp;좋아, 그녀를 받겠어. 여기 네 스파크다, 고맙고. 내 마음에 들었으면 좋겠군!'
$refuse_skill_quote['Alesha'] = '[알료샤]<br>&nbsp;해야 할 일을 해낼 수 없는데 내가 왜 그녀를 필요로 하지? 그런 상품엔 관심 없어.'
$refuse_level_quote['Alesha'] = '[알료샤]<br>&nbsp;더 나은 여자애를 찾을 수 없나? 등급을 생각하면 너무 비싸군.'
$refuse_charm_quote['Alesha'] = '[알료샤]<br>&nbsp;음… 모르겠군. 형식상으론 맞지만 너무 볼품없어 보여. 매력도 부족하고. 마음에 안 들어.'
$refuse_health_quote['Alesha'] = '[알료샤]<br>&nbsp;무슨 수작을 부리려는 거지? 그녀는 있어야 할 만큼 건강하고 활기차 보이지 않는다. 자칫하면 멀쩡히 못 나갈 줄 알아라!'
$refuse_pregnant_quote['Alesha'] = '[알료샤]<br>&nbsp;그래서, 임신한 노예를 나한테 팔고 그 처리까지 내가 하길 바라는 거냐? 절대 안 된다!'
$refuse_special_quote['Alesha'] = '[알료샤]<br>&nbsp;그녀는 내가 원한 게 아니다!'
$refuse_again_quote['Alesha'] = '[알료샤]<br>&nbsp;안 된다는 건 안 되는 거다!'
$refuse_special_quote['Alesha'] = '[알료샤]<br>&nbsp;내 특별 요구 조건은 어쩌고?! 난 그녀를 받지 않겠다!'
