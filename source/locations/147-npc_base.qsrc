! JO9 MOD START J9M2130 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$azura_pref[1] = '[아주라]<br>&nbsp;가게에서 일할 일꾼은 내가 직접 고른다. 주인은 돈을 내고 계약서에 도장만 찍지. 그러니 잘 들어, <<$master_name>>.'
$azura_pref[2] = '[아주라]<br>&nbsp;내 일꾼들은 근면하고, <font color="#0000D8"><b>영리</b></font>하며, 글을 읽고 쓸 줄 알아야 하고, 까다로운 손님들과 <font color="#0000D8"><b>외교적으로 말할</b></font> 수 있어야 해. 그러려면 <font color="#6B0084"><b>어느 정도 개성</b></font>도 필요하지. 그리고 물론, 내 보석의 우아함에 어울리려면 <font color="#0000D8"><b>아름답고</b></font> <font color="#0000D8"><b>우아하게 움직일</b></font> 수 있어야 해.'
$azura_pref[3] = '[아주라]<br>&nbsp;보석 장신구는 마법부여에 자주 쓰인다. 그러니 그녀가 <font color="#0000D8"><b>주술과 연금술</b></font>을 아는 건 매우 유용할 거야. 그리고 물론, 가게와 자기 방을 <font color="#0000D8"><b>깔끔하게 유지</b></font>할 줄도 알아야 하지.'
$azura_pref[4] = '[아주라]<br>&nbsp;난 좀 이국적인 여자들을 좋아하고 피어싱 몇 개쯤 있으면 좋겠다고 생각하지만, 그건 중요하지 않아. 특별한 요구는 없으니, 내 지시만 따라.'
$azura_pref[5] = '[아주라]<br>&nbsp;그리고 한 가지 더… 주인은 몇 년째 나에게 관심이 없지만, 그렇다고 다른 남자와 잘 수는 없어, 그건 내 수치니까. 난 자주 외롭고, 내 <font color="#6B0084"><b>스트레스를 풀어 주는</b></font> 일꾼들이 있다면 정말 고맙겠어.'
! JO9 MOD END J9M2130

