# black_market_interface
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1474 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'black_market_interface': gs 'snk_room_bridge', 'guard', 'black_market_interface'
! JO9 MOD END J9M1474
! Интерфейс чёрного рынка

GS '_layout'

killobj

if txt = 0:
   txt = 1
   min_txt = 1
   txt_count = arrsize('bm_index')
end

s_type = bm_index[txt - 1]


! Текстовый блок

$text[txt] = '이 노예의 이름은 <<$seed_name[s_type]>>이다. '
if stock_world_index[s_type] = 1:
   $text[txt] += '확실히 하이테크 세계 출신이다 - 우주 제국 같은 곳 말이다. '
elseif stock_world_index[s_type] = 2:
   $text[txt] += '자동차와 컴퓨터, 전쟁과 파괴된 생태가 있는 세계에서 왔다고 한다.. '
elseif stock_world_index[s_type] = 3:
   $text[txt] += '증기와 석탄, 그리고 세계대전이라는 끝없는 고기 분쇄기가 이어지는 세계 출신인 듯하다. '
elseif stock_world_index[s_type] = 4:
   $text[txt] += '기사와 마법사, 그리고 온갖 사악한 영들이 있는 세계에서 안개를 넘어왔다. '
else
   $text[txt] += '냄새로 보아 무슨 동굴에서 기어 나온 것 같다. 어쩌면 공룡도 봤을지 모른다. '
end

if stock_work_index[s_type] = 1:
   $text[txt] += '야망을 보면, 자기 세계에선 공주 비슷한 존재였던 것 같다. 재수 없군. '
elseif stock_work_index[s_type] = 2:
      $text[txt] += '자기 세계에서는 중요한 인물이었던 것 같다. 여기선 그만큼 더 고생하겠지. '
elseif stock_work_index[s_type] = 3:
      $text[txt] += '자기 세계에서는 무슨 전문가였던 모양이다. 여기서도 쓸 데가 있을지도 모르지. '
elseif stock_work_index[s_type] = 4:
      $text[txt] += '고향 세계에서는 평범한 군중의 일부였다. 로마에 와도 별 차이는 못 느낄 거다. '
elseif stock_work_index[s_type] = 5:
      $text[txt] += '자기 세계의 맨 밑바닥에서 왔다. 어쩌면 여기서가 고향보다 더 잘 살게 될지도 모른다. '
else
   $text[txt] += '나이가 너무 어려서 자기 세계에서는 아무것도 이루지 못했다.. '
end

bm_price = seed_cost[s_type]
if bm_price = 0: bm_price = 350
if seed_virginity[s_type] < 2:
   bm_price += 100
   $text[txt] += '참고로 아직 처녀라서, 가격은 더 높아질 거다. '
end

if sparks >= bm_price: 
   $text[txt] += '<<bm_price>> 스파크에 넘기겠다.'
else
   $text[txt] += '값은 <<bm_price>> 스파크인데, 네겐 그만한 돈이 없다.'
end

if txt_count = 0: $text[txt] = '불행히도 지금은 다른 선택지가 없다. 다음에 다시 와라. (추가 노예가 없다. 인터넷에서 다운로드하거나 직접 만들어라.)'

! JO9 MOD START J9M1473 | 2026-10-08_persistent_image_cycle, 2026-10-15_z_inline_text_prefix | changed block; context may be included
*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\<<$bg[$place]>>.jpg"></div>')
! JO9_INLINE_TEXT_PREFIX_20261015
local $jo9_leading_empty = $strfind($text[txt], '^(\s|&nbsp;|<[bB][rR]\s*/?>)+')
if $jo9_leading_empty ! '': $text[txt] = $mid($text[txt], len($jo9_leading_empty) + 1, len($text[txt]))
! JO9 MOD END J9M1473
*p '<div id = "text"><<$text[txt]>></div>'
$info_bar = ''
! JO9 MOD START J9M1472 | 2026-10-10_restore_ui_format_after_dialogue_normalization | changed block; context may be included
*p '<div id = "side_panel_main"><center><div style="font-size: 40px;"><<$place_name[$place]>></div>
<<$place_location[$place]>>
 참고 정보:
 </center></div>'
! JO9 MOD END J9M1472
*p '<div id = "barn_stat_bar">'
*nl '이름: &nbsp;<<$seed_name[s_type]>>'
*nl '나이: &nbsp;<<$slave_age_name[seed_age[s_type]]>>'
*p '<br> 속성정보<div style="line-height:25%"><br></div>'
*p '<font style="font-size:12px;">외모 </font><a class="tooltip-right" href="EXEC: msg $beauty_reference & msg $beauty_reference_2"><<$beauty[seed_beauty[s_type]]>></a>'
*nl '<font style="font-size:12px;">체력 </font><a class="tooltip-right" href="EXEC: msg $health_reference & msg $health_reference_2"><<$stamina[seed_stamina[s_type]]>></a>'
*nl '<font style="font-size:12px;">감수성 </font><a class="tooltip-right" href="EXEC: msg $sensitivity_reference & msg $sensitivity_reference_2"><<$sensitivity[seed_sensitivity[s_type]]>></a><div style="line-height:25%"><br></div>'
*p '<font style="font-size:12px;">성격 </font><a class="tooltip-right" href="EXEC: msg $temperament_reference & msg $temperament_reference_2"><<$temper[seed_temper[s_type]]>></a>'
*nl '<font style="font-size:12px;">지성 </font><a class="tooltip-right" href="EXEC: msg $mind_reference & msg $mind_reference_2"><<$intellect[seed_intellect[s_type]]>></a>'
*nl '<font style="font-size:12px;">자아 </font><a class="tooltip-right" href="EXEC: msg $character_reference & msg $character_reference_2"><<$ego[seed_ego[s_type]]>></a><div style="line-height:25%"><br></div>'
*p '<font style="font-size:12px;">태도 </font><a class="tooltip-right" href="EXEC: msg $pride_reference & msg $pride_reference_2"><<$pride[seed_pride[s_type]]>></a>'
*nl '<font style="font-size:12px;">독특함 </font><a class="tooltip-right" href="EXEC: msg $exoticism_reference & msg $exoticism_reference_2"><<$exotic[seed_exotic[s_type]]>></a>'
*nl '<font style="font-size:12px;">체형 </font><a class="tooltip-right" href="EXEC: msg $fat_reference & msg $fat_reference_2"><<$fat[seed_fat[s_type]]>></a><div style="line-height:25%"><br></div>'
*p '<font style="font-size:12px;">인지도 </font><a class="tooltip-right" href="EXEC: msg $glory_reference & msg $glory_reference_2"><<$girl_fame[seed_fame[s_type]]>></a>'
*p '<div style="line-height:25%"><br></div>노예의 특성<div style="line-height:5%"><br></div><<$stock_features_list>></div>'


!<u>ОСОБЕННОСТИ</u>
!<<$stock_features_list>>

! JO9 MOD START J9M1471 | 2026-10-08_persistent_image_cycle | changed block; context may be included
*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\<<$fullimage[s_type]>>.png"></div>')
! JO9 MOD END J9M1471
if txt > min_txt:
   addobj '<img src = "content\pic\buttons\back_button.png">'
else
   addobj '<img src = "content\pic\buttons\noback_button.png">'
end
if txt < txt_count: addobj '<img src = "content\pic\buttons\forward_button.png">'
$yes = {
      if sound_on = 1: play 'content\snd\kkm.wav', sound_volume
      killobj
      killvar 'bm_index'
      black_market_taken['<<s_type>>'] = 1
      sparks -= bm_price
      gs 'black_market_get_comm_slave'
      gt 'shop_general'
}
$no = {
   killvar 'bm_index'
   gt $return_lock
}
if sparks >= bm_price and txt_count <> 0: *p {<div id = "approve"><a href = 'EXEC: dynamic $yes'><img src="content\pic\buttons\approve.png"></a></div>}
*p {<div id = "deny"><a href = 'EXEC: killobj & dynamic $no'><img src="content\pic\buttons\deny.png"></a></div>}

------------ black_market_interface ------------
