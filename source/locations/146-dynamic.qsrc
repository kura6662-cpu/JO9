!Repulse Check - crushboss

$dyn_sex_acceptance = {
	! sub-calculation for $dyn_repulse_check, called from interaction, interaction_city, interaction_result
	! no effect unless stimulating flag is enabled (expected to be enabled for any interactions that set erotic_stimulation in $special_part)
	! sets interaction_*['sex_acceptance'], to be interpreted as a bonus/penalty to obedience, uncapped, values < 0 indicate reluctance
	! expects to be called with dynamic $replace($dyn_sex_acceptance, 'dyn'+'slave', 'a slave instance variable')
	interaction_dynslave['sex_acceptance'] = 0
	if dynslave_state = CONST_INT['slave_exist']:

		if $dynslave_psy_status = 'broken':
			! mind-broken slaves are indifferent
		elseif dynslave['moral'] < 5 and instr($interaction_type, 'rape') ! 0:
			! rape is opposed by nature ([-20, -4]) unless fully devoted - ImperatorAugustus
			interaction_dynslave['sex_acceptance'] -= (dynslave['ego'] + dynslave['temper'] + dynslave['pride'] + dynslave['intellect'])
		elseif stimulating > 0 or orgastic > 0:
			interaction_dynslave['sex_acceptance'] = (master_style - 5) + dynslave['mood'] + dynslave['moral'] + dynslave['arousal']*2 - dynslave['pride']*2
			! initial value ranges from +20 (alluring master, ecstatic, max devotion, max arousal, no pride) to -20 (repulsive master, depressed, no devotion, no arousal, max pride)
			if $dynslave_psy_status = 'frightened' or $dynslave_psy_status = 'docile':
				interaction_dynslave['sex_acceptance'] += dynslave['fear'] &! a frightened or docile slave is most motivated by fear - ImperatorAugustus
			elseif $dynslave_psy_status = 'horny':
				interaction_dynslave['sex_acceptance'] += dynslave['arousal'] &! a horny slave is most motivated by arousal - ImperatorAugustus
			elseif $dynslave_psy_status = 'servile':
				interaction_dynslave['sex_acceptance'] += dynslave['ego'] &! a devoted slave subordinates their nature - ImperatorAugustus
			elseif $dynslave_psy_status = 'obedient':
				interaction_dynslave['sex_acceptance'] += dynslave['intellect'] &! an obedient slave is most motivated by rationality - ImperatorAugustus
			elseif $dynslave_psy_status = 'hysteric':
				interaction_dynslave['sex_acceptance'] -= dynslave['moral'] &! being hysteric (spoiled) counters devotion - ImperatorAugustus
			elseif $dynslave_psy_status = 'hateful':
				interaction_dynslave['sex_acceptance'] -= dynslave['temper'] &! a hateful slave is most motivated by temperament - ImperatorAugustus
			elseif $dynslave_psy_status = 'resistant':
				interaction_dynslave['sex_acceptance'] -= dynslave['ego'] &! a resistant slave is most motivated by nature - ImperatorAugustus
			elseif $dynslave_psy_status = 'arrogant':
				interaction_dynslave['sex_acceptance'] -= dynslave['pride'] &! an arrogant slave is most motivated by pride - ImperatorAugustus
			elseif $dynslave_psy_status = 'reluctant' or $dynslave_psy_status = 'depresive' or $dynslave_psy_status = 'lachrymose':
				interaction_dynslave['sex_acceptance'] += dynslave['sensitivity'] &! sensitivity determines the impact of angst, which reduces resistance - ImperatorAugustus
			end
			if dynslave['nymphomania'] > 0: interaction_dynslave['sex_acceptance'] += dynslave['arousal'] &! nymphomania increases arousal weight - ImperatorAugustus
			if dynslave['nymphomania'] < 0: interaction_dynslave['sex_acceptance'] -= dynslave['sensitivity'] &! frigidity increases resistance proportional to sensitivity - ImperatorAugustus
			! above factors range from [-10, +10] (without nymphomania/frigidity, [-5, +5]), below factors range from [-20, +40]
			interaction_dynslave['sex_acceptance'] += dynslave['sex_sum']/2 &! acceptance rises with experience (average of all sex skills adds [0, 16])
			if shameful > 0:
				interaction_dynslave['sex_acceptance'] += 5*dynslave['exhibitionism']
			end
			if painful > 0:
				interaction_dynslave['sex_acceptance'] += 5*dynslave['masochism']
			end
			if disgusting > 0:
				interaction_dynslave['sex_acceptance'] += 5*dynslave['perversion']
			end
			if hero_choice < 100:
				if lesbian > 0:
					interaction_dynslave['sex_acceptance'] += 5*dynslave['homosexualism']
				elseif dynslave['homosexualism'] = 2:
					interaction_dynslave['sex_acceptance'] -= 8 &! lesbians dislike non-lesbian activities
				end
			elseif hero_choice > 100:
				if dynslave['homosexualism'] = 0:
					interaction_dynslave['sex_acceptance'] -= 2 &!heterosexual slaves dislike mistress
				elseif dynslave['homosexualism'] = -1:
					interaction_dynslave['sex_acceptance'] -= 8 &!homophobic slaves dislike mistress
				elseif dynslave['homosexualism'] = 2:
					interaction_dynslave['sex_acceptance'] += 8 &!lesbians love mistress
				else
					interaction_dynslave['sex_acceptance'] += 5 &!bisexual slaves like mistress
				end
			end
			! sum of all factors ranges from [-50,+70]
			interaction_dynslave['sex_acceptance'] /= 2 &! final value is in range [-30, +48] but usually single digits

		end &! end of stimulating check

	end &! end of conscious state check
}


$dyn_repulse_check = {
	! called from interaction_result
	! sets result interaction_*['res'], which if < 0 indicates the slave refuses the interaction
	! if slave has a positive or negative affinity ($target_affinity set by caller), it has a large impact (+/- 5)
	! a slave will answer what she wants to do at (-1 + pride) obedience
	! going from +3 mood to <= 0 mood drops obedience by 2, which is less than the +5 bonus for a positive affinity
	! this means that a slave will be willing to do the thing they said they want to do even if their mood drops
	! expects to be called with dynamic $replace($dyn_repulse_check, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state = CONST_INT['slave_exist']:

		!if dynslave['domini_dictum'] = 1:
		!	interaction_dynslave['res'] = 0
		!if 'dynslave' = 'assistant':
		!	interaction_dynslave['res'] = dynslave['moral'] &! TODO: for now, devoted assistants do not refuse anything - ImperatorAugustus
		!else
			interaction_dynslave['res'] = dynslave['obedience'] + interaction_dynslave['sex_acceptance'] - interaction_dynslave['repulse']
			! for rape or actions the slave finds distasteful, sex_acceptance may be negative, making it harder to overcome the repulse threshold
			if $target_affinity ! '':
				if $interaction_partner = 'dynslave' and interaction_dynslave['res'] >= 0: dynslave[$target_affinity + '_revealed'] = max(1, dynslave[$target_affinity + '_revealed'])
				if dynslave[$target_affinity] < 0: interaction_dynslave['res'] -= 5
				if dynslave[$target_affinity] > 0: interaction_dynslave['res'] += 5
			end
		!end

		if $interaction_partner = 'dynslave' and interaction_dynslave['res'] >= 0: dynslave['daring'] = max(dynslave['daring'], interaction_dynslave['repulse']) &! this is used to limit merit, increases here and decreases in next_day

	elseif dynslave_state = CONST_INT['slave_faint']:

		interaction_dynslave['res'] = 0 &! unconscious slaves cannot resist - ImperatorAugustus

	end &! end of conscious/fainted state checks
}


$dyn_diligence = {
	! called from interaction_result after $dyn_repulse_check
	! sets interaction_*['diligence'] in range [0,5], zero reflects inadequate/lackluster effort, positive reflects praise-worthy effort
	! interaction_*['motivation_repulse'] can be set by caller in [0,5] range as a malus to overcome (motivation_repulse affects only diligence, not obedience)
	! this function adjusts diligence to account for $target_affinity, if set by caller (affinities have strong influence)
	! this function also imposes a range of [0, diligence] on the sex_quality global (which represents the slave applying skills to improve sex for partner)
	! expects to be called with dynamic $replace($dyn_diligence, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state = CONST_INT['slave_exist']:

		interaction_dynslave['diligence'] = dynslave['mood'] + dynslave['moral'] + dynslave['fear']*2 - dynslave['angst']/2 - dynslave['spoil'] &! initial value is in range [-12, +20]

		! AURA-BASED MOTIVATION
		interaction_dynslave['motivation_repulse'] = max(0, min(5, interaction_dynslave['motivation_repulse'])) &! enforce [0,5] range (default 0)
		interaction_dynslave['diligence'] -= (1 + interaction_dynslave['motivation_repulse'])/2 &! reduce initial diligence by [0,3] - ImperatorAugustus
		if dynslave['custom']     > interaction_dynslave['motivation_repulse']: interaction_dynslave['diligence'] += 1
		if dynslave['instinct']   > interaction_dynslave['motivation_repulse']: interaction_dynslave['diligence'] += 1
		if dynslave['rational']   > interaction_dynslave['motivation_repulse']: interaction_dynslave['diligence'] += 1

		! ITEM BONUSES
		if $target_skill ! '':
			dynamic $replace($recalc_equipment_bonuses, 'dyn'+'slave', 'dynslave') &! refresh learn_bonus for slave (used in $misc_bonus)
			interaction_dynslave['diligence'] += dyneval('result = learn_bonus[$target_skill]') &! item bonuses increase diligence
		end

		! PHOBIAS
		phobia = 0
		if shameful > 0:     phobia += dynslave['exhibitionism'] - shameful
		if painful > 0:      phobia += dynslave['masochism'] - painful
		if abuse > 0:        phobia += dynslave['abuse_attitude'] - abuse
		if disgusting > 0:   phobia += dynslave['perversion'] - disgusting
		if darkness > 0:     phobia += dynslave['darkness_attitude'] - darkness
		if bloody > 0:       phobia += dynslave['blood_attitude'] - bloody
		if fire_based > 0:   phobia += dynslave['fire_attitude'] - fire_based
		if water_based > 0:  phobia += dynslave['water_attitude'] - water_based
		if vermin_based > 0: phobia += dynslave['vermin_attitude'] - vermin_based
		if deprivation > 0:  phobia += dynslave['deprivation_attitude'] - deprivation
		if lesbian > 0:      phobia += dynslave['homosexualism'] - lesbian
		if heterosexual = 0: phobia += dynslave['homosexualism'] - heterosexual
		if stimulating = 0:  phobia += dynslave['nymphomania'] &! no offset because nymphomania only goes up to +1, all above go to +2
		interaction_dynslave['diligence'] += phobia*2 &! will be positive or negative depending on relevant attitudes (doubled for greater trait impact - ImperatorAugustus)

		! SAME-DAY PUNISHMENTS BOOST DILIGENCE POTENTIAL
		interaction_dynslave['diligence'] += dynslave['daily_punishment_count']

		! NEGATIVE FACTORS
		if dynslave['energy'] < 0: interaction_dynslave['diligence'] += dynslave['energy']*4 &! exhaustion directly reduces diligence
		if stimulating > 0 or orgastic > 0: interaction_dynslave['diligence'] -= dynslave['pride'] - max(0, dynslave['arousal'] - 3) &! pride opposes sex, 4/5 arousal does the opposite [1,2]
		if rebell[$dynslave_psy_status] < 0: interaction_dynslave['diligence'] += rebell[$dynslave_psy_status] &! currently a [-100,-2] range
		if rebell[$dynslave_psy_status] > 0: interaction_dynslave['diligence'] -= rebell[$dynslave_psy_status] &! currently a [0,4] range
		if interaction_dynslave['res'] < 0: interaction_dynslave['diligence'] += interaction_dynslave['res']/2 &! when refusal is not possible (tutor, academy)

		! BONUSES FOR TEACHING ABILITY
		if $interaction_type = 'master_teaches_slave':
			interaction_dynslave['diligence'] += max(0, master_tutor - 2) &! +1 with B+ teaching skill, +2 with A+ teaching skill, +3 with S+ teaching skill
		elseif $interaction_type = 'assistant_teaches_slave' and assistant['intellect'] > 3:
			interaction_dynslave['diligence'] += (assistant['intellect'] - 3) &! assistants with A+ or S+ intellect boost diligence by +1 or +2
		elseif $interaction_type = 'school_class':
			interaction_dynslave['diligence'] += 2 &! classes boost diligence by +2
		elseif $interaction_type = 'coach_teaches_slave':
			interaction_dynslave['diligence'] += 3 &! tutors boost diligence by +3
		elseif $interaction_type = 'master_teaches_assistant':
			interaction_dynslave['diligence'] += max(0, master_tutor - 2) &! +1 with B+ teaching skill, +2 with A+ teaching skill, +3 with S+ teaching skill
		end
		! NORMAL DIFFICULTY OVERRIDE
		if interaction_dynslave['diligence'] < 2 and difficulty_setting ! 2:
			! except on hardcore obedience difficulty, negative mood has a reduced impact on diligence
			if dynslave['mood'] < 0: interaction_dynslave['diligence'] -= (1+dynslave['mood'])/2 &! subtracting a negative, effectively reversing a portion of the penalty (depressed becomes a -2 instead of -5)
			! except on hardcore obedience difficulty, a slave with non-negative obedience and/or mood will give at least a minimal effort irrespective of above factors
			if max(dynslave['obedience'], dynslave['mood']) >= 0: interaction_dynslave['diligence'] = max(1, interaction_dynslave['diligence'])
		end

		! LINKED PRIMARY TRAIT BONUS/PENALTY
		if $target_affinity ! '':
			if dynslave[$target_affinity] > 0: interaction_dynslave['diligence'] += 10 &! positive affinity negates two out of three: depressed mood, max-angst, max-spoil
			if dynslave[$target_affinity] < 0: interaction_dynslave['diligence'] -= 10 &! negative affinity does the opposite
		end

		! SEX DILIGENCE IS CAPPED WHEN PSY STATUS IS FRIGHTENED, DOCILE, LACHRYMOSE, DEPRESSIVE OR BROKEN
		if (stimulating > 0 or orgastic > 0) and rebell[$dynslave_psy_status] < 0 and interaction_dynslave['diligence'] > 2: interaction_dynslave['diligence'] = 2

		! PSEUDO-RANDOM POSITIVE DILIGENCE WITH MOOD AS LOWER BOUND, OR CAP POSITIVE DILIGENCE AT 1 IF MOOD IS NEGATIVE (HARDCORE ONLY)
		if interaction_dynslave['diligence'] > 1:
			if dynslave['mood'] < 0 and difficulty_setting = 2:
				interaction_dynslave['diligence'] = 1
			elseif dynslave['mood'] < interaction_dynslave['diligence']:
				interaction_dynslave['diligence'] = max(dynslave['mood'], 1 + (48271 * (day + dynslave_type + interaction + dynslave_already_done_total[$str(interaction)]) mod 65537)/(65537/interaction_dynslave['diligence']))
			end
		end

		! SPECIAL CASES
		if dynslave['domini_dictum'] = 1 or $dynslave_psy_status = 'broken':
			interaction_dynslave['diligence'] = 1 &! mind-controlled or mind-broken diligence is locked at 1
		!elseif 'dynslave' = 'assistant':
		!	interaction_dynslave['diligence'] = iif(stimulating > 0, min(5, dynslave['moral'] + dynslave['arousal']/5), dynslave['moral']) &! TODO: assistant ignores other factors for now - ImperatorAugustus
		end

		! CLAMP RESULT
		interaction_dynslave['diligence'] = max(0, min(5, interaction_dynslave['diligence'])) &! enforce [0,5] range

	end &! end of conscious state check
}

$dyn_torture_phobia = {
	! sets interaction_*['phobia'] to the sum of trait values corresponding to an enabled torture flag (shameful, painful, abuse, etc.)
	! for example, if a slave is a Masochist (trait value = 2) and Shy (trait value = -1), the sum +1 confers partial resistance to torture involving both pain and shame
	! expects to be called with dynamic $replace($dyn_torture_phobia, 'dyn'+'slave', 'a slave instance variable')
	! disabled incrementing xp here because this function is called from interaction before determining outcome
	! it is possible that the interaction fails after this function is called, in which case no xp should be gained
	! xp increments have therefore moved to $dyn_torture_result - ImperatorAugustus
	if dynslave_state = CONST_INT['slave_exist']:
		interaction_dynslave['phobia'] = 0
		if painful > 0: interaction_dynslave['phobia'] += dynslave['masochism']
		if shameful > 0: interaction_dynslave['phobia'] += dynslave['exhibitionism']
		if disgusting > 0: interaction_dynslave['phobia'] += dynslave['perversion']
		if abuse > 0: interaction_dynslave['phobia'] += dynslave['abuse_attitude']
		if darkness > 0: interaction_dynslave['phobia'] += dynslave['darkness_attitude']
		if bloody > 0: interaction_dynslave['phobia'] += dynslave['blood_attitude']
		if fire_based > 0: interaction_dynslave['phobia'] += dynslave['fire_attitude']
		if water_based > 0: interaction_dynslave['phobia'] += dynslave['water_attitude']
		if vermin_based > 0: interaction_dynslave['phobia'] += dynslave['vermin_attitude']
		if deprivation > 0: interaction_dynslave['phobia'] += dynslave['deprivation_attitude']
		! not handling compassion here because it is not necessarily the correct perspective (observer feels compassion, not victim)
		interaction_dynslave['phobia'] = max(-1, min(2, interaction_dynslave['phobia'])) &! limit to range [-1, +2]

	end &! end of conscious state check
}

$dyn_torture_result = {
	!Torture result - improved - crushboss (revised and converted to dynamic by ImperatorAugustus, consolidated moodlet and trait impacts from other locations, including torture xp)
	! clears any sin on the victim, determines torture outcome, inflicts mental effects accordingly, but does not apply any physical effects (e.g., no stamina drain, no damage)
	! for physical effects, if applicable, it is recommended to additionally call $dyn_slave_damaged
	! sets torture_succeeded to 0, 1 or 2 (repectively: minimal effect, moderate effect, maximal effect - including a fear level increase for the slave)
	! expects phobia to be set by an earlier call to $dyn_torture_phobia, and expects torture_intensity, sensitivity_threshold and torturer_skill to be set by caller
	! expects to be called with dynamic $replace($dyn_torture_result, 'dyn'+'slave', 'a slave instance variable')

	! fear_resistance opposes torturer_skill: ego (willpower) and (to a lesser extent) temperament and pride oppose fear, sensitivity increases vulnerability, and previous experience of the same torture increases resistance
	fear_resistance = (dynslave['ego'] - dynslave['sensitivity']) + (dynslave['temper'] + dynslave['pride'])/2
	if abuse > 0: fear_resistance += dynslave_already_done_total[$str(interaction)] &! slaves accumulate lifetime resistance to psychological pressure, but this cannot overcome a phobia - ImperatorAugustus
	! 5 ego, 5 temper, 5 pride, 0 sensitivity -> +10 fear resistance (max value without previous repetitions)
	! 5 ego, 5 temper, 3 pride, 3 sensitivity -> +7 fear resistance
	! 5 ego, 5 temper, 5 pride, 5 sensitivity -> +5 fear resistance
	! 4 ego, 4 temper, 4 pride, 4 sensitivity -> +4 fear resistance
	! 3 ego, 3 temper, 3 pride, 3 sensitivity -> +3 fear resistance
	! 2 ego, 5 temper, 1 pride, 5 sensitivity -> +0 fear resistance
	! 2 ego, 2 temper, 0 pride, 5 sensitivity -> -2 fear resistance
	if interaction_dynslave['phobia'] = 1: fear_resistance *= 2 &! if instead of a phobia the slave has an affinity for the torture type, they are more resistant to it
	if futile_threat = 1: fear_resistance *= 2 &! futile_threat is set when repeating a threat before actually performing the threatened action

	! torturer_skill should be set by caller for the specific interaction to the average [0,5] of applicable specific skills of the torturer (e.g., dominance for verbal abuse, flagellation for whipping)
	if dynslave['sensitivity'] > max(sensitivity_threshold, (1 + torturer_skill)/2, futile_threat*5): dynslave_rate['sensitivity'] -= dynslave['sensitivity']
	! futile_threat*5 in the line above negates sensitivity damage when futile_threat is set to 1 by the caller because max sensitivity is 5, and 5 > 5 is always false
	! master skill can prevent sensitivity dropping below half of master skill level, rounded up: skillfully reducing damage, but not fully negating it (max master skill prevents lowering sensitivity below B+)

	torturer_skill += 5 + torture_intensity &! after sensitivity check, add baseline to torturer_skill (makes punishments effective for an unskilled master - higher tiers are more effective / can be repeated more times)
	! an average slave with all B+ stats has +3 fear resistance initially, against which an unskilled master gets 3 effective uses of chastise punishment (6 vs. 3, 6 vs. 4 due to +1 from already_done_total, 6 vs. 5, 6 vs. 6 = fail)
	! a high-tier slave with all A+ stats has +4 fear resistance initially, against which an unskilled master gets 2 effective uses of chastise punishment (6 vs. 4, 6 vs. 5 due to +1 from already_done_total, 6 vs. 6 = fail)
	! a top-tier slave with all S+ stats has +10 fear resistance initially, against which an unskilled master gets no effective uses of chastise punishment (6 vs. 10)

	! torture always drops mood regardless of outcome (only if slave has an associated phobia - ImperatorAugustus)
	if interaction_dynslave['phobia'] < 0: gs '$mood_drop', 'dynslave', torture_intensity
	! if interaction_dynslave['phobia'] = 0: gs '$mood_drop', 'dynslave', 1 &! disabled general mood drop for non-phobia, neg moodlets are enough - ImperatorAugustus
	!TODO: dynslave_rate['mood'] -= dynslave['sensitivity'] &! temporary mood decrease ranging from 0 at no sensitivity to -0.5 at 5 sensitivity and tier 5 intensity (negative mood translates to angst overnight)

	if dynslave['sin'] = 0: dynslave_rate['rational'] -= dynslave['intellect'] &! being punished when feeling no guilt lowers awareness (rational motivation to obey to avoid punishment), smarter slaves are more affected - ImperatorAugustus

	!determine outcome: 0 = only negative impacts (sensitivity/fear/taming drain), 1 = positive impacts if matched to guilt - +awareness/+taming [if painful or deprivation], 2 = same as 1 plus fear increase [proportional to sensitivity]
	if dynslave['courage'] = -1:
		torture_succeeded = 2 &! slave is a coward (easily frightened) so torture always raises fear
		if dynslave['courage_revealed'] = 0: dynslave['courage_revealed'] = 1
	elseif interaction_dynslave['phobia'] = 2 or dynslave['courage'] = 2:
		torture_succeeded = 0 &! slave has a trait aligned with the activity or has the moronic trait (impossible to frighten)
		if dynslave['courage_revealed'] = 0: dynslave['courage_revealed'] = 1
	elseif interaction_dynslave['phobia'] = -1:
		torture_succeeded = 2 &! always increase fear when exploiting slave phobia (unless moronic)
	elseif torturer_skill < fear_resistance:
		torture_succeeded = 0
	else
		torture_succeeded = iif(torture_intensity >= dynslave['fear'], 2, 1) &! increase fear if torture intensity matches or exceeds current fear (possible to max fear without using tier-5 punishments)
	end 

	if torture_succeeded = 2: dynslave_rate['fear'] += torture_intensity * (2 + dynslave['sensitivity']) &! the gentle slave is easier affected by stress and stung by punishments

	if torture_succeeded = 0 or dynslave['sin'] > torture_intensity:
		! torture ineffective due to fear resistance or aligned trait or too-lenient punishment (lower tier than guilt) lowers fear and increases spoiling
		if dynslave['fear'] > torture_intensity: dynslave_rate['fear'] -= max(torture_intensity, dynslave['sin'] - torture_intensity) &! lower fear towards but not below the level of the punishment - ImperatorAugustus
		if dynslave['sin'] > torture_intensity: dynslave_rate['spoil'] += dynslave['temper'] &! spoil increase reflects the slave feeling safer defying the slaver - temperament measures initiative (strength of personal desires)
		if rebell[$dynslave_psy_status] <= 0: $dynslave_psy_status = 'resistant' &! temporary status change for better text selection
		dynslave['pos_ineffective_punishment'] = max(dynslave['pos_ineffective_punishment'], torture_intensity)
		dynslave['merit'] = 0 &! reset merit - being under-punished can be viewed as a reward, but does not make the slave more motivated to obey the slaver (if disobedience is rewarded, disobedience is reinforced)
	else
		dynslave['pos_ineffective_punishment'] = 0
		! probabilistic formula by utterlyjunky to increase max_guilt (guilt cap used by $sin_gained_now), capped to not increase above current fear + 1
		if dynslave['max_guilt'] <= dynslave['fear'] and (rand(1,20) + master_domination - dynslave['ego']) > 14: dynslave['max_guilt'] = min(5, dynslave['max_guilt'] + 1)
		if dynslave['max_guilt'] < dynslave['fear'] and rand(0,2) = 0: dynslave['max_guilt'] += 1 &! 33% catch-up chance when fear is higher than guilt cap

		if dynslave['sin'] > 0:
			! successful torture at or above the level of guilt the slave feels (if the slave does feel guilt) builds rational obedience - ImperatorAugustus
			dynslave_rate['rational'] += (1+dynslave['intellect'])/2 &! smarter slaves gain awareness faster - if no guilt, they will instead lose awareness (above)
			msm = max(1, min(5, master_supermacy)) &! limit to [1,5] range
			if difficulty_setting < 2 and dynslave['pride'] > 2:
				if msm > 0:
					dynslave_rate['pride'] -= (torture_intensity + msm)
				else
					dynslave_rate['pride'] -= torture_intensity
				end
			end
			if painful > 0 or deprivation > 0: dynslave_rate['instinct'] += msm * min(1 + dynslave['sensitivity'], (1 + torture_intensity)/2) &! pain or deprivation (restriction of mobility) increase taming proportional to the intensity of punishment, perceived superiority of the master and empathy of the slave - ImperatorAugustus
			! these increases are not capped or limited and can be repeated multiple times per day at the cost of energy and mood (negative mood translates to angst overnight)
		end
		dynamic $replace($newloc_update_slave, 'dyn'+'slave', 'dynslave') &! update stats and potentially change psy status as a result for better text selection and obedience bonus determination
		if dynslave['sin'] < torture_intensity:
			! torture intensity above guilt increases angst and, if angst is already maxed, directly drains stats - ImperatorAugustus
			dynslave_rate['angst'] += torture_intensity + dynslave['sensitivity']*2
			if dynslave['angst'] = 5: dynslave_rate['temper'] -= 5 & dynslave_rate['ego'] -= 5 &! drain stats directly when angst is already maxed - ImperatorAugustus
			$dynslave_psy_status = 'lachrymose' &! temporary status change (overriding update above) for better text selection
		end
	end

	! guilt reset (only after checking it above) - ImperatorAugustus
	dynslave['sin'] = 0
	dynslave['pos_no_punish'] = 0 &! punishment removes this moodlet if it was active - ImperatorAugustus

	dynslave['daily_punishment_count'] += 1 &! daily punishment count is reset in next_day
	if dynslave['daily_punishment_count'] > 2: dynslave_rate['angst'] += (dynslave['daily_punishment_count'] * 5)

	!increase applicable trait xp, reveal applicable hidden traits and clear pain threat if applicable (relocated to interaction_result)

	$удача_пытки[0] = 'наказание провалилось'
	$удача_пытки[1] = 'наказание успешно, без повышения страха'
	$удача_пытки[2] = 'наказание успешно, c повышением страха'
	!msg уровень пытки = <<torture_intensity>>
	!эффективность пытки = <<torturer_skill>>
	!Фактор фобий = <<interaction_dynslave['phobia']>>
	!сопротивляемость рабыни = <<fear_resistance>>
	!Результат: <<$удача_пытки[torture_succeeded]>>
	!Новый уровень страха: <<slave["fear"]>>
}

$dyn_reward_potence = {
	! utility function for interaction_result, modifies interaction_reward_potence 'local' variable (cleared and set by interaction, used by interaction_result)
	! expects to be called with dynamic $replace($dyn_reward_potence, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state = CONST_INT['slave_exist']:

		if dynslave_already_done_total[$str(interaction)] = 0: interaction_reward_potence += 1
		interaction_reward_potence += dynslave['moral']
		if dynslave['obedience'] < 0: interaction_reward_potence += dynslave['obedience']
		if interaction_reward_potence <= 0: interaction_reward_potence = 1

	end &! end of conscious state check
}

!Erotic Stimulation - slave
$dyn_erotic_stimulation = {
	! called from interaction_result, sets interaction_*['final_stimulation'] and calls $slave_orgasm if orgastic > 0 (global set by caller) and sufficient stimulation
	! if orgastic > 0 and stimulation is sufficient, adds nymphomania xp, reveals nymphomania, adds text to $orgasm_text array with orgasm description
	! otherwise, increases arousal proportional to stimulation amount (which is boosted by existing arousal and the sensitivity level of the slave)
	! expects to be called with dynamic $replace($dyn_erotic_stimulation, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state > CONST_INT['no_slave'] and interaction_dynslave['erotic_stimulation'] > 0:
		! state check includes fainted (TODO: stamina drain [implemented elsewhere] for sexing fainted slaves?) - ImperatorAugustus
		if rebell[$dynslave_psy_status] > 0: interaction_dynslave['erotic_stimulation'] = 1 + interaction_dynslave['erotic_stimulation']/10
		interaction_dynslave['erotic_stimulation'] = min(22, max(0, interaction_dynslave['erotic_stimulation'])) &! total stimulation is capped within [0,22] range
		interaction_dynslave['final_stimulation'] = interaction_dynslave['erotic_stimulation'] * max(1, dynslave['arousal']) &! arousal above 1 increases stimulation

		! below code calling $slave_orgasm consolidated here from individual interactions to reduce copy/paste - ImperatorAugustus
		if orgastic > 0 and (interaction_dynslave['final_stimulation'] >= (22 - dynslave['arousal']*3) or dynslave['arousal'] = 5):
			orgastic = max(orgastic, interaction_dynslave['final_stimulation']/22) &! number of orgasms [1,5]
			dynslave['nymphomania_xp'] += (1 + orgastic)/2
			dynamic $replace($dyn_slave_orgasm, 'dyn'+'slave', 'dynslave') &! protect from earlier replace
			if orgasm_description ! 0:
				dynamic $replace(' $orgasm_text[] = ''<<$orgasm_description[orgasm_description]>>'' ', 'dyn'+'slave', 'dynslave') &! evaluate delayed sub-expressions
				if orgastic > 1: $orgasm_text[arrsize('$orgasm_text')-1] = $replace($orgasm_text[], 'cums violently', 'cums repeatedly, shuddering for almost half a minute before relaxing')
				! $orgasm_text will be appended to $text array and cleared at the end of interaction_result
				orgasm_description = 0
			end
		elseif dynslave['nymphomania'] >= 0:
			! accumulate arousal (unless frigid)
			dynslave_rate['arousal'] += (interaction_dynslave['final_stimulation'] * (2 + dynslave['sensitivity']))/2
		end

	end &! end of conscious or fainted state check (and stimulation > 0)
}

!Slave Orgasm - overhauled by crushboss
$dyn_slave_orgasm = {
	! called from $dyn_erotic_stimulation and interaction_result (self_sex_lesson_special easter egg effect)
	! expects to be called with dynamic $replace($dyn_slave_orgasm, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state > CONST_INT['no_slave']:

		if orgastic < 1: orgastic = 1 & msg '$dyn_slave_orgasm called with orgastic < 1, please report this!' &! default to 1 if caller did not set it
		if dynslave['no_orgasm_rule'] = 0 or dynslave_state = CONST_INT['slave_faint'] or ('dynslave' ! 'assistant' and 'dynslave' ! 'slave' and cow_lesson_in_progress ! 1):
			! fainted slaves cannot be expected to follow rules - ImperatorAugustus
			! only slave and assistant are required to follow no-orgasm rule (extra check added for cow lesson which swaps active slave to cow) - ImperatorAugustus
			orgasm_description = 1

			dynslave['pos_orgasm'] += 1 &! moodlet exponentially decays in next_day -ImperatorAugustus
			dynslave_rate['arousal'] -= interaction_dynslave['final_stimulation'] * (dynslave['arousal'] + orgastic * dynslave['temper'])
			dynslave_rate['temper'] += orgastic &! +1 per orgasm
			if dynslave['temper'] > dynslave['pride']: dynslave_rate['instinct'] += 1

		elseif dynslave['no_orgasm_rule'] = 1:
			if interaction_dynslave['final_stimulation'] <= dynslave['obedience']:
				orgasm_description = 2

				if dynslave['nymphomania'] >= 0:
					! accumulate arousal (unless frigid)
					dynslave_rate['arousal'] += (interaction_dynslave['final_stimulation'] * (2 + dynslave['sensitivity']))/2
				end
				dynslave_rate['sensitivity'] += orgastic &! +1 per orgasm resisted
				if dynslave['temper'] > dynslave['pride']: dynslave_rate['instinct'] += 1

			elseif interaction_dynslave['final_stimulation'] > dynslave['obedience']:
				orgasm_description = 3

				dynslave['pos_orgasm'] += 1 &! moodlet exponentially decays in next_day -ImperatorAugustus
				dynslave_rate['arousal'] -= interaction_dynslave['final_stimulation'] * (dynslave['arousal'] + orgastic * dynslave['temper'])
				dynslave_rate['temper'] += orgastic &! +1 per orgasm
				dynslave_rate['instinct'] -= dynslave['instinct'] &! breaking the rule reduces taming - ImperatorAugustus
				dynamic $sin_gained_now, 'dynslave', 3 &! cap sin at level 3 (was capped at greatest of 2, devotion or instinct) - ImperatorAugustus

			end
		end

	end &! end of conscious or fainted state check - ImperatorAugustus
}

$dyn_advance_sex_skills = {
	! used by self_sex_lesson in interaction_result
	! expects caller to have set success variable
	! expects caller to have set $subskill, $subskill_xp, and optionally $subskill_two and $subskill_two_xp
	! caution: does not reset rise_difficulty, $subskill, $subskill_xp, $subskill_two or $subskill_two_xp, cleanup is caller responsibility
	! updates the designated subskills accordingly
	! expects to be called with dynamic $replace($dyn_advance_sex_skills, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state > CONST_INT['no_slave']:

		if $subskill ! '' and $subskill_xp ! '':
			if dyneval($replace('result = <<$subskill>>', 'slave', 'dynslave')) < 5:
				dynamic $replace('success += <<$subskill_xp>>', 'slave', 'dynslave') &! add accumulated progress from previous lesson(s)
				if success >= rise_difficulty or dyneval($replace('result = <<$subskill>>', 'slave', 'dynslave')) = 0:
					! first transition (F- to D-) is always successful
					dynamic $replace('<<$subskill>> += 1', 'slave', 'dynslave') &! skill_adv_mul here skipped entire levels, so removed (xp multiplier below is enough) - ImperatorAugustus
					dynamic $replace('<<$subskill_xp>> = 0', 'slave', 'dynslave') &! reset accumulated progress
					if $subskill_two ! '' and $subskill_two_xp ! '':
! JO9 MOD START COG_DYNAMIC_1 | 2026-10-16_innate_learning_traits
! JO9 MOD START J9TP_GAIN_4 | 2026-10-17_traits_personality
						dynamic $replace('if <<$subskill_two>> < 5: <<$subskill_two_xp>> += func(''jo9_traits_personality'', ''xp'', ''dynslave'', ''subskill'', func(''jo9_learning_xp'', (1), dynslave[''jo9_learning_trait''], ''subskill''))', 'slave', 'dynslave') &! secondary skills get a small xp boost (line order here is important - add xp before level-up/reset, not after)
! JO9 MOD END J9TP_GAIN_4
! JO9 MOD END COG_DYNAMIC_1
						dynamic $replace('if <<$subskill_two>> < 1: <<$subskill_two>> += 1 & <<$subskill_two_xp>> = 0', 'slave', 'dynslave') &! secondary skills only advance from F- to D- in incidental (not the focus of the lesson) training
					end
				else
! JO9 MOD START COG_SUB_PRIMARY | 2026-10-16_innate_learning_traits
					dynamic $replace('jo9_learning_gain = skill_adv_mul * max(2, success - <<$subskill_xp>>)', 'slave', 'dynslave')
     if func('jo9_meiki_training_bonus', 'dynslave', $subskill) = 1: jo9_learning_gain += 1
! JO9 MOD START J9TP_GAIN_3 | 2026-10-17_traits_personality
     jo9_learning_gain = func('jo9_traits_personality', 'xp', 'dynslave', 'subskill', func('jo9_learning_xp', (jo9_learning_gain), dynslave['jo9_learning_trait'], 'subskill'))
! JO9 MOD END J9TP_GAIN_3
     dynamic $replace('<<$subskill_xp>> += jo9_learning_gain', 'slave', 'dynslave')
! JO9 MOD END COG_SUB_PRIMARY
! JO9 MOD START J9M1802 | 2026-10-15_zzzz_meiki_comment_lex_fix | changed block; context may be included
					! JO9_TRAINING_V3: +1 to new XP from this lesson only, not previous accumulated XP.
! JO9 MOD END J9M1802
! JO9 MOD START COG_SUB_BONUS_MERGED | 2026-10-16_innate_learning_traits
! 기존 교육 추가 경험치는 COG_SUB_PRIMARY에서 합산한다.
! JO9 MOD END COG_SUB_BONUS_MERGED
! JO9 MOD START COG_DYNAMIC_2 | 2026-10-16_innate_learning_traits
! JO9 MOD START J9TP_GAIN_2 | 2026-10-17_traits_personality
					if $subskill_two_xp ! '': dynamic $replace('if <<$subskill_two>> < 5: <<$subskill_two_xp>> += func(''jo9_traits_personality'', ''xp'', ''dynslave'', ''subskill'', func(''jo9_learning_xp'', (1), dynslave[''jo9_learning_trait''], ''subskill''))', 'slave', 'dynslave') &! secondary skills get a small xp boost
! JO9 MOD END J9TP_GAIN_2
! JO9 MOD END COG_DYNAMIC_2
				end
			end
		end

	end
}

$dyn_advance_sex_skills_nolesson = {
	! used in various places for non-lesson sex skill progression
	! expects caller to have set rise_difficulty and rise_mod
	! expects caller to have set $subskill, $subskill_xp, and optionally $subskill_two and $subskill_two_xp
	! caution: will reset $subskill, $subskill_xp, $subskill_two, $subskill_two_xp, rise_difficulty and success unless caller passes 'noreset' as $args[0]
	! calls $dyn_advance_sex_skills to update the designated subskills
	! expects to be called with dynamic $replace($dyn_advance_sex_skills_nolesson, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state > CONST_INT['no_slave']:

		if $subskill ! '' and $subskill_xp ! '':

			args[1] = success &! save value to restore later
			args[2] = rise_difficulty &! save value to restore later
			success = 0 &! minimum progress rate
			rise_difficulty = 12 + max(1, dyneval($replace('result = <<$subskill>>', 'slave', 'dynslave')))*34 &! should be higher than maximum rise_difficulty in lessons, including rise_mod, hence 12 + 22 = 34
			dynamic $replace($dyn_advance_sex_skills, 'dyn'+'slave', 'dynslave') &! primary sex skills advance slowly, uncapped, in incidental (non-lesson) training; secondary skills only advance from F- to D-
			! F- to D- is guaranteed success, D- to C- is 46/2 = 23 repetitions, C- to B+ is 80/2 = 40 repetitions, B+ to A+ is 114/2 = 57 repetitions, A+ to S+ is 148/2 = 74 repetitions, in total 1 + 23 + 40 + 57 + 74 = 195 repetitions

			if $args[0] ! 'noreset':
				$subskill = ''
				$subskill_xp = ''
				$subskill_two = ''
				$subskill_two_xp = ''
				rise_difficulty = 0
				success = 0
			else
				success = args[1]
				rise_difficulty = args[2]
			end
		end

	end
}

!Sin Gained - overhauled by crushboss (overhauled again by ImperatorAugustus, see notes below)
! Revised to introduce a progression of guilt (as described in the game tutorial) tied to reasoned or instinctive internalization of slavery (credit to utterlyjunky for suggesting a progression and developing the formula)
! Instead of being essentially random with hard-coded fixed upper limits for each interaction, the highest level of guilt that can be felt by a slave is now capped by a max_guilt internal variable. Interactions can set upper bounds on the maximum amount of guilt they could possibly give to a slave (although many will not). For example, a comparatively "minor" violation like cumming with no-orgasm rule could be limited to 3 guilt even for a perfectly devoted slave. Meanwhile, a new slave with an uninitialized max_guilt would feel the minimum guilt (1) even for a "severe" infraction. I considered even letting disobedient slaves feel no guilt at all, but many texts in the game are written assuming that guilt is awarded (almost all of the interaction refusal texts, for example), so I kept the minimum at 1 for now.
! I also changed the behavior of gaining guilt on top of existing guilt. Now it replaces previous guilt only if the potential guilt of the new infraction is greater. Further, if a slave gains more guilt on top of unpunished existing guilt, they will lose a small amount of reflexive superiority-based obedience (aka instinct/taming). So repeatedly asking a slave to do things they refuse to do will drain their obedience in that way. I deliberately did not include increases in stats like pride or ego, even though those would "realistically" be boosted when a slave disobeys, because I did not want this to become a possible exploit for raising those stats (pride is not gameplay beneficial, but can be interesting for "roleplay" purposes, while ego/nature increases the market value of a slave).
$sin_gained_now = {
	dynamic "
		if <<$args[0]>>_state = CONST_INT['slave_exist'] and '<<$args[0]>>' = 'slave':
			! TODO: only primary slave can gain sin (for now) - ImperatorAugustus

			if <<$args[0]>>['meekness'] < 0 and <<$args[0]>>['meekness_revealed'] = 0: <<$args[0]>>['meekness_revealed'] = 1

			! code calling $sin_gained_now can pass an optional numeric second parameter to define an upper bound - ImperatorAugustus
			interaction_<<$args[0]>>['sin_potential'] = <<args[1]>>

			! code calling $sin_gained_now can also set sin_potential first to define an upper bound, 5 is default - ImperatorAugustus
			if interaction_<<$args[0]>>['sin_potential'] <= 0: interaction_<<$args[0]>>['sin_potential'] = 5

			! added taming drain when slaves gain additional guilt on top of guilt already felt (e.g., refusing a second order after refusing the first) - ImperatorAugustus
			if <<$args[0]>>['sin'] > 0 and game_difficulty = 2: <<$args[0]>>_rate['instinct'] -= (1 + <<$args[0]>>['sin'])/3 &! reduced magnitude and limited to extreme difficulty - ImperatorAugustus

			if <<$args[0]>>['obedience'] > 0:
				! set sin potential for obedient slaves to a pseudo-random value between 1 and itself
				interaction_<<$args[0]>>['sin_potential'] = 1 + (48271 * (day + <<$args[0]>>_already_done_total[$str(interaction)]) mod 65537)/(65537/interaction_<<$args[0]>>['sin_potential'])
			end

			! calculate potential guilt level as lesser of sin potential or max_guilt (see $dyn_torture_result), increased by sententia veritas is active, capped within [1,5] range
			interaction_<<$args[0]>>['sin_potential'] = max(1, min(5, min(interaction_<<$args[0]>>['sin_potential'], <<$args[0]>>['max_guilt']) + <<$args[0]>>['sententia_veritas'] ) )
			if <<$args[0]>>['sententia_veritas'] > 0: <<$args[0]>>['sententia_veritas'] = 0 &! clear the spell after applying the effect

			! guilt no longer accumulates, instead potential guilt replaces existing guilt only if potential guilt is greater than existing guilt - ImperatorAugustus
			<<$args[0]>>['sin'] = max(<<$args[0]>>['sin'], interaction_<<$args[0]>>['sin_potential'])

			! irrespective of whether we replaced existing guilt, reduce existing merit by the amount of new (potential) guilt - ImperatorAugustus
			<<$args[0]>>['virtue'] -= min(<<$args[0]>>['virtue'], interaction_<<$args[0]>>['sin_potential'])

			interaction_<<$args[0]>>['sin_potential'] = 0 &! reset variable

			master_moodlet['pos_nice_slave'] = 0
			if interaction_<<$args[0]>>['res'] < 0:
				! only apply rebellious slave moodlet and master mood drop for interaction refusals, not for inadequate diligence - ImperatorAugustus
				master_moodlet['neg_rebell'] = 1
				gs '$mod_master_drop', 1

				! slightly lower taming and angst and increase ego when the slave refuses (once per day per slave) - ImperatorAugustus
				if <<$args[0]>>_already_done_today['sin_gained_with_negative_res'] = 0:
					<<$args[0]>>_already_done_today['sin_gained_with_negative_res'] = 1
					<<$args[0]>>_rate['instinct'] -= (1 + <<$args[0]>>['ego'])/2 &! Instinctual obedience is reduced when the slave successfully disobeys, undermining the perception that the master is superior
					<<$args[0]>>_rate['angst'] -= 2
					<<$args[0]>>_rate['ego'] += 2
				end
			end

		end &! end of conscious state check - ImperatorAugustus
	"
}


!Virtue Gained - overhauled by crushboss
$virtue_gained_now = {
	! called by $dyn_skill_rise and interaction_result
	! if prior virtue exists, it will be added to new virtue only if the slave feels no guilt; otherwise new merit, if greater, will replace old merit
	dynamic "
		if slave_state = CONST_INT['slave_exist'] and '<<$args[0]>>' = 'slave':
			! TODO: only primary slave can gain virtue (for now) - ImperatorAugustus

			if <<$args[0]>>['meekness'] > 0 and <<$args[0]>>['meekness_revealed'] = 0: <<$args[0]>>['meekness_revealed'] = 1
			!if <<$args[0]>>_already_done_today[$str(interaction)] = 0:
				virtue_gained = 1 + ((48271 * (day + dynslave_type + interaction + <<$args[0]>>_already_done_total[$str(interaction)])) mod 65537)/(65537/max(1, min(<<$args[0]>>['temper'], interaction_<<$args[0]>>['diligence'] + <<$args[0]>>['spoil']*2 - <<$args[0]>>['moral'] - <<$args[0]>>['daily_reward_count']))) - <<$args[0]>>_already_done_recent[$str(interaction)] - <<$args[0]>>_already_done_today[$str(interaction)] &! potential merit is capped by temperament (to a minimum of 1), oft-repeated tasks give less merit, devoted slaves feel less deserving, spoiled slaves feel more deserving, and slaves who were already rewarded in the same day expect less subsequent rewards - ImperatorAugustus & qwertyu12359
				if interaction_<<$args[0]>>['repulse'] >= <<$args[0]>>['daring']: virtue_gained += 1
				if virtue_gained > 1 and interaction_<<$args[0]>>['repulse'] < <<$args[0]>>['daring'] - 8: virtue_gained -= 1
				if virtue_gained > 1 and $<<$args[0]>>_psy_status = 'frightened': virtue_gained -= 1
				if virtue_gained > 1 and <<$args[0]>>['angst'] > 0: virtue_gained -= 1
				if <<$args[0]>>['moral'] = 5: virtue_gained -= 1
				if virtue_gained <= 0: virtue_gained = 0
				if virtue_gained > 5: virtue_gained = 5
				if virtue_gained >= <<$args[0]>>['sin']:
					if <<$args[0]>>['moral'] = 5 and <<$args[0]>>['intellect'] > 3 and <<$args[0]>>['selfesteem'] >= 0:
						! prior guilt can be fully canceled by new merit if the slave is fully devoted, Clever or Intelligent, and has neutral or positive self-esteem - ImperatorAugustus & qwertyu12359
						! Guilt is an expectation of punishment. A fully devoted slave believes wholeheartedly that by doing what the master wants, they are doing The Right Thing.
						! A sufficiently clever, devoted slave reasons that if master chooses not to punish them when they feel guilty, master must have a good reason.
						! Instead of doubting it, they will put their whole focus into the next task and fully feel the merit they gain from it.
						<<$args[0]>>['sin'] = 0
					elseif <<$args[0]>>['sin'] > 0:
						! otherwise, retain some residual guilt - ImperatorAugustus & qwertyu12359
						<<$args[0]>>['sin'] = 1
					end
				else
					<<$args[0]>>['sin'] -= virtue_gained
					virtue_gained = 0
				end
				if virtue_gained >= <<$args[0]>>['virtue']:
					<<$args[0]>>['virtue'] += virtue_gained
					master_moodlet['pos_nice_slave'] = 2
					master_moodlet['neg_rebell'] = 0
				end
			!end
			if <<$args[0]>>['sententia_veritas'] > 0:
				!intentionally outside the already-done-today condition
				<<$args[0]>>['virtue'] += <<$args[0]>>['sententia_veritas']
				<<$args[0]>>['sententia_veritas'] = 0
			end
			if <<$args[0]>>['virtue'] > 5: <<$args[0]>>['virtue'] = 5
			if difficulty_setting ! 1 and interaction_<<$args[0]>>['diligence'] <= (<<$args[0]>>['moral'] - <<$args[0]>>['moral']/5 - <<$args[0]>>['spoil']): dynamic $sin_gained_now, '<<$args[0]>>' &! sub-par diligence produces guilt in devoted slaves, except on easy obedience difficulty - ImperatorAugustus
			virtue_gained = 0

		end &! end of conscious state check - ImperatorAugustus
	"
}

$dyn_virtue_gained_eroles = {
	! only one calling location: interaction_result (for self_sex_lesson)
	! expects to be called with dynamic $replace($dyn_virtue_gained_eroles, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state = CONST_INT['slave_exist'] and 'dynslave' = 'slave':
		! TODO: only primary slave can gain virtue (for now) - ImperatorAugustus

		if dynslave['meekness'] > 0 and dynslave['meekness_revealed'] = 0: dynslave['meekness_revealed'] = 1
		!if dynslave_already_done_today[$str(interaction)] = 0:
			virtue_gained = 1 + ((48271 * (day + dynslave_type + interaction + dynslave_already_done_total[$str(interaction)])) mod 65537)/(65537/max(1, min(dynslave['temper'], interaction_dynslave['diligence'] + dynslave['spoil']*2 - dynslave['moral'] - dynslave['daily_reward_count']))) - dynslave_already_done_recent[$str(interaction)] - dynslave_already_done_today[$str(interaction)] &! potential merit is capped by temperament (to a minimum of 1), oft-repeated tasks give less merit, devoted slaves feel less deserving, spoiled slaves feel more deserving, and slaves who were already rewarded in the same day expect less - ImperatorAugustus & qwertyu12359
			if interaction_dynslave['repulse'] >= dynslave['daring']: virtue_gained += 1
			if virtue_gained > 1 and interaction_dynslave['repulse'] < dynslave['daring'] - 8: virtue_gained -= 1
			if virtue_gained > 1 and $dynslave_psy_status = 'frightened': virtue_gained -= 1
			if virtue_gained > 1 and dynslave['angst'] > 0: virtue_gained -= 1
			if success >= rise_difficulty: virtue_gained += 2
			if dynslave['moral'] = 5: virtue_gained -= 1
			if virtue_gained <= 0: virtue_gained = 0
			if virtue_gained > 5: virtue_gained = 5
			if virtue_gained >= dynslave['sin']:
				if dynslave['moral'] = 5 and dynslave['intellect'] > 3 and dynslave['selfesteem'] >= 0:
					! prior guilt can be fully canceled by new merit if the slave is fully devoted, Clever or Intelligent, and has neutral or positive self-esteem - ImperatorAugustus & qwertyu12359
					! Guilt is an awareness of punishment deserved. A fully devoted slave believes wholeheartedly that by doing what the master wants, they are doing The Right Thing.
					! A sufficiently clever, devoted slave reasons that if master chooses not to punish them when they feel guilty, master must have a good reason.
					! Instead of doubting it, they will put their whole focus into the next task and fully feel the merit they gain from it.
					dynslave['sin'] = 0
				elseif dynslave['sin'] > 0:
					! otherwise, retain some residual guilt - ImperatorAugustus & qwertyu12359
					dynslave['sin'] = 1
				end
			else
				dynslave['sin'] -= virtue_gained
				virtue_gained = 0
			end
			if virtue_gained >= dynslave['virtue']:
				dynslave['virtue'] += virtue_gained
				master_mood_rate += virtue_gained
				master_moodlet['pos_nice_slave'] = 2
				master_moodlet['neg_rebell'] = 0
			end
		!end
		if dynslave['sententia_veritas'] > 0:
			!intentionally outside the already-done-today condition
			dynslave['virtue'] += dynslave['sententia_veritas']
			dynslave['sententia_veritas'] = 0
		end
		if dynslave['virtue'] > 5: dynslave['virtue'] = 5
		if difficulty_setting ! 1 and interaction_dynslave['diligence'] <= (dynslave['moral'] - dynslave['moral']/5 - dynslave['spoil']): dynamic $sin_gained_now, 'dynslave' &! sub-par diligence produces guilt in devoted slaves - ImperatorAugustus
		virtue_gained = 0

	end &! end of conscious state check - ImperatorAugustus
}


$dyn_skill_rise = {
	! called from interaction_result (expects to be called after $dyn_diligence)
	! calls $sin_gained_now if diligence is zero, otherwise calls $virtue_gained_now
	! optionally, caller can set $target_skill and $target_affinity appropriately for the current activity (e.g. 'slave_rate["stamina"]' and 'sport_affinity' respectively)
	! if set by caller, increases $target_skill rate by minimum of 1, more depending on diligence, intellect, applicable learn_bonus from items
	! expects caller to set tutor_modifier (usually derived from master skill, but can be zero if slave is performing a task independently)
	! expects caller to have set $misc_bonus to a string that will expand to the learn_bonus property appropriate for the current activity (e.g., 'learn_bonus["stamina"]')
	! if set by caller, reveals $target_affinity and sets pos_job or neg_job moodlet if the slave has a corresponding positive or negative affinity
	! expects to be called with dynamic $replace($dyn_skill_rise, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state = CONST_INT['slave_exist']:

! JO9 MOD START J9TP_FIXED_SKILL_WORK | 2026-10-17_traits_personality
		if $curloc = 'next_day': gs 'jo9_traits_personality', 'activity', 'dynslave', 'work:' + $target_skill, 1
! JO9 MOD END J9TP_FIXED_SKILL_WORK
		if $target_affinity ! '':
			if dynslave[$target_affinity] ! 0 and dynslave[$target_affinity + '_revealed'] = 0 and 'dynslave' ! 'assistant': dynslave[$target_affinity + '_revealed'] = 1
			if dynslave[$target_affinity] > 0: dynslave['pos_job'] = max(dynslave['pos_job'], 2)
			if dynslave[$target_affinity] < 0: dynslave['neg_job'] = max(dynslave['neg_job'], 2)
		end

		if $target_skill ! '':
			dyn_skill_rise_mod = tutor_modifier
			if dynslave['intellect'] < 2:
				dyn_skill_rise_mod -= 2
			elseif dynslave['intellect'] = 2:
				dyn_skill_rise_mod -= 1
			elseif dynslave['intellect'] = 4:
				dyn_skill_rise_mod += 1
			elseif dynslave['intellect'] = 5:
				dyn_skill_rise_mod += 2
			end
			if $misc_bonus = '':
				msg 'missing $misc_bonus for interaction (<<interaction>>)! please report this'
			else
				dynamic $replace($recalc_equipment_bonuses, 'dyn'+'slave', 'dynslave') &! refresh learn_bonus for slave (used in $misc_bonus)
				dynamic "dyn_skill_rise_mod += <<$misc_bonus>>"
			end
			skill_rise = (max(1, dyn_skill_rise_mod) * interaction_dynslave['diligence'])/4
			if $target_skill = 'stamina':
				skill_rise = skill_rise/2
				if skill_rise < 3: skill_rise = 3
				if dynslave_already_done_today['exertion'] >= dynslave['stamina']: skill_rise *= -1
				dynslave_already_done_today['exertion'] += 1
			else
				if $target_skill ! 'cowSK':
					dynslave_rate['cowSK'] -= 3 &! training any skill other than stamina decays cow training - ImperatorAugustus
				elseif dynslave['cowSK'] = 5:
					skill_rise = max(1, skill_rise - dynslave['cowSK']) &! S+ cow skill greatly impedes training other skills - ImperatorAugustus
				end
				if skill_rise < 1 or interaction_dynslave['diligence'] = 0: skill_rise = 1
			end
! JO9 MOD START COG_MAIN_XP | 2026-10-16_innate_learning_traits
! JO9 MOD START TRAITS_BODY_MAIN_XP | 2026-10-17_traits_batch
! JO9 MOD START J9TP_GAIN_1 | 2026-10-17_traits_personality
			dynslave_rate[$target_skill] += func('jo9_traits_personality', 'xp', 'dynslave', $target_skill, func('jo9_traits_combat', 'education_xp', 'dynslave', func('jo9_learning_xp', (skill_rise * skill_adv_mul), dynslave['jo9_learning_trait'], $target_skill), $target_skill))
! JO9 MOD END J9TP_GAIN_1
! JO9 MOD END TRAITS_BODY_MAIN_XP
! JO9 MOD END COG_MAIN_XP
		end

	end &! end of conscious state check
}

$sex_diligence = {
	phobia = 0
	if stimulating > 0 or orgastic > 0:
		phobia += sex['girl_nympho']
	end
	if shameful > 0:
		phobia += sex["girl_exhibitionism"] - shameful
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["exhibitionism_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["exhibitionism_xp"] += 1
		end
	end
	if painful > 0:
		phobia += sex["girl_masochism"] - painful
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["masochism_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["masochism_xp"] += 1
		end
	end
	if abuse > 0:
		phobia += sex["girl_abuse_attitude"] - abuse
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["abuse_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["abuse_xp"] += 1
		end
	end
	if disgusting > 0:
		phobia += sex["girl_perversion"] - disgusting
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["perversion_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["perversion_xp"] += 1
		end
	end
	if darkness > 0:
		phobia += sex["girl_darkness_attitude"] - darkness
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["darkness_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["darkness_xp"] += 1
		end
	end
	if bloody > 0:
		phobia += sex["girl_blood_attitude"] - bloody
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["blood_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["blood_xp"] += 1
		end
	end
	if fire_based > 0:
		phobia += sex["girl_fire_attitude"] - fire_based
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["fire_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["fire_xp"] += 1
		end
	end
	if water_based > 0:
		phobia += sex["girl_water_attitude"] - water_based
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["water_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["water_xp"] += 1
		end
	end
	if vermin_based > 0:
		phobia += sex["girl_vermin_attitude"] - vermin_based
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["vermin_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["vermin_xp"] += 1
		end
	end
	if deprivation > 0:
		phobia += sex["girl_deprivation_attitude"] - deprivation
		if sex_done_today[$str(sex_interaction)] = 0:
			if $sex['partner'] = '': slave["deprivation_xp"] += 1
			if $sex['partner'] = 'assistant': assistant["deprivation_xp"] += 1
		end
	end

	diligence = phobia - res + sex['girl_obedience'] &! subtract resistance threshold and adjust for obedience: diligence < 0 triggers refusal - ImperatorAugustus
	if sex['girl_openmind'] > res: diligence += 1
	if sex['girl_mood'] > res: diligence += 1
	if sex['girl_taming'] > res: diligence += 1
	if sex['girl_moral'] > res: diligence += 1
	if sex['girl_fear'] > res: diligence += 1
	if sex['girl_greed'] > res: diligence += 1
	if sex['girl_habit'] > res: diligence += 1
	if (stimulating > 0 or orgastic > 0) and sex['girl_excitement'] > diligence: diligence += 1
	if sex['girl_spoil'] > 0: diligence -= sex['girl_spoil']
	if sex['girl_pride'] > 0: diligence -= sex['girl_pride']
	if sex['girl_mood'] < 0: diligence += sex['girl_mood'] &! addition subtracts
	if sex['girl_angst'] > 0: diligence -= 1
	if sex['girl_openmind'] = 1: diligence -= 1

	if $sex['partner'] = '' and $slave_psy_status = 'broken': diligence = 0
	if $sex['partner'] = 'assistant' and $assistant_psy_status = 'broken': diligence = 0
	if sex['girl_energy'] <= 0: diligence = 0
	if diligence > 5: diligence = 5
}

$slave_energy_drop = {
	if cheat_inf_en = 0:
		slave['half_action'] += 2
		if easy_for_slave = 1: slave['half_action'] -= 1 & easy_for_slave = 0 &! clear the flag (used in interaction_result)
		if slave['half_action'] > 1: slave['energy'] -= 1 & slave['half_action'] -= 2
	end
	if slave['energy'] < -5: slave['energy'] = -5
	if slave['energy'] < 0: slave_rate['stamina'] += slave['energy']
	slave['calories'] -= 1
}

$assistant_energy_drop = {
	if cheat_inf_en = 0:
		assistant['half_action'] += 2
		if easy_for_assistant = 1: assistant['half_action'] -= 1 & easy_for_assistant = 0 &! clear the flag (used in interaction_result)
		if assistant['half_action'] > 1: assistant['energy'] -= 1 & assistant['half_action'] -= 2
	end
	if assistant['energy'] < -5: assistant['energy'] = -5
	if assistant['energy'] < 0: assistant_rate['stamina'] += assistant['energy']
	assistant['calories'] -= 1
	!calorie counting for assistant in case she switches to slave - ImperatorAugustus
}

$master_energy_drop = {
	if cheat_inf_en = 0:
		!revised bull ring effect to double actions per day instead of infinite - ImperatorAugustus
		master_half_action += iif(bull_ring_on = 1, 1, 2)
		if easy_for_master = 1: master_half_action -= 1 & easy_for_master = 0 &! clear the flag (used in interaction_result)
		if master_half_action > 1: master_energy -= 1 & master_half_action -= 2
	end
	if master_energy < -5: master_energy = -5
	if master_energy < 0 and obereg_on = 0: master_str_rate += master_energy
	! removed 'and bull_ring_on = 0' strength (master health) protection - ImperatorAugustus
}

$prisoner_energy_drop = {
	! added cheat_inf_en check for prisoner - ImperatorAugustus
	if cheat_inf_en = 0:
		prisoner['half_action'] += 2
		if easy_for_prisoner = 1: prisoner['half_action'] -= 1 & easy_for_prisoner = 0 &! clear the flag (used in interaction_result)
		if prisoner['half_action'] > 1: prisoner['energy'] -= 1 & prisoner['half_action'] -= 2
	end
	if prisoner['energy'] < -5: prisoner['energy'] = -5
	if prisoner['energy'] < 0: prisoner_rate['stamina'] += prisoner['energy']
	prisoner['calories'] -= 1
}

$cow_energy_drop = {
	! added cheat_inf_en check for cow - ImperatorAugustus
	if cheat_inf_en = 0:
		cow['half_action'] += 2
		if easy_for_cow = 1: cow['half_action'] -= 1 & easy_for_cow = 0 &! clear the flag (used in interaction_result)
		if cow['half_action'] > 1: cow['energy'] -= 1 & cow['half_action'] -= 2
	end
	if cow['energy'] < -5: cow['energy'] = -5
	if cow['energy'] < 0: cow_rate['stamina'] += cow['energy']
	cow['calories'] -= 1
}

$dynamic_energy_drop = {
	! added cheat_inf_en check - ImperatorAugustus
	if cheat_inf_en = 0:
		dynslave['half_action'] += 2
		if easy_for_dynslave = 1: dynslave['half_action'] -= 1 & easy_for_dynslave = 0 &! clear the flag (used in interaction_result)
		if dynslave['half_action'] > 1: dynslave['energy'] -= 1 & dynslave['half_action'] -= 2
	end
	if dynslave['energy'] < -5: dynslave['energy'] = -5
	if dynslave['energy'] < 0: dynslave_rate['stamina'] += dynslave['energy']
	dynslave['calories'] -= 1
}

$transport_energy_drop = {
	! energy drop only when traveling to a different district that is not the district where home estate is located
	! energy drop is also skipped if called with an estate name that matches the current home estate
	if city_form = city_district or (city_form/10) = city_district: exit &! at home, city_district is -1, so this is when not home and fast-traveling to where you already are
	if $quick_move_action = "go" and (city_form = estate_district[$estate] or (city_form/10) = estate_district[$estate]): exit &! fast travel/enter a district from city_form = 0
	if $args[0] = $estate: exit &! click per-decade event buttons, click empty slave avatar to go to market, click cryo button (when home capsule is rented)
	if chariot_state > CONST_INT['no_slave'] and horse_power > 0:
		horse_power -= 1
	else
		easy_for_master = 1 &! half-action or free with Bull Ring
		dynamic $master_energy_drop
	end
	dynamic $city_sounds &! convenient place to handle music transition for all home shortcuts - ImperatorAugustus
	if is_home = 1 and sound_on = 1: play 'content/snd/door.wav', sound_volume &! convenient place to handle departure sound for all home shortcuts - ImperatorAugustus
}

$volume_controls = {
	act '1':
		music_volume -= 10
		if music_volume < 0: music_volume = 0
		dynamic $play_music
		gt $curloc
	end
	act '2':
		music_volume += 10
		if music_volume > 100: music_volume = 100
		dynamic $play_music
		gt $curloc
	end
	act '3':
		if music_volume ! 0:
			rem_music_volume = music_volume
			music_off = 1
			music_volume = 0
		else
			music_volume = rem_music_volume
			music_off = 0
		end
		dynamic $play_music
		gt $curloc
	end
	act '4':
		sound_volume  -= 10
		if sound_volume < 0: sound_volume = 0
		dynamic $play_music
		gt $curloc
	end
	act '5':
		sound_volume += 10
		if sound_volume > 100: sound_volume = 100
		dynamic $play_music
		gt $curloc
	end
	act '6':
		if sound_volume ! 0:
			rem_sound_volume = sound_volume
			sound_off = 1
			sound_volume = 0
		else
			sound_volume = rem_sound_volume
			sound_off = 0
		end
		dynamic $play_music
		gt $curloc
	end
}

$play_music = {
	if sound_on = 1 and $toplay ! '':
		if $music_now ! $music[$toplay]:
			! it is unsafe to change tracks within a half-second of each other, and we have not found a viable workaround
			! closing a different audio file (or all files) somehow glitches the next play sometimes, so using close during track transitions is unsafe
			! quickly toggling sound on/off or quickly entering/leaving home also causes glitches (silence or city/night music continues instead of home music)
			! filing this under ??? for now; these glitches are avoidable by not spamming spacebar at night nor click-spamming the door button nor mute button
			$music_now = $music[$toplay] &! switch to the new track
		end
		if $music_now ! '': play $music_now, music_volume, 'only, loop' &! start new track / ensure it is playing (transitions sometimes glitch)
	end
}

$home_sounds = {
	if sound_on = 1:
		if demo_game = 1:
			$toplay = 'nostalgic'
		elseif master_mood < -3:
			$toplay = 'verybadmood'
		elseif master_mood > 3:
			$toplay = 'verygoodmood'
		elseif master_mood < 0:
			$toplay = 'badmood'
		elseif master_mood > 0:
			$toplay = 'goodmood'
		else
			$toplay = 'home'
		end
	end
	dynamic $play_music
}

$city_sounds = {
	if sound_on = 1:
		if city_form ! 1000:
			if noble_status = 1 or brand_reputation >= 5:
				$toplay = 'honor'
			elseif $estate = 'slum_house':
				$toplay = 'poor'
			else
				$toplay = 'citizen'
			end
		else
			$toplay = 'city'
		end
	end
	dynamic $play_music
}

$master_ejaculate = {
	if master_excitement >= 0:
		master_mood_rate += ejaculation_intensity * master_excitement
		master_moodlet['pos_satisfied'] = max(master_moodlet['pos_satisfied'], min(5, (1 + ejaculation_intensity)/2))
	end
	if debug_excitement = 1 and ejaculation_intensity > 5: msg 'ejaculation_intensity = <<ejaculation_intensity>>'
	master_excitement_rate -= ejaculation_intensity*10
	if master_excitement >= 0: master_libido_rate += ejaculation_intensity
	if master_excitement < 0:  master_libido_rate -= ejaculation_intensity
	gs '$calculate_attributes', 1 &! update excitement and libido (1 = skip mood update to not interfere with next_day mood checks when invoked via alarm rule - ImperatorAugustus)
}

$house_cleaning = {
	house_mess = 0
	if house_mess_rate >= 10: house_mess = 1
	if house_mess_rate >= 20: house_mess = 2
	if house_mess_rate >= 40: house_mess = 3
	if house_mess_rate >= 60: house_mess = 4
	if house_mess_rate >= 80: house_mess = 5
}

$dyn_stamina_rise = {
	! expects to be called with dynamic $replace($dyn_stamina_rise, 'dyn'+'slave', 'a slave instance variable'), # of calories, # of stamina points
	if dynslave_state = CONST_INT['slave_exist']:

		dynslave['calories'] -= args[0]
		if dynslave_already_done_today['exertion'] < dynslave['stamina']:
			dynslave_rate['stamina'] += min(interaction_dynslave['diligence'], args[1])
		else
			dynslave_rate['stamina'] -= min(interaction_dynslave['diligence'], args[1])
		end
		dynslave_already_done_today['exertion'] += 1

	end &! end of conscious state check
}

!Strange stamina gain fixed - crushboss
$dyn_slave_damaged = {
	! expects to be called with dynamic $replace($dyn_slave_damaged, 'dyn'+'slave', 'a slave instance variable')
	! caller can optionally set 'damage' global before calling, resulting in wounds if it exceeds the stamina of the slave
	! additional global flags 'bruising' and 'scarification' can be set to 1 by the caller if those impacts are desired
	if dynslave_state > CONST_INT['no_slave']:

		if damage > dynslave['stamina']: dynslave_rate['wounds'] += damage
		damage += dynslave['sensitivity'] + min(dynslave['wounds'], dynslave['hygiene']) - dynslave['stamina']
		if damage < 0: damage = 0
		dynslave_rate['stamina'] -= damage
		if bruising = 1:
			dynslave_rate['bruises'] += damage * (8 - dynslave['stamina']) &! slaves with lower endurance are more susceptible to bruising - ImperatorAugustus
			if dynslave_rate['bruises'] < cont_atr_threshold[1]: dynslave_rate['bruises'] = cont_atr_threshold[1] &! always reach at least first visible level
		end
		if scarification = 1: dynslave_rate['scars'] += damage
		damage = 0

	end &! end of conscious or fainted state check
}

$slave_fights_back = {
	killvar '$play_sound'
	$play_sound[1] = $cane_sound
	if master_str < 4: master_str_rate += 2
	dynamic $sin_gained_now, 'slave'
	msg '<<$경고>> <center>노예가 반란을 일으켰다.<br><br> 당신은 싸움을 준비해야 한다...</center>'
	количество_врагов = 1
	$враг[1] = 'воспитуемая'
	slave['beaten'] = 1
	slave['beaten_ever'] = 1
	slave['calories'] -= 5
	slave_rate['stamina'] += 2
	$fight_return = 'menu_form'
	combatant = 0 &! master is in the defending slot
	$toplay = 'girl'
	gt 'начать_бой'
}

$dyn_slave_forced = {
	! expects to be called with dynamic $replace($dyn_slave_forced, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state = CONST_INT['slave_exist']:

		killvar '$play_sound'
		$play_sound[1] = $cane_sound
		if master_str < 4: master_str_rate += 1
		if is_kid = 1 and dynslave['age'] = CONST_INT['loli_age']:
			if no_loli = 2 and dynslave['boobs'] = 0:
				msg '<<$경고>><center><<$dynslave_name>>(이)가 당신의 처우에 불만을 품고 난폭하게 달려들었다.<br><br>하지만 소녀는 쉽게 제압당했다.<br><br>당신보다 작은 아이를 제압하는 건 쉬운 일이다.</center>'
			else
				msg '<<$경고>> <<$dynslave_name>>(이)가 당신의 처우에 불만을 품고 난폭하게 달려들었다.<br><br>하지만 어린 아이는 매우 쉽게 제압당했다.<br><br> 당신보다 훨씬 작은 아이를 제압하는건, 무척 쉬운 일이다.</center>'
			end
		else
			msg '<<$경고>><center><<$dynslave_name>>(이)가 당신의 처우에 불만을 품고 난폭하게 달려들었다.<br><br>하지만 당신에게 저항하기에는 너무 약하기 때문에 쉽게 제압할 수 있었다.<br><br>덕택에 그녀는 몇 군데 멍이 생겼다.</center>'
		end
		dynslave['neg_forced'] = dynslave['ego']
		dynslave['virtue'] = 0
		if dynslave['sin'] = 0: dynamic $sin_gained_now, 'dynslave'
		dynslave['beaten'] = 1
		dynslave['beaten_ever'] = 1
		dynslave['calories'] -= 1
		damage = (5 - dynslave['stamina']) + master_str - master_fighter &! a skilled fighter can control his strength to reduce damage
		if damage > 5: damage = 5
		if damage > 0: gs '$mood_drop', 'dynslave', damage
		bruising = 1
		dynamic $replace($dyn_slave_damaged, 'dyn'+'slave', 'dynslave') &! protect from earlier replace

	end &! end of conscious state check
}

$dyn_rape_effects = {
	! expects to be called with dynamic $replace($dyn_rape_effects, 'dyn'+'slave', 'a slave instance variable')
	! this is for psychological effects of penetrative rape (any orifice), and defaults to vaginal if $subskill is not set - ImperatorAugustus
	! adapted from qwertyu12359 virgin rape effects, which were -1 nature, -1 temperament, -1 pride if above timid, +2 angst - ImperatorAugustus
	! currently, rape always leaves an impact on her guilt, pride, taming and mood (the latter penalty may be negated if devotion exceeds empathy)
	! we use a rape fear formula to assess whether the slave finds the experience traumatic enough to induce despair and more severe mood drops
	! if so, we apply additional penalties to mood, devotion and empathy and we use despair to create lingering trauma that requires management
	if dynslave_state > CONST_INT['no_slave']:

		rape_fear = max(0, (dynslave['pride']*2 + dynslave['ego'] + (dynslave['temper']+1)/2) + dynslave['intellect']/2 - dynslave['sex_sum'] - dynslave['moral']*3)
		if $subskill ! '': rape_fear -= 4 * dyneval($replace('result = <<$subskill>>', 'slave', 'dynslave')) &! 0 at F-, 4 at D-, 8 at C-, 12 at B+, 16 at A+, 20 at S+
		if $subskill = '': rape_fear -= 3 * dynslave['virginity'] &! 0 (natural virgin), 3 (restored hymen), 6 (non-virgin), 9 (stretched by fisting)
		! [0,20] + [0,-67], consisting of pride [0,10], ego [0,5], temper [0,3], intellect [0,2], rape-orifice penetration experience [0,-20], general sexual experience [0,-35], devotion [0,-12]

		! C- pride (3), B+ ego, B+ intellect, B+ temper,                        F- sex skills,  virgin,  no devotion =  6 + 3 + 2 + 1 - 0 - 0 - 0   = 12 = lingering trauma
		! B+ pride (2), B+ ego, B+ intellect, B+ temper,                       D- penetration,  !virgin, no devotion =  4 + 3 + 2 + 1 - 1 - 0 - 4   = 5  = lingering trauma
		! B+ pride (2), B+ ego, B+ intellect, B+ temper,                       C- penetration,  !virgin, no devotion =  4 + 3 + 2 + 1 - 2 - 0 - 8   = 0  = less affected

		! D- pride (4), B+ ego, B+ intellect, B+ temper, C- in 1, D- in 2 sex skill categories, virgin,  no devotion =  8 + 3 + 2 + 1 - 4 - 0 - 0   = 10 = lingering trauma
		! D- pride (4), B+ ego, B+ intellect, B+ temper, C- in 1, D- in 2 sex skill categories, !virgin, no devotion =  8 + 3 + 2 + 1 - 4 - 0 - 4   = 6  = lingering trauma
		! D- pride (4), B+ ego, B+ intellect, B+ temper, C- in 3 sex skill categories,          !virgin, no devotion =  8 + 3 + 2 + 1 - 6 - 0 - 4   = 4  = lingering trauma
		! D- pride (4), B+ ego, B+ intellect, B+ temper, C- in 5 sex skill categories,          !virgin, no devotion =  8 + 3 + 2 + 1 - 10 - 0 - 4  = 0  = less affected

		! F- pride (5), B+ ego, B+ intellect, B+ temper, C- in 5 sex skill categories,          virgin,  no devotion = 10 + 3 + 2 + 1 - 10 - 0 - 0  = 6  = lingering trauma
		! F- pride (5), B+ ego, B+ intellect, B+ temper, C- in 5 sex skill categories,         !virgin,  no devotion = 10 + 3 + 2 + 1 - 10 - 0 - 8  = -2 = less affected

		if dynslave['nymphomania'] < 0:     rape_fear += dynslave['temper'] &! frigid trait increases rape fear proportional to temperament (feels strongly)
		if dynslave['abuse_attitude'] = -1: rape_fear += dynslave['temper'] &! hysteric trait increases rape fear proportional to temperament (feels strongly)
		if dynslave['nymphomania'] > 0:     rape_fear -= dynslave['temper'] &! nymphomania trait decreases rape fear proportional to temperament (feels strongly)
		if dynslave['abuse_attitude'] = 2:  rape_fear -= dynslave['temper'] &! psi-masochist trait decreases rape fear proportional to temperament (feels strongly)

		dynslave['sin'] = 0 &! being raped clears guilt and raises guilt cap if less than or equal to her fear
		if dynslave['max_guilt'] <= dynslave['fear']: dynslave['max_guilt'] = min(5, dynslave['max_guilt'] + 1)
		dynslave['neg_raped'] = max(0, 1 + dynslave['sensitivity'] - dynslave['moral']*2) &! drops mood by 1 (equivalent to -10 mood rate) if not already applied
		dynslave_rate['pride'] -= dynslave['pride']*(10 - dynslave['neg_raped']) &! max 5 repetitions to drop highest pride (-80 rate threshold, rate can go up to +10)
		dynslave_rate['instinct'] += (6 - dynslave['ego'])*(2 - dynslave['neg_raped']/3) &! F- nature = up to 12 pts; B+ nature = up to 6 pts; S+ nature = up to 2 pts
		if rape_fear > 0:
			gs '$mood_drop', 'dynslave', dynslave['sensitivity'] &! reduce magnitude of any positive moodlets
			dynslave_rate['sensitivity'] -= dynslave['sensitivity']*7 &! max 3 repetitions to drop highest empathy (-80 rate threshold, rate can go up to +10)
			dynslave['angst'] = min(5, max(2, dynslave['sensitivity'] - 1, dynslave['angst'])) &! set despair to a minimum of 2 (3 if empathy is A+) if lower
			dynslave_rate['angst'] = max(dynslave_rate['angst'] + dynslave['neg_raped']*3, indep_atr_max_threshold[dynslave['angst']] / 2) &! set despair half-way to next level if lower
			if dynslave['angst'] = 5: dynslave_rate['ego'] -= 2 * dynslave['ego'] & dynslave_rate['temper'] -= 2 * dynslave['temper'] &! drain stats directly when angst is already maxed - ImperatorAugustus
		end

	end &! end of existence check
}

$dyn_slave_bathed = {
	! clear hygiene, makeup and perfume and set mood
	! expects to be called with dynamic $replace($dyn_slave_bathed, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state > CONST_INT['no_slave']:

		dynslave_rate['mood'] += dynslave['hygiene']/10 &! max of +2 mood with 200 hygiene - ImperatorAugustus
		dynslave_rate['hygiene'] = 0
		dynslave['hygiene'] = 0
		dynslave['pos_slave_clean'] = 1
		if dynslave['makeup'] ! 3: dynslave['makeup'] = 0
		if dynslave['perfume'] = 1: dynslave['perfume'] = 0
		house_mess_rate += 1

	end &! end of conscious or fainted state check
}

!CHARIOT RACE
$damage_frame = {
	if boards >= frame:
		boards -= 1
	else
		frame -= 1
	end
}

$damage_wheels = {
	if wheels >= chassis:
		wheels -= 1
	else
		chassis -= 1
	end
}

$chariot_crash = {
	if chariot['inertia'] > 1:
		frame = 0
	else
		dynamic $damage_frame
	end
}

$pony_death = {
	chariot['pony_health'] = 0
}


!TRINITY (BATTLE ENGINE)

$в_боевое_меню = {
	gs 'боевое_меню'
	gt 'боевой_интерфейс'
}

!from location 'сменить_оружие'
$сменить_вторичное = {
	gt 'боевой_интерфейс'
}
$убрать_основное = {
	$оружие = 'безоружный'
	gs 'боевое_меню'
	gt 'боевой_интерфейс'
}
$убрать_вторичное = {
	$вторичный = ''
	gs 'боевое_меню'
	gt 'боевой_интерфейс'
}

!Dual Wield system - Primary Weapon - overhauled by crushboss
$primary_weapon = {
	if no_wpn['за_спиной'] = 1:
	!Two-Handed Back Weapon
		$оружие = $за_спиной
		$вторичный = ''
		if combatant = 0: $за_спиной = $master_back_wpn & $master['prev_secondary_wpn'] = ''
		if combatant = 1: $за_спиной = $slave['back_wpn'] & $slave['prev_secondary_wpn'] = ''
		if combatant = 2: $за_спиной = $assistant['back_wpn'] & $assistant['prev_secondary_wpn'] = ''
	elseif no_wpn['справа'] = 1:
	!Right Weapon
		$оружие = $справа
		if combatant = 0: $справа = $master_right_wpn
		if combatant = 1: $справа = $slave['right_wpn']
		if combatant = 2: $справа = $assistant['right_wpn']
	elseif no_wpn['слева'] = 1:
	!Left Weapon
		$оружие = $слева
		if combatant = 0: $слева = $master_left_wpn
		if combatant = 1: $слева = $slave['left_wpn']
		if combatant = 2: $слева = $assistant['left_wpn']
	elseif no_wpn['предплечье'] = 1:
	!Bracer Weapon (arm)
		$оружие = $предплечье
		if combatant = 0: $предплечье = $master_arm_wpn
		if combatant = 1: $предплечье = $slave['arm_wpn']
		if combatant = 2: $предплечье = $assistant['arm_wpn']
	elseif no_wpn['в_сапоге'] = 1:
	!Boot Weapon (leg)
		$оружие = $в_сапоге
		if combatant = 0: $в_сапоге = $master_leg_wpn
		if combatant = 1: $в_сапоге = $slave['leg_wpn']
		if combatant = 2: $в_сапоге = $assistant['leg_wpn']
	end
	!Remember the previous primary weapon
	if $оружие ! '':
		if combatant = 0: $master['prev_primary_wpn'] = $оружие
		if combatant = 1: $slave['prev_primary_wpn'] = $оружие
		if combatant = 2: $assistant['prev_primary_wpn'] = $оружие
	end
}

!Dual Wield system - Secondary Weapon - overhauled by crushboss
$secondary_weapon = {
	if no_wpn['слева'] = 2:
	!Left Weapon
		$вторичный = $слева
		if combatant = 0: $слева = $master_left_wpn
		if combatant = 1: $слева = $slave['left_wpn']
		if combatant = 2: $слева = $assistant['left_wpn']
	elseif no_wpn['справа'] = 2:
	!Right Weapon
		$вторичный = $справа
		if combatant = 0: $справа = $master_right_wpn
		if combatant = 1: $справа = $slave['right_wpn']
		if combatant = 2: $справа = $assistant['right_wpn']
	elseif no_wpn['предплечье'] = 2:
	!Bracer Weapon (arm)
		$вторичный = $предплечье
		if combatant = 0: $предплечье = $master_arm_wpn
		if combatant = 1: $предплечье = $slave['arm_wpn']
		if combatant = 2: $предплечье = $assistant['arm_wpn']
	elseif no_wpn['в_сапоге'] = 2:
	!Boot Weapon (leg)
		$вторичный = $в_сапоге
		if combatant = 0: $в_сапоге = $master_leg_wpn
		if combatant = 1: $в_сапоге = $slave['leg_wpn']
		if combatant = 2: $в_сапоге = $assistant['leg_wpn']
	end
	!Remember the previous secondary weapon
	if $вторичный ! '':
		if combatant = 0: $master['prev_secondary_wpn'] = $вторичный
		if combatant = 1: $slave['prev_secondary_wpn'] = $вторичный
		if combatant = 2: $assistant['prev_secondary_wpn'] = $вторичный
	end
}

!Use Previous Weapon Configuration Option - crushboss
$previous_weapon = {
	!Primary
	if $оружие = '' and a = 1:
		if combatant = 0 and ($master_back_wpn = $master['prev_primary_wpn'] or _ 
							$master_left_wpn = $master['prev_primary_wpn'] or _ 
							$master_right_wpn = $master['prev_primary_wpn'] or _ 
							$master_arm_wpn = $master['prev_primary_wpn'] or _ 
							$master_leg_wpn = $master['prev_primary_wpn']): $оружие = $master["prev_primary_wpn"]
		if combatant = 1 and ($slave['back_wpn'] = $slave['prev_primary_wpn'] or _ 
							$slave['left_wpn'] = $slave['prev_primary_wpn'] or _ 
							$slave['right_wpn'] = $slave['prev_primary_wpn'] or _ 
							$slave['arm_wpn'] = $slave['prev_primary_wpn'] or _ 
							$slave['leg_wpn'] = $slave['prev_primary_wpn']): $оружие = $slave["prev_primary_wpn"]
		if combatant = 2 and ($assistant['back_wpn'] = $assistant['prev_primary_wpn'] or _ 
							$assistant['left_wpn'] = $assistant['prev_primary_wpn'] or _ 
							$assistant['right_wpn'] = $assistant['prev_primary_wpn'] or _ 
							$assistant['arm_wpn'] = $assistant['prev_primary_wpn'] or _ 
							$assistant['leg_wpn'] = $assistant['prev_primary_wpn']): $оружие = $assistant["prev_primary_wpn"]
	end

	! Secondary
	if $вторичный = '' and a = 1:
		if combatant = 0 and ($master_left_wpn = $master["prev_secondary_wpn"] or _ 
							$master_right_wpn = $master["prev_secondary_wpn"] or _ 
							$master_arm_wpn = $master["prev_secondary_wpn"] or _ 
							$master_leg_wpn = $master["prev_secondary_wpn"]): $вторичный = $master["prev_secondary_wpn"]
		if combatant = 1 and ($slave['left_wpn'] = $slave["prev_secondary_wpn"] or _ 
							$slave['right_wpn'] = $slave["prev_secondary_wpn"] or _ 
							$slave['arm_wpn'] = $slave["prev_secondary_wpn"] or _ 
							$slave['leg_wpn'] = $slave["prev_secondary_wpn"]): $вторичный = $slave["prev_secondary_wpn"]
		if combatant = 2 and ($assistant['left_wpn'] = $assistant["prev_secondary_wpn"] or _ 
							$assistant['right_wpn'] = $assistant["prev_secondary_wpn"] or _ 
							$assistant['arm_wpn'] = $assistant["prev_secondary_wpn"] or _ 
							$assistant['leg_wpn'] = $assistant["prev_secondary_wpn"]): $вторичный = $assistant["prev_secondary_wpn"]
	end
}

$взять_оружие_за_спиной = {
	if $класс_оружия[$за_спиной]!'вторичное_оружие':
		if $за_спиной ! 'вторичный':
			$оружие = $за_спиной
			if $класс_оружия[$за_спиной] = 'тяжелое_оружие': $вторичный = ''
! JO9 MOD START J9M1801 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
			if nogoto = 0: $действия_игрока = '당신은 <<$item_name[$за_спиной]>>을 집어 든다'
! JO9 MOD END J9M1801
			if nogoto = 0: gt 'ход_противников'
		end
	end
}
