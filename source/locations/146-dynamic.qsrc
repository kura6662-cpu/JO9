 if instr($result,'(한결 부드러워진 표정으로) ')=1: $result=$trim(mid($result,16,len($result)))
 if instr($result,'(한결 풀어진 얼굴로) ')=1: $result=$trim(mid($result,13,len($result)))
 if instr($result,'(아쉬움이 스치는 눈빛으로) ')=1: $result=$trim(mid($result,16,len($result)))
