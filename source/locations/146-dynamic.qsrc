	if $slave['boobs_img'] = 'boobs_D':  $slave['boobs_img'] = 'boobs_DP'
	if $slave['boobs_img'] = 'boobs_CC': $slave['boobs_img'] = 'boobs_CP'
	if $slave['boobs_img'] = 'boobs_C':  $slave['boobs_img'] = 'boobs_CP'
	if $slave['boobs_img'] = 'boobs_BB': $slave['boobs_img'] = 'boobs_BP'
	if $slave['boobs_img'] = 'boobs_B':  $slave['boobs_img'] = 'boobs_BP'
	if $slave['boobs_img'] = 'boobs_A':  $slave['boobs_img'] = 'boobs_AP'
}

$pierce_clitoris = {
}

$rise_faction_fame = {
	no_rise = 0
	if $npc_alignment[$npc_id] = 'taurus' and faction_fame['kamira'] > 2 and npc_progress['pope'] < 2: no_rise = 1
	if $npc_alignment[$npc_id] = 'serpis' and faction_fame['korvus'] > 2 and npc_progress['pope'] < 2: no_rise = 1
	if $npc_alignment[$npc_id] = 'kamira' and faction_fame['taurus'] > 2 and npc_progress['pope'] < 2: no_rise = 1
	if $npc_alignment[$npc_id] = 'korvus' and faction_fame['serpis'] > 2 and npc_progress['pope'] < 2: no_rise = 1
	
	if noble_status > 0 and noble_via_faction = 1 and faction_fame[$npc_alignment[$npc_id]] = 4 and ($npc_alignment[$npc_id] = 'taurus' or $npc_alignment[$npc_id] = 'serpis' or $npc_alignment[$npc_id] = 'kamira' or $npc_alignment[$npc_id] = 'korvus'): no_rise = 1 &! already a patrician of another faction
	if faction_fame[$npc_alignment[$npc_id]] >= 5: no_rise = 1 &! already at maximum
	if no_rise = 0: faction_fame[$npc_alignment[$npc_id]] += 1
}

$death = {
	! Just print the message and wait for click anything for reading verify
	!$_d_answer = input($args[0] + ' Restart the game.')
	!killvar '$_d_answer'
	day = 0 &! redirect ESC key to main menu
	gt 'exit', $args[0]
}

!assistant rule reset (replaced $assistant_purge_rules with a single function for clear all or enable all) - ImperatorAugustus
$reset_assistant_rules = {
	!all assistant rules have been moved from independent variables to properties of the assistant array variable
	!likewise, slave rules have been moved from independent variables to properties of the slave array variable
	!properties below use same names as equivalent rules for slave so rules transfer automatically when swapping
	assistant['account_rule'] = args[0]
	assistant['cleans_rule'] = args[0]
	assistant['cooks_rule'] = args[0]
	assistant['washes_master_rule'] = args[0]
	assistant['tentacle_rule'] = iif(pet_tentacle > 0, args[0], 0)
	!properties below are assistant-exclusive (e.g. slave['account_rule'] is used, slave['buy_milk'] is not)
	!assistant_alchemist_rule was missing from previous implementation ($assistant_purge_rules)
	assistant['alchemist_rule'] = args[0]
	assistant['supervise_rule'] = args[0]
	assistant['washes_slave_rule'] = args[0]
	assistant['buy_vegetables'] = args[0]
	assistant['buy_flour'] = args[0]
	assistant['buy_spice'] = args[0]
	assistant['buy_cheese'] = args[0]
	assistant['buy_alcohol'] = args[0]
	assistant['buy_eggs'] = args[0]
	assistant['buy_milk'] = args[0]
	assistant['buy_cream'] = args[0]
	assistant['buy_mince'] = args[0]
	assistant['buy_meat'] = args[0]
	!intentionally not included: assistant_quiet_rule (quiet mode is a global policy, not assistant-specific)
}

