 if instr($result,'(미소를 머금으며) ')=1: $result=$trim(mid($result,11,len($result)))
 if instr($result,'(기분 좋게 눈을 맞추며) ')=1: $result=$trim(mid($result,15,len($result)))
 if instr($result,'(공손한 자세로) ')=1: $result=$trim(mid($result,10,len($result)))
 if instr($result,'(자세를 바로잡으며) ')=1: $result=$trim(mid($result,12,len($result)))
 if instr($result,'(차분히 반성하는 태도로) ')=1: $result=$trim(mid($result,15,len($result)))
