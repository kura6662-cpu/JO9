		faction_fame['korvus'] = 1
		$starting_area = '<font color="009FEF">네크로폴리스</font>'
		faction_purchase_kamira = 0
		faction_purchase_serpis = 0
		faction_purchase_taurus = 0
		faction_purchase_korvus = 1
		faction_purchase_neutral = 0
		dynamic $faction_adjustment
	end
}

$faction_adjustment = {
	if faction_fame['neutral'] = 1:
		if faction_fame['korvus'] = 0:
			hero_points -= 40
			faction_fame['korvus'] = 1
		end
		if faction_fame['taurus'] = 0:
			hero_points -= 20
			faction_fame['taurus'] = 1
		end
		if faction_fame['serpis'] = 0:
			hero_points -= 10
			faction_fame['serpis'] = 1
		end
		if faction_fame['kamira'] = 0:
			hero_points -= 5
			faction_fame['kamira'] = 1
		end
	end
	if faction_fame['korvus'] = 1:
		if faction_fame['taurus'] = 0:
			hero_points -= 20
			faction_fame['taurus'] = 1
		end
		if faction_fame['serpis'] = 0:
			hero_points -= 10
			faction_fame['serpis'] = 1
		end
		if faction_fame['kamira'] = 0:
			hero_points -= 5
			faction_fame['kamira'] = 1
		end
	end
	if faction_fame['taurus'] = 1:
		if faction_fame['serpis'] = 0:
			hero_points -= 10
			faction_fame['serpis'] = 1
		end
		if faction_fame['kamira'] = 0:
			hero_points -= 5
			faction_fame['kamira'] = 1
		end
	end
	if faction_fame['serpis'] = 1:
		if faction_fame['kamira'] = 0:
			hero_points -= 5
			faction_fame['kamira'] = 1
		end
	end
}

