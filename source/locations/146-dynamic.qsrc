! JO9 MOD START VOICE_ARGON_NATIVE | 2026-10-18_argon_revised_dialogue
! Complete authored fragments; original native dispatch selects the group.
$voice_native_history_write = {
 $dynslave['jo9_voice_last2_native_'+$args[0]]=$args[2]
 $dynslave['jo9_voice_last1_native_'+$args[0]]=$args[1]
}
$voice_native_pending_clear = {
 killvar '$jo9_vnp_actor'
 killvar '$jo9_vnp_group'
 killvar '$jo9_vnp_signature'
 killvar '$jo9_vnp_last1'
}
$voice_native_pending_commit = {
 jo9_vnp_at=0
 :jo9_vnp_next
 if jo9_vnp_at<arrsize('$jo9_vnp_group'):
  dynamic $replace($voice_native_history_write,'dyn'+'slave',$jo9_vnp_actor[jo9_vnp_at]),$jo9_vnp_group[jo9_vnp_at],$jo9_vnp_signature[jo9_vnp_at],$jo9_vnp_last1[jo9_vnp_at]
  jo9_vnp_at+=1
  jump 'jo9_vnp_next'
 end
 killvar 'jo9_vnp_at'
}
$voice_native_actor = {
 $jo9_vn_group=$args[0]
 $jo9_vn_original=$args[1]
 $result=$jo9_vn_original
 $jo9_vn_profile=$dyneval($voice_profile,$jo9_vn_occupation,dynslave['temper'],dynslave['sensitivity'],dynslave['ego'],dynslave['pride'])
 jo9_vf_tone=val(mid($jo9_vn_profile,len($jo9_vn_profile),1))
 $jo9_vf_type=mid($jo9_vn_profile,1,len($jo9_vn_profile)-2)
 $jo9_vf_mode='neutral'
 if instr('|reluctant|arrogant|hateful|resistant|hysteric|','|'+$jo9_vn_psy+'|')>0: $jo9_vf_mode='hostile'
 if $jo9_vn_psy='lachrymose' or $jo9_vn_psy='frightened': $jo9_vf_mode='fearful'
 if $jo9_vn_psy='depresive': $jo9_vf_mode='bleak'
 if $jo9_vn_psy='broken': $jo9_vf_mode='broken'
 if $jo9_vn_psy='optimistic': $jo9_vf_mode='hopeful'
 if $jo9_vn_psy='obedient' or $jo9_vn_psy='servile' or $jo9_vn_psy='horny':
  $jo9_vf_mode='duty'
  if dynslave['moral']>=4: $jo9_vf_mode='loyal'
 end
 jo9_vn_fear=dynslave['fear']
 jo9_vn_mood=dynslave['mood']
 jo9_vn_score_vulnerable=2*dynslave['moral']-dynslave['pride']-2*(dynslave['fear']>=4)
 jo9_vn_score_hostile=dynslave['ego']+dynslave['temper']-2*dynslave['fear']
 jo9_vn_score_positive=2*dynslave['moral']+dynslave['sensitivity']-dynslave['pride']
 jo9_vn_depth_vulnerable=(jo9_vn_score_vulnerable>=4)+(jo9_vn_score_vulnerable>=8)
 jo9_vn_depth_hostile=(jo9_vn_score_hostile>=4)+(jo9_vn_score_hostile>=8)
 jo9_vn_depth_positive=(jo9_vn_score_positive>=4)+(jo9_vn_score_positive>=8)
 $jo9_vf_last1=$dynslave['jo9_voice_last1_native_'+$jo9_vn_group]
 $jo9_vf_last2=$dynslave['jo9_voice_last2_native_'+$jo9_vn_group]
 $jo9_vf_signature=''
 jo9_vf_reward_total=0
 jo9_vn_skip=0
 if $jo9_vn_actor='slave1':
  ! These native statements are overwritten before any page can be displayed.
  if instr($jo9_vn_group,'1117_refuse_talk_')=1: jo9_vn_skip=1
  if snk_origin_relation and slave1['isolate']<1 and (sa_rel ! 2 or slave['obedience']>=0): jo9_vn_skip=1
 end
 $jo9_vn_core=''
 if jo9_vn_skip=0: $jo9_vn_core=$dyneval($voice_pick_fragment,'native_'+$jo9_vn_group+'_core','',2,'native')
 $jo9_vn_detail=''
 if $jo9_vn_core ! '':
  $jo9_vn_detail=$dyneval($voice_pick_fragment,'native_'+$jo9_vn_group+'_detail','',2,'native')
  if instr($jo9_vn_group,'1111_')=1:
   $jo9_vn_category=''
   if instr($jo9_vn_group,'1111_world_')=1: $jo9_vn_category='world'
   if instr($jo9_vn_group,'1111_family_')=1: $jo9_vn_category='family'
   if instr($jo9_vn_group,'1111_occupation_')=1: $jo9_vn_category='occupation'
   if $jo9_vn_category ! '': $jo9_vn_detail=$dyneval($voice_pick_fragment,'native_1111_'+$jo9_vn_category+'_react_detail','',2,'native')
  end
  $jo9_vn_text=$jo9_vn_core
  if $jo9_vn_detail ! '': $jo9_vn_text+=' '+$jo9_vn_detail
  ! Bind only the five locked source tokens, in the current native speaker context.
  $jo9_vn_text=$replace($jo9_vn_text,'{PH_001}',$slave_noun1[dynslave['age']])
  $jo9_vn_text=$replace($jo9_vn_text,'{PH_002}',iif(dynslave['courage'] ! 2,' 무섭고',''))
  $jo9_vn_text=$replace($jo9_vn_text,'{PH_003}',$little_txt)
  $jo9_vn_text=$replace($jo9_vn_text,'{PH_004}',$slave_noun4[dynslave['age']])
  $jo9_vn_text=$replace($jo9_vn_text,'{PH_005}',$slave2['name'])
  ! JO9 MOD START VOICE_RELATION_CALL | 2026-10-18_relation_dialogue_flow
  if $jo9_vn_actor='slave1': $jo9_vn_text=$dyneval($voice_relation_line,$jo9_vn_group,$jo9_vn_text,args[2])
  ! JO9 MOD END VOICE_RELATION_CALL
  $jo9_vn_prefix=''
  $jo9_vn_suffix=''
  jo9_vn_prefix_at=instr($jo9_vn_original,']<br>')
  if jo9_vn_prefix_at>0: $jo9_vn_prefix=mid($jo9_vn_original,1,jo9_vn_prefix_at+len(']<br>')-1)+'&nbsp;'
  if instr($jo9_vn_original,'</div>')>0: $jo9_vn_suffix='</div>'
  $jo9_vn_color=$strfind($jo9_vn_original,'<font[^>]*>')
  if $jo9_vn_color ! '': $jo9_vn_text=$jo9_vn_color+$jo9_vn_text+'</font>'
  $result=$jo9_vn_prefix+$jo9_vn_text+$jo9_vn_suffix
  if $jo9_vn_actor='slave1':
   $result=' '+$result+' '
   if $text[2]=$slave2['name']: $result=': '+$trim($result)+' '
  end
  if $jo9_vf_signature ! '':
   if jo9_vn_defer_history=1 or $jo9_vn_group='1113_no_need' or $jo9_vn_group='1113_no_need_gentle' or $jo9_vn_group='1114_no_like' or $jo9_vn_group='1114_no_like_gentle':
    $jo9_vnp_actor[]=$jo9_vn_memory_actor
    $jo9_vnp_group[]=$jo9_vn_group
    $jo9_vnp_signature[]=$jo9_vf_signature
    $jo9_vnp_last1[]=$jo9_vf_last1
   else
    dynamic $replace($voice_native_history_write,'dyn'+'slave',$jo9_vn_memory_actor),$jo9_vn_group,$jo9_vf_signature,$jo9_vf_last1
   end
  end
 end
 ! JO9 MOD START VOICE_RELATION_FALLBACK_CONTEXT | 2026-10-18_relation_semantic_speech
 if $jo9_vn_actor='slave1' and jo9_relation_active=1 and args[2]>0 and $jo9_vn_core='':
