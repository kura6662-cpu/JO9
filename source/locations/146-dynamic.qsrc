!Cryo Sleep - new buttons on main menu feature - crushboss (converted to dynamic - ImperatorAugustus)
$show_main_screen_cryo_cell_button = {
	cryo_cell_button_number = val(replace($args[0], 'iced_', ''))
	if dyneval("result = iced_<<cryo_cell_button_number>>_state") = CONST_INT['no_slave']:
		*p '<div id = "stasis_cell_<<cryo_cell_button_number>>"><a class="tooltip-left" tooltip-data="극저온 보관 - 셀 <<cryo_cell_button_number>>" href = "EXEC: cryo_cell_selected = <<cryo_cell_button_number>> & gs ''slave_to_iced'', <<cryo_cell_button_number>> & gt ''menu_form''"><img src = "content\pic\ui\crushboss\white_<<cryo_cell_button_number>>.png"></a></div>'
	else
		*p '<div id = "stasis_cell_<<cryo_cell_button_number>>"><a class="tooltip-left" tooltip-data="극저온 보관 - 셀 <<cryo_cell_button_number>>" href = "EXEC: cryo_cell_selected = <<cryo_cell_button_number>> & gt ''menu_form''"><img src = "content\pic\ui\crushboss\arousal_<<cryo_cell_button_number>>.png"></a></div>'
	end
}

!Cryo Storage - Selected cell - crushboss (converted to dynamic - ImperatorAugustus)
$show_main_screen_selected_cryo_cell_avatar = {
	if dyneval("result = iced_<<cryo_cell_selected>>_state") ! CONST_INT['no_slave']:
		dynamic "$cryo_cell_avatar_slave_name = $iced_<<cryo_cell_selected>>_name"
		dynamic "$cryo_cell_avatar_image = $<<'iced_'+$str(cryo_cell_selected)+'[''ava_gray'']'>>"
		*p '<div id = "stasis"><a class="tooltip-left-huge" tooltip-data="극저온 보관 중인 <<$cryo_cell_avatar_slave_name>> - 셀 <<cryo_cell_selected>>" href = "EXEC: gs ''slave_to_iced'', <<cryo_cell_selected>> & gt ''menu_form''"><img src = "<<$cryo_cell_avatar_image>>.png"></a></div>'
	end
}

$chariotweight = {
	chariot_weight = (heavy_frame + heavy_boards + heavy_chassis + heavy_wheels + heavy_rider_armor) + 5
}

$msgsmallfont = {
	!currently used only for rules explanations on slave_stat screen
	msg '<div id="inksmall"><<$args[0]>></div>'
}

$msg = {
	$MSG_FORMAT = '<div id="ink">%TEXT%</div>'
	msg '<<$args[0]>>'
}

$milking_result = { 
	$text[2] = '  착유의 총 결과: 우유 <<milk_bottle_plus>>병<<iif(milk_bottle_plus ! 1, "", "")>>.'
	if milk_bottle_plus > 0:
		dynamic $get_fridge_space
		if fridge_space >= 10:
			milk_bottle_plus += fridge['milk']
			fridge['milk'] = 0
			if milk_bottle_plus <= 10:
				fridge['milk'] = milk_bottle_plus
				milk_bottle_plus = 0
			else
				fridge['milk'] = 10
				milk_bottle_plus -= 10
			end
		end
		if milk_bottle_plus > 0:
			if milk_can = 1:
				milk_stock += milk_bottle_plus
				if milk_stock > 100:
					milk_stock = 100
					$text[2] += '<br><br>  우유 탱크는 우유를 최대 백 병까지만 저장할 수 있다. 초과분은 버려졌다.'
				end
			else
				$text[3] = '  냉장고는 우유를 열 병까지만 저장할 수 있는데 지금은 가득 차 있다. 남는 분량을 보관하려면 우유 탱크에 투자해야 한다.'
			end
		end
		milk_bottle_plus = 0
	end
}

$milk_price = {
	if milk_tip ! 1:
		milk_price += rand(-1,1)
	end

	if milk_tip = 1:
		if milk_demand = 0: milk_price -= 1
		if milk_demand = 1: milk_price += 0
		if milk_demand = 2: milk_price += 1
	end

	if milk_price < 1: milk_price = 1
	if milk_price > 7: milk_price = 7
}

!wore clothes and equipments are sold along the slave - Pianocat
$sold_clothing = {
	slave_inventory[$slave["cloth"]] -= 1
	slave_inventory[$slave["headband"]] -= 1
	slave_inventory[$slave["earrings"]] -= 2
	slave_inventory[$slave["collar"]] -= 1
	slave_inventory[$slave["gloves"]] -= 1
	slave_inventory[$slave["boots"]] -= 1
	slave_inventory[$slave["nipplerings"]] -= 1
	slave_inventory[$slave["clitring"]] -= 1
	slave_inventory[$slave["navel"]] -= 1
	slave_inventory[$slave["tongue"]] -= 1
	slave_inventory[$slave["ring_right"]] -= 1
	slave_inventory[$slave["ring_left"]] -= 1
	slave_inventory[$slave["armor"]] -= 1
	slave_inventory[$slave["back_wpn"]] -= 1
	slave_inventory[$slave["left_wpn"]] -= 1
	slave_inventory[$slave["right_wpn"]] -= 1
}

$inseminate = {
	!simplifying assumption: even if ejaculation_intensity = 0 (master did not cum inside), enough sperm was introduced via precum or otherwise
	!sperm remain viable for 3-5 days after insemination (overwrite pre-existing value, because hunter-killer sperm and statistical variability)
	dynamic "<<$args[0]>>['inseminated'] = rand(3,5) & <<$args[0]>>['cum_load'] += ejaculation_intensity * (1 + master_libido/5)" &! added libido bonus (2x at S+) - ImperatorAugustus
}


$vaginally_penetrated = {
! JO9 MOD START J9M1761 | 2026-10-15_zz_meiki_state | changed block; context may be included
 gs 'jo9_meiki_state', 'dynslave', 0
! JO9 MOD END J9M1761
	! actually called from interaction_result, but implemented in interaction in $special_part sections (expects to be called with a slave instance as parameter)
	! expects to be called with dynamic $replace($vaginally_penetrated, 'dyn'+'slave', 'a slave instance variable')
	if dynslave_state > CONST_INT['no_slave']:

		if dynslave['virginity'] < 2:
			if dynslave['virginity'] ! 1:
				! check for restored hymen to close potential exploit, and make simplifying assumption that master is around if not involved - ImperatorAugustus
				if is_perv ! 0 and dynslave['age'] = CONST_INT['loli_age']:
					master_perv_rate += 10
					if ejaculation_intensity > 0 and dynslave['age'] = CONST_INT['young_age']: was_virgin = 1 &! flag for Uncle Tom (see $calculate_attributes)
				end
				if $interaction_type ! 'rape' and $interaction_type ! 'torture' and dynslave['domini_dictum'] = 1: dynamic $replace($dyn_rape_effects, 'dyn'+'slave', 'dynslave')
				! interaction_result for 'rape' or 'torture' already applies rape effects: this catches defloration forced via domini dictum by other methods - ImperatorAugustus
			end
			if dynslave['masochism'] ! 2: dynslave['neg_defloration'] = max(0, 1 + dynslave['sensitivity'] + dynslave['pride'] - dynslave['moral']*2 - dynslave['arousal'])
			! above formula is balanced so that maxed devotion and arousal exactly negate maxed sensitivity and pride - ImperatorAugustus
			if dynslave['neg_defloration'] > 0: gs '$mood_drop', 'dynslave', dynslave['neg_defloration']
			dynslave['virginity'] = 2
! JO9 MOD START J9M1760 | 2026-10-15_zz_meiki_state | changed block; context may be included
			! MEIKI_CHECKS_V1: transition result selects state-handler argument 1 or 0.
			if func('jo9_meiki_checks', 'transition', $interaction_type, interaction_dynslave['diligence'], func('jo9_meiki_willing', 'dynslave', 0)) = 1:
				gs 'jo9_meiki_state', 'dynslave', 1
			else
				gs 'jo9_meiki_state', 'dynslave', 0
			end
! JO9 MOD END J9M1760
		end

		if dynslave['sub_vaginal'] < 1: dynslave['sub_vaginal'] = 1

		if ejaculation_intensity > 0:
			dynamic $master_ejaculate
			!TODO: assuming that ejaculation_intensity > 0 implies the vaginal penetration was done by the master is not necessarily true in all cases - ImperatorAugustus
			if hero_choice < 100 or $current_sub = '$interaction_lesson_dp' or $interaction_type = 'impregnate_cow': 
				dynamic $inseminate, 'dynslave'
			end
			master_penetration_rate += (skill_adv_mul * 1)
			if master_ill = 0 and dynslave['ill'] > 0 and rand(1,6) > master_str and obereg_on = 0: master_ill += 1 &! venereal disease transmission to master
			if master_ill > 0 and dynslave['ill'] = 0 and rand(1,6) > dynslave['stamina']: dynslave['ill'] += 1 &! venereal disease transmission to slave
		end
	end
}

$plastics_get_image_range = {
	if dynslave['age'] = CONST_INT['young_age']:
		txt_count = young_last
		min_txt = young_first
	elseif dynslave['age'] = CONST_INT['loli_age']:
		txt_count = loli_last
		min_txt = loli_first
	elseif dynslave['age'] = CONST_INT['milf_age']:
		txt_count = milf_last
		min_txt = milf_first
	end
}

$plastics_hair_color_range = {
	if instr($fullimage[txt], $hair_color) = 0: 
		txt += args[0]
		dynamic $plastics_hair_color_range, args[0]
	end
}

$plastics_confirm_appearance = {
	$dynslave["fullimage"] = $fullimage[txt]
	$dynslave["ava"] = $seed_ava[txt]
	$dynslave["ava_gray"] = $seed_ava_gray[txt]
	$dynslave["ava_clear"] = $seed_ava_clear[txt]
	$dynslave["hairColor"] = ''
	slave_type = txt 
	sp_txt = 1
	killobj
	dynamic $replace($plastics_confirm_procedure, "dyn"+"slave", $plastics_target)
	gt "shop_general"
}

$plastics_confirm_procedure = {
! JO9 MOD START TBV_SURGERY | 2026-10-17_trait_value
	gs 'jo9_traits_value', 'surgery', 'dynslave'
	sparks -= procedure_price
	dynslave['energy'] = -4
	dynslave_rate['stamina'] -= 20
	dynslave['rehabilitation'] = rehabilitation_period
	dynslave['beauty_enhanced'] = 1
	if dynslave['base_beauty'] < 5: dynslave_rate['beauty'] = cont_atr_threshold[dynslave['base_beauty'] + 1]
! JO9 MOD END TBV_SURGERY
}

$console = {
	$command = $trim($input("*뭘 하는지 알고 있을 때만 써라*"))
	if mid($command,1,1) = '@':
		dynamic $mid($command,2)
	elseif instr($command, ' ') > 0:
		msg '잘못된 입력 (공백 포함): 명령에는 @ 접두사를 써라'
	else
		dynamic "msg " + $command
	end
}

! 0 -> index, 1 -> text
$save_link = {
	if args[0] ! -1:
		$menu_links[args[0]] = $args[1]
	else
		killvar '$menu_links'
	end
}


