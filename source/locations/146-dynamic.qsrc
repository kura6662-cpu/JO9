	if slave['cooks_rule'] = 1: preset_slave_cooks_rule[i] = 1
	if slave['washes_master_rule'] = 1: preset_slave_washes_master_rule[i] = 1
	if slave['tentacle_rule'] = 1: preset_slave_tentacle_rule[i] = 1

