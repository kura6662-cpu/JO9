!for master create screen
!TODO: replace this whopper for something more compact
!needs cycle or majjick

!for controlling starting reputation
$rise_rep = {
	if $estate = 'korvus_house':
 		if hero_points >= 80:
  			hero_points -= 80
  			if faction_fame['neutral'] = 1:
   				hero_points += 80
  			end
  			$estate = 'white_house'
			faction_fame['neutral'] = 1
			$starting_area = '<font color="009900">백색 도시</font>'
			faction_purchase_kamira = 0
			faction_purchase_serpis = 0
			faction_purchase_taurus = 0
			faction_purchase_korvus = 0
			faction_purchase_neutral = 1
			dynamic $faction_adjustment
  		else
  			msg "캐릭터 포인트가 부족하다. 이 능력치를 올리려면 80포인트가 필요하다."
 		end
	end
	if $estate = 'taurus_house':
 		if hero_points >= 40:
  			hero_points -= 40
  			if faction_fame['korvus'] = 1:
   				hero_points += 40
  			end
			$estate = 'korvus_house'
			faction_fame['korvus'] = 1
			$starting_area = '<font color="009FEF">네크로폴리스</font>'
			faction_purchase_kamira = 0
			faction_purchase_serpis = 0
			faction_purchase_taurus = 0
			faction_purchase_korvus = 1
			faction_purchase_neutral = 0
			dynamic $faction_adjustment
  		else
  			msg "캐릭터 포인트가 부족하다. 이 능력치를 올리려면 40포인트가 필요하다."
 		end
	end
	if $estate = 'serpis_house':
		if hero_points >= 20:
			hero_points -= 20
			if faction_fame['taurus'] = 1:
   				hero_points += 20
  			end
			$estate = 'taurus_house'
			faction_fame['taurus'] = 1
			$starting_area = '<font color="0000D8">황소 구역</font>'
			faction_purchase_kamira = 0
			faction_purchase_serpis = 0
			faction_purchase_taurus = 1
			faction_purchase_korvus = 0
			faction_purchase_neutral = 0
			dynamic $faction_adjustment
  		else
  			msg "캐릭터 포인트가 부족하다. 이 능력치를 올리려면 20포인트가 필요하다."
 		end
	end
	if $estate = 'kamira_house':
 		if hero_points >= 10:
  			hero_points -= 10
		  	if faction_fame['serpis'] = 1:
		   		hero_points += 10
	  		end
			$estate = 'serpis_house'
			faction_fame['serpis'] = 1
			$starting_area = '<font color="6B0084">뱀자리 구역</font>'
			faction_purchase_kamira = 0
			faction_purchase_serpis = 1
			faction_purchase_taurus = 0
			faction_purchase_korvus = 0
			faction_purchase_neutral = 0
			dynamic $faction_adjustment
  		else
  			msg "캐릭터 포인트가 부족하다. 이 능력치를 올리려면 10포인트가 필요하다."
 		end
	end
	if $estate = 'slum_house':
	 	if hero_points >= 5:
	  		hero_points -= 5
	  		if faction_fame['kamira'] = 1:
	   			hero_points += 5
	  		end
			$estate = 'kamira_house'
			faction_fame['kamira'] = 1
			faction_purchase_kamira = 1
			faction_purchase_serpis = 0
			faction_purchase_taurus = 0
			faction_purchase_korvus = 0
			faction_purchase_neutral = 0
			dynamic $faction_adjustment
	  		$starting_area = '<font color="EA0090">추방자 구역</font>'
	  	else
	  		msg "캐릭터 포인트가 부족하다. 이 능력치를 올리려면 5포인트가 필요하다."
	 	end
	end
}

$lower_rep = {
	if $estate = 'kamira_house':
		hero_points += 5
		$estate = 'slum_house'
		faction_fame['kamira'] = 0
