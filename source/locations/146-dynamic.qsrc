!attacks
$первое_действие = {
	gt 'атака_игрока',1
}

$второе_действие = {
	gt 'атака_игрока',2
}
$атака_второй_рукой = {
	gt 'атака_игрока',31
}

$пинок = {
	gt 'атака_игрока',11
}
$толчок = {
	gt 'атака_игрока',12
}
$подсечка = {
	gt 'атака_игрока',13
}

!Used to be named $суперудар_1 with variable суперудар_сделан[1] = 1.  Somewhere in the code it was setting the variable to 1
!Not a pretty fix but it works with new function and variable names without issues - crushboss
$суперудар_11 = {
	суперудар_сделан[11] = 1
	gt 'атака_игрока',21
