$name_preset = {
	$a = input ('프리셋 이름을 입력해라. 비워 두면 이름은 바뀌지 않는다. <br> 가능하면 열네 글자를 넘기지 마라.')
	if $a !'': $preset_name[i] = $a
}

$save_preset = {
	preset_silence_rule[i] = 0
	preset_humility_rule[i] = 0
