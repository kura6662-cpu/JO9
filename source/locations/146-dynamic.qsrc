$use_preset = {
	slave['silence_rule'] = preset_silence_rule[i]
	slave['humility_rule'] = preset_humility_rule[i]
	slave['masturbation_rule'] = preset_masturbation_rule[i]
	slave['no_orgasm_rule'] = preset_orgasm_prohibited[i]
	slave['no_shit_rule'] = preset_shit_prohibited[i]
