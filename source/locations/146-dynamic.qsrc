}

$name_type = {
	$a = input ('Give your character a name. Please try to keep this shorter than 14 characters.')
	if $a !'': $master_name = $a
	gt $curloc
}

$game_difficulty_decrease = {
	if game_difficulty > 0:
		game_difficulty -= 1
		if game_difficulty = 0:
			! easy
			hero_points += 2940 &! 2940 is required to max everything
			sparks += 4000
			if sparks > 10000:
				hero_points += (sparks - 10000)/10
				sparks = 10000
			end
			difficulty_setting = 1 &! easy obedience difficulty
			get_initial_slave = 1 &! enable patrician start mode
		elseif game_difficulty = 1:
			! normal
			hero_points += 250
			sparks += 5600
			if sparks > 7500:
				hero_points += (sparks - 7500)/10
				sparks = 7500
			end
			difficulty_setting = 0 &! classic obedience difficulty
			get_initial_slave = 0 &! disable patrician start mode
		end
	end
	gt $curloc
}

$game_difficulty_increase = {
	if game_difficulty < 2:
		game_difficulty += 1
		if game_difficulty = 1:
			! normal
			hero_points -= 2940 &! difference in points from Easy to Normal
			sparks -= 4000 &! difference in sparks from Easy to Normal
			if sparks > 7500:
				hero_points += (sparks - 7500)/10
				sparks = 7500
			end
			difficulty_setting = 0 &! classic obedience difficulty
			get_initial_slave = 0 &! disable patrician start mode
		elseif game_difficulty = 2:
			! extreme
			if cheat_a ! 0 or cheat_b ! 0 or cheat_c ! 0 or cheat_d ! 0 or cheat_h ! 0 or cheat_i ! 0 or _ 
				cheat_j ! 0 or cheat_k ! 0 or cheat_l ! 0 or cheat_all ! 0 or cheat_all_basic ! 0 or _ 
				cheat_all_low ! 0 or cheat_all_max ! 0 or isabella_get ! 0:
				! e,f,g limit slave generation to selected age - no reset for these
				gs 'init_custom_game' &! full reset to disable cheats for extreme difficulty - ImperatorAugustus
			end
			hero_points -= 250 &! difference in points from Normal to Extreme
			sparks -= 5600 &! difference in sparks from Normal to Extreme
			if sparks > 400:
				hero_points += (sparks - 400)/10
				sparks = 400
			end
			difficulty_setting = 2 &! hardcore obedience difficulty
			get_initial_slave = 0 &! disable patrician start mode
		end
	end
	gt $curloc
}

$sparks_decrease = {
	if sparks > 200:
		sparks -= 100
		hero_points += 10
	end
	gt $curloc
}

$sparks_increase = {
	if sparks < iif(game_difficulty = 0, 10000, iif(game_difficulty = 2, 400, 8000)):
		sparks += 100
		hero_points -= 10
	end
	gt $curloc
}

$go_forward = {
	unsel
	txt_count = arrsize('$text') - 1
	if txt < txt_count:
		txt += 1
	else
		delobj '@'
		if $msg_txt ! '' and txt_count = txt:
			msg '<<$msg_txt>>'
			$msg_txt = ''
		end
		if exam_in_progress = 1:
			gt 'demo_menu_form'
		elseif is_home ! 1:
			gt 'city_menu_form'
		else
			gt 'menu_form'
		end
	end
	gt $curloc
}

$dyn_meat_evaluation = {
	base_meat_gain = (dynslave['fat'] + 2)
	if dynslave['age'] ! CONST_INT['loli_age']: base_meat_gain *= 2
	mince_gain = dynslave['fat']
	if dynslave['boobs'] > 0: mince_gain *= dynslave['boobs']
	mince_bonus = 0
	meat_max = 1 + dynslave['stamina']
	if dynslave['age'] ! CONST_INT['loli_age']: meat_max *= 2
	if base_meat_gain > meat_max:
		meat_gain = meat_max
		mince_bonus = base_meat_gain - meat_max
	else
		meat_gain = base_meat_gain
	end
	mince_gain += mince_bonus
	if dynslave['age'] = CONST_INT['loli_age'] or (dynslave['age'] = CONST_INT['young_age'] and dynslave['virginity'] = 0):
		! was virginity = 1, error when the butcher gave virgin meat when hymen is restored
		virgin_meat_gain = meat_gain
		meat_gain = 0
	else
		virgin_meat_gain = 0
	end
	meat_price = mince_gain + meat_gain*2 + virgin_meat_gain*4
}

$get_meat = {
	if fridge_space > 0:
		if fridge_space >= virgin_meat_gain:
			fridge["virgin_meat"] += virgin_meat_gain
		else
			fridge["virgin_meat"] += fridge_space
		end
	end
	if fridge_space > 0:
		if fridge_space >= meat_gain:
			fridge["meat"] += meat_gain
		else
			fridge["meat"] += fridge_space
		end
	end
	if fridge_space > 0:
		if fridge_space >= mince_gain:
			fridge["mince"] += mince_gain
		else
			fridge["mince"] += fridge_space
		end
	end
}

$get_fridge_space = {
	fridge_items = fridge['alcohol'] + fridge['vegetables'] + fridge['grain'] + fridge['spice'] + fridge['cheese'] + fridge['eggs'] + fridge['milk'] + fridge['cream'] + fridge['mince'] + fridge['meat'] + fridge['virgin_meat']
	fridge_space = estate_size[$estate] - fridge_items
}
!+ brainwashing_potion 
$get_lab_space = {
	lab_items = lab_store['slime'] + lab_store['kanabis'] + lab_store['koffe'] + lab_store['meth'] + lab_store['opium'] + вакхический_нектар + тонизируюзщий_эликсир + целительный_бальзам + афродизиак + мощный_афодизиак + приворотное_зелье + вода_леты + метаболизм_плюс + метаболизм_минус + жир_плюс + жир_минус + brainwashing_potion + potion_of_mystra + molar_of_wolf
	lab_space = estate_size[$estate] - lab_items
}

$master_pass_out = {
	if master_str_rate < 0: dynamic $death, '<br> 일을 너무 과로해서 체력이 고갈되었고, 당신은 심각한 병치레에 시달리게 되었다. 그로인해, 최고의 노예상인이 되겠다는 당신의 목표는 달성할 수 없게 되었다...'
	if master_energy <= -5: is_home = 1 & gt 'next_day' &! is_home = 1 to bypass menu_form ESC intercept
}

!Slave pass out - Overhauled - crushboss
$slave_pass_out = {
	if slave_state > CONST_INT['no_slave']:
		if slave_state = CONST_INT['slave_exist']:
			if slave['energy'] <= -5:
				msg '<<$경고>>노예가 과로로 쓰러졌다'
				slave_state = CONST_INT['slave_faint']
			elseif slave['stamina'] = 0:
				msg '<<$경고>>노예가 체력 부족으로 쓰러졌다'
				slave_state = CONST_INT['slave_faint']
			elseif slave['stamina'] = 1 and slave_rate['stamina'] <= 0:
				if slave['nearly_fainted'] = 0: msg '<<$경고>>노예가 체력이 부족해 비틀대고 있다'
				slave['nearly_fainted'] = 1
			end
		end
		if cheat_no_starve = 0 and max(slave['stamina'], slave['fat']) = 0 and max(slave_rate['stamina'], slave_rate['fat']) <= indep_atr_min_threshold[0]:
			dynamic $replace($dyn_meat_evaluation, 'dyn'+'slave', 'slave')
			master_moodlet['neg_slave_starved'] = 3
			if exam_in_progress ! 1: msg '<<$경고>>노예가 굶어 죽었다. 시체를 도축장에 넘기고, <<meat_price>>스파크를 받았다.'
			sparks += meat_price
			dynamic $clear_slave_instance, 'slave'
		end
	end
}

