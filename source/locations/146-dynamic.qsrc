 end
 
 slave["rapeCount"]+=1
 master["rapeCount"]+=1
}
$scroll_heroes_woman = {
    IF hero_choice < 124:
        hero_choice += 1
    else
        hero_choice = 101
    END
    if hero_choice > 124: hero_choice = 101
    gt $curloc
}
$scroll_heroes_woman_back = {
    IF hero_choice > 101:
        hero_choice -= 1
    else
        hero_choice = 124
    END
    if hero_choice < 101: hero_choice = 124
    gt $curloc
}
$scroll_heroes_man = {
    IF hero_choice < 18:
        hero_choice += 1
    else
        hero_choice = 1
    END
    if hero_choice > 18: hero_choice = 1
    gt $curloc
}
$scroll_heroes_man_back = {
    IF hero_choice > 1:
        hero_choice -= 1
    else
        hero_choice = 18
    END
    if hero_choice < 1: hero_choice = 18
