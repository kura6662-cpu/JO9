 if instr($result,'(담담한 눈빛으로) ')=1: $result=$trim(mid($result,11,len($result)))
}
$voice_flow_pack = {
 ! Sort complete utterances by context. A page boundary never cuts a sentence.
 killvar '$jo9_vf_pages'
 $jo9_vfp_page=''
 $jo9_vfp_plain=''
 jo9_vfp_theme=1
 :jo9_vfp_theme_next
 if jo9_vfp_theme<=3:
  jo9_vfp_slot=1
  :jo9_vfp_slot_next
  if jo9_vfp_slot<=10:
   jo9_vfp_match=0
   if jo9_vfp_theme=1 and jo9_vfp_slot<=4: jo9_vfp_match=1
   if jo9_vfp_theme=2 and jo9_vfp_slot>=5 and jo9_vfp_slot<=7: jo9_vfp_match=1
   if jo9_vfp_theme=3 and jo9_vfp_slot>=8: jo9_vfp_match=1
   if jo9_vfp_match=1 and $jo9_vf_blocks[jo9_vfp_slot] ! '':
    $jo9_vfp_next=$jo9_vf_blocks[jo9_vfp_slot]
    if $jo9_vfp_page ! '': $jo9_vfp_next=$dyneval($voice_flow_uncue,$jo9_vfp_next)
    $jo9_vfp_join=' '
    if $jo9_vfp_page='': $jo9_vfp_join=''
    ! Knowing consequences and feeling fear are distinct.
    if $jo9_vfp_page ! '' and jo9_vfp_slot=6 and $jo9_vf_fear_key='fear_0': $jo9_vfp_join=' 다만 '
    if $jo9_vfp_page ! '' and jo9_vfp_slot=6 and instr($jo9_vfp_next,'네, ')=1: $jo9_vfp_next=mid($jo9_vfp_next,4,len($jo9_vfp_next))
    if $jo9_vfp_page ! '' and jo9_vfp_slot=7 and $jo9_vf_fear_key ! 'fear_0' and ($jo9_vf_instinct_key='instinct_3' or $jo9_vf_instinct_key='instinct_4' or $jo9_vf_instinct_key='instinct_5'): $jo9_vfp_join=' 그런데도 '
    ! A later event can contrast with the real recent-event trend.
    if $jo9_vfp_page ! '' and jo9_vfp_slot=4 and $jo9_vf_recent='A' and $jo9_vf_today='C': $jo9_vfp_join=' 하지만 '
    if $jo9_vfp_page ! '' and jo9_vfp_slot=4 and $jo9_vf_recent='B' and $jo9_vf_today='D': $jo9_vfp_join=' 그래도 '
    :jo9_vfp_clean_next
    $jo9_vfp_probe=$jo9_vfp_next
    :jo9_vfp_strip_tag
    $jo9_vfp_tag=$strfind($jo9_vfp_probe,'<[^>]*>')
    if $jo9_vfp_tag ! '':
     $jo9_vfp_probe=$replace($jo9_vfp_probe,$jo9_vfp_tag,'')
     jump 'jo9_vfp_strip_tag'
    end
    if $jo9_vfp_page ! '' and len($jo9_vfp_plain)+len($jo9_vfp_join)+len($jo9_vfp_probe)>230:
     $jo9_vf_pages[]=$jo9_vfp_page
     $jo9_vfp_page=''
     $jo9_vfp_plain=''
     $jo9_vfp_join=''
     $jo9_vfp_next=$jo9_vf_blocks[jo9_vfp_slot]
     jump 'jo9_vfp_clean_next'
    end
    if $jo9_vf_colors[jo9_vfp_slot] ! '': $jo9_vfp_next=$jo9_vf_colors[jo9_vfp_slot]+$jo9_vfp_next+'</font>'
    $jo9_vfp_page+=$jo9_vfp_join+$jo9_vfp_next
    $jo9_vfp_plain+=$jo9_vfp_join+$jo9_vfp_probe
   end
   jo9_vfp_slot+=1
   jump 'jo9_vfp_slot_next'
  end
  if $jo9_vfp_page ! '': $jo9_vf_pages[]=$jo9_vfp_page
  $jo9_vfp_page=''
  $jo9_vfp_plain=''
  jo9_vfp_theme+=1
  jump 'jo9_vfp_theme_next'
 end
 killvar '$jo9_vfp_page'
 killvar '$jo9_vfp_plain'
 killvar '$jo9_vfp_next'
 killvar '$jo9_vfp_join'
 killvar '$jo9_vfp_probe'
 killvar '$jo9_vfp_tag'
 killvar 'jo9_vfp_theme'
 killvar 'jo9_vfp_slot'
 killvar 'jo9_vfp_match'
}

! JO9 MOD END VOICE_FLOW_PAGE_HELPERS
$voice_impression = {
 ! VOICE_ARGON_FLOW_V7: original selectors; route before picking and join complete related utterances.
 jo9_vf_question=args[0]
 jo9_vf_has_request=0
 killvar '$jo9_vf_pages'
 killvar '$jo9_vf_blocks'
 killvar '$jo9_vf_colors'
 $jo9_vf_fear_key=''
 $jo9_vf_instinct_key=''
 killvar '$jo9_vf_parts'
 killvar '$jo9_vf_part_ids'
 $jo9_vf_profile=$dyneval($voice_profile,$slave_occupation,slave['temper'],slave['sensitivity'],slave['ego'],slave['pride'])
 jo9_vf_tone=val(mid($jo9_vf_profile,len($jo9_vf_profile),1))
 $jo9_vf_type=mid($jo9_vf_profile,1,len($jo9_vf_profile)-2)
 $jo9_vf_mode='neutral'
 if instr('|reluctant|arrogant|hateful|resistant|hysteric|','|'+$slave_psy_status+'|')>0: $jo9_vf_mode='hostile'
 if $slave_psy_status='lachrymose' or $slave_psy_status='frightened': $jo9_vf_mode='fearful'
 if $slave_psy_status='depresive': $jo9_vf_mode='bleak'
 if $slave_psy_status='broken': $jo9_vf_mode='broken'
 if $slave_psy_status='optimistic': $jo9_vf_mode='hopeful'
 if $slave_psy_status='obedient' or $slave_psy_status='servile' or $slave_psy_status='horny':
  $jo9_vf_mode='duty'
  if slave['moral']>=4: $jo9_vf_mode='loyal'
 end
 jo9_vf_reward_total=0
 jo9_vf_punishment_total=0
 jo9_vf_scan=0
 :jo9_vf_reward_count
 if jo9_vf_scan<arrsize('voice_reward_ids'):
  jo9_vf_reward_total+=slave_already_done_recent[str(voice_reward_ids[jo9_vf_scan])]
  jo9_vf_scan+=1
  jump 'jo9_vf_reward_count'
 end
 jo9_vf_scan=0
 :jo9_vf_punishment_count
 if jo9_vf_scan<arrsize('voice_punishment_ids'):
  jo9_vf_punishment_total+=slave_already_done_recent[str(voice_punishment_ids[jo9_vf_scan])]
  jo9_vf_scan+=1
  jump 'jo9_vf_punishment_count'
 end
 $jo9_vf_recent=''
 if jo9_vf_reward_total>=3 or jo9_vf_punishment_total>=3:
  $jo9_vf_recent='B'
  if jo9_vf_reward_total>jo9_vf_punishment_total: $jo9_vf_recent='A'
 end
 $jo9_vf_today=''
 if slave['daily_reward_count']>slave['daily_punishment_count']:
  $jo9_vf_today='D'
 else
  if slave['daily_punishment_count']>0: $jo9_vf_today='C'
 end
 $jo9_vf_topics=$jo9_vf_recent
 if $jo9_vf_today ! '':
  $jo9_vf_topics=''
  if ($jo9_vf_recent='A' and $jo9_vf_today='C') or ($jo9_vf_recent='B' and $jo9_vf_today='D'): $jo9_vf_topics=$jo9_vf_recent
  $jo9_vf_topics+=$jo9_vf_today
 end
 $jo9_vf_last1=$slave['jo9_voice_last1_'+str(jo9_vf_question)]
 $jo9_vf_last2=$slave['jo9_voice_last2_'+str(jo9_vf_question)]
 $jo9_vf_signature=''
 		obed = 0
		if slave['obedience'] > 0: obed = 1
		if slave['obedience'] > 10: obed = 2
		if slave['obedience'] > 20: obed = 3
		if slave['obedience'] > 30: obed = 4
		if slave['obedience'] > 40: obed = 5
		$jo9_vf_parts[1] = $slave_relation_description[$slave_psy_status] & $jo9_vf_part_ids[1] = 'relation_' + $slave_psy_status 
		if obed = 0 and slave['obedience'] >= -5 + iif(slave['stamina'] < 3, 1, -1) + iif(slave['intellect'] > 2, 1, -1) + iif(slave['pride'] > 2, slave['pride'] - 2, slave['pride'] - 3) + _ 
																			iif(slave['pride'] > 2, -2, 0) + iif(slave['ego'] < 3, 1, 0) + iif(slave['intellect'] < 3, 1, 0):
			$jo9_vf_parts[2] = $slave_obed_description[1] & $jo9_vf_part_ids[2] = 'obed_' + str(1) &! slave will obey maid rule, according to the text
		else
			$jo9_vf_parts[2] = $slave_obed_description[obed] & $jo9_vf_part_ids[2] = 'obed_' + str(obed) 
		end
		if rebell[$slave_psy_status] > 0: obed = 0
		if $slave_psy_status ! 'broken':
			if obed > 0 and slave['sex_sum'] > 0: $jo9_vf_parts[] = $slave_urge_description[min(obed, slave['arousal'])] & $jo9_vf_part_ids[arrsize('$jo9_vf_parts')-1] = 'urge_' + str(min(obed, slave['arousal'])) &! only comment on arousal if obed > 0 and slave has some sex experience
			$jo9_vf_parts[] = $slave_fear_description[max(slave['fear'] ! 0, slave['fear'] - slave['moral']/2)] & $jo9_vf_part_ids[arrsize('$jo9_vf_parts')-1] = 'fear_' + str(max(slave['fear'] ! 0, slave['fear'] - slave['moral']/2)) &! fear level is offset by devotion, but always show at least [1] if any fear (fear ! 0)
			$jo9_vf_parts[] = $slave_ratio_description[min(obed + (slave['daily_reward_count'] ! 0)*2, slave['rational'])] & $jo9_vf_part_ids[arrsize('$jo9_vf_parts')-1] = 'ratio_' + str(min(obed + (slave['daily_reward_count'] ! 0)*2, slave['rational'])) &! gates the [3] answer until obed > 0 ([0], [1] and [2] can be seen before obed > 0, but only [0] will be seen before a reward has been given that day)
			$jo9_vf_parts[] = $slave_instinct_description[min(obed + 2, slave['instinct'])] & $jo9_vf_part_ids[arrsize('$jo9_vf_parts')-1] = 'instinct_' + str(min(obed + 2, slave['instinct'])) &! min obed + 2 gates the [3] answer until obed > 0 ([1] and [2] can be seen before obed > 0)
			$jo9_vf_parts[] = $slave_custom_description[min(obed + 2, slave['custom'])] & $jo9_vf_part_ids[arrsize('$jo9_vf_parts')-1] = 'custom_' + str(min(obed + 2, slave['custom'])) &! min obed + 2 gates the [3] answer until obed > 0 ([1] and [2] can be seen before obed > 0)
			if obed > 0: $jo9_vf_parts[] = $slave_spoil_description[slave['spoil']] & $jo9_vf_part_ids[arrsize('$jo9_vf_parts')-1] = 'spoil_' + str(slave['spoil']) &! only comment on spoil if obed > 0, no min for spoil because higher is "worse"
			if obed > 0: $jo9_vf_parts[] = $slave_moral_description[min(obed, slave['moral'])] & $jo9_vf_part_ids[arrsize('$jo9_vf_parts')-1] = 'moral_' + str(min(obed, slave['moral'])) &! only comment on devotion if obed > 0, limited by overall obedience so it tracks (or lags) slave_obed_description
		end

 jo9_vf_part=1
 :jo9_vf_next_part
 if jo9_vf_part<arrsize('$jo9_vf_parts'):
  $jo9_vf_key=$jo9_vf_part_ids[jo9_vf_part]
  jo9_vf_core_question=1112
  if instr($jo9_vf_key,'urge_')=1: jo9_vf_core_question=1113
  if instr($jo9_vf_key,'spoil_')=1 and $jo9_vf_key ! 'spoil_0': jo9_vf_core_question=1113
  if $jo9_vf_key='custom_2' or $jo9_vf_key='custom_3': jo9_vf_core_question=1116
  $jo9_vf_unit=$jo9_vf_parts[jo9_vf_part]
  $jo9_vf_color=$strfind($jo9_vf_unit,'<font[^>]*>')
  jo9_vf_prefix=instr($jo9_vf_unit,']<br>')
  if jo9_vf_prefix>0: $jo9_vf_unit=mid($jo9_vf_unit,jo9_vf_prefix+len(']<br>'))
  :jo9_vf_strip_font
  $jo9_vf_tag=$strfind($jo9_vf_unit,'<font[^>]*>')
  if $jo9_vf_tag ! '':
   $jo9_vf_unit=$replace($jo9_vf_unit,$jo9_vf_tag,'')
   jump 'jo9_vf_strip_font'
  end
  $jo9_vf_unit=$replace($jo9_vf_unit,'</font>','')
  $jo9_vf_unit=$replace($jo9_vf_unit,'</div>','')
  $jo9_vf_unit=$replace($jo9_vf_unit,'&nbsp;',' ')
  $jo9_vf_unit=$trim($jo9_vf_unit)
  if $jo9_vf_unit ! '':
   $jo9_vf_emotion=$voice_fact_emotion[$jo9_vf_key]
   if $jo9_vf_emotion='': $jo9_vf_emotion='positive'
   jo9_vf_depth=dyneval($voice_depth_level,$jo9_vf_emotion)
   $jo9_vf_core=''
   if jo9_vf_question=jo9_vf_core_question: $jo9_vf_core=$dyneval($voice_pick_fragment,'fact_'+$jo9_vf_key+'_core',$jo9_vf_unit,jo9_vf_depth,'mix',jo9_vf_question)
   $jo9_vf_detail=$dyneval($voice_pick_fragment,'fact_'+$jo9_vf_key+'_detail','',jo9_vf_depth,'mix',jo9_vf_question)
   $jo9_vf_unit=$jo9_vf_core
   if $jo9_vf_detail ! '':
    if $jo9_vf_unit ! '': $jo9_vf_unit+=' '
    $jo9_vf_unit+=$jo9_vf_detail
   end
   if $jo9_vf_unit ! '':
    if jo9_vf_question=1112 and jo9_vf_part=1 and $jo9_vf_mode ! 'broken' and instr($jo9_vf_core,'<i>') ! 1 and instr($jo9_vf_core,'(') ! 1:
     $jo9_vf_intro=$dyneval($voice_pick_fragment,'open','',jo9_vf_depth)
     if $jo9_vf_intro ! '': $jo9_vf_unit=$jo9_vf_intro+' '+$jo9_vf_unit
    end
    if jo9_vf_question=1112:
     jo9_vf_slot=0
     if instr($jo9_vf_key,'relation_')=1: jo9_vf_slot=1
     if instr($jo9_vf_key,'obed_')=1: jo9_vf_slot=2
     if instr($jo9_vf_key,'fear_')=1: jo9_vf_slot=5 & $jo9_vf_fear_key=$jo9_vf_key
     if instr($jo9_vf_key,'instinct_')=1: jo9_vf_slot=7 & $jo9_vf_instinct_key=$jo9_vf_key
     if $jo9_vf_key='spoil_0': jo9_vf_slot=6
     if instr($jo9_vf_key,'ratio_')=1: jo9_vf_slot=8
     if instr($jo9_vf_key,'custom_')=1: jo9_vf_slot=9
     if instr($jo9_vf_key,'moral_')=1: jo9_vf_slot=10
     $jo9_vf_blocks[jo9_vf_slot]=$jo9_vf_unit
     $jo9_vf_colors[jo9_vf_slot]=$jo9_vf_color
    else
     if $jo9_vf_color ! '': $jo9_vf_unit=$jo9_vf_color+$jo9_vf_unit+'</font>'
     $jo9_vf_pages[]=$jo9_vf_unit
     if jo9_vf_question=1113 and $jo9_vf_key ! 'urge_0': jo9_vf_has_request=1
    end
   end
  end
  if jo9_vf_question=1112 and jo9_vf_part=1:
   jo9_vf_topic_at=1
   :jo9_vf_next_topic
   if jo9_vf_topic_at<=len($jo9_vf_topics):
    $jo9_vf_topic=mid($jo9_vf_topics,jo9_vf_topic_at,1)
    $jo9_vf_emotion='positive'
    if $jo9_vf_topic='B' or $jo9_vf_topic='C': $jo9_vf_emotion='hostile'
    if $jo9_vf_mode='hostile': $jo9_vf_emotion='hostile'
    if $jo9_vf_mode='fearful' or $jo9_vf_mode='bleak' or (($jo9_vf_mode='loyal' or $jo9_vf_mode='duty') and ($jo9_vf_topic='B' or $jo9_vf_topic='C')): $jo9_vf_emotion='vulnerable'
    jo9_vf_depth=dyneval($voice_depth_level,$jo9_vf_emotion)
    $jo9_vf_event=$dyneval($voice_pick_fragment,$jo9_vf_topic,'',jo9_vf_depth)
    if $jo9_vf_event ! '':
     $jo9_vf_blocks[2+jo9_vf_topic_at]=$jo9_vf_event
     $jo9_vf_colors[2+jo9_vf_topic_at]=$jo9_vf_color
    end
    jo9_vf_topic_at+=1
    jump 'jo9_vf_next_topic'
   end
  end
  jo9_vf_part+=1
  jump 'jo9_vf_next_part'
 end
 if jo9_vf_question=1112: dynamic $voice_flow_pack

 if $jo9_vf_signature ! '':
  $slave['jo9_voice_last2_'+str(jo9_vf_question)]=$jo9_vf_last1
  $slave['jo9_voice_last1_'+str(jo9_vf_question)]=$jo9_vf_signature
 end
 killvar '$jo9_vf_parts'
 killvar '$jo9_vf_part_ids'
 killvar '$jo9_vf_blocks'
 killvar '$jo9_vf_colors'
 killvar '$jo9_vf_fear_key'
 killvar '$jo9_vf_instinct_key'
 killvar '$jo9_vf_key'
 killvar 'jo9_vf_core_question'
 killvar 'jo9_vf_slot'
 killvar '$jo9_vf_profile'
 killvar 'jo9_vf_tone'
 killvar '$jo9_vf_type'
 killvar '$jo9_vf_mode'
 killvar 'jo9_vf_reward_total'
 killvar 'jo9_vf_punishment_total'
 killvar 'jo9_vf_scan'
 killvar '$jo9_vf_recent'
 killvar '$jo9_vf_today'
 killvar '$jo9_vf_topics'
 killvar '$jo9_vf_last1'
 killvar '$jo9_vf_last2'
 killvar '$jo9_vf_signature'
 killvar 'jo9_vf_part'
 killvar '$jo9_vf_unit'
 killvar '$jo9_vf_core'
 killvar '$jo9_vf_detail'
 killvar '$jo9_vf_color'
 killvar 'jo9_vf_prefix'
 killvar '$jo9_vf_tag'
 killvar 'jo9_vf_depth'
 killvar '$jo9_vf_intro'
 killvar 'jo9_vf_topic_at'
 killvar '$jo9_vf_topic'
 killvar '$jo9_vf_emotion'
 killvar '$jo9_vf_event'
 killvar 'jo9_vf_question'
 killvar 'jo9_vf_is_request'
 killvar 'jo9_vf_include'
}

