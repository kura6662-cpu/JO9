	if inventory['vaginal_balls'] > 0 and slave['virginity'] > 1: slave['v_balls_rule'] = preset_v_balls_rule[i]

	slave['force_rules'] = preset_force_rules[i]

	if boudoir = 0 and preset_slave_sleep_condition[i] = 2:
		slave['sleep_condition'] = 1
	else
		slave['sleep_condition'] = preset_slave_sleep_condition[i]
	end
