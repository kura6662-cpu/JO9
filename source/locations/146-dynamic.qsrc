! 직업 문자열, 성격, 감수성, 자아, 태도 -> 유형_말투 문자열. 계산 임시는 끝에서 삭제한다.
$voice_profile = {
 jo9_voice_express = args[1] + args[2]
 jo9_voice_assert = args[3] + args[4]
 $jo9_voice_type = 'plain'
 if jo9_voice_assert <= 3:
  $jo9_voice_type = 'meek'
  if jo9_voice_express <= 3: $jo9_voice_type = 'doll'
  if jo9_voice_express >= 7: $jo9_voice_type = 'fragile'
 else
  if jo9_voice_assert >= 7:
   $jo9_voice_type = 'proud'
   if jo9_voice_express <= 3: $jo9_voice_type = 'ice'
   if jo9_voice_express >= 7: $jo9_voice_type = 'flame'
  else
   if jo9_voice_express <= 3: $jo9_voice_type = 'calm'
   if jo9_voice_express >= 7: $jo9_voice_type = 'frank'
  end
 end
 jo9_voice_tone_code = 2
 if instr('|maid|valertry|secretary|nun|policewoman|mind_contol|time_plice|jailer|academy|mech|', '|' + $args[0] + '|') > 0: jo9_voice_tone_code = 1
 if instr('|tribal_girl|thief|beggar|gypsy|whore|markitane|brothel|thug|brigand|punk|contraband|', '|' + $args[0] + '|') > 0: jo9_voice_tone_code = 3
 $result = $jo9_voice_type + '_' + str(jo9_voice_tone_code)
 killvar 'jo9_voice_express'
 killvar 'jo9_voice_assert'
 killvar '$jo9_voice_type'
 killvar 'jo9_voice_tone_code'
}

! 자아, 성격, 태도 -> 0 보통 / 1 신경쇠약 / 2 정신분열. 전용 대사 덮어쓰기는 4단계다.
$voice_mental = {
 jo9_voice_mental_sum = args[0] + args[1] + args[2]
 result = 0
 if jo9_voice_mental_sum <= 4: result = 1
 if jo9_voice_mental_sum <= 2: result = 2
 killvar 'jo9_voice_mental_sum'
}

! 조각 번호 k, 후보 수 n(양수) -> 0~n-1. 기존 day/interaction을 읽고 난수 상태는 바꾸지 않는다.
$voice_index = {
 result = ((48271 * (day + interaction + args[0])) mod 65537) mod args[1]
}

! JO9 MOD START VOICE_RECENT_PICKER | 2026-10-17_zzzzzzzzzz_voice_recent
! 발언이 확정된 곳에서만 호출한다. 화면 그리기에는 호출하지 않는다.
! dynslave는 기존 인스턴스 치환 관례다. $args[0]은 질문/출력 항목 키다.
! 입력 임시 배열: $jo9_voice_candidates, $jo9_voice_candidate_ids. 반환: 고른 발언.
! 저장: 해당 인물 배열의 jo9_voice_last1_<항목>, jo9_voice_last2_<항목> 두 문자열.
$voice_pick_recent = {
 $result = ''
 jo9_vpick_count = min(arrsize('$jo9_voice_candidates'), arrsize('$jo9_voice_candidate_ids'))
 jo9_vpick_selected = -1
 if jo9_vpick_count > 0:
  $jo9_vpick_key1 = 'jo9_voice_last1_' + $args[0]
  $jo9_vpick_key2 = 'jo9_voice_last2_' + $args[0]
  $jo9_vpick_previous1 = $dynslave[$jo9_vpick_key1]
  $jo9_vpick_previous2 = $dynslave[$jo9_vpick_key2]
  jo9_vpick_start = dyneval($voice_index, dynslave['id'] mod 10000, jo9_vpick_count)
  jo9_vpick_pass = 0
  :jo9_vpick_next_pass
  jo9_vpick_scan = 0
  :jo9_vpick_scan_candidate
  jo9_vpick_at = (jo9_vpick_start + jo9_vpick_scan) mod jo9_vpick_count
  $jo9_vpick_id = $jo9_voice_candidate_ids[jo9_vpick_at]
  jo9_vpick_allowed = 1
  if $jo9_voice_candidates[jo9_vpick_at] = '' or $jo9_vpick_id = '': jo9_vpick_allowed = 0
  if jo9_vpick_pass < 2 and $jo9_vpick_id = $jo9_vpick_previous1: jo9_vpick_allowed = 0
  if jo9_vpick_pass = 0 and $jo9_vpick_id = $jo9_vpick_previous2: jo9_vpick_allowed = 0
  if jo9_vpick_allowed = 1: jo9_vpick_selected = jo9_vpick_at
  jo9_vpick_scan += 1
  if jo9_vpick_selected < 0 and jo9_vpick_scan < jo9_vpick_count: jump 'jo9_vpick_scan_candidate'
  jo9_vpick_pass += 1
  ! 후보가 적으면 최근 한 개만 회피하고, 그것도 불가능하면 사용 가능한 후보를 허용한다.
  if jo9_vpick_selected < 0 and jo9_vpick_pass < 3: jump 'jo9_vpick_next_pass'
  if jo9_vpick_selected >= 0:
   $result = $jo9_voice_candidates[jo9_vpick_selected]
   $dynslave[$jo9_vpick_key2] = $jo9_vpick_previous1
   $dynslave[$jo9_vpick_key1] = $jo9_voice_candidate_ids[jo9_vpick_selected]
  end
 end
 killvar 'jo9_vpick_count'
 killvar 'jo9_vpick_selected'
 killvar '$jo9_vpick_key1'
 killvar '$jo9_vpick_key2'
 killvar '$jo9_vpick_previous1'
 killvar '$jo9_vpick_previous2'
 killvar 'jo9_vpick_start'
 killvar 'jo9_vpick_pass'
 killvar 'jo9_vpick_scan'
 killvar 'jo9_vpick_at'
 killvar '$jo9_vpick_id'
 killvar 'jo9_vpick_allowed'
}
! JO9 MOD END VOICE_RECENT_PICKER

! slave의 기존 오늘 횟수와 최근 행동별 횟수를 읽어 1112 한 블록의 내용만 반환한다.
! JO9 MOD START VOICE_ARGON_DISTRIBUTED_HELPERS | 2026-10-18_argon_dialogue_distribution
! Complete authored fragments only. No runtime word/ending substitution.
$voice_depth_level = {
 jo9_vdepth_score=0
 if $args[0]='vulnerable': jo9_vdepth_score=2*slave['moral']-slave['pride']-2*(slave['fear']>=4)
 if $args[0]='hostile': jo9_vdepth_score=slave['ego']+slave['temper']-2*slave['fear']
 if $args[0]='positive': jo9_vdepth_score=2*slave['moral']+slave['sensitivity']-slave['pride']
 result=0
 if jo9_vdepth_score>=4: result=1
 if jo9_vdepth_score>=8: result=2
 killvar 'jo9_vdepth_score'
}
! args: role, fallback, maximum depth, optional body mix mode.
! VOICE_TIERED_POOLS: within each history pass try typed before common;
! only then relax history. Random selection is uniform in the eligible pool.
$voice_pick_fragment = {
 $result=''
 killvar '$jo9_vfp_candidates'
 killvar '$jo9_vfp_typed'
 killvar '$jo9_vfp_common'
 killvar '$jo9_vfp_pool'
 jo9_vfp_best=-1
 jo9_vfp_scan=0
 $jo9_vfp_lookup=$args[0]+'_'+$jo9_vf_type+'_'+str(jo9_vf_tone)
 :jo9_vfp_filter
 if jo9_vfp_scan<voice_fragment_count[$jo9_vfp_lookup]:
  $jo9_vfp_id=$voice_fragment_item[$jo9_vfp_lookup+'_'+str(jo9_vfp_scan)]
  jo9_vfp_ok=1
  if $voice_fragment_role[$jo9_vfp_id] ! $args[0]: jo9_vfp_ok=0
  if args[4]>0 and voice_fragment_question[$jo9_vfp_id] ! args[4]: jo9_vfp_ok=0
  if voice_fragment_tone[$jo9_vfp_id] ! jo9_vf_tone: jo9_vfp_ok=0
  if $voice_fragment_types[$jo9_vfp_id] ! '*' and instr($voice_fragment_types[$jo9_vfp_id],'|'+$jo9_vf_type+'|')=0: jo9_vfp_ok=0
  if $voice_fragment_relations[$jo9_vfp_id] ! '*' and instr($voice_fragment_relations[$jo9_vfp_id],'|'+$jo9_vf_mode+'|')=0: jo9_vfp_ok=0
  if instr('|A|B|C|D|','|'+$args[0]+'|')>0 and $jo9_vf_mode='broken' and instr($voice_fragment_relations[$jo9_vfp_id],'|broken|')=0: jo9_vfp_ok=0
   jo9_vfp_cap=args[2]
  if $args[3]='native':
   if $voice_fragment_emotion[$jo9_vfp_id]='vulnerable': jo9_vfp_cap=jo9_vn_depth_vulnerable
   if $voice_fragment_emotion[$jo9_vfp_id]='hostile': jo9_vfp_cap=jo9_vn_depth_hostile
   if $voice_fragment_emotion[$jo9_vfp_id]='positive': jo9_vfp_cap=jo9_vn_depth_positive
  end
  if voice_fragment_level[$jo9_vfp_id]>jo9_vfp_cap: jo9_vfp_ok=0
  jo9_vfp_fear=slave['fear']
  jo9_vfp_mood=slave['mood']
  if $args[3]='native': jo9_vfp_fear=jo9_vn_fear & jo9_vfp_mood=jo9_vn_mood
  if voice_fragment_need_fear[$jo9_vfp_id]>jo9_vfp_fear: jo9_vfp_ok=0
  if voice_fragment_good_mood[$jo9_vfp_id]>0 and jo9_vfp_mood<=0: jo9_vfp_ok=0
  if voice_fragment_rare_praise[$jo9_vfp_id]>0 and jo9_vf_reward_total>=3: jo9_vfp_ok=0
  if $voice_fragment_text[$jo9_vfp_id]='': jo9_vfp_ok=0
  if jo9_vfp_ok=1:
   if ($args[3]='mix' or $args[3]='native'):
    if $voice_fragment_types[$jo9_vfp_id] ! '*':
     $jo9_vfp_typed[]=$jo9_vfp_id
    else
     $jo9_vfp_common[]=$jo9_vfp_id
    end
   else
    if voice_fragment_level[$jo9_vfp_id]>jo9_vfp_best:
     killvar '$jo9_vfp_candidates'
     jo9_vfp_best=voice_fragment_level[$jo9_vfp_id]
    end
    if voice_fragment_level[$jo9_vfp_id]=jo9_vfp_best: $jo9_vfp_candidates[]=$jo9_vfp_id
   end
  end
  jo9_vfp_scan+=1
  jump 'jo9_vfp_filter'
 end
 $jo9_vfp_choice=''
 jo9_vfp_pass=0
 :jo9_vfp_pass_next
 jo9_vfp_tier=0
 jo9_vfp_tier_count=1
 if ($args[3]='mix' or $args[3]='native'): jo9_vfp_tier_count=2
 :jo9_vfp_tier_next
 killvar '$jo9_vfp_pool'
 jo9_vfp_count=arrsize('$jo9_vfp_candidates')
 if ($args[3]='mix' or $args[3]='native'):
  if jo9_vfp_tier=0:
   jo9_vfp_count=arrsize('$jo9_vfp_typed')
  else
   jo9_vfp_count=arrsize('$jo9_vfp_common')
  end
 end
 jo9_vfp_scan=0
 :jo9_vfp_pool_next
 if jo9_vfp_scan<jo9_vfp_count:
  $jo9_vfp_id=$jo9_vfp_candidates[jo9_vfp_scan]
  if ($args[3]='mix' or $args[3]='native'):
   if jo9_vfp_tier=0:
    $jo9_vfp_id=$jo9_vfp_typed[jo9_vfp_scan]
   else
    $jo9_vfp_id=$jo9_vfp_common[jo9_vfp_scan]
   end
  end
  $jo9_vfp_token='|'+$args[0]+'='+$jo9_vfp_id+'|'
  jo9_vfp_ok=1
  if jo9_vfp_pass<2 and instr($jo9_vf_last1,$jo9_vfp_token)>0: jo9_vfp_ok=0
  if jo9_vfp_pass=0 and instr($jo9_vf_last2,$jo9_vfp_token)>0: jo9_vfp_ok=0
  if jo9_vfp_ok=1: $jo9_vfp_pool[]=$jo9_vfp_id
  jo9_vfp_scan+=1
  jump 'jo9_vfp_pool_next'
 end
 if arrsize('$jo9_vfp_pool')>0: $jo9_vfp_choice=$jo9_vfp_pool[rand(0,arrsize('$jo9_vfp_pool')-1)]
 jo9_vfp_tier+=1
 if $jo9_vfp_choice='' and jo9_vfp_tier<jo9_vfp_tier_count: jump 'jo9_vfp_tier_next'
 jo9_vfp_pass+=1
 if $jo9_vfp_choice='' and jo9_vfp_pass<3: jump 'jo9_vfp_pass_next'
 if $jo9_vfp_choice ! '':
  $result=$voice_fragment_text[$jo9_vfp_choice]
  if args[4]>0 and $voice_flow_override[$jo9_vfp_choice] ! '' and $result=$voice_flow_original[$jo9_vfp_choice]: $result=$voice_flow_override[$jo9_vfp_choice]
  $jo9_vf_signature+='|'+$args[0]+'='+$jo9_vfp_choice+'|'
 else
  if $args[1] ! '':
   $result=$args[1]
   $jo9_vf_signature+='|'+$args[0]+'=original|'
  end
 end
 killvar '$jo9_vfp_candidates'
 killvar '$jo9_vfp_typed'
 killvar '$jo9_vfp_common'
 killvar '$jo9_vfp_pool'
 killvar 'jo9_vfp_best'
 killvar 'jo9_vfp_scan'
 killvar '$jo9_vfp_id'
 killvar 'jo9_vfp_ok'
 killvar '$jo9_vfp_choice'
 killvar 'jo9_vfp_count'
 killvar 'jo9_vfp_pass'
 killvar 'jo9_vfp_tier'
 killvar 'jo9_vfp_tier_count'
 killvar '$jo9_vfp_token'
 killvar '$jo9_vfp_lookup'
 killvar 'jo9_vfp_cap'
 killvar 'jo9_vfp_fear'
 killvar 'jo9_vfp_mood'
}

! JO9 MOD START VOICE_FLOW_PAGE_HELPERS | 2026-10-18_impression_flow_and_routes
$voice_flow_uncue = {
 $result=$args[0]
 ! Recognize only authored leading cues.
 if instr($result,'(흔들림 없는 눈빛으로 똑바로 마주 보며) ')=1: $result=$trim(mid($result,24,len($result)))
 if instr($result,'(태연한 기색으로 정면을 바라보며) ')=1: $result=$trim(mid($result,20,len($result)))
 if instr($result,'(담담한 표정으로 시선을 맞추며) ')=1: $result=$trim(mid($result,19,len($result)))
 if instr($result,'(태연한 얼굴로 시선을 맞추며) ')=1: $result=$trim(mid($result,18,len($result)))
 if instr($result,'(눈 하나 깜짝하지 않고 마주 보며) ')=1: $result=$trim(mid($result,21,len($result)))
 if instr($result,'(태연한 얼굴로 마주 보며) ')=1: $result=$trim(mid($result,16,len($result)))
 if instr($result,'(차분하게 고개를 저으며) ')=1: $result=$trim(mid($result,15,len($result)))
 if instr($result,'(가볍게 고개를 저으며) ')=1: $result=$trim(mid($result,14,len($result)))
 if instr($result,'(어깨를 으쓱하며) ')=1: $result=$trim(mid($result,11,len($result)))
 if instr($result,'(굳은 표정으로 시선을 낮추며) ')=1: $result=$trim(mid($result,18,len($result)))
 if instr($result,'(조심스럽게 눈치를 살피며) ')=1: $result=$trim(mid($result,16,len($result)))
 if instr($result,'(잠시 입술을 깨물었다가) ')=1: $result=$trim(mid($result,15,len($result)))
 if instr($result,'(어깨를 살짝 굳히며) ')=1: $result=$trim(mid($result,13,len($result)))
 if instr($result,'(조심스럽게 숨을 고르며) ')=1: $result=$trim(mid($result,15,len($result)))
 if instr($result,'(경계 어린 눈빛으로) ')=1: $result=$trim(mid($result,13,len($result)))
 if instr($result,'(살짝 몸을 사리며) ')=1: $result=$trim(mid($result,12,len($result)))
 if instr($result,'(슬쩍 반걸음 물러서며) ')=1: $result=$trim(mid($result,14,len($result)))
 if instr($result,'(조심스럽게 거리를 두며) ')=1: $result=$trim(mid($result,15,len($result)))
 if instr($result,'(낮게 숨을 고르며) ')=1: $result=$trim(mid($result,12,len($result)))
 if instr($result,'(나직하게 한숨을 쉬며) ')=1: $result=$trim(mid($result,14,len($result)))
 if instr($result,'(시선을 비키며) ')=1: $result=$trim(mid($result,10,len($result)))
 if instr($result,'(차갑게 굳은 얼굴로) ')=1: $result=$trim(mid($result,13,len($result)))
 if instr($result,'(시선을 바닥에 둔 채) ')=1: $result=$trim(mid($result,14,len($result)))
 if instr($result,'(입꼬리를 굳힌 채) ')=1: $result=$trim(mid($result,12,len($result)))
 if instr($result,'(가늘게 떨리는 손끝을 감추며) ')=1: $result=$trim(mid($result,18,len($result)))
 if instr($result,'(굳은 어깨로 시선을 낮추며) ')=1: $result=$trim(mid($result,17,len($result)))
 if instr($result,'(움찔하며 시선을 내리고) ')=1: $result=$trim(mid($result,15,len($result)))
 if instr($result,'(어깨를 살짝 움츠리며) ')=1: $result=$trim(mid($result,14,len($result)))
 if instr($result,'(굳은 목소리로) ')=1: $result=$trim(mid($result,10,len($result)))
 if instr($result,'(짧은 침묵 끝에) ')=1: $result=$trim(mid($result,11,len($result)))
 if instr($result,'(잠시 말을 삼켰다가) ')=1: $result=$trim(mid($result,13,len($result)))
 if instr($result,'(작게 한숨을 내쉬며) ')=1: $result=$trim(mid($result,13,len($result)))
 if instr($result,'(시선을 바닥으로 떨군 채 한 박자 늦게 입을 연다.) ')=1: $result=$trim(mid($result,31,len($result)))
 if instr($result,'(시선을 낮게 내리깔고서야 짧게 대답한다.) ')=1: $result=$trim(mid($result,25,len($result)))
 if instr($result,'(굳은 얼굴로 시선을 피하며 나직이 입을 뗀다.) ')=1: $result=$trim(mid($result,28,len($result)))
 if instr($result,'(애써 똑바로 서려 하지만 끝내 목소리가 떨린다.) ')=1: $result=$trim(mid($result,29,len($result)))
 if instr($result,'(입술을 세게 깨물며 버티다가 낮게 내뱉는다.) ')=1: $result=$trim(mid($result,27,len($result)))
 if instr($result,'(억지로 기세를 세우려다 어깨를 움츠린다.) ')=1: $result=$trim(mid($result,25,len($result)))
 if instr($result,'(가늘게 떨리는 숨을 삼키며) ')=1: $result=$trim(mid($result,17,len($result)))
 if instr($result,'(창백해진 기색을 애써 누르며) ')=1: $result=$trim(mid($result,18,len($result)))
 if instr($result,'(마주 선 채로 미세하게 몸을 떨며) ')=1: $result=$trim(mid($result,21,len($result)))
 if instr($result,'(창백해진 얼굴로 눈치를 보며) ')=1: $result=$trim(mid($result,18,len($result)))
