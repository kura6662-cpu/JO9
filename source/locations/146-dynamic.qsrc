 if $jo9_vrl_group='1117_jealousy3_3' and jo9_vf_tone=1 and $jo9_vrl_body='감히 말씀드리기 어렵지만, 주인님이 그녀에게 그렇게 많은 관심을 주시는 것에 몹시 마음이 상합니다.': $jo9_vrl_body='감히 말씀드리기 어렵지만, 주인님께서 그녀에게 그렇게 신경을 써 주시니 몹시 마음이 상합니다.'
 if $jo9_vrl_group='1117_jealousy3_3' and jo9_vf_tone=2 and $jo9_vrl_body='감히 말씀드리기 어렵지만, 주인님이 그녀에게 그렇게 많은 관심을 주시는 게 몹시 마음이 상해요.': $jo9_vrl_body='감히 말씀드리기 어렵지만, 주인님이 그녀에게 그렇게 신경을 써 주시니 정말 마음이 상해요.'
 if $jo9_vrl_group='1117_jealousy3_3' and jo9_vf_tone=3 and $jo9_vrl_body='감히 말하기 어렵지만, 주인님이 그녀에게 그렇게 많은 관심을 주는 게 몹시 마음이 상해.': $jo9_vrl_body='감히 말하기 어렵지만, 주인님이 그녀에게 그렇게 신경을 써 주니까 정말 마음이 상해.'
 if $jo9_vrl_group='1117_family_class5to13_3' and jo9_vf_tone=1 and $jo9_vrl_body='저는 고통받는 데 익숙합니다. 하지만 그녀가 고통받는 것을 보는 일은 즐거울 것입니다.': $jo9_vrl_body='저야 고통받는 거라면 익숙합니다. 하지만 그 여자가 고통받는 꼴은… 보면 즐거울 겁니다.'
 if $jo9_vrl_group='1117_family_class5to13_3' and jo9_vf_tone=2 and $jo9_vrl_body='저는 고통받는 데 익숙해요. 하지만 그녀가 고통받는 걸 보는 건 즐거울 거예요.': $jo9_vrl_body='저야 고통받는 거라면 익숙해요. 하지만 그 여자가 고통받는 꼴은… 보면 즐거울 거예요.'
 if $jo9_vrl_group='1117_family_class5to13_3' and jo9_vf_tone=3 and $jo9_vrl_body='나는 고통받는 데 익숙해. 하지만 그녀가 고통받는 걸 보는 건 즐거울 거야.': $jo9_vrl_body='나야 고통받는 거라면 익숙해. 하지만 그 여자가 고통받는 꼴은… 보면 즐거울 거야.'
 ! JO9 MOD END VOICE_RELATION_SPOKEN_V8
 ! Contrast is based only on the original feature appraisal group, never inferred from mood or wording.
 jo9_vrl_sign=0
 if instr($jo9_vrl_group,'1117_feat_')=1:
  jo9_vrl_sign=-1
  if instr($jo9_vrl_group,'1117_feat_int_eq_')=1 or instr($jo9_vrl_group,'1117_feat_bea_eq_good_')=1 or instr($jo9_vrl_group,'1117_feat_ego_high_')=1: jo9_vrl_sign=1
 end
 $jo9_vrl_join=''
 if args[2]=4 and jo9_vrl_sign ! 0:
  if jo9_relation_last_sign[4]>0 and jo9_vrl_sign<0: $jo9_vrl_join='다만 '
  if jo9_relation_last_sign[4]<0 and jo9_vrl_sign>0: $jo9_vrl_join='그래도 '
  jo9_relation_last_sign[4]=jo9_vrl_sign
 end
 ! JO9 MOD START VOICE_RELATION_BRIDGE_V8 | 2026-10-18_relation_semantic_speech
 $jo9_vrl_continued=$dyneval($voice_relation_continue,$jo9_relation_prev_group[args[2]],$jo9_vrl_group,$jo9_relation_prev_body[args[2]],$jo9_vrl_body,jo9_vf_tone,jo9_relation_prev_tone[args[2]])
 if $jo9_vrl_continued ! $jo9_vrl_body: $jo9_vrl_join=''
 $jo9_vrl_body=$jo9_vrl_continued
 $jo9_relation_prev_group[args[2]]=$jo9_vrl_group
 $jo9_relation_prev_body[args[2]]=$jo9_vrl_join+$jo9_vrl_body
 jo9_relation_prev_tone[args[2]]=jo9_vf_tone
 $result=$jo9_vrl_join+$jo9_vrl_body
 killvar '$jo9_vrl_continued'
 ! JO9 MOD END VOICE_RELATION_BRIDGE_V8
 if $jo9_vrl_cue ! '' and jo9_relation_cue_used=0:
  $result=$jo9_vrl_cue+' '+$result
  jo9_relation_cue_used=1
 end
 killvar '$jo9_vrl_group'
 killvar '$jo9_vrl_body'
 killvar '$jo9_vrl_cue'
 killvar '$jo9_vrl_join'
 killvar 'jo9_vrl_sign'
}
! JO9 MOD END VOICE_RELATION_FLOW
! JO9 MOD END VOICE_ARGON_NATIVE

! JO9 MOD START ARGON_R2_NATIVE_TOPICS | recognize only already-selected native 1116 pages
$voice_native_moods = {
 killvar '$jo9_vnt_mood_keys'
 copyarr '$jo9_vnt_mood_keys', '$slave_good_mood'
 jo9_vnt_mood_scan = 0
 :jo9_vnt_native_mood_bad_keys
 if jo9_vnt_mood_scan < arrsize('$slave_bad_mood'):
  $jo9_vnt_mood_keys[] = $slave_bad_mood[jo9_vnt_mood_scan]
  jo9_vnt_mood_scan += 1
  jump 'jo9_vnt_native_mood_bad_keys'
 end
 $jo9_vnt_mood_keys[] = 'pos_'
 $jo9_vnt_mood_keys[] = 'neg_'
 jo9_vnt_mood_page = 1
 :jo9_vnt_native_mood_next
 if jo9_vnt_mood_page < arrsize('$text'):
  jo9_vnt_mood_scan = 0
  :jo9_vnt_native_mood_match
  if jo9_vnt_mood_scan < arrsize('$jo9_vnt_mood_keys'):
   $jo9_vnt_mood_key = $jo9_vnt_mood_keys[jo9_vnt_mood_scan]
   dynamic "$jo9_vnt_mood_original = '" + $replace($mood_description[$jo9_vnt_mood_key], 'dyn'+'slave', 'slave') + "'"
   if $jo9_vnt_mood_original = $text[jo9_vnt_mood_page]:
    $text[jo9_vnt_mood_page] = $dyneval($voice_native,'1116_slave_'+$jo9_vnt_mood_key,$text[jo9_vnt_mood_page])
    jo9_vnt_mood_scan = arrsize('$jo9_vnt_mood_keys')
   else
    jo9_vnt_mood_scan += 1
   end
   jump 'jo9_vnt_native_mood_match'
  end
  jo9_vnt_mood_page += 1
  jump 'jo9_vnt_native_mood_next'
 end
 killvar '$jo9_vnt_mood_keys'
 killvar '$jo9_vnt_mood_key'
 killvar '$jo9_vnt_mood_original'
 killvar 'jo9_vnt_mood_scan'
 killvar 'jo9_vnt_mood_page'
}
! JO9 MOD END ARGON_R2_NATIVE_TOPICS


! JO9 MOD START VOICE_ARGON_STORED | 2026-10-18_argon_revised_dialogue
$voice_native_stored = {
 $result=$args[1]
 $jo9_vns_group=''
 jo9_vns_matches=0
 if $args[0]='world' and $args[1] ! '':
  if $prehistoric_description[1] ! '' and $args[1]=$prehistoric_description[1]:
   $jo9_vns_group='1111_world_prehistoric_1'
   jo9_vns_matches+=1
  end
  if $prehistoric_description[2] ! '' and $args[1]=$prehistoric_description[2]:
