! expects to be called with dynamic $replace($get_non_combat_equipment, 'dyn'+'slave', 'a slave instance variable')
! args: 
!	0 - item 
!	1 - slot
!   2 - force text 	[OPTIONAL] {DEFAULT: item_name[$args[0]] I.E. the item name}
! 	3 - no tooltip 	[OPTIONAL] {DEFAULT: 0, Set to 1 if no aura-bound tooltip should be added} 
! 	4 - item_change argument [OPTIONAL] {DEFAULT: 0}
$get_non_combat_equipment = {
	$equip_choice += '<a href = "EXEC: $new_item = ''<<$args[0]>>'' & slot = <<args[1]>> & gt ''item_change'', <<args[4]>>"><<iif($args[2] ! "", $args[2], $item_name[$args[0]])>></a>' + iif(args[3] = 0, dyneval($replace($dyn_aurabound_tooltip, 'dyn'+'slave', 'dynslave'), $args[0], '', args[4]), '') + '<br>'
}

$dyn_aurabound_tooltip = {
	if args[2] = 0: args[2] = 1 &! item change argument aka quantity (earring / nipple slots equip 2 of the item), default to 1
	if $args[0] = '' or $args[0] = 'пусто' or $args[0] = 'голая': $args[0] = 'no match' &! avoid showing aurabound icon next to empty slots
	$result = iif(dynslave_inventory[$args[0]] > 0 or ($args[0] = $args[1]), '&nbsp;<a class="tooltip-right" tooltip-data="이 아이템은 <<$dynslave_name>>에게 아우라로 귀속되어 있다 (<<dynslave_inventory[$args[0]]+($args[0] = $args[1])*args[2]>>/<<dynslave_inventory[$args[0]]+inventory[$args[0]]+($args[0] = $args[1])*args[2]>>)"><img style="width:15;height:15;" src="content/pic/aurabound.png"></a>', '')
}

$slave_cloth_list = {
	slot = 24
	$equip_choice = ''
	dynamic $show_item_description_and_image, $slave["cloth"]
! JO9 MOD START J9M1785 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	if $item_name[$slave["cloth"]] ! '' and $item_name[$slave["cloth"]] ! '-' and $item_name[$slave["cloth"]] ! 'Naked': dynamic $replace($get_non_combat_equipment, 'dyn'+'slave', 'slave'), 'голая', 24, '알몸으로 벗기기 -', 1 &! $equip_choice += '<a href = "EXEC: $new_item = ''голая'' & slot = 24 & gt ''item_change''">- 알몸으로 벗기기 -</a><br>'
! JO9 MOD END J9M1785
	if slave_inventory['common_apron'] > 0 		or inventory['common_apron'] > 0: 		dynamic $replace($get_non_combat_equipment, 'dyn'+'slave', 'slave'), 'common_apron', 24 &! $equip_choice += '<a href = "EXEC: $new_item = ''common_apron'' & slot = 24 & gt ''item_change''"><<$item_name["common_apron"]>></a><br>'
	if slave_inventory['maid_dress'] > 0 		or inventory['maid_dress'] > 0: 		dynamic $replace($get_non_combat_equipment, 'dyn'+'slave', 'slave'), 'maid_dress', 24 &! $equip_choice += '<a href = "EXEC: $new_item = ''maid_dress'' & slot = 24 & gt ''item_change''"><<$item_name["maid_dress"]>></a><br>'
