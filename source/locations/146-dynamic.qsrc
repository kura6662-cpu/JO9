 if instr($result,'(죄송한 듯 눈을 내리깔며) ')=1: $result=$trim(mid($result,16,len($result)))
 if instr($result,'(차분한 눈빛으로 예를 갖추며) ')=1: $result=$trim(mid($result,18,len($result)))
 if instr($result,'(담담하게 고개를 숙이며) ')=1: $result=$trim(mid($result,15,len($result)))
 if instr($result,'(담담하게 시선을 맞추며) ')=1: $result=$trim(mid($result,15,len($result)))
 if instr($result,'(담담한 표정으로) ')=1: $result=$trim(mid($result,11,len($result)))
 if instr($result,'(낮게 한숨을 쉬며) ')=1: $result=$trim(mid($result,12,len($result)))
