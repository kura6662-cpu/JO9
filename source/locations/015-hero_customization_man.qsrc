# hero_customization_man
! Readable view; authoritative fields are in ../locations.json.
if snk_room_target > 0 and $curloc = 'hero_customization_man': gs 'snk_room_bridge', 'guard', 'hero_customization_man'
! JO9 MOD START J9M2697 | 2026-10-14_hide_outer_frame_on_startup | changed block; context may be included
*p '<style id="jo9_startup_no_outer_frame">body:before,body:after{display:none!important;}</style>'
! JO9 MOD END J9M2697
get_initial_slave = 1

*p '<div id = "big_title_scroll"><img src = "content\pic\big_scroll_large.png"></div>'
*p '<div id = "center_text_column_4"> <center><b>마스터를 선택하세요</center></b></div>'

*p '<div id = "ava_choice_1_1"><a href = "EXEC: gs ''init_story_mode'' & hero_choice = 1 & gt ''hero_description''"><img src = "content\pic\master\master_noble_sepia.png"></a></div>'
