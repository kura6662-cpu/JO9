! JO9 MOD START J9M1479 | 2026-10-08_persistent_image_cycle, 2026-10-15_z_inline_text_prefix | changed block; context may be included
*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\apteka.png"></div>')
! JO9_INLINE_TEXT_PREFIX_20261015
local $jo9_leading_empty = $strfind($text[txt], '^(\s|&nbsp;|<[bB][rR]\s*/?>)+')
if $jo9_leading_empty ! '': $text[txt] = $mid($text[txt], len($jo9_leading_empty) + 1, len($text[txt]))
! JO9 MOD END J9M1479
*p '<div id = "text"><<$text[txt]>></div>'
! JO9 MOD START J9M1478 | 2026-10-09_city_scene_menu_alignment | changed block; context may be included
