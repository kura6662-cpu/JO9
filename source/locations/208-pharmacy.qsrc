! JO9 MOD END J9M1502
GS '_layout'
npc = 0
$npc_id = 'Marianna'
$text_display = ''
	!Strec - jon_UIadds addition
	sjm_weaponshopsparksbegin = sparks
if sp_txt = 0: sp_txt = 1

IF sp_txt = 1:
