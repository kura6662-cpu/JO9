*p '<div id = "jeongrijotnaanhane_tkwls"><img src = "<<$sex["girl_ava"]>>.png"></div>'
! JO9 MOD START J9M1441 | 2026-10-08_persistent_image_cycle | changed block; context may be included
*p func('interior_change', 'jo9_html', '<div id = "bg"><img src="content\pic\bg\<<$bg[$place]>>.png"></div>')
! JO9 MOD END J9M1441
*p '<div id = "text"></div>'
*p '<div id = "intensity_knobs"><<$intensity_knobs>></div>'
*p '<div id = "bg"><<$sex_menu>></div>'

$info_bar = ''
*p '<div id = "haissibaljjangggae_dlfma"><<$master_name>></div>'
*p '<div id = "jeongrijotnaanhane_dlfma"><<$sex["girl_name"]>></div>'
*p '<div id = "haissibaljjangggae_tjfaud"><<$sex_master_stat>></div>'
*p '<div id = "jeongrijotnaanhane_tjfaud"><<$sex_info>></div>'
*p '<div id = "haissibaljjangggae_tjfaudgkskej"><<$sex_master_var>></div>'
*p '<div id = "jeongrijotnaanhane_tjfaudgkskej"><<$sex_slave_var>></div>'

if ui_style = 2:
	if sound_on = 1:
		*p '<div id="side_sound_icon"><a href = "EXEC: sound_on = 0 & close all & gt $curloc"><img src="content\pic\ui\grimdark\buttons\sound_on.png"></a></div>'
	else
		*p '<div id="side_sound_icon"><a href = "EXEC: sound_on = 1 & gt $curloc"><img src="content\pic\ui\grimdark\buttons\sound_off.png"></a></div>'
	end
	else
	if sound_on = 1:
		*p '<div id="side_sound_icon"><a href = "EXEC: sound_on = 0 & close all & gt $curloc"><img src="content\pic\buttons\sound_on.png"></a></div>'
	else
		*p '<div id="side_sound_icon"><a href = "EXEC: sound_on = 1 & gt $curloc"><img src="content\pic\buttons\sound_off.png"></a></div>'
	end
end

if ui_style = 2:
	*p '<div id="side_options_icon"><a href = "EXEC: sex_num = 100 & gt $curloc"><img src="content\pic\ui\grimdark\buttons\gear.png"></a></div>'
else
	*p '<div id="side_options_icon"><a href = "EXEC: sex_num = 100 & gt $curloc"><img src="content\pic\buttons\gear.png"></a></div>'
end

if sex_num = 100:
	if exam_in_progress = 1:
		*p '<div id = "under_soundconfigS"><a style="
line-height:5%"><Br></a>'
		*p '&nbsp&nbsp&nbsp배경음악 : <a href = 1>&nbsp저&nbsp</a> <<music_volume>>% <a href = 2>&nbsp고&nbsp</a><a style="line-height:5%"><br></a>'
		*p '&nbsp&nbsp&nbsp효과음악 : <a href = 4>&nbsp고&nbsp</a> <<sound_volume>>% <a href = 5>&nbsp고&nbsp</a></div>'
	else
		*p '<div id = "under_soundconfigS"><a style="
line-height:5%"><Br></a>'
		*p '&nbsp&nbsp&nbsp배경음악 : <a href = 1>&nbsp저&nbsp</a> <<music_volume>>% <a href = 2>&nbsp고&nbsp</a><a style="line-height:5%"><br></a>'
		*p '&nbsp&nbsp&nbsp효과음악 : <a href = 4>&nbsp저&nbsp</a> <<sound_volume>>% <a href = 5>&nbsp고&nbsp</a></div>'
	end
	if sound_on = 1:
		*p '<div id="sound_icon2"><a class="tooltip-top" tooltip-data="소리 재생중" href = "EXEC: sound_on = 0 & close all & gt $curloc"><img src="content\pic\<<IIF(ui_style = 2, ''ui\grimdark\buttons\sound_on.png'', ''buttons\sound_on.png'')>>" style="width:35px;height:35px;"></a></div>'
	else
		*p '<div id="sound_icon2"><a class="tooltip-top" tooltip-data="음소거 중" href = "EXEC: sound_on = 1 & gt $curloc"><img src="content\pic\<<IIF(ui_style = 2, ''ui\grimdark\buttons\sound_off.png'', ''buttons\sound_off.png'')>>" style="width:35px;height:35px;"></a></div>'
	end
end

act '1':
	music_volume -= 10
	if music_volume < 0: music_volume = 0
	gt $curloc
end

act '2':
	music_volume += 10
	if music_volume > 100: music_volume = 100
	gt $curloc
end

act '3':
	if music_volume ! 0:
		rem_music_volume = music_volume
		music_off = 1
		music_volume = 0
	else
		music_volume = rem_music_volume
		music_off = 0
	end
	gt $curloc
end

act '4':
	sound_volume  -= 10
	if sound_volume < 0: sound_volume = 0
	gt $curloc
end

act '5':
	sound_volume += 10
	if sound_volume > 100: sound_volume = 100
	gt $curloc
end

act '6':
	if sound_volume ! 0:
		rem_sound_volume =  sound_volume
		sound_off = 1
		sound_volume = 0
	else
		sound_volume = rem_sound_volume
		sound_off = 0
	end
	gt $curloc
end

!intensity buttons
if sex_num >= 0:
	if intensity = 1:
		*p '<div id = "intensity_01"><img src = "content\pic\buttons\01.png"></div>'
	else
		*p '<div id = "intensity_01"><a class="tooltip-right" tooltip-data="매우 부드럽게 " href = "EXEC: intensity = 1 & gt $curloc"><img src = "content\pic\buttons\01g.png"></a></div>'
	end
	if intensity = 2:
		*p '<div id = "intensity_02"><img src = "content\pic\buttons\02.png"></div>'
	else
		*p '<div id = "intensity_02"><a class="tooltip-right" tooltip-data="부드럽게 " href = "EXEC: intensity = 2 & gt $curloc"><img src = "content\pic\buttons\02g.png"></a></div>'
	end
	if intensity = 3:
		*p '<div id = "intensity_03"><img src = "content\pic\buttons\03.png"></div>'
	else
		*p '<div id = "intensity_03"><a class="tooltip-right" tooltip-data=" " href = "EXEC: intensity = 3 & gt $curloc"><img src = "content\pic\buttons\03g.png"></a></div>'
	end
	if intensity = 4:
		*p '<div id = "intensity_04"><img src = "content\pic\buttons\04.png"></div>'
	else
		*p '<div id = "intensity_04"><a class="tooltip-right" tooltip-data="강하게 " href = "EXEC: intensity = 4 & gt $curloc"><img src = "content\pic\buttons\04g.png"></a></div>'
	end
	if intensity = 5:
		*p '<div id = "intensity_05"><img src = "content\pic\buttons\05.png"></div>'
	else
		*p '<div id = "intensity_05"><a class="tooltip-right" tooltip-data="거칠게 " href = "EXEC: intensity = 5 & gt $curloc"><img src = "content\pic\buttons\05g.png"></a></div>'
	end
end

if sound_on = 1 and $play_sound[txt] ! '': play 'content\snd\<<$play_sound[txt]>>.wav', sound_volume
if $play_sound[txt] ! '': $play_sound[txt] = ''

if wizard_mode = 1: $msg_txt = "<center>Итог</center><br>" + _
"Новизна: <<sex['girl_newness']>><br>" + _
"Старание: <<diligence>><br>" + _
"Навык: <<skill>><br>" + _
"Качество: <<quality>><br>" + _
