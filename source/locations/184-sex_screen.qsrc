# sex_screen
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1442 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'sex_screen': gs 'snk_room_bridge', 'guard', 'sex_screen'
! JO9 MOD END J9M1442
!SEX SCREEN USER INTERFACE
gs '_layout'
gs 'sex_addup'

killvar '$play_sound'
$play_sound[1] = ''
CLOSE ALL

$sex_menu = ''
dynamic $sex_options[sex_num]
gs "#sex_texts"
gs 'sex_addup'

pc_boner_plus = sex['pc_boner']
if pc_boner_plus < 0: pc_boner_plus = 5 - sex['pc_boner']
if pc_boner_plus > 10: pc_boner_plus = 10

$sex_master_stat = ''
$sex_master_stat = '<a style = "color: black;" href="EXEC: msg $возбуждение_справка & gt $curloc">흥분도:</a><br>'
$sex_master_stat += '<a style = "color: black;" href="EXEC: msg $энергия_справка & gt $curloc">에너지:</a><br>'
$sex_master_stat += '<a style = "color: black;" href="EXEC: msg $интерес_справка & gt $curloc">관심:</a><br>'
$sex_master_stat += '<a style = "color: black;" href="EXEC: msg $запас_семени_справка & gt $curloc">정액량:</a><br>'
$sex_master_stat += '<a style = "color: black;" href="EXEC: msg $порог_справка & gt $curloc">한계:</a><br>'

$sex_info = '<a style = "color: black;" href="EXEC: msg $партнер_выносливость_справка & gt $curloc"><BR>체력:</a><br>'
$sex_info += '<a href="EXEC: msg $партнер_возбуждение_справка & gt $curloc"><<$sex_girl_arousal[sex["girl_excitement"]]>></a><br>'
$sex_info += '<a href="EXEC: msg $партнер_внимание_справка & gt $curloc"><<$sex_girl_concentration[sex["girl_attention"]]>></a><br>'
$sex_info += '<a href="EXEC: msg $партнер_открытость_справка & gt $curloc"><<$sex_girl_openmind[sex["girl_openmind"]]>></a><br>'
!$sex_info += '<a href="EXEC: msg $партнер_боль_справка & gt $curloc"><<$sex_girl_pain[sex["girl_pain"]]>></a><br>'
$sex_info += '<a style = "color: black;" href="EXEC: msg $партнер_оргазмометр_справка & gt $curloc">절정 카운터: </a><br>'

$sex_master_var = ''
$sex_master_var = '<<$sex_pc_excitement[sex["pc_excitement_state"]]>><br>'
$sex_master_var += '<<$sex_pc_energy[sex["pc_energy_state"]]>><br>'
$sex_master_var += '<<$sex_pc_interest[sex["pc_interest_state"]]>><br>'
