if master_medic_rate >= master_medic_rate_cap[1]: master_medic = 2
if master_medic_rate >= master_medic_rate_cap[2]: master_medic = 3
if master_medic_rate >= master_medic_rate_cap[3]: master_medic = 4
if master_medic_rate >= master_medic_rate_cap[4]: master_medic = 5

!Fog trophies give one-time xp once master skill without bonuses reaches 4 (A+) - ImperatorAugustus
!There are 14 trophies in total and fighting xp is no longer given for sparring or non-unique Fog battles at A+
!So to reach S+ all of the trophies must be obtained, or other sources of xp must be used to supplement progress
!Currently the only other source of xp is personally teaching gladiatrix lessons, which gives master +1 per lesson
!Note it is currently impossible to obtain all trophies before reaching A+ skill because Fog battles give 5-15 xp each
if master_fighter_rate >= master_fighter_rate_cap[3]:
	if trophy_youngfiend  = 1: trophy_youngfiend  = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_maturefiend = 1: trophy_maturefiend = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_hugefiend   = 1: trophy_hugefiend   = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_blackmedic  = 1: trophy_blackmedic  = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_paladin     = 1: trophy_paladin     = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_beastmen    = 1: trophy_beastmen    = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_werewolf    = 1: trophy_werewolf    = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_vampire     = 1: trophy_vampire     = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_lich        = 1: trophy_lich        = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_scum        = 1: trophy_scum        = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_ogre        = 1: trophy_ogre        = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_goblins     = 1: trophy_goblins     = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_warg        = 1: trophy_warg        = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
	if trophy_orc         = 1: trophy_orc         = 2 & master_fighter_rate += (master_fighter_rate_cap[4] - master_fighter_rate_cap[3])/14
end

master_fighter = 0
if master_fighter_rate >= master_fighter_rate_cap[0]: master_fighter = 1
if master_fighter_rate >= master_fighter_rate_cap[1]: master_fighter = 2
if master_fighter_rate >= master_fighter_rate_cap[2]: master_fighter = 3
if master_fighter_rate >= master_fighter_rate_cap[3]: master_fighter = 4
if master_fighter_rate >= master_fighter_rate_cap[4]: master_fighter = 5

master_mage = 0
