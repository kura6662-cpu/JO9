if master_flagelation_rate >= master_flagelation_rate_cap[0]: master_flagelation = 1
if master_flagelation_rate >= master_flagelation_rate_cap[1]: master_flagelation = 2
if master_flagelation_rate >= master_flagelation_rate_cap[2]: master_flagelation = 3
if master_flagelation_rate >= master_flagelation_rate_cap[3]: master_flagelation = 4
if master_flagelation_rate >= master_flagelation_rate_cap[4]: master_flagelation = 5

