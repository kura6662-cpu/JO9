if master_torture_rate >= master_torture_rate_cap[0]: master_torture = 1
if master_torture_rate >= master_torture_rate_cap[1]: master_torture = 2
if master_torture_rate >= master_torture_rate_cap[2]: master_torture = 3
if master_torture_rate >= master_torture_rate_cap[3]: master_torture = 4
if master_torture_rate >= master_torture_rate_cap[4]: master_torture = 5

master_bondage = 0
if master_bondage_rate >= master_bondage_rate_cap[0]: master_bondage = 1
if master_bondage_rate >= master_bondage_rate_cap[1]: master_bondage = 2
if master_bondage_rate >= master_bondage_rate_cap[2]: master_bondage = 3
if master_bondage_rate >= master_bondage_rate_cap[3]: master_bondage = 4
if master_bondage_rate >= master_bondage_rate_cap[4]: master_bondage = 5

master_petting = 0
if master_petting_rate >= master_petting_rate_cap[0]: master_petting = 1
if master_petting_rate >= master_petting_rate_cap[1]: master_petting = 2
if master_petting_rate >= master_petting_rate_cap[2]: master_petting = 3
if master_petting_rate >= master_petting_rate_cap[3]: master_petting = 4
if master_petting_rate >= master_petting_rate_cap[4]: master_petting = 5

master_oral = 0
if master_oral_rate >= master_oral_rate_cap[0]: master_oral = 1
if master_oral_rate >= master_oral_rate_cap[1]: master_oral = 2
if master_oral_rate >= master_oral_rate_cap[2]: master_oral = 3
if master_oral_rate >= master_oral_rate_cap[3]: master_oral = 4
if master_oral_rate >= master_oral_rate_cap[4]: master_oral = 5

master_penetration = 0
if master_penetration_rate >= master_penetration_rate_cap[0]: master_penetration = 1
if master_penetration_rate >= master_penetration_rate_cap[1]: master_penetration = 2
if master_penetration_rate >= master_penetration_rate_cap[2]: master_penetration = 3
if master_penetration_rate >= master_penetration_rate_cap[3]: master_penetration = 4
if master_penetration_rate >= master_penetration_rate_cap[4]: master_penetration = 5

master_fetish = 0
if master_fetish_rate >= master_fetish_rate_cap[0]: master_fetish = 1
if master_fetish_rate >= master_fetish_rate_cap[1]: master_fetish = 2
if master_fetish_rate >= master_fetish_rate_cap[2]: master_fetish = 3
if master_fetish_rate >= master_fetish_rate_cap[3]: master_fetish = 4
if master_fetish_rate >= master_fetish_rate_cap[4]: master_fetish = 5

!Counting master cloth characteristic boosts - crushboss
killvar 'boost_up'
dynamic $item_property[$master_cloth]

if boost_up['master_artdirector'] = 1:
	master_artdirector += 1
end

if boost_up['master_fighter'] = 1:
	master_fighter += 1
end

if boost_up['master_butler'] = 1:
	master_butler += 1
end

if boost_up['master_medic'] = 1:
	master_medic += 1
end

if boost_up['master_mage'] = 1:
	master_mage += 1
end

!Characteristic Alignment for Master - crushboss
if master_hygiene_rate < 0: master_hygiene_rate = 0
if master_excitement_rate < -200: master_excitement_rate = -200
if master_excitement_rate > 200: master_excitement_rate = 200
if master_str > 5: master_str = 5
if master_str < 0: master_str = 0
! negative str will trigger game over via $master_pass_out call from menu_form
if master_cha > 5: master_cha = 5
if master_cha < 0: master_cha = 0
if master_cha_rate < 0: master_cha_rate = 0
if master_libido > 5: master_libido = 5
if master_libido < 0: master_libido = 0
if master_libido_rate <= 1: master_libido_rate = 2
if master_domination > 5: master_domination = 5
if master_domination < 0: master_domination = 0
if master_domination_rate < 0: master_domination_rate = 0

if master_tutor > 5: master_tutor = 5
if master_tutor < 0: master_tutor = 0
if master_tutor_rate < 0: master_tutor_rate = 0
if master_fighter > 6: master_fighter = 6
if master_fighter < 0: master_fighter = 0
if master_fighter_rate < 0: master_fighter_rate = 0
if master_butler > 6: master_butler = 6
if master_butler < 0: master_butler = 0
if master_butler_rate < 0: master_butler_rate = 0
if master_artdirector > 6: master_artdirector = 6
if master_artdirector < 0: master_artdirector = 0
if master_artdirector_rate < 0: master_artdirector_rate = 0
if master_medic > 6: master_medic = 6
if master_medic < 0: master_medic = 0
if master_medic_rate < 0: master_medic_rate = 0
if master_mage > 6: master_mage = 6
if master_mage < 0: master_mage = 0
if master_mage_rate < 0: master_mage_rate = 0
if master_torture > 5: master_torture = 5
if master_torture < 0: master_torture = 0
if master_torture_rate < 0: master_torture_rate = 0
if master_bondage > 5: master_bondage = 5
if master_bondage < 0: master_bondage = 0
if master_bondage_rate < 0: master_bondage_rate = 0
if master_flagelation > 5: master_flagelation = 5
if master_flagelation < 0: master_flagelation = 0
if master_flagelation_rate < 0: master_flagelation_rate = 0
if master_petting > 5: master_petting = 5
if master_petting < 0: master_petting = 0
if master_petting_rate < 0: master_petting_rate = 0
if master_oral > 5: master_oral = 5
if master_oral < 0: master_oral = 0
if master_oral_rate < 0: master_oral_rate = 0
if master_penetration > 5: master_penetration = 5
if master_penetration < 0: master_penetration = 0
if master_penetration_rate < 0: master_penetration_rate = 0
if master_fetish > 5: master_fetish = 5
if master_fetish < 0: master_fetish = 0
if master_fetish_rate < 0: master_fetish_rate = 0

if master_ill < 0: master_ill = 0
if master_ill > 6: master_ill = 6
if master_issues < 0: master_issues = 0
if master_issues > 5: master_issues = 5
if master_wounds > 5: master_wounds = 5
if master_wounds_rate < 0: master_wounds_rate = 0

if code_defined['update_master_energy_stars'] = 0:
	code_defined['update_master_energy_stars'] = 1 &! do-once

	$update_master_energy_stars = {
		$master_energy_stars = ''
		! if energy exceeds cap and a half star is missing, refill it
		if master_energy > 5 and master_half_action = 1: master_half_action = 0
		! transfer bonus energy stars (negative half_actions) to normal energy stars
		if master_half_action < 0 and master_energy < 5:
			master_energy += (-1 * master_half_action) / 2
			master_half_action = master_half_action MOD 2 - max(0, master_energy - 5)*2
		end
		! consume spent half actions (positive half_actions)
		:_process_master_half_actions_loop
			if master_half_action > 1: master_half_action -= 2 & dynamic $master_energy_drop
			if master_half_action > 1: jump '_process_master_half_actions_loop'
		! clamp value
		master_energy = max(-5, min(5, master_energy))
		! update overexerted moodlet state, which affects the color of energy stars (TODO: not fully implemented)
		!if master_energy < 0 or already_done_today['exertion'] >= master_str:
		!	master_moodlet['neg_master_overexerted'] = 100
		!else
		!	master_moodlet['neg_master_overexerted'] = 0
		!end
		! assemble row of images corresponding to current energy level and exhaustion status
		if master_energy = 0:
			if master_half_action = 1:
				$master_energy_stars = '<img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_red_half.png">'
			elseif master_half_action = -1:
				$master_energy_stars = iif(master_moodlet['neg_master_overexerted'] = 0, '<img src = "content/pic/ui overhaul/energy/energy_green_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_purple_half.png">') + '<img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png"><img src = "content/pic/ui overhaul/energy/energy_empty.png">'
			else
				$master_energy_stars = '-'
			end
		else
			if master_energy < 0:
				for i = 1 to (5 + master_energy) step 1: $master_energy_stars += iif(i = (5 + master_energy) and master_half_action = 1, '<img src = "content/pic/ui overhaul/energy/energy_red_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_empty.png">')
				for i = 1 to (-1 * master_energy) step 1: $master_energy_stars += iif(i = 1 and (master_half_action MOD 2) = -1, '<img src = "content/pic/ui overhaul/energy/energy_red_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_red.png">')
			else
				for i = 1 to (master_energy + max(0, master_half_action/-2)) step 1: $master_energy_stars += iif(i = master_energy and master_half_action = 1, iif(master_moodlet['neg_master_overexerted'] = 0, '<img src = "content/pic/ui overhaul/energy/energy_green_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_purple_half.png">'), iif(master_moodlet['neg_master_overexerted'] = 0, '<img src = "content/pic/ui overhaul/energy/energy_green.png">', '<img src = "content/pic/ui overhaul/energy/energy_purple.png">'))
				if (master_half_action MOD 2) = -1:
					$master_energy_stars += iif(master_moodlet['neg_master_overexerted'] = 0, '<img src = "content/pic/ui overhaul/energy/energy_green_half.png">', '<img src = "content/pic/ui overhaul/energy/energy_purple_half.png">')
					if (5 - master_energy - max(0, master_half_action/-2)) > 1: for i = 2 to (5 - master_energy - max(0, master_half_action/-2)) step 1: $master_energy_stars += '<img src = "content/pic/ui overhaul/energy/energy_empty.png">'
				elseif (5 - master_energy - max(0, master_half_action/-2)) > 0:
					for i = 1 to (5 - master_energy - max(0, master_half_action/-2)) step 1: $master_energy_stars += '<img src = "content/pic/ui overhaul/energy/energy_empty.png">'
				end
			end
		end

	}
end
dynamic $update_master_energy_stars

!Update situational master moodlets (expects slaves have been updated already - specifically, $newloc_update_slave in #static_base)
gs 'moodlets' &! depends on house_mess, master_hygiene, master_wealth, brand_reputation, master_excitement, master_energy, master_str, does not depend on master_style

! $moodlets_account refreshes mood (and mood description strings) for master
if args[0] = 0: gs '$moodlets_account' &! #dynamic passes a 1 here from $master_ejaculate to bypass mood update to avoid side effects to next_day mood checks due to alarm rule

!style update after hygiene, energy and mood updates (above) and before updating master_supermacy (below) - ImperatorAugustus
master_style = 2 + style_modifer[$master_cloth] - max(0, master_hygiene - 2)
if master_hygiene = 0: master_style += 1
if master_energy > 0: master_style += 1
if master_energy < 0: master_style -= 1
if master_visage > 0: master_style += 1
if master_visage = 0: master_style -= 1
if master_haircut > 0: master_style += 1
if master_haircut = 0: master_style -= 1
if master_str > 3: master_style += 1
if master_str < 3: master_style -= 1
if master_mood > 0: master_style += 1
if master_mood < 0: master_style -= 1
if master_style > 5: master_style = 5
if master_style < 0: master_style = 0

!Calculate Master Supermacy

dynamic $replace("
	master_supermacy = (master_cha + master_domination + master_style + master_str + dynslave['beaten_ever'] + magna_magnifika + item_supermacy_bonus) - (dynslave['temper'] + dynslave['ego'] + dynslave['pride'] + dynslave['stamina'] + (dynslave['intellect'] - 3))
	if $master_cloth = 'regal_suit': master_supermacy += 1
	if $master_cloth = 'comfy_robes': master_supermacy -= 1
	if $master_back_wpn = 'посох_огня': master_supermacy += 2

	! lolis are easier to dominate.  Uncle Tom is particularly good at it, and it’s easier for Johny to pick on someone smaller than him
	if dynslave['age'] = CONST_INT['loli_age']:
		master_supermacy += 2
		if hero_select = 5:  master_supermacy += 3  &! Teacher
		if hero_select = 9:  master_supermacy += 8  &! Old Man
		if hero_select = 10: master_supermacy += 1  &! Kid
	end
	if dynslave['age'] = CONST_INT['milf_age']:
		if hero_select = 8:  master_supermacy += 2  &! Butler
		if hero_select = 9:  master_supermacy -= 1  &! Old Man
	end
	if dynslave['age'] = CONST_INT['young_age']:
		if hero_select = 5:  master_supermacy += 2  &! Teacher
	end
", 'dyn'+'slave', iif(slave_state > CONST_INT['no_slave'], 'slave', 'assistant'))

------------ $calculate_attributes ------------
