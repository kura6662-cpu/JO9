if master_mage_rate >= master_mage_rate_cap[1]: master_mage = 2
if master_mage_rate >= master_mage_rate_cap[2]: master_mage = 3
if master_mage_rate >= master_mage_rate_cap[3]: master_mage = 4
if master_mage_rate >= master_mage_rate_cap[4]: master_mage = 5

master_domination = 0
