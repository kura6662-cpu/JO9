$taurus_fame[0] = dyneval($vb_cycle_skill, 0, '나는 타우루스 가문과 아무런 접점이 없다. 그들의 구역에서 직접 노예를 팔아야만한다.')
$taurus_fame[1] = dyneval($vb_cycle_skill, 1, '타우루스 가문의 일원이 이미 나에 대해 알고 있다. 그 덕분에 황소자리 영역에서 거주할 수 있게 되었지만, 그게 전부다.')
$taurus_fame[2] = dyneval($vb_cycle_skill, 2, '나는 타우루스 가문의 대표들과 유용한 계약을 체결했다. 그러나 새하얀 궁전에 들어가기 위해서는 더 중요한 인사를 내 고객으로 만들어야 한다.')
$taurus_fame[3] = dyneval($vb_cycle_skill, 3, '나는 새하얀 궁전에 들어갈 수 있게끔 해 준 타우루스 가문의 영향력 있는 친구가 많다. 이제 엘리트 고객을 상대할 수 있다!')
$taurus_fame[4] = dyneval($vb_cycle_skill, 4, '타우루스 가문의 최고 일원 중 한명을 내 친구로 만들었다. 이제 황소자리 왕을 알현할 수 있다!')
$taurus_fame[5] = dyneval($vb_cycle_skill, 5, '타우루스 가문의 왕이 나에게 직접 기사작위를 수여했다. 이제 나는 그냥 단순한 사람이 아니다. 나는 황소의 등에 타고 있다!')
$taurus_fame[6] = dyneval($vb_cycle_skill, 5, '국왕은 자기 의뢰 결과에 만족했다. 하지만 나는 이미 타가문 소속 귀족이기 때문에, 타우루스 가문 소속이 될 수는 없다.')

$serpis_fame[0] = dyneval($vb_cycle_skill, 0, '세르피스 가문의 대표들은 나를 거의 모른다. 뱀자리 영역에서 입소문을 내 줄만한 최소한의 고객들을 찾는다면, 그들도 날 알게 될 것이다.')
$serpis_fame[1] = dyneval($vb_cycle_skill, 1, '세르피스 가문의 여러 인사들과 알고지낸 덕에 뱀자리 영역에서 거주할 수 있게 되었다. 그러나 그게 전부다. 명성이 더 높아지게끔 노력해야 한다.')
$serpis_fame[2] = dyneval($vb_cycle_skill, 2, '세르피스 가문의 일원 몇몇과 친구가 되었다. 그러나 중앙행정 첨탑에 들어가려면 아직 부족하다. 거물 중 한명에게 노예를 판매할 필요가 있다.')
$serpis_fame[3] = dyneval($vb_cycle_skill, 3, '나는 세르피스 가문에 유용한 연줄도 많이 만들었고, 중앙행정 첨탑에 들어갈만한 영향력도 쌓았다. 이제 이 구역을 지배하는 자들을 만날 차례다.')
$serpis_fame[4] = dyneval($vb_cycle_skill, 4, '세르피스 가문의 고위직에 있는 지인 덕분에 의장을 알현해 노예를 판매할 수 있었다. 엄청난 진전이다!')
$serpis_fame[5] = dyneval($vb_cycle_skill, 5, '나는 대통령으로부터 세르피스 가문 명예시민 증서를 수여받았다. 형식적인 절차가 전혀 아니다. 내 뒤에 뱀의 실제 권력이 있다는 얘기지!')
$serpis_fame[6] = dyneval($vb_cycle_skill, 5, '대통령는 자기 주문 결과에 만족했다. 하지만 나는 이미 타가문 소속 귀족이기 때문에, 세르피스 가문 소속이 될 수는 없다.')

$kamira_fame[0] = dyneval($vb_cycle_skill, 0, '나는 카미라 가문의 수인들에게 알려지지 않았다. 하지만 내가 그들의 일원과 제대로된 한 번의 계약만 맺으면 나를 알아볼 것이다.')
$kamira_fame[1] = dyneval($vb_cycle_skill, 1, '내 고객들 덕분에 추방자 영역 내 거주권을 얻을 수 있었다. 그러나 명성을 높이려면 더 많은 고객을 찾아야 한다.')
$kamira_fame[2] = dyneval($vb_cycle_skill, 2, '카미라 가문의 사람들과 안면은 있다. 그러나 불의 성채에 들어가기 위한 진짜 영향력을 얻기 위해서는 인간 이외의 더 영향력 있는 친구를 사귀어야 한다.')
$kamira_fame[3] = dyneval($vb_cycle_skill, 3, '불의 성채에 들어가기 위한 충분한 친구를 만들었고, 가문의 저명한 대표자들을 소개받았다. 굴러 들어오는 돈이 보인다!')
$kamira_fame[4] = dyneval($vb_cycle_skill, 4, '카미라 가문의 고위 간부와의 우정 덕분에 카미라 가문의 여주인인 티아마트를 알현하고, 얘기를 나눌 수 있었다.')
$kamira_fame[5] = dyneval($vb_cycle_skill, 5, '카미라 가문의 여주인 티아마트가 직접 나를 무리의 일원으로 받아들였다. 이게 무슨 말이냐고? 이제 아무리 어려운 일이 닥쳐도 용의 숨결이 도와줄 것이란 얘기다!')
$kamira_fame[6] = dyneval($vb_cycle_skill, 5, '티아마트는 자기 주문 결과에 만족했다. 하지만 나는 이미 타가문 소속 귀족이기 때문에, 카미라 가문 소속이 될 수는 없다.')

$korvus_fame[0] = dyneval($vb_cycle_skill, 0, '불멸자들은 마치 내가 존재하지 않는 듯이 나를 알아채지 못한다. 만약 내가 코르부스 가문에서 이름을 알리려면, 구울 중 누군가를 내 고객으로 만들어야 한다.')
$korvus_fame[1] = dyneval($vb_cycle_skill, 1, '보통 불멸자는 망자의 무덤에 인간이 정착하는 것을 허락하지 않지만, 나는 가까스로 거주권을 얻어낼 수 있었다. 여전히 코르부스 가문원 대부분은 날 전혀 모르고 있지만.')
$korvus_fame[2] = dyneval($vb_cycle_skill, 2, '코르부스 가문에 지인들이 몇 있지만, 그들은 내가 레이븐 타워에 들어가는데 까지는 영향력을 행사하지 못한다. 가문의 귀족들을 내 고객으로 끌어들여야겠다.')
$korvus_fame[3] = dyneval($vb_cycle_skill, 3, '최고의 노예만 취급한다는 내 소문이 레이븐 타워에도 흘러들어간 모양이다. 이제 까마귀가문의 고위직 불멸자들을 만나야 할 시간이다.')
$korvus_fame[4] = dyneval($vb_cycle_skill, 4, '코르부스 가문의 상원으로부터 승인을 얻어 대공을 직접 알현할 수 있는 기회를 얻었다!')
$korvus_fame[5] = dyneval($vb_cycle_skill, 5, '코르부스 가문의 대공은 나에게 노블 블러드의 작위를 수여했다. 이제 어떤 어려움이 닥쳐도 코르부스 가문은 내 편일 것이다!')
$korvus_fame[6] = dyneval($vb_cycle_skill, 5, '코르부스 가문의 대공은 자기 주문 결과에 만족했다. 하지만 나는 이미 타가문 소속 귀족이기 때문에, 코르부스 가문 소속이 될 수는 없다.')

$brand_fame[0] = dyneval($vb_cycle_skill, 0, '나의 상표는 아직 무명이다. 그렇기 때문에 내 노예의 가치는 아주 낮다. 내 상표의 인지도를 높이기 위해서는 상표 낙인을 찍은 노예들을 여러 명 팔거나 노예들이 시합에서 승리를 해야 한다!')
$brand_fame[1] = dyneval($vb_cycle_skill, 1, '조합 내 모든 상표 중에서 내 상표의 가치가 가장 낮다. 그러나 좋은 노예를 여럿 팔면 금방 나아질 것이다.')
$brand_fame[2] = dyneval($vb_cycle_skill, 2, '상표 인지도가 어느 정도 생겼지만, 노예가 비싸게 팔리려면 한참 멀었다. 내가 파는 상품의 질을 개선할 필요가 있다.')
$brand_fame[3] = dyneval($vb_cycle_skill, 3, '질 좋은 상품을 공급하는 걸로 명성이 높아지고 있다. 엉덩이에 내 상표 낙인이 찍힌 소녀들은 뭔가 특별하다. 그러나 그들만의 리그에 입성하려면 더 노력해야 한다.')
