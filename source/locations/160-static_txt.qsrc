!SOULNET
! JO9 MOD START J9M2537 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$infodata_aura[1] = '[소울넷 터미널]<br>&nbsp;요청 처리 중… 잠시 기다려 주십시오…'
$infodata_aura[2] = '[소울넷 터미널]<br>&nbsp;오라. 모든 지성체의 불멸의 영혼이 만들어 내는 사이코필드의 시각적 발현이다. 특히 불멸의 로마의 영역에서 두드러지며, 기초 계열의 스파크 마법을 통해 분석할 수 있다.'
$infodata_aura[3] = '[소울넷 터미널]<br>&nbsp;안정된 감정과 의식의 특성은 오라 안에서 형상, 색, 크기를 통해 드러나며 분석될 수 있다. 오라를 분석하면 대상의 내적 상태를 파악할 수 있다.'
$infodata_aura[4] = '[소울넷 터미널]<br>&nbsp;오라의 전체적인 밝기와 밀도는 대상의 개인적 힘에 대응한다. 오라의 밝기는 지적 발달, 성격, 개방성, 신체적 힘, 건강, 정신적 강인함 같은 요소의 영향을 받는다.'
$infodata_aura[5] = '[소울넷 터미널]<br>&nbsp;더 강한 오라는 가까운 거리에서 더 약한 오라를 지닌 존재를 억누를 수 있으며, 그 결과 더 약한 대상은 종속적인 태도를 취하게 된다. 다만 이 효과는 절대적이지는 않다.'
$infodata_aura[6] = '[소울넷 터미널]<br>&nbsp;의도적으로 오라의 힘을 키우기 위해서는 특수한 정신마법 증폭 물품이나 그에 상응하는 의식이 자주 사용된다.'
$infodata_aura[7] = '[소울넷 터미널]<br>&nbsp;오라의 안정된 시각 패턴 분류에 대한 정보를 받아보겠습니까?'
! JO9 MOD END J9M2537

! JO9 MOD START J9M2536 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$infodata_aura_patterns[1] = '[소울넷 터미널]<br>&nbsp;오라의 움직임, 형태 변화, 혹은 맥동은 대상의 감정 표현을 나타내는 지표다. 오라의 날카로운 요동은 보통 분노나 성적 욕망의 표시다. 경험이 충분하면 둘은 쉽게 구별할 수 있다.'
$infodata_aura_patterns[2] = '[소울넷 터미널]<br>&nbsp;붉은색은 의식적인 공포를 뜻하며, 오라의 근원 근처에 실제로 존재하는 대상이나 사물을 향하고 있다. 이는 섬광 형태로 나타나며, 공포가 클수록 더 자주, 더 오래 지속된다.'
$infodata_aura_patterns[3] = '[소울넷 터미널]<br>&nbsp;어두운 색은 부정적인 무의식 감정을 뜻한다. 보통 오라의 깊은 부분에서 관찰되며, 증폭되면 뚜렷한 "뱀"이나 "촉수"의 형태로 퍼져 나간다.'
$infodata_aura_patterns[4] = '[소울넷 터미널]<br>&nbsp;오라에서 어두운 하부 구조가 우세하다는 것은 강한 절망감과 희망 상실을 시사한다. 이는 개인의 점진적인 붕괴로 이어질 수 있다: 시간이 지나면 의지와 동기 영역이 파괴되고, 개성은 상실된다.'
$infodata_aura_patterns[5] = '[소울넷 터미널]<br>&nbsp;보라색, 자주색, 혹은 자수정색은 지적 발달 상태에 대응한다. 이 색이 존재한다는 것은 오라의 근원이 가까이 있는 어떤 대상에 대해 강한 견해를 갖고 있음을 뜻한다.'
$infodata_aura_patterns[6] = '[소울넷 터미널]<br>&nbsp;오라 속 자수정색의 또렷한 구체는, 대상이 자기 처지를 분명히 이해하고 있으며 상황에 맞는 태도를 충분히 형성했음을 나타내는 지표다.'
$infodata_aura_patterns[7] = '[소울넷 터미널]<br>&nbsp;길게 늘어진 실이나 막대처럼 형성된 노란색 혹은 금색 하부 구조는 높은 수준의 본능적 규율을 나타낸다. 이는 보통 가까이에 있는 어떤 인간을 무의식적으로 지도자로 인식하고 있음을 뜻한다.'
$infodata_aura_patterns[8] = '[소울넷 터미널]<br>&nbsp;오라 가장자리를 감싸는 푸른 빛은 현재 상황에 익숙하며, 그 상황을 꽤 평범하고 정상적인 것으로 받아들이고 있음을 나타낸다. 변화에 대한 기대가 낮다는 뜻이기도 하다.'
$infodata_aura_patterns[9] = '[소울넷 터미널]<br>&nbsp;오라 바깥 부분의 날카로운 분홍빛 광택은, 가까이에 있는 어떤 사물이나 존재를 부와 사익을 위한 이용 및 조종의 대상으로 인식하고 있음을 시사한다.'
$infodata_aura_patterns[10] = '[소울넷 터미널]<br>&nbsp;별 모양의 녹색 구조는, 개인의 도덕적 선택에 중요한 요인이 되는 대상이나 사물이 존재할 때 형성된다.'
$infodata_aura_patterns[11] = '[소울넷 터미널]<br>&nbsp;이 밖에도 존재 기간이 짧거나 의미가 애매해서 분류와 분석이 잘 되지 않는, 덜 안정적인 다른 구조들도 있다.'
! JO9 MOD END J9M2536



!AUSPEX AURA DESCRIPTIONS
