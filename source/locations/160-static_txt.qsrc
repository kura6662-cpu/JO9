$aura_supermacy[1] = '<font color="#e0640b">노예의 의지</font>는 당신의 장악력보다 <font color="#cd0000">훨씬 강한 상태</font>입니다.'
$aura_supermacy[2] = '<font color="#e0640b">노예의 의지</font>는 당신의 장악력보다 <font color="#C71585">강한 상태</font>입니다.'
$aura_supermacy[3] = '<font color="#e0640b">노예의 의지</font>는 당신의 장악력과 <font color="#0000CD">같은 힘</font>입니다.'
$aura_supermacy[4] = '<font color="#e0640b">노예의 의지</font>는 당신의 장악력보다 <font color="#008080">약한 상태</font>입니다.'
$aura_supermacy[5] = '<font color="#e0640b">노예의 의지</font>는 당신의 장악력보다 <font color="#008000">훨씬 약한 상태</font>입니다.'

$aura_lust[0] = '<font color="#ad0e7b">쾌락의 영혼</font>이 <font color="#008000">천천히</font> 부드럽게 뛰고 있습니다. 별다른 성적욕망을 발견할 수 없습니다.'
$aura_lust[1] = '<font color="#ad0e7b">쾌락의 영혼</font>이 <font color="#008080">가볍게</font> 뛰고 있습니다. 낮은 성적욕망이 보입니다.'
$aura_lust[2] = '<font color="#ad0e7b">쾌락의 영혼</font>이 <font color="#0000CD">상당한</font> 파동을 보이고 있습니다. 강한 성적욕망이 보입니다.'
$aura_lust[3] = '<font color="#ad0e7b">쾌락의 영혼</font>이 <font color="#4B0082">강렬하게</font> 흔들리고, 움찔거리기를 반복하고 있습니다. 욕구불만이 보입니다.'
$aura_lust[4] = '<font color="#ad0e7b">쾌락의 영혼</font>이 <font color="#C71585">관능적으로</font> 파동치며, 펴졌다 구부려졌다를 반복하고 있습니다. 참을수 없는 욕망이 보입니다.'
$aura_lust[5] = '<font color="#ad0e7b">쾌락의 영혼</font>이 반짝이며 <font color="#cd0000">열망하듯</font> 빠르게 돌아가고 있습니다. 터질 것 같은 색욕입니다.'

$aura_fear[0] = '<font color="#960018">두려움의 홍옥</font>은 <font color="#008000">아무 빛도</font> 발하지 않고 있습니다.'
$aura_fear[1] = '<font color="#960018">두려움의 홍옥</font>은 거의 없으며, 1분 동안 <font color="#008080">한 개</font>의 빛 만을 발견했습니다.'
$aura_fear[2] = '<font color="#960018">두려움의 홍옥</font>이 때때로 나타나며, 1분 동안 <font color="#0000CD">한 쌍</font>의 빛을 발견했습니다.'
$aura_fear[3] = '<font color="#960018">두려움의 홍옥</font>이 자주 나타나며, <font color="#4B0082">세 개</font>의 빛이 깜박이고 있습니다.'
$aura_fear[4] = '<font color="#960018">두려움의 홍옥</font>이 일자로 빛나고 <font color="#C71585">네 개</font>의 빛을 빈번히 발산하고 있습니다.'
$aura_fear[5] = '<font color="#960018">두려움의 홍옥</font>이 차례차례 나타나 급속히 뛰는 심장같은 파동을 <font color="#cd0000">다섯 개</font> 이상 만들어냅니다. '

$aura_angst[0] = '<font color="#464451">진회색의 절망</font>은 <font color="#008000">거의</font> 감지할 수 없습니다.'
$aura_angst[1] = '<font color="#464451">진회색의 절망</font>이 <font color="#cd0000">한 개</font>의 촉수처럼 노예의 아우라에 침투하고 있습니다.'
$aura_angst[2] = '<font color="#464451">진회색의 절망</font>이 <font color="#cd0000">두 개</font>의 촉수처럼 노예의 아우라를 양쪽에서 단단히 붙잡고 있습니다.'
$aura_angst[3] = '<font color="#464451">진회색의 절망</font>이 빽빽하게 엉겨붙어 있으며 <font color="#cd0000">세 개</font>의 역겹게 몸부림치는 촉수가 그곳에서 나와 들러붙어 있습니다.'
$aura_angst[4] = '<font color="#464451">진회색의 절망</font>이 커지면서 <font color="#cd0000">네 개</font>의 촉수가 형성되었고, 이 촉수는 모든 방향에서 노예의 아우라를 집어 삼키고 있습니다.'
$aura_angst[5] = '<font color="#464451">진회색의 절망</font>이 크고 역겨운 촉수가 <font color="#cd0000">다섯개</font> 튀어나와 다른 빛들을 찢고 있습니다.'

$aura_rational[0] = '<font color="#B452CD">인식의 자수정</font>은 <font color="#cd0000">어떤 구체도</font> 형태를 이루지 않았습니다.'
$aura_rational[1] = '<font color="#B452CD">인식의 자수정</font>은 응어리져 <font color="#C71585">한 개</font>의 아주 작은 방울로 형성되고 있습니다'
$aura_rational[2] = '<font color="#B452CD">인식의 자수정</font>은 <font color="#4B0082">두 개</font>의 밀접히 붙어있는 작은 방울로 형성되어 있습니다.'
$aura_rational[3] = '<font color="#B452CD">인식의 자수정</font>은 <font color="#0000CD">세 개</font>의 중간 크기의 구상체로 형성되어 있습니다.'
$aura_rational[4] = '<font color="#B452CD">인식의 자수정</font>은 <font color="#008080">네 개</font>의 크고 단단한 구상체로 빽빽하게 형성되어 있습니다.'
$aura_rational[5] = '<font color="#B452CD">인식의 자수정</font>은 최소한 <font color="#008000">다섯 개</font> 이상의 잘 형성된 구상체로 중심부를 차지하고 있습니다.'

$aura_instinct[0] = '<font color="#9e8e00">사육의 금빛 실</font>은 아직 <font color="#cd0000">형성되어 있지 않습니다</font>.'
$aura_instinct[1] = '<font color="#9e8e00">사육의 금빛 실</font>은 거의 형성되어 있지 않습니다. 단지 <font color="#C71585">한 개</font>의 강렬한 금색 끈만 보입니다.'
$aura_instinct[2] = '<font color="#9e8e00">사육의 금빛 실</font>은 여기저기에서 보입니다. 그 중에 <font color="#4B0082">두 개</font>의 강렬한 금색 끈을 발견했습니다.'
$aura_instinct[3] = '<font color="#9e8e00">사육의 금빛 실</font>은 많은 곳에서 보입니다. 특히 <font color="#0000CD">세 개</font>의 강렬한 금색 끈을 발견했습니다.'
$aura_instinct[4] = '<font color="#9e8e00">사육의 금빛 실</font>은 모든 곳에서 보입니다. <font color="#008080">네 개</font>의 밝은 고리가 아우라의 주위에 둘러져 있습니다.'
$aura_instinct[5] = '<font color="#9e8e00">사육의 금빛 실</font>은 노예의 아우라를 벌집모양으로 <font color="#008000">완전히</font> 속박하고 있습니다.'

$aura_custom[0] = '<font color="#082567">습관의 청옥</font>이 <font color="#cd0000">전혀 나타나지 않습니다</font>.'
$aura_custom[1] = '<font color="#082567">습관의 청옥</font>이 오직 <font color="#C71585">한 곳</font>에서 둔중하게 빛나고 있습니다.'
$aura_custom[2] = '<font color="#082567">습관의 청옥</font>이 어슴푸레하게 <font color="#4B0082">두 개</font>의 장소에 표시됩니다.'
$aura_custom[3] = '<font color="#082567">습관의 청옥</font>이 안정적으로 <font color="#0000CD">세 지점</font>에 집중되어 있습니다.'
$aura_custom[4] = '<font color="#082567">습관의 청옥</font>이 <font color="#008080">네 곳</font>에서 뻗어나와 노예의 표면을 지나고 있습니다.'
$aura_custom[5] = '<font color="#0000a0">습관의 청옥</font>이 몽롱한 실안개처럼 노예의 <font color="#008000">전체 아우라</font>를 감싸고 있습니다.'

$aura_spoil[0] = '<font color="#EE1289">무지개빛 응석</font>은 <font color="#008000">전혀</font> 보이지 않습니다.'
$aura_spoil[1] = '<font color="#EE1289">무지개빛 응석</font>이 <font color="#cd0000">한 곳</font>에 모여 있으며, 역겨운 구멍을 형성하고 있습니다.'
$aura_spoil[2] = '<font color="#EE1289">무지개빛 응석</font>이 <font color="#cd0000">두 곳</font>에 혐오스러운 상처를 형성하고 있습니다.'
$aura_spoil[3] = '<font color="#EE1289">무지개빛 응석</font>이 <font color="#cd0000">세 곳</font>에 끔찍한 상처를 형성하고 있습니다.'
$aura_spoil[4] = '<font color="#EE1289">무지개빛 응석</font>이 <font color="#cd0000">네 곳</font>에 추악한 궤양을 형성하고 있습니다.'
$aura_spoil[5] = '<font color="#EE1289">무지개빛 응석</font>이 <font color="#cd0000">모든 부위를</font> 깊숙히 파고들어, 피로 물든 반점처럼 찍혀있습니다.'

$aura_moral[0] = '<font color="#008080">헌신의 취옥</font>은 <font color="#cd0000">어느 곳에서도</font> 찾아볼 수 없습니다.'
$aura_moral[1] = '<font color="#008080">헌신의 취옥</font>이 오직 <font color="#C71585">하나</font>의 별처럼 희미하게 반짝이고 있습니다.'
$aura_moral[2] = '<font color="#008080">헌신의 취옥</font>이 <font color="#4B0082">두개</font>의 부드럽게 빛나는 별을 형성하고 있습니다.'
$aura_moral[3] = '<font color="#008080">헌신의 취옥</font>이 <font color="#0000CD">세개</font>의 눈에 띄는 별처럼 빛나고 있습니다.'
$aura_moral[4] = '<font color="#008080">헌신의 취옥</font>이 <font color="#008080">네개</font>의 별이 되어 영롱하게 반짝이고 있습니다.'
$aura_moral[5] = '<font color="#008080">헌신의 취옥</font>이 노예의 아우라를 지배하고 있으며, <font color="#008000">수많은</font> 별처럼 밝고 뚜렷하게 보입니다.'



