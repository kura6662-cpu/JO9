! JO9 MOD START J9M2553 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$magister_vailos_quest[1] = '[술사 발리오스]<br>&nbsp;위대한 지식에 기여하고 싶은 생각 없나, 필멸자여? 뭐? 없다고?.. 하아.. 뭐, 그렇겠지... 인간들은 그들의 짧고 빡빡한 삶을 살면서 가장 중요한 것을 생각하느라 바쁘니까.</div>'
$magister_vailos_quest[2] = '[술사 발리오스]<br>&nbsp;하지만 말이네, 이건 자네에게도 좋은 얘기야. 노예상인인 자네가 가치 있는 삶을 살기 위해 노력하는 동안, 나는 기꺼이 그 삶이 더 즐겁게 느껴지게끔 할 수 있지. 우선, 안개 지역에서 촉수괴물과 마주친 적 있나?</div>'
$magister_vailos_quest[3] = '[술사 발리오스]<br>&nbsp;나는 그 안개 괴물이라는 것 때문에 당신 같은 인간들이 많이 죽고 있다는 소식을 들은 적이 있지. 이 생명체는 안개 속에서 노예를 임신시키는데, 이 안개 괴물의 애벌레가 노예의 몸을 갉아먹으면서 태어나는 것이라네.</div>'
$magister_vailos_quest[4] = '[술사 발리오스]<br>&nbsp;멍청한 노예 상인들은 이렇게 노예가 죽으면 손해만 보지. 똑똑한 노예 상인은 이 생명체를 아주 잘 활용한다네. 안개 괴물의 애벌레는 무척 유용하기 때문에, 그걸 잡아서 지하실에 가두고 키우면, 그 괴물이 토해내는 엄청난 정액을 이용해서 노예를 먹이고 식비도 절약할 수 있지. 자네는 똑똑한 노예상으로 보이는데... 안그런가?</div>'
$magister_vailos_quest[5] = '[술사 발리오스]<br>&nbsp;내가 그 안개 괴물을 얻게되면 연구에 아주 큰 도움이 될 거라네. 다만 살아있어야 하고, 건강하고, 완전히 성장한 괴물이 필요한게 문제지. 아직 덜 자랐거나, 너무 작아서 죽어버린거면 안되네.</div>'
$magister_vailos_quest[6] = '[술사 발리오스]<br>&nbsp;물론 이 일이 쉽지 않다는 건 잘 알고 있지. 그리고 그게 자네의 주요 관심사가 아니란 것도 말이네. 하지만, 나는 스파크보다도 훨씬 더 값진 것을 가지고 있다네. 내가 만든 장신구는 자네와 같은 사람이이 일하는데 있어 매우 유용할 것이야.</div>'
$magister_vailos_quest[7] = '[술사 발리오스]<br>&nbsp;나는 이것을 «큰까마귀 관» 이라 부르고 있지! 한 번 착용하면, 자네는 항상 다른 이들의 아우라를 볼 수 있게 되기 때문에, 마법을 쓰는데 필요한 시간과 돈을 아낄 수 있지!</div>'
$magister_vailos_quest[8] = '[술사 발리오스]<br>&nbsp;그 뿐만이 아니라네. 이 장신구는 아우라를 더 강력하게 만들어 줄 것이고, 심지어 다른 사람들도 자네의 아우라가 강해져 위엄과 위대함을 느끼게 될 거라네!</div>'
$magister_vailos_quest[9] = '[술사 발리오스]<br>&nbsp;그러니, 관심있으면 안개 괴물을 최대로 성장시켜 여기있을 나를 찾아오게. 나는 종종 이 집회장에 있을 것이라네. 이곳이 사색하긴 좋은 장소이니.</div>'
! JO9 MOD END J9M2553

! JO9 MOD START J9M2552 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$garsid_quest[1]<br> = '[임신마 가르시드]<br>&nbsp;거기, 남자. 엿키로 와. 네가 음믐믐탕한 년을 지도하나? 아, 인닌닝간 차찿창녀는 좋아. 보드랍고 쉽게 임신. 단지 쎾쓰치는 법 모를뿐.</div>'
$garsid_quest[2]<br> = '[임신마 가르시드]<br>&nbsp;난 듣들었어, 멋진 거걱시기 가진 것들이 조촟좋은 창녀 만든다고. 큰데 그런건 비싸. 어. 무척 비싸. 우뭄우리한텐 아니지... 그걸 햏해보겠써.</div>'
$garsid_quest[3]<br> = '[임신마 가르시드]<br>&nbsp;난 명품 필요없어. 심지어 암뭄무것도 못해도, 상관 어음써. 또 생긱낀건... 생기낀 것 상관 없어, 다 비스비쓰태.</div>'
$garsid_quest[4]<br> = '[임신마 가르시드]<br>&nbsp;그래도 눈눈누구보다 잘 쳐야돼! 몸몸모든 방면! 아무와든, 어디서든, 자세든, 국쿸쿠멍이든. 이게 좋은 창녀가 카캊갖출 소양. 그러니까 남자가 찾찿잘 해야지.</div>'
$garsid_quest[5]<br> = '[임신마 가르시드]<br>&nbsp;가캊, 캊갖져와 와완벽한 쎋쏐쎾쓰 켇계집노예. 그럼 귁귁귀여운 걸 주지. 마법, 그래. 나난나낟처럼 되지. 바밥반시간 쎿쓰 정도로 아앙안죽지. 겨격결코 쓰러지지 않아, 쳐쳦쳐지지 않아.</div>'
$garsid_quest[6]<br> = '[임신마 가르시드]<br>&nbsp;계켘켸집도 더 느껴. 아주 몹시. 넨네 여영영혼 힘으로도 제압 가능하지. 하물며 전투에도, 피핖피가 말려 들어갈거야. 삳상처따위 위험하지 않아.</div>'
$garsid_quest[7]<br> = '[임신마 가르시드]<br>&nbsp;좋은 제쳋제안이지. 진귀한거. 누구도 갗가질수 없는. 가르시드가 주지. 집회장에 와. 계켘계집 데리고 와. 쿄굑교환하자.</div>'
$wujen_quest[1]<br> = '[현명한 부셴]<br>&nbsp;반갑군 젊은이. 대답해보게, 경주를 좋아하는감? 난 좋아하네만. 그 육체들, 땀에 젖어 빛나는, 탄탄한 근육질에, 흥분에 젖은 ... 내 실토하지, 난 아주 노름꾼이야. 우리 계통은 각자 공모자가 있어.</div>'
$wujen_quest[2]<br> = '[현명한 부셴]<br>&nbsp;거기서 단지 자네가 알아줘야 할 건, 난 나만의 경주 챔피언이 필요해! 하지만 거의 몽환일 뿐 이었지. 판매자들은, 해가 걸려도 벌기 힘들 댓가들을 요구했어. 난 이 도시에 살기만도 벅차고.</div>'
$wujen_quest[3]<br> = '[현명한 부셴]<br>&nbsp;그래서 내 아주 특별한 제안을 하나 하지. 요행을 위한 요행으로. 사실 뱀자리 쪽이 달갑지는 않지만, 충심을 원하시면 내가 더 보여야지. 그게 옳겠지?</div>'
$wujen_quest[4]<br> = '[현명한 부셴]<br>&nbsp;우리 지도자들은 항상 <b>특별한 목걸이</b>를 착용해. 개인의 성질과 힘, 인격을 드높여 주는 목걸이. 난 그 목걸이 제작 비결을 아는 유일한 사람이고.</div>'
$wujen_quest[5]<br> = '[현명한 부셴]<br>&nbsp;목걸이 소지자는, 전투 속 고통과 두려움에 매우 저항하게 되지. 또한 주변인들 눈에 띄는 힘을 갖추게 되네. 아우라는 훨씬 강력해짐과 동시에, 아우라를 훔쳐보려 하는 자들의 시야도 완벽하게 차단해주지.</div>'
$wujen_quest[6]<br> = '[현명한 부셴]<br>&nbsp;이런 목걸이는 구매 불가능해. 그래도 콜로세움 경주에 승리한 노예라면, 내가 교환해줄 수도 있지. 자네가 관심 있으면 이 집회장에서 날 찾게, 곧잘 오니까.</div>'
$aramus_quest[1]<br> = '[아라무스 경]<br>&nbsp;거기! 그대. 그래 당신. 여기 와주지 않겠나. 딱 그대 나이대 남성에 내 제의할 것이 있어, 상호간 이익이 될 만한. 흥미있나?</div>'
$aramus_quest[2]<br> = '[아라무스 경]<br>&nbsp;들어주게. 혹 그대, 타우루스 가문이 비밀리에 투사 경기 개최함을 아는가? 콜로세움과 방식은 같지만, 오직 우리 가문원들만의 경기이지. 장소는 더 가깝고 관중하기도 편하지. 무엇보다 저가표는 발매 않고.</div>'
$aramus_quest[3]<br> = '[아라무스 경]<br>&nbsp;행여 내게 승리를 안겨줄, 많이 안겨줄 노예만 얻으면... 형제여, 여긴 노다지야! 아레나 챔피언이 필요해. 무조건. 어 뭐, 그것의 일반 거래가 스파크는 갖고 있지 않지만.</div>'
$aramus_quest[4]<br> = '[아라무스 경]<br>&nbsp;기다려, 기다려봐 형제여. 돌아서지 말게. 스파크는 어디서든 얻을 수 있잖은가. 게다가 무얼 제의할지는, 날 돕지않고 들은 것 만으론 볼 수가 없어. 그래. 이제서야 흥미가 좀 생기나, 엉?</div>'
$aramus_quest[5]<br> = '[아라무스 경]<br>&nbsp;저 안에선 내가 특수 군사 시설에 접근할 수 있어. 하, 알테지. 바로 이 주변의 괴수, 불사자, 그 엿같은 기술력으로 무장한 미친놈들. 우리는 어떻게든 그 수준에 맞춰가야해.</div>'
$aramus_quest[6]<br> = '[아라무스 경]<br>&nbsp;아레나 챔피언 노예만 데려와 줘, 그럼 내가 <b>황소 반지</b>를 획득해다 줄테니. 평범한 반지 모양이지, 하지만 전투에서 자넨 두 배나 튼튼해진다구. 자네 인상의 압박감은 물론 아우라의 힘도 증대시켜 줄거야.</div>'
$aramus_quest[7]<br> = '[아라무스 경]<br>&nbsp;신중히 생각해, 난 서두르지 않을테니. 알맞는 여자만 있으면, 바로 집회장으로 데려와 줘. 그럼 같은날에 그 고리를 얻어다 줄게. 수쓰지 않을테니 걱정은 말고. 이제 떠나게, 어울리는게 띄면 좋지 않아.</div>'
! JO9 MOD END J9M2552



!MYSTRA
! JO9 MOD START J9M2551 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$mystra_spd[0] = '<br> 미스트라는 비록 많은 상품을 제공하지만, 당신은 그것들 중 연금술에 이용될 수 있는 네가지 재료에만 관심이 있다. : <b>삼나무 진액</b> - 기분 변화. <b>낙원의 독말풀</b> - 진정과 이완감. <b>요정의 가루</b> - 강력한 자극. <b>망각의 정수</b> - 고통과 두려움 배제.'
! JO9 MOD END J9M2551
$mystra_spd[1] = '<br> 낙원의 독말풀은 강하지 않은 흡연물로, 널리 서식한다. 향정신성 약물로썬 꽤 효과가 크다. 그 이완감과 진정이, 붕 뜨는 것처럼 특별한 감각을 준다. 하지만 과용하면 지성이 떨어진다고 한다.'
$mystra_spd[2] = '<br> 삼나무 진액은 강장 효과를 가진 끈적한 검은 액체를 만드는데 쓰인다. 음용이 가능하지만, 마법 없이는 바르게 다루지 못한다고 알려져있다. 맛은 꽤 쓴데, 많은 사람들이 이 진액을 매일 아침마다 마시곤 한다. 한 번 중독되면 이거 없인 잘 못일어난다고...'
$mystra_spd[3] = '<br> 요정의 가루는 요정의 날개에서 채취한 것이고, 잇몸에 문지르거나 코로 흡입한다. 강력한 흥분과 함께 엄청난 활력을 선사해주지만, 신체적인 내상을 주며, 장기적으로는 건강에 극히 나쁘다.'
$mystra_spd[4] = '<br> 망각의 정수는 아주 간사한 물질로, 불운하거나 약해빠진 영혼들을 죽여왔다. 피에 섞으면, 모든 고통과 고뇌를 없애주고 헤어나올 수 없는 순수한 쾌락을 가져다준다. 한 번 빠져들면, 더이상 거부하는 것은 불가능하다.'
$mystra_spd[5] = '<br> 미스트라가 특별 제작한 비약이다. 심각하게 비싼 가격인데 그만한 가치가 있길 바란다...'

! JO9 MOD START J9M2550 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$elixir_help[1] = '[미스트라]<br>&nbsp;저는 몸과 영혼에 영향을 주는 많은 물질들을 판매해요.전부 위험하고 음해까지도 가능한 것들이죠. 중독되고, 내재된 파괴심을 불러일으켜요.대부분은 미미하지만, 그 외에는 중국 가게에서 하마님 은총이나 받고있죠.</div>'
$elixir_help[2] = '[미스트라]<br>&nbsp;연금에는 창조의 불꽃 스파크 힘을 사용해요. 그걸 더 강력하고 안전한 무언가로 바꾸는 거죠. 간단한 예로, 적당한 자극을 주어 몸에 축적된 힘을 끌어온다던가. 하지만 영약별 효과는 상이해요.</div>'
$elixir_help[3] = '[미스트라]<br>&nbsp;영약을 직접 제조하고 싶은거라면, 특별 장비가 갖춰진 <b>연금실</b>이 필요해요. 약물 지식이 있는 누군가도 필요하구요.저에게서 각 재료들도 사가셔야 할 거에요.</div>'
$elixir_help[4] = '[미스트라]<br>&nbsp;항상 뼈대로 쓸 기본 재료를 넣고, 거기에 첨가물을 넣는 방식이에요. 약한 영약들은 물약으로도 주조 가능해요. 대게 주류도 통하구요.하지만 강한 영약들은 오로지 안개 괴물의 점액질로만 만들 수 있어요.</div>'
$elixir_help[5] = '[미스트라]<br>&nbsp;연금자는 약물의 성분을 반드시 정량으로만, 또 스파크를 일깨워 사용해야 해요. 주조자 경험이 충분하지 않을시엔 모든 제조법이 엉망이 될거에요.그럼 맛없는 술찌끼나 남을테죠. 뭐 아니면, 비릿한 식물성 애액이나요.</div>'
$elixir_help[6] = '[미스트라]<br>&nbsp;모든 과정이 알맞게 진행되면, 확실한 마법 성분을 얻게되죠. 만들어 달라고만 마세요. 난 연금실도 없고, 그저 재료 판매상이니까요.</div>'
! JO9 MOD END J9M2550

! JO9 MOD START J9M2549 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$bahus_help[1] = '[미스트라]<br>&nbsp;물약에 1.요정의 가루 2.삼나무 진액 3.망각의 정수 순으로 넣어 양조하세요. 그럼 영약중에 가장 간단한 영약 완성이에요. </div>'
$bahus_help[2] = '[미스트라]<br>&nbsp;이 즙은 신성한 맛이 있고 술과 같은 강한 취기를 가져와요. 하지만 매우 부드러운 넘김이죠. 동시에 육체적 갈망 또한 일깨워요.</div>'
! JO9 MOD END J9M2549

! JO9 MOD START J9M2548 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$tonic_help[1] = '[미스트라]<br>&nbsp;주류에 1.요정의 가루 2.삼나무 진액 3.망각의 정수 순으로 넣어 양조하세요. 힘을 즉각 회복시켜 주는 유용한 강장제를 얻을 거에요.</div>'
$tonic_help[2] = '[미스트라]<br>&nbsp;이 강장제는 정말 굉장하지만 사용에 주의해야 해요. 과용은 끔찍함만 쌓여갈거에요.</div>'
! JO9 MOD END J9M2548

! JO9 MOD START J9M2547 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$cure_help[1] = '[미스트라]<br>&nbsp;점액질에 1.요정의 가루 2.삼나무 진액 3.망각의 정수 순으로 넣어 양조하세요. 그럼 기적의 향유를 얻을거에요.</div>'
$cure_help[2] = '[미스트라]<br>&nbsp;상처를 금방 입은 상태라면, 말끔히 나을거에요. 그래서 보통 전투에서 즉각 사용하죠. 하지만 시간이 지난 상처에도 쓸만할거에요.</div>'
! JO9 MOD END J9M2547

! JO9 MOD START J9M2546 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$afro_help[1] = '[미스트라]<br>&nbsp;주류에 1.삼나무 진액 2.요정의 가루 3.낙원의 독말풀 순으로 넣어 양조하세요.감각을 각성시키는 최음제를 얻게되죠.</div>'
$afro_help[2] = '[미스트라]<br>&nbsp;양조될 최음제의 효과는 양조자의 기술력, 음용자의 연금 능력에 영향 받아요.<b>물약</b>으로는 절대 만들 수 없는걸 명심하세요.</div>'
! JO9 MOD END J9M2546

! JO9 MOD START J9M2545 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$letha_help[1] = '[미스트라]<br>&nbsp;주류에 1.삼나무 진액 2.낙원의 독말풀 3.망각의 정수 순으로 넣어 양조하세요. 저승의 강물이라 불리우는 아주 위험한 영약을 얻을거에요.어떠한 뼈대 재료와도 맞아요. 물약으로도 충분하죠.</div>'
$letha_help[2] = '[미스트라]<br>&nbsp;저승의 강물은 죽은 자들의 세계에 있는 강물이에요. 음용자는 이승에서 가졌던 모든 근심과 열정들을 잊어버리게 돼요.음용자가 전부 잊는다는 걸 꼭 유념하세요. 좋든, 나쁘든 모조리.</div>'
! JO9 MOD END J9M2545

! JO9 MOD START J9M2544 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$morpot_help[1] = '[미스트라]<br>&nbsp;점액질에 1.망각의 정수 2.낙원의 독말풀 3.요정의 가루 순으로 넣어 양조하세요. 그럼 순애의 미약을 얻게돼요.</div>'
$morpot_help[2] = '[미스트라]<br>&nbsp;음용자는 무의식적 영향을 받아요. 음용 후 처음본 사람을 열망하게 되죠. 효과가 강하다곤 말 못 하지만, 깊다고 할 순 있죠.</div>'
! JO9 MOD END J9M2544

!potion of mystra (픽스)
! JO9 MOD START J9M2543 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$mystra_help[1] = '[미스트라]<br>&nbsp;음용자의 부정적인 마음에만 변화를 줘요. 저승의 강물에서 긍정적인 부분만 남기기 위한 많은 노력이 들어가 많이 비싸답니다.</div>'
$mystra_help[2] = '[미스트라]<br>&nbsp;하지만 지금은 이 비약을 만들 촉매가 부족해서 못만들고 있어요. 안개의 영역에서 볼 수 있는 와그의 어금니가 있다면...</div>'
! JO9 MOD END J9M2543

!potion of mystra material quest (픽스)
$mystra_event[1] = '<br> 나는 와그의 어금니를 가지고 미스트라를 찾아 갔다.'
! JO9 MOD START J9M2542 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$mystra_event[2] = '[미스트라]<br>&nbsp;이 건 비약을 만드는 데 있어 꽤나 뛰어난 촉매제네요. 제게 이걸 준다면, 특별한 비약을 구매할 수 있게 해드리죠.</div>'
$mystra_event[3] = '[<<$master_name>>]<br>&nbsp;그냥 주는게 아니라?</div>'
$mystra_event[4] = '[미스트라]<br>&nbsp;이건 그저 촉매일 뿐, 실제로 비약에 들어가는 재료는 무척 많거든요. 그래도 이 약을 사용해보면, 분명 마음에 들겁니다.</div>'
! JO9 MOD END J9M2542

!BALALAIKA
! JO9 MOD START J9M2541 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$smuggler_info[1] = '[발랄라이카]<br>&nbsp;이 병신같은 도시에선 거의 모든것이 용납되지. 약물, 무기, 보석에서 예술품까지. 이 모든 것이 그 가문님들 지휘하에 안개에서 흘러들어와.</div>'
$smuggler_info[2] = '[발랄라이카]<br>&nbsp;하지만 살아있는 것을 수입하는건 엄격하게 금지, 바티칸의 기본 법률이지. 가문들도 이해는 하고 있어. 다만 안개를 통해서 전이자가 수도없이 들어오다 보니까, 골치가 아픈거지.</div>'
$smuggler_info[3] = '[발랄라이카]<br>&nbsp;그래도 머리가 있으면, 안개를 뚫는 방법은 얼마든지 있다고. 다만 그럴지라도, 수용할 공간이 남아나질 않는건 마찬가지. 그래서 가문들과 다른 권력의 중심들, 당신네 조합도 포함해 이 법률을 지지하지.</div>'
$smuggler_info[4] = '[발랄라이카]<br>&nbsp;덕택에 수송선 객실마다 아주 꼼꼼하게 검사받아. 그러니 살아있는 생물체를 수송할 순 없지. 그래도 안개를 걸어서는 운반할 수 있어. 느리고 또 위험해도, 거의 들키지는 않지.</div>'
$smuggler_info[5] = '[발랄라이카]<br>&nbsp;그럼 다음 떠오르는 의문점. 어떻게 성벽을 뚫고 내부로 밀수해 옮기느냐. 하지만 당신에겐 쉬운 질문이겠네. 사람은 안되겠지만, 진짜 돼지라면 어떨까?</div>'
$smuggler_info[6] = '[발랄라이카]<br>&nbsp;똑똑히 말해줄게. 배달하는 생 돼지는 매우 고가로 취급되지. 인육을 마다하는 소수들은, 신선한 고기 먹으려고 가격 따윈 신경쓰지 않거든. 당신은 상상도 못 할걸. 이제 들어가는 방법에 대한 설명은 끝.</div>'
$smuggler_info[7] = '[발랄라이카]<br>&nbsp;아-아 어쨌든 이해했겠지? "만들어진" 노예 수입을 조합이 <b>격하게</b> 승인하지 않는 것 말야. 그냥 들어오는 걸로도 처치곤란인데, 제품까지 수입하기 시작하면 노예 가격이 바닥을 쳐 당신 조직이 끝장날테니까.</div>'
$smuggler_info[8] = '[발랄라이카]<br>&nbsp;물론 조합이 졸렬하다고 해서, 누구 조합원 한명이 잘못해서 그렇게 된 건 아닐거야. 하지만 그래도 그런걸 필요로 하는 사람들이 있단 말이지. 누구라고 말은 안하겠지만, 이미 많은 사람이 여기를 찾아오니까 말이야.</div>'
$smuggler_info[9] = '[발랄라이카]<br>&nbsp;실은 우리가 거래하는 여러 세계중에, 인공 인간을 만들어내는 거대 기업이 있어. 거기서 만든 "제품"은 복제되어서 빠르게 자라나. 그 뒤엔 최면 작업으로 과거 기억을 도입하면 충분.</div>'
$smuggler_info[10] = '[발랄라이카]<br>&nbsp;당신이 해야할 건 상표를 새기고 좋은 가격에 파는 것. 배달같은 복잡한 과정은 여기서 해결해. 단, 그 과정까지만 내가 도울거고.</div>'
$smuggler_info[11] = '[발랄라이카]<br>&nbsp;우리가 그것들의 품질은 보증하지. 더욱이 노예시장이 원하는 기본 기술수준 또한 포함되어 있어. 그만큼 수면훈련 작업을 최대한 많이 하거든.</div>'
$smuggler_info[12] = '[발랄라이카]<br>&nbsp;기본 성능지표 또한 우수, 우리 기술자들이 분명히 하니까. 노예의 매력적 외모나 건강한 육체, 신경계통 균형과 기초적 지성까지도.</div>'
! JO9 MOD END J9M2541
$smuggler_info[13] = '[발랄라이카]<br> 그리고 내가 장담할 수 있는건, 그 여체들은 아무런 질병과 감염이 없는 완전한 처녀라는 거지. 종류는 세개 있어. 아동, 아가씨, 그리고 성인.</div>'
! JO9 MOD START J9M2540 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$smuggler_info[14] = '[발랄라이카]<br>&nbsp;구입후 따로 해야할 건 없지만, 만약에 길드에게 걸렸다고 해서 나에게 찾아오진 마. 물어주는 것 따윈 없으니까.</div>'
$smuggler_info[15] = '[발랄라이카]<br>&nbsp;가격은 상품 당 <b>2000 스파크</b>. 경매장에선 훨씬 고가에 팔릴테니, 우리 모두가 남는장사 아니겠어? 상표 새기는 것만 잊지마.</div>'
! JO9 MOD END J9M2540



!AUCTION
! JO9 MOD START J9M2539 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$auction_start = '<font color="#660000"> [잡파]<br>&nbsp;좋은 날입니다, 친애하는 여러분! 자, 자, 정숙해 주세요. 상표가 아직 새겨지지 않은 노예를 곧 경매하겠습니다. 안개가 우리에게 흥미로운 것들을 많이 가져왔습니다. 시대와 공간을 초월해 각지에서 온 아름답고, 건강하고, 생기있는 소녀들이 준비되어있습니다! 보시면 바로 아실 겁니다, 부디 스파크를 너무 아끼지는 마시기 바랍니다!</font>'
$auction_buy_player_bets[1] = '<font color="#660000"> [잡파]<br>&nbsp;아하! 여기 조합을 대표해서 입찰하시는 분이 계시는 군요. 자, 저런 분이 찍은 노예니까 반드시 뭔가 특별할 겁니다. 더 부르실 분 안 계십니까? 불러보세요!</font>' 
$auction_buy_player_bets[2] = '<font color="#660000"> [잡파]<br>&nbsp;존경받는 조합원이 입찰했습니다. 더 부르실 분? </font>'
$auction_buy_player_bets[3] = '<font color="#660000"> [잡파]<br>&nbsp;낙찰될 것 같군요! 당연히 여러분들은 이런 맛있는 먹거리를 놓칠 분들이 아닐겁니다. 그렇지만 조금 더 가격이 나갈 수도 있을 것 같군요. 다음 응찰자 분? </font>'
$auction_buy_player_bets[4] = '<font color="#660000"> [잡파]<br>&nbsp;정말! 노예 조합은 쉬지도 않는군요. 그렇지 않습니까! 자! 이 전문가보다 더 높은 금액을 제시할 분은 어디 계십니까? 저 사람 눈썰미가 보통이 아니랍니다. 저 소녀는 분명히 가치가 클 겁니다! 여러분의 입찰을 기다리고 있습니다.</font>'
$auction_buy_player_bets[5] = '<font color="#660000"> [잡파]<br>&nbsp;아하! 새로운 가격이군요. 올리겠습니다. 이제 과연 누가 더 높은 가격을 부를까요?</font>'
! JO9 MOD END J9M2539


$auk_add[1] = '<font color="#660000">어떤 분이 더 높은 금액을 부르시겠습니까?</font>'
$auk_add[2] = '<font color="#660000">얼마나 훌륭한 상품인지를 보십시오!</font>'
$auk_add[3] = '<font color="#660000">지금 5 스파크를 더 올리라고 들은 것 같은데, 아닌가요?</font>'
$auk_add[4] = '<font color="#660000">조금만 더 용기 내 보세요, 여러분!</font>'
$auk_add[5] = '<font color="#660000">이런 멋진 노예를 구할 수 있는 기회를 놓치지 마세요!</font>'
$auk_add[6] = '<font color="#660000">입찰하세요! 지금 새로운 입찰을 기다리고 있습니다.</font>'
$auk_add[7] = '<font color="#660000">정말 싼 가격이군요! 좋은 상품을 저렴한 가격에 살 수 있는 절호의 기회입니다!</font>'
$auk_add[8] = '<font color="#660000">과연 누가 스파크를 살짝 더 쓸까요? 정말 조금이면 됩니다!</font>'
$auk_add[9] = '<font color="#660000">자 여러분, 이제 마음의 결정을 하십시오! 시간이 얼마 남지 않았습니다!</font>'


! JO9 MOD START J9M2538 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$rival_stake[1] = '[뚱뚱한 흑인]<br>&nbsp;거기, 너! 한 번 돌아봐, 다리 벌리고, 숙여. 음... 엉덩이 죽이네. 나 얘 살래!</div>'
$rival_stake[2] = '[방탕한 중년남자]<br>&nbsp;내 쪼그라든 열정을 다시 불태우기에 딱이군, 헤헤...</div>' 
$rival_stake[3] = '[담배를 뻐금대는 중년부인]<br>&nbsp;이 소녀, 나와 부엌에서 야한 짓하기에 적당한 것 같네요.</div>'
$rival_stake[4] = '[못생긴 난쟁이]<br>&nbsp;입찰가 올리겠소! 그 귀여운 얼굴이 내 다리 사이에 잘 어울릴 것 같네, 하하!</div>'
$rival_stake[5] = '[귀족 대리인]<br>&nbsp;내 고객 이름으로 더 올리겠소! 저런 물건이 있으면 낙찰받아오라고 했소.</div>'
$rival_stake[6] = '[조합의 경쟁자]<br>&nbsp;입찰가 올리겠소! 조교하기 좋은 재료군.</div>'
$rival_stake[7] = '[침흘리는 짐승족]<br>&nbsp;(침 튀기며) 이봐! 내가 그 년을 사겠어. 임신시켜서 건강한 강아지들을 낳게 할거야.</div>'
$rival_stake[8] = '[코트 입은 이방인]<br>&nbsp;(입찰가를 올리려는 듯이 손을 올린다)</div>'
$rival_stake[9] = '[창백한 뱀파이어]<br>&nbsp;아하아아아... 따뜻한 심장박동이 느껴지는군.</div>'
$rival_stake[10] = '[털북숭이 도살업자]<br>&nbsp;좋은 햄거리군, 확실해! 어이 경매사, 내 입찰가 올려줘.</div>'
$rival_stake[11] = '[마스크 쓴 여자]<br>&nbsp;(입찰가를 올리려는 듯이 손을 올린다)</div>'
$rival_stake[12] = '[흉터 있는 기사]<br>&nbsp;내 침대를 덥힐 때 필요한 게 바로 저거야!</div>'
$rival_stake[13] = '[대머리 생체해부학자]<br>&nbsp;오랜 시간 해부해도 견뎌 낼만한 물건이군, 바로 내가 필요했던 거야.</div>'
$rival_stake[14] = '[배고픈 여자 뱀파이어]<br>&nbsp;(송곳니를 핥으며) 더 이상 못 참겠어. 이렇게 달콤하다니, 냄새가 여기까지 나...</div>'
$rival_stake[15] = '[송곳니가 튀어나온 짐승족]<br>&nbsp;내꺼야! 내꺼! 어디 한 번 가격 올려봐, 이 약골들아. 내가 갈가리 찢어 줄 테니!!!</div>'
$rival_stake[16] = '[뚱뚱한 흑인]<br>&nbsp;이봐, 잡파! 저런 애가 나한텐 쓸모 있어!</div>'
$rival_stake[17] = '[방탕한 중년남자]<br>&nbsp;늙은 아저씨의 차가운 침대를 데워 줄 어린 피라니. 헤헤..헤...</div>'
$rival_stake[18] = '[담배를 뻐금대는 중년부인]<br>&nbsp;아이참, 농담이었어요! 저 아이는 부엌에서 날 돕게 할 거예요. 설거지 시킨다구요.</div>'
$rival_stake[19] = '[못생긴 난쟁이]<br>&nbsp;저 년에게 진짜 남자의 맛을 보여줘야지. 이봐, 날 봐. 내가 네 새 주인이다. 알겠나?!</div>'
$rival_stake[20] = '[귀족 대리인]<br>&nbsp;후원자 이름으로 입찰가 올리겠소! 그가 찾던 바로 그 상품이군.</div>'
$rival_stake[21] = '[조합의 경쟁자]<br>&nbsp;이 정도 물건이면 좋은 상품이 되겠군. 내가 데려가서 조교하지.</div>'
$rival_stake[22] = '[침흘리는 짐승족]<br>&nbsp;(침 튀기며) 여기봐, 잡파! 내가 올렸어, 올렸다구!</div>' 
$rival_stake[23] = '[코트 입은 이방인]<br>&nbsp;(입찰가를 더 올린다는 듯이 손을 높게 든다)</div>'
$rival_stake[24] = '[창백한 뱀파이어]<br>&nbsp;저 소녀의 삶의 기운을 느낄 수 있어. 잡파, 이 병에 저 애 피 좀 담아줘! 그거 말곤 쓸모없잖아.</div>'
$rival_stake[25] = '[털북숭이 도살업자]<br>&nbsp;조금만 더 찌우면 육즙이 좔좔 흐르겠군. 내가 사겠어! 누구든지 저걸 좋아하게 된 사람은 나중에 내 가게로 와, 한 점 나눠줄게!</div>' 
$rival_stake[26] = '[마스크 쓴 여자]<br>&nbsp;(입찰가를 더 올린다는 듯이 손을 강하게 들고 있다)</div>'
$rival_stake[27] = '[흉터 있는 기사]<br>&nbsp;집에 메이드가 필요해, 그리고 침대를 데워줄 탕파도, 이 소녀가 아주 딱이군. 이봐, 잡파!</div>'
$rival_stake[28] = '[대머리 생체해부학자]<br>&nbsp;음, 실험을 몇 개해도 어리니까 살아남을지도 모르겠군. 입찰가를 올려야겠어.</div>'
$rival_stake[29] = '[배고픈 여자 뱀파이어]<br>&nbsp;(송곳니를 게걸스럽게 핥으며) - 이봐, 나 빨리 걔를 마셔야 한다고!</div>' 
$rival_stake[30] = '[송곳니가 튀어나온 짐승족]<br>&nbsp;내꺼라구! 내꺼! 내꺼어어어어어!!! 빨리, 빨리, 빨리 줘!!!</div>'
$rival_stake[31] = '[조합의 경쟁자]<br>&nbsp;(손을 들며) 조교하기 좋을 거야.</div>'
$rival_stake[32] = '[여드름 난 십대]<br>&nbsp;한 달 동안 용돈 모아 왔어요! 제발 아무나 한 명만 사게 해주세요!</div>'
$rival_stake[33] = '[조합의 경쟁자]<br>&nbsp;잡파! 자네 입찰가를 너무 많이 올렸어! 훈련도 안 받은 노예에게 그만한 가치는 없다구! 이게 내 마지막 입찰일세!</div>' 
$rival_stake[34] = '[땅딸막한 사형집행인]<br>&nbsp;내려치는 강도를 시험해 볼 애를 하나 구하고 있어. 이거 좋은데? 귀여운 머리가 단두대에 잘 어울릴 것 같군!</div>'
$rival_stake[35] = '[귀족 대리인]<br>&nbsp;내 고객이 원하는 노예가 딱 그 소녀요. 이봐요 잡파, 내가 사겠소!</div>'
! JO9 MOD END J9M2538

$stake_size[1] = '<br><br> 5 스파크 더!'
$stake_size[2] = '<br><br> 10 스파크 더!'
$stake_size[3] = '<br><br> 15 스파크 더!'
$stake_size[4] = '<br><br> 내가 20 더 내겠소!'
$stake_size[5] = '<br><br> 내가 25 더 내겠소.'
$stake_size[6] = '<br><br> 거기에 30 더 얹겠소!'
$stake_size[7] = '<br><br> 35 스파크 더.'
$stake_size[8] = '<br><br> 40 스파크 더!'
$stake_size[9] = '<br><br> 거기에 45 스파크 더!'
$stake_size[10] = '<br><br> 50 스파크 더!'



!TRAITS
$Нет_клейма = '<center>노예 특성 : 미상표</center><Br> 상표가 없습니다! 미상표품은 고객 판매가 불가능합니다.<br><br> 또한 노예의 운명을 수용하지 않을겁니다.<br><br> 지하에서 인장(육체 상세정보에서) 혹은 추방자 영역에서 문신이나 강력한 마법사의 마법으로 표식을 새길 수 있습니다.'
$sanity_broken = '<center>노예 특성 : 정신붕괴</center><Br> 정신이 완전히 망가졌습니다. 인형과도 같은 상태입니다.<br><br> 이는 등급을 추락시킬 것이며 모든 행동, 대화, 명령 등에 의지를 상실하여 이행하기 힘들 것입니다.<br><br> 태도나 자아, 성격의 증가로 회복할 수 있을지도 모릅니다.'
$sanity_low = '<center>노예 특성 : 신경쇠약</center><Br> 정신 상태가 위험 수준에 이르렀습니다!<br><br> 태도나 자아, 성격의 증가로 회복할 수 있을지도 모릅니다.'
! JO9 MOD START TRAIT_DESC_24 | 2026-10-16_trait_descriptions_woman | $Нимфоманка = #txt_woman
$Нимфоманка = ' 당신은 당신의 노예가, 좋게 말해도, 섹스를 몹시 밝힌다는 걸 알아차렸다. 많은 성적 행위는 그녀에게 더 쉬워지겠지만, 채워지지 않는 욕망은 그녀를 미치게 만들 것이다.'
! JO9 MOD END TRAIT_DESC_24
! JO9 MOD START TRAIT_DESC_25 | 2026-10-16_trait_descriptions_woman | $Фригидная = #txt_woman
$Фригидная = ' 당신은 당신 노예가 섹스에 완전히 무관심하다는 걸 깨닫는다. 그녀를 흥분시키는 것은 사실상 불가능하고, 이는 관련 기술 발달을 분명 복잡하게 만들며 모든 에로틱한 보상을 무효화한다.'
! JO9 MOD END TRAIT_DESC_25
! JO9 MOD START TRAIT_DESC_26 | 2026-10-16_trait_descriptions_woman | $Мазохистка = #txt_woman
$Мазохистка = ' 고통은 당신 노예를 겁주지 않는다. 오히려 그녀는 고통을 갈망하고, 거기서 쾌락을 얻는다. 마조히스트에게 채찍질은 소용없지만, 그녀에게 영향을 줄 다른 방법은 있다…'
! JO9 MOD END TRAIT_DESC_26
! JO9 MOD START TRAIT_DESC_27 | 2026-10-16_trait_descriptions_woman | $Привычна_к_боли = #txt_woman
$Привычна_к_боли = ' 당신의 노예는 고통을 견딜 수 있다. 마조히스트는 아니지만, 평범한 고문으로 겁주기는 쉽지 않다. 하지만 고통 말고도 두려움의 원천은 언제든 찾을 수 있다…'
! JO9 MOD END TRAIT_DESC_27
! JO9 MOD START TRAIT_DESC_28 | 2026-10-16_trait_descriptions_woman | $Боится_боли = #txt_woman
$Боится_боли = ' 당신의 노예는 고통을 끔찍이 두려워해, 평범한 매질만으로도 울음을 터뜨릴 준비가 되어 있다. 기억해 두어라 - 고통스러운 처벌이 훨씬 더 효과적일 것이다!'
! JO9 MOD END TRAIT_DESC_28
! JO9 MOD START TRAIT_DESC_29 | 2026-10-16_trait_descriptions_woman | $Эксгибиционистка = #txt_woman
$Эксгибиционистка = ' 당신은 당신의 노예가 자기 알몸을 드러내는 데 특별한 기쁨을 느낀다는 걸 알아차린다. 그녀에게 알몸의 수치를 느끼게 만들 수는 없지만, 분명 어떤 수업들은 더 쉽게 진행될 것이다.'
! JO9 MOD END TRAIT_DESC_29
! JO9 MOD START TRAIT_DESC_30 | 2026-10-16_trait_descriptions_woman | $Стеснительная = #txt_woman
$Стеснительная = ' 당신 노예는 분명 자기 알몸을 미칠 듯이 부끄러워한다. 알몸을 드러내는 기술을 가르치기는 어려울 것이지만, 이 특성은 더 효과적인 처벌을 고르는 데 활용할 수 있다.'
! JO9 MOD END TRAIT_DESC_30
! JO9 MOD START TRAIT_DESC_31 | 2026-10-16_trait_descriptions_woman | $Извращенка = #txt_woman
$Извращенка = ' 당신 노예는 대부분의 사람들이 역겹다고 여기는 것들을 좋아하는 것 같다. 가장 더럽고 변태적인 짓들에 특히 강하게 흥분한다 - 이는 극단적인 성기술을 익히는 데 분명 유용하다.'
! JO9 MOD END TRAIT_DESC_31
! JO9 MOD START TRAIT_DESC_32 | 2026-10-16_trait_descriptions_woman | $Пуристка = #txt_woman
$Пуристка = ' 당신은 당신 노예가 비표준적이고 더러운 종류의 섹스와, 변태성과 관련된 모든 것을 견디지 못한다는 걸 알아차린다. 극단적인 성적 행위를 교육하는 일은 특히 어려울 것이다.'
! JO9 MOD END TRAIT_DESC_32
! JO9 MOD START TRAIT_DESC_33 | 2026-10-16_trait_descriptions_woman | $Лесбиянка = #txt_woman
$Лесбиянка = ' 실제로 확인해 보니 당신 노예는 남자에게는 완전히 무관심하지만, <<iif(slave_type, $slave_girls2_txt[slave["age"]], "여자들")>>과는 기꺼이 섹스한다. 대부분의 경우 이것은 문제가 되겠지만, 그래도 그녀에게도 가르칠 수 있는 건 있다.'
! JO9 MOD END TRAIT_DESC_33
! JO9 MOD START TRAIT_DESC_34 | 2026-10-16_trait_descriptions_woman | $Бисексуальная = #txt_woman
$Бисексуальная = ' 당신은 당신 노예가 여자와 남자 모두와의 섹스를 똑같이 즐긴다는 걸 이해한다. 이런 개방성은 특정 성적 행위에서 꽤 유용할 수 있다.'
! JO9 MOD END TRAIT_DESC_34
! JO9 MOD START TRAIT_DESC_35 | 2026-10-16_trait_descriptions_woman | $Гомофобка = #txt_woman
$Гомофобка = ' 당신 노예는 다른 <<iif(slave_type, $slave_noun6[slave["age"]], "소녀")>>와의 섹스로는 전혀 흥분할 수 없다. 아주 큰 문제는 아니지만, 그래도 몇몇 성적 행위에서는 성과가 떨어질 것이다.'
! JO9 MOD END TRAIT_DESC_35
! JO9 MOD START TRAIT_DESC_45 | 2026-10-16_trait_descriptions_woman | $Пси_мазохистка = #txt_woman
$Пси_мазохистка = ' 당신은 당신 노예가 모욕당하고 말로 학대당할 때 비뚤어진 쾌락을 느낀다는 걸 알아차린다. 욕설과 협박은 아무 소용이 없고, 오히려 그녀의 나쁜 행동만 더 부추길 뿐이다. 더 거친 제재를 써야 한다.'
! JO9 MOD END TRAIT_DESC_45
! JO9 MOD START TRAIT_DESC_46 | 2026-10-16_trait_descriptions_woman | $Истеричка = #txt_woman
$Истеричка = ' 타인의 관심은 당신 노예에게 엄청나게 중요하다. 그녀는 언제나 주목의 중심에 있고 싶어 하고, 칭찬을 갈망한다. 말로 하는 격려는 특히 효과적일 것이다.'
! JO9 MOD END TRAIT_DESC_46
! JO9 MOD START TRAIT_DESC_47 | 2026-10-16_trait_descriptions_woman | $Дитя_тьмы = #txt_woman
$Дитя_тьмы = ' 틈만 나면 당신 노예는 어두운 구석에 숨으려 든다. 어둠 속에서 특별히 편안함을 느끼는 것 같다. 이것은 몇몇 처벌의 효과를 낮출 수 있다.'
! JO9 MOD END TRAIT_DESC_47
! JO9 MOD START TRAIT_DESC_48 | 2026-10-16_trait_descriptions_woman | $Боится_темноты = #txt_woman
$Боится_темноты = ' 당신은 당신 노예가 어둠 속에 남겨지는 것을 죽을 만큼 두려워한다는 걸 알아차렸다. 이 공포는 당신에게 유리하게 쓸 수 있다: 시야 제한을 수반하는 처벌이 특히 효과적일 것이다.'
! JO9 MOD END TRAIT_DESC_48
! JO9 MOD START TRAIT_DESC_49 | 2026-10-16_trait_descriptions_woman | $Кровожадная = #txt_woman
$Кровожадная = ' 당신 노예는 피의 모습과 맛을 좋아하는 것 같다. 이런 특성은 몇몇 고문의 효과를 떨어뜨릴 수 있다. 바늘과 메스가 그녀를 겁주는 대신 오히려 끌어당기기 때문이다.'
! JO9 MOD END TRAIT_DESC_49
! JO9 MOD START TRAIT_DESC_50 | 2026-10-16_trait_descriptions_woman | $Боится_крови = #txt_woman
$Боится_крови = ' 피를 보는 순간 노예는 거의 기절할 지경이 된다. 피를 흘리게 하는 고문은 특히 강력한 효과를 낼 것이라는 점을 기억해 둔다. 이제 바늘과 메스를 갈아야 할 시간이다!'
! JO9 MOD END TRAIT_DESC_50
! JO9 MOD START TRAIT_DESC_51 | 2026-10-16_trait_descriptions_woman | $Пиромания = #txt_woman
$Пиромания = ' 당신 노예는 불에 절대적으로 매혹된 것 같다. 불꽃을 너무 좋아해서, 고통스러운 화상조차 용감하게 견디려 든다. 이것은 어떤 종류의 고문의 효과를 낮출 것이다.'
! JO9 MOD END TRAIT_DESC_51
! JO9 MOD START TRAIT_DESC_52 | 2026-10-16_trait_descriptions_woman | $Пирофобия = #txt_woman
$Пирофобия = ' 노출된 불꽃은 당신 노예에게 짐승 같은 공포를 불러일으키는 것 같다. 즉, 불과 관련된 고문을 사용하면 훨씬 더 큰 효과를 얻을 수 있다는 뜻이다.'
! JO9 MOD END TRAIT_DESC_52
! JO9 MOD START TRAIT_DESC_53 | 2026-10-16_trait_descriptions_woman | $Дитя_воды = #txt_woman
$Дитя_воды = ' 당신 노예는 물을 사랑하는 듯하며, 물에 빠져 죽을 수도 있다는 전망도 그다지 두려워하지 않는다. 물을 이용한 고문으로 그녀를 겁주기는 어려울 것이다.'
! JO9 MOD END TRAIT_DESC_53
! JO9 MOD START TRAIT_DESC_54 | 2026-10-16_trait_descriptions_woman | $Гидрофобия = #txt_woman
$Гидрофобия = ' 당신 노예는 질식하는 것을 미칠 듯이 두려워하며, 머리가 물에 잠기면 그대로 굳어 버린다. 이것은 모든 수중 고문의 효율을 크게 높여 줄 것이다.'
! JO9 MOD END TRAIT_DESC_54
! JO9 MOD START TRAIT_DESC_55 | 2026-10-16_trait_descriptions_woman | $Арахнофилия = #txt_woman
$Арахнофилия = ' 당신 노예는 온갖 역겨운 생물들 - 딱정벌레, 전갈, 뱀, 쥐, 특히 거미 - 에 병적인 애착을 느끼는 것 같다! 그래서 아무리 혐오스러운 파충류를 들이밀어도 그녀를 겁줄 수가 없다.'
! JO9 MOD END TRAIT_DESC_55
! JO9 MOD START TRAIT_DESC_56 | 2026-10-16_trait_descriptions_woman | $Арахнофобия = #txt_woman
$Арахнофобия = ' 당신은 당신 노예가 딱정벌레, 전갈, 뱀, 쥐, 특히 거미 같은 온갖 역겨운 생물들을 미친 듯이 두려워한다는 걸 알아차린다. 즉, 이런 생물들을 이용한 고문이 극도로 효과적이라는 뜻이다.'
! JO9 MOD END TRAIT_DESC_56
! JO9 MOD START TRAIT_DESC_57 | 2026-10-16_trait_descriptions_woman | $Любит_беспомощность = #txt_woman
$Любит_беспомощность = ' 당신은 이동을 제한하는 것이 당신 노예에게 매우 긍정적으로 작용한다는 걸 알아차린다. 그녀는 그저 묶이거나 좁은 상자에 갇히는 걸 기뻐하는 것 같다. 이런 점은 많은 처벌을 사실상 쓸모없게 만든다.'
! JO9 MOD END TRAIT_DESC_57
! JO9 MOD START TRAIT_DESC_58 | 2026-10-16_trait_descriptions_woman | $InuredHelplessness = #txt_woman
$InuredHelplessness = ' 당신은 이동 제한이 당신 노예를 거의 괴롭히지 않는다는 걸 알아차린다. 이 부류의 처벌은 그녀에게 덜 효과적이겠지만, 완전히 쓸모없는 건 아니다.'
! JO9 MOD END TRAIT_DESC_58
! JO9 MOD START TRAIT_DESC_59 | 2026-10-16_trait_descriptions_woman | $Клаустрофобия = #txt_woman
$Клаустрофобия = ' 노예의 움직임을 제한하면 그녀는 즉시 공포로 질식할 듯해진다. 무력감과 도망칠 수 없다는 감각이 그녀에게 짐승 같은 공포를 일으키는 것 같다. 가장 효과적인 처벌을 고를 때 이 점을 기억해야 한다.'
! JO9 MOD END TRAIT_DESC_59
! JO9 MOD START TRAIT_DESC_60 | 2026-10-16_trait_descriptions_woman | $Ленивая = #txt_woman
$Ленивая = ' 당신 노예를 지켜보면, 그녀가 빈둥거릴 기회를 높이 평가한다는 걸 알 수 있다. 노예에게는 썩 좋은 특성이 아니지만, 몇몇 종류의 보상은 분명 더 효과적일 것이다.'
! JO9 MOD END TRAIT_DESC_60
! JO9 MOD START TRAIT_DESC_61 | 2026-10-16_trait_descriptions_woman | $Гиперактивная = #txt_woman
$Гиперактивная = ' 당신 노예는 도무지 가만히 앉아 있지를 못한다. 언제나 활력이 넘치고, 늘 무슨 일엔가 바쁘다. 자유 시간을 준다고 해서 특별한 감사는 받지 못할 것이다.'
! JO9 MOD END TRAIT_DESC_61
! JO9 MOD START TRAIT_DESC_62 | 2026-10-16_trait_descriptions_woman | $Любит_роскошь = #txt_woman
$Любит_роскошь = ' 보아하니 당신 노예는 아름답고, 사치스럽고, 반짝이는 모든 것에 미쳐 있다. 드레스와 장신구만 있으면 그녀 마음은 쉽게 얻을 수 있다.'
! JO9 MOD END TRAIT_DESC_62
! JO9 MOD START TRAIT_DESC_63 | 2026-10-16_trait_descriptions_woman | $Аскетичная = #txt_woman
$Аскетичная = ' 당신 노예는 사치에 완전히 무관심한 것 같다. 반짝이는 장식품이나 화려한 드레스로는 매수할 수 없다. 좋지 않은 일이다. 영향을 줄 수단이 줄어들기 때문이다.'
! JO9 MOD END TRAIT_DESC_63
! JO9 MOD START TRAIT_DESC_64 | 2026-10-16_trait_descriptions_woman | $Сладкоежка = #txt_woman
$Сладкоежка = ' 당신은 당신 노예가 달고 맛있는 모든 것에 미쳐 있다는 걸 알아차린다. 이런 미식 취향은 조종할 수 있는 큰 기회를 드러낸다: 달콤한 디저트 하나만 있어도 그녀는 엄청난 데까지 나아갈 준비가 되어 있다!'
! JO9 MOD END TRAIT_DESC_64
! JO9 MOD START TRAIT_DESC_65 | 2026-10-16_trait_descriptions_woman | $Не_любит_сладкое = #txt_woman
$Не_любит_сладкое = ' 당신 노예는 미식가가 아닌 것 같다. 아주 조금만 먹고, 음식 맛에는 거의 관심이 없다. 안타깝지만 케이크나 초콜릿으로는 매수할 수 없다.'
! JO9 MOD END TRAIT_DESC_65
! JO9 MOD START TRAIT_DESC_66 | 2026-10-16_trait_descriptions_woman | $Тщеславная = #txt_woman
$Тщеславная = ' 당신은 노예가 사람들 사이에서 활짝 살아나는 걸 알아차린다. 그녀는 분명 주목의 중심에 서는 걸 좋아하고, 끊임없이 떠든다. 도시 데이트는 아주 효과적인 보상이 될 것이다.'
! JO9 MOD END TRAIT_DESC_66
! JO9 MOD START TRAIT_DESC_67 | 2026-10-16_trait_descriptions_woman | $Хикикомори = #txt_woman
$Хикикомори = ' 당신 노예는 낯선 사람을 피하고, 공개된 장소에 있는 걸 즐기지 않는다는 걸 알게 된다. 보아하니 그녀가 원하는 건 그저 네 벽 안에 틀어박혀 아무 데도 나가지 않는 것뿐이다. 데이트는 그녀에게 끝없는 스트레스가 될 것이다.'
! JO9 MOD END TRAIT_DESC_67
! JO9 MOD START TRAIT_DESC_36 | 2026-10-16_trait_descriptions_woman | $Отмороженая = #txt_woman
$Отмороженая = ' 당신 노예는 단순히 용감한 정도가 아니라 무모하다. 어째서인지 공포라는 감정을 모르고, 겁주는 것이 불가능하다. 이런 유형은 타인에게뿐 아니라 자기 자신에게도 매우 위험할 수 있다!'
! JO9 MOD END TRAIT_DESC_36
! JO9 MOD START TRAIT_DESC_37 | 2026-10-16_trait_descriptions_woman | $Храбрая = #txt_woman
$Храбрая = ' 당신 노예는 자신의 두려움을 쉽게 극복할 수 있다. 물론 여전히 공포를 이용해 영향을 줄 수는 있지만, 그녀는 보통 노예들보다 훨씬 용감하므로 고문으로 꺾기는 쉽지 않을 것이다.'
! JO9 MOD END TRAIT_DESC_37
! JO9 MOD START TRAIT_DESC_38 | 2026-10-16_trait_descriptions_woman | $Трусиха = #txt_woman
$Трусиха = ' 당신 노예는 진짜 겁쟁이인 것 같다. 조금만 압박해도 곧바로 굴복할 준비가 되어 있다. 가벼운 처벌만으로도 그녀의 저항 의지를 빨리 꺾고 당신 뜻을 밀어붙일 수 있을 것이다.'
! JO9 MOD END TRAIT_DESC_38
! JO9 MOD START TRAIT_DESC_20 | 2026-10-16_trait_descriptions_woman | $Мощный_метаболизм = #txt_woman
$Мощный_метаболизм = ' 당신 노예의 신진대사는 믿을 수 없을 만큼 효율적이다. 먹고 싶은 걸 다 먹어도 살이 안 찌는 것 같다. 그러니 식단에 대해 덜 신경 써도 된다.'
! JO9 MOD END TRAIT_DESC_20
! JO9 MOD START TRAIT_DESC_21 | 2026-10-16_trait_descriptions_woman | $Хороший_метаболизм = #txt_woman
$Хороший_метаболизм = ' 당신 노예는 신진대사가 아주 좋다. 대부분의 사람보다 살이 훨씬 천천히 찌므로 식단을 조금 느슨하게 관리해도 된다. 편리한 일이다.'
! JO9 MOD END TRAIT_DESC_21
! JO9 MOD START TRAIT_DESC_22 | 2026-10-16_trait_descriptions_woman | $Ослабленный_метаболизм = #txt_woman
$Ослабленный_метаболизм = ' 시간이 지나면서 당신은 당신 노예가 신진대사에 문제가 있다는 걸 깨닫는다. 다른 이들보다 쉽게 살이 찌므로 식단에 특별한 주의가 필요하다.'
! JO9 MOD END TRAIT_DESC_22
! JO9 MOD START TRAIT_DESC_23 | 2026-10-16_trait_descriptions_woman | $Слабый_метаболизм = #txt_woman
$Слабый_метаболизм = ' 당신 노예의 신진대사는 심하게 망가져 있다. 빵 하나만 더 먹어도 체중계에는 바로 지방이 늘어난 수치가 찍힌다. 식단을 아주 세심하게 관리해야 한다.'
! JO9 MOD END TRAIT_DESC_23
! JO9 MOD START TRAIT_DESC_05 | 2026-10-16_trait_descriptions_woman | $Спортивная = #txt_woman
$Спортивная = ' 당신 노예는 매우 활동적이고 운동에서 큰 즐거움을 얻는다. 훌륭한 몸 상태로 만드는 일은 어렵지 않을 것이다.'
! JO9 MOD END TRAIT_DESC_05
! JO9 MOD START TRAIT_DESC_06 | 2026-10-16_trait_descriptions_woman | $Апатичная = #txt_woman
$Апатичная = ' 당신 노예는 운동을 좋아하지 않고, 스스로를 밀어붙이지도 않는다. 제대로 된 몸 상태로 만들기가 어려울 것이다.'
! JO9 MOD END TRAIT_DESC_06
! JO9 MOD START TRAIT_DESC_07 | 2026-10-16_trait_descriptions_woman | $оратор = #txt_woman
$оратор = ' 당신 노예는 자기 표현에 재능을 보인다. 예절과 수사학을 키우는 일은 쉬울 것이고, 이는 분명 반가운 소식이다!'
! JO9 MOD END TRAIT_DESC_07
! JO9 MOD START TRAIT_DESC_08 | 2026-10-16_trait_descriptions_woman | $питомец = #txt_woman
$питомец = ' 보아하니 당신 노예는 애완동물 흉내 내는 걸 정말 좋아한다. 그리고 무엇보다도, 그걸 아주 잘한다. 훈련은 잘 진행될 것이다!'
! JO9 MOD END TRAIT_DESC_08
! JO9 MOD START TRAIT_DESC_09 | 2026-10-16_trait_descriptions_woman | $Brony = #txt_woman
$Brony = ' 보아하니 당신 노예는 말이 되는 걸 좋아한다. 남들이 굴욕적이고 힘들다고 여길 일을, 그녀는 즐겁고 흥미롭게 여긴다.'
! JO9 MOD END TRAIT_DESC_09
! JO9 MOD START TRAIT_DESC_10 | 2026-10-16_trait_descriptions_woman | $Indolent = #txt_woman
$Indolent = ' 당신 노예는 몸도 머리도 쓰기 싫어하고, 그저 빈둥거리길 좋아한다. 어쩌면 젖소로 바꾸기가 더 쉬울지도 모르겠다?'
! JO9 MOD END TRAIT_DESC_10
! JO9 MOD START TRAIT_DESC_11 | 2026-10-16_trait_descriptions_woman | $медсестра = #txt_woman
$медсестра = ' 당신 노예는 의학 쪽에서 눈에 띄는 능력을 보인다. 훌륭한 간호사로 키워 내기 쉬울 것이다!'
! JO9 MOD END TRAIT_DESC_11
! JO9 MOD START TRAIT_DESC_12 | 2026-10-16_trait_descriptions_woman | $горничная = #txt_woman
$горничная = ' 당신 노예는 집안의 질서를 유지하는 데 큰 즐거움을 느끼는 것 같다. 이 점 덕분에 훌륭한 하녀가 될 수 있을 것이다!'
! JO9 MOD END TRAIT_DESC_12
! JO9 MOD START TRAIT_DESC_13 | 2026-10-16_trait_descriptions_woman | $кухарка = #txt_woman
$кухарка = ' 당신 노예는 분명 요리에 재능이 있다. 요리하는 걸 즐기고, 난로 앞에서 이것저것 만지작거리는 걸 분명 재미있어한다.'
! JO9 MOD END TRAIT_DESC_13
! JO9 MOD START TRAIT_DESC_14 | 2026-10-16_trait_descriptions_woman | $воительница = #txt_woman
$воительница = ' 당신 노예는 타고난 전사다! 전투 기술을 키우는 일은 쉬울 것이고, 이런 능력은 수요도 아주 많다.'
! JO9 MOD END TRAIT_DESC_14
! JO9 MOD START TRAIT_DESC_15 | 2026-10-16_trait_descriptions_woman | $чародейка = #txt_woman
$чародейка = ' 당신 노예는 믿기 힘든 마법 재능을 드러냈다. 훌륭한 마녀나 연금술사가 될 것이다.'
! JO9 MOD END TRAIT_DESC_15
! JO9 MOD START TRAIT_DESC_16 | 2026-10-16_trait_descriptions_woman | $певица = #txt_woman
$певица = ' 당신 노예는 그림 그리는 걸 좋아할 뿐 아니라, 머릿속에 떠오른 것을 그대로 재현하는 데도 대단한 재능이 있다. 위대한 화가로 훈련시키기 쉬울 것이다!'
! JO9 MOD END TRAIT_DESC_16
! JO9 MOD START TRAIT_DESC_17 | 2026-10-16_trait_descriptions_woman | $музыкантка = #txt_woman
$музыкантка = ' 당신 노예는 절대음감을 지녔다. 이것은 악기 연주를 배울 때 엄청난 도움이 될 것이다. 그녀의 음악적 재능을 키우는 데 특별한 주의를 기울여야 한다.'
! JO9 MOD END TRAIT_DESC_17
! JO9 MOD START TRAIT_DESC_18 | 2026-10-16_trait_descriptions_woman | $танцовщица = #txt_woman
$танцовщица = ' 당신 노예는 춤에 분명한 재능이 있다. 음악을 깊이 느끼고, 춤동작을 순식간에 따라 하며, 쉽게 즉흥적으로 움직이고 자기만의 스타일과 안무까지 만들어 낸다.'
! JO9 MOD END TRAIT_DESC_18
! JO9 MOD START TRAIT_DESC_19 | 2026-10-16_trait_descriptions_woman | $секретарша = #txt_woman
$секретарша = ' 당신 노예는 개인 조수로서 탁월한 감각을 지닌 것 같다 - 차분하고, 세심하며, 서류 작업도 쉽게 해낸다. 이 재능을 최대한 활용해야 한다!'
! JO9 MOD END TRAIT_DESC_19
$Эйдетическая_память = '<center>노예 특성 : 기억 도서관</center><Br> 기억력이 특출나게 뛰어납니다.<br><br> 마치 책처럼 모든 것을 기억해냅니다.<br><br> 이미 배운것을 잊지 않을겁니다.'
$Забывчивая = '<center>노예 특성 : 건망증 환자</center><Br> 머릿속이 뒤죽박죽입니다.<br><br> 단 몇일 전 무엇을 하였는지 조차 잊어버립니다.<br><br> 배운것을 망각하거나, 아침 빨기를 잊기 일수입니다.'
! JO9 MOD START TRAIT_DESC_39 | 2026-10-16_trait_descriptions_woman | $Дисциплинированная = #txt_woman
$Дисциплинированная = ' 보아하니 당신 노예는 엄격한 규율에 익숙하고, 자기 욕망을 무시한 채 복종할 준비가 되어 있다. 노예에게는 분명 유용한 특성이다.'
! JO9 MOD END TRAIT_DESC_39
! JO9 MOD START TRAIT_DESC_40 | 2026-10-16_trait_descriptions_woman | $Своенравная = #txt_woman
$Своенравная = ' 규율은 분명 당신 노예의 강점이 아니다. 정리도 안 되어 있고, 언제나 제멋대로 행동한다. 늘 막대기 들고 머리 위에 서 있어야 한다.'
! JO9 MOD END TRAIT_DESC_40
! JO9 MOD START TRAIT_DESC_41 | 2026-10-16_trait_descriptions_woman | $Мания_величия = #txt_woman
$Мания_величия = ' 당신 노예는 분명 자기 장점을 과대평가하고, 자기 가치를 지나치게 확신한다. 하지만 밝은 면도 있다: 별것 아닌 공에도 큰 보상을 줘도, 그녀를 버릇없게 만들 걱정은 덜해도 된다.'
! JO9 MOD END TRAIT_DESC_41
! JO9 MOD START TRAIT_DESC_42 | 2026-10-16_trait_descriptions_woman | $Комплекс_вины = #txt_woman
$Комплекс_вины = ' 당신 노예는 끊임없이 죄책감을 느끼며, 어떤 실수에도 몹시 괴로워한다. 이렇게 자존감이 낮으니 사소한 잘못에도 자신이 심한 벌을 받아 마땅하다고 여긴다.'
! JO9 MOD END TRAIT_DESC_42
! JO9 MOD START TRAIT_DESC_43 | 2026-10-16_trait_descriptions_woman | $Милосердная = #txt_woman
$Милосердная = ' 당신은 당신 노예가 다른 사람의 고통을 함께 느낀다는 걸 이해한다. 이건 그녀를 통제하는 데 이용할 수 있다!'
! JO9 MOD END TRAIT_DESC_43
! JO9 MOD START TRAIT_DESC_44 | 2026-10-16_trait_descriptions_woman | $Садистка = #txt_woman
$Садистка = ' 당신 노예는 분명 다른 사람의 고통을 보는 걸 즐기고, 어쩌면 그 과정에 직접 끼는 것도 싫어하지 않을 것이다. 안타깝게도 이는 당신의 영향 수단을 좁힌다.'
! JO9 MOD END TRAIT_DESC_44
! JO9 MOD START TRAIT_DESC_01 | 2026-10-16_trait_descriptions_woman | $NaturalGrace = #txt_woman
$NaturalGrace = ' 당신 노예는 움직임과 몸짓이 매끄럽고 유연하며 자연스럽고 아름답다. 그녀가 무엇을 하든 그 안에는 타고난 매력과 아름다움이 있다.'
! JO9 MOD END TRAIT_DESC_01
! JO9 MOD START TRAIT_DESC_02 | 2026-10-16_trait_descriptions_woman | $Klutzy = #txt_woman
$Klutzy = ' 당신 노예는 움직임과 몸짓이 서툴고 부조화롭다. 우아한 움직임이 필요한 활동을 시키면 큰 난관이 될 것이다.'
! JO9 MOD END TRAIT_DESC_02
! JO9 MOD START TRAIT_DESC_03 | 2026-10-16_trait_descriptions_woman | $Dexterity = #txt_woman
$Dexterity = ' 당신 노예는 손가락이 매우 민첩하다. 빠르고 정확하게 움직일 수 있다. 예술적인 활동을 시킨다면 이 재능은 큰 선물이 될 것이다.'
! JO9 MOD END TRAIT_DESC_03
! JO9 MOD START TRAIT_DESC_04 | 2026-10-16_trait_descriptions_woman | $Clumsy = #txt_woman
$Clumsy = ' 당신 노예는 손이 매우 서툴다. 예술적인 활동을 시키면 이것이 큰 장애물이 될 것이다.'
