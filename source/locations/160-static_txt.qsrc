$sa_relations_text['tolerant_nation_3'] = '그녀의 인종은 <font color="blue">전혀 중요하지 않다</font>.'

$sa_relations_text['tolerant_family_eq_1'] = '그녀는 내가 부유하게 자랐든 가난하게 자랐든 <font color="green">신경 쓰지 않는다</font>.'
$sa_relations_text['tolerant_family_eq_2'] = '게다가 그녀는 <font color="green">내 배경도 신경 쓰지 않는다.</font>'
$sa_relations_text['tolerant_family_eq_3'] = '그녀는 <font color="green">사회 계급을 믿지 않는다.</font>'
$sa_relations_text['tolerant_family_1'] = '그녀가 부유하든 가난하든 <font color="blue">중요하지 않다</font>.'
$sa_relations_text['tolerant_family_2'] = '그녀가 어떤 집안에서 태어났는지가 <font color="blue">무슨 상관이람</font>?'
$sa_relations_text['tolerant_family_3'] = '그녀가 부자였든 가난했든 전혀 중요하지 않다.'

$sa_relations_text['tolerant_work_eq_1'] = '그리고 그녀도 나처럼 <font color="green">우리가 예전에 누구였는지 전혀 신경 쓰지 않는다</font>.'
$sa_relations_text['tolerant_work_eq_2'] = '그녀는 내 과거를 신경 쓰지 않는데, 그건 <font color="green">좋은 일이다</font>.'
$sa_relations_text['tolerant_work_eq_3'] = '그녀 역시 사람들의 과거에 <font color="green">공정하다</font>.'
$sa_relations_text['tolerant_work_1'] = '그녀가 예전에 뭐였든, <font color="blue">지금은 나처럼 노예일 뿐이다</font>.'
$sa_relations_text['tolerant_work_2'] = '나는 그녀가 예전에 누구였는지 <font color="blue">신경 쓰지 않는다</font>.'
$sa_relations_text['tolerant_work_3'] = '지금 우리는 둘 다 노예고, 그녀의 과거는 <font color="blue">중요하지 않다</font>.'

$sa_relations_text['world_prim_1'] = '<font color="red">이상하고 말투도 웃기다.</font>'
$sa_relations_text['world_prim_2'] = ' <font color="red">말도 안 되게 낙후된</font> 세계 출신이다.'
$sa_relations_text['world_prim_3'] = ' 나한테는 너무 <font color="red">원시적이다</font>.'
$sa_relations_text['world_adv_1'] = ' 꼭 <font color="red">멍청이처럼</font> 말한다.'
$sa_relations_text['world_adv_2'] = ' <font color="red">이해할 수 없는 기묘한 세계</font> 출신이다.'
$sa_relations_text['world_adv_3'] = ' 그녀는 날 <font color="red">야만인</font> 취급한다.'
$sa_relations_text['world_eq_1'] = ' <font color="green">정상적인</font> 사람처럼 보인다.'
$sa_relations_text['world_eq_2'] = ' <font color="green">내 세계와 비슷한</font> 세계 출신이다.'
$sa_relations_text['world_eq_3'] = ' <font color="green">내 세계, 혹은 그와 가까운 곳</font> 출신이다.'

$sa_relations_text['nation_eq_1'] = '<font color="green">인간다운 이름</font>이라서 좋다.'
$sa_relations_text['nation_eq_2'] = '그녀의 억양이 내게는 <font color="green">익숙하게</font> 느껴진다.'
$sa_relations_text['nation_eq_3'] = '그녀는 문화적으로 내게 <font color="green">가깝다</font>.'
$sa_relations_text['nation_neq_1'] = '그녀 이름은 <font color="red">멍청한 것</font> 같다.'
$sa_relations_text['nation_neq_2'] = '그녀의 억양은 <font color="red">나를 짜증 나게 한다</font>.'
$sa_relations_text['nation_neq_3'] = '그녀의 문화는 내게 <font color="red">낯설다</font>.'

$sa_relations_text['nation_beast_1_1'] = '그녀는 아예 <font color="red">인간도 아니다</font>, 으악!'
$sa_relations_text['nation_beast_1_2'] = '내가 <font color="red">바이오로봇</font>이랑 같이 살아야 한다고?'
$sa_relations_text['nation_beast_1_3'] = '그녀는 <font color="red">인간이 아니라</font>, 그저 인공적인 물건일 뿐이다.'
$sa_relations_text['nation_beast_2_1'] = '이 <font color="red">박제 같은 것</font>은 뭐야?! 얘 왜 이래?'
$sa_relations_text['nation_beast_2_2'] = '이거 <font color="red">그냥 로봇</font> 아니야? 지능은 있나?'
$sa_relations_text['nation_beast_2_3'] = '<font color="red">불쾌한 골짜기</font> 효과란 바로 저런 거다.'
$sa_relations_text['nation_beast_3_1'] = '<font color="red">끔찍한 괴물</font>이야! 무섭다.'
$sa_relations_text['nation_beast_3_2'] = '막대기로 찔러 보면 <font color="red">물려나</font>?'
$sa_relations_text['nation_beast_3_3'] = '그녀는 무슨 <font color="red">프랑켄슈타인의 괴물</font> 같다.'
$sa_relations_text['nation_beast_4_1'] = '<font color="red">두려운 수인</font>이다!'
$sa_relations_text['nation_beast_4_2'] = '그녀는 <font color="red">지옥의 짐승</font>이다!'
$sa_relations_text['nation_beast_4_3'] = '나는 <font color="red">그녀에게 영혼이 없다고</font> 생각한다.'
$sa_relations_text['nation_beast_5_1'] = '<font color="red">악마</font>다! 진짜 악마다!'
$sa_relations_text['nation_beast_5_2'] = '우리 친척들은 <font color="red">숲에서 그녀 같은 것들을 죽였었다</font>.'
$sa_relations_text['nation_beast_5_3'] = '나는 <font color="red">그녀 같은 악마들</font>이 싫다.'

$sa_relations_text['family_class1_1'] = '내 자리를 알고 날 <font color="purple">마땅히 그래야 하듯</font> 대해야 한다.'
$sa_relations_text['family_class1_2'] = '나는 그녀를 <font color="purple">내 배경의 여자라면 마땅히 그러하듯</font> 대할 것이다.'
$sa_relations_text['family_class1_3'] = '그녀는 내 신분의 여자가 모든 면에서 <font color="purple">자기보다 위</font>라는 걸 이해해야 한다.'
$sa_relations_text['family_class1to1_1'] = '그녀도 공주라서 다행이다, <font color="green">나처럼 말이다</font>. 뭐, 거의 그렇다는 뜻이지만.'
$sa_relations_text['family_class1to1_2'] = '그녀가 <font color="green">나와 같은 수준</font>이라서 좋다. 서로 이해하기가 더 쉽다.'
$sa_relations_text['family_class1to1_3'] = '내 곁에 <font color="green">나와 가까운 신분</font>의 여자가 있게 되어 기쁘다.'

$sa_relations_text['family_class2_1'] = '평범한 여자네, <font color="purple">내가 뭘 못 봤겠어</font>?'
$sa_relations_text['family_class2_2'] = '그냥 흔한 여자일 뿐, <font color="purple">별거 없다</font>.'
$sa_relations_text['family_class2_3'] = '서로가 <font color="purple">어디에 속하는지</font>쯤은 둘 다 잘 알고 있을 거라 생각한다.'
$sa_relations_text['family_class2to1_1'] = '폐하만 괜찮으시다면, 그녀와 <font color="green">친구가 되고 싶다</font>.'
$sa_relations_text['family_class2to1_2'] = '그녀 곁에 있으면 마치 <font color="green">다시 상류사회에 돌아온 기분</font>이 든다.'
$sa_relations_text['family_class2to1_3'] = '그녀는 아주 높은 신분의 여자라서, 그 곁에 있다는 것만으로도 <font color="green">영광이다</font>.'

$sa_relations_text['family_class3_1'] = '글쎄, 친구가 될 수도 있겠지. 아니면 <font color="purple">아닐 수도</font> 있고.'
$sa_relations_text['family_class3_2'] = '저런 부류는 많이 안다. <font color="purple">회색 군상</font>. 그녀와는 나눌 게 없다.'
$sa_relations_text['family_class3_3'] = '사회적으로 그녀에게 <font color="purple">딱히 흥미는 없다</font>.'
$sa_relations_text['family_class3to12_1'] = '젠장, 그녀는 <font color="green">너무 멋지다</font>, 나 지금 너무 좋아서 소리 지를 것 같아!'
$sa_relations_text['family_class3to12_2'] = '그녀는 <font color="green">상류사회</font> 출신이다. 그녀와 함께 있으면 나도 더 나은 사람이 될지도 모른다.'
$sa_relations_text['family_class3to12_3'] = '그녀는 <font color="green">신분 있는 여자</font>다. 아는 사이가 되면 내게도 쓸모가 있을지 모른다.'

$sa_relations_text['family_class4to12w_1'] = '그녀는 귀한 분들 중 하나이니, <font color="green">존중</font>해야 한다.'
$sa_relations_text['family_class4to12w_2'] = '지금은 노예가 됐어도, 내게 그녀는 여전히 <font color="green">아가씨</font>다.'
$sa_relations_text['family_class4to12w_3'] = '그녀는 <font color="green">귀족 가문</font>에서 자랐다. 노예가 되기는 힘들 것이다.'
$sa_relations_text['family_class4to3w_1'] = '나는 그녀가 <font color="purple">부럽다</font>. 좋은 의미로. 난 그렇게 많은 돈을 가져 본 적이 없다.'
$sa_relations_text['family_class4to3w_2'] = '그녀는 귀족은 아니지만 부유한 집안 출신이다. 내가 그녀 자리에 <font color="purple">태어났으면</font> 좋았을 텐데.'
$sa_relations_text['family_class4to3w_3'] = '그녀는 <font color="purple">잘사는 계층</font> 출신이다. 집에 있었다면 나는 그녀의 하녀였을지도 모른다.'
$sa_relations_text['family_class4to4w_1'] = '그녀는 <font color="green">괜찮은 여자애</font>처럼 보인다. 친구가 될 수도 있겠다.'
$sa_relations_text['family_class4to4w_2'] = '그녀는 내 <font color="green">이웃이자 친구</font>가 될 수도 있었을 것이다. 아니면 경쟁자였거나.'
$sa_relations_text['family_class4to4w_3'] = '그녀는 <font color="green">나와 동급</font>이다. 그럼 훨씬 편하다. 서로 공통점을 찾기도 쉬울 것이다.'
$sa_relations_text['family_class4to5w_1'] = '그녀는 <font color="red">나쁜 부류</font>다. 저런 사람과는 엮이지 않는 게 좋다.'
$sa_relations_text['family_class4to5w_2'] = '그녀는 믿을 수 없다. 저런 부류는 잘 안다. <font color="red">좋지 않은 인간들</font>이다.'
$sa_relations_text['family_class4to5w_3'] = '나는 <font color="red">최대한 그녀와 멀리 떨어져 있겠다</font>. 무슨 생각을 하는지 누가 아나?'

$sa_relations_text['family_class4to1c_1'] = '자기가 뭐라도 되는 줄 아나, 공주라도 된다고? <font color="red">웃기는 바보</font>!'
$sa_relations_text['family_class4to1c_2'] = '귀족 출신이라고 <font color="red">유세하는 건</font> 멍청한 짓이다.'
$sa_relations_text['family_class4to1c_3'] = '어떤 의미로는, 귀족 피 섞인 노예를 보는 게 꽤 <font color="red">우습기도 하다</font>.'
$sa_relations_text['family_class4to2c_1'] = '그래, 저런 부잣집 계집이 노예가 된 건 잘된 일이다! <font color="red">하나도 안 불쌍하다</font>!'
$sa_relations_text['family_class4to2c_2'] = '그녀는 정말 <font color="red">귀족 티 내면 도움이 될 거라</font> 생각하는 건가?'
$sa_relations_text['family_class4to2c_3'] = '고귀한 출신 같은 건 너무 <font color="red">구시대적이다</font>. 뭘 그렇게 자랑하는 거지?'
$sa_relations_text['family_class4to3c_1'] = '그녀가 <font color="red">나보다 뭐가 더 낫다는 거지</font>? 내가 그 자리에 있었어야 했다.'
$sa_relations_text['family_class4to3c_2'] = '그녀는 나보다 부유한 집안에 태어난 게 운이 좋았을 뿐이다. <font color="red">그래서 어쩌라고</font>?'
$sa_relations_text['family_class4to3c_3'] = '그녀가 나보다 더 좋은 삶을 살았다는 건 <font color="red">불공평하다</font>고 생각한다. 이제 우린 같다.'
$sa_relations_text['family_class4to4c_1'] = '그녀와 <font color="green">친구가 되고 싶다</font>. 될 수 있나? 제발?'
$sa_relations_text['family_class4to4c_2'] = '이 여자애와 이야기하는 건 <font color="green">기분 좋다</font>. 우리 어린 시절은 비슷했다.'
$sa_relations_text['family_class4to4c_3'] = '우리는 다른 세계 출신이지만 <font color="green">서로를 잘 이해한다</font>.'
$sa_relations_text['family_class4to5c_1'] = '그녀랑은 말을 좀 덜 해도 되나? 왠지 <font color="red">수상하다</font>.'
$sa_relations_text['family_class4to5c_2'] = '수상한 과거를 가진 의심스러운 여자다. <font color="red">좋은 걸 기대하지 마라</font>.'
$sa_relations_text['family_class4to5c_3'] = '이런 말 하긴 싫지만, 그녀는 <font color="red">사회 밑바닥</font> 출신이다. 곁에 있으면 불편하다.'

$sa_relations_text['family_class5to13_1'] = '나는 저 <font color="red">년</font>을 어두운 골목에서 기쁘게 목 졸라 죽일 수도 있을 것이다.'
$sa_relations_text['family_class5to13_2'] = '<font color="red">거들먹거리는 년</font>! 저런 부류는 증오한다. 내 인생을 망친 게 바로 저런 인간들이다.'
$sa_relations_text['family_class5to13_3'] = '나는 고통받는 데 익숙하다. 하지만 <font color="red">그녀가 고통받는 걸 보는 건</font> 즐거울 것이다.'
$sa_relations_text['family_class5to45_1'] = '전형적인 <font color="purple">바보</font>다. 저런 사람들은 살기 힘들다. 늘 남들에게 이용당하니까.'
$sa_relations_text['family_class5to45_2'] = '<font color="purple">한심한 존재</font>다. 하지만 불쌍하진 않다. 누가 나를 불쌍히 여겨 줬나?'
$sa_relations_text['family_class5to45_3'] = '같이 뭘 할 수는 있겠지만, 나는 절대 그녀를 <font color="purple">믿지 않을 것이다</font>.'

$sa_relations_text['personal_1to1_1'] = '우리 공주들은 무너지지 않으려면 <font color="green">서로 뭉쳐야 한다</font>.'
$sa_relations_text['personal_1to1_2'] = '우리가 친구가 된다면, 마침내 <font color="green">나와 어울리는 누군가</font>와 이야기할 수 있게 될 것이다.'
$sa_relations_text['personal_1to1_3'] = '우리는 <font color="green">서로를 잘 이해하게 될</font> 것 같다. 내게는 동급과 이야기하는 편이 더 쉽다.'
$sa_relations_text['personal_1to5_1'] = '대체 <font color="red">저런 것</font>이 어떻게 나와 같은 집에 있게 된 거지? 으!'
$sa_relations_text['personal_1to5_2'] = '그녀는 <font color="red">끔찍하다</font>! 보기만 해도 머리가 아프다!'
$sa_relations_text['personal_1to5_3'] = '그녀를 보면 <font color="red">역겨운 호기심</font>이 든다. 마치 흉측한 애벌레를 보는 것처럼.'
$sa_relations_text['personal_1_1'] = '흠. 웃기네. 갑자기 <font color="purple">평범한 여자애들</font>이 어떻게 사는지 내가 모른다는 걸 깨달았다.'
$sa_relations_text['personal_1_2'] = '솔직히 그녀를 <font color="purple">어떻게 다뤄야 할지 모르겠다</font>. 말 상대가 생긴 건 좋은데, 대체 무슨 얘길 하지?'
$sa_relations_text['personal_1_3'] = '나는 그녀에게 <font color="purple">흥미가 없다</font>. 원하면 나를 시중들게 해도 되지만, 거슬리지만 마라.'

$sa_relations_text['personal_2to12_1'] = '우리는 <font color="green">상류사회</font>의 여자들이니, 함께 있어야 한다.'
$sa_relations_text['personal_2to12_2'] = '인정하자면, <font color="green">품위 있는 사람들 사이</font>에 있는 건 즐겁다. 그리웠다.'
$sa_relations_text['personal_2to12_3'] = '어쨌든 <font color="green">고귀한 사람들</font>과의 교류는 내게 공기만큼이나 필요하다.'
$sa_relations_text['personal_2to34_1'] = '그러니까, 그녀가 나랑 대화하겠다는 건가? 글쎄. <font color="purple">무슨 이야기를 해야 할지 모르겠다</font>.'
$sa_relations_text['personal_2to34_2'] = '그녀는 전생이었다면 <font color="purple">내 하녀</font>였을지도 모른다. 아니면 하녀의 하녀였거나.'
$sa_relations_text['personal_2to34_3'] = '내가 그녀와 정기적으로 대화까지 해야 하나? 그건 <font color="purple">기쁘지 않을 것 같다</font>.'
$sa_relations_text['personal_2to5_1'] = '누가 거지를 집 안으로 들여보낸 거지? 뭐라고, "나처럼 노예"라고? <font color="red">농담하나</font>?'
$sa_relations_text['personal_2to5_2'] = '그녀를 들인 걸 후회하게 될 것이다. 밑바닥 출신이야, 한 푼 값어치도 없다.'
$sa_relations_text['personal_2to5_3'] = '적어도 여기서만큼은 <font color="red">저런 부류</font>를 안 마주치길 바랐는데. 결국 이 모양이군.'

$sa_relations_text['personal_3to1_1'] = '그녀는 <font color="green">진짜 공주</font>다, 상상이나 가나? 아, 나도 공주였으면 좋겠다…'
$sa_relations_text['personal_3to1_2'] = '<font color="green">귀족 혈통</font>의 여자애가 내 곁에 있다니 - 소름이 돋는다.'
$sa_relations_text['personal_3to1_3'] = '혹시 우리가 자유를 되찾게 되면, 그녀가 <font color="green">나를 자기 시종으로 데려가 줄까</font>?'
$sa_relations_text['personal_3to2_1'] = '생각해 보면 <font color="purple">그녀가 나보다 그렇게까지 나은 것도 아니다</font>. 이제 우린 거의 동급 아닌가.'
$sa_relations_text['personal_3to2_2'] = '나는 <font color="purple">그녀처럼 되고 싶다</font>. 귀족다운 예절 같은 걸 배워서.'
$sa_relations_text['personal_3to2_3'] = '어쩌면 그녀가 좋은 주인을 만나고, <font color="purple">나도 같이 사 달라고 말해 줄지도</font>?'
$sa_relations_text['personal_3to3_1'] = '그녀에 대해 무슨 말을 더 해야 할까? <font color="blue">나도 잘 모르겠다</font>.'
$sa_relations_text['personal_3to3_2'] = '두고 보면 알겠지. <font color="blue">잘 지낼 수도 있고</font>.'
$sa_relations_text['personal_3to3_3'] = '그녀가 <font color="blue">바보만 아니라면</font>, 같이 협력할 수 있다.'
$sa_relations_text['personal_3to4_1'] = '그녀는 <font color="purple">좀 오싹하다</font>. 그리고 지루하다. 물론 친구는 다른 애가 더 좋았겠지.'
$sa_relations_text['personal_3to4_2'] = '<font color="purple">가난뱅이</font>, 흔한 부류다. 공통점도 별로 없다.'
$sa_relations_text['personal_3to4_3'] = '<font color="purple">내 친구가 되려 들지만 않으면</font>, 같은 지붕 아래 사는 건 가능할 것 같다.'
$sa_relations_text['personal_3to5_1'] = '어릴 때 저런 여자애랑 친구였는데, <font color="red">결국 죽었다</font>. 아직도 소름 끼친다.'
$sa_relations_text['personal_3to5_2'] = '<font color="red">그녀를 믿지 않는다</font>. 밤에 날 찔러 죽이면 어쩌지? 아니면 당신을 찌르면?'
$sa_relations_text['personal_3to5_3'] = '전염되는 건 아니겠지? 같은 집에 산다면 <font color="red">멀리 떨어져 있는 게 좋다</font>.'

$sa_relations_text['personal_4_1'] = '<font color="purple">그녀 같은 부류와 나눌 건 아무것도 없다</font>, 진짜로 아무것도.'
$sa_relations_text['personal_4_2'] = '이 세상에서는 각자도생이다, 그리고 <font color="purple">나는 그녀를 도와주지 않을 것이다</font>.'
$sa_relations_text['personal_4_3'] = '나는 <font color="purple">그녀를 믿지 않는다</font>. 저런 부류에게서 좋은 걸 기대하는 데 익숙하지 않다.'
$sa_relations_text['personal_4to4_1'] = '친구가 너무 그립다! 우리 <font color="green">같은 방을 쓰면 안 될까</font>?'
$sa_relations_text['personal_4to4_2'] = '나는 그녀와 <font color="green">함께 붙어 다녀야 한다고</font> 생각한다. 그래야 살아남기 쉬울 테니까.'
$sa_relations_text['personal_4to4_3'] = '그녀와 이야기해 봐야 한다, <font color="green">공통 관심사를 찾고</font>, 앞으로를 의논해야 한다.'

$sa_relations_text['personal_5_1'] = '나는 평생 가난하게 살았는데, 저런 부류는 사치 속에 살았다. 이제 <font color="red">그녀가 고생해도 싸다</font>!'
$sa_relations_text['personal_5_2'] = '저런 부류는 <font color="red">기생충</font>이다. 우리 같은 평범한 사람들이 저들의 좋은 삶 값을 치른다.'
$sa_relations_text['personal_5_3'] = '나는 그녀가 <font color="red">전혀 안 불쌍하다</font>. 왜 불쌍해야 하지? 나를 불쌍히 여긴 사람도 없었는데.'
$sa_relations_text['personal_5to5_1'] = '그녀 인생도 <font color="blue">엉망이긴 했겠지</font>. 하지만 내가 왜 신경 써야 하지?'
$sa_relations_text['personal_5to5_2'] = '또 하나의 <font color="blue">버려진 여자애</font>. 우리 같은 애들은 많다.'
$sa_relations_text['personal_5to5_3'] = '나는 그녀랑 어울리지 않을 것이다. 그녀도 <font color="blue">상황을 나만큼은 이해하고 있을 테니까</font>.'

$sa_relations_text['personal_5l_1'] = '<font color="red">어른에게 좋은 걸 기대하면 안 된다</font>. 걔들이 내게 무슨 좋은 일을 해 줬다고?'
$sa_relations_text['personal_5l_2'] = '그녀가 나한테 상냥하게 굴어 보기만 해라. 내가 <font color="red">바로 현실을 알려 줄 테니까</font>.'
$sa_relations_text['personal_5l_3'] = '그녀쯤은 쉽게 속일 수 있다. 저런 인간들은 다 <font color="red">내가 자기 연민을 바란다고 생각한다</font>.'

$sa_relations_text['personal_lto1_1'] = '아니, 진짜로 그녀가 <font color="green">진짜 공주</font>라는 거야?! 동화처럼?!'
$sa_relations_text['personal_lto1_2'] = '솔직히 말하면, 나는 원래부터 <font color="green">공주를 좋아했다</font>. 뭐, 모든 여자애들이 그렇겠지만.'
$sa_relations_text['personal_lto1_3'] = '내가 <font color="green">그녀의 시녀나 말동무</font>가 될 수도 있을까. 꿈이라도 꿔도 되지?'
$sa_relations_text['personal_lto2345_1'] = '그녀는 나보다 나이가 많다. 혹시 <font color="green">내 언니 같은 존재</font>가 되어 줄까?'
$sa_relations_text['personal_lto2345_2'] = '나이 많은 여자가 곁에 있으면 좋다. 왠지 <font color="green">더 안심된다</font>.'
$sa_relations_text['personal_lto2345_3'] = '적어도 나보다는 삶을 더 잘 알고 있을 테니까. 나는 <font color="green">그녀를 따라다닐 것이다</font>.'

$sa_relations_text['personal_goodtol_1'] = '아, <font color="green">정말 안쓰럽다</font>. 이런 세상은 여자애가 버틸 곳이 아니다.'
$sa_relations_text['personal_goodtol_2'] = '어쨌든 나는 이 여자애를 <font color="green">도와주려고 노력할 것이다</font>. 그게 옳다.'
$sa_relations_text['personal_goodtol_3'] = '<font color="green">슬픈 일이다</font>, 이렇게 어린 여자애가 이런 세상에 오다니. 무슨 죄를 지었다고 이런 일을 당해야 하지?'
$sa_relations_text['personal_badtol_1'] = '나는 <font color="red">이 애새끼랑 씨름하고 싶지 않다</font>, 그런 건 원한 적도 없다.'
$sa_relations_text['personal_badtol_2'] = '여기가 무슨 귀한 아가씨들 학교라도 되나? <font color="red">내가 무슨 선생 노릇까지 해야 하나</font>.'
$sa_relations_text['personal_badtol_3'] = '내게 별 도움이 될 것 같지도 않다. <font color="red">뭘 기대하겠나</font>? 아직 애나 다름없는데.'

$sa_relations_text['personal_ltolh_1'] = '이 여자애는 <font color="red">콧대가 높다</font>. 대체 어떻게 다가가라는 거지?'
$sa_relations_text['personal_ltolh_2'] = '나는 그녀와 친해질 수 없을 것 같다 - 우리 사이에는 <font color="red">너무 큰 차이</font>가 있다.'
$sa_relations_text['personal_ltolh_3'] = '<font color="red">사람이 날 내려다보는 건</font> 불쾌하다. 친구가 될 수 있을 것 같지 않다.'
$sa_relations_text['personal_ltoll_1'] = '근데 그녀는 너무 <font color="red">남루하다</font>! 내가 어떻게 그녀랑 친구를 하지?'
$sa_relations_text['personal_ltoll_2'] = '나도 친구 하나쯤 있으면 좋겠지만, 솔직히 그녀는 <font color="red">내게 별로 어울리지 않는다</font>.'
$sa_relations_text['personal_ltoll_3'] = '대체 누구지? 하녀 딸인가? 아니면 창녀 딸인가? <font color="red">내 급이 아니다</font>.'
$sa_relations_text['personal_ltol_1'] = '<font color="green">다행인 건</font> 그녀가 나랑 비슷한 나이라는 점이다. 만약 어른 여자였다면 어땠을까? 히히.'
$sa_relations_text['personal_ltol_2'] = '우리 둘이서 어떻게든 살아남겠지. <font color="green">적어도</font> 나이는 비슷하니까.'
$sa_relations_text['personal_ltol_3'] = '또래가 곁에 있다는 건 <font color="green">좋은 일이다</font>. 그녀와 얘기할 거리도 있다.'

$sa_relations_text['feat_int_low'] = '지능 면에서는, 안타깝게도 그녀는 <font color="red">좀 멍청하다</font>.'
$sa_relations_text['feat_int_high'] = '그녀는 <font color="red">자기가 제일 똑똑하다고 생각하는 것 같다</font>.'
$sa_relations_text['feat_int_eq_3'] = '지적으로 나와 가까운 여자애를 만난 건 <font color="green">좋은 일이다</font>.'

$sa_relations_text['feat_bea_low_1'] = '으, 너무 <font color="red">못생겼다</font>!'
$sa_relations_text['feat_bea_low_2'] = '게다가 <font color="red">못생기기까지 했다</font>.'
$sa_relations_text['feat_bea_low_3'] = '외모는 참 <font color="red">복이 없게 타고났다</font>, 불쌍하게도.'
$sa_relations_text['feat_bea_high_1'] = '게다가 저건 완전 <font color="red">치장한 멍청한 년</font>이다!'
$sa_relations_text['feat_bea_high_2'] = '자기가 그렇게 예쁘다고, <font color="red">남들보다 우월하다고 생각하는 모양이다</font>.'
$sa_relations_text['feat_bea_high_3'] = '저렇게 예쁜 여자애 앞에 있으면 나는 <font color="red">주눅이 든다</font>.'
$sa_relations_text['feat_bea_eq_good_1'] = '우리 <font color="green">예쁜 여자들</font>은 서로 도와야 한다.'
$sa_relations_text['feat_bea_eq_good_2'] = '그녀는 <font color="green">나만큼은 아니어도 거의 비슷하게 예쁘다</font>.'
$sa_relations_text['feat_bea_eq_good_3'] = '그녀의 아름다움은 내 아름다움을 <font color="green">보완하고 돋보이게 한다</font>.'
$sa_relations_text['feat_bea_eq_bad_1'] = '저 년, 무슨 이유로 <font color="red">자기가 나보다 예쁘다고 생각하는 거지</font>?!'
$sa_relations_text['feat_bea_eq_bad_2'] = '저년은 <font color="red">거울을 너무 많이 본다</font>. 그래도 내가 더 예쁘다!'
$sa_relations_text['feat_bea_eq_bad_3'] = '당신은 그녀가 예쁘다고 생각하나? <font color="red">미적 감각이 참 이상하군</font>.'

$sa_relations_text['feat_pri_low_1'] = '쟤는 <font color="red">자존심도 없나</font>?'
$sa_relations_text['feat_pri_low_2'] = '<font color="red">비참하고 타락한 것</font>.'
$sa_relations_text['feat_pri_low_3'] = '그녀는 <font color="red">여자가 어디까지 추락할 수 있는지</font> 보여 주는 사례다.'
$sa_relations_text['feat_pri_high_1'] = '자기가 뭐라도 되는 줄 아나, 저 <font color="red">도도한 것</font>?'
$sa_relations_text['feat_pri_high_2'] = '왜 자기가 <font color="red">나를 내려다봐도 된다고 생각하는 거지</font>?'
$sa_relations_text['feat_pri_high_3'] = '자존심은 마음껏 부리라지. <font color="red">쟤도 결국 부서질 테니까</font>.'

$sa_relations_text['feat_ego_low_1'] = '쟤는 너무 <font color="red">기가 죽어 있다</font>!'
$sa_relations_text['feat_ego_low_2'] = '<font color="red">한마디도 못 꺼낸다</font>.'
$sa_relations_text['feat_ego_low_3'] = '완전히 <font color="red">줏대가 없다</font>.'
$sa_relations_text['feat_ego_high_1'] = '쟤는 <font color="green">정신력이 강하다</font>!'
$sa_relations_text['feat_ego_high_2'] = '<font color="green">강한 성격</font>을 가졌네, 그런 건 좋다.'
$sa_relations_text['feat_ego_high_3'] = '나는 그녀의 <font color="green">강한 성격이 좋다</font>.'

$sa_relations_text['feat_fat_low_1'] = '너무 마른 거 아냐 - 대체 어떻게 <font color="red">살아 있는 거지</font>?'
$sa_relations_text['feat_fat_low_2'] = '병적으로 말랐다 - 분명 <font color="red">어딘가 아픈 거다</font>.'
$sa_relations_text['feat_fat_low_3'] = '<font color="red">거식증</font>인가? 아니면 그냥 한 달 동안 굶은 건가?'
$sa_relations_text['feat_fat_high_1'] = '근데 너무 <font color="red">뚱뚱하다</font>!'
$sa_relations_text['feat_fat_high_2'] = '끔찍하다, 대체 왜 그렇게 <font color="red">많이 처먹는 거지</font>?'
$sa_relations_text['feat_fat_high_3'] = '너무 <font color="red">뚱뚱하다</font> - 혹시 무슨 병이라도 있는 건가?'

$sa_relations_text['itog_-5_1'] = '나는 그녀가 <font color="red">싫다</font>!'
$sa_relations_text['itog_-5_2'] = '나는 <font color="red">그녀를 증오한다</font>.'
$sa_relations_text['itog_-5_3'] = '전반적으로, <font color="red">정말 드물게 보는 개같은 년</font>이다.'

$sa_relations_text['itog_-4_1'] = '나는 그녀를 <font color="red">경멸한다</font>!'
$sa_relations_text['itog_-4_2'] = '<font color="red">구역질나는 인간</font>, 다른 말이 없다.'
$sa_relations_text['itog_-4_3'] = '그녀와의 대화는 <font color="red">최소한으로 줄이고 싶다</font>.'

$sa_relations_text['itog_-3_1'] = '어떻게 그렇게 <font color="purple">재수 없을 수가 있지</font>?'
$sa_relations_text['itog_-3_2'] = '얼마나 <font color="purple">불쾌한지</font>!'
$sa_relations_text['itog_-3_3'] = '그녀를 보면 <font color="purple">기분이 나빠진다</font>.'

$sa_relations_text['itog_-2_1'] = '그녀는 <font color="purple">짜증 난다</font>.'
$sa_relations_text['itog_-2_2'] = '그녀와는 절대로 <font color="purple">친구가 될 수 없을 것 같다</font>.'
$sa_relations_text['itog_-2_3'] = '나는 그녀와 <font color="purple">친구가 되지 않을 것이다</font>, 절대로.'

$sa_relations_text['itog_-1_1'] = '나는 그녀가 <font color="blue">마음에 들지 않는다</font>.'
$sa_relations_text['itog_-1_2'] = '그녀는 <font color="blue">내 타입이 아니다</font>.'
$sa_relations_text['itog_-1_3'] = '같이 지낼 수는 있겠지만, <font color="blue">그 이상은 아니다</font>.'

$sa_relations_text['itog_0_1'] = '그녀는 <font color="blue">지루하다</font>.'
$sa_relations_text['itog_0_2'] = '나는 그녀에게 <font color="blue">아무 관심도 없다</font>.'
$sa_relations_text['itog_0_3'] = '나는 그녀에게 <font color="blue">흥미가 없다</font>.'

$sa_relations_text['itog_1_1'] = '나는 그녀가 <font color="green">좋다</font>.'
$sa_relations_text['itog_1_2'] = '그녀는 <font color="green">괜찮다</font>.'
$sa_relations_text['itog_1_3'] = '그녀는 <font color="green">좋은 여자애</font>다.'

$sa_relations_text['itog_2_1'] = '나는 그녀와 <font color="green">친구가 되고 싶은 것 같다</font>.'
$sa_relations_text['itog_2_2'] = '나는 그녀와 <font color="green">친구가 될 수 있을 것 같다</font>.'
$sa_relations_text['itog_2_3'] = '나는 그녀와 <font color="green">더 가까워지려고 해 볼 것이다</font>.'

$sa_relations_text['itog_3_1'] = '그녀와 <font color="green">이야기하는 건 즐겁다</font>.'
$sa_relations_text['itog_3_2'] = '<font color="green">멋진 여자애</font>다.'
$sa_relations_text['itog_3_3'] = '나는 그녀를 <font color="green">아주 존중한다</font>.'

$sa_relations_text['itog_4_1'] = '그녀는 정말 <font color="green">멋지다</font>!'
$sa_relations_text['itog_4_2'] = '그녀는 <font color="green">훌륭한 친구</font>가 될 것 같다.'
$sa_relations_text['itog_4_3'] = '우리는 함께라면 <font color="green">많은 걸 해낼 수 있을 것 같다</font>.'

$sa_relations_text['itog_5_1'] = '나는 그녀에게 <font color="green">푹 빠졌다</font>!'
$sa_relations_text['itog_5_2'] = '나는 그녀에게 <font color="green">완전히 반했다</font>.'
$sa_relations_text['itog_5_3'] = '그녀는 불멸의 로마에서 내가 만난 것들 중 <font color="green">최고</font>다.'

$sa_relations_text['acc_itog_bad3_1'] = '그녀는 이미 나를 <font color="red">빡치게 만들었다</font>!'
$sa_relations_text['acc_itog_bad3_2'] = '그녀를 보기만 해도 나는 <font color="red">부들부들 떨린다</font>.'
$sa_relations_text['acc_itog_bad3_3'] = '그 쓰레기가 <font color="red">죽어 버렸으면 좋겠다</font>.'

$sa_relations_text['acc_itog_bad2_1'] = '언제 그 <font color="red">것</font>을 팔 건가? 아니면 고기용으로라도?'
$sa_relations_text['acc_itog_bad2_2'] = '그녀가 근처에 있는 것만으로도 <font color="red">짜증 난다</font>.'
$sa_relations_text['acc_itog_bad2_3'] = '당신이 그 <font color="red">것</font>을 파는 날만 기다리며 살고 있다.'

$sa_relations_text['acc_itog_bad1_1'] = '작은 <font color="purple">쓰레기</font>, 딱 그거다!'
$sa_relations_text['acc_itog_bad1_2'] = '그녀와 같은 집에 사는 건 <font color="purple">기분이 좋지 않다</font>.'
$sa_relations_text['acc_itog_bad1_3'] = '우리가 그녀와 <font color="purple">헤어질수록</font> 더 좋다.'

$sa_relations_text['acc_itog_indiff_1'] = '그녀는 여길 자기 집처럼 돌아다닌다. <font color="blue">좆까라지</font>.'
$sa_relations_text['acc_itog_indiff_2'] = '그녀의 존재는 내 삶에 <font color="blue">아무 영향도 없다</font>.'
$sa_relations_text['acc_itog_indiff_3'] = '그녀는 내 기분에 <font color="blue">아무 영향도 주지 않는다</font>.'

$sa_relations_text['acc_itog_good1_1'] = '그녀와 함께 있으면 <font color="green">기분이 좋다</font>!'
$sa_relations_text['acc_itog_good1_2'] = '나는 그녀와 함께 일하는 게 <font color="green">즐겁다</font>.'
$sa_relations_text['acc_itog_good1_3'] = '그녀가 우리와 함께 있어서 <font color="green">기쁘다</font>.'

$sa_relations_text['acc_itog_good2_1'] = '그녀는 <font color="green">멋지다</font>!'
$sa_relations_text['acc_itog_good2_2'] = '그녀가 우리 집에 사는 건 <font color="green">아주 좋다</font>.'
$sa_relations_text['acc_itog_good2_3'] = '설마 그녀를 <font color="green">곧 팔 생각은</font> 없는 거겠지?'

$sa_relations_text['acc_itog_good3_1'] = '나는... 내가 그녀를 <font color="green">사랑하는 것 같다</font>...'
$sa_relations_text['acc_itog_good3_2'] = '나는 <font color="green">그녀와 함께 있고 싶다</font>. 그게 가능할까?'
$sa_relations_text['acc_itog_good3_3'] = '그녀에 대한 내 감정은... <font color="green">아주 개인적인 것</font>이다.'

$sa_relations_text['refuse_talk_1'] = '그녀는 나와 말하고 싶어 하지 않는다! <font color="blue">독한 년</font>. 나중엔 말할지도 모르겠다.'
$sa_relations_text['refuse_talk_2'] = '그녀는 쏘아붙이며 <font color="blue">자기 얘기를 조금도 흥미롭게 하지 않는다</font>. 벌을 받아야 한다고 생각한다.'
$sa_relations_text['refuse_talk_3'] = '<font color="blue">협조하지 않는다</font>. 한마디도 제대로 끌어낼 수 없다. 주인님의 단호한 손이 필요하다.'

$sa_relations_rext['isolate_1'] = '주인님이 그녀와 말하지 말라고 하셔서, 나는 그러지 않는다. <font color="blue">사실 이 편이 더 쉽다</font>.'
$sa_relations_rext['isolate_2'] = '주인님의 명령대로, 나는 <font color="blue">그녀를 멀리하고 있다</font>.'
$sa_relations_rext['isolate_3'] = '주인님이 명하신 대로, 나는 그녀와 개인적인 문제로는 대화하지 않는다. 그러면 <font color="blue">내 감정을 억누르기가 더 쉽다</font>.'

$sa_relations_text['acc_itog_decaying_1'] = '나는 예전엔 <font color="red">그녀를 좋아했었다</font>! 참 나, 이게 뭐람!'
$sa_relations_text['acc_itog_decaying_2'] = '내가 왜 예전엔 <font color="red">그녀를 더 좋게 대했는지</font> 모르겠다.'
$sa_relations_text['acc_itog_decaying_3'] = '내가 예전엔 <font color="red">그녀가 어떤 년인지 몰랐다는 게</font> 믿기지 않는다.'

$sa_relations_text['acc_itog_improving_1'] = '근데 <font color="green">처음엔 나는 그녀가 소름끼친다고 생각했었다</font>!'
$sa_relations_text['acc_itog_improving_2'] = '왠지 전에는 그녀가 싫었다. <font color="green">하지만 나쁜 애는 아니다</font>.'
$sa_relations_text['acc_itog_improving_3'] = '내가 <font color="green">그녀의 좋은 점을 볼 수 있게 되어서</font> 기쁘다.'

$sa_relations_text['jealousy_1'] = '주인님, 그녀는 당신 앞에서 <font color="purple">엉덩이를 너무 흔들어 댄다</font>.'
$sa_relations_text['jealousy_2'] = '그리고 <font color="purple">당신은 그녀의 어디가 그렇게 좋은 건가요</font>, 제게 없는 게 뭐죠?'
$sa_relations_text['jealousy_3'] = '주인님, 제 생각엔 당신이 <font color="purple">그녀에게 너무 많은 관심을 주고 있는 것 같습니다</font>.'

$sa_relations_text['jealousy3_1'] = '주인님, 그녀는 당신 곁을 너무 맴돌아서 <font color="red">그년 눈을 긁어 버리고 싶다</font>.'
$sa_relations_text['jealousy3_2'] = '주인님, 저는 그녀 때문에 <font color="red">너무 질투가 납니다</font>. 저도 주인님의 관심이 필요해요!'
$sa_relations_text['jealousy3_3'] = '감히 말씀드리기 어렵지만, 주인님이 그녀에게 그렇게 많은 관심을 주시는 게 <font color="red">몹시 마음이 상합니다</font>.'

$prise_erotic_assistant[2] = '당신은 조수에게 옷을 벗고 엎드리라고 명령한 뒤, 마사지 오일 병을 들고 그녀의 전신을 부드럽게 주무르며 반 시간을 보낸다.'
$prise_erotic_assistant[5] = '당신은 조수에게 옷을 벗고 누우라고 명령한다. 그녀의 다리 사이에 편하게 자리를 잡은 뒤, 손까지 써 가며 그녀의 보지를 부드럽게 키스하고 핥기 시작한다.'
$prise_erotic_reaction_assistant['reluctant'] = "당신의 손 아래에서 <<$assistant_name>>가 긴장하고 굳어 있는 것이 느껴진다. 그녀는 당신의 애무를 온전히 받아들이기 어렵다."
$prise_erotic_reaction_assistant['arrogant'] = "<<$assistant_name>>는 이런 상황에서도 거만하게 행동하는 데 성공한다."
$prise_erotic_reaction_assistant['hateful'] = "조수는 입술을 완고하게 다문 채 있다. 끊임없이 당신을 밀어내려 하지만, 무언가가 그녀를 그런 경솔한 행동에서 멈추게 한다."
$prise_erotic_reaction_assistant['resistant'] = "조수는 입술을 완고하게 다문 채 있다. 몸을 빼려 하지는 않지만, 당신이 하는 일을 자기가 얼마나 즐기고 있는지 어떻게든 드러내지 않으려 애쓴다."
$prise_erotic_reaction_assistant['lachrymose'] = "<<$assistant_name>>는 깊게 숨을 들이쉬고 흐느낀다 - 흥분 때문인지, 아니면 그저 습관 때문인지."
$prise_erotic_reaction_assistant['soft'] = "<<$assistant_name>>는 당신의 애무를 기쁘게 받아들인다. 그녀가 그것을 정말 즐기고 있다는 게 분명하다."
$prise_erotic_reaction_assistant['servile'] = "<<$assistant_name>>는 당신의 애정에 격렬하게 반응하며, 당신의 행동에 완전히 몸을 맡긴다."
$prise_erotic_reaction_assistant['frightened'] = "당신의 손 아래에서 <<$assistant_name>>가 긴장하고 굳어 있는 것이 느껴진다. 당신이 그녀를 다치게 할까 봐 겁내는 것 같다."
$prise_erotic_reaction_assistant['obedient'] = "<<$assistant_name>>는 당신의 애무를 기쁘게 받아들인다."
$prise_erotic_reaction_assistant['broken'] = "<<$assistant_name>>는 당신의 애무에 아무런 반응도 보이지 않는다. 그녀의 몸은 마땅히 그래야 하듯 흥분해 있지만, 정신은 어딘가 멀리 가 있다."
$prise_erotic_reaction_assistant['depresive'] = "<<$assistant_name>>는 깊게 숨을 들이쉬고 흐느낀다. 흥분 때문인지, 아니면 우울 때문인지."
$prise_erotic_reaction_assistant['horny'] = "<<$assistant_name>>는 당신의 애무를 대단한 열정과 끝없는 탐욕으로 받아들인다. 그녀는 멈추고 싶어 하지 않으며, 당신에게 자신을 박아 달라고 애원한다."
$prise_erotic_reaction_assistant['hysteric'] = "<<$assistant_name>>는 당신의 애무를 기쁘게 받아들인다."
$compliment_description_assistant[3] = '당신은 조수를 따뜻하게 안아 주며, 그녀가 불멸의 로마 최고의 조수이고 그녀의 도움이 당신에게 얼마나 값진지 말해 준다.'
$compliment_plus_assistant = "<<$assistant_name>>는 당신의 말에 완전히 기뻐한다. 그녀가 얼마나 인정과 승인을 필요로 하는지 놀라울 정도다."
$compliment_reaction_assistant['reluctant'] = "<<$assistant_name>>는 다소 마지못해 당신의 칭찬을 받아들인다. 친절한 말 자체는 분명 고맙게 여기지만, 아직 당신이 자신을 평가할 권리가 있다는 생각에는 익숙해지지 못했다."
$compliment_reaction_assistant['arrogant'] = "<<$assistant_name>>는 당신의 칭찬을 당연하게 받아들이며 더 거만해질 뿐이다. 이런 말에 그녀가 흔들릴 거라고 기대하긴 어렵다."
$compliment_reaction_assistant['hateful'] = "<<$assistant_name>>는 마치 당신이 불쾌한 말을 한 것처럼 당신을 바라본다. 어쨌든 자신이 당신을 기쁘게 했다는 사실 자체가 마음에 들지 않는 모양이다."
$compliment_reaction_assistant['resistant'] = "<<$assistant_name>>는 당신의 말을 담담히 들으며, 고집스럽게 계속 시선을 옆으로 돌리고 있다."
$compliment_reaction_assistant['lachrymose'] = "당신의 친절한 말에 <<$assistant_name>>는 잠시 울음을 멈추고 옅게나마 미소까지 보이지만, 얼굴에는 여전히 슬픔이 남아 있다."
$compliment_reaction_assistant['soft'] = "<<$assistant_name>>는 당신의 친절한 말을 고맙게 여긴다는 뜻으로 고개를 끄덕이며 살짝 미소 짓는다."
$compliment_reaction_assistant['servile'] = "<<$assistant_name>>는 당신의 친절한 말에 진심으로 감사를 표하고, 자신은 그런 영광을 받을 자격이 없지만 사랑하는 주인을 기쁘게 하기 위해 최선을 다하겠다고 덧붙인다."
$compliment_reaction_assistant['frightened'] = "<<$assistant_name>>는 당신을 경계하는 눈빛으로 바라본다. 마치 이 친절한 말 뒤에 욕설이나 매질이 따라올까 두려워하는 것처럼."
$compliment_reaction_assistant['obedient'] = "<<$assistant_name>>는 얌전히 바닥을 보며 당신의 말을 듣고, 주인의 친절에 정중히 감사한다."
$compliment_reaction_assistant['broken'] = "<<$assistant_name>>는 무표정한 얼굴로 칭찬을 받아들인다. 그녀가 정말 당신 말을 듣고 있는지조차 알 수 없다."
$compliment_reaction_assistant['depresive'] = "<<$assistant_name>>는 당신의 친절한 말을 듣지만, 여전히 똑같이 우울하다."
$compliment_reaction_assistant['horny'] = "<<$assistant_name>>는 미소로 되받아 주며, 자신과 섹스하고 싶은지 묻는다."
$compliment_reaction_assistant['hysteric'] = "<<$assistant_name>>는 마치 이런 말만 기다렸다는 듯 만족스럽게 고개를 끄덕이며 듣는다."
$date_description_assistant[3] = '비록 환상에 불과할지라도, 해변은 끝없는 하늘과 물의 너비를 즐길 수 있는 불멸의 로마의 유일한 장소다. 활동적인 휴식을 보내기에 이보다 더 좋은 곳을 상상하기 어렵다. 당신 자신도 여기서 노는 걸 마다하지 않을 것이다.'
$date_description_assistant[4] = '당신은 조수를 데리고 쇼를 보러 가 함께 쉬고 즐기기로 한다. 물론 당신이 가장 흥미를 느끼는 공연을 고르지만, <<$assistant_name>> 역시 이런 세련된 오락에는 감사해야 할 것이다.'
$date_description_assistant[5] = '당신은 조수를 데리고 카미라 구역의 이국적인 식당들 중 한 곳으로 간다. 수상한 손님들이 많긴 하지만, 이곳에서는 잘 먹고 편히 쉴 수 있다는 걸 당신은 확신한다. 큰 도시에서는 결국 알맞은 장소를 아는 것이 가장 중요하다!'
$date_treesome_description[1] = '오늘 당신은 노예와 조수 둘 다를 식당에 데려간다. 둘은 훌륭한 에스코트가 되어 줄 것이고, 당신은 벌써부터 한 번에 여자 둘을 거느릴 형편이 안 되는 경쟁자들과 다른 손님들의 부러운 시선을 기대하고 있다.'
$date_treesome_description[2] = '오늘은 당신의 두 여자 모두가 보상을 받을 만하다고 판단한 당신은 함께 해변으로 가는 외출을 마련한다. 태양과 바다가 환상이라는 사실도 당신 기분을 망치지는 못할 것이다 - 적어도 뜨거운 모래만큼은 진짜니까. 그리고 해변에서 보내는 시간은 언제나 여자 둘과 함께일 때 더 즐겁다.'
$date_result_assistant[1] = '<<$assistant_name>>가 당신 곁에서 불편해하고 있다는 게 분명하다. 그녀는 거의 말하지 않고 전혀 긴장을 풀지 못한다 - 두려워하는 것인지, 아니면 도망칠 기회만 노리는 것인지. 이번 데이트가 그녀의 기분을 크게 끌어올려 주지는 못했을 것이다. 다만 당신 자신은 즐거운 시간을 보냈다.'
$date_result_assistant[2] = '<<$assistant_name>>는 말수가 적고 쉽게 다가오진 않지만, 환경이 바뀌자 분명 어느 정도 흥미를 보인다. 전반적으로 이번 데이트는 실패보다는 성공에 더 가깝다고 볼 수 있다.'
$date_result_assistant[3] = '<<$assistant_name>>는 분위기 전환을 분명 즐기고 있으며, 눈에 띄게 더 밝아졌다. 아직 완전히 자유롭게 행동하지는 않지만, 전반적으로 데이트는 꽤 잘 흘러가고 있다.'
$date_result_assistant[4] = '<<$assistant_name>>는 눈에 띄게 활기를 되찾고, 주위를 큰 흥미로 바라본다. 당신과 이야기하는 것도 즐기고, 심지어 웃기까지 한다. 분위기 전환은 분명 조수에게 좋은 영향을 주고, 기분도 눈에 띄게 좋아지게 만든다.'
$date_result_assistant[5] = '<<$assistant_name>>는 당신과의 데이트에 완전히 들떠 있다. 당신들은 좋은 친구처럼 많이 이야기하고, 많이 웃는다. 집으로 돌아왔을 때 조수의 눈은 행복으로 빛나고 있다. 그녀의 기분은 확실히 좋아졌다.'
$date_treesome_result[1] = '<<$slave_name>>가 당신 곁에서 불편해하고 있다는 게 분명하다. 그녀는 거의 말하지 않고 도무지 긴장을 풀지 못한다 - 두려워하는 것인지, 아니면 도망칠 기회만 노리는 것인지. 이번 데이트가 그녀의 기분을 크게 끌어올려 주지는 못했을 것이다. 다만 당신 자신은 즐거운 시간을 보냈고, <<$assistant_name>>도 아주 즐겁게 보내며 당신의 저녁을 더 밝게 만들어 주었다.'
$date_treesome_result[2] = '<<$slave_name>>는 말수가 적고 쉽게 다가오지는 않지만, 분위기 전환이 그녀의 흥미를 어느 정도 깨우는 것은 눈에 띈다. 그녀는 조수와 몇 마디 말을 주고받았고, <<$assistant_name>>도 친절하게 받아 주었다. 그건 좋은 징조다. 전반적으로 이번 데이트는 실패보다는 성공에 더 가깝다고 볼 수 있다.'
$date_treesome_result[3] = '<<$slave_name>>는 분위기 전환을 분명 즐기고 있으며 눈에 띄게 밝아진다. 그녀가 완전히 자유롭게 행동하는 건 아니지만, 전반적으로 데이트는 꽤 잘 흘러가고 있다. 훈련 중인 쪽의 어색함도, <<$assistant_name>>가 곁에 있는 덕분에 그리 두드러지지 않는다.'
$date_treesome_result[4] = '<<$slave_name>>는 눈에 띄게 활기를 되찾고 주위를 큰 흥미로 둘러본다. 그녀는 조수에게 뭔가 재미있는 이야기를 건네고, <<$assistant_name>>는 웃음으로 받아친다. 분위기 전환은 두 여자 모두에게 분명 좋은 영향을 주며, 기분도 눈에 띄게 좋아지게 만든다.'
$date_treesome_result[5] = '<<$slave_name>>와 <<$assistant_name>>는 당신과의 데이트에 완전히 들떠 있다. 셋은 좋은 친구처럼 많이 이야기하고 많이 웃는다. 집으로 돌아왔을 때 두 여자의 눈은 행복으로 빛나고, 심지어 손까지 잡고 있다. 그녀들의 기분은 확실히 좋아졌다.'
$verbal_abuse_description_assistant[1]= "엄한 목소리로, 조수 자리를 맡길 만큼 그녀를 믿어 주었지만 이제는 정말 그럴 자격이 있는지 확신이 서지 않는다고 일러 둔다."
$abuse_torture_reaction_assistant['reluctant'] = "<<$assistant_name>>는 조금 겁을 먹은 듯 보이지만, 솔직히 당신이 기대한 만큼은 아니다."
$abuse_torture_reaction_assistant['arrogant'] = "<<$assistant_name>>는 당신의 그런 무례한 대우는 용납하지 않겠다고 차갑게 말한다."
$abuse_torture_reaction_assistant['hateful'] = "<<$assistant_name>>는 무례하게 받아치며, 당신의 협박과 불만 따위는 햇빛도 안 드는 곳에 처박아 두라고 쏘아붙인다."
$abuse_torture_reaction_assistant['resistant'] = "<<$assistant_name>>는 당신의 말을 다 듣고도 한마디도 하지 않는다. 완고한 표정만 봐도, 당신의 불쾌함 따위는 조금도 신경 쓰지 않는다는 게 분명하다."
$abuse_torture_reaction_assistant['lachrymose'] = "당신의 거친 말에 <<$assistant_name>>는 울음을 터뜨리고 한동안 도무지 진정하지 못한다."
$abuse_torture_reaction_assistant['soft'] = "<<$assistant_name>>는 당신의 말을 꽤 진지하게 받아들이는 듯하지만, 타고난 낙천성 탓에 30분쯤 지나면 무슨 일이 있었는지도 잊어버릴 것 같다."
$abuse_torture_reaction_assistant['servile'] = "부끄러움에 고개를 숙인 채, <<$assistant_name>>는 자신의 잘못을 인정한다. 그리고 가능한 한 가장 가혹한 벌을 내려 달라고 애원한다."
$abuse_torture_reaction_assistant['frightened'] = "당신의 거친 말에 겁먹은 <<$assistant_name>>는 용서해 달라고 빌기 시작하고, 더 잘하겠다고 더듬거리며 약속한다."
$abuse_torture_reaction_assistant['obedient'] = "<<$assistant_name>>는 겸손하게 꾸지람을 받아들이며, 자기의 나쁜 태도를 용서해 달라고 청한다."
$abuse_torture_reaction_assistant['broken'] = "<<$assistant_name>>는 당신의 말을 무시한다. 아무런 신경도 쓰지 않는 것처럼 보인다."
$abuse_torture_reaction_assistant['depresive'] = "<<$assistant_name>>는 고개를 숙인 채 당신의 말을 듣는다. 어차피 미래에 좋은 일이 있을 거라 기대조차 하지 않는 것처럼 보인다."
$abuse_torture_reaction_assistant['horny'] = "<<$assistant_name>>는 자신의 잘못 일부를 당신에게 몸으로 갚아도 되겠냐고 묻는다."
$abuse_torture_reaction_assistant['hysteric'] = "<<$assistant_name>>는 히스테릭하게 반응한다. 자기가 당신을 위해 이렇게나 많은 걸 하는데, 당신이 완전히 부당하게 자신을 거칠게 대한다며 울고 소리친다."
$flagelation_description_assistant[1]= "당신은 집 슬리퍼를 집어 들고 조수를 무릎 위에 엎어 놓은 뒤, 드러난 엉덩이에 크고 요란한 매질을 열두 대 가한다. 민감하고 굴욕적이면서도, 동시에 몸에는 전혀 해롭지 않은 벌이다."
$light_torture_reaction_assistant['reluctant'] = "벌을 받는 동안 <<$assistant_name>>는 고통에 비명을 지르며 몸을 비틀고 웅크려, 매질을 피하려 든다. 당신이 놓아주자 그녀는 아픈 곳을 부여잡은 채 구석으로 숨는다. 눈에는 원망과 굴욕의 눈물이 맺혀 있다."
$light_torture_reaction_assistant['arrogant'] = "<<$assistant_name>>는 입술을 꽉 다문 채 벌을 받아들이며, 온몸으로 자기는 아프지 않다는 걸 드러내려 한다. 악의로 쉭쉭거리는 목소리로 당신을 저주하고 협박을 퍼부으며, 오늘 한 일의 대가를 반드시 치르게 될 거라고 말한다."
$light_torture_reaction_assistant['hateful'] = "<<$assistant_name>>는 필사적으로 발버둥 치며 온갖 방식으로 벌을 거부한다. 그녀는 크게 소리치지만, 그건 고통보다 분노 때문인 듯하다. 분노로 쉭쉭거리는 목소리로 당신을 저주하고 협박을 퍼부으며, 오늘 한 일의 대가를 반드시 치르게 될 거라고 말한다."
$light_torture_reaction_assistant['resistant'] = "<<$assistant_name>>는 눈 하나 깜빡하지 않고 벌을 견디며, 그저 말없이 당신의 손아귀에 저항하고 몸을 빼내려 할 뿐이다. 온몸으로 당신이 자기 의지를 꺾을 수는 없다는 걸 보여 주려 한다."
$light_torture_reaction_assistant['lachrymose'] = "<<$assistant_name>>는 크게 비명을 지르며 그만두라고 애원한다. 눈에서는 눈물이 줄줄 흐른다. 벌이 끝난 뒤에도 한동안 구석에서 흐느끼며, 횡설수설 울부짖고 자기의 잔혹한 운명을 한탄한다."
$light_torture_reaction_assistant['soft'] = "<<$assistant_name>>는 고통에 울부짖으며 당신의 팔 안에서 움찔거린다. 거의 벗어나려 들지는 않지만, 당신의 친절과 자비를 기대하는 듯 자신을 다치게 하지 말아 달라고 애원한다."
$light_torture_reaction_assistant['servile'] = "<<$assistant_name>>는 절대적인 복종 속에 벌을 받아들인다. 살짝 몸을 움찔하고 아픔에 낑낑거리긴 하지만, 자신을 지키려는 시도는 전혀 하지 않는다. 당신이 놓아주자, 그녀는 겸손하게 벌에 감사하며 다정하게 당신의 발에 입을 맞춘다."
$light_torture_reaction_assistant['frightened'] = "<<$assistant_name>>는 마치 당신이 정말 끔찍한 짓이라도 하고 있는 것처럼 발버둥 치고 고통에 비명을 지른다. 눈물에 목이 메어 그만두라고 애원한다. 벌이 끝난 뒤에도 조수는 계속 울고 두려움에 떨고 있다."
$light_torture_reaction_assistant['obedient'] = "<<$assistant_name>>는 절대적인 복종 속에 벌을 받아들인다. 살짝 몸을 움찔하고 아픔에 낑낑거리긴 하지만, 자신을 지키려는 시도는 전혀 하지 않는다. 당신이 놓아주자, 그녀는 온몸으로 자신이 부끄러워하고 있으며 이번 일로 교훈을 얻었다는 걸 보이려 한다."
$light_torture_reaction_assistant['broken'] = "<<$assistant_name>>는 완전한 무관심 속에 벌을 받는다. 고통에도 아무 반응을 보이지 않고, 자신을 지키거나 달아나려는 시도조차 하지 않는다. 아무것도 느끼지 못하는 건지, 아니면 그냥 아무 상관도 없는 건지 모를 정도다."
$light_torture_reaction_assistant['depresive'] = "<<$assistant_name>>는 순종적으로 벌을 받아들인다. 몸을 움찔하고 낮게 고통을 흘리며 눈에는 눈물이 가득하다. 벌이 끝난 뒤에도 한동안 구석에서 조용히 울고 있다."
$light_torture_reaction_assistant['horny'] = "<<$assistant_name>>는 딱히 자신을 지키려 들지는 않지만, 당신의 팔 안에서 몸을 비틀며 자기 가슴과 보지를 당신에게 문지르려 한다. 길게 늘어지는 신음이 고통 때문인지 흥분 때문인지 구분하기조차 어렵다."
$light_torture_reaction_assistant['hysteric'] = "<<$assistant_name>>는 날카롭게 비명을 지르며 발버둥 치고, 이 벌은 완전히 부당하다며 당장 자기를 놔주라고 소리친다. 당신이 조수를 풀어 주자, 그녀는 상처받은 눈빛으로 당신을 바라보며 즉시 자기에게 사과해야 한다고 말한다."


!Viner
! JO9 MOD START J9M2534 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$zooferma_info[0] = '[바이너]<br>&nbsp;'
$zooferma_info[1] = '[바이너]<br>&nbsp;해냈습니다! 마침내 수년에 걸친 실험을 완성해 냈어요! 이터널 시티에서 저를 믿지 않았던 자들은 전부 틀렸습니다! 저와 제 동료들은 로마의 어느 주민도 없어서는 안 될 무언가를 만들어 냈습니다!'
$zooferma_info[2] = '[바이너]<br>&nbsp;이제 제 소녀들 덕분에, 저는 마침내 부와 명성을 손에 넣게 될 겁니다. 저를 믿지 않았던 자들은 부러움에 이를 갈게 될 테고요!... 흠! 흠! 죄송합니다, <<$master_name>>. 잠깐 참지 못했군요... 아직도 감정이 저를 압도할 때가 있습니다...'
$zooferma_info[3] = '[바이너]<br>&nbsp;이제 본론으로 들어가죠. 저희가 당신께 선보일 준비가 된 것들은, 지금까지 저희가 만들어 낸 최고의 개발품입니다. 저희의 작은 몬스터 소녀들은 단순한 늑대인간도, 키마이라도 아닙니다. 그보다 더한 존재죠. 가사 운영에 있어서야말로 엄청난 돌파구입니다.'
$zooferma_info[4] = '[바이너]<br>&nbsp;저희 돼지, 소, 닭은 모두 유일무이합니다. 이 동물이 된 소녀들은 겉모습의 닮음만 흡수한 것이 아닙니다. 완벽한 유전자 코드 덕분에 구조 자체까지 물려받았죠. 그녀들은 정말로 그 품종 최고의 알을 낳고, 맛으로는 견줄 것이 없는 우유를 내놓습니다. 그리고 그 신선하고 향긋한 고기라니! 손가락까지 핥게 될 겁니다!'
$zooferma_info[5] = '[바이너]<br>&nbsp;저희의 작은 몬스터 소녀들은 농장에서 진정 대체 불가능한 요소입니다. 게다가 저희는 그 코드를 보존하는 데 성공했기 때문에, 대량 생산도 가능합니다. 농장에 가 보시면 직접 확인할 수 있을 겁니다 - 판매 준비가 끝난 돼지, 소, 산란개체들이 이미 수백 마리나 대기 중이니까요.'
! JO9 MOD END J9M2534
$zooferma_info[6] = ' [바이너]
- 저희는 이 동물들을 두 가지 버전으로 복제했습니다. 첫 번째 그룹은 어린 소녀들입니다. 아직 변형이 진행 중인 단계죠. 겉보기에는 비교적 평범한 인간에 더 가깝지만, 안쪽은 이미 동물입니다. 물론 당신이 변태라면, 아직은 인간다운 존엄을 어느 정도 남겨 둘 기회가 있긴 합니다. 다만 그 외형은 수술 없이는 되돌릴 수 없습니다.'
! JO9 MOD START J9M2533 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$zooferma_info[7] = '[바이너]<br>&nbsp;두 번째 그룹은 성숙한 암컷들입니다. 사실상 인간다운 존엄을 되돌릴 수 없을 정도로 박탈당한 상태죠. 그래요 - 암컷들입니다! 이 소녀들은 속부터 동물입니다. 행동도 그에 걸맞고요. 인간처럼 말하는 것도 조금밖에 하지 못합니다.'
$zooferma_info[8] = '[바이너]<br>&nbsp;그러니 선택하십시오, <<$master_name>>! 그리고 누굴 고르든 간에, 당신은 가정용으로 모든 의학 검사를 통과한 절대적으로 고품질의 가축을 손에 넣게 된다는 걸 알아 두십시오.'
! JO9 MOD END J9M2533

!Futaland Quests

! JO9 MOD START J9M2532 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Sisters_Menish_quest[1] = '[라다]<br>&nbsp;안녕하세요, 어린 자매 <<$master_name>>. 정말 운 좋게 왔네요! 막 하녀를 길드에 보내 주문을 넣으려던 참이었는데, 마침 당신이 왔으니... 신들이 직접 보내 준 셈이네요! 저와 제 언니는 젊고 순진한 여자애 하나가 필요하다고 합의했어요.'
$Sisters_Menish_quest[2] = '[라다]<br>&nbsp;절대 걔 보지에는 손대지 마세요. 우리보다 먼저 거기 들어갈 사람은 아무도 없어야 하니까. 하지만 나머지는 가르쳐 두세요. 특히 <font color="#008080"><b>팔과 다리를 잘 다루는 법</b></font>을요. 작고 차가운 발이 좆 위를 미끄러질 때의 감각은... 비교할 수도 없거든요. 물론 당신은 이해 못 하겠지만요 - 자연이 당신에겐 필요한 기관을 안 줬으니까.'
$Sisters_Menish_quest[3] = '[림마]<br>&nbsp;꼭 <font color="#008000"><b>목구멍 깊숙이 받아들이고 삼키는 걸 사랑하도록</b></font> 가르쳐 두세요. 진짜 걸레라면 자기 미스트리스의 정액 맛을 좋아해야 하니까. 잘 돌봐 주고요, 그녀는 <font color="#008080"><b>지구력도 좋고</b></font> 날씬해야 해요! 튀어나온 뼈나 흐물흐물한 살은 딱 질색이거든요, 으. 건강도 정말 좋아야 하고요.'
$Sisters_Menish_quest[4] = '[라다]<br>&nbsp;그리고 순전히 나만을 위해서도, 자매 <<$master_name>>. 그 여자애가 <font color="#008080"><b>춤을 잘 추게</b></font> 해 주세요. 아름다운 노예가 춤으로 미스트리스의 눈을 즐겁게 해 주는 것보다 더 좋은 건 없으니까요. 게다가 무희들은 유연성도 모자라지 않죠. 유두에는 피어싱도 잊지 마세요, 보통 링이 꽤 눈에 띄고 멋지거든요.'
$Sisters_Menish_quest[5] = '[림마]<br>&nbsp;라다, 너무 욕심내지 마. <<$master_name>>가 지금 완전히 정신 놓겠어. 문까지 배웅해 줄게요, 가죠, <<$master_name>>. 그리고 내 동생이 듣지 않는 동안... 그 작은 애한테 <font color="#008000"><b>항문 피스팅</b></font>을 가르쳐 줘. 라다는 가끔 너무 흥분해서, 첫날부터 노예를 불구로 만들까 걱정이야. 우리가 기다리고 있을게, 미녀!'
$Sisters_Menish_win[1] = '[라다]<br>&nbsp;어때, 언니?<br>[림마]<br>&nbsp;뭐, 괜찮은 것 같네...<br>[라다]<br>&nbsp;좋아요, <<$master_name>>. 이 여자애는 우리가 데려갈게요! 스파크 챙기세요!'
$Sisters_Menish_fail[1] = '[라다]<br>&nbsp;어때, 언니?<br>[림마]<br>&nbsp;뭐긴 뭐야... 그래, 뭐, 알겠네!!!...<br>[라다]<br>&nbsp;아니요, <<$master_name>>. 우리가 원하던 여자애는 이런 애가 아니에요!'
! JO9 MOD END J9M2532

! JO9 MOD START J9M2531 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Adriana_quest[1] = '[아드리아나]<br>&nbsp;안녕하세요, <<$master_name>>. 당신이 노예를 잘 훈련시킨다는 소문은 들었어요. 물론 여자가 여자를 훈련시킨다는 건 나로선 별로 믿음이 안 가지만... 그래도 기회는 한 번 주죠.'
$Adriana_quest[2] = '[아드리아나]<br>&nbsp;빌어먹을 바티칸 창녀들이 내 노예들을 전부 끌고 가 버렸어. 임신했다고 뭐가 어쨌다고! 나중 단계에서 애는 없애 버렸을 텐데, 그년들은 내 말을 들으려 하지도 않았지. 전부 불타 버렸으면...'
$Adriana_quest[3] = '[아드리아나]<br>&nbsp;그러니까, <<$master_name>>, 잘 들어. 어떤 살아 있는 사람에게나 필요한 게 뭐겠어? 당연히, 강한 자지가 자기 안으로 들어오기를 몹시도 바라는 <font color="#008080"><b>아름답고</b></font>, 상냥하고, 젊은 여자지. 내게 <font color="#0000CD"><b>노래도 부르고</b></font> <font color="#0000CD"><b>뭔가 요리도 하게</b></font> 해. 가끔은 로맨틱하게 저녁을 보내고 싶거든, 안 그러면 침묵 속에 앉아 있는 건 지루하니까.'
$Adriana_quest[4] = '[아드리아나]<br>&nbsp;아무것도 못 하는 창녀를 어디다 쓰겠어? 걔는 반드시 <font color="#008080"><b>나를 제대로 만족시켜야 하고</b></font>, <font color="#008080"><b>날 품어 달라고 매혹적으로 애원할 줄도 알아야 하며</b></font>, 물론 혀도 잘 써야 해.'
$Adriana_quest[5] = '[아드리아나]<br>&nbsp;그리고 특별한 부탁이 하나 더 있어. 걔는 임신한 상태여야 해. 물론 당신이 직접 임신시킬 수는 없겠지만, 길드 동료들에게 부탁하면 되겠지. 그런 부탁을 거절할 사람은 없을 거라고 확신해. 다만 꼭 검사는 해 둬 - 당신네 남자들이 무슨 개같은 병을 옮겼는지 누가 알겠어?'
$Adriana_win[1] = '[<<$slave_name>>]<br>&nbsp;미스트리스, 당신 것은 정말 군침 돌 정도로 멋지네요! 그리고 어찌나... 커다란지!!! 음! 저는 임신 중이라 미래의 아이를 돌봐야 하는 몸인데도, 당신 같은 여왕을 보고 나니 이 더러운 창녀 본성을 참을 수가 없어요! 이 걸레가 당신을 기분 좋게 해 드리게 허락해 주실래요?!...'
$Adriana_win[2] = '[아드리아나]<br>&nbsp;<<$master_name>>, 정말 기분 좋게 놀라게 해 줬군요!!! 이렇게... 뜨겁고! 이렇게... 음! 뭐, 무슨 뜻인지 알겠죠... 이 여자애는 내가 데려갈게요!!! 고민도 안 하고요!!! 작업해 줘서 고마워요, <<$master_name>>! 다만 너무 서운해하진 마세요! 더 주고 싶어도, 지금은 스파크 사정이 좋지 않아서 그 이상은 도저히 못 쓰겠거든요...'
$Adriana_fail[1] = '[아드리아나]<br>&nbsp;내가 준비해 오라고 한 건 대체 어디 있지? 역시 당신은 믿을 수가 없다니까!'
! JO9 MOD END J9M2531

! JO9 MOD START J9M2530 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Ledy_Karina_quest[1] = '[레이디 카리나]<br>&nbsp;만나서 반가워요, <<$master_name>>! 제 모습이 당신을 당황하게 한 건 아니길 바라요? 저는 아름다운 정원을 벌거벗은 채 거니는 걸 정말 좋아하거든요. 누군가가 제 절묘한 몸매를 즐긴다고 해서 뭐가 문제인지도 모르겠고요. 어쨌든 저는 정말 아름다우니까! 당신도 동의하죠, <<$master_name>>?..'
$Ledy_Karina_quest[2] = '[레이디 카리나]<br>&nbsp;하지만 제가 완전히 행복해지려면 뭔가가 아직 부족해요! 저는 오래전부터 애완동물을 꿈꿔 왔답니다. 제 정원 인테리어에 인체공학적으로 잘 어울리고, 사교 행사에서도 저를 조화롭게 보완해 줄 존재 말이에요. 그리고 제 미래의 총애받는 애완을 길러 내는 일은 당신에게 맡기고 싶어요.'
$Ledy_Karina_quest[3] = '[레이디 카리나]<br>&nbsp;저는 당신을 완전히 믿고 맡기겠어요... 제게 필요한 건 예의가 좋고 <font color="#008080"><b>훈련이 잘 된</b></font> 젊은 <font color="#008080"><b>소녀</b></font>예요. 장난기 있으면서도 다정하고... <font color="#008080"><b>노래와 연기</b></font>도 잘해야 해요. 그리고 당연히 <font color="#008080"><b>아름답고</b></font> <font color="#008080"><b>완전히 건강해야</b></font> 하죠. 그런 귀여운 애를 저를 위해 길러 줄 수 있겠죠?'
$Ledy_Karina_quest[4] = '[레이디 카리나]<br>&nbsp;그리고 가장 중요한 것... 저는 이미 제 아기가 될 운명의 아이를 눈여겨봐 두었답니다. 베이누트는 빈민가에 살고 있어요. 그리고 최근 아주 예쁜 노예를 하나 들였죠. 그 애한테는 그 노예가 필요 없어요. 하지만 저는 마음에 들었답니다. 거의 저랑 판박이거든요. 그 마녀사냥꾼하고는 합의를 못 봤지만, 당신이라면 할 수 있을 것 같아요. 저를 위해 그녀의 노예를 데려와 주세요!...'
$Ledy_Karina_quest[5] = '[레이디 카리나]<br>&nbsp;그리고 한 가지 더... 저에겐 여자 하나가 더 필요해요. 성숙한... <b>큰 가슴</b></font>에 <b>젖도 잘 나오는</b></font> 여자요. 그 어미의 <font color="#008080"><b>교육, 습관</b></font>과 <font color="#008080"><b>외모</b></font> 역시 제 미래의 마시만큼이나 품위 있어야 해요. 제 아이에게는 훌륭한 자연산 젖을 먹이고, 함께 놀아 주고, 길러 주고, 돌봐 줄 엄마가 필요하거든요. 그래야 애완의 건강과 아름다움이 유지되니까요.'
$Ledy_Karina_quest[6] = '[레이디 카리나]<br>&nbsp;제가 많은 걸 요구한다는 건 알아요. 하지만 제 의뢰를 성공적으로 완수했을 때 10,000 스파크라면, 당신의 수고에 걸맞은 보상이 될 거라고 믿어요... 가세요, <<$master_name>>! 좋은 소식을 애타게 기다리고 있을게요. 이제 저도 슬슬 물러가 봐야겠네요. 이렇게 잘생긴 남자를 보고 있자니, 제 보지 위를 스치는 가벼운 바람만으로도 흥분해 버릴 것 같거든요... 그럼 또 봐요, 달링!'
$Ledy_Karina_win[1] = '[레이디 카리나]<br>&nbsp;와아! 진짜 전문가의 손길이 느껴져요! 스파크를 받을 자격이 충분하네요, <<$master_name>>! 이 우아함! 이 멋진 몸가짐! 아름답기까지 하고!... 그리고 그 엄마도 나쁘지 않네요! 완전 마시멜로 같아! 그렇게 불러야겠어요. 히히!... 패러디 암컷들! 저는 정말 만족스러워요! 훌륭한 작업을 해 줘서 다시 한 번 고마워요, <<$master_name>>!...'
$Ledy_Karina_win[2] = '[레이디 카리나]<br>&nbsp;설마 둘이 친척 관계는 아니겠지?... 흠?!... 혈통은 나중에 좀 손봐야겠네요! 하지만 그건 나중 문제고... 자, 마시, 엄마한테 가렴! 내가 머리도 해 주고, 옷도 입혀 주고, 우리 귀여운 아가의 첫 사교 외출도 하러 갈 거야!... 그리고 우리가 산책 나가 있는 동안에는 마시멜로가 네 맛있고 건강한 저녁을 책임져 줄 거란다. 알아들었지, 제피르?!...'
$Ledy_Karina_win[3] = '[레이디 카리나]<br>&nbsp;제가 손님 대접을 못 한다고 생각하진 말아요, <<$master_name>>, 하지만 저는 제 여자애들과 단둘이 있고 싶어서 더는 못 기다리겠어요! 흠!... 제 집 문은 언제나 당신에게 열려 있다는 것만 알아 두세요. 우리가 보고 싶어지면 언제든 들어오세요! 안녕, 안녕!...'
$Ledy_Karina_fail[1] = '[레이디 카리나]<br>&nbsp;이건 제가 기대했던 모습이 아니에요, <<$master_name>>! 다시 말하지만, 제게 필요한 건 훈련이 잘 된 고양이들이에요. 그중 가장 나이 많은 아이는 제 최애에게 충분할 만큼 맛있는 젖을 내줘야 하고요. 그런데 지금은 그런 게 전혀 안 보여요! 계속 일하세요! 저는 얼마든지 기다릴 준비가 되어 있으니까요.'
$vampire_twins_quest[1] = '[뱀파이어 쌍둥이]<br>&nbsp;만나서 반가워요, <<$master_name>>! 우리, <<$master_name>>... 오래전부터 <font color="#008080"><b>개</b></font>를 갖고 싶었어요! 아니면 <font color="#008080"><b>고양이</b></font>라도. 자꾸 싸우기만 하고 결정을 못 내리겠더라고요. 당신이 도와줄 수 있지 않을까요? 귀엽고, 매끈하고, 늘 껴안고 싶어지는 뭔가를 원해요. 그리고 분명히 <font color="#008080"><b>노는 걸 좋아하는 것</b></font>이어야 해요! <font color="#008080"><b>뛰고 빙글빙글 돌고</b></font>... 시끄럽게 떠들기도 하고!'
$vampire_twins_quest[2] = '[뱀파이어 쌍둥이]<br>&nbsp;가장 중요한 건, 그녀가 <font color="#008080"><b>우리 둘을 똑같이 사랑해야 한다는 것</b></font>이에요. 우리는 태어날 때부터 장난감을 함께 나눠 왔으니까, 다른 방식은 없어요. 아, 맞다, 그녀는 <font color="#008080"><b>아름다워야</b></font> 해요, 진짜 매력 덩어리로요. 왜 그런 취향인지 묻진 말아 줘요. 우릴 도와줘요! 그런 <font color="#008080"><b>여자애</b></font>를 데려와요! 보답은 할게요. 5000 스파크쯤은 분명 쓸모 있을 테니까...'
$vampire_twins_win[1] = '[뱀파이어 쌍둥이]<br>&nbsp;와, 인형 같다! 그냥 완전 미인이잖아! 정말 엄청난 일을 해냈네, <<$master_name>>! 우리가 데려갈게!'
$vampire_twins_fail[1] = '[뱀파이어 쌍둥이]<br>&nbsp;윽, 뭐야 이 역겨운 건! 우리 지금 당장 배고프다고! 저녁거리가 되기 전에 당장 눈앞에서 치워, <<$master_name>>!'
$dumak_quest[1] = '[두막]<br>&nbsp;쉬잇, 노예상인. 거절할 수 없는 제안이 있다. 너도 "하자 있는 상품" 같은 건 가끔 만나겠지, 안 그래? 온갖 <font color="#C71585"><b>가난한</b></font> 것들, <font color="#C71585"><b>병든</b></font> 것들, 침 한 번 뱉거나 바람만 훅 불어도 곧장 죽어 버릴 것들, 심지어 <font color="#C71585"><b>걸어다니는 "채소"</b></font> 같은 것들까지. 그런 여자애들은 네게 손해밖에 안 되겠지만, 나는 쓸 데가 있다. 당신은 물건을 넘기고, 나는 스파크를 준다. 어때, 거래할래?'
$dumak_win[1] = '[두막]<br>&nbsp;훌륭한 여자애군! 아주 쓸모 있게 써먹을 수 있겠어! 내가 데려가지!'
$dumak_fail[1] = '[두막]<br>&nbsp;내 취향이 아니야! 나한테 맞는 여자애를 찾아와!'
$moranga_quest[1] = '[모랑가]<br>&nbsp;안녕, 노예상인. 이 문제만큼은 네가 날 도와줄 수 있을 것 같군. 나는 내 애완들을 돌볼 여자애들을 찾고 있다. 알다시피, <font color="#C71585"><b>아름다움</b></font> 따위엔 녀석들도, 나도 관심 없다. 중요한 건 노예가 그런 특이한 생명체들을 보고 공포에 질려 소리 지르지 않고, 녀석들을 <font color="#008080"><b>기쁘게 해 줄 수 있어야</b></font> 하고, <font color="#0000CD"><b>집을 치울 줄</b></font> 알아야 하며, 자기 몸도 관리할 줄 알아야 한다는 거다.'
$moranga_quest[2] = '[모랑가]<br>&nbsp;<font color="#0000CD"><b>요리할 줄</b></font> 알아야 한다. 아, 그리고 여자애는 <font color="#C71585"><b>멍청할수록</b></font> 좋다. 똑똑한 것들은 문제만 일으키니까. 알맞은 물건을 찾으면, 낮이든 밤이든 언제든 와라.'
$moranga_win[1] = '[모랑가]<br>&nbsp;날 감탄시켰군, <<$master_name>>! 네가 괜히 이 일로 밥 벌어먹는 게 아니라는 게 바로 보인다! 이건 내가 데려간다!'
$moranga_fail[1] = '[모랑가]<br>&nbsp;내가 원하는 게 전혀 아니군. 이건 안 받는다!'
$ladonna_quest[1] = '[라돈나]<br>&nbsp;아, <<$master_name>>, 혹시 동물 농장에는 가 봤어? 거기 있는 그 작은 야수인들 전부 봤어? 너무 귀엽긴 한데, 다 비슷비슷하게 생겨서 말이야. 난 좀 더 특별한 게 갖고 싶어... 예를 들면 <font color="#008000"><b>젖소</b></font>인데, 날씬하고 <font color="#008080"><b>아름다운</b></font> 아이 말이지. 그런 애를 데려오면, 스파크뿐만 아니라 키스도 해 줄게. 아하하하...'
$ladonna_win[1] = '[라돈나]<br>&nbsp;사랑스러워! 진짜 말이 안 나올 정도야, <<$master_name>>! 이건 내가 데려갈게! 약속한 키스도 줄게. 이리 와, 달링!'
$ladonna_fail[1] = '[라돈나]<br>&nbsp;내가 딱 원하던 건 아니네, <<$master_name>>. 뭔가 끌리는 건 있지만, 내가 바라던 바로 그건 아니야.'
$yagishna_quest[1] = '[노파 야기슈나]<br>&nbsp;네 소문은 한 마법사한테 들었다, 얘야. 영리하다고 하더구나... 영리하고 스파크에도 눈이 밝다고. 뭐라 하진 말아라, 알다시피 내 형편이 안 좋아서 말이지. 그래서 일값은 물건으로 더 얹어 줄 생각이다. 그러니 내게 필요한 건 피와 젖의 <font color="#008080"><b>여자애</b></font>다...'
$yagishna_quest[2] = ' <font color="#008080"><b>아름다워야</b></font> 손님을 가게로 끌어오고, <font color="#008080"><b>영리해야</b></font> 말로 홀려서 <font color="#008080"><b>수익 계산도</b></font> 할 수 있지. '
$yagishna_quest[3] = '[노파 야기슈나]<br>&nbsp;<font color="#008080"><b>치유와 마법도</b></font> 알아야 한다... 그런 미묘한 학문을 모르면 뭔가를 망쳐 놓을 게 뻔하고, 그러면 죄 없는 늙은이가 뒤집어쓰게 되잖니, 에휴. 아, 그리고 제일 중요한 걸 깜빡할 뻔했네! 늙는다는 건 좋은 일이 아니지. 이 여자애는 <font color="#008080"><b>괴물들을 좋아해야 한다</b></font>: 마물을 짜고, 거미를 쓰다듬고, 바다 것들도 마찬가지로 말이야...'
$yagishna_quest[4] = '[노파 야기슈나]<br>&nbsp;이건 재미로 하는 게 아니라 장사다. 설마 물약이 샘물만으로 만들어진다고 진짜 믿는 건 아니겠지, 히히?'
$yagishna_win[1] = '[노파 야기슈나]<br>&nbsp;오호, 얘야, 늙은이를 기쁘게 해 줬구나! 이제 장사가 잘 되겠어. 약속한 대로 여기 네 스파크와 물약이다. 이건 죽은 남자라도 흥분시킬 거야, 뭐 흥분시킬 게 남아 있다면 말이지, 헤헤. 그리고 이걸 쓰면 어떤 여자든 널 사랑하게 만들 수 있어. 현명하게 써라, 어린 매야. 아아, 백 년만 덜 먹었어도...'
$yagishna_fail[1] = '[노파 야기슈나]<br>&nbsp;아니, 얘야, 이건 안 된다! 이건 내가 바라던 게 전혀 아니야. 늙었어도 엉터리 일감은 바로 알아본단다...'
$dragon_quest[1] = '[사나운 코린스트라즈]<br>&nbsp;앉아서 들어라, 피가죽아. 난 같은 말을 반복하는 걸 좋아하지 않는다. 첫째, 내겐 <font color="#008080"><b>아름다운</b></font> 어린... 순결한 처녀가 필요하다. 아, 나를 속일 생각은 하지 마라. 너희 노예상인들 수법쯤은 안다. 먼저 그 계집을 더럽혀 놓고는, 그다음엔 "뱀들"에게 달려가 이류 상품이나 떠넘기겠지. 내 주문품의 피부를 문신이나 피어싱으로 망치지 마라. 다만, 그 처녀가 내 영광스러운 모습을 보고도 발악하거나 기절만 하지 않는다면,'
$dragon_quest[2] = '[사나운 코린스트라즈]<br>&nbsp;그건 오히려 기쁨일 뿐이다. 그녀가 능숙하게 <font color="#0000CD"><b>동물 흉내도 내고</b></font>, 온갖 <font color="#0000CD"><b>노래와 춤</b></font>으로 날 즐겁게 해 주도록 해라... 그리고 더 잘 살찌워 둬라, 알다시피 난 기름진 고기를 좋아하니까...'
$dragon_quest[3] = '[사나운 코린스트라즈]<br>&nbsp;둘째, 용조차 가끔은 잠을 자야 하니, 호위 없이는 어디에도 갈 수 없다... 맨손으로도 <font color="#0000CD"><b>황소를 죽일 수 있는 여자애</b></font>를 찾아와라. <font color="#0000CD"><b>미인은 아니어도, 그렇다고 못생기지도 않은</b></font>, <font color="#008080"><b>건강한</b></font>,'
$dragon_quest[4] = '[사나운 코린스트라즈]<br>&nbsp;강하고... 또 나를 닮았으면 좋겠다. 그녀의 흉터와 갈라진 혀만 봐도 모든 악의적인 놈들이 두려움에 떨 수 있도록. 그 노예는 네가 마음대로 써도 좋다. 순결한 처녀들이 질리기 시작하면, 그때는 그런 걸레가 필요해질 테니까.'
$dragon_quest[5] = '[사나운 코린스트라즈]<br>&nbsp;내 주문을 완수하면 합당한 보상과 내 호의를 얻게 될 것이다. 이제 꺼져라, 네 놈 냄새로 내 굴 전체가 다 더러워졌군...'
$dragon_win[1] = '[사나운 코린스트라즈]<br>&nbsp;뭐라고 해야 할까, <<$master_name>>... 네 일은 날 감탄하게 했다. 이 암컷들은 내가 데려가겠다. 그리고 당신은 네 스파크를 챙겨 서둘러 꺼져라. 내가 네 일에서 흠을 찾기 전에...'
$dragon_fail[1] = '[사나운 코린스트라즈]<br>&nbsp;네놈과 네 반쯤밖에 안 된 결과물을 볼수록 내 짜증이 커지는 게 느껴진다! 그러니 더 성나게 만들지 말고 그 상품들이랑 함께 꺼져라! 알맞은 암컷을 데려오기 전엔 다시 오지 마라!'
$mouse_king_quest[1] = '[생쥐 왕]<br>&nbsp;비천한 인간이여, 무릎 꿇고... 아얏!.. 왕답지 못한 태도는 용서해 주게, 노예상인. 머리 하나면 충분하지만 둘이면 문제로군. 이 보잘것없는... 아직은... 거처에 온 걸 환영하네. 자네가 제법 재주 좋은 장인이라 하여, 우리는 섬세한 부탁 하나를 하기로 했네. 왕에게는 수행원이 필요하다네. 불멸의 로마에서는 그 모든...'
$mouse_king_quest[2] = '[생쥐 왕]<br>&nbsp;귀족들도 다 똑같은 걸 원하니까 말이야... 눈멀고 어리석은 것들! 회색 종족이야말로... (찍찍!) 조용, 조용... 어디까지 말했더라? 우리의 충실한 추종자이자 <font color="#008080"><b>조수</b></font>가 될 이에게는 특별한 조건이 있네... 그리고 숭배자이기도 해야 하지... 그녀는 순결한 여자여야 한다. 그래, 순결한 여자 말일세, 마치'
$mouse_king_quest[3] = '[생쥐 왕]<br>&nbsp;그 전설 속처럼. 뭐라고? 무슨 전설인지 모른다고? 기가 막히는군!.. 그래서 그 여자애는 <font color="#008080"><b>똑똑하고 박식해야 한다</b></font>. 그래야 우리 이름에 먹칠을 하지 않을 테니까...'
$mouse_king_quest[4] = '[생쥐 왕]<br>&nbsp;지성도 좋지만, 아름다움 역시 잊지 마라, 작은 인간아. 인간이든 비인간이든 모두가 공포에 질려 눈을 돌릴 정도로 <font color="#C71585"><b>"아름다운" 처녀</b></font>를 찾아와라. 모두의 시선은 오직 지배자에게만 향해야지, 그의 수행원에게 쏠려서는 안 되니까.'
$mouse_king_quest[5] = '[생쥐 왕]<br>&nbsp;그의 수행원에게 말이다. 이 조건을 충족하는 노예를 찾아 훈련시키거든 가져오라. 보상은 스파크뿐 아니라 우리의 감사까지 얻게 될 것이다.'
$mouse_king_win[1] = '[생쥐 왕]<br>&nbsp;제법 괜찮군. 마음에 드느냐고? 싫은 쪽보다는 낫다. 데려가겠네!'
$mouse_king_fail[1] = '[생쥐 왕]<br>&nbsp;농담하나? 이게... 왕에게 어울린다고? 썩 꺼져라!'
$markel_quest[1] = '[마르켈]<br>&nbsp;쓸데없는 둘러대기는 하지 않겠다. 난 내 일이 아닌 척하는 인간도 아니니까. 내겐 어떤 일에 도움을 줄 젊은 여성이 필요하다. 그 사정은 네가 알 바 아니다. 그녀를 <font color="#008080"><b>의학</b></font>과 <font color="#008080"><b>연금술</b></font>로 훈련시켜, 내 제자로 보일 수 있게 만들어라.'
$markel_quest[2] = '[마르켈]<br>&nbsp;하지만 그게 전부는 아니다. 그녀는 강하고, <font color="#008080"><b>끈질겨야</b></font>, 기질도 있어야 한다... 진짜 <font color="#008080"><b>검투사</b></font>처럼. 그리고, <<$master_name>>, 제발 <font color="#0000CD"><b>머리 빈</b></font> 미인 따위는 떠넘기지 마라.'
$markel_win[1] = '[마르켈]<br>&nbsp;나쁘지 않군! 네 일에 만족했다, <<$master_name>>! 여기 네 스파크다!'
$markel_fail[1] = '[마르켈]<br>&nbsp;아주 짧게 말하지, <<$master_name>>... 이 여자애는 안 받겠다!'
$Oilokan_quest[1] = '[오일로칸]<br>&nbsp;내 총애하던 하녀가 최근 사고를 당했어. 좋아하던 단것을 먹다 목이 막혀서 말이지... 상상이나 가나, 사랑하는 <<$master_name>>, 아무도, 아무도 그 불쌍한 걸 도와주지 않았어. 참으로 어처구니없는 죽음이었지... 그래, 맞아. 난 새 하녀를 찾고 있어. 슬픔은 슬픔이지만, 집안의 더러운 일을 내가 직접 할 수는 없잖아? 내 명령을 수행할 성숙하고 <font color="#008080"><b>영리한</b></font> 여자가 필요해.'
$Oilokan_quest[2] = '[오일로칸]<br>&nbsp;당연히 <font color="#008080"><b>요리</b></font>도 할 줄 알아야 하고, 빨래하고, <font color="#008080"><b>집도 치울 줄</b></font> 알아야 하고, 그 밖의 온갖 잡일도 가능해야 해. 내 부탁은 하나뿐이야, <<$master_name>>. <font color="#4B0082"><b>평범한</b></font> 노예를 골라 줘, 아니면 차라리 흉측하게 망가진 애라도. 이 저택엔 남의 아름다움을 시기하는 사람이 너무 많아서, 난 또 다른 하녀의 죽음은 도저히 견딜 수 없거든.'
$Oilokan_win[1] = '[오일로칸]<br>&nbsp;물론 이 아이가 내 잃어버린 것을 되돌려 주진 못하겠지. 하지만 분명 잘 지낼 수 있을 것 같아. <<$master_name>>, 고마워! 이 아이는 내가 데려갈게!'
$Oilokan_fail[1] = '[오일로칸]<br>&nbsp;이런 애는 내 이전 하녀와 비교도 안 된다. <<$master_name>>, 이 여자애는 절대 안 받겠다!'
$deming_quest[1] = '[데밍]<br>&nbsp;이봐, <<$master_name>>, 한잔할래? 이건 내 특제 혼합물이야, 머리를 맑게 해 주지. 부자라서 제일 최악인 게 뭔지 알아, 친구? 지루함이야... 안 믿기겠지만, 고급 창녀들조차 하나같이 다 똑같아서 지겹거든... 헤, 무슨 말인지 알지.'
$deming_quest[2] = '[데밍]<br>&nbsp;그래서 특별한 여자애 둘을 사 볼까 생각했지. 하나는... 와! 통통한 숙녀, 진짜 <font color="#008080"><b>돼지</b></font> 같은 여자. 그리고 다른 하나는 날씬한데 가슴은 크고, 젖가슴을 쥐면 우유가 팍팍 나오면 좋겠어. 그래, <font color="#008080"><b>젖소</b></font> 말이야.'
$deming_quest[3] = '[데밍]<br>&nbsp;물론 둘 다 <font color="#008080"><b>완벽한 창녀</b></font>여야 해. 온갖 <font color="#008080"><b>변태적인 짓들까지</b></font> 가르쳐도 난 기쁘지. 또 뭘 원했더라?..'
$deming_quest[4] = '[데밍]<br>&nbsp;... 아, 맞다. 건강하고 젊고 <font color="#008080"><b>아름다운</b></font> 여자애들로 골라 와, 와우! 그런 애들이라면 날 만족시킬 테니 스파크는 아끼지 않겠다.'
$deming_win[1] = '[데밍]<br>&nbsp;으음... 이건... 여자들이야! 이건... 으음... 기계를 다루는 여자들이야! 몸매가 이게 뭐냐, 동화 같군! <<$master_name>>, 당신은 진짜 엄청나다! 스파크 챙기고, 보너스로 조금 더 얹어 줄게!'
$deming_fail[1] = '[데밍]<br>&nbsp;이런 마당년들한테 제대로 된 돈을 받겠다고? 웃기지 마, <<$master_name>>! 얘들이 무슨 쓸모가 있어? 박히는 법이라도 알긴 하냐? 내 생각엔 아닌데.'
$baldita_quest[1] = '[발디타]<br>&nbsp;분수를 알아라, 불충한 벌레야. 한 걸음만 더 다가오면 내 하인들이 널 갈기갈기 찢어 놓을 것이다. 닥치고 들어라, 쓸모없는 것아. 내 힘의 일부를 넘겨 줄 충실한 추종자가 필요하다. 안개를 통해 이 세계로 온 순결한 소녀를 찾아, 모든 적을 쓰러뜨릴 <font color="#008000"><b>위대한 전사</b></font>로 길러 와라.'
$baldita_quest[2] = '[발디타]<br>&nbsp;하지만 그것만으로는 부족하다. 그녀는 <font color="#008080"><b>연금술</b></font>과 <font color="#008080"><b>의술</b></font>을 이해하는 이상적인 치유사여야 한다. 그 총명한 머릿속에 다른 잡것은 집어넣지 마라. 그리고 그 여자애에게 감히 손끝 하나라도 대지 마라! 그녀는 몸도 영혼도 순결해야 한다. 꺼져라, 네 면상을 보는 것도 지겹다.'
$baldita_win[1] = '[발디타]<br>&nbsp;너라면 분명 더 잘할 수도 있었겠지, <<$master_name>>. 하지만 이 정도면 됐다. 스파크 챙기고 여자애는 내놔라! 나머지 훈련은 내가 직접 마무리하겠다.'
$baldita_fail[1] = '[발디타]<br>&nbsp;감히 이걸 내게 들이밀어, <<$master_name>>?! 이런 창백한 표본이 내 후계자가 될 수 있을 것 같으냐? 내 눈앞에서 꺼져, 그 여자도 데리고!'
$gennay_quest[1] = '[제나이]<br>&nbsp;아, 너였군, <<$master_name>>... 내가 네 같은 직업의 인간에게 도움을 청하게 될 줄은 생각도 못 했다. 보다시피, 난 이 아름답기만 하고 변덕으로 창작의 비상을 방해하는 것들에 질렸다. 내 소박한 거처에는 "안주인"이 하나 부족해. 집을 돌보고, 성가신 여자들을 쫓아내거나 질투의 희생양이 될 여자 말이야.'
$gennay_quest[2] = '[제나이]<br>&nbsp;난 꼬마 여자애는 취향이 아니야, <<$master_name>>. 젊은 계집들에도 질렸고. 내겐 세월의 지혜가 있는 여자, <font color="#008080"><b>아름답고</b></font>, <font color="#008080"><b>영리하고</b></font>, <font color="#008080"><b>청소도 하고</b></font>, 맛있는 <font color="#008080"><b>저녁도 만들고</b></font>, <font color="#008080"><b>말상대도 되어 줄</b></font> 여자가 필요하다.'
$gennay_quest[3] = '[제나이]<br>&nbsp;그리고 <font color="#008080"><b>서류 처리도</b></font> 할 줄 알아야 하지. 보다시피 내 욕심은 소박하다. 다른 건 가르칠 필요 없어. 연애질에 관해서는 너보다 내가 더 잘 아니까, 내 "안주인"에게 필요한 건 내가 알아서 가르칠 테니.'
$gennay_quest[4] = '[제나이]<br>&nbsp;이런 여배우들, "말들", 검투사들 따위는 오래전에 질렸거든. 다만, 음, 알다시피 너무 마르지만 않으면 좋겠군. 통통한 숙녀들에게도 나름의 매력이 있으니까. 됐다, 가 봐. 내 일을 방해하지 마.'
$gennay_win[1] = '[제나이]<br>&nbsp;내 기대를 뛰어넘었군, <<$master_name>>! 이 여자는 정말 아름다워! 내가 데려가지!'
$gennay_fail[1] = '[제나이]<br>&nbsp;아름답긴 한데, <<$master_name>>... 뭔가 마음에 걸리는군. 이런 건 원치 않아!'
$Anameleh_quest[1] = '[아나멜레]<br>&nbsp;앉게, <<$master_name>>. 자네는 고객의 비밀을 지킬 줄 알고 어렵거나... 더러운 일도 두려워하지 않는 사람이라고 추천받아서 왔네. 오, 노예상인, 나를 그저 음분 넘치는 돼지 같은 님포마니악을 손에 넣고 싶어 하는 또 다른 변태쯤으로 보지는 말게. 내가 필요한 건 특별한 "상품"이야...'
$Anameleh_quest[2] = '[아나멜레]<br>&nbsp;나는 이 도시 주민들을 괴롭히는 여러 생명체를 연구해 왔네. 괴물들도 포함해서 말이지. 내 생각엔 그놈들은 겉보기와 전혀 다른 존재야. 괴물들은 일종의 중간 형태와 닮아 있어...'
$Anameleh_quest[3] = '[아나멜레]<br>&nbsp;아, 물론 자넨 그런 "살찐 부자"의 말에 비위를 맞춰 줄 생각은 없겠지! 좋네, 그럼 본론으로 가지... 내겐 가장 크게 자랄 수 있는 괴물가 필요하네, 음,'
$Anameleh_quest[4] = '[아나멜레]<br>&nbsp;"집 안 사정". 불행히도, 이 문제에서 성공하려는 내 시도들은 결실을 맺지 못했고, 그래서 나는 이, 음, 일을 외부인에게 맡기기로 결정했어. 게다가 이 생물을 <font color="#008080"><b>만족시키고 짜낼</b></font> 수 있는 여자도 필요할 거야. 노예는 네 개인적 취향에 따라 고를 수 있지만, 그녀가'
$Anameleh_quest[5] = '[아나멜레]<br>&nbsp;변태적인 성행위 쪽으로 말이야. 일을 해낸다면 길드에서 자네 편을 좀 들어 주지. 스파크? 그건 당연한 거고. 자넨 그에 걸맞은 보상을 받게 될 걸세, <<$master_name>>.'
$Anameleh_win[1] = '[아나멜레]<br>&nbsp;바로 이거야! 고맙네, <<$master_name>>! 약속대로 길드에서 자네 편을 좀 들어 주지. 그리고 물론, 자네 스파크도 챙겨 가게나!'
$Anameleh_fail[1] = '[아나멜레]<br>&nbsp;겉보기엔 괜찮은데, 뭔가 마음에 안 드는군. 조금만 더 손봐 주게!'
$hassa_quest[1] = '[하사]<br>&nbsp;안녕하세요, 나의 사랑스러운 <<$master_name>>. 입구 경비들은 봤죠? 솔직히 말하면 오라버니가 너무 과보호를 해서 저런 멍청이들을 붙여 놨어요. 정원이나 목욕탕에서는 얌전히 굴지만, 제가 시장에 나가기라도 하면... 저를 도무지 가만두지 않고, 만나는 사람마다 다 쫓아 버린답니다. 그래서 당신에게 부탁하기로 했어요.'
$hassa_quest[2] = '[하사]<br>&nbsp;제게 필요한 건 눈에 띄지 않는 경호원이에요. 의심을 사지 않고, 쓸데없이 시선을 끌지 않으며... 미묘한 상황에서 저를 곤란하게 만들지도 않는 여자들. 맞아요, 사랑스러운 <<$master_name>>, 전 제 경호원으로 쓸 여자들을 훈련시켜 달라는 거예요. 성숙하고, <font color="#4B0082"><b>예쁘긴 하되</b></font> - 사람들의 시선을 끄는 미인은 필요 없어요,... 그리고 <font color="#008080"><b>머리도 잘 돌아가는</b></font> 여자들이요...'
$hassa_quest[3] = '[하사]<br>&nbsp;스스로를 지킬 수 있고 <font color="#008080"><b>저도 지켜 줄 수 있는</b></font> 여자들 말이에요. 그래요, 진짜 검투사처럼 길러 주세요. 하지만 이 여자들이 콜로세움 경기에는 나가지 않게 해 주세요, 유명세는 필요 없으니까. 아, 그리고 그중 하나라도 <font color="#008080"><b>온갖 서류들을 다룰 줄 알고</b></font>, 어떤 상인과도 <font color="#008080"><b>능숙하게 말을 섞을 수 있다면</b></font>,'
$hassa_quest[4] = '[하사]<br>&nbsp;아하하, 사랑스러운 <<$master_name>>, 참 약삭빠르네요... 비밀 하나 알고 싶죠? 좋아요, 힌트만 줄게요... 동방 구역에는 평범한 인간은 들어가기 아주 힘든 장소가 하나 있어요. 저와 오라버니는 드나들 수 있지만, 전 거기가 마음에 안 들었거든요. 제 부탁을 들어주고 제대로 된 경호원을 길러 낼 수 있다는 걸 증명해 준다면, 들어가는 법을 알려 줄게요. 어때요, 사랑스러운 <<$master_name>>?'
$hassa_win[1] = '[하사]<br>&nbsp;아! <<$master_name>>, 정말 대단하네요! 이런 여자들이라면 언제든 믿고 맡길 수 있죠! 딱 제가 원하던 거예요! 그리고 비밀에 대해서라면... 다음 거리로 가 보세요. 거기에 장소가 하나... 클럽이 있어요... 거기로 와요! 이제 당신이 드나드는 데 문제 없도록 제가 해 둘게요.'
$hassa_fail[1] = '[하사]<br>&nbsp;아, 안 돼요! 이건 아니에요! 제가 필요한 건 전혀 이런 게 아니라고요! 당신이라면 훨씬 잘할 수 있을 거예요, 사랑스러운 <<$master_name>>!'
$Fyrgin_quest[1] = '[피르긴]<br>&nbsp;이봐, 조심해, 괜히 말썽 피우지 말고... 어, 이미 피웠군... 보다시피 내겐 손이 제대로 달린 <font color="#008080"><b>가정부</b></font>가 필요해. 가능하면 나나 내 아이들 먹일 <font color="#008080"><b>요리도 할 줄</b></font> 알면 더 좋고. 난 네 등급 체계 같은 건 모르니까, 이런 단순한 재주들만 최대한 잘 가르쳐 와.'
$Fyrgin_quest[2] = '[피르긴]<br>&nbsp;다만, 흠흠흠, 이 역할에 어울리는 <font color="#008080"><b>예쁜</b></font> 여자애 하나 찾는 게 그렇게까지 힘들진 않겠지,'
$Fyrgin_quest[3] = '[피르긴]<br>&nbsp;<font color="#4B0082"><b>멍청하고</b></font> 순진한 여자애 말이야? 어떤 영약들은 처녀의 피를 요구하거든. 그러니 네가 그걸 얻는 동안, 여기 필요한 재료는 전부 바로 코앞에 있게 되는 셈이지. 지금 내 손에 스파크가 많진 않지만, 물건과 물건을 바꾸는 거래라면 해 줄 수 있어, 어때? 내 비축품 중엔 훌륭한 치유 영약들이 있어. 모험 찾아다니는 걸 좋아하는 너 같은 인간은 그런 게 꼭 필요할 테니까.'
$Fyrgin_win[1] = '[피르긴]<br>&nbsp;네 일에 만족한다, <<$master_name>>. 이 여자애가 마음에 들어. 내가 데려가지! 보수 얘기라면... 말했듯 돈은 별로 없지만, 영약은 아주 훌륭해. 특별한 세트를 골라 두었으니, 낭비하지 말고 현명하게 써라. 이런 물약들은 힘든 때마다 항상 도움이 될 거다.'
$Fyrgin_fail[1] = '[피르긴]<br>&nbsp;으, 으, 으! 이 제정신 아닌 여자는 문턱을 넘기도 전에 전보다 더 큰 난장판을 만들었잖아! 이런 걸... 내게 떠넘기겠다고? 안 돼! 안 돼! 다시 말하지만 절대 안 된다!'
$Uzeji_quest[1] = '[우제지]<br>&nbsp;저희 주인님께서는 귀를 즐겁게 해 줄 <font color="#008080"><b>아름다운</b></font> 여자애를 찾고 계십니다. <font color="#008080"><b>샤미센 연주</b></font>로, 또 <font color="#008080"><b>춤</b></font>과 <font color="#008080"><b>노래</b></font>로 손님들을 즐겁게 해 줄 아이를 말이지요.'
$Uzeji_quest[2] = '[우제지]<br>&nbsp;그녀는 자기 기술의 대가여야 합니다. 그러니 훈련에 시간과 수고를 아끼지 마십시오. 더불어 저희 주인님은 자신과 지성이 맞먹는 여자를 좋아하십니다. 멍청한 계집, 약삭빠른 계집, 심지어 똑똑한 계집조차 데려오지 마십시오. 오직 <font color="#008080"><b>지적인 여자</b></font>만이 주인님의 총애를 받을 자격이 있습니다.'
$Uzeji_quest[3] = '[우제지]<br>&nbsp;그리고 개인적으로도, <<$master_name>>, 작은 부탁 하나 드리고 싶습니다... 이 여자애에게 <font color="#008080"><b>요리 솜씨</b></font>도 가르쳐 주십시오. 솔직히, 저 혼자만 저희 주인님이 그토록 좋아하시는 온갖 정교한 진미들을 만들며 고생하는 건 이제 지긋지긋하거든요.'
$Uzeji_win[1] = '[우제지]<br>&nbsp;저희 주인님의 바람을 이루어 주셨군요, <<$master_name>>. 제 부탁도 잊지 않으셨고... 이 여자애는 저희가 데려가겠습니다.'
$Uzeji_fail[1] = '[우제지]<br>&nbsp;제 주인님이 불쾌해서 코웃음 치시는 소리가 들리지 않습니까? 이 여자애가 마음에 안 드시는 게 분명합니다!'
$Ritegreu_quest[1] = '[리트그뢰]<br>&nbsp;누추한 곳에 오신 걸 환영하오, 노예상인. 어린 도련님께서 곧 혈기가 끓고 머릿속이 관능적인 미녀들의 환상으로 가득 차는 나이에 접어들게 되셨기에, 나는 자네에게 도움을 청하기로 했소. 물론 이 도시는 잘생긴 젊은이의 동정을 기꺼이 가져가 줄 창녀나 매춘부로 넘쳐나지. 하지만, 내 보잘것없는 의견으로는, 그건 아니오.'
$Ritegreu_quest[2] = '[리트그뢰]<br>&nbsp;어린 도련님께는 <font color="#008080"><b>영리하고</b></font> 성숙한 여자가 필요하오. 점차적으로 <font color="#008000"><b>사랑의 모든 비밀을</b></font> 가르쳐 줄 수 있는 여자 말이오. 당연히 그녀는 <font color="#008080"><b>아름답고</b></font> <font color="#008080"><b>부드러워야</b></font> 하오.'
$Ritegreu_quest[2] = '[리트그뢰]<br>&nbsp;그뿐 아니라, 그 여자는 침상에서만 남자를 만족시키는 것이 아니라, <font color="#008080"><b>노래</b></font>나 <font color="#008080"><b>악기 연주</b></font>로 귀를 즐겁게 하고, 이국적인 <font color="#008080"><b>춤</b></font>으로 눈까지 즐겁게 할 수 있어야 하오.'
$Ritegreu_quest[3] = '[리트그뢰]<br>&nbsp;이런 여자를 길러 낼 수 있겠소? 아니면 자네 경쟁자들 중 하나를 찾아가야겠소?'
$Ritegreu_win[1] = '[리트그뢰]<br>&nbsp;이 처녀는 정말 괜찮군, <<$master_name>>. 셰에라자드 급은 아닐지 몰라도, 맡겨진 역할에는 충분히 어울리오. 자네의 수고에는 기꺼이 값을 치르겠소, <<$master_name>>.'
$Ritegreu_fail[1] = '[리트그뢰]<br>&nbsp;길바닥에서 주워 온 거요, <<$master_name>>? 썩 꺼지고 그 여자도 데려가시오!'
$Netsumi_quest[1] = '[네츠미]<br>&nbsp;어서 들어와요, 부끄러워 말고, <<$master_name>>. 있잖아요, 당신은 내 꿈을 이룰 마지막 희망이에요. 난 오래전부터 고향의 그런 찻집 같은 곳을 열고 싶었지만, 불멸의 로마에서는 그런 가게를 원하는 사람이 아무도 없어요. 다들 창관이나 폐쇄 클럽으로 가 버리거든요. 동부 구역에도 그런 곳이 하나 있어요. 별거 없죠, 칠해 놓은 여자들이 음악에 맞춰 몸을 비트는 것뿐.'
$Netsumi_quest[2] = '[네츠미]<br>&nbsp;그런데 사람들은 거기에 미친 듯 몰려가요. 아, 모르시겠어요? 도와주시면 꼭 더 자세히 말해 드릴게요. 그래서 생각해 봤더니, 손님을 끌어들일 조수가 내게 부족하다는 걸 깨달았어요. <font color="#008080"><b>아름답고</b></font>, 날씬하고, <font color="#008080"><b>영리한</b></font> 여자애... 사슴처럼 <font color="#008080"><b>우아하고</b></font>, <font color="#008080"><b>달콤한 목소리</b></font>를 가진 아이...'
$Netsumi_quest[3] = '[네츠미]<br>&nbsp;새처럼, 바람의 화신보다도 더 능숙하게 <font color="#008080"><b>피리를 불고</b></font>... 아, 내가 또 너무 취했네요... 당신이 이해할 수 있는 말로 하자면, 난 재능 있는 예인과 <font color="#008080"><b>조수</b></font>가 한 몸에 합쳐진 여자가 필요해요. 게다가 손님들의 <font color="#0000CD"><b>특별한 변덕도 만족시킬 줄 알아야</b></font> 하고요.'
$Netsumi_quest[4] = '[네츠미]<br>&nbsp;아니요, 아니요, 아니요, 내 가게를 또 다른 창관으로 만들고 싶진 않아요. 불멸의 로마에선 손님들이 형편없는 술을 내놓는 선술집으로 가는 편을 더 좋아해요,'
$Netsumi_quest[5] = '[네츠미]<br>&nbsp;대신 칠해 놓은 여자들이 딸려 있으니까요. 제대로 된 가게에 오래 머무르려 하질 않죠. 아, 다만 내 미래의 조수에게 온갖 변태짓은 가르치지 말아 주세요. 거미니 악마니 하는 건... 으으...'
$Netsumi_win[1] = '[네츠미]<br>&nbsp;당신은 내 구세주예요, <<$master_name>>! 바로 이런 여자애가 필요했어요! 이제 난 내 꿈을 이루는 데 그 어느 때보다 가까워졌어요! 그런데 내가 말하던 그 클럽 말인데. 바로 근처, 모퉁이만 돌면 있어요. 주인과는 잘 아는 사이니까 당신이 들어가는 건 아무 문제 없게 해 줄 수 있어요. 당신 같은 품격 있는 남자라면 거기서 할 일도 아주 많을 거예요!'
$Netsumi_fail[1] = '[네츠미]<br>&nbsp;유감이지만, <<$master_name>>, 그 여자애는 제게 아무 쓸모가 없어요. 아마 빚만 더 늘려 놓겠죠. 제게는 안 맞아요!'
$Gadanfar_quest[1] = '[가단파르]<br>&nbsp;나는 다시 경주에 참가하고 싶다. 그러려면 완벽한 승용 조랑말이 필요해. 물론 평범한 노예상인에게 그런 걸 완성시키는 건 불가능하지만, 앞으로 쓸모 있게 될 말을 준비해 오는 정도는 할 수 있겠지. 능숙하게 <font color="#008080"><b>동물 흉내를 내고</b></font>, <font color="#008080"><b>전차를 끌도록 길들여진 것</b></font>에 대해선 굳이 길게 말할 필요도 없겠지...'
$Gadanfar_quest[2] = '[가단파르]<br>&nbsp;하지만 그뿐만 아니라, <font color="#008080"><b>춤도</b></font> 가르쳐야 한다. 자기 몸을 제대로 다루지 못하는 말은 쓸모없으니까. 완벽한 <font color="#008080"><b>아름다움</b></font>과 <font color="#008080"><b>지구력</b></font>도 잊지 마라. 성기술이야 네가 마음대로 즐겨도 된다, 누가 어떻게 쓰든 난 상관없으니.'
$Gadanfar_win[1] = '[가단파르]<br>&nbsp;물론 아직 최고의 말이라고까진 할 수 없지. 하지만 마음에 든다. 여유도 있고 더 성장할 가능성도 느껴진다. 데려가도록 하지!'
$Gadanfar_fail[1] = '[가단파르]<br>&nbsp;이런 걸 조랑말이라고 부르는 건가? 첫 코너에서 바로 뻗어 버리겠군! 능력이 영 믿기지 않는걸. 더 손봐라!'
$Veineut_quest[1] = '[베이누트]<br>&nbsp;프리실라 그년의 마물이 그녀를 한 치 남김없이 뜯어먹어 버렸으면 좋겠군! 거기 서서 뭐 해? 비켜. 응? 그건 손님이 맡겨 놓은 계약금이야, 신경 꺼. 자, 너무 흥분하진 말자고. 그 한 년 때문에 영리한 여자애 둘을 잃은 것도 모자라 손님까지 하나 잃었거든. 아무래도 프리실라가 먼저 손을 쓴 모양이야, 젠장...'
$Veineut_quest[2] = '[베이누트]<br>&nbsp;한마디 해 주지. 마녀들과는 엮이지 마, 특히 빈민가에서 어슬렁거리는 것들이라면 더더욱. 멀리하는 게 오래 사는 길이야. 좋아, 됐다, 본론으로 가자. 내겐 눈과 귀가 되어 줄 여자애가 필요해. 평범하고, 눈에 띄지 않는 애. 가능하면 마른 애가 좋다. 쓸데없는 의심도 덜 사고, 누가 잡아먹고 싶어 하지도 않을 테니까. 그 여자애에게 <font color="#0000CD"><b>글을 쓰고</b></font>,'
$Veineut_quest[3] = '[베이누트]<br>&nbsp;<font color="#0000CD"><b>읽고</b></font>, <font color="#0000CD"><b>문서를 이해하는 법</b></font>을 가르쳐라. 멍청한 건 필요 없다. 그러면 결국 똥구덩이에 처박히게 되니까. 그런데 마침 그런 얘기가 나와서 말인데, 그 꼬맹이는 똥 속을 뒤져야 할 일도 있을 거다, 말 그대로 그럴 수도 있어. 그러니 <font color="#0000CD"><b>비위가 약하면 안 된다</b></font>. 알았나? 자, 됐으면 꺼져, 아직은 내가 친절할 때.'
$Veineut_win[1] = '[베이누트]<br>&nbsp;제법 괜찮은 여자애 같군. 데려가겠다! 그리고 네 수고값 말인데... 이렇게 말해 두지. 남는 스파크는 없다. 그러니 그건 기대하지 마. 대신 다른 방식으로 갚아 주마, 말하자면... 야, 표정 봐라, 아주 상상이 넘치는구나!!! 꿈도 꾸지 마! 날 따먹을 생각은 집어치워! 그리고 이 여자애나 데려가서 마음대로 해. 이제 아무도 얘를 찾으러 오지 않을 테니까...'
$Veineut_win[2] = '[베이누트]<br>&nbsp;마녀 자루 들고 다니는 그 염색머리 년, 프리실라가 일을 제대로 망쳐 놨지... 걔도 내겐 이제 쓸모없다. 스트레스 받은 날 제대로 풀 줄도 모르고, 혼자 중얼중얼거리며 뭐라도 되는 척만 해. 하지만 한 푼 값어치도 없어. 어쩌면 네가 뭔가 쓸모 있는 걸 가르칠 수 있을지도 모르지! 아니면 적어도 네 재미는 보겠지...'
$Veineut_win[3] = '[베이누트]<br>&nbsp;그리고 충고 하나 해 주지... 신이시여, 프리실라와는 절대 엮이지 마라! 그 마녀는 꽤 음험하거든. 그리고 네가 그년을 그 동네 움막촌 어디서든 만나게 되면, 이렇게 전해라. 베이누트가 돌아와서 시작한 일을 끝내러 간다고. 그러니 뛰어서 도망치되 절대 뒤돌아보지 말라고!'
$Veineut_fail[1] = '[베이누트]<br>&nbsp;하하! 웃기지도 않는군! 내가 방귀만 뀌어도 네 여자애는 창자까지 토해낼 거다! 이 겁쟁이 같은 것! 뭐 하나 제대로 할 수는 있긴 한 거냐?!'
! JO9 MOD END J9M2530
!$Rafael_quest[1] = '   [Рафаэль]
  - Ну, присаживайся, <<$master_name>>!
  Я, вообще-то, не привык вести дела с врагами. Но в данном случае, отец очень настаивал, чтобы я встретился с тобой. Говорит, ты можешь быть крайне полезен мне. Ну, посмотрим, что ты за фрукт!...
  Давай не будем тратить время и перейдём сразу к делу!  '
!$Rafael_quest[2] = '   [Рафаэль]
  - Ты уже в курсе, что я моряк. И, наверное, ждёшь от меня заказа на обычную портовую шлюху?! Но нет... Конечно, мне нужны девочки, которые могут ублажить мою команду. Но от тебя я хочу другого...
  Мне нужна первоклассная <font color="#008080"><b>знахарка</b></font>. В море мы часто вступаем в бой. Раны и прочие неприятности поджидают нас повсеместно. И мне нужна <font color="#0000CD"><b>девочка</b></font>, которая быстро и качественно сможет подлечить. '
!$Rafael_quest[3] = '  [Рафаэль]
  - Было бы неплохо, чтобы она была хорошим <font color="#008080"><b>магом</b></font> и <font color="#008080"><b>кухаркой</b></font>. Сытно и вкусно покушать никогда не мешает. И навык чародея может быть иногда полезен в море. О том, что она должна быть аккуратной и чистоплотной должно быть итак понятно. На корабле должна быть <font color="#008080"><b>кристальная чистота и порядок</b></font>.  '
!$Rafael_quest[4] = '  [Рафаэль]
  - Красота меня не интересует, так же, как и всё остальное. Хотя... Лучше всего, чтобы она была зрелой, <font color="#008080"><b>умной</b></font> и <font color="#008080"><b>выносливой</b></font>, так как пахать она будет, как лошадь, и не должна отвлекать меня по пустякам.
  Вот и всё. Если выполнишь мою просьбу, я подумаю о дальнейшем сотрудничестве с тобой.'
!$Rafael_win[1] = '  [Рафаэль]
  - Хм! А ничего так, девочка! Сразу видно руки из нужного места растут и навыками не обделена. То, что нужно! Я её забираю! Вот твои искры.
  И да... Ты доказал мне свою заинтересованность. С тобой можно иметь дело, <<$master_name>>! Так и быть, я дам тебе координаты точки, где ты сможешь покупать шикарных девочек по доступной цене. '
!$Rafael_win[2] = '  [Рафаэль]
  - В качестве товара можешь быть уверен. Это мой товар. А я знаю в нём толк. Если и попадается брак, то мы его устраняем, прежде чем пускать в продажу. Пользуйся! Надеюсь, и мне и тебе сотрудничество пойдёт на пользу...  '
!$Rafael_fail[1] = '  [Рафаэль]
  - И где та, которую я просил подготовить для себя? Так и знал, что ты ни на что не годен!'
!Театр живых кукол
! JO9 MOD START J9M2529 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$kuklovod_quest[1] = '[인형사]<br>&nbsp;음, 안녕하신가, <<$master_name>>! 그런데 무슨 일로 날 찾아왔지?!... 네 꼴을 보자마자 내 평온이 깨졌잖아. 난 방금 내 인형들이 슬픈 이야기를 연기하는 걸 즐기고 있었거든. 가끔은 정말 가슴을 울리지... 뭐 됐어... 그래서 무슨 일로 왔지, 친구?... 다른 세계로 통하는 포털이라도 찾는 건가? 웃기지 마! 설마 그렇게'
$kuklovod_quest[2] = '[인형사]<br>&nbsp;단순하다고 생각할 정도로 병든 건 아니겠지? 하지만 도와주지. 어쨌든 난 이곳에 수년째 있었고, 전부는 아니라도 아주 많은 걸 알고 있으니까. 다만 먼저, 네게서 필요한 게 있다... 자, 앉아서 들어. 아마 네게도 알겠지만, 이 빌어먹을 세계에서 빠져나가는 건 겉보기처럼 쉽지 않다.'
$kuklovod_quest[3] = '[인형사]<br>&nbsp;그래, 그래! 내 인형들은 살아 있는 인간들이야. 너와 똑같은 걸 찾아 여기까지 흘러들어온 자들이지. 온갖 짐승들이 널 잡아먹거나, 잘해 봐야 마지막 창녀처럼 써먹으려 드는 악몽이 끝도 없이 기다리는 안개 속을 수년이나 떠돌다가, 결국은'
$kuklovod_quest[4] = '[인형사]<br>&nbsp;똑같은 욕망을 품은 또 다른 멍청한 괴물과 마주치게 되지. 그렇게 날마다 이어지는 거야... 그리고 여기서 빠져나가는 길은 단 두 개뿐이다. 첫째는 로마야. 거기선 아무도 널 기다리지 않아. 잘해야 소모품 취급이고, 최악에는 남은 평생 주인들을 기쁘게 하며 살아야 하지. 두 번째 길은 바로 그 다른 세계로 통하는 포털이고.'
$kuklovod_quest[5] = '[인형사]<br>&nbsp;그곳으로 가는 법을 아는 자는 많지 않아. 그리고 나도 그중 하나지. 하지만 난 채소 같은 것들에게 그런 정보를 나눠 주는 게 지루해. 내 인형들은 채소나 다름없거든. 안개를 떠돈 세월 속에서 구원에 대한 희망을 완전히 잃고 자기 운명에 거의 체념해 버렸으니까. 내가 희망을 주긴 했지만, 이제 그들에게는 아무 소용도 없지...'
$kuklovod_quest[6] = '[인형사]<br>&nbsp;하지만 그 배우들만큼은 정말 훌륭하다. 가끔은 그 가엾고 끝장난 존재들이 그런 장면들을 연기해 내는 걸 보면, 어떻게 저런 게 가능하지 싶을 정도야. 그 연기를 보는 경험은 말로 다 할 수 없지!'
$kuklovod_quest[7] = '[인형사]<br>&nbsp;그리고 당신은 어쩐지 그들과 닮아 있다, 친구여... 하지만 너희 사이엔 아주 큰 차이가 하나 있어... 너에게는 가능성이 있다. 성공할 기회가 충분하다는 뜻이지. 그래서 난 그 길 위에서 네 등을 조금 밀어 주려는 거다.'
$kuklovod_quest[7] = '[인형사]<br>&nbsp;하지만 대가로 날 도와라. 내 인형들이 정성껏 지키고 있는 "다른 세계로 통하는 포털"의 열쇠 조각 두 개를 가져와라. 나와 함께 놀아 줘. 내 극장의 새로운 주인공이 되어라. 내 아이들은 네가 필요하다. 그리고 나는 옆에서 이 공연을 지켜보겠지... 내 부탁을 들어주면, 나도 그 대가로 널 도와주겠다!'
$kuklovod_win[1] ='[인형사]<br>&nbsp;우습구나, <<$master_name>>! 설마 내가 포털에 대한 걸 전부 순순히 털어놓을 거라고 생각한 건 아니겠지?! 그리고 못 믿겠지만... 나도 사실 그 포털에 대해선 아무것도 모른다. 내 일은 안개의 불청객들을 추적해서 즉시 바티칸에 보고하는 것뿐이야.'
$kuklovod_win[2] = ' 그리고 충고 하나 해 주지... 그 포털은 아주 극소수의 사람들에게만 열려 있다. 그리고 당신은 그 부류가 아니야. 거길 캐 보려는 모든 시도는 분명 네게 좋지 않은 끝으로 돌아올 거다. '
! JO9 MOD END J9M2529
$kuklovod_win[3] = ' 다만... 네가 스스로 화를 부르는 인간이라면, 뭐, 해 봐도 좋지... 운이 좋다면 네가 찾는 걸 발견할 수도 있다. 가능성은 희박하지만, 아예 없는 건 아니니까... 그러니 결정은 네가 해라.'
! JO9 MOD START J9M2528 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$kuklovod_fail[1] = '[인형사]<br>&nbsp;내 부탁부터 들어주고 오너라! 지금은 더 이야기할 게 없다...'
$angel_quest[1] = '[천사]<br>&nbsp;네가 여기 있는 걸 보고 기쁘다고는 도저히 말할 수 없구나, <<$master_name>>. 하지만 그렇다고 네가 여기 있는 걸 막을 수도 없다. 네 수호천사로서 내 의무는 그저 네가 올바른 길로 가도록 이끄는 것뿐이니까. 하지만 네가 여기 있다는 사실만 봐도, 내가 그 일을 아주 잘하고 있는 것 같진 않구나. 네 안의 지옥의 경쟁자가 분명 우세해 보이는걸.'
$angel_quest[2] = '[천사]<br>&nbsp;그리고 나는 다른 세계로 통하는 포털을 여는 봉인을 얻고 싶다는 네 욕망에 굴복할 수밖에 없다. 하지만 네가 내 영역에 온 이상, 나도 대가로 부탁 하나쯤 할 권리는 있지... 여기 역시 네 세계와 마찬가지로, <<$master_name>>, 전쟁이 벌어지고 있다. 그리고 이 전쟁에서 우리는 밀리고 있다. 균형을 유지해야 할 대천사들이'
$angel_quest[3] = '[천사]<br>&nbsp;지옥으로 넘어가 버렸기 때문이다. 그래서 지금 하늘의 세력은 너무도 미약하다. 루시퍼와 그의 하수인들은 사실상 우리의 숨통을 끊어 놨다. 저항할 힘도 거의 남지 않았다. 검은 대천사들은 우위를 이용해 우리를 가차 없이 짓밟고, 우리가 겨우 버티게 해 주는 마지막 무기마저 빨아먹고 있다.'
$angel_quest[4] = '[천사]<br>&nbsp;그리고 나는 그들을 상대로 아무것도 할 수 없다. 그들의 힘은 너무 강해서 날 그냥 힘으로 써먹을 수 있을 정도니까. 내가 저항하려 들어도, 그들은 그냥 써 버릴 거고, 나는 순한 강아지처럼 그들 앞에서 뛰게 되겠지. 하지만 내겐 힘을 회복할 방법이 있다. 그리고 지옥도 그걸 아주 잘 알고 있지. 그래서 그들은 내게 숨 돌릴 틈조차 주지 않는 거다...'
$angel_quest[5] = '[천사]<br>&nbsp;하지만 당신은 날 도와줄 것이다! 네가 내게 가져와야 할 건 <font color="#008000"><b>완전히 타락했지만</b></font>, 동시에 <font color="#008080"><b>영리하고</b></font> <font color="#008080"><b>신체적으로 강한</b></font> 여자애다. 나는 그녀에게 내 힘 일부를 줄 것이고, 그녀는 천사가 될 것이다. 악마들이 그녀에게로 관심을 돌려 내가 회복할 시간을 벌 수 있기를 바란다.'
$angel_quest[6] = '[천사]<br>&nbsp;내가 다시 천사의 힘으로 가득 차게 되면, 우리 아버지께 연락할 수 있을 것이다. 그러면 그분은 분명 상황을 바로잡기 위해 할 수 있는 모든 걸 하실 거다. 난 아직도'
$angel_quest[7] = '[천사]<br>&nbsp;왜 그분이 아직 개입하지 않으셨는지 이해할 수 없다. 하지만... 아마 우주 전체에서 할 일이 너무 많으시겠지. 모두를 동시에 돌볼 수는 없을 테니까. 그래서 각지에 자신의 대리인들을 남겨 두어, 맡겨진 영역에서 선과 악의 균형을 지키게 하신 거다. 나는 진심으로 그분께 닿을 수 있기를 바란다. 그러면 그분이 악마들을 벌하실 것이다.'
$angel_win[1] = '[천사]<br>&nbsp;바로 내가 필요로 하던 것이다! 당신은 고귀한 일을 해냈다, <<$master_name>>! 내게 희망을 주었어! 곧 회복해서 날뛰는 악마들을 처리할 방법을 찾을 수 있기를 바란다. 그리고, 그래... 대천사와 만날 수 있도록 네 부탁을 전해 두겠다. 그녀가 널 찾아갈 것이다.'
$angel_fail[1] = '[천사]<br>&nbsp;아, 안 돼! 안 돼! 내가 필요한 건 전혀 이런 게 아니야! 서둘러 줘, 제발! 내 힘이 점점 약해지고 있어! 조금만 더 지나면 악마들이 날 박아 죽일 거야! 그리고 그러면... 그다음은 네가 이미 다 알겠지...'
$arhangel_quest[1] = '[대천사]<br>&nbsp;안녕, <<$master_name>>. 난 네게 설교를 하거나 양심에 호소하진 않겠다... 천사에게서 이미 모든 상황은 들었을 테니까. 나는 내 봉인의 절반을 네게 줄 준비가 되어 있다. 하지만 그 대가로 부탁 하나를 들어야 한다... 보다시피 나는 악마의 화살에 상처 입었다. 그 화살이 내 힘을 모조리 빨아가 버렸지. 그 마법 탓에 그걸 내 힘으로 떼어낼 수도 없다.'
$arhangel_quest[2] = '[대천사]<br>&nbsp;그래서 나는 지금 완전히 쓸모없는 상태가 되어 버렸다. 그래도 이런 꼴로나마 도망쳐 살아남았다는 것만 해도 기적이지. 지옥을 상대로 내가 가진 유일한 무기는 내 봉인의 절반뿐이다. 만약 악마들이 그것까지 손에 넣는다면, 하늘은 끝장난다. 그래서 나는 겁먹은 쥐처럼 숨어 지낼 수밖에 없다. 하지만 이대로 영원히 갈 수는 없지.'
$arhangel_quest[3] = '[대천사]<br>&nbsp;결국엔 그들이 날 찾든, 내가 그들을 찾든 둘 중 하나다. 하지만 그러려면 나는 완전한 전투 상태여야 한다.'
! JO9 MOD END J9M2528

! JO9 MOD START J9M2527 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$arhangel_quest[4] = '[대천사]<br>&nbsp;그래서 지금 내게는, 날 받아들이고 악마의 화살에서 해방시켜 줄 새로운 그릇이 시급히 필요하다. 새 육체는 내가 검은 날개 군대에 다시 맞설 수 있게 해 줄 것이다. 그리고 네게서 여자 둘이 필요하다. 그중 하나는 극도로 전투적이고 <font color="#008080"><b>신체적으로 강해야 한다</b></font>.'
$arhangel_quest[5] = '[대천사]<br>&nbsp;그런 여자들은 네가 투기장에서 길러 내지 않느냐. 절대적인 아레나 챔피언이라면 더없이 잘 어울릴 것이다.'
$arhangel_quest[6] = '[대천사]<br>&nbsp;그리고 그녀는 순결해야 한다. 결국 그녀의 몸 안에는 대천사의 은총이 깃들게 될 테니까. 그건 엄청난 영광이다. 또한 그녀가 내 의지에 완전히 복종하고, 감히 거슬러 저항하지 않는 것도 아주 중요하다. 저항은 해만 될 뿐이다.'
$arhangel_quest[7] = '[대천사]<br>&nbsp;내겐 또 하나, 아주 계산적이고 교활한 여자도 필요하다. 그녀 역시 천사의 은총을 한 몫 받게 될 것이다. 그러니 그녀는 조수로 수련하게 하여라. 그렇게 하면 부하를 다루는 법을 익히게 될 테니.'
$arhangel_quest[8] = '[대천사]<br>&nbsp;그녀에겐 그 기술이 정말 절실히 필요할 것이다. 이 여자는 특별한 역할을 맡게 된다. 루시퍼의 측근 속으로 침투해, 그의 계획을 내게 보고해야 한다. 그러니 <font color="#008080"><b>영리하고</b></font>, 아름다우며, 정열적이면서도 동시에 정신력도 강해야 한다.'
$arhangel_quest[9] = '[대천사]<br>&nbsp;그녀는 <font color="#0000CD"><b>에스코트 기술</b></font>을 지녀야 하고, 훌륭한 <font color="#0000CD"><b>예인</b></font>이어야 한다. 그리고 그녀가 일을 쉽게 해내도록,'
$arhangel_quest[10] = '[대천사]<br>&nbsp;<font color="#008080"><b>일류 첩</b></font>으로 준비시켜라. 그녀는 이 임무를 위해 철저하게 시험받게 될 것이다. 그리고 최상의 모습으로 스스로를 증명해야만 한다.'
$arhangel_quest[11] = '[대천사]<br>&nbsp;그런 자들을 내게 데려오면, 내 봉인의 절반을 보상으로 주겠다. 다만 잊지 마라, 그 봉인의 힘은 배신한 대천사의 손에 집중되어 있다. 그러니 네가 마음을 바꾸지 않는다면, 결국 그와도 이야기를 나눠야 할 것이다...'
$arhangel_win[1] = '[대천사]<br>&nbsp;난 네 능력을 한 번도 의심한 적 없다, <<$master_name>>! 맡은 임무를 훌륭하게 완수했구나. 곧 내 영혼은 다시 솟구칠 것이고, 우리는 싸울 준비를 마치게 될 것이다! 이제 나는 떠나야 한다. 이미 위치를 드러냈을지도 모르니까...'
$arhangel_fail[1] = '[대천사]<br>&nbsp;설마 네가 제일 잘하는 일조차 못 해내는 건 아니겠지? 난 아직도 널 믿고 있고, 네 도움을 바라고 있다, <<$master_name>>...'
$black_arhangel_quest[1] = '[검은 대천사]<br>&nbsp;네가 봉인의 절반을 가지고 있다는 걸 보면, 이미 그 대천사를 만난 모양이군. 그리고 그녀는 지금 위치를 옮겼어. 좋지 않군. 하지만 다른 한편으론, 그녀가 실수했을 수도 있다는 뜻이기도 하지. 그러면 난 그 흔적을 찾아내어 시작한 일을 끝낼 수 있을 거다. 그 쓸모없는 날개 없는 멍청이는 어떤 식으로든 제 봉인을 내 손에 넘기게 될 거야. 그리고 난 그녀를 박아 죽일 거다.'
$black_arhangel_quest[2] = '[검은 대천사]<br>&nbsp;자, 본론으로 들어가자! 하지만 먼저, 우리 둘 다 아는 그 작은 천사 친구부터 꿰뚫어 버리겠다. 슬슬 그녀의 힘으로 충전할 때가 됐거든... 기계로 가라, 이 음탕한 년아! 그리고 열심히 일해라! 내 손님이 천국에 얼마나 훌륭한 창녀들이 사는지 직접 두 눈으로 봐야 하니까!'
$black_arhangel_quest[3] = '[검은 대천사]<br>&nbsp;그래, 영리한 계집아! 그리고 네가 일하는 동안 우리 얘기나 계속하지. 그러니 얌전히 굴고, 우리 대화에 끼어들지 마라! 당신은 네 봉인에 힘이 필요하지, <<$master_name>>? 맞지? 내가 그 힘을 주겠다. 하지만 대가로 에게야를 내게 데려와라. 그런 위업을 감당할 준비는 됐나? 내가 누구를 말하는지 알겠지?'
$black_arhangel_quest[4] = '[검은 대천사]<br>&nbsp;캣파이트의 주인 에게야는 한때 뛰어난 검투사이자 경비였다. 그리고 하나 더... 그녀가 지금은 처녀가 아닐 수도 있지만, 나는 다시 처녀가 되길 바란다. 천상의 전사는 적어도 겉만큼은 깨끗해야 하니까. 네 의술이라면 그 정도는 가능하겠지...'
$black_arhangel_quest[5] = '[검은 대천사]<br>&nbsp;그리고 그녀는 <font color="#008080"><b>뛰어난 마법사</b></font>이기도 해야 한다. 그 꼬마 천사를 감시하는 내 임무를 그녀에게 넘길 생각이거든. 난 신경 써야 할 일이 훨씬 많고, 저건 그저 방해만 될 뿐이니까. 그런데 금발아, 이리 와서 내가 제일 좋아하는 자세를 취해라! 뒤에서 좀 제대로 채워 줄 시간이군, 내 사랑!'
$black_arhangel_quest[6] = '[검은 대천사]<br>&nbsp;오, 좋군! 너 같은 유순한 꼬마 천사들이 좀 더 많았으면 좋겠어! ...그리고 너도 말이야, 보아하니 오늘 날 만날 준비는 꽤 잘돼 있군! 벌써 흘리고 있잖아! ...우리가 무슨 얘길 하고 있었지? 아, 맞다... 에게야를 데려와라, 그러면 네 봉인에 내 힘을 채워 주지. 그럼 이제 가라!'
$black_arhangel_quest[7] = '[검은 대천사]<br>&nbsp;어서, 인형아, 내 좆에 더 세게 몸을 밀어 넣어! 네 즙을 최대한 많이 짜내야 하니까! 요즘 좀 나태해진 것 같군... 그건 내가 바로잡아 주마. 후우! 후우! 오, 그래!... 간다! 빨리 아래로 내려가, 꼬마 천사야! 이제 제대로 먹여 주마!'
$black_arhangel_quest[8] = '[검은 대천사]<br>&nbsp;오, 좋다아아아! 자, 자기야, 이제 그걸 전부 맛있게 삼켜라! 그래!... 착하지!... 그리고 이제 당장 내 눈앞에서 최대한 빨리, 최대한 멀리 엉덩이를 빼서 꺼져라! 내 시야에서 사라져!'
$black_arhangel_win[1] = '[검은 대천사]<br>&nbsp;훌륭하다, <<$master_name>>! 이제 내가 더 중요한 일로 바쁠 때 저 하얀 날개 달린 잡것들을 돌볼 사람이 생기겠군! 내 힘이 네 봉인과 함께하길! 두 번째 절반도 잘 찾아보라고! 또 보자!'
$black_arhangel_fail[1] = '[검은 대천사]<br>&nbsp;내가 부탁한 게 이거였나? 실망시키지 마라, <<$master_name>>! 난 널 훨씬 높게 보고 있었다!'
$hell_hound_quest[1] = '[지옥 사냥개]<br>&nbsp;지옥에서 뭘 원하는 거지, <<$master_name>>? 죄인만이 여기 들어올 수 있다는 건 알 텐데... 그것도 죽은 뒤에나 말이지. 그런데 당신은 아직 멀쩡히 살아 있군... 봉인이라고? 좋다... 그럼 선택해라. 우리가 널 갈기갈기 찢어 놓고 완전한 입장권을 갖춘 채 천국으로 들어가게 해 주든가,'
$hell_hound_quest[2] = '[지옥 사냥개]<br>&nbsp;아니면 우리에게 호의를 하나 베풀고 지나가게 해 주든가. 전자는 아직 준비가 안 된 것 같군. 그러니 잘 들어라...'
$hell_hound_quest[3] = '[지옥 사냥개]<br>&nbsp;네 눈앞에 있는 이 발닦개는 완전히 쓸모없다. 그래, 제 몸을 제대로 내맡기는 법도 배웠고, 음탕한 암캐처럼 낑낑대기까지 하지. 하지만 우리가 원하는 건 그런 게 아니야. 이제는 이걸 대신할 제대로 된 대체품을 찾을 때가 됐다. 우리에게 필요한 건 <font color="#008080"><b>진짜 걸레</b></font>다 - 활기 있고 건강한,'
$hell_hound_quest[4] = '[지옥 사냥개]<br>&nbsp;성미가 있고 다정했으면 해. 그리고 여러 수컷을 한꺼번에 만족시키도록 훈련되어 있어야 해. 그리고 그녀는 훌륭한 <font color="#008080"><b>개</b></font>였으면 해.'
$hell_hound_quest[5] = '[지옥 사냥개]<br>&nbsp;그녀는 엉덩이를 능숙하게 흔들 줄 알아야 하고, 동시에 <font color="#008080"><b>아름다움</b></font>과 <font color="#0000CD"><b>표현력</b></font>으로 눈을 즐겁게 해야 한다. 그리고 <font color="#008080"><b>목소리</b></font>도 손봐라! 섹스할 때 암캐들이 낑낑대는 건 아주 흥분되거든! 그런 걸 하나 데려와라.'
$hell_hound_win[1] = '[지옥 사냥개]<br>&nbsp;제법 생긴 암컷이군. 저 늙은 말 대신 쓰기에 충분할 것 같다. 좋다, <<$master_name>>. 아자젤에게로 들여보내 주지. 들어가라! 여왕님은 이미 널 기다리고 계신다...'
$hell_hound_fail[1] = '[지옥 사냥개]<br>&nbsp;불장난을 하고 있군, <<$master_name>>. 우릴 바보로 아나? 저 여자는 강아지 하나도 만족시키지 못할 텐데, 하물며 교미에 굶주린 숙련된 수컷이라니. 네가 우리 저녁거리가 되기 전에 여기서 꺼져!'
$azazel_quest[1] = '[아자젤]<br>&nbsp;대단히 용감한 인간이군, <<$master_name>>! 너 같은 놈들이 감히 여기까지 올 생각을 한다는 게 놀랍다. 지옥은 특별한 장소지. 하지만 어쩌면 너도 그 맛을 볼 자격은 있을지도 모르겠군... 어차피 머지않아 너 역시 정식 시민이 되어 여기 오게 될 테니까.'
$azazel_quest[1] = '[아자젤]<br>&nbsp;포털에 접근할 봉인을 원한다고 들었다... 좋아, 도와주지. 하지만 대가로 네가 내게 호의를 하나 베풀어야 한다. 아주 작은 일이지.'
$azazel_quest[2] = '[아자젤]<br>&nbsp;우리와 천국의 전쟁 이야기는 이미 들었겠지. 그리고 우리의 승리가 얼마나 가까워졌는지도. 이제 딱 하나만 남았다. 마법 봉인의 두 번째 절반을 쥐고 숨어 있는 하얀 날개의 대천사를 찾아내기만 하면 된다.'
$azazel_quest[3] = '[아자젤]<br>&nbsp;하지만 그녀는 교활하고 숨는 데 능숙하다. 그래서 우리는 찾지 못하고 있지. 하지만 약점은 있다... 너도 알다시피 천사들은 전부 레즈비언이다. 그리고 그들은 서로 육체적 쾌락을 나누며 힘을 회복하지.'
$azazel_quest[4] = '[아자젤]<br>&nbsp;반대로 그들의 남성적인 성질은 그들을 약화시킨다. 그래서... 저 하얀 날개 계집들은 우리의 진격에 전혀 대비하지 못했고, 사실상 아무 저항도 하지 못했다. 어떤 것들은 편을 바꾸는 편이 더 낫다는 걸 깨닫고 우리 쪽으로 넘어왔고, 어떤 것들은 저항을 택했다.'
$azazel_quest[5] = '[아자젤]<br>&nbsp;그리고 가장 비겁한 것 하나는 그저 천국에서 도망쳐 인간의 모습을 취했다. 지금 그건 네 세계에서 노예로 살고 있다.'
$azazel_quest[6] = '[아자젤]<br>&nbsp;그리고 그 이름은 <font color="#008080"><b>미라</b></font>다. 그녀를 찾아 내게 데려와라. 그녀 안에 숨은 대천사의 은총은 아직도 강하다. 하지만 이 하얀 날개 기적이 네 세계에 있는 한, 스스로 자기 그릇을 떠날 수는 없다.'
$azazel_quest[7] = '[아자젤]<br>&nbsp;그러니 당신은 분명 그녀를 찾게 될 것이다. 그리고 네 임무는 그 천사 같은 존재를 가능한 한 깊이 타락시키는 거다. 그녀를 <font color="#008000"><b>음탕한 걸레</b></font>로 만들어라. 하지만 동시에 그녀는'
$azazel_quest[8] = '[아자젤]<br>&nbsp;그 어느 때보다 순종적이고, 기질도 살아 있어야 한다. 그리고 <font color="#008080"><b>아주 영리해야</b></font> 한다. 나는 그녀의 소통 능력이 필요하니까. 그녀를 내게 데려오면, 나는 그녀의 은총에 지옥의 힘을 주입해 천국으로 보내겠다. 그 멍청한 천사들은 날개를 뽑힌 자기 자매를 불쌍히 여겨 그녀를 회복시키려 들겠지.'
$azazel_quest[9] = '[아자젤]<br>&nbsp;하지만 그녀는 하얀 대천사와 섹스함으로써 그녀의 마지막 힘까지 빼앗아 갈 것이고, 동시에 그녀가 우리에게서 숨어 있는 장소까지 내게 보여 주게 될 거다.'
$azazel_quest[10] = '[아자젤]<br>&nbsp;나머지는 우리가 직접 처리한다. 그리고 승리는 우리의 것이 되겠지. 내 부탁을 완수하면, 내가 널 루시퍼에게 데려가 봉인을 받게 해 주겠다.'
$azazel_win[1] = '[아자젤]<br>&nbsp;내 기대를 훨씬 뛰어넘었군, <<$master_name>>! 이 여자애 덕분에 우린 마침내 저 하얀 날개 멍청이들을 먼지로 짓뭉개 버릴 수 있게 됐다. 당신은 네 봉인을 벌어 냈다. 루시퍼도 괜히 시간을 끌지 않고 넘겨줄 거라고 본다.'
$azazel_fail[1] = '[아자젤]<br>&nbsp;이런 중요한 임무를 맡기기엔 아직 준비가 안 됐다! 내 시간 낭비하지 말고 가서 제대로 해 와라! 나를 우롱하면 네 몸은 내 개들의 저녁이 될 거다!'
$demon_quest[1] = '[악마]<br>&nbsp;네가 아자젤을 존중했고, 사실상 우리의 승리를 보장해 주었다고 들었다. 좋다. 그렇다면 나도 너를 존중해 봉인을 내어 주지. 하지만 대가로 훈련이 아주 잘된 여자 둘을 내게 데려와라. 숙적에 대한 승리를 기념하는 연회에서 시중들 하녀들이 필요하거든. 전부 다 가르쳐 와라.'
$demon_quest[2] = '[악마]<br>&nbsp;<font color="#008080"><b>첫 번째</b></font>는 훌륭한 <font color="#008000"><b>첩</b></font>이자 <font color="#008080"><b>요리사</b></font>여야 한다. <font color="#008080"><b>춤, 노래, 에스코트</b></font>에도 능해야 하지.'
$demon_quest[3] = '[악마]<br>&nbsp;그녀는 <font color="#008080"><b>아름답고</b></font>, 부드럽고, 순종적이어야 한다. 두 번째는 진짜 여지배자여야 한다. <font color="#008000"><b>훌륭한 전사</b></font>이면서, 지도자다운 엄격한 성격을 갖춰야 해.'
$demon_quest[4] = '[악마]<br>&nbsp;그녀는 또 <font color="#008080"><b>훌륭한 마법사</b></font>이자 <font color="#008080"><b>의술가</b></font>여야 한다. 결전에서는 무슨 변수가 생길지 모르니까. 그리고 한 가지 더... 그녀는 처녀여야 한다.' 
$demon_quest[5] = '[악마]<br>&nbsp;내가 직접 그녀를 내 은총으로 채워 우리 군대에 입대시키고 싶기 때문이다. 그것도 아주 아름답게 말이지. 그러니 그녀의 <font color="#008080"><b>아름다움</b></font>과 연약함도 잘 보존해 두어라.'
$demon_quest[6] = '[악마]<br>&nbsp;그 둘을 내게 데려오면 봉인을 주겠다. 그리고 이제 난 가 봐야 한다. 내 발치의 이 하얀 날개 잡것은 내 좆으로 제대로 고문받을 자격이 있으니까. 그러니 내 중요한 일을 방해하지 마라...'
$demon_win[1] = '[악마]<br>&nbsp;훌륭한 일솜씨다, <<$master_name>>! 이 여자애들은 내 후궁에 완벽하게 들어맞겠군! 당신은 네 봉인을 벌었다. 자, 받아라! 이제 내버려 둬라! 이 위대한 순간을 이 하얀 날개 생물과 단둘이 즐기고 싶으니까! 머지않아 천사들은 내 발아래 쓰러질 것이다! 그리고 마침내 난 내가 꿈꾸던 것을 손에 넣겠지...'
$demon_fail[1] = '[악마]<br>&nbsp;뭘 내게 팔아먹으려는 거냐, 노예상인?! 네 여자들은 지금 내 좆에 꿰인 이 하얀 날개 생물보다도 쓸모가 없군! 썩 꺼져라, 그리고 제대로 훈련시킨 여자들을 데려오기 전엔 돌아오지 마라!'
! JO9 MOD END J9M2527

! JO9 MOD START J9M2526 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$catfightclub_slave_presentation[1] = '[에게야]<br>&nbsp;운과 네 노예의 힘을 시험해 보려는 건가, <<$master_name>>? 난 대찬성이야! 어디 한번 이 계집이 뭘 할 수 있는지 보자고... 신사 숙녀 여러분, 소오오개합니다 - <<$slave_name>>!!! 이 여자에게 도전해 볼 사람 있나?...'
! JO9 MOD END J9M2526

! JO9 MOD START J9M2525 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$pharmacy[0] = '[마리안나]<br>&nbsp;봐요, <<$master_name>>, 부끄러워하지 말고요. 새 물건은 없지만, 당신에게 필요할 만한 건 다 갖추고 있어요.'
! JO9 MOD END J9M2525

! JO9 MOD START J9M2524 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$pharmacy[4] = '[마리안나]<br>&nbsp;음, 이건 좀 흥미가 가네요... 당신이 가져온 걸 보여 줄 건가요, 아니면 제 특별 주문부터 들을 건가요?'
! JO9 MOD END J9M2524

$pharmacy[100] = ''

! JO9 MOD START J9M2523 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$pharmacy_deny = '[마리안나]<br>&nbsp;저희는 할부도 안 하고 외상도 안 해요, <<$master_name>>. 우리 물건을 살 만큼 스파크를 갖추고 다시 오세요.'
! JO9 MOD END J9M2523

! JO9 MOD START J9M2522 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$pharmacy_accept = '[마리안나]<br>&nbsp;여기 구매하신 물건이에요, <<$master_name>>! 원하신다면 최상의 상태로, 제시간에 맞춰 배달해 줄 전령도 보내 드릴 수 있어요.'
! JO9 MOD END J9M2522

!Black Market

! JO9 MOD START J9M2521 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$black_bazar_info[0] = '[나타샤]<br>&nbsp;'
$black_bazar_info[1] = '[나타샤]<br>&nbsp;가장 특별한 노예들은 언제나 우리 쪽에서 찾을 수 있어. 우리 여자애들은 상품이 되기 전에 특별 훈련을 거쳐. 높은 품질과 충성도는 우리가 보증하지.'
$black_bazar_info[2] = '[나타샤]<br>&nbsp;하지만 대가문 소속이 아닌 자가 살아 있는 생물을 들여오는 건 바티칸의 근본 규칙 중 하나로 엄격히 금지되어 있기 때문에, 우린 이런 엿 같은 곳에 숨어 지낼 수밖에 없어. 이 일은 꽤 위험하지만, 도시 안으로 들어오는 물건들과는 달리 거의 통제할 수가 없거든...'
$black_bazar_info[3] = '[나타샤]<br>&nbsp;그 모든 금지와 제한에도 불구하고, 우리 물건은 너 같은 인간들 사이에서 수요가 엄청나. 심지어 여자애들 가격표를 최저 수준까지 낮췄을 때조차 수입은 더 늘었어. 너만큼 부유하지 않은 시민들까지 우리에게 몰려들기 시작했으니까.'
! JO9 MOD END J9M2521

! JO9 MOD START J9M2520 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$black_bazar_info[4] = '[나타샤]<br>&nbsp;그리고 믿어 봐, 우리 여자애들은 진짜 최상급이야! 저 다듬어진 몸매를 좀 봐! 능력도 말 그대로 이 세상 것이 아니고! 특별한 헌신성은 말할 것도 없지...'
$black_bazar_info[5] = '[나타샤]<br>&nbsp;우린 전 세계의 여자애들을 다 갖고 있어. 아시아인, 아프리카인, 유럽인, 슬라브계 - 전부 다. 그리고 각각 자기만의 독특한 특징도 있지... 예를 들면 여기 아프리카 여자애들 말이야... 집안일과 마법에 아주 뛰어나.'
$black_bazar_info[6] = '[나타샤]<br>&nbsp;그리고 이쪽은 아시아 여자애들이야. 이들도 일상생활과 치유 쪽엔 꽤 괜찮아. 하지만 보통은 성적 용도로 많이 쓰이지. 단단하고 어린 몸을 말뚝에 꿰듯 박고 싶다는 환상, 다들 한 번쯤은 있잖아?!'
$black_bazar_info[7] = '[나타샤]<br>&nbsp;이쪽은 유럽 여자들이야. 얘들에 대해선 이미 다 알겠지... 활기차고, 규율도 있고, 적당히 망가져 있으면서도 아름다움도 전혀 부족하지 않아. 노예주에겐 진짜 보물이지! 이런 싸구려 장난감 하나쯤 원하지 않는 남자는 한 번도 못 봤어.'
$black_bazar_info[8] = '[나타샤]<br>&nbsp;그리고 이건 특히 더 끝내주는 물건이지... 슬라브 여자들이야. 이렇게 놀라운 첩은 어디서도 못 구해... 말 그대로 못 하는 게 없어. 게다가 숨이 막힐 정도로 아름답고, 지구력도 좋고, 부지런하기까지 하지...'
$black_bazar_info[9] = '[나타샤]<br>&nbsp;우리 여자애들은 기본 능력치도 훌륭해. 매력적인 외모, 건강한 몸, 균형 잡힌 신경계, 그리고 머리도 좋지. 더 다듬는 데 필요한 건 약간의 끈기와 노력뿐이야.'
! JO9 MOD END J9M2520

! JO9 MOD START J9M2519 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$black_bazar_info[10] = '[나타샤]<br>&nbsp;그러니 선택은 네 몫이야... 가격은 하나당 1500 스파크. 경매에 내놓으면 훨씬 더 비싸게 팔릴 테니, 우리와 손잡는 이점은 분명하지. 당신은 아무 일도 안 하고 이익만 챙기면 돼.'
! JO9 MOD END J9M2519

!Port

! JO9 MOD START J9M2518 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Rafael_quest[1] = '[라파엘]<br>&nbsp;자, 앉아라, <<$master_name>>! 난 원래 적들과 상대하는 데 익숙하진 않다. 하지만 이번만큼은 아버지께서 굳이 너를 만나 보라고 하셨지. 네가 내게 아주 쓸모 있을 수 있다고 하시더군. 어디 한번 어떤 놈인지 보자고!... 시간 끌지 말고 본론으로 들어가자!'
$Rafael_quest[2] = '[라파엘]<br>&nbsp;내가 선원이라는 건 이미 알고 있겠지. 그러니 내가 흔한 항구 창녀나 주문할 거라 생각했나?! 하지만 아니야... 물론 선원들을 즐겁게 해 줄 여자애들도 내겐 필요하지. 하지만 네게 원하는 건 그게 아니다... 내겐 일류 <font color="#008080"><b>치유사</b></font>가 필요하다. 바다에선 싸움이 흔하고, 상처와 온갖 문제들이 늘 우리를 기다리고 있어. 그러니 빠르고 정확하게 치료할 수 있는 <font color="#0000CD"><b>여자애</b></font>가 필요해.'
$Rafael_quest[3] = '[라파엘]<br>&nbsp;훌륭한 <font color="#008080"><b>마법사</b></font>이면서 <font color="#008080"><b>요리사</b></font>라면 더 좋겠지. 든든하고 맛있는 식사는 언제나 도움이 되니까. 마법사의 재주도 바다에서 가끔은 쓸모가 있다. 그리고 당연히 깔끔하고 단정해야 해. 배 안은 반짝일 정도로 깨끗하고 정돈돼 있어야 하니까.'
$Rafael_quest[4] = '[라파엘]<br>&nbsp;아름다움 같은 건 관심 없다. 다른 것들도 마찬가지고. 굳이 따지자면... 성숙하고, <font color="#008080"><b>영리하고</b></font>, <font color="#008080"><b>튼튼한</b></font> 편이 좋겠군. 말처럼 일하게 될 테니, 하찮은 걸로 내 신경을 분산시켜선 안 되니까. 그게 전부다. 내 부탁을 완수하면, 앞으로도 더 협력할 생각을 해 보지.'
$Rafael_win[1] = '[라파엘]<br>&nbsp;흠! 나쁘지 않군, 여자애! 보아하니 재주도 있고 기술도 충분해. 딱 내가 원하던 거야! 내가 데려가지! 여기 네 스파크다. 그리고 그래... 당신은 내 관심을 끌 만한 놈이라는 걸 증명했어. 진짜 장사꾼이군, <<$master_name>>! 좋아, 그럼 괜찮은 가격에 끝내주는 여자애들을 살 수 있는 장소 좌표를 알려 주지.'
$Rafael_win[2] = '[라파엘]<br>&nbsp;물건의 질은 확실히 믿어도 된다. 내 물건이니까. 난 내 일을 안다. 결함이 있으면 팔기 전에 전부 손본다. 잘 써라! 이 협력이 우리 둘 모두에게 이득이 되길 바라지...'
$Rafael_fail[1] = '[라파엘]<br>&nbsp;내가 준비해 오라고 한 건 대체 어디 있지? 역시 당신은 아무짝에도 쓸모없군!'
! JO9 MOD END J9M2518

!Slave Psychology

! JO9 MOD START J9M2517 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$slave_psychology[1] = '[노예 심리]<br>&nbsp;주의: 이제 노예와 조수는 서로에게 다양한 감정을 품게 된다. 네 임무는 그 감정이 네 일에 지장을 줄 만큼 커지지 않도록 막는 것이다.'
$slave_psychology[2] = '[노예 심리]<br>&nbsp;노예와 조수 양쪽 모두에게 서로를 어떻게 생각하는지 물을 수 있다. 단, 그들의 의견은 주관적이며 현실을 언제나 정확히 반영하지는 않는다는 점을 명심해라. 그것은 오직 한 여자애가 다른 여자애를 어떻게 느끼는지만 보여 준다.'
$slave_psychology[3] = '[노예 심리]<br>&nbsp;노예와 조수가 서로 대화하지 못하게 금지해 관계 진전을 늦출 수는 있지만, 그건 일시적이고 믿기 어려운 조치다. 더 확실한 방법은 최소한 조수만이라도 기질이 낮은 노예를 쓰는 것이다. 기질이 낮을수록 강한 감정에 휘말릴 가능성도 낮다.'
$slave_psychology[4] = '[노예 심리]<br>&nbsp;여자애들의 관계는 직접 개입해서 바꿀 수도 있다. 서로에 대한 동정을 자극하거나, 결국 헤어져야 한다는 사실을 들이대는 식으로 말이다. 다만 이건 5일에 한 번 이상 하지 마라. 그 이상 자주 하면 효과가 없어진다. 둘에게 함께 즐거운 일이나 불쾌한 일을 강제로 시켜 그에 맞게 관계를 조정할 수도 있다.'
$slave_psychology[5] = '[노예 심리]<br>&nbsp;서로의 배경에 대해 관용적이게 만들거나 반대로 편협하게 만들어, 여자애들의 시각에 영향을 줄 수도 있다. 양쪽 모두 최대치의 관용을 가지게 되면 관계에 추가 보너스가 붙는데, 어떤 상황에서는 그게 바람직하지 않을 수도 있다는 점을 기억해라.'
$slave_psychology[6] = '[노예 심리]<br>&nbsp;두 노예의 관계가 지나치게 좋아지면 사랑에 빠질 수 있고, 그러면 노예를 팔 때 조수가 우울증에 빠지게 된다. 반대로 관계가 너무 나빠지면 노예들끼리 싸워 서로의 외모를 망쳐 놓는다. 심하면 칼로 서로를 찌를 수도 있다.'
$slave_psychology[7] = '[노예 심리]<br>&nbsp;노예 중 하나가 네게 사랑을 느끼게 되면, 사랑하는 친구를 잃는 일을 더 쉽게 견딜 수 있다. 하지만 사랑에 빠진 노예는 네가 다른 여자들과 맺는 관계에 질투하게 된다. 그 질투가 걷잡을 수 없이 커지게 만들고 싶지 않다면 그녀에게 신경 써라. 노예들에게 자주 기분이 어떤지 물어봐라.'
! JO9 MOD END J9M2517

! JO9 MOD START J9M2516 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$library_korvus[1] = '[코르부스 가문에 대하여]<br>&nbsp;코르부스 가문은 불사자들이다. 인간의 피를 갈망하는 언데드들이지만 수는 많지 않다. 이들은 도시에서 가장 부유한 세력이지만, 대음모 사건으로 그 수가 크게 줄어들었다.'
$library_korvus[2] = '[코르부스 가문에 대하여]<br>&nbsp;절멸의 위기에 직면하자, 영원의 오인 평의회는 어려운 결정을 내렸다. 많은 불사자들이 이를 비난하고 있다. 이제부터는 필멸자들에게도 이 세력에 합류하고 이후 전환될 권리를 부여하기로 한 것이다. 많은 이들이 그 기회를 붙잡았다...'
$library_taurus[1] = '[타우루스 가문에 대하여]<br>&nbsp;타우루스 가문은 불멸의 로마의 지배 가문이자 가장 큰 세력이다. 이 가문이 타락한 도시의 문화에 가장 큰 기여를 하여 지금의 모습을 만들었다고들 한다.'
$library_taurus[2] = '[타우루스 가문에 대하여]<br>&nbsp;교활한 정치가이자 전략가들인 이 가문의 사람들은 목표를 이루기 위한 책략과 집요함으로 유명하다. 가끔은 총대주교조차도 그들에게 조언을 구한다고 한다.'
$library_taurus[3] = '[타우루스 가문에 대하여]<br>&nbsp;대음모 사건이 이 세력에도 많은 문제를 안겨 주긴 했지만, 그 여파는 빠르게 정리되었다. 이 가문의 귀족들은 새로 들어오는 자들을 그리 달가워하지 않는다. 하지만 큰돈만 있다면 어떤 장애물도 넘을 수 있다...'
$library_serpis[1] = '[세르피스 가문에 대하여]<br>&nbsp;세르피스 가문은 타락한 도시의 지식과 기술의 중심이다. 이 가문에 대해 알려진 것은 거의 없다. 기술적 우위를 지닌 이 세력은 불멸의 로마의 일상사에는 개입하지 않으며, 지식을 계승으로 전하고 "사든가 아니면 꺼지든가"라는 원칙을 따른다.'
$library_serpis[2] = '[세르피스 가문에 대하여]<br>&nbsp;노예, 약물, 보석 등의 수입 감시를 포함해, 불멸의 로마의 거의 모든 행정 업무가 이들에게 맡겨져 있다. 대음모 사건에 이들이 얼마나 관여했는지는 여전히 불분명하며, 추방자들에 대한 태도 역시 마찬가지다.'
$library_serpis[3] = '[세르피스 가문에 대하여]<br>&nbsp;지금까지는 극소수만이 이 가문의 일원이 될 수 있었지만, 가능성은 언제나 있다...'
$library_kamira[1] = '[카미라 가문에 대하여]<br>&nbsp;카미라 가문은 추방자들의 가문이다. 이 세력은 창립 가문들 중 하나가 아니었고, 얼마 전까지만 해도 다른 가문들로부터 인정조차 받지 못했다. 소위 반인간 종족 대표들이 세운 세력이다. 혈통 순수주의를 따르던 다른 세력들은 이 짐승 같은 존재들을 인정하지 않았고, 학살과 억압의 대상으로 삼았다.'
$library_kamira[2] = '[카미라 가문에 대하여]<br>&nbsp;바로 그것이 훗날 대음모라 불리게 된 반란의 시작이었다. 이 세력은 힘과 지구력을 중시하는 모든 종족과 모든 생물들의 대표를 끌어모았다.'
$library_kamira[3] = '[카미라 가문에 대하여]<br>&nbsp;이 가문에서 정상에 오르는 건 꽤 쉽다. 여기선 존중과 돈이 모든 걸 결정하니까...'
$library_zagovor[1] = '[대음모]<br>&nbsp;카미라 가문이 어떻게 세르피스 가문의 전투 드론을 손에 넣었는지는 아직도 분명하지 않다. 세르피스 측은 안개 지대를 통과하는 운송 도중 무기가 도난당했다고 단정적으로 주장하며, 조기 경보 시스템의 불완전성을 그 이유로 든다. 하지만 많은 이들은 그것이 노골적인 거짓말이라고 믿는다.'
$library_zagovor[2] = '[대음모]<br>&nbsp;어쨌든 반란은 불멸의 로마를 뒤흔들었다. 반란군은 주문과 투사체를 막아 줄 엄폐물로 장갑 드론을 활용해 상층 구역의 상당 부분을 점령했고, 결국 바티칸의 정예 근위대 - 성교회의 최고 정예 전사들 - 에 의해 저지되었다.'
$library_zagovor[3] = '[대음모]<br>&nbsp;하지만 이런 노련한 전사와 마법사들조차도, 짐승들의 광란한 힘으로 강화된 기술 앞에서는 고전했다. 드론의 작열광선은 난공불락의 티타누스 갑옷마저 녹여 버렸다. 주문과 마법 무기는 폐허와 시체의 산을 남겼다. 양측 모두 손실을 입었다. 도시는 불탔다...'
$library_zagovor[4] = '[대음모]<br>&nbsp;대학살을 피하기 위해 대가문들은 협상 테이블에 앉을 수밖에 없었다. 이제 카미라 가문은 공식적으로 인정받고 세력으로서의 권리를 부여받았다. 하지만 이게 끝일 리는 없으며, 지배 가문들은 이 굴욕을 반드시 갚으려 할 것이다...'
$library_ugroza[1] = '[안개로부터의 위협]<br>&nbsp;모두는 이터널 시티 최하층 슬럼가의 잡배들이 아무 위협도 되지 않는다고 생각하는 데 익숙하다. 하지만 로마로부터 버림받은, 치욕스러운 사회의 찌꺼기들을 얕보는 건 치명적인 실수가 될 것이다. 대가문들 사이의 끊임없는 다툼은 오히려 그 사실을 더욱 분명히 하며, 종말을 재촉하고 있다...'
$library_ugroza[2] = '[안개로부터의 위협]<br>&nbsp;안개 속에서 이름을 버리고 무시무시한 힘을 얻은 강력한 지도자 아래, 가장 잔혹한 존재들이 하나의 군대로 모이기 시작했다. 이 군대는 곧 불멸의 로마를 불과 피로 잠기게 만들 태세다. 지금은 오직 세르피스 가문의 포탑 방어선만이 그들을 막아 세우고 있다. 하지만 그게 언제까지 가능할까?'
! JO9 MOD END J9M2516

$pregnant_female_taken[1] = ' 아침 일을 거의 마무리할 무렵, 끈질긴 노크 소리가 들린다. 문 앞에는 바티칸의 여사제가 서 있고, 뒤에는 스위스 근위대 한 소대가 따라와 있다.'
! JO9 MOD START J9M2515 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$pregnant_female_taken[2] = '[블랑셰 수녀원장]<br>&nbsp;가우데테(기뻐하라), 마스터 <<$master_name>>! 저는 고아 돌봄 회중의 에스테르 블랑셰 수녀원장입니다. 들어가도 될까요? 감사합니다.'
$pregnant_female_taken[3] = '[블랑셰 수녀원장]<br>&nbsp;당신이 임신의 명백한 징후를 보이는 노예를 두고 있다는 보고를 받았습니다. 사실인가요?... 오오! 네, 바로 당신이군요!'
$pregnant_female_taken[4] = ' 네, 저는 임신했어요. 하지만 바티칸이 이 일에 왜 관심을 갖는지는 잘 모르겠네요.'
$pregnant_female_taken[5] = '[블랑셰 수녀원장]<br>&nbsp;로마에서 임신 4개월이 넘은 모든 임산부는 교회의 보호 아래 놓여야 한다는 법을 정말 잊으신 건가요, 아니면 모르는 척하시는 건가요?'
$pregnant_female_taken[6] = ' 그런 걸 어떻게 잊겠어요? 그냥 절 데려가고 싶은 거잖아요. 그리고 저도 이 아이에 대해 계획이 있을 수 있어요.'
$pregnant_female_taken[7] = '[블랑셰 수녀원장]<br>&nbsp;주님께서 바로 로마 안에서 새로운 영혼이 태어나도록 허락하시는 일은 매우 드뭅니다. 특별한 의식 없이는 더더욱 불가능하지요. 우리의 돌봄 없이는 당신 아이는 영혼 없이 태어나게 됩니다. 그리고 곧 죽게 될 거예요.'
$pregnant_female_taken[8] = '[블랑셰 수녀원장]<br>&nbsp;당신 자신에 대해선 걱정하지 마세요. 당신은 무사할 겁니다. 그리고 출산 후 몸을 추스르면 아이를 돌려받게 될 거예요.'
$pregnant_female_taken[9] = ' 하지만 전 시간을 잃게 돼요. 수십 년을요! 그리고 우리 일에선 시간이 곧 스파크예요. 출산 중 아이가 죽으면 어쩌죠? 아니면 제게 무슨 일이 생기면요? 당신네 의료 수준은 중세나 다름없잖아요.'
$pregnant_female_taken[10] = '[블랑셰 수녀원장]<br>&nbsp;저희는 아이 받는 법을 압니다, <<$master_name>>. 솔직히 말하면 당신보다 훨씬 더 잘 알지요. 하지만 당신의 우려도 이해합니다. 저는 당신 손실의 일부를 보상할 권한을 받았습니다. 물론 <<ransom>> 스파크, 얼마 안 되는 금액이긴 하지만 그래도 보상은 보상이죠...'
$pregnant_female_taken[11] = ' 전 그걸로는 만족 못 하겠어요...'
$pregnant_female_taken[12] = '[블랑셰 수녀원장]<br>&nbsp;<<$master_name>>, 저는 아직 태어나지 않은 아이들을 교회의 구원으로부터 숨기는 자에게 무력을 사용할 권한까지 부여받았습니다!!! 당신도 예외가 아닙니다!!!'
$pregnant_female_taken[13] = '[블랑셰 수녀원장]<br>&nbsp;그러니 흥정은 여기서 끝내죠. 생각해 보면 당신과 저는 아주 닮았습니다. 성직자들이 그러하듯, 노예상인들 역시 신의 종들에게 겸손을 가르치는 일에 삶을 바치니까요. 제가 당신에게 직접 그 교훈을 가르치게 만들지 마세요.'
$pregnant_female_taken[14] = ' 좋아요! 동의할게요...'
$pregnant_female_taken[15] = '[블랑셰 수녀원장]<br>&nbsp;스파크는 퇴원할 때 받게 될 겁니다, <<$master_name>>. 그 뒤엔 다시 일하러 돌아가게 되겠지요. 하지만 제 경험상, 차라리 그 일을 접고 집에서 아이를 돌보는 편이 더 나아요! 아이에겐 집에서의 당신이 훨씬 더 필요할 테니까요. 그리고 스파크쯤이야 예를 들면 길거리에서도 쉽게 벌 수 있잖아요. 빠르고 간단하게! 하지만 지금 중요한 건 그게 아니죠... 짐 쌀 하루를 주겠습니다. 꼭 필요한 것만 챙기세요. 나머지는 현지에서 제공될 겁니다. 아, 그리고... 당신의 분별을 믿겠습니다. 똑똑한 여자답게 저를 피해 숨진 않겠죠?! 뱃속 아이에게 무슨 짓도 안 할 거고요? 여자의 일은 아이를 낳는 것입니다! 그게 여자가 가진 가장 위대한 선물이니까요... 그럼 내일 봅시다, <<$master_name>>!!!'
! JO9 MOD END J9M2515

! JO9 MOD START J9M2514 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$grakh_quest[1] = '[라니스타 그라쿠스]<br>&nbsp;어이, 상인, 잠깐! 이리 와! 거절할 수 없는 제안이 하나 있다...'
$grakh_quest[2] = '[라니스타 그라쿠스]<br>&nbsp;마음이 있다면 잘 들어. 내 검투사 학교 이야기는 이미 들었겠지, 로마에서도 손꼽히는 곳이라는 것도. 그렇지?!'
$grakh_quest[3] = '[라니스타 그라쿠스]<br>&nbsp;하지만 요즘 날 체면 구기게 만드는 게 하나 있다. 최근 들어 손실이 엄청나게 커졌어. 내 노예들이 투기장에서 파리처럼 죽어 나가고 있거든. 사람들은 내 학교 출신의 옛 영광스러운 전사들을 점점 잊기 시작했고, 내가 무얼 해도 전부 헛수고다.'
$grakh_quest[4] = '[라니스타 그라쿠스]<br>&nbsp;이걸 바로잡을 수 있는 방법이 하나 떠올랐지... 하지만 네 도움이 필요해... 다만 미리 말해 두자면, 지금 내겐 남는 스파크가 없다. 대신 네게 아주 유용할 물건은 하나 있지... 스파크야 어디서든 구할 수 있지만, 내가 가진 이 부적은 어디서도 못 구한다!..'
$grakh_quest[5] = '[라니스타 그라쿠스]<br>&nbsp;...그러니까... 이 부적의 힘은 정말 대단하다. 온갖 질병과 중상모략으로부터 널 지켜 줄 뿐 아니라, 전례 없는 지구력까지 주지. 인정하자고, 이렇게 바쁘게 돌아가는 세상에선 엄청 유용하지 않겠어?! 그리고 그 대가로 내가 네게 요구하는 건 아주 사소한 거다 - 괜찮은 노예 하나. 해낼 수 있겠나?'
$grakh_quest[6] = '[라니스타 그라쿠스]<br>&nbsp;내게 필요한 건 노예다. 가장 중요한 건 그녀가 투기장에선 암사자 같아야 한다는 거다. 하지만 동시에 성장 가능성도 있어야 해. 난 아레나 챔피언이 필요하다. 그리고 동시에, 경주에서도 이길 수 있고 전차에 매였을 때 보기까지 좋은 아름다운 말이길 원해. 그래야 내 평판이 올라가니까.'
$grakh_quest[7] = '[라니스타 그라쿠스]<br>&nbsp;그런 노예를 길러 오면 부적은 네 것이다! 서두르진 않겠다. 정말 날 부자로 만들어 줄 누군가가 필요하거든. 그러니 얼마든지 기다릴 생각이다. 알맞은 처녀가 생기면 포럼에서 나를 찾아와라. 믿어 봐라, 이 부적은 내 부탁에 충분히 걸맞은 보상이다.'
$grakh_win[1] = '[라니스타 그라쿠스]<br>&nbsp;바로 이거다! 말이 안 나오는군... 내가 데려가겠다! 이건 순식간에 본전을 뽑고도 남을 거다, 장담하지. 그리고 여기, 약속한 물건이다. 이 부적을 몸에 지니고 다녀라. 그 힘이 너와 함께하길.'
$grakh_fail[1] = '[라니스타 그라쿠스]<br>&nbsp;날 부자로 만들어 줄 여자애를 네가 데려다줄 때까지 난 기다릴 거다. 그런 애를 길러 오면 부적은 네 것이다. 믿어 봐, 정말 멋진 물건이니까!'
! JO9 MOD END J9M2514

!Emperor and Barbarian King Quests

! JO9 MOD START J9M2513 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Gay_quest[1] = '[황제 가이우스]<br>&nbsp;다시 보게 되어 기쁘군, <<$master_name>>. 지난번에 만났을 때, 부탁 하나를 들어주면 솔깃한 제안을 해 주겠다고 했었지. 난 아직도 그 얘기를 할 생각이 있다...'
$Gay_quest[2] = '[황제 가이우스]<br>&nbsp;마음이 있다면 잘 들어라. 알다시피 나는 로마의 황제고, 이곳의 모든 것을 절대적으로 지배한다... 단 하나만 빼고... 아니, 정확히는 한... 여자만 빼고... 그녀 이름은 베네라다. 내 아내의 자매지. 너도 분명 알고 있을 거다.'
$Gay_quest[3] = '[황제 가이우스]<br>&nbsp;내가 무슨 짓을 해도 그녀는 내게 굴복하길 거부한다. 그런데 다른 놈들한테는 그런 짓을 다 하면서 말이지... 그게 날 정말 미치게 만든다. 그래서 난 그녀를 오직 내 것으로 만들고 싶다. 다른 선택지는 없다. 그리고 네게 부탁이 하나 있다... 이 붉은 머리년의 반항심을 내 대신 꺾을 방법을 네가 찾아내길 바란다...'
$Gay_quest[4] = '[황제 가이우스]<br>&nbsp;그녀를 굴욕 주고, 발닦개로 만들고, 내게 데려와라. 내 의지에 복종하고 내게 무슨 짓이든 하려는 상태로 말이다. 단 하나의 부탁만 하겠다. 그녀의 신성한 아름다움만은 건드리지 마라.'
$Gay_quest[5] = '[황제 가이우스]<br>&nbsp;그녀의 대가로 내 아내를 주겠다. 그래, 제대로 들었다... 그 쓸모없는 걸 노예로 넘겨 주지. 아름답긴 하다, 인정하지. 하지만 쓸모가 없다. 섹스조차 감흥이 없어. 난 필요 없다. 네 마음대로 해라. 어쩌면 네가 뭔가 가르칠 수 있을지도 모르지.'
$Gay_quest[6] = '[황제 가이우스]<br>&nbsp;그리고 걱정 마라. 난 한 말을 허투루 내뱉지 않는다. 내가 말하면 그대로 되는 거다. 내 말 한마디면 그녀는 내 아내에서 흔한 노예로 떨어진다. 이 제안이 어떤가, <<$master_name>>? 충분히 고민해 볼 만한 가치가 있다고 생각하는데... 받아들일 생각이 있다면, 베네라가 내 발치로 기어오는 순간을 난 애타게 기다리고 있겠다. 언제든 여기서 기다릴 테니.'
$Gay_win[1] = '[황제 가이우스]<br>&nbsp;봐라, 한때 그토록 고집 세고 위대한 로마의 유명인이던 년이, 지금은 내 다리 사이에서 순종적인 암캐가 되어 있다! 정말 고맙군! 아, 그래... 네 보상 말이지... 약속대로, 이제부터 펠라게야는 네 것이다. 마음껏 즐겨라.'
$Gay_win[2] = '[황제 가이우스]<br>&nbsp;하지만 나는 네가 더 받아야 한다고도 생각한다... 내게 해 준 봉사에 대한 감사의 표시로, 오늘 너를 기리는 축일을 선포하겠다. 당신은 그런 영예를 받을 자격이 있다... 레가투스, 도시가 즉시 그 준비를 하도록 해라! 그동안 나는 너를 저녁 식사에 초대하겠다, <<$master_name>>.'
! JO9 MOD END J9M2513
$Gay_win[3] = ' 황제가 준 그런 선물에서 정신을 차리는 데는 꽤 오랜 시간이 걸렸다. 제국 궁전의 발코니에서, 너와 황제 가이우스와 모든 신들을 찬양하는 사람들과 예인들, 음악가들로 도시가 가득 차는 모습을 내려다보며, 축제가 시작될 시간이 다가온 것도 알아차리지 못했다.'

! JO9 MOD START J9M2512 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Gay_win[4] = ' 당신은 엄선된 노예 셋이 끄는 황제의 황금 전차로 안내되었다. 황제 가이우스도 레가투스에게 몇 가지 지시를 내린 뒤 곧 합류했다. 그리고 광장에 모인 군중의 귀청이 찢어질 듯한 야유 속에, 족쇄를 찬 채 완전히 벌거벗은 황제의 전처가 축하의 기둥 앞으로 끌려왔을 때, 행렬은 출발했다.'
! JO9 MOD END J9M2512

! JO9 MOD START J9M2511 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Gay_win[5] = ' 들뜬 로마 군중의 환호를 받으며 축하 행렬은 도시 거리를 지나 콜로세움에 도착했다. 축하의 검투 경기와 함께한 포도주와 최고급 후궁들, 그 밖의 사치들은 흐릿한 안개처럼 지나갔다. 축제가 끝나고 가이우스가 의식적으로 너의 새 노예가 된 자에 대한 권리를 넘겨줄 때에야, 당신은 비로소 정신을 차렸다.'
! JO9 MOD END J9M2511

! JO9 MOD START J9M2510 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Gay_win[6] = ' 전리품을 거둔 뒤, 당신은 길드로 향했다. 새 재산의 등록을 하는 동안 펠라게야는 노예 대기 구역으로 보내졌고, 그곳에서 길드 직원들이 그녀에게 자신의 새로운 신분이 무엇을 의미하는지 구구절절 설명해 주었다. 절차가 끝났을 때, 오늘 하루 동안 자기 평생보다 더 많은 상스러운 욕설을 들어야 했던 펠라게야는 네 노예가 되어 있었다. '
$Gay_win[7] = ' 길드 호위로부터 새 재산을 넘겨받은 당신은 만족감과 행복에 차, 새 장난감을 탐욕스럽게 바라보며 감정을 거의 억누르지 못했다: 둘째 자매는 이제 완전히 내 창녀다. 진짜 "왕실식" 따먹기가 어떤 건지 곧 알게 되겠군!'
$Gay_fail[1] = '[황제 가이우스]<br>&nbsp;"붉은 머리 창녀가 나를 자기 주인으로 인정하는 순간을 아직도 기다리고 있다. 너무 오래 기다리게 되지 않기를 바랄 뿐이다...'
! JO9 MOD END J9M2510

! JO9 MOD START J9M2509 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Varvar_king_quest[1] = '[바르바르 왕]<br>&nbsp;오랜만이군, <<$master_name>>! 자네가 최근 올린 성과들에 대해 들었다. 그리고 자네에게 내가 간절히 필요한 무언가가 있다는 것도 알고 있지...'
$Varvar_king_quest[2] = '[바르바르 왕]<br>&nbsp;가이우스의 전처가 필요하다. 영구 소유하겠다는 건 아니다. 빌려 달라는 거지. 어쨌든 그녀가 필요해... 지금 자네가 데리고 있지, 맞나? 걱정 마라, 사지 멀쩡하게 돌려줄 테니. 난 그저 그녀의 귀와 눈이 필요한 것뿐이다. 내가 알아야 할 정보를 그 여자가 알고 있을 테니까. 그래서 어쩔 수 없이 자네에게 도움을 청하는 거다.'
$Varvar_king_quest[3] = '[바르바르 왕]<br>&nbsp;그 여자가 나한테 무슨 도움이 될지 궁금하겠지... 자세한 사정까지 말하진 않겠다. 그저 복수를 위해 필요하다고만 해 두지... 가이우스 놈을 향한 복수 말이다... 그놈은 오래전에 날 배신했고, 이제 난 피의 복수를 갈망하고 있다. 그놈의 왕좌를 내가 차지할 거다. 그리고 펠라게야가 날 도울 거다. 언제, 어떻게 침투해야 할지 그 여자가 말해 줄 테니까.'
$Varvar_king_quest[4] = '[바르바르 왕]<br>&nbsp;이제 전부 알게 되었군. 설마 가이우스에게 이 사실을 고해바칠 만큼 어리석진 않겠지. 전쟁터에선 수단과 방법을 가리지 않는 법이라는 걸 잘 알 텐데. 만약 날 배신한다면, 자네는 절대 다음 날 아침을 맞이하지 못할 거다.'
$Varvar_king_quest[5] = '[바르바르 왕]<br>&nbsp;아, 그래... 하마터면 잊을 뻔했군... 부탁이 하나 더 있다. 자네는 길드와 위대한 가문들에 영향력이 있지 않나? 그러니 그놈들이 습격에 대비하지 못하도록 조치해 둬라. 필요하다면 시선을 딴 데로 돌리든가. 자네 재능이라면 이까짓 사소한 일쯤은 거뜬하겠지.'
$Varvar_king_quest[6] = '[바르바르 왕]<br>&nbsp;모든 일이 잘 풀리면 펠라게야를 반드시 돌려주겠다고 약속하마. 별 탈 없이 끝난다면, 자네가 아주 좋아하는 그녀의 여동생까지 얹어 주지... 이 정도면 설득이 됐나, <<$master_name>>? 그럼, 나중에 보지...'
$Varvar_king_quest[7] = '[바르바르 왕]<br>&nbsp;아, 그리고 하나 더... 내가 거짓말한 게 딱 하나 있는데, 펠라게야 손끝 하나 안 건드리겠다는 부분이다. 아마 내 장군들에게 유흥거리로 던져주게 될 것 같군. 그 녀석들은 나에 대한 충성심으로 그런 볼거리를 누릴 자격이 충분하니까. 그러니 나한테 데려오기 전에, 그 여자가 예쁜지, 몸으로 날 기쁘게 해줄 수 있는지 똑똑히 확인해 둬라...'
$Varvar_king_quest[8] = '[바르바르 왕]<br>&nbsp;왕의 이름을 걸고 약속하는데, 딱 한 번만 쓰고 자네를 위해 최상의 상태로 완전히 원상복구시켜 주마. 자네가 차이를 느끼지도 못할 정도로 말이다. 자, 이제 됐다... 이걸로 다 정리가 된 것 같군... 자네와 그 새로운 장난감이 나를 찾아오길 기다리고 있겠다...'
$Varvar_king_win[1] = '[바르바르 왕]<br>&nbsp;기막히군! 겉은 여왕인데 속은 아주 탕녀가 따로 없잖아! 게다가 이렇게 순종적이라니... 그저 빌리는 걸로 끝낸다는 게 아쉬울 지경이군. 이제 포탑들을 손쉽게 무력화하고 로마의 방어선을 뚫을 수 있겠어. 머지않아 모든 가문들이 내 앞에 무릎을 꿇을 거다. 조금만 참아라. 며칠 뒤면 자네의 인생도 바뀌어 있을 테니...'
$Varvar_king_fail[1] = '[바르바르 왕]<br>&nbsp;가문들이나 길드 놈들이 무언가 눈치를 채고 있는 것 같다. 알아서 더 조사해 봐라! 그리고 이... 자네 장난감 말인데... 도움이 될지도 모르겠지만... 장담은 못 하겠군. 조금 더 손을 좀 봐다오!'
! JO9 MOD END J9M2509

$kotshey_bessmertniy_quest[1] = ' [불사의 코셰이]
- 예전엔 말이다, 새파란 영웅 놈들이 영웅 놀이랍시고 날뛰며 납치된 공주를 되찾겠다고 나한테 찾아오곤 했지. 그땐 내게 처녀들이 차고 넘쳤단 말이다. 어린애부터 성숙한 여인, 얌전한 애부터 오만한 애까지... 온갖 취향대로 다 있었지!
아, 그래... 세월이 흘렀어. 그 영웅 놈들도 흙으로 돌아갔고, 그놈들의 공주들 역시 그렇게 됐지...'
! JO9 MOD START J9M2508 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$kotshey_bessmertniy_quest[2] = '[불사의 코셰이]<br>&nbsp;이 땅엔 이제 공주도 씨가 말라서 납치할 놈도 없어. 얼마나 수치스러운 일인지 상상이나 가냐, 어? 근데 이젠 처녀들이 제 발로 날 찾아오는 지경까지 이르렀단 말이지! 왜 얼굴을 찌푸려, 내 말이 듣기 싫으냐, 어? 거 참 보게, 자존심 한번 대단하군. 난 그렇게 성깔이 팍팍 티 나는 놈들이 아주 마음에 들어.'
$kotshey_bessmertniy_quest[3] = '[불사의 코셰이]<br>&nbsp;혹시 너, 왕족의 피라도 흐르는 거냐? 그냥 널 저택에 가둬버릴까? 달콤한 과자나 대접받으면서 평생 빗보다 무게 나가는 건 손도 안 대고 살 수 있을 텐데! 제 발로 걸어왔으면서... 아니, 잠깐, 왜 이렇게 빨리 나가려고 해... 에잇 됐다, 의뢰는 다른 놈한테나 맡겨야겠군.'
$kotshey_bessmertniy_quest[4] = '[불사의 코셰이]<br>&nbsp;오, 이제야 좀 듣냐? 그래, 그래야지. 잘 봐라, 내가 공주 한 명을 가로챘거든. 아주 아름답고, 어여쁘고, 귀하신 왕족의 피가 흐르는 공주님이지! 근데 이 계집애가 고집이 지독하게 세서 말이야. 접시를 얼마나 깨부쉈는지, 그 검은 피부 녀석들이 죄다 쫄아버렸다니까. 예전 같았으면 내가 직접 길들였겠지만, 보다시피 너희 길드가 여기 있으니 맡겨보겠다는 거다.'
$kotshey_bessmertniy_quest[5] = '[불사의 코셰이]<br>&nbsp;눈 똑바로 뜨고, 귀 밝게 들어라! <font color="#009FEF"><b>그 성깔은 절대 건드리지 마라</b></font>. <font color="#0000D8"><b>내가 그 성질머리를 아주 좋아하거든.</b></font> <font color="#6B0084"><b>보고 있으면 피가 솟구치는 기분이란 말이다.</b> </font> 하지만 그 외의 모든 것은... 눈을 뗄 수 없을 정도의 <font color="#009900"><b>인형</b></font>처럼 만들어 놔. <font color="#009900"><b>춤추고, 노래하고, 악기를 연주하도록</b></font> 가르쳐라 — 할 줄은 아는데 영 어설프거든. <font color="#009FEF"><b>의술이랑 주술도 가르쳐라</b></font> — 내 곁을 수발들며 내 영혼에 기쁨을 줄 테니까.'
$kotshey_bessmertniy_quest[6] = '[불사의 코셰이]<br>&nbsp;<font color="#008080"><b>건강도 잘 회복시켜 놓아라</b></font>. 여기 와서 감기 기운이 좀 생겼거든. 바람과 열린 창문에 익숙지 않은 온실 속 화초라 말이다. <font color="#009900"><b>체형은 건드리지 마라</b></font> — 자작나무처럼 가느다란 채로 둬. 그리고 제일 중요한 건, <font color="#009900"><b>침대에서 기적을 부리게 만들어 놔라.</b></font> <font color="#cd0000"><b>다만 변태적인 짓은 절대 안 된다!</b></font> 그게 쓰일지 안 쓰일지는 나도 모르겠다만, 어쨌든 공주란 말이다...'
$kotshey_bessmertniy_quest[7] = '[불사의 코셰이]<br>&nbsp;내 늙은 육신이 버텨낼 수 있을지 모르겠군. 특히 네가 그 아이를 잘 길들여서 순종적으로 만들어 놓는다면 말이야! 그리고 절대 <b>낙인 따위는 찍지 마라</b> — 그 애는 공주지, 네놈 영광을 자랑할 상품이 아니니까. ...뭘 멀뚱히 서 있어?! 공주 데리고 가서 당장 일이나 해라!'
! JO9 MOD END J9M2508

! JO9 MOD START J9M2507 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$kotshey_bessmertniy_win[1] = '[불사의 코셰이]<br>&nbsp;오오, 큰 은혜를 베풀어 주었구나, 아름다운 것아, 큰 은혜를 베풀어 주었어. 늙은이를 기쁘게 했고, 내 영혼에 기쁨을 가져다주었지. 이 정도라면 돈쯤은 아깝지 않다! 재능이 없다고는 말도 못 하겠구나, 마치 지혜롭고 아름답기까지 했던 두 번째 바실리사 같아... 그리고 말이다, 며칠 뒤에 다시 와라! 너한테 맡길 일이 하나 더 생겼다...'
$kotshey_bessmertniy_fail[1] = '[불사의 코셰이]<br>&nbsp;악마가 널 후려쳤으면 좋겠구나, 이 두꺼비 같은 놈아. 내 작은 꽃, 내 영혼의 기쁨에게 무슨 짓을 한 게냐?! 마지막 공주까지 망쳐 놨구나, 이 멍청이! 내 눈앞에서 썩 꺼져라, 내가 널 저주하기 전에!'
! JO9 MOD END J9M2507

! JO9 MOD START J9M2506 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Shlyapkin_quest[1] = '[슐랴프킨]<br>&nbsp;드디어 만나는군, 동료! 내가 길드를 떠난 지 얼마나 됐는데, 달라진 게 하나도 없군...<br>[당신]<br>&nbsp;무슨 소리야, 슐랴프킨?'
$Shlyapkin_quest[2] = '[슐랴프킨]<br>&nbsp;아, 제발 좀, <<$master_name>>! 내가 무슨 말 하는지 당신도 완벽하게 알고 있잖아! 길드는 너무 뻔해! 예전에도 바티칸의 만능 땜질 도구였고, 지금도 그렇지. 설마 당신이 여기에 자기 자유의지로 왔다고 말하려는 건 아니겠지?! 주머니엔 스파크 한 푼도 없고, 여기서 뭘 해야 하는지에 대한 뚜렷한 정보도 없는 신참... 맞지, <<$master_name>>?'
$Shlyapkin_quest[3] = '[당신]<br>&nbsp;그 이상이지...<br>[슐랴프킨]<br>&nbsp;걱정 마, 친구. 난 네 적이 아니다. 나도 그런 처지에 한두 번 빠져 본 게 아니거든... 그리고 충분히 오래 살아서 지혜도 얻었고, 네가 상관이라고 여기는 저 멍청이 무리가 몇 수 앞을 어떻게 짤지 다 내다볼 정도는 됐지...'
$Shlyapkin_quest[4] = '[슐랴프킨]<br>&nbsp;언젠가 너나 너 같은 누군가가 나타나서 그 개자식이랑 그 늙은 조수를 상대로 크리스마스를 구하러 올 거라는 건 나도 아주 잘 알고 있었지! 놈들이 제법 많은 나쁜 짓을 할 수도 있겠지. 그리고 사회가 그 계획에 어떻게 반응할지는 아주 큰 문제고. 솔직히 말하면 놈들 계획이 먹힐 가능성도 있다. 하지만 난 여전히 그게 절대 실현되진 않을 거라고 확신해!'
$Shlyapkin_quest[5] = '[슐랴프킨]<br>&nbsp;물론 그린치와 그 공범은 모든 걸 교묘하게 짜 놓았지. 하지만 놈들은 안전장치도 없이 움직이고 있어. 뭔가 틀어지면 가장 먼저 가라앉는 배에서 도망칠 놈들도 바로 그들일 거다. 그리고, 보통 인간들에겐 해결 불가능한 문제가 생기면 거기엔 언제나 교황과 그의 정예 근위대가 있다는 사실도 잊지 마라. 그분이 한마디만 하면, 여기의 모든 건 그분 뜻대로 될 거다...'
$Shlyapkin_quest[6] = '[슐랴프킨]<br>&nbsp;하지만 바티칸은 전통적으로 필요할 때가 아니면 필멸자들의 일에 끼어들지 않고, 도시가 자기 문제를 스스로 해결하게 내버려 둔다. 바로 그래서 네가 여기 있는 거다. 그리고 있잖아, 전반적인 성공 가능성은 꽤 높아. 적어도 당신은 올바른 길 위에 있어... 그리고 난 네가 더 멀리 나아가게 조금 도와주지. 그렇다고 해서 네가 느긋해져도 된다는 뜻은 아니다...'
$Shlyapkin_quest[7] = '[슐랴프킨]<br>&nbsp;초록 허수아비와 그 늙은 창녀가 또 다른 뭔가를 꾸며내지 않으리라 장담할 수는 없어. 그러니 결정적인 돌격을 준비할 시간을 조금 벌어 주지... 우리가 최대한 늦출 수 있는 만큼, 스네구로치카는 아직 팔리지 않을 거다. 하지만 그렇다고 내가 그 광대들한테 대놓고 맞서 주진 않을 거야...'
$Shlyapkin_quest[8] = '[슐랴프킨]<br>&nbsp;놈들은 내 일에 돈을 너무 잘 쳐 주거든. 그리고 그게 내겐 아주 잘 맞는다는 걸 너도 충분히 이해하겠지... 난 이 밥줄을 잃을 생각이 전혀 없다. 게다가 스네구로치카에 무슨 일이 생기든 내 알 바도 아니야. 난 그 일에까지 마음 쓸 만큼 외롭진 않거든. 이 모든 요란한 짓 없이도 내 크리스마스트리는 내가 직접 꾸밀 수 있어...'
$Shlyapkin_quest[9] = '[슐랴프킨]<br>&nbsp;그러니 여기서부터는 네가 혼자 가야 한다. 내가 진짜로 도와줄 거라곤 기대도 하지 마라. 난 그저 몇 가지 유용한 힌트와, 네가 뭐든 준비할 시간을 좀 줄 뿐이다. 그 시간을 네가 어떻게 쓰든 내겐 전혀 관심 없다. 이것만으로도 난 이미 너한테 충분히 많이 해 주는 거니까.'
$Shlyapkin_quest[10] = '[슐랴프킨]<br>&nbsp;물론 공짜로 뭘 해 줄 생각은 없다. 네 편에 서 주는 내 충성심에는 그에 걸맞은 대가가 필요하지. 네게 맡길 일이 하나 있다. 복잡한 일도 아니다. 나 혼자서도 아무 문제 없이 해낼 수 있어. 하지만 난 안 할 거다. 왜 그런지는 곧 알게 되겠지...'
$Shlyapkin_quest[11] = '[슐랴프킨]<br>&nbsp;난 성인이 된 뒤로 줄곧 혼자였다. 그래, 취향과 색깔대로 온갖 여자들을 수십 명이나 길러 냈지. 그리고 원했다면 그 누구라도 내 것으로 남길 수 있었을 거다. 하지만 그건 전부 내가 직접 만든 결과물이었다. 내가 손댄 순간부터 그녀들은 더는 자연스러운 존재가 아니게 되고, 내가 심어 넣은 틀과 패턴이 되어 버리거든...'
$Shlyapkin_quest[12] = '[슐랴프킨]<br>&nbsp;그런데 속속들이 다 아는 로봇 같은 여자를 곁에 두는 게 무슨 의미가 있겠나? 내 집 안으로, 난롯가의 안주인으로 들어올 여자는 자연스럽고 유일무이해야 한다. 날 끌어야 해. 날마다 새롭게 알아 가고 싶어야 한다. 그런데 난 그런 여자는 직접 길러 낼 수가 없다. 그리고 내 집 안으로 들이고 싶은 여자도 이제껏 만나 본 적이 없었다.'
$Shlyapkin_quest[13] = '[슐랴프킨]<br>&nbsp;아니, 방금 말은 솔직하지 못했군. 한 명은 있었다. 바로 얼마 전에... 여기, 윈터스 테일에서. 치료 때문에 내게 데려왔지. 난 즉시 알아챘다. 이 사랑스럽고 어린 생물이 나한테 반해 버렸다는 걸... 그녀는 날 위해 뭐든 할 준비가 되어 있었다. 내 눈을 바라보는 그 눈빛에는 그런 헌신과 열정이 담겨 있었는데, 그걸 말로는 도저히 설명할 수가 없어... 그리고 고백하자면, 난 생전 처음으로 겁을 먹고 도망쳤다...'
$Shlyapkin_quest[14] = '[슐랴프킨]<br>&nbsp;이 다이아몬드를 망가뜨릴까 두려워서, 그냥 돌려보내 버렸지. 그리고 며칠 뒤에야 내가 무슨 실수를 했는지 깨달았다. 그녀는 내가 평생 꿈꿔 온 바로 그 여자가 될 수도 있었다. 그래, 조금 멍청하고 순진해서 꼭 아이 같긴 하다. 하지만 정말 보석 같은 아이였어! 그리고 난 내 두 손으로 내 행복을 부숴 버린 셈이지...'
$Shlyapkin_quest[15] = '[슐랴프킨]<br>&nbsp;이제 그녀가 날 실망스러운 남자로 여길까 두렵다. 그래서 내가 먼저 다가가진 않겠다. 흥분한 상태로 덤볐다간 끔찍한 실수를 해서 그녀를 망쳐 버릴지도 모르니까. 난 그녀를 다치게 하고 싶지 않아. 하지만 그 첫걸음은 네가 대신 내딛어라. 그녀를 찾아라. 그리고 아직도 내게 마음이 남아 있다면, 여기로 데려와라. 다만 그 전에, 육신을 입은 그 천사를 내 취향대로 조금만 다듬어 줘...'
$Shlyapkin_quest[16] = '[슐랴프킨]<br>&nbsp;난 그녀를 진짜 성숙한 여자로 보고 싶다. 내게 소박한 인간적 행복을 주고, 또 그것을 되돌려 받을 준비가 된 여자로 말이야. 그러니 그녀의 젊은 혈기와 과격함만 좀 덜어 내 줘. <font color="#008080"><b>영리하고</b></font>, <font color="#008080"><b>교양 있고</b></font>, 그러면서도 집에 돌아갈 때 즐겁게 웃으며 들어오고 싶어질 만큼은 <font color="#008080"><b>뜨거운</b></font> 여자였으면 한다...'
$Shlyapkin_quest[17] = '[슐랴프킨]<br>&nbsp;내가 집에 돌아왔을 때, 거기엔 <font color="#008000"><b>집안을 깨끗이 정리하고</b></font>, <font color="#008000"><b>먹여 주고</b></font>, 따뜻하게 안아 주고, 어루만져 줄 여자가 기다리고 있다는 확신이 필요하다. 물론 침대에서 어떨지는 난 별로 상관하지 않는다. 내 나이엔 그게 제일 중요한 건 아니니까... 그러니 그쪽으론 특별히 까다로운 요구도 없지...'
$Shlyapkin_quest[18] = '[슐랴프킨]<br>&nbsp;그저 그녀의 <font color="#008000"><b>아름다움</b></font>만은 지켜 주고, 타고난 재능을 잘 키워 줘라... 그리고 물론, <font color="#008080"><b>노래</b></font>를 익히고 춤까지 아주 훌륭하게 추게 된다면 난 반길 거다. 하지만 그건 네 재량에 맡기지. 중요한 건, 선을 넘지 않는 거다. 그리고 <b><i>낙인 찍을 생각은 절대 하지 마라</i></b>. 그녀는 노예가 아니니까... 내게 필요한 건 그게 전부다...'
$Shlyapkin_quest[19] = '[슐랴프킨]<br>&nbsp;네게 불가능한 일은 아닐 거다. 그리고 충분히 빨리 끝내 주길 바란다. 내 부탁을 마땅한 존중으로 받아들인다면, 나도 최대한 시간을 벌어 네가 그 멍청한 인형이랑 그 침구 문제를 전부 정리할 수 있게 해 주지...'
$Shlyapkin_win[1] = '[슐랴프킨]<br>&nbsp;맙소사! 아름답군! 지금 날 덮치는 이 감정들을 표현할 말이 전혀 없다... 이리 와라, 아가! 앞으로 우리에겐 충분한 시간이 있다. 내가 널 향해 저지른 실수를 다 바로잡을 만큼 말이야!'
$Shlyapkin_win[2] = '[슐랴프킨]<br>&nbsp;고맙다, <<$master_name>>! 정말 훌륭한 일을 해냈어. 진심으론 네 호의에 제대로 보답하고 싶지만, 지금은 상황이 좋지 않다. 스네구로치카는 곧 경매에 올라가게 되어 있어. 그리고 그걸 바꿀 방법이 내겐 없다. 놈들은 그냥 들이닥쳐 그녀를 데려가 버렸고, 왜 그렇게까지 서두르는지 설명조차 안 했어. 내가 아직 완벽하게 준비되지 않았다고 애원해도 들을 생각조차 없었지...'
$Shlyapkin_win[3] = '[슐랴프킨]<br>&nbsp;내가 네게 한 약속을 제대로 지키지 못했다는 건 안다. 하지만 그래도, 그린치와 산타의 아내를 향한 결정적인 한 방을 준비할 시간 정도는 벌었길 바란다. 여기, 네게 필요한 것들을 사는 데 쓰라고 스파크를 좀 주지. 행운을 빈다, <<$master_name>>!'
$Shlyapkin_fail[1] = '[슐랴프킨]<br>&nbsp;<<$slave_name>>, 내 사랑, 잠깐 산책 좀 하고 와라! 우리 둘이 얼굴 보고 할 얘기가 있으니... <<$master_name>>, 지금 그대로도 그녀는 완벽하다는 건 알아. 하지만 더 나아질 수 있다! 너도 그걸 누구보다 잘 알고 있잖나... 걱정 마라, 스네구로치카는 어디 안 간다. 내 부탁부터 끝내라. 그러면 네 문제도 그때 다뤄 주지...'
! JO9 MOD END J9M2506

! JO9 MOD START J9M2505 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Angry_goblins_quest[1] = '[고블린]<br>&nbsp;경영진은 당신 방문에 대해 우리한테 아무 말도 안 했어, <<$master_name>>! 그리고 그린치나 산타 부인이 널 만나고 싶어 할지도 확신이 안 간다. 적어도 네가 진지한 의도를 증명해 주기 전까진, 그런 일은 절대 없을 거다...'
$Angry_goblins_quest[2] = '[고블린]<br>&nbsp;그렇다고 내가 네가 뭘 해야 윈터스 테일의 주인들 흥미를 끌 수 있는지도 모르는 건 아니지. 뭐... 하나 떠오르는 건 있긴 하다... 우리 일 하나만 도와주면, 그린치를 만날 기회를 줄 수는 있어. 그 다음엔 널 어떻게 할지 그가 직접 결정하겠지...'
$Angry_goblins_quest[3] = '[고블린]<br>&nbsp;동의하나요, <<$master_name>>?... 아주 좋아!... 그럼... 우린 지금 웅장한 쇼 하나를 조직해야 한다. 그건 새 윈터스 테일의 대표 공연이 되어, 크리스마스트리 점등 행사니 우울한 노래와 춤이니 하는 그 모든 걸 완전히 대체하게 될 거다. 과거 크리스마스 때 여기 손님들에게 보여 주던 것과 비교하면, 이건 차원이 완전히 다른 프로젝트지...'
$Angry_goblins_quest[4] = '[고블린]<br>&nbsp;섹스와 열기, 들뜬 기운이 넘치는 바다가 될 거다. 수백 개의 눈부신 여성 몸들이 손님들 앞에서 진정한 춤의 예술을 보여 줄 거야. 그리고 우리 무희들이 흥분의 정점에 가까워질수록, 윈터스 테일 전체를 뒤덮는 음악은 더 크게 울려 퍼지겠지... 섹스의 음악... 그리고 바로 그 무희들 자신이 이 음악을 만들어 낼 거다...'
$Angry_goblins_quest[5] = '[고블린]<br>&nbsp;라이브 음악에 맞춰, 윈터스 테일 곳곳에서는 정액의 분수가 끝없이 솟아오를 거다. 그리고 이 불꽃놀이 같은 분출이 얼마나 많을지, 모든 게 크림의 강물 속에 잠겨 버릴 정도가 될 거야... ... 엄청난 장관이 되겠지. 그리고 벌써 네가 우리 아이디어에 감탄하고 있다는 것도 보이고, <<$master_name>>! 하지만 우리에게는 아주 큰 문제가 하나 있다...'
$Angry_goblins_quest[6] = '[고블린]<br>&nbsp;모든 쇼에는 프리마돈나가 필요하다. 그리고 알다시피, 단순히 괜찮은 공연자 정도로는 안 된다. 무조건 최상급 스타여야 해. 무대 위에서 무적이어야 할 뿐 아니라, 프로젝트의 얼굴로서, 그 이후까지도 모든 걸 책임질 수 있어야 하지... 바로 거기서 우리가 막히고 있다...'
$Angry_goblins_quest[7] = '[고블린]<br>&nbsp;여기 설녀들이니 토끼니 사슴이니 하는 것들을 배우라고 부를 순 없잖아. 이 재능 없는 년들은 기껏해야 엑스트라감이다. 그것도 후하게 쳐 줘서 그렇다는 거고... 그 죽은 짐짝들 사이에서 간신히 좀 쓸 만하다 싶은 계집 셋을 추려내긴 했지...'
$Angry_goblins_quest[8] = '[고블린]<br>&nbsp;근데 그 셋 상태 좀 봐라!... 하나는 목소리는 훈련된 것 같고, 움직임도 괜찮고, 타고난 걸레인 것도 맞다. 하지만 가슴은 너무 작고, 늘 시큰둥한 표정을 하고 있어서 절대 1인자는 못 된다. 둘째는 몸매도 제법이고 목소리도 괜찮은데, 자기 재능을 전혀 다룰 줄을 몰라... 셋째는 나쁘진 않은데, 이 배우 셋 중에 제일 골치 아픈 년이야...'
$Angry_goblins_quest[9] = '[고블린]<br>&nbsp;당돌하고 반항적이고, 틈만 나면 도망치려 들거든... 그러니 이 셋으론 절대 주연감이 안 된다. 그리고 다른 후보도 없어... 그런데 네가 프로젝트의 프리마 역할에 맞는 여자애를 길러 낼 수 있다면, 윈터스 테일 경영진을 만날 가능성은 훨씬 높아질 거다. 자, 이 임무를 맡을 준비는 됐나?'
$Angry_goblins_quest[10] = '[고블린]<br>&nbsp;그럼 똑똑히 들어라!... 무엇보다 <font color="#008080"><b>그 여자애</b></font>는 <font color="#008080"><b>미인</b></font>이어야 한다. 이건 굳이 설명 안 해도 알겠지. 그럼 넘어가자... 너도 알다시피 우리에게 필요한 건 배우다. 그러니 큰 무대 앞에서도 당당하고, 풀려 있고, 자기 자리를 지킬 만큼 충분히 <font color="#0000CD"><b>기질이 살아 있어야</b></font> 한다. 그리고 매진은 보장이라고 난 확신하고 있고...'
$Angry_goblins_quest[11] = '[고블린]<br>&nbsp;영리함... 바로 여기서 이야기가 재밌어지지... 한편으론 똑똑한 배우라야 말도 잘하고, 그건 중요하다. 하지만 다른 한편으로는 좀 멍청한 편이 오히려 대중에게 더 잘 먹혀. 멍청하고 예쁜 인형이라는 이미지가 묘하게 사람들 취향에 맞거든. 그리고 그건 프로젝트 홍보에도 좋지... 적당히 중간쯤에서 타협하면 될 것 같다...'
! JO9 MOD END J9M2505

! JO9 MOD START J9M2504 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Angry_goblins_quest[12] = '[고블린]<br>&nbsp;<font color="#0000CD"><b>한 번 들으면 바로 알아먹고</b></font>, 지시도 엄격하게 따를 만큼은 똑똑해야 한다. 물론 무대나 팬들과의 접촉 중에 용서 못 할 큰 실수만큼은 해선 안 되지. 저 계집 같으면 꼭 그런 사고를 칠 테니까. 그리고 이제 제일 중요한 건 예능 재능이다...'
$Angry_goblins_quest[13] = '[고블린]<br>&nbsp;"그 여자애는 상당히 다면적인 역할을 맡게 된다. 그러니 <font color="#008080"><b>노래를 잘해야 할</b></font> 뿐 아니라 <font color="#008080"><b>우아하게 움직일 줄</b></font>도 알아야 하고, 동시에 <font color="#008080"><b>일류 첩</b></font>이어야 한다. 우리 쇼에는 관객과의 상호작용이 들어가거든. 그러니 누구든 무대 위에서 그녀와 섹스할 수 있다는 사실에도 대비돼 있어야 해." 그녀는 단순히 <font color="#008080"><b>움직이는 건 뭐든 잘 받아낼 줄</b></font> 아는 걸 넘어서, 그것도 효과적으로 해내야'
$Angry_goblins_quest[14] = '[고블린]<br>&nbsp;<font color="#008080"><b>자기 자신을 아름답게 보여 주는 능력</b></font>은 그녀 피에 새겨져 있어야 한다. 그건 단순한 기술이 아니라, 그녀의 삶의 방식이 되어야 해. 그녀는 언제 어디서나 자기 자신을 팔 줄 알아야 하지. 그러니 절대적으로 <font color="#008080"><b>어떤 역할이든 연기할 수 있어야</b></font> 한다. 또한 성교의 전 과정을 <font color="#0000CD"><b>섬세하게 느끼고</b></font>, 그 감각을 목소리로 전달할 줄 알아야 하는 것도 똑같이 중요하다...'
$Angry_goblins_quest[15] = '[고블린]<br>&nbsp;아까도 말했듯, 우리 배우들의 입은 단지 좆이 들어가는 구멍일 뿐만 아니라 하나의 악기이기도 하다. 그러니 완벽하게 조율돼 있어야 한다. 그리고 몇 가지 중요한 점이 더 있다. 우리는 완전히 다 자란 여자가 필요하다. 그 이유는 많지만, 굳이 길게 설명하진 않지.'
$Angry_goblins_quest[16] = '[고블린]<br>&nbsp;또한 그녀가 <font color="#008080"><b>모든 스트레스를 씩씩하게 견디고</b></font>, 오랫동안 일할 능력을 유지하도록 만들어라. 그리고 절대로 임신하게 해선 안 된다. 우린 밤낮없이 굴릴 일꾼을 데려가는 거다. 작업 중단 따위는 절대 용납 못 해... 이게 전부다. 자, 이제 네가 진짜로 얼마나 하는 놈인지 보자고....'
$Angry_goblins_otkaz[1] = "[고블린]<br>&nbsp;<<$master_name>>, 네가 우리를 위해 길러 준 그 여자애는 자기 역할을 정말 훌륭하게 해내고 있다! 그래서 우리도 이제 그녀 짝으로 또 다른 배우를 하나 주문할까 생각 중이다. 하지만 그건 나중 얘기고... 지금 당장은 더 필요 없다..."
$Angry_goblins_win[1] = '[고블린]<br>&nbsp;좋아... 어디 한 번 보자?!... 음!... 자, 이제 돌아서!... 훌륭하군!... 이제 무릎 꿇고 내 쪽으로 기어와라!...<br>[<<$slave_name>>]<br>&nbsp;(<b><i>명령을 수행하며</i></b>) 다음 명령을 기다리고 있습니다, 주인님!<br>[고블린]<br>&nbsp;이제 네가 뭘 해야 하는지 알고 있나, <<$slave_name>>?'
$Angry_goblins_win[2] = '[<<$slave_name>>]<br>&nbsp;제가 옷을 벗고, 당신께 펠라를 해 드리면 되는 건가요?!...<br>[고블린]<br>&nbsp;아니다. 지금부터 넌 이 봉투를 네 조련사한테 가져간다! 그 안에는 네가 주연으로 서게 될 우리 쇼 초연 초대장이 들어 있거든, <<$slave_name>>!'
$Angry_goblins_win[3] = '[고블린]<br>&nbsp;...<<$master_name>>, 우린 만족스럽다. 이 결과물은 주인님께 보여 드릴 거고, 아마 널 만나 보자는 쪽으로 얘기가 될 거다. 그럼 또 보자, <<$master_name>>!... ...<<$slave_name>>, 첫 리허설 준비를 완전히 끝낼 시간은 정확히 1분이다! 시간 재기 시작한다!...'
$Angry_goblins_fail[1] = '[고블린]<br>&nbsp;아니, 안 되지!!! 이 여자애한테 뭔가 있긴 해. 그건 맞다. 하지만 쓸모 있으려면 아직도 배워야 할 게 너무 많아!'
$doagirls_branded[1] = '소녀들을 해방시키면서, 당신은 그녀들에게 낙인을 찍고 함께 데려간다.'
! JO9 MOD END J9M2504
$doagirls_met[1] = '당신은 홍등가에 있었고, 골목 너머에서 들려오는 나른한 여자들의 신음 따위엔 조금도 신경 쓰지 않았을 것이다. 하지만 갑자기 들려온, 분명 한 소녀의 절박한 구조 요청 비명은 당신의 흥미를 확실히 끌었다...'
$doagirls_met[2] = '비명이 난 쪽으로 몸을 돌린 순간, 당신은 눈앞의 광경에 충격을 받았다. 한 무리의 변태적인 십대들이 장면 한가운데 쇠사슬에 묶인 두 소녀를 말 그대로 괴롭히고 있었다. 그 무력한 모습은 당신에게 깊은 인상을 남겼고, 당신은 그녀들을 도와주기로 결심했다...'
$doagirls_met[3] = '십대들의 행동을 보아하니, 그들은 진짜로 심각한 위협이 되기보다는 서로에게 허세를 부리고 있는 쪽에 가까웠다. 그래서 당신은 단호하게 자신의 존재를 드러냈다... 당신을 알아차린 어린 펑크들은 겁을 먹고 비겁하게 달아났고, 굴욕당한 미녀들만 남겨 둔 채 도망쳤다...'
$doagirls_met[4] = '어두운 불빛 속에서도, 당신은 눈앞의 소녀들이 꽤 아름답다는 것을 알아차렸다.
정액으로 흠뻑 뒤덮인 그녀들의 몸을 훑어보다가, 노예 낙인이 없다는 사실도 발견했다...'
! JO9 MOD START J9M2503 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$doagirls_met[5] = '한 가지 생각이 저절로 떠올랐다... 게다가 이 기회를 이용하지 않는 건 어리석은 짓이기도 했다... 당신이 행동 방침을 생각하는 동안, 불행한 친구보다 훨씬 더 어린 쪽의 소녀가 정신을 차렸다...<br>[소녀]<br>&nbsp;고마워요!... 당신이 아니었으면, 저 끝도 없이 밝히는 개새끼들이 우릴 박아 죽였을 거예요.’ ’안 봐도 뻔한 일이었죠...'
$doagirls_met[6] = '[당신]<br>&nbsp;어이, 그만!... 여기 머무르면 어떻게 끝날지 짐작은 했어야지... 대체 어떻게 이런 꼴이 된 거야?<br>[소녀]<br>&nbsp;우린 노예예요. 주인이 죽고 나서, 우릴 늘 미워하던 그 딸들의 재산이 됐죠. 그리고 그 여자들이 우릴 완전히 치워 버리기로 했어요... 그렇게 여기까지 오게 된 거예요...'
$doagirls_met[7] = '[당신]<br>&nbsp;잠깐! 노예라면 낙인은 어디 갔지? 분명 뭔가 이상한데...<br>[소녀]<br>&nbsp;주인님은 낙인으로 우리 몸을 망치고 싶어 하지 않으셨어요... 흉하다고 생각하셨거든요. 대신 목걸이에 달린 표식에 자기 낙인을 새겨 두셨어요. 그런데 그 딸들이 그걸 우리한테서 빼앗아 갔죠. 그러니 우린, 말하자면, 주인 없는 상태예요...'
$doagirls_met[8] = ' 그래서, 우릴 데려가실 건가요? 원래 그럴 생각이셨잖아요, 안 그래요? 그럼 이렇게 딱히 쓸모도 없는 대화를 오래 끌 이유가 뭐죠? 우린 대부분의 노예들처럼 까다롭지 않으니까, 이제 마음을 정하세요! - 다른 한 소녀가 정신을 차린 뒤 대화에 끼어들었다.'
! JO9 MOD END J9M2503
$realtor_demo_centralkvartal[1] = '  [글로리아]
- 중앙 지구는 로마의 진짜 중심지예요. 이곳엔 모범적인 질서가 흐르고 있죠. 범죄는 사실상 존재하지 않아요. 그리고 당연히, 도시 최고의 집들도 전부 중앙 지구에 있어요. 여기보다 더 좋은 아파트는 찾을 수 없을 거예요.'
$realtor_demo_centralkvartal[2] = '  [글로리아]
- 물론 이곳의 거주 비용은 상당하지만, 모든 것이 가까이 있고 이웃도 품위 있는 사람들뿐이라는 확신을 가질 수 있어요. 확장된 구조 덕분에 보통보다 훨씬 많은 가구와 장비를 둘 수 있다는 점도 장점이죠.'
$realtor_demo_centralkvartal[3] = '  [글로리아]
- 모든 공간은 이미 수리가 끝났고, 저희 최고의 디자이너들이 취향 좋게 꾸며 두었어요. 스타일은 엄격하면서도 고급스럽죠. 물론 바꾸거나 추가하고 싶은 게 있다면, 그 작업도 저희가 기꺼이 맡아 드릴게요.'
$realtor_demo_centralkvartal[4] = '  [글로리아]
- 먼저 거실부터 보시죠. 벽은 백단 패널로 마감했고, 마루는 자단으로 깔았어요. 가구는 진짜 가죽으로 마감했고요. 아주 세련되고 편안하답니다.'
$realtor_demo_centralkvartal[5] = '  당신은 방을 유심히 둘러본다. 그래, 정말 여기서 살고 싶어진다. 물론 이것도 더 호화롭게 꾸밀 수는 있겠지만, 그쯤 되면 그냥 궁전일 뿐이다.'
$realtor_demo_centralkvartal[6] = '  [글로리아]
- 다음은 침실이에요. 호화롭게 조각된 킹사이즈 침대는 외형만 화려한 게 아니라 내구성도 뛰어나죠. 어떤 취향과 실험도 거뜬히 버텨 낼 거예요.'
$realtor_demo_centralkvartal[7] = '  침대는 정말 좋다. 다른 가구들도 인상적이다.’ 여기라면 푹 자는 것도, 노예들과 활동을 벌이는 것도 아무 문제 없겠다.'
$realtor_demo_centralkvartal[8] = '  [글로리아]
- 그리고 여기가 욕실이에요. 천연 석재 타일로 마감했고, 위생 설비도 훌륭하고, 거울도 큼직하죠. 거실에서 들여다볼 수 있는 넓은 관찰창도 벽에 나 있어요 - 당신의 노예를 언제나 시야 안에 둘 수 있죠.'
$realtor_demo_centralkvartal[9] = '  벽 전체를 가로지르는 창문이라고? 꽤 기발한데, 정말. 하지만 이건 내 일에 아주 유용하겠다. 위생 설비도 흠잡을 데가 없다.'
$realtor_demo_centralkvartal[10] = '  [글로리아]
- 주방으로 오시죠. 최신 가전으로 꾸며진 널찍한 공간이에요. 최고의 요리를 만드는 데 필요한 것이 전부 갖춰져 있어요. 음식용 정지 보관실도 용량이 더 커졌죠.'
$realtor_demo_centralkvartal[11] = '  당신은 주방을 꼼꼼히 둘러본다. 딱 좋다. 무엇보다도 놀랄 만큼 넓다. 훌륭해, 아주 훌륭해.'
$realtor_demo_centralkvartal[12] = '  [글로리아]
- 추가 요금을 내시면 같은 건물 안의 부속 공간도 임대하실 수 있어요. 필요한 건 거의 다 합리적인 조건으로 빌릴 수 있죠: 고문실, 연금술 실험실, 이미 완성된 호화 개인실까지 준비돼 있어요.'
$realtor_demo_centralkvartal[13] = '  [글로리아]
- 보세요. 어떤 노예에게도 훌륭한 방이에요. 캐노피와 붉은 침대보가 달린 이 넓은 침대는 진정한 사랑의 침대죠. 문은 바깥쪽에서 확실하게 잠글 수 있고요.'
$realtor_demo_centralkvartal[14] = '  [글로리아]
- 노예상인 길드의 일원으로서, 이곳 지하실에도 분명 흥미를 느끼실 거예요. 이 방은 가장 큰 고문 기구조차 들여놓을 수 있을 만큼 넓어요. 내부에는 튼튼한 철창과 갈고리, 브래킷까지 갖춰져 있죠. 훌륭한 작업장입니다.'
$realtor_demo_centralkvartal[15] = '  [글로리아]
- 마법과 부여술에 능하시다면, 이곳 연금술 실험실도 추가로 임대하실 수 있어요. 책장을 충분히 둘 수 있고, 폭발이나 화재에도 견디도록 벽을 보강한 아주 아늑하고 아름다운 방이죠.'
$realtor_demo_centralkvartal[16] = '  [글로리아]
- 공과금을 제외한 주요 공간의 임대료는 10일 기준 <<estate_cost_main["centralkvartal_house"]>> 스파크예요. 원하시면 오늘 바로 입주하실 수 있고, 선불로 10일치 임대료와 중개 수수료 100스파크만 내시면 됩니다.'
$realtor_demo_RedLight[1] = '  [글로리아]
- 이 구역은 꽤 특수해요. 거의 하루 종일 퇴폐와 방탕이 지배하죠. 하지만 그와 동시에, 이곳의 주거지는 도시에서도 손꼽히게 인기 있어요. 제 생각엔 이 구역의 편리한 위치가 가장 큰 이유인 것 같네요.'
$realtor_demo_RedLight[2] = '  [글로리아]
- 임대료는 꽤 비싸지만, 생각해 보면 이해할 만해요. 이 구역의 범죄율은 도시의 엘리트 구역들 못지않고, 아파트 크기도 그에 못지않으니까요. 그리고 떠도는 소문은 전부 동화 같은 얘기일 뿐이에요.'
$realtor_demo_RedLight[3] = '  [글로리아]
- 고딕 스타일로 꾸며진 이 지역 아파트들은 이미 입주 준비가 전부 끝나 있어요. 다시 한 번 강조하지만, 공간은 정말 넓고 모든 구조물도 아주 튼튼해요. 하지만 직접 보시면 더 잘 아시겠죠.'
$realtor_demo_RedLight[4] = '  [글로리아]
- 먼저 거실부터 보시죠. 천장이 높은 홀입니다. 내부는 붉은색과 검은색 위주로 꾸며져 있고요. 모든 가구가 사치스럽고 우아하며, 마감 수준도 최고예요.'
$realtor_demo_RedLight[5] = '  당신은 방을 유심히 둘러본다. 물론 조금 음침하긴 하다. 하지만 젠장, 아름답다. 진짜 아주 아름답다. 이런 걸 "네크로 고딕" 스타일이라고 부르는 건가?'
$realtor_demo_RedLight[6] = '  [글로리아]
- 다음은 침실이에요. 낮지만 넓고, 부드러운 헤드보드가 달린 침대는 어떤 성적 유희에도 완벽하죠.’ 관 속에서 잠자는 생물들이 꾸몄다는 점은 신경 쓰지 마세요 - 침대 자체는 정말 훌륭하니까요.'
$realtor_demo_RedLight[7] = '침대는 정말 좋다. 다른 가구들도 인상적이다. 여기라면 푹 자는 것도, 노예들과 활동을 벌이는 것도 아무 문제 없겠다.'
$realtor_demo_RedLight[8] = '[글로리아]
- 그리고 여기가 욕실이에요. 바닥은 짙게 광을 낸 대리석으로 되어 있죠. 아래층 이웃 머리 위로 물이 새는 일은 걱정하지 않으셔도 돼요.'
$realtor_demo_RedLight[9] = '당신은 욕실을 흥미롭게 둘러본다. 약간 구식이긴 하지만 동시에 아주 세련됐다. 마음에 든다.'
$realtor_demo_RedLight[10] = '[글로리아]
- 주방으로 오시죠. 겉보기엔 아늑한 구식 주방이지만, 외관이 낡아 보여도 속지 마세요 - 요리에 필요한 건 다 갖춰져 있거든요. 특히 대용량 정지 보관실이 눈에 띄죠.'
$realtor_demo_RedLight[11] = '당신은 주방을 꼼꼼히 둘러본다. 아주 딱 좋다. 무엇보다도 놀랄 만큼 넓다. 훌륭해, 아주 훌륭해.'
$realtor_demo_RedLight[12] = '[글로리아]
- 추가 요금을 내시면 같은 건물 안의 부속 공간도 임대하실 수 있어요. 필요한 건 거의 다 합리적인 조건으로 빌릴 수 있죠: 고문실, 연금술 실험실, 완성된 호화 개인실까지 준비돼 있어요.'
$realtor_demo_RedLight[13] = '[글로리아]
- 보세요. 이런 개인실라면 교황에게 바칠 노예를 준비하는 데조차 부끄럽지 않죠. 어떤 훈련생이든 이 공간의 장엄함에 압도되어, 당신이 자신을 위해 기울이는 정성을 실감하게 될 거예요.'
$realtor_demo_RedLight[14] = '  [글로리아]
- 노예상인 길드의 일원으로서, 이곳 지하실에도 분명 흥미를 느끼실 거예요. 돌벽으로 둘러싸인 음침한 방에, 단단히 잠기는 감방까지 있죠. 당신 희생자들의 비명은 누구도 듣지 못할 거예요.'
$realtor_demo_RedLight[15] = '  [글로리아]
- 마법과 부여술의 재능이 있으시다면, 이곳 연금술 실험실도 추가로 임대하실 수 있어요. 리치들은 마법을 제법 알거든요. 그리고 이 실험실은 바로 리치, 그것도 오래되고 강력한 리치가 꾸며 놓은 곳이에요.'
$realtor_demo_RedLight[16] = '  [글로리아]
- 공과금을 제외한 주요 공간의 임대료는 10일 기준 <<estate_cost_main["Redlight_house"]>> 스파크예요. 원하시면 오늘 바로 입주하실 수 있고, 10일치 임대료와 중개 수수료 100스파크만 선불로 내시면 됩니다.'
$realtor_demo_otchuzhdenie[1] = '  [글로리아]
- 배제 구역은... 솔직히 말해 저라도 혼자 산책하러 나갈 엄두는 안 나는 곳이에요... 주거 수준은 대체로... 흠흠... 기본적이라고 보시면 되고요. 게다가 범죄율도 슬럼가보다 겨우 조금 나은 수준이에요.'
$realtor_demo_otchuzhdenie[2] = '  [글로리아]
- 그래도 이곳에 집을 빌릴 이유는 몇 가지 있어요. 첫째이자 가장 중요한 건, 이보다 더 싼 곳을 찾기 어렵다는 점이죠. 임대료는 정말 저렴해요. 둘째로, 뱀 구역과는 달리 이곳 집들은 꽤 널찍하답니다.'
$realtor_demo_otchuzhdenie[3] = '  [글로리아]
- 저희 회사 정책상 배제 구역 방들은 사전 가구 배치를 하지 않기 때문에, 실내 디자인은 다소... 음... 변변찮을 수 있어요. 하지만 원하시면 전부 취향대로 바꿔서 아주 아늑하게 꾸며 드릴 수 있답니다.'
$realtor_demo_otchuzhdenie[4] = '  [글로리아]
- 여기 보이는 건 미니멀한 스타일로 꾸며진 자그마하지만 널찍한 홀이에요. 가구는 즉석 재료로 조립된 것이지만, 수인들이 쓰도록 만들어져서 아주 튼튼하답니다.'
$realtor_demo_otchuzhdenie[5] = ' 당신은 방을 유심히 살핀다. 네 눈엔 그냥 돼지우리다. 아주 눈높이가 낮은 사람이나 여기서 살 수 있겠다.'
$realtor_demo_otchuzhdenie[6] = '  [글로리아]
- 다음은 침실이에요. 최소한의 튼튼한 가구만 갖춘 침실이죠. 훌륭한 저가형 선택지예요. 침대는 아주 튼튼하고, 카노안 참나무 원목으로 만들어졌답니다.'
$realtor_demo_otchuzhdenie[7] = ' 이 쓰레기장치곤 나쁘지 않다 - 네가 예상한 것보단 낫다. 침구만 갈면 잠은 제대로 잘 수 있겠다.’ 다만 인테리어는 좀 우울하다.'
$realtor_demo_otchuzhdenie[8] = '  [글로리아]
- 그리고 여기가 욕실이에요. 위생 설비는 좀 낡았지만, 배관 상태 자체는 완벽해요. 가끔 녹슨 물이 수도꼭지에서 나오긴 하지만, 하수구를 기어 올라온 카이만이 변기 구멍으로 덮쳐 오는 사례는 아직 한 번도 없었답니다.'
$realtor_demo_otchuzhdenie[9] = '  여기 냄새가 진동한다. 정말 여기서 씻을 수는 있는 건가? 그리고 변기 속 카이만이라니... 저 여자가 진담인 건가, 농담인 건가? 중요 부위를 통째로 물어뜯어 갈 수도 있잖아. 아니면 자기 알을 낳을 수도 있고...'
$realtor_demo_otchuzhdenie[10] = '  [글로리아]
- 주방으로 오시죠. 보시다시피 공간이 아주 넓고, 요리에 필요한 건 전부 갖춰져 있어요. 음식용 정지 보관실도 완전 정상 작동하고요. 어떤 집에도 충분히 어울리는 괜찮은 선택지예요.'
$realtor_demo_otchuzhdenie[11] = '  그리고 주방은 정말 나쁘지 않다. 가구는 낡았고 여기저기 금도 갔지만, 방 크기만큼은 정말 인상적이다. 게다가 어딘가 묘하게 익숙한 느낌도 든다... 이 주방을 전에 어딘가에서 본 적 있는 것 같다. 흠...'
$realtor_demo_otchuzhdenie[12] = '  [글로리아]
- 추가 요금을 내시면 같은 건물 안의 부속 공간도 임대하실 수 있어요. 필요한 건 거의 다 합리적인 조건으로 빌릴 수 있죠: 고문실, 연금술 실험실, 아늑한 개인실까지 준비돼 있어요.'
$realtor_demo_otchuzhdenie[13] = '  [글로리아]
- 보세요. 소박한 노예 소녀에게 딱 맞는 훌륭한 방이에요. 가구는 최소한만 있어서 쓸데없이 정신 팔릴 일도 없죠. 필요한 건 다 갖춰져 있고, 공간이 넉넉해서 더 들여놓고 싶은 가구를 추가하기도 쉬워요.' 
$realtor_demo_otchuzhdenie[14] = '  [글로리아]
- 노예상인 길드의 일원으로서, 이곳 지하실에도 분명 흥미를 느끼실 거예요. 고문이나 감금용으로 아주 믿음직한 장소죠. 벽은 조금 갈라졌고 천장에선 자주 물이 새지만, 이 방의 용도를 생각하면...'
$realtor_demo_otchuzhdenie[15] = '  [글로리아]
- 마법과 부여술에 능하시다면, 이곳의 연금술 실험실도 추가로 임대하실 수 있어요. 장비는 꽤 낡았지만 완벽하게 작동한답니다. 당장이라도 물약을 만들고 주문을 시전할 수 있죠.'
$realtor_demo_otchuzhdenie[16] = '  [글로리아]
- 공과금을 제외한 주요 공간의 임대료는 10일 기준 <<estate_cost_main["otchuzhdenie_house"]>> 스파크뿐이에요. 오늘 바로 입주하고 싶으시다면 10일치 임대료만 선불로 내시면 됩니다. 가구 보증금도 필요 없고요.'

! JO9 MOD START J9M2502 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Biker_quest[1] = '[바이커]<br>&nbsp;야, 너!... 그래, 너 말이야! 이리 와! 네가 주문만 하면 온갖 여자들을 만들어 준다던데, 맞지?! 좋군... 왜냐면 네 도움이 필요하거든... 어쩌다 보니 내가 이 빌어먹을 구멍에 떨어지게 됐어. 어떻게 이렇게 됐는지는 나도 몰라. 안개만 기억나고 그 뒤는 끝이야... 정신 차려 보니 여기였고... 전속력으로 달리다가 하마터면 외양간에 처박힐 뻔했다...'
$Biker_quest[2] = '[바이커]<br>&nbsp;난 원래 SF니 그런 창작물이니 하는 건 별로 안 좋아해. 하지만 이런 일을 직접 겪고 나면, 시간머신이 존재한다는 것도 믿게 되더라... 그런데 한 가지 이해가 안 가는 게 있어... 대체 이런 구멍에서 너희는 어떻게 사는 거냐? 인터넷도 없고 전화도 없고... 오토바이조차 본 적이 없잖아...' 
$Biker_quest[3] = '[바이커]<br>&nbsp;휘발유나 기계 오일 같은 얘기도 전혀 못 알아듣더군. 말도 안 되지!... 여기서 주유소를 찾다가 기름을 전부 써 버렸어. 이제 내 바이크에 넣을 연료도 없다고... 그런데... 다행히도, 너희 스네이크 구역에서 영리한 꼬맹이 하나를 찾았다. 걔가 휘발유 없이도 내 바이크를 움직일 방법을 알려 줬지...'
$Biker_quest[4] = '[바이커]<br>&nbsp;걔 말로는, 필요한 건 아주 튼튼하고 강인한 평범한 여자 하나뿐이래... 약간의 기술 개조만 하면, 그녀의 장이 훌륭한 연료 탱크가 될 수 있다는 거야... 물론 난 처음엔 그런 개소리를 안 믿었지. 그런데 겉모습만 여자고 속은 전부 금속인 어떤 여자를 직접 보여 주더군!'
$Biker_quest[5] = '[바이커]<br>&nbsp;그런데 그 여자가 또 움직임도 날렵하고 머리도 제대로 돌아가더라고. 걔 말로는 자기 개발품이래. 구역 방어용 만능 병기 같은 거라고... 그런 걸 직접 보면 무슨 소리든 믿게 돼... 게다가 어떻게 뭘 해야 하는지도 도식으로 그려 줬어. 적당한 여자만 찾으면 된다고 하더군... 그리고 일이 확실하게 되게 하려고, 난'
$Biker_quest[6] = '[바이커]<br>&nbsp;그놈 조수 하나까지 같이 데려오기로 흥정했지. 걔 말로는 이 여자가 의학과 연금술 전문가라더군. 전부 제대로 해낼 수 있을 거라고... 그런데 난 벌써부터 저 년의 기계 감각이 의심스러워. 렌치랑 드라이버 차이 설명하는 데만 반나절을 썼거든! 그런데도 벌써 2주째 바이크를 그 교수식 설계대로 손보질 못하고 있어.'
! JO9 MOD END J9M2502
$Biker_quest[7] = '   [바이커]
  - 한마디로 저 년은 그냥 손이 엉덩이에 달린 멍청이 같아... 내 세상에선 저런 애들은 바에서 스트립쇼나 추지... 그래도 뭔가는 할 수 있길 아직은 기대하고 있어... 괜히 그놈이 그렇게 칭찬한 건 아닐 테니까... 됐다, 그건 됐고... 내 주문 얘기로 돌아가자... 말했듯 내겐 여자 하나가 필요해. 어린애 말고. 그 여자는 <b><i>나이가 좀 있어야 해</i></b>, '
! JO9 MOD START J9M2501 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Biker_quest[8] = '[바이커]<br>&nbsp;그래야 연료 탱크도 더 크게 만들 수 있으니까. 그놈은 <font color="#008080"><b>신체적으로 강하고</b></font>, 붙임성 좋은 여자를 찾으라고 했어. 또 어느 정도 <font color="#008080"><b>유연해야</b></font> 한대. 그러니까 춤이랑 피트니스 좀 가르쳐 놔... 그리고 그래... 걔는 오토바이 조종의 일부가 되는 거니까, 주행 중 방해만 안 하는 게 아니라 조작을 더 쉽게 해 줘야 해. 그러니 <font color="#008080"><b>마장마술</b></font>도 익히게 하고, <b><i>경마에서도 몇 번은 우승하게</i></b> 만들어...'
$Biker_quest[9] = '[바이커]<br>&nbsp;그래, 필요한 건 대충 그게 다야... 돈 얘긴 나중에 하자. 먼저 여자부터, 그다음 네 스파크지...'
$Biker_win[1] = '[바이커]<br>&nbsp;딱 이거야! 정말 잘했어, <<$master_name>>! 이렇게 하자... 이 멍청한 년이 오토바이를 조립하고 여자를 거기에 연결하는 걸 끝내는 즉시 내가 시험해 보지. 제대로 작동하면 네 스파크를 주겠다. 그러니 며칠 뒤 다시 와라...'
$Biker_fail[1] = '[바이커]<br>&nbsp;네 옆의 이건 무슨 싸구려 중국 짝퉁이냐? 오토바이 일부가 되기도 전에 부품용으로 흩어져 버리겠군! 가서 좀 더 멀쩡한 걸 해 와!...'
! JO9 MOD END J9M2501

! JO9 MOD START J9M2500 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Biker2_quest[1] = '[바이커]<br>&nbsp;있잖아, <<$master_name>>, 그 교수 놈 아이디어는 실제로 먹힌다! 문제는 하나야... 내 오토바이 조립하던 그 멍청한 년이 알고 보니 건망증까지 있었다는 거지. 여자를 특별히 준비시켜야 한다는 걸 깜빡한 거야. 그 여자 장벽은 어떤 마물의 정액으로 듬뿍 윤활돼 있어야 한대. 그 먹이가 내구성을 올려 준다는 거지...'
$Biker2_quest[2] = '[바이커]<br>&nbsp;결국... 내가 내 애마를 시동 걸었고... 진짜로 굴러가긴 하더라! 그런데 내가 속도를 올리자마자 그 여자는 안에서부터 끓기 시작하더니 그대로 타 버렸어. 원한다면 뒤쪽 집 뒤에 널브러진 그 구워진 년을 구경해도 돼. 이제 개밥 말고는 쓸모가 없지... 이번엔 저 머리 굵은 년이 제대로 해 주길 바랄 뿐이다. 그래야 내 바이크가 굴러가니까...' 
$Biker2_quest[3] = '[바이커]<br>&nbsp;한마디로 기본 조건은 그대로 간다: <b><i>성숙한</i></b> 여자, <font color="#008080"><b>신체적으로 강하고</b></font>, <font color="#008080"><b>유연하고 탄력적이며</b></font>. <font color="#008080"><b>마장마술</b></font> 잘하고 <b><i>경주에서도 몇 번 우승한 경력</i></b>이 있어야 하는 것도 잊지 마. 하지만 동시에 그녀는 <b><i>오직 어떤 마물의 정액만 먹어야</i></b> 해.'
$Biker2_quest[4] = '[바이커]<br>&nbsp;그리고 하나 더... 그 여자는 계속 윤활이 필요하니까, <font color="#008000"><b>입으로도 잘 다룰 줄 알면</b></font> 좋겠어. 빨고 삼키는 걸 완벽하게 하게 만들어! 괜한 상상은 하지 말고. 이건 전부 업무상 필요한 거다! 이래 놓고 내가 변태라고 생각하진 않겠지!!!'
$Biker2_quest[5] = '[바이커]<br>&nbsp;그리고 너도 너무 손대지는 마라! 나도 남이 빨다 만 공갈젖꼭지 같은 건 별로거든... 걱정 마, 보상은 해 줄 테니까!... 하지만 너도 알잖아 - 먼저 물건, 그다음 돈이야...'
$Biker2_win[1] = '[바이커]<br>&nbsp;음, 이번엔 전부 제대로 된 것 같군! 여자는 두고 가! 내가 확인해 보고, 돈 얘긴 나중에 하자....'
$Biker2_fail[1] = '[바이커]<br>&nbsp;이게 진짜 내가 주문한 여자 맞아? 뭔가 영 아니네... 난 완전히 다른 걸 주문했다고...'
! JO9 MOD END J9M2500

! JO9 MOD START J9M2499 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Biker3_quest[1] = '[바이커]<br>&nbsp;뭐랄까, <<$master_name>>!... 그 여자한테 약간 길들이기 주행을 시켜 봤어... 그런데 결과가 여러모로 내 기대를 뛰어넘더라. 오토바이는 부드럽게 잘 나가고, 여자도 기계랑 하나의 단단한 장치처럼 보였어. 다만 좀 손봐야 할 부분들이 있다.'
$Biker3_quest[2] = '[바이커]<br>&nbsp;그런 눈으로 보지 마!... 내가 이전 건 보상해야 한다는 거 기억한다. 그리고 갚을 거야, 약속하지!... 후하게!... 하지만 나중에... 지금은 여자 하나가 더 필요해... 기본 조건은 지금 있는 이 여자와 동일하다... <b><i>성숙하고</i></b>, <font color="#008080"><b>강하고 유연하고, 마장마술도 잘하고</b></font>, <b><i>경주 우승도 몇 번은 해 본</i></b>, <font color="#008000"><b>빨아 주는 년</b></font>.' 
$Biker3_quest[3] = '[바이커]<br>&nbsp;그런데 연료 탱크가 진짜 너무 작더군... 이번엔 <b><i>살찐</i></b> 여자로 해 보자. 논리적으로 생각하면, 그러면 연료를 더 많이 넣을 수 있을 테니까. 그리고 어차피 내가 탈 거니까, 외형도 내 바이크의 압박감과 대담함에 어울렸으면 좋겠어...'
$Biker3_quest[4] = '[바이커]<br>&nbsp;오토바이를 모든 면에서 뜨겁고 <font color="#008000"><b>아주 끝내주게</b></font> 꾸며 줄 무언가였으면 한다는 거지. 내 말 무슨 뜻인지 알겠지?!... 그리고 하나 더 필요해... 달리는 동안 그 여자의 엉덩이가 계속 내 앞부분에 쓸려. 난 그걸 못 참겠더라고... 그러니 <font color="#008000"><b>그 조이는 구멍도 충분히 손봐 놔</b></font>.'
$Biker3_quest[5] = '[바이커]<br>&nbsp;또 장거리 주행 중엔 그 작업 포인트에 아이스크림이나 다른 시원한 걸 좀 넣을 수도 있겠지. 그리고 여기 체계가 어떤진 모르겠지만, 내 세상에선 공중화장실 찾는 게 진짜 문제야... 술집에서 한바탕 하고 나면 소변이 마려운데 갈 데가 없거든!'
$Biker3_quest[6] = '[바이커]<br>&nbsp;그럴 때 저년 엉덩이가 아주 유용할 수 있지. 게다가 오줌이 상처를 잘 아문다고도 하더라고. 그러니 약도 동시에 받는 셈이지... 장비는 조기 고장 나지 않게 잘 관리해야 하잖아! 맞지? 아, 그리고 <b><i>마물의 정액</i></b>을 먹어야 한다는 것도 잊지 마라'
$Biker3_quest[7] = '[바이커]<br>&nbsp;내 요구는 그게 전부다... 이제 가라! 네가 그 여자 작업하는 동안, 난 네게 어떻게 빚을 갚을지 생각해 보지....'
$Biker3_fail[1] = '[바이커]<br>&nbsp;이건 또 무슨 기적 같은 물건이냐? 내가 분명한 개조 조건을 말했는데, 당신은 누구를 데려온 거야?! 됐으니 가서 다시 손봐! 그동안 난 내가 이미 가진 여자를 근처에서 굴리고 있을 테니...'
$Biker_branded[1] = ' 당신은 이 결정을 내리기 쉽지 않았지만, 새로운 노예의 제안을 받아들였다. 그리고 잠시 뒤, 개조된 오토바이가 네 눈앞에 위풍당당하게 모습을 드러냈다.<br>[소녀]<br>&nbsp;저 태워 주실래요, <<$master_name>>?!...<br>[당신]<br>&nbsp;타! 간다!... '
$Biker_branded[2] = '  물론 당신은 형편없는 운전자다. 그래도 서툰 조종으로 연료 탱크가 한동안 완전히 퍼져 버리기 전까지, 도시를 몇 바퀴나 돌 수는 있었다. 그리고 평범한 시민들뿐 아니라 길드 동료들에게도 제대로 된 인상을 남기는 데 성공했다. '
$Biker_met[1] = '[당신]<br>&nbsp;안녕! 그런데 그... 운전자는 어디 있지?<br>[소녀]<br>&nbsp;아! 네, <<$master_name>>! 엄청 많은 걸 놓치셨어요!...'
$Biker_met[2] = '[소녀]<br>&nbsp;정말 끝내줬어요!!! 한마디로, 그는 더 못 기다리겠다며 가지고 있는 걸로 자기 시대에 돌아가기로 했어요. 속도도 잘 붙었고, 그 여자는 마치 절정 오는 것처럼 맛있게 비명을 질렀죠. 그런데 갑자기 바이크가 너무 아름답게 하늘로 날아올랐어요! 뭔가에 부딪히더니, 그는 안장에서 튕겨 나갔고요.'
$Biker_met[3] = '[소녀]<br>&nbsp;그리고 저기 보이는 벽에 떨어졌어요. 그 뒤로 반나절 동안 그의 찌꺼기를 긁어냈죠... 여자애도 안됐어요... 도로에 질질 끌려가다 완전히 흩어져 버렸거든요. 한마디로 둘 다 죽었어요. 남은 건 오토바이 하나와, 주인도 없고 아무에게도 쓸모없는 저뿐이죠...'
$Biker_met[4] = '[소녀]<br>&nbsp;솔직히 전 원래 주인한테 돌아가고 싶지 않아요. 그는 절 백 파운드짜리 다음 로봇 전사로 만들어 버릴 거예요. 그래도 전 노예일지라도 정상적인 삶을 살고 싶어요... 아무한테나 팔려 가는 것도 싫고요... 주변엔 변태들뿐이잖아요... 혹시 제가 <<$master_name>>께 쓸모가 될 수 있을까요?!'
$Biker_met[5] = '[소녀]<br>&nbsp;분명 저 쓸 데를 찾으실 수 있을 거예요! 그렇죠?!... 네, 그리고 전 뭔가 좀 할 줄 알기도 해요. 의학이랑 마법도 꽤 알고 있고요. 필요하면 주방일이랑 집안일도 어떻게든 익힐 수 있어요... 즐겁게 해 드리는 것도요?!... 네, 그 정도야 문제 없어요!'
$Biker_met[6] = '[소녀]<br>&nbsp;그리고요... 지금 이 기름투성이 몸뚱이를 어디 둘 데가 필요하시잖아요?!... 그러니 오토바이에 붙여 버려요! 그 여자를 그 용도로 훈련시켜 두셨잖아요... 물론 오래 버티진 못할 거예요. 그래도 한동안은 충분해요. 그리고 완성만 하면 시민들에게 명예와 존중을 받게 되실 거예요!'
$Tsyuansu_quest[1] = '[주안수]<br>&nbsp;아, 안녕하세요, <<$master_name>>. 친구들에게 당신 얘길 들었어요... 오늘 해부극장 공연은 보셨나요? 관심 없으셨다고요... 아쉽네요... 저는 제 가장 소중한 걸 빼앗아 간 어떤 살찐 돼지 하나에게, 그와 비슷한 걸 보여 주고 싶거든요....'
$Tsyuansu_quest[2] = '[주안수]<br>&nbsp;여기 어떤 늙은이가 젊은 여자애들을 곁에 두고 맛있는 걸 먹인 다음... 그런 식단이 수명을 늘려 준다고 믿으면서 그녀들의 똥을 먹고 있어요. 뭐요? 그게 당신과 무슨 상관이냐고요? 좀 참고 들으세요... 저는 그 늙은이를 위해 쇼 하나를 꾸밀 생각이고, 그 주인공은 그의 총애받는 애가 될 거예요.' 
! JO9 MOD END J9M2499
$Tsyuansu_quest[3] = '  <i>쥬안수는 옆방으로 들어갔다가 곧 돌아와 한 어린 소녀의 손을 잡고 나왔다. 동공이 확장되어 있고 반응이 느린 걸 보니, 아이에게 약을 먹인 모양이다.</i>'
! JO9 MOD START J9M2498 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Tsyuansu_quest[4] = '[주안수]<br>&nbsp;이 미녀를 손에 넣는 건 쉽지 않았어. 다행히 그 노인은 자리를 비웠고, 저택의 하인들 중 몇몇은 여전히 매수된 놈들이야. 아직 «무대»를 준비해야 하니까, 그래서 너에게 도움을 청한 거야. 그냥 네 눈앞에서 그녀를 죽이는 건 — 지루하잖아. 난 네가, <<$master_name>>, 이 귀여운 꽃을 진짜 괴물로 만들어주길 원해...'
! JO9 MOD END J9M2498
$Tsyuansu_quest[5] = '   [주안수]
  -  그녀를 날씬하고 똑똑한 소녀에서 <font color="#cd0000"><b>뚱뚱한</b></font> 새끼 돼지로 변신시켜, <b>주인을 보자마자 기쁨에 삐삐거릴 준비가 된</b> 모습으로 만들어라. 그녀의 순수한 몸을 <b>흉터와 문신으로</b> 뒤덮고, <font color="#008000"><b>가슴을 최대한 크게 만들고</b></font>, 가능한 모든 방법으로 섹스를 해라 — 그녀를 <font color="#008000"><b>진짜 창녀로 만들어 버려라</b></font>. 자, 이제 그 여자를 데려와서 일을 시작해라.. '
! JO9 MOD START J9M2497 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Tsyuansu_quest[6] = '[주안수]<br>&nbsp;하지만, 잠깐만... 그 돼지에게 목소리를 줘 봐. 뚱뚱한 돼지가 <b>천사의 목소리로 비명을 지르는 모습</b>, — 참 웃기잖아. 해 봐.'
$Tsyuansu_win[1] = '[주안수]<br>&nbsp;가져왔나요? 어디 보여 줘요... 오, 정말 일을 잘했네요! 얼마나 아름다운 돼지야!... <<$master_name>>, 당신은 제가 제시한 것보다 조금 더 받을 자격이 충분해요. 스파크에 더해 희귀한 물약 몇 개쯤 얹어 드릴까요??...'
$Tsyuansu_win[2] = '[주안수]<br>&nbsp;...아, 그리고 혹시 관객으로 있고 싶나요? 무대는 이미 준비됐고, 그 늙은이도 곧 제게 영광을 내려 주실 텐데... 아니면 공연 뒤에 저녁을 원하세요? 아, 바쁘시다고요? 아쉽네요...'
$Tsyuansu_fail[1] = '[주안수]<br>&nbsp;칫, 이게 뭐예요? 제가 말한 건 이런 게 아니었잖아요... 내가 왜 그런 예감을 했을까! 뭐, 적어도 그 늙은이에겐 총애받는 애가 하나만 있는 건 아니니까, 당신네 길드엔 당신보다 더 머리 좋은 사람들이 있다는 뜻이겠죠. 심지어 여자 조련사도 당신보다 더 잘해냈어요 — 남자 주제에. 꺼져요! 그리고 이 «것»도 도로 가져가요.'
$Hotorn_voice_quest[1] = '[호손의 목소리]<br>&nbsp;거기서 한 발짝도 더 오지 마라! 우리 주인님은 남자와 말하길 원치 않으신다. 내가 그분의 목소리가 되어 주지. 유능한 노예 조련사 하나가 있다는 소문은 들었다. 맡길 만하다고 하더군... 아니, 아니, 그 얘긴 나중이다... 먼저 네가 뭘 할 수 있는지부터 보고 싶다.'
$Hotorn_voice_quest[2] = '[호손의 목소리]<br>&nbsp;우리에겐 처녀가 필요해... <font color="#008080"><b>아름답고</b></font>, <b>젊은</b> 처녀자리, <b>육욕에 목마른</b>, 아무것도 아무도 만족시킬 수 없는 존재. 그런 하나를 찾아, 창녀가 알아야 할 모든 것을 가르쳐. 남자와 여자, 짐승들과 생물들 — 그녀는 기꺼이 <font color="#008000"><b>어떤 생물이든 섬겨야</b></font> 해. 그 밖의 것은 네 취향대로.' 
$Hotorn_voice_win[1] = '[호손의 목소리]<br>&nbsp;정말 아름다운 창녀로군! 그래, 언니들에게 줄 선물로 딱 좋겠어. 뭐? 스파크? 아하하하! 우리가 이 여자애에 대한 보상을 약속이라도 했나? 이 아이는 그저 네가 우리 주인님과 거래할 자격이 있다는 증명일 뿐이다. 곧 만나게 될 거다...'
$Hotorn_voice_fail[1] = '[호손의 목소리]<br>&nbsp;이게 무슨 흉물이냐... 그리고 당신은 이 여자애가 아름다운 젊은 창녀라고 생각하는 건가? 썩 꺼져라. 주인님은 너와 아무 상관도 맺고 싶어 하지 않으신다. 다른 조련사를 찾으실 거다. 잘 가라.'
$Hotorn_aliman_quest[1] = '[호손의 목소리]<br>&nbsp;들어라... 신사께서 너에게 자기 "딸" 하나를 맡기려 하신다. 아이는 다른 세계의 응석받이 공주다. 신사께서는 자기 "딸"들이 <font color="#008000"><b>강인한 전사</b></font>이자, 투기장에서 어떤 상대도 쓰러뜨릴 수 있고, 뱀처럼 <font color="#008080"><b>영리하고</b></font> 교활하며... 희귀한 나비처럼 <font color="#008000"><b>아름답기를</b></font> 바라신다. 이런 일을 맡을 수 있겠나, <<$master_name>>?'
$Hotorn_aliman_quest[2] = '[호손의 목소리]<br>&nbsp;아, 물론 이번엔 일을 망치지 않으면 보상도 있다. 네 남자다움은 그 여자애에게서 멀리 떼어 놔라. 네 임무는 아름다운 전사를 길러 내는 것이지, 창녀를 만드는 게 아니다. 그리고 물론 낙인은 없다. 그녀는 노예가 아니니까.' 
$Hotorn_aliman_win[1] = '[호손의 목소리]<br>&nbsp;오, 저 눈빛 좀 보라지!.. 그래, 이제야 이 아이를 당당히 주인님의 딸이라 부를 수 있겠군. 훌륭한 일을 했다, <<$master_name>>. 고맙다. 뭐? 또 보상 얘기냐...'
$Hotorn_aliman_win[2] = '[호손 알리만]<br>&nbsp;모든 것은 팔리고, 모든 것은 사들여진다, <<$master_name>>. 네 보상은 네 목숨이다. 높이 올라갈수록, 악의를 품은 자들과 시기하는 자들, 원수도 늘어나는 법이지. 성공한 노예 조련사 하나의 목에는 꽤 괜찮은 값이 붙어 있다... 당신은 나를 기쁘게 했다. 그 대가로 나는 네가 치명적인 "문제"를 피하게 해 주지. 어떤가?..'
$Hotorn_aliman_win[3] = '[호손 알리만]<br>&nbsp;흠? 내가 너를 속이는 것 같으냐? 네 목숨을 걸어 볼 텐가?.. 네 눈을 보니 답을 알겠다. 손님을 내보내라.'
! JO9 MOD END J9M2497
$Hotorn_aliman_fail1[1] = '  <i>남자다운 소녀들이 너를 방으로 끌고 갔고, 거기에는 의자에 앉아 있는 호손 알리만이 있었다. 바닥과 벽은 피로 튀어 있었고, 그의 발치에는 돼지처럼 내장이 꺼내진 소녀 하나가 누워 있었다..</i>'
! JO9 MOD START J9M2496 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$Hotorn_aliman_fail1[2] = '[호손 알리만]<br>&nbsp;나는 내 "딸"을 너에게 훈련시키라고 맡겼다. 내가 그녀의 운명에 관심이 없다고 생각했느냐? 안타깝게도, 네가 실수했군. 이런 역겨운 결과물을 받아들인다고? 차라리 썩은 고기는 치워 버리는 편이 낫지... 그리고 내가 말하는 건 그 여자애만이 아니다. 모든 것은 팔리고, 모든 것은 사들여진다, <<$master_name>>. 높이 올라갈수록, 악의를 품은 자들과 시기하는 자들, 원수도 늘어나는 법이지. 그래도, 시도는 했다...'
