! JO9 MOD START TBV_BEAUTY_FORMULA_assistant | 2026-10-17_trait_value
		*p '<<$красота[assistant["beauty"]]>> = <<$природная_красота[assistant["base_beauty"]]>> + <<$пластика[assistant["beauty_enhanced"]]>><<iif(assistant[''jo9_peerless''] = 1, '' + 절세미인'', '''')>> - (<<$шрамы[assistant["scars"]]>> + <<$синяки[assistant["bruises"]]>> + <<$beauty_physique[assistant["fat"]]>>)'
! JO9 MOD END TBV_BEAUTY_FORMULA_assistant
		*nl '<<$стиль[assistant["style"]]>> = <<$wear_st[assistant["st_count"]]>> + <<$slave_makeup[assistant["makeup"]]>> + <<$hair_style[assistant["hairstyle"]]>> + <<$мейкап[assistant["makeup_count"]]>> + <<$грация[assistant["grace_count"]]>> - <<$гигиена[assistant["hygiene"]]>>'
		*nl '<<$экзотика[assistant["exotic"]]>> = <<$природная_экзотика[assistant["base_exotic"]]>> + <<$slave_tattoo[assistant["tattoo"]]>> + <<$пирсинг[assistant["piercing_count"]]>> + <<$wear_ex[assistant["ex_count"]]>>'
		if auspex = 1:
			*nl '<<$charm_aura[max(0, 5 + charm_from_aura)]>> = <<$charm_moral[assistant["moral"]]>> - (<<$charm_angst[assistant["angst"]]>> + <<$charm_spoil[assistant["spoil"]]>>)'
			*nl '<a href = "EXEC: msg $charm_help"><<$charm_stat>>&nbsp;<img src="content/pic/chart.png"></a> = <<$brand[brand_reputation]>> + <<$girl_fame[assistant["fame"]]>> + <<$стиль[assistant["style"]]>> + <<$экзотика[assistant["exotic"]]>> <<iif(charm_from_aura < 0, "-", "+")>> <<$charm_aura[max(0, 5 + charm_from_aura)]>> <<iif(assistant["fat"] ! 1, "-", "+")>> <<$charm_physique[assistant["fat"]]>> - <<$шрамы[assistant["scars"]]>> - <<$синяки[assistant["bruises"]]>>' &! $charm_stat is updated by $slave_price call earlier
		else
			*nl '<font color="black">조수의 오라와 매혹 등급을 보려면 아우스펙스를 시전해야 한다</font>&nbsp;<a href = "EXEC: msg $charm_help & gt $curloc"><img src="content/pic/chart.png"></a>'
		end
