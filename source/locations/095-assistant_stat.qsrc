# assistant_stat
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1582 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'assistant_stat': gs 'snk_room_bridge', 'guard', 'assistant_stat'
! JO9 MOD END J9M1582
!rewritten a piece of code with assistant infotext, now its all in one file, removed some from main_screen
gs '$newloc' &! ensure all stats are updated before displaying them

if assistant_state = CONST_INT['slave_faint']:
	$info_text = '<<$assistant_name>> (이)가 헐떡이며 쓰러졌다. 몸 상태가 좋지 않은 모양이다. 휴식을 취하게 하고 진단도 받아보자.'
elseif assistant_state = CONST_INT['slave_dead']:
	$info_text = '<<$assistant_name>> (이)가 죽어버렸다. 생명력이 바닥난 시신이 땅을 뒹굴고 있다.'
elseif $info_text = '':
	if assistant_stat_screen = 0:
! JO9 MOD START J9M1581 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
		$info_text = '[<<$assistant_name>>]<br>&nbsp;새 노예는 혼란을 틈타 탈출을 모색하거나 아무일도 하려하지 않으려 합니다만, 제가 지켜보겠습니다. 만약 특별히 관리를 지시하시면, 주의를 주며 가르치겠습니다. 이 여자들은 당신의 소유물이니 만큼, 망가지지 않게 조심히 다룰겁니다. 나의 주인님.</div>'
! JO9 MOD END J9M1581
		if slave_state > CONST_INT['no_slave']:
			gs '$slave_price'
			$spec_list = ''
			if slave_specialisation['concubine'] >= 3:   $spec_list += ', ' + dyneval($vb_cycle_skill, slave_specialisation['concubine'], '성노예')
			if slave_specialisation['pet'] >= 3:         $spec_list += ', ' + dyneval($vb_cycle_skill, slave_specialisation['pet'], '애완동물')
			if slave_specialisation['witchdoctor'] >= 3: $spec_list += ', ' + dyneval($vb_cycle_skill, slave_specialisation['witchdoctor'], '치유술사')
			if slave_specialisation['servant'] >= 3:     $spec_list += ', ' + dyneval($vb_cycle_skill, slave_specialisation['servant'], '시종')
			if slave_specialisation['gladiatrix'] >= 3:  $spec_list += ', ' + dyneval($vb_cycle_skill, slave_specialisation['gladiatrix'], '여검투사')
			if slave_specialisation['artist'] >= 3:      $spec_list += ', ' + dyneval($vb_cycle_skill, slave_specialisation['artist'], '예술가')
			if slave_specialisation['refferent'] >= 3:   $spec_list += ', ' + dyneval($vb_cycle_skill, slave_specialisation['refferent'], '비서')
			if slave_specialisation['cowSK'] >= 3:       $spec_list += ', ' + dyneval($vb_cycle_skill, slave_specialisation['cowSK'], '젖소녀')
! JO9 MOD START J9M1580 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
			$info_text = '[<<$assistant_name>>]<br>&nbsp;노예의 전공을 알아본 결과 다음과 같습니다. 주인님. <a href = "EXEC: master_stat_screen = 1 & killvar ''$info_text'' & quest_description_mode = 1 & choosen_quest = 11 & gt ''master_stat''">&nbsp;&nbsp;&nbsp;전공 조건보기</a>'
! JO9 MOD END J9M1580
			
			if $spec_list = '':
				$info_text += '<br><br> 현재 노예가 어떠한 전공 조건도 충족하지 못했습니다.'
			else
				$info_text += '<br><br> :<<$mid($spec_list, 3)>>'
			end
			
			if slave['brand'] = 0:
				$info_text += '<br><br> 현재 노예는 상표가 없습니다, 조합 내 판매는 가능하지만, 시중가보다 적은 값을 받게 됩니다.'
			end
		end
	else
		dynamic $replace("$info_text = '<<$psy_status[$assistant_psy_status]>>'", 'dyn'+'slave', 'assistant') &! evaluate delayed sub-expressions with substitution
	end
end

!Fix blank screen bug - crushboss
if assistant_state = CONST_INT['slave_exist']:
 	if $assistant["wpn"] = '': $assistant["wpn"] = 'безоружный'
 	if $assistant["armor"] = '': $assistant["armor"] = 'без_брони'
 	if $assistant["cloth"] = '': $assistant["cloth"] = 'голая'
end

gs 'stats_layout'

*p '<div id = "bookmark_one">규칙</div>'
*p '<div id = "bookmark_two">신체</div>'
*p '<div id = "bookmark_three">장비</div>'
*p '<div id = "bookmark_four">오라</div>'

if is_home = 1:
	*p '<div id = "close"><a href = "EXEC: $equip_choice = '''' & $info_text = '''' & gt ''menu_form''"><img src = "content\pic\buttons\close_button.png"></a></div>'
else
	*p '<div id = "close"><a href = "EXEC: $equip_choice = '''' & $info_text = '''' & gt ''city_menu_form''"><img src = "content\pic\buttons\close_button.png"></a></div>'
end

gs '$addon', 'info_box'

!수정부분
!조수왼쪽 정보.
*p '<div id="left_column_assistant"><br>'
*nl '호 칭 : &nbsp<<$assistant_name>>'
*nl '연 령 대 : &nbsp;<<$assistant_age_name[assistant["age"]]>>'
if assistant['age_count'] = 1:
	*nl '소 유 일 수 : &nbsp;1 일'
elseif assistant['age_count'] < 1000:
	*nl '소 유 일 수 : &nbsp;<<assistant["age_count"]>> 일'
else
	*nl '소 유 주 기 : &nbsp;<<assistant["age_count"]/10>> 주기'
end
gs '$slave_price', 'assistant' &! update $rating and rating to represent assistant so we can display the correct rank and populate $rating_help for the assistant when the rank is clicked
*nl ''
*nl '<a style="font-size:30px" class="tooltip-right" tooltip-data="등급을 올리는 방법" href="EXEC: msg $rating_help"><<$rating[rating]>></a>  조수 속성정보 <a class="tooltip-right" tooltip-data="속성에 대하여" style="color:black" href = "EXEC: msg $rank_help & msg $rank_help_2"><img style="width:15px;height:15px;" src="content/pic/chart.png"></a><br>'
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'beauty', assistant['beauty'], 1)
*nl '<font style="font-size:12px;">외모 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $красота_справка & dynamic $msg, $красота_справка_2 & $info_text = $красота_совет & gt $curloc"><<$beauty[assistant["beauty"]]>></a>'
$tooltip_text = func('$addon', 'assistant_stat_tooltip_text', 'stamina')
*nl '<font style="font-size:12px;">체력 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $здоровье_справка & dynamic $msg, $здоровье_справка_2 & $info_text = $здоровье_совет & gt $curloc"><<$stamina[assistant["stamina"]]>></a>'
$tooltip_text = func('$addon', 'assistant_stat_tooltip_text', 'sensitivity')
*nl '<font style="font-size:12px;">감수성 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $чувствительность_справка & dynamic $msg, $чувствительность_справка_2 & $info_text = $чувствительность_совет & gt $curloc"><<$sensitivity[assistant["sensitivity"]]>></a><br>'
$tooltip_text = func('$addon', 'assistant_stat_tooltip_text', 'temper')
*nl '<font style="font-size:12px;">성격 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $темперамент_справка & dynamic $msg, $темперамент_справка_2 & $info_text = $темперамент_совет & gt $curloc"><<$temper[assistant["temper"]]>></a>'
$tooltip_text = func('$addon', 'assistant_stat_tooltip_text', 'intellect')
*nl '<font style="font-size:12px;">지성 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $ум_справка & dynamic $msg, $ум_справка_2 & $info_text = $ум_совет & gt $curloc"><<$intellect[assistant["intellect"]]>></a>'
$tooltip_text = func('$addon', 'assistant_stat_tooltip_text', 'ego')
*nl '<font style="font-size:12px;">자아 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $характер_справка & dynamic $msg, $характер_справка_2 & $info_text = $характер_совет & gt $curloc"><<$ego[assistant["ego"]]>></a><br>'
$tooltip_text = func('$addon', 'assistant_stat_tooltip_text', 'pride', -1)
*nl '<font style="font-size:12px;">태도 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $гордыня_справка & dynamic $msg, $гордыня_справка_2 & $info_text = $гордыня_совет & gt $curloc"><<$pride[assistant["pride"]]>></a>'
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'exotic', assistant['exotic'], 1)
*nl '<font style="font-size:12px;">독특함 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $экзотичность_справка & dynamic $msg, $экзотичность_справка_2 & $info_text = $экзотичность_совет & gt $curloc"><<$exotic[assistant["exotic"]]>></a>'
$tooltip_text = func('$addon', 'assistant_physique_tooltip_text', 'fat', assistant['fat'])
*nl '<font style="font-size:12px;">체형 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $жыр_справка & dynamic $msg, $жыр_справка_2 & $info_text = $жыр_совет & gt $curloc"><<$fat[assistant["fat"]]>></a><br>'
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'style', assistant['style'], 1)
*nl '<font style="font-size:12px;">세련됨 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $стиль_справка & dynamic $msg, $стиль_справка_2 & $info_text = $стиль_совет & gt $curloc"><<$style[assistant["style"]]>></a>'
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'fame', assistant['fame'], 1)
*nl '<font style="font-size:12px;">인지도 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $слава_справка & dynamic $msg, $слава_справка_2 & $info_text = $слава_совет & gt $curloc"><<$girl_fame[assistant["fame"]]>></a>'
$tooltip_text = func('$addon', 'no_rate_full_grade_tooltip_text', 'mood', assistant['mood'], 1)
*nl '<font style="font-size:12px;">기분 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: msg $mood_chart & $info_text = $slave_mood_help & gt $curloc"><<$mood[assistant_mood_plus]>></a><br>'
*nl '조수의 특성'
*nl '<div style="line-height:5%"><br></div><<$assistant_features_list>>'
*p '</div>'

!main tab
!$info_text = ''&nbsp'' - info text will reset after switching
if assistant_stat_screen = 0:
 	*p '<div id = "mark_one"><img src = "content\pic\buttons\sel_button.png"></div>'
 	*p '<div id = "mark_two"><a href = "EXEC: assistant_stat_screen = 1 & killvar ''$info_text'' & gt $curloc"><img src = "content\pic\buttons\unsel_button.png"></a></div>'
 	*p '<div id = "mark_three"><a href = "EXEC: assistant_stat_screen = 2 & killvar ''$info_text'' & gt $curloc"><img src = "content\pic\buttons\unsel_button.png"></a></div>'
 	*p '<div id = "mark_four"><a href = "EXEC: assistant_stat_screen = 3 & killvar ''$info_text'' & gt $curloc"><img src = "content\pic\buttons\unsel_button.png"></a></div>'
 	if is_home = 1:
  		*p '<div id="center_image"><img src = "content\pic\bg\<<$interior_study[$study]>>.png"></div>'
 	else
  		*p '<div id="center_image"><img src = "content\pic\bg\<<$bg[$place]>>_small.png"></div>'
 	end
 	if nsfw = 0: *p func('display_fullimage', 'assistant', 'center_image', 'psy')

	!assistant alternate appearances
	$assistant_appearance = ''
	assistant_alt_appearance_count = 0

	if $fullmade[assistant_type] ! '':
	 	$assistant_appearance += '하녀 : &nbsp<br><span style="display:block; height:8px;"></span>'
		assistant_alt_appearance_count += 1
	else
	 	$assistant_appearance += '<br>'
	end
	if $fullsecretary[assistant_type] ! '':
		assistant_alt_appearance_count += 1
		if assistant['age'] = CONST_INT['milf_age']:
			$assistant_appearance += '비서 : &nbsp<br><span style="display:block; height:8px;"></span>'
		else
			$assistant_appearance += '교복 : &nbsp<br><span style="display:block; height:8px;"></span>'
		end
	end
	if $fullmistress[assistant_type] ! '':
	 	$assistant_appearance += '도미나 : &nbsp<br><span style="display:block; height:8px;"></span>'
		assistant_alt_appearance_count += 1
	else
		$assistant_appearance += '<br>'
	end

	if nsfw = 0 and assistant_alt_appearance_count > 0 and CONST_INT['slave_exist']:
		$assistant_appearance = '알몸 : &nbsp<br><span style="display:block; height:8px;"></span>' + $assistant_appearance
! JO9 MOD START J9M1579 | 2026-10-10_restore_ui_format_after_dialogue_normalization | changed block; context may be included
		*p '<div id="right_padding">- 임무 -<br><br><br><br><br><br><br><br><br><br><br><br><br>- 외형 -<br><br><br><br><br><br><br><span style="display:block; height:8px;"></span>- 보고 -</div>'
! JO9 MOD END J9M1579
		*p '<div id="assistant_appear"><br><<$assistant_appearance>></div>'

		if assistant['image_mode'] = 0:
			assistant['nude'] = 1
			assistant['maido'] = 0
			assistant['domina'] = 0
			assistant['executive'] = 0
		end
		if assistant['image_mode'] = 1:
			assistant['nude'] = 0
			assistant['maido'] = 0
			assistant['domina'] = 1
			assistant['executive'] = 0
		end
		if assistant['image_mode'] = 2:
			assistant['nude'] = 0
			assistant['maido'] = 1
			assistant['domina'] = 0
			assistant['executive'] = 0
		end
		if assistant['image_mode'] = 3:
			assistant['nude'] = 0
			assistant['maido'] = 0
			assistant['domina'] = 0
			assistant['executive'] = 1
		end

		if assistant['nude'] = 1:
			*p '<div id="chekbox_10r"><img src="content\pic\buttons\sel_button.png"></div>'
		else
			*p '<div id="chekbox_10r"><a href = "EXEC: assistant[''image_mode''] = 0 & $assistant[''fullimage''] = $fullimage[assistant_type] & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
		end

		IF $fullmade[assistant_type] ! '':
			if assistant['maido'] = 1:
				*p '<div id="chekbox_11r"><img src="content\pic\buttons\sel_button.png"></div>'
			else
				*p '<div id="chekbox_11r"><a href = "EXEC: assistant[''image_mode''] = 2 & $assistant[''fullimage''] = $fullmade[assistant_type] & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
			end
		end

		if $fullsecretary[assistant_type] ! '':
			if assistant['executive'] = 1:
				*p '<div id="chekbox_12r"><img src="content\pic\buttons\sel_button.png"></div>'
			else
				*p '<div id="chekbox_12r"><a href = "EXEC: assistant[''image_mode''] = 3 & $assistant[''fullimage''] = $fullsecretary[assistant_type] & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
			end

		if $fullmistress[assistant_type] ! '':
			if assistant['domina'] = 1:
				*p '<div id="chekbox_13r"><img src="content\pic\buttons\sel_button.png"></div>'
			else
				*p '<div id="chekbox_13r"><a href = "EXEC: assistant[''image_mode''] = 1 & $assistant[''fullimage''] = $fullmistress[assistant_type] & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
			end
		end
		end
	else
! JO9 MOD START J9M1578 | 2026-10-10_restore_ui_format_after_dialogue_normalization | changed block; context may be included
		*p '<div id="right_padding">- 임무 -<br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><span style="display:block; height:8px;"></span>- 보고 -</div>'
! JO9 MOD END J9M1578
	end
	killvar '$assistant_appearance'

 	*p '<div style ="line-height:71%;font-family:Sandoll 미생;font-size:22px;" id="right_rules">'
	*nl '<br>가내 회계&nbsp<br>'
	*nl '연금술 명령&nbsp<br>'
	*nl '요리 명령&nbsp<br>'
	*nl '잡일과 청소 명령&nbsp<br>'
	*nl '촉수 착정 명령&nbsp<br>'
	*nl '수행 보조&nbsp<br>'
	*nl '주인 씻기기&nbsp<br>'
	*nl '노예 씻기기&nbsp<br>'
	*nl '절정 금지&nbsp<br>'
	*nl '<div style="line-height: 0.5;"><br></div><br><br><br><br><br><br><br><br><br><br><br><br>'
	*nl '침묵 유지&nbsp<br>'
	*nl '주인과 동침&nbsp<br>'
	*nl '노예강간 허가&nbsp<br></div>'


	if assistant["account_rule"] = 1:
		*p '<div id="chekbox_1r"><a href = "EXEC: assistant[''account_rule''] = 0 & $info_text = $assistant_account_rule_abort & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
	else
		*p '<div id="chekbox_1r"><a href = "EXEC: assistant[''account_rule''] = 1 & $info_text = $assistant_account_rule & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
	end

	if lab <= 0:
		*p '<div id="chekbox_2r"><a href = "EXEC: msg $no_lab & gt $curloc"><img src="content\pic\buttons\unactive_button.png"></a></div>'
	elseif assistant["alchemist_rule"] = 1:
		!display enabled and do not allow disabling when no slave available - ImperatorAugustus
		if slave_state < CONST_INT['slave_exist']:
			*p '<div id="chekbox_2r"><a href = "EXEC: msg $no_slave & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
		else
			*p '<div id="chekbox_2r"><a href = "EXEC: assistant[''alchemist_rule''] = 0 & $info_text = $assistant_alchemist_rule_abort & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
		end
	else
		*p '<div id="chekbox_2r"><a href = "EXEC: assistant[''alchemist_rule''] = 1 & $info_text = $assistant_alchemist_rule & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
	end

	if kitchen <= 0:
		*p '<div id="chekbox_3r"><a href = "EXEC: msg $no_kitchen & gt $curloc"><img src="content\pic\buttons\unactive_button.png"></a></div>'
	elseif assistant["cooks_rule"] = 1:
		*p '<div id="chekbox_3r"><a href = "EXEC: assistant[''cooks_rule''] = 0 & $info_text =  $assistant_cooks_rule_abort & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
	else
		*p '<div id="chekbox_3r"><a href = "EXEC: assistant[''cooks_rule''] = 1 & $info_text = $assistant_cooks_rule & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
	end

	if assistant["cleans_rule"] = 1:
		*p '<div id="chekbox_4r"><a href = "EXEC: assistant[''cleans_rule''] = 0 & $info_text = $assistant_cleans_rule_abort & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
	else
		*p '<div id="chekbox_4r"><a href = "EXEC: assistant[''cleans_rule''] = 1 & $info_text = $assistant_cleans_rule & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
	end

	if pet_tentacle <= 0:
		*p '<div id="chekbox_5r"><a href = "EXEC: msg $no_tentacle & gt $curloc"><img src="content\pic\buttons\unactive_button.png"></a></div>'
	elseif assistant["tentacle_rule"] = 1:
		*p '<div id="chekbox_5r"><a href = "EXEC: assistant[''tentacle_rule''] = 0 & $info_text = $assistant_tentacle_rule_abort & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
	else
		*p '<div id="chekbox_5r"><a href = "EXEC: assistant[''tentacle_rule''] = 1 & $info_text = $assistant_tentacle_rule & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
	end

	if slave_state = CONST_INT['no_slave']:
		*p '<div id="chekbox_6r"><a href = "EXEC: msg $no_slave & gt $curloc"><img src="content\pic\buttons\unactive_button.png"></a></div>'
	elseif assistant["supervise_rule"] = 1:
		*p '<div id="chekbox_6r"><a href = "EXEC: assistant[''supervise_rule''] = 0 & $info_text = $assistant_supervise_rule_abort & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
	else
		*p '<div id="chekbox_6r"><a href = "EXEC: assistant[''supervise_rule''] = 1 & $info_text = $assistant_supervise_rule & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
	end

	if bath <= 0:
		*p '<div id="chekbox_7r"><a href = "EXEC: msg $no_bath & gt $curloc"><img src="content\pic\buttons\unactive_button.png"></a></div>'
	elseif assistant["washes_master_rule"] = 1:
