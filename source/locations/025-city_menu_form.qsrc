    FUNC('$menu', 'interaction_city', $menu_item_RedBaron, menu_RedBaron, '레드 바론 영지')
  ELSE
    FUNC('$menu', 'interaction_city', $menu_item_RedBaron_gray, menu_RedBaron, '레드 바론 영지')
  END
  FUNC('$menu', '===END===')
END

