# city_menu_form
! Readable view; authoritative fields are in ../locations.json.
ui_style = 2
! JO9_SINGLE_GRIMDARK_UI_20261014
! JO9 MOD START J9M0005 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'city_menu_form': gs 'snk_room_bridge', 'guard', 'city_menu_form'
! JO9 MOD END J9M0005
!return to tutorial if the player somehow escapes
if exam_in_progress = 1: gt 'demo_menu_form'
gs '$newloc' &! ensure all stats are updated before displaying them

dynamic $slave_pass_out
dynamic $prisoner_pass_out
dynamic $assistant_pass_out
dynamic $cow_pass_out
dynamic $master_pass_out &! master should be last

$text_display = ''
$setting_display = ''
$setting_display_c = ''
$setting_display_c2 = ''
$setting_display_r = ''
$return_lock  = 'city_menu_form'
sp_txt = 0
get_girl = 0
is_home = 0
!обнуление
buyer_from_house = 0


!Energy loss will occur with the regular menu now instead of only with the quick travel buttons - crushboss
if city_form = 0:
	$place = 'city'
	func('$menu', 'spacer', 1)

	func('$menu', '===BEGIN===', 'column_0')

	func('$menu', 'exec_options', $menu_item_town, 'city_form = 1 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', '백색 도시')
	func('$menu', 'exec_options', $menu_item_Necropolis, 'city_form = 5 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', '네크로폴리스')
	func('$menu', 'exec_options', $menu_item_Bull, 'city_form = 2 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', '황소 구역')
	func('$menu', 'exec_options', $menu_item_Serpentine, 'city_form = 3 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', '뱀자리 구역')

	func('$menu', 'exec_options', $menu_item_Outcasts, 'city_form = 4 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', '추방자 구역')
	FUNC('$menu', 'exec_options', $menu_item_eastkvartal, 'city_form = 121 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', '동부 구역')
	FUNC('$menu', 'exec_options', $menu_item_redlight, 'city_form = 117 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', '홍등가')
	FUNC('$menu', 'exec_options', $menu_item_centralkvartal, 'city_form = 118 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', '중앙 구역')
	!func('$menu', 'exec_options', $menu_item_Slums, 'city_form = 6 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', 'The Slums')
	func('$menu', 'exec_options', $menu_item_city_gate, 'city_form = 61 & $quick_move_action = "go" & gt "sjm_UI_UIadds"', '도시 관문으로')
	func('$menu', '===END===')
end



if city_form = 1:
	city_district = 1
	$place = 'white_city'
	func('$menu', 'spacer', 1)

	func('$menu', '===BEGIN===', 'column_0')

	func('$menu', 'city_form', $menu_item_ResidencesWhiteTown, menu_ResidencesWhiteTown, '팔라틴 저택가')
	func('$menu', 'city_form', $menu_item_square, menu_square, '교역 광장')
	func('$menu', 'interaction_city', $menu_item_guild, menu_guild, '노예상 길드')
	func('$menu', 'interaction_city', $menu_item_Colosseum, menu_Colosseum, '콜로세움')
	func('$menu', 'interaction_city', $menu_item_Central, menu_Central, '중앙 포럼')
	func('$menu', 'interaction_city', $menu_item_Vatican, menu_Vatican, '바티칸')
	func('$menu', 'city_form', $menu_item_Leavewhite, menu_Leavewhite, '구역을 떠난다')

	func('$menu', '===END===')
end

if city_form = 11:
	$place = 'market'

	func('$menu', '===BEGIN===', 'column_0')

	if slave_state = CONST_INT['no_slave']:
		func('$menu', 'goto_city', $menu_item_marketbuy, menu_market, 'txt = 1', 'slave_auction_buy', '노예 시장')
	elseif slave_state ! CONST_INT['no_slave']:
		func('$menu', 'goto_city', $menu_item_marketsell, menu_market, 'txt = 1', 'slave_auction_sell', '노예 시장')
	else
		func('$menu', 'city_form', $menu_item_nomarket, empty, '노예 시장')
	end
	func('$menu', 'interaction_city', $menu_item_Gastronomicon, menu_Gastronomicon, '식품점 -미식가들-')
	func('$menu', 'interaction_city', $menu_item_laid, menu_laid, '미용실 -누워있는 엘프-')
	func('$menu', 'interaction_city', $menu_item_Quint, menu_Quint, '양품점 -세르빌리아 퀸타-')
	func('$menu', 'interaction_city', $menu_item_treasury, menu_treasury, '패물점 -아주라-')
	func('$menu', 'interaction_city', $menu_item_armory, menu_armory, '무구점 -맨 헌터의 무기점-')
	func('$menu', 'interaction_city', $menu_item_office, menu_office, '부동산 사무소')
	func('$menu', 'city_form', $menu_item_Leavesquare, menu_Leavesquare, '교역 광장을 떠난다')

	func('$menu', '===END===')
end

if city_form = 111:
	$place = 'white_street'

	func('$menu', '===BEGIN===', 'column_0')

	if $estate = 'white_house':
! JO9 MOD START J9M0004 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
		func('$menu', 'goto_city', $menu_item_apartmentwhite_house, 0, 'menu_form = 0 & city_form', 'menu_form', '내가 사는 집')
! JO9 MOD END J9M0004
	end
! JO9 MOD START J9M0003 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	func('$menu', 'interaction_city', $menu_item_KulaShop, menu_KulaShop, '쿨라의 비밀상점')
	func('$menu', 'city_form', $menu_item_town, menu_town, '중앙 거리로')
! JO9 MOD END J9M0003
	
	func('$menu', '===END===')
end



