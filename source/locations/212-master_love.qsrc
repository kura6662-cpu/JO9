	if master_str >= 3 and master_cha >= 3 and master_style >= 2 and master_domination >= 3:
!		msg '3_2<br><<slave1["obedience"]>><br><<slave1["fear"]>><br><<slave1["angst"]>><br><<slave1["rational"]>><br><<slave1["instinct"]>><br><<slave1["custom"]>><br><<slave1["spoil"]>><br><<slave1["moral"]>>'
		if slave1["obedience"] >= 10 and slave1["fear"] <= 2 and slave1["angst"] <= 1 and slave1["rational"] >= 2 and slave1["instinct"] = 5 and slave1["custom"] = 5 and slave1["spoil"] <= 3 and slave1["moral"] >= 4:
