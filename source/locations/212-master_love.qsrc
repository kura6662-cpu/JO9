if sa_rel = 1:
	copyarr 'slave1', 'slave'
elseif sa_rel = 2:
	copyarr 'slave1', 'assistant'	
end

! Проверка на настоящую любовь

if slave1["love"] = 0:
!	msg "1_1"
	if master_str = 5 and master_cha = 5 and master_style = 5 and master_domination = 5:
!		msg "1_2"
		if slave1["obedience"] >= 10 and slave1["arousal"] >= 3 and slave1["fear"] = 0 and slave1["angst"] = 0 and slave1["instinct"] = 5 and slave1["custom"] = 5 and slave1["spoil"] <= 2 and slave1["moral"] = 5:
!			msg "1_3"
			if slave1["sensitivity"] >= 3 and slave1["temper"] >= 3 and slave1["pride"] <= 4:
				slave1["pos_slave_love"] = 100
				slave1["pos_slave_love2"] = 0
				slave1["pos_slave_love3"] = 0
				slave1["pos_slave_love4"] = 0
				slave1["pos_slave_love5"] = 0
				slave1["pos_slave_love6"] = 0
!				msg "<<sa_rel>> 1-рабыня, 2-ассист.<br><br>Настоящая любовь к мастеру"
				jump 'override'
			end
		end
	end
end

! Проверка на влюблённость

if slave1["abuse_attitude"] = -1 or slave1["perversion"] = -1 or slave1["masochism"] = -1 or slave1["nymphomania"] = -1 or slave1["exhibitionism"] = -1 or slave1["compassion"] = 1:
