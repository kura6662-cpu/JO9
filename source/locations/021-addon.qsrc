# $addon
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2816 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '$addon': gs 'snk_room_bridge', 'guard', '$addon'
! JO9 MOD END J9M2816
!Updates changed databases cleans up old variables
if $args[0] = 'update':
	if $args[1] = 'full':
		!Reload databases
		gs 'interior_storage'
		gs 'refresh_database'
		gs 'interior_restore'

! JO9 MOD START J9M2815 | 2026-10-15_refresh_message_ui_before_save_upgrade | changed block; context may be included
! JO9_MESSAGE_LAYOUT_REFRESH_20261015
! Saved UI settings must not retain retired button paths.
$MSG_BACKIMAGE = 'content/pic/msg_bg.png'
$MSG_OK_IMAGE = 'content/pic/buttons/ok-icon.png'
$MSG_FORMAT = '<div id="ink">%TEXT%</div>'
MSG_TEXT_X = 80
MSG_TEXT_Y = 40
MSG_TEXT_W = 370
MSG_TEXT_H = 400
MSG_OK_X = 250
MSG_OK_Y = 340
MSG_X = 200
! JO9_MESSAGE_LAYOUT_REFRESH_END
! JO9 MOD END J9M2815
		!title fix
		if $game_ver ! $title_fix:
			if $game_ver ! '':
				msg '<br><center>게임이<br>(<<$game_ver>>)<br>에서<br>(<<$title_fix>>)<br>로 업데이트되었습니다'
			else
				msg '<br><center>게임이<br>(<<$title_fix>>)<br>로 업데이트되었습니다'
			end
			if no_loli ! 1 and instr($title_fix, ' no-loli edition') > 0: no_loli = 1 &! added in 2.2.3 - ImperatorAugustus
			$game_ver = $title_fix
			
			if slaver_stats_decay = 1: killvar 'slaver_stats_decay' & slaver_background_matters = 1 & master_check = 0 &! added in 2.3.0.1 - ImperatorAugustus
			if fridge['flower'] > 0: fridge['grain'] = fridge['flower'] & fridge['flower'] = 0 &! added in 2.3.1 - ImperatorAugustus
		end
	end
end

if $args[0] = 'master_rate_stat_tooltip_text':
	if args[2] = 0:
		$result = "<<$atr_name[$args[1]]>><<$skill_grade[iif(args[3] = -1, 5, 0)]>> (<<dyneval('result = ' + $args[1+args[4]] + '_rate')>>/<<dyneval('result = ' + $args[1+args[4]] + '_rate_cap[0]')>>)"
	elseif args[2] = 1:
		$result = "<<$atr_name[$args[1]]>><<$skill_grade[iif(args[3] = -1, 4, 1)]>> (<<dyneval('result = ' + $args[1+args[4]] + '_rate')>>/<<dyneval('result = ' + $args[1+args[4]] + '_rate_cap[1]')>>)"
	elseif args[2] = 2:
		$result = "<<$atr_name[$args[1]]>><<$skill_grade[iif(args[3] = -1, 3, 2)]>> (<<dyneval('result = ' + $args[1+args[4]] + '_rate')>>/<<dyneval('result = ' + $args[1+args[4]] + '_rate_cap[2]')>>)"
	elseif args[2] = 3:
		$result = "<<$atr_name[$args[1]]>><<$skill_grade[iif(args[3] = -1, 2, 3)]>> (<<dyneval('result = ' + $args[1+args[4]] + '_rate')>>/<<dyneval('result = ' + $args[1+args[4]] + '_rate_cap[3]')>>)"
	elseif args[2] = 4:
		$result = "<<$atr_name[$args[1]]>><<$skill_grade[iif(args[3] = -1, 1, 4)]>> (<<dyneval('result = ' + $args[1+args[4]] + '_rate')>>/<<dyneval('result = ' + $args[1+args[4]] + '_rate_cap[4]')>>)"
	elseif args[2] = 5:
		$result = "<<$atr_name[$args[1]]>><<$skill_grade[iif(args[3] = -1, 0, 5)]>>"
	elseif args[2] = 6:
		$result = "<<$atr_name[$args[1]]>> S++"
	end
end

