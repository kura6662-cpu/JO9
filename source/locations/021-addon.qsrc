if $args[0] = 'menu_form' or $args[0] = 'city_menu_form' and args[1] ! 0 and args[2] ! 0:

!lillimerge, might want to rename this as Cheat Mode, for clarity
	$setting_display += {<br><div id="under_gray">{ { { 위저드 모드 } } }<br></div>}
	if wizard_mode ! 1:
	 	$setting_display += '<br><div id="under">끔<br><div id = "clear"><a href = ''EXEC: wizard_mode = 1 & gt "<<$args[0]>>"''><img src = "content\pic\clear.png"></a></div></div>'
	else
	 	$setting_display += '<br><div id="under">켬<br><div id = "clear"><a href = ''EXEC: wizard_mode = 0 & gt "<<$args[0]>>"''><img src = "content\pic\clear.png"></a></div></div>'
	end

!lillimerge, not sure what the use of the turning on and off debug mode is
	$setting_display += {<br><div id="under_gray">{ { { 디버그 } } }<br></div>}
	if debug ! 1:
	 	$setting_display += '<br><div id="under">끔<br><div id = "clear"><a href = ''EXEC: debug = 1 & gt "<<$args[0]>>"''><img src = "content\pic\clear.png"></a></div></div>'
	else
	 	$setting_display += '<br><div id="under">켬<br><div id = "clear"><a href = ''EXEC: debug = 0 & gt "<<$args[0]>>"''><img src = "content\pic\clear.png"></a></div></div>'
	end

	if $args[0] = 'city_menu_form':
		$setting_display_c += '<br><div id="under">이전 <br><div id = "clear"><a href = ''EXEC: city_form = <<args[2]>> & gt "<<$args[0]>>"''><img src = "content\pic\clear.png"></a></div></div>'
		if args[3] ! 0:
			$setting_display_c2 += '<br><div id="under">다음 <br><div id = "clear"><a href = ''EXEC: city_form = <<args[3]>> & gt "<<$args[0]>>"''><img src = "content\pic\clear.png"></a></div></div>'
		else
			$setting_display_c2 += {<br><div id="under_gray"> 다음 <br></div>}
		end
	else
		$setting_display_c += '<br><div id="under">이전 <br><div id = "clear"><a href = ''EXEC: <<$args[0]>> = <<args[2]>> & gt "<<$args[0]>>"''><img src = "content\pic\clear.png"></a></div></div>'
		if args[3] ! 0:
			$setting_display_c2 += '<br><div id="under">다음 <br><div id = "clear"><a href = ''EXEC: <<$args[0]>> = <<args[3]>> & gt "<<$args[0]>>"''><img src = "content\pic\clear.png"></a></div></div>'
		else
			$setting_display_c2 += {<br><div id="under_gray"> 다음 <br></div>}
		end
	end
end

