$тип_вреда['огненный_шар'] = 'огонь'
$суперудар_тип['огненный_шар'] = 'сильная'
$суперудар_название['огненный_шар'] = "<font color='red'>Огненный шар</font>"
суперудар_длительность['огненный_шар'] = 2+ловкость
