$суперудар_условие_2['цепь_молний'] = 'нет'
$суперудар_условие_против['цепь_молний'] = 'отсутствует'

$спецэффект_суперудара['цепь_молний'] = {
	! strike living enemies adjacent to current target (rewritten as a single loop - ImperatorAugustus)
	for вторцель = (текущий - 1) to (текущий + 1):
		if вторцель ! текущий and враг[вторцель] = 1:
			! secondary target is not current target, secondary target is alive

			atk = 0
			def = вторцель

			вред_на_рассчет = базовый_вред[$оружие]*2
			$атака = 'точная'

			gs 'рассчет_вреда'

			if $класс_врага[вторцель] = 'пешка':
				if модификатор > 0:
					$состояние[вторцель] = 'повержен'
					дух_игрока += 2
				end
			elseif $тип_нанесенного_вреда = 'психический':
				if тонкое_тело[$враг[вторцель]] = 1: здоровье_врага[вторцель] -= нанесенный_вред
				if бесстрашный[$враг[вторцель]] = 0: дух_врага[вторцель] -= нанесенный_вред
				дух_игрока += нанесенный_вред/2
			elseif $тип_нанесенного_вреда = 'дробящий':
				if хрупкий[$враг[вторцель]] = 1: здоровье_врага[вторцель] -= нанесенный_вред
				if безустали[$враг[вторцель]] = 0: выносливость_врага[вторцель] -= нанесенный_вред
				if бесстрашный[$враг[вторцель]] = 0: дух_врага[вторцель] -= нанесенный_вред
				дух_игрока += нанесенный_вред/2
			else
				if бессмертный[$враг[вторцель]] = 0: здоровье_врага[вторцель] -= нанесенный_вред
				if безустали[$враг[вторцель]] = 0: выносливость_врага[вторцель] -= нанесенный_вред
				if бесстрашный[$враг[вторцель]] = 0: дух_врага[вторцель] -= нанесенный_вред
				дух_игрока += нанесенный_вред/2 &! bugfix: was нанесенный_вред[i]/2 when i is not initialized here - ImperatorAugustus
			end

		end
	end
}


