		$left_text_teach += '<a href = "EXEC: interaction = 1214 & gt ''interaction''"><<dyneval($vb_cycle_skill, slave["secretary"], "비서 수업" + $skill_grade[slave["secretary"]])>></a><<iif(debug_interactions = 3, "(" + debug_repulse[1214] + ")", "")>><br>'
