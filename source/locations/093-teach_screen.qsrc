!PERSONAL TRAINING TAB
if teach_stat_screen = 0:

	!creating a training list

	$left_text_teach = ''
	$middle_text_1 = ''
	$middle_text_2 = ''
	$middle_text_3 = ''
	$middle_text_4 = ''
	$middle_text_5 = ''
	$middle_text_6 = ''
	$middle_text_7 = ''
	$middle_text_8 = ''
	$left_text_heading = ''
	$right_text_heading = ''

	if debug_interactions = 2:
		copyarr 'backup_slave', 'slave'
		interaction = 1211
		gt 'interaction'
	end

	$left_text_heading += '<u>기술 훈련 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</u>'
	if slave["service"] > 5:
		$left_text_teach += '<a href = "EXEC: msg $max_skill & gt $curloc"><font color="#424242">하녀 수업</font></a><br>'
	elseif house_mess < 1:
		$left_text_teach += '<a href = "EXEC: msg $no_house_mess & gt $curloc"><font color="#424242">하녀 수업</font></a><br>'
	else
		$left_text_teach += '<a href = "EXEC: interaction = 1211 & gt ''interaction''"><<dyneval($vb_cycle_skill, slave["service"], "하녀 수업" + $skill_grade[slave["service"]])>></a><<iif(debug_interactions = 3, "(" + debug_repulse[1211] + ")", "")>><br>'
		!$left_text_teach += '<a href = "EXEC: interaction = 1211 & gt ''interaction''"><<$slave_service[slave[''service'']]>></a><br>'
	end
	if slave["cook"] > 5:
		$left_text_teach += '<a href = "EXEC: msg $max_skill & gt $curloc"><font color="#424242">요리 수업</font></a><br>'
