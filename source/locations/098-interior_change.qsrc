 $jo9_candidates[1] = 'content/pic/scene/Witch/witch (2).png'
 jo9_candidate_ids[1] = 1
end
! JO9 WINDOWS IMAGE SLOT REGISTRY END
 jo9_active_count = 0
 jo9_selected_at = -1
 jo9_i = 0
 :jo9_slot_registered_check
 if jo9_i < jo9_count:
  $jo9_candidate = $jo9_candidates[jo9_i]
  if jo9_selected = jo9_candidate_ids[jo9_i]: $jo9_saved_path = $jo9_candidate
  jo9_exists = 0
  dynamic 'jo9_exists = %<<$jo9_candidate>>%'
  if jo9_exists = 1:
   $jo9_active_paths[jo9_active_count] = $jo9_candidate
   jo9_active_ids[jo9_active_count] = jo9_candidate_ids[jo9_i]
   if jo9_selected = jo9_candidate_ids[jo9_i]: jo9_selected_at = jo9_active_count
   jo9_active_count += 1
  end
  jo9_i += 1
  jump 'jo9_slot_registered_check'
 end
 ! Only the three Windows-copy siblings are discovered at runtime.
 $jo9_ext = $strfind($jo9_input, '(\.[^./]+)$', 1)
 if $jo9_ext ! '': $jo9_stem = $mid($jo9_input, 1, len($jo9_input) - len($jo9_ext))
 if $jo9_ext ! '' and $strfind($jo9_stem, ' \([0-9]+\)$') = '':
  jo9_slot = 2
  :jo9_slot_windows_check
  if jo9_slot <= 4:
   $jo9_candidate = $jo9_stem + ' (' + str(jo9_slot) + ')' + $jo9_ext
   if jo9_selected = 10000 + jo9_slot: $jo9_saved_path = $jo9_candidate
   $jo9_candidate_key = $lcase($replace($jo9_candidate, '\', '/'))
   jo9_duplicate = 0
   jo9_j = 0
   :jo9_slot_duplicate_check
   if jo9_j < jo9_count:
    if $lcase($replace($jo9_candidates[jo9_j], '\', '/')) = $jo9_candidate_key: jo9_duplicate = 1
    jo9_j += 1
    jump 'jo9_slot_duplicate_check'
   end
   if jo9_duplicate = 0:
    jo9_exists = 0
    dynamic 'jo9_exists = %<<$jo9_candidate>>%'
    if jo9_exists = 1:
     $jo9_active_paths[jo9_active_count] = $jo9_candidate
     jo9_active_ids[jo9_active_count] = 10000 + jo9_slot
     if jo9_selected = 10000 + jo9_slot: jo9_selected_at = jo9_active_count
     jo9_active_count += 1
    end
   end
   jo9_slot += 1
   jump 'jo9_slot_windows_check'
  end
 end
 ! Mode 2 identifies the image already rendered, even if its file was removed.
 if args[2] = 2:
  jo9_image_count = jo9_active_count
  $result = $jo9_saved_path
  exit
 end
 ! A missing saved choice returns to A (or the first surviving path if A is absent).
 if jo9_selected_at < 0:
  jo9_selected_at = 0
  jo9_cut_choice[$jo9_base] = 0
 end
 if jo9_active_count > 0:
  if args[2] = 1: jo9_selected_at = (jo9_selected_at + 1) mod jo9_active_count
  $jo9_path = $jo9_active_paths[jo9_selected_at]
  jo9_cut_choice[$jo9_base] = jo9_active_ids[jo9_selected_at]
 end
 jo9_image_count = jo9_active_count
 $result = $jo9_path
 exit
end
! JO9 MOD END WINDOWS_IMAGE_SLOTS_PATH
if $args[0] = 'jo9_html':
 local $jo9_html, $jo9_tail, $jo9_src, $jo9_attr, $jo9_newsrc, $jo9_saved_html, jo9_at, jo9_next
 $jo9_html = $args[1]
 ! JO9 paired cutscene tools: exclude home dashboard and combat.
 if $curloc = 'main_screen' or $curloc = 'demo_estate' or $curloc = 'боевой_интерфейс' or $curloc = 'конец_боя' or $curloc = 'colosseum_fight' or instr($jo9_html, 'fight_bg') > 0 or instr($jo9_html, 'bg_right') > 0:
  $result = $jo9_html
  exit
 end
 if instr($jo9_html, '<img') = 0:
  $result = $jo9_html
  exit
 end
 ! Reset image-only mode on a fresh scene; preserve layered pictures within one render.
 jo9_clean_hidden = 0
 if $jo9_clean_overlay ! '':
  $jo9_saved_html = $replace($maintxt, $jo9_clean_overlay, '')
  if $jo9_saved_html ! $maintxt:
   *clr
   *p $jo9_saved_html
  end
 end
 $jo9_clean_overlay = ''
 ! Remove the previous layer switch, but retain its selected picture.
 if $jo9_last_button ! '':
  $jo9_saved_html = $replace($maintxt, $jo9_last_button, '')
  if $jo9_saved_html ! $maintxt:
   *clr
   *p $jo9_saved_html
  end
 end
 $jo9_last_button = ''
 $jo9_visible_top = ''
 jo9_at = 1
 :jo9_image_scan
 jo9_next = instr($mid($jo9_html, jo9_at), '<img')
 if jo9_next > 0:
  jo9_next += jo9_at - 1
  $jo9_tail = $mid($jo9_html, jo9_next)
  $jo9_src = $strfind($jo9_tail, 'src\s*=\s*"([^"]+)"', 1)
  if $jo9_src ! '':
   $jo9_visible_top = $lcase($replace($jo9_src, '\', '/'))
   $jo9_newsrc = func('interior_change', 'jo9_path', $jo9_src)
   $jo9_attr = $strfind($jo9_tail, 'src\s*=\s*"([^"]+)"')
   $jo9_html = $replace($jo9_html, $jo9_attr, 'src="' + $jo9_newsrc + '"')
  end
  jo9_at = jo9_next + 4
  jump 'jo9_image_scan'
 end
 if $jo9_visible_top ! '':
  $jo9_newsrc = func('interior_change', 'jo9_path', $jo9_visible_top)
  if jo9_image_count >= 1:
! JO9 MOD START J9M1248 | 2026-10-08_image_cycle_tooltip_right, 2026-10-08_image_cycle_top_left | changed block; context may be included
   $jo9_last_button = '<div id="jo9_image_cycle" style="position:absolute;left:7px;right:auto;top:4px;width:62px;height:28px;z-index:2147483600;"><a class="tooltip-right" tooltip-data="이미지 전환" title="이미지 전환" style="display:block;position:relative;width:26px;height:26px;" href="EXEC: gs ''interior_change'', ''jo9_toggle''"><img style="width:26px;height:26px;" src="content/pic/ui/approved_main_v1/tool_room.png"></a><a id="jo9_cutscene_view" class="tooltip-right" tooltip-data="컷신만 보기 / UI 복원" title="컷신만 보기 / UI 복원" style="display:block;position:absolute;left:32px;top:0;width:26px;height:26px;line-height:26px;text-align:center;background:#202820;color:#e8d39c;border:1px solid #b59d62;border-radius:3px;font-size:20px;" href="EXEC: gs ''interior_change'', ''jo9_clean_toggle''">◉</a></div>'
! JO9 MOD END J9M1248
! JO9 MOD START WINDOWS_IMAGE_SLOTS_DISABLED | 2026-10-18_windows_image_slots
   if jo9_image_count = 1:
    $jo9_last_button = $replace($jo9_last_button, 'tooltip-data="이미지 전환" title="이미지 전환"', 'tooltip-data="이미지 전환 · 추가 컷 없음" title="이미지 전환 · 추가 컷 없음"')
    $jo9_last_button = $replace($jo9_last_button, 'display:block;position:relative;width:26px;height:26px;', 'display:block;position:relative;width:26px;height:26px;opacity:0.45;')
    $jo9_last_button = $replace($jo9_last_button, 'href="EXEC: gs ''interior_change'', ''jo9_toggle''"', 'aria-disabled="true"')
   end
! JO9 MOD END WINDOWS_IMAGE_SLOTS_DISABLED
! JO9 MOD START J9M1247 | 2026-10-10_restore_private_room_ui_corrections | changed block; context may be included
   if instr($jo9_html, 'id="snk_room_bg"') > 0 or instr($jo9_html, 'id="snk_room_character"') > 0:
    $jo9_html += $jo9_last_button
   else
   $jo9_html = $replace($jo9_html, '</div>', $jo9_last_button + '</div>')
   end
! JO9 MOD END J9M1247
  end
 end
 $result = $jo9_html
 exit
end
! JO9 MOD START WINDOWS_IMAGE_SLOTS_TOGGLE | 2026-10-18_windows_image_slots
if $args[0] = 'jo9_toggle':
 local $jo9_before, $jo9_after, $jo9_current_html, $jo9_before_attr, $jo9_after_attr, jo9_match, jo9_searchpos, jo9_last_match, jo9_before_choice, jo9_saved_choice, $jo9_before_button
 if $jo9_visible_top = '': exit
 jo9_saved_choice = jo9_cut_choice[$jo9_visible_top]
 $jo9_before = func('interior_change', 'jo9_path', $jo9_visible_top, 2)
 $jo9_after = func('interior_change', 'jo9_path', $jo9_visible_top)
 jo9_before_choice = jo9_cut_choice[$jo9_visible_top]
 if jo9_saved_choice = jo9_before_choice and jo9_image_count > 1:
  $jo9_after = func('interior_change', 'jo9_path', $jo9_visible_top, 1)
 end
 $jo9_current_html = $replace($maintxt, $jo9_clean_overlay, '')
 $jo9_before_attr = 'src="' + $jo9_before + '"'
 $jo9_after_attr = 'src="' + $jo9_after + '"'
 jo9_searchpos = 1
 jo9_last_match = 0
 :jo9_find_top_attribute
 jo9_match = instr($mid($jo9_current_html, jo9_searchpos), $jo9_before_attr)
 if jo9_match > 0:
  jo9_last_match = jo9_searchpos + jo9_match - 1
  jo9_searchpos = jo9_last_match + len($jo9_before_attr)
  jump 'jo9_find_top_attribute'
 end
 if jo9_last_match = 0:
  jo9_cut_choice[$jo9_visible_top] = jo9_before_choice
  exit
 end
 $jo9_current_html = $mid($jo9_current_html, 1, jo9_last_match - 1) + $jo9_after_attr + $mid($jo9_current_html, jo9_last_match + len($jo9_before_attr))
 if jo9_image_count < 2 and $jo9_last_button ! '':
  $jo9_before_button = $jo9_last_button
  $jo9_last_button = $replace($jo9_last_button, 'tooltip-data="이미지 전환" title="이미지 전환"', 'tooltip-data="이미지 전환 · 추가 컷 없음" title="이미지 전환 · 추가 컷 없음"')
  $jo9_last_button = $replace($jo9_last_button, 'display:block;position:relative;width:26px;height:26px;', 'display:block;position:relative;width:26px;height:26px;opacity:0.45;')
  $jo9_last_button = $replace($jo9_last_button, 'href="EXEC: gs ''interior_change'', ''jo9_toggle''"', 'aria-disabled="true"')
  $jo9_current_html = $replace($jo9_current_html, $jo9_before_button, $jo9_last_button)
 end
 if jo9_clean_hidden = 1:
  $jo9_clean_overlay = func('interior_change', 'jo9_clean_html')
  $jo9_current_html += $jo9_clean_overlay
 end
 *clr
 *p $jo9_current_html
 refint
 exit
end
! JO9 MOD END WINDOWS_IMAGE_SLOTS_TOGGLE
! End JO9 image-cycle; original home room switching follows.
! JO9 image-only viewing never re-enters a game location.
if $args[0] = 'jo9_clean_html':
 ! Hide real UI nodes without cloning or resizing any pictures.
! JO9 MOD START J9M1246 | 2026-10-12_zzz_hide_choice_controls | changed block; context may be included
 $result = '<style id="jo9_clean_style">.menu,.tooltip,#main_screen,#sparks_display,#snk_room_menu,#approve,#deny{visibility:hidden!important;pointer-events:none!important}'
! JO9 MOD END J9M1246
 if $curloc = 'city_screen': $result += '#settings,#settings_2r,#settings_ex,#settings_ex2,#back_home{visibility:hidden!important;pointer-events:none!important}'
 $result += '</style>'
 exit
end

if $args[0] = 'jo9_clean_toggle':
 local $jo9_view_html
 if $jo9_last_button = '' or instr($maintxt, $jo9_last_button) = 0: exit
 $jo9_view_html = $replace($maintxt, $jo9_clean_overlay, '')
 jo9_clean_hidden = 1 - jo9_clean_hidden
 $jo9_clean_overlay = ''
 if jo9_clean_hidden = 1:
  $jo9_clean_overlay = func('interior_change', 'jo9_clean_html')
  $jo9_view_html += $jo9_clean_overlay
 end
 *clr
 *p $jo9_view_html
 refint
 exit
end

!Move to a different room in your apartment
!Created by crushboss

!gs 'main_layout'

if change_interior = 1: interior_num += 1
if interior_num > 7: interior_num = 1
if interior_num = 1: $place = 'bedroom_lux'
if interior_num = 2 and bath > 0:
	$place = 'bathroom_lux'
elseif interior_num = 2 and bath = 0:
	interior_num += 1
end
if interior_num = 3 and dungeon > 0:
	$place = 'dungeon_lux'
elseif interior_num = 3 and dungeon = 0:
	interior_num += 1
end
if interior_num = 4 and kitchen > 0:
	$place = 'kitchen_lux'
elseif interior_num = 4 and kitchen = 0:
	interior_num += 1
end
if interior_num = 5 and lab > 0:
	$place = 'lab_lux'
elseif interior_num = 5 and lab = 0:
	interior_num += 1
end
if interior_num = 6 and boudoir > 0:
	$place = 'boudoir_lux'
elseif interior_num = 6 and boudoir = 0:
	interior_num += 1
end
if interior_num = 7: $place = 'home_lux'

change_interior = 0

