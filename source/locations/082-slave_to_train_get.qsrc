# slave_to_train_get
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2862 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'slave_to_train_get': gs 'snk_room_bridge', 'guard', 'slave_to_train_get'
! JO9 MOD END J9M2862
!Забираем рабыню по контракту
train_slave_count[$npc_id] = 0

contract['time'] = npc_contract_time[$npc_id]
contract['salary'] = npc_reward[$npc_id]
sparks += npc_advance[$npc_id]
$stock['contractor'] = $npc_id
stock["brand"] = 4


city_form = 1
$return_lock = 'city_menu_form'
gs 'stock_to_slave'

------------ slave_to_train_get ------------
