		*p '<div class="inventory_item"><a style = "color: black;" href = "EXEC: dynamic $master_ring_list"><u>반 지</u> : <<$item_name[$master_ring]>></a></div>'
! JO9 MOD END J9M1560
		*p '<div class="inventory_item"><a style = "color: black;" href = "EXEC: dynamic $master_karman_list"><u>주 머 니</u> :  <<$item_name[$master_karman]>></a></div>'
	*p '</div>'
