*nl '<a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>" href="EXEC: msg $master_fetish_chart & $info_text = $master_fetish_help & gt $curloc"><<$master_fetish[master_fetish]>> </a><font style="font-size:12px; line-height: 32px;">  이상  </font></div>'

!OBJECTIVES TAB
if master_stat_screen = 1:
	gs '#quest_base' &! update dynamic quest status and text
	if city_already_done_today[$str(menu_findcustomers)]: gs '$appropriate_buyers_list'
	gs '$quest_list' &! update quest list for objectives tab
	*p '<div id = "mark_one"><a href = "EXEC: master_stat_screen = 0 & gt $curloc"><img src = "content\pic\buttons\unsel_button.png"></a></div>'
	*p '<div id = "mark_two"><img src = "content\pic\buttons\sel_button.png"></div>'
	*p '<div id = "mark_three"><a href = "EXEC: master_stat_screen = 2 & gt $curloc"><img src = "content\pic\buttons\unsel_button.png"></a></div>'
	*p '<div id = "mark_four"><a href = "EXEC: master_stat_screen = 3 & gt $curloc"><img src = "content\pic\buttons\unsel_button.png"></a></div>'
	if ui_style = 2:
		*p '<div id="center_image"><img src = "content\pic\ui\grimdark\bg\page_blank.png"></div>'
	else
		*p '<div id="center_image"><img src = "content\pic\page_blank.png"></div>'
	end

	*p '<div id = "bg_blue_script_right"><br><<$quest_list>></div>'
end

!EQUIP TAB
