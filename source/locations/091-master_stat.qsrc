		*p '<div class="inventory_item"><a style = "color: black;" href = "EXEC: dynamic $master_wpn_list"><u>왼 손</u> : <<$item_name[$master_left_wpn]>></a></div>'
		*p '<div class="inventory_item"><a style = "color: black;" href = "EXEC: dynamic $master_wpn_list_2"><u>오 른 손</u> : <<$item_name[$master_right_wpn]>></a></div>'
		*p '<div class="inventory_item"><a style = "color: black;" href = "EXEC: dynamic $master_wpn_list_small"><u>팔 뚝</u> : <<$item_name[$master_arm_wpn]>></a></div>'
		*p '<div class="inventory_item"><a style = "color: black;" href = "EXEC: dynamic $master_wpn_list_small_2"><u>허 벅 지</u> : <<$item_name[$master_leg_wpn]>></a></div>'
! JO9 MOD END J9M1561
		*p '<br>'
! JO9 MOD START J9M1560 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
		*p '<div class="inventory_item"><a style = "color: black;" href = "EXEC: dynamic $master_cloth_list"><u>평 상 복</u> : <<$item_name[$master_cloth]>></a></div>'
		*p '<div class="inventory_item"><a style = "color: black;" href = "EXEC: dynamic $master_head_list"><u>투 구</u> : <<$item_name[$master_head_gear]>></a></div>'
		*p '<div class="inventory_item"><a style = "color: black;" href = "EXEC: dynamic $master_ears_list"><u>귀 걸 이</u> : <<$item_name[$master_earring]>></a></div>'
