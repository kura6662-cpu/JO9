*nl '<a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>" href="EXEC: msg $master_petting_chart & $info_text = $master_petting_help & gt $curloc"><<$master_petting[master_petting]>> </a><font style="font-size:12px; line-height: 32px;">  애무  </font>'
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'master_oral', master_oral)
*nl '<a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>" href="EXEC: msg $master_oral_chart & $info_text = $master_oral_help & gt $curloc"><<$master_oral[master_oral]>> </a><font style="font-size:12px; line-height: 32px;">  구강  </font>'
