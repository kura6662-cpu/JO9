# $mod_assistant_drop
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2937 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '$mod_assistant_drop': gs 'snk_room_bridge', 'guard', '$mod_assistant_drop'
! JO9 MOD END J9M2937
!Decrease good moodlets of assistant
n = arrsize('$assistant_good_mod')
i = 0
:loop
i += 1
$curmod = $assistant_good_mood[i]
assistant['<<$curmod>>'] -= args
if i < n: jump 'loop'
------------ $mod_assistant_drop ------------
