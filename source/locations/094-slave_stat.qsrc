	if nsfw = 0: *p '<div id="lower_image"><img src = "content\pic\girls\body\<<$slave["pussy_img"]>>.png" width="370"></div>'
	*p '<div id = "stat_text"><center>'
! JO9 MOD START TBV_BEAUTY_FORMULA_slave | 2026-10-17_trait_value
		*p '<<$красота[slave["beauty"]]>> = <<$природная_красота[slave["base_beauty"]]>> + <<$пластика[slave["beauty_enhanced"]]>><<iif(slave[''jo9_peerless''] = 1, '' + 절세미인'', '''')>> - (<<$шрамы[slave["scars"]]>> + <<$синяки[slave["bruises"]]>> + <<$beauty_physique[slave["fat"]]>>)'
! JO9 MOD END TBV_BEAUTY_FORMULA_slave
		*nl '<<$стиль[slave["style"]]>> = <<$wear_st[slave["st_count"]]>> + <<$slave_makeup[slave["makeup"]]>> + <<$hair_style[slave["hairstyle"]]>> + <<$мейкап[slave["makeup_count"]]>> + <<$грация[slave["grace_count"]]>> - <<$гигиена[slave["hygiene"]]>>'
		*nl '<<$экзотика[slave["exotic"]]>> = <<$природная_экзотика[slave["base_exotic"]]>> + <<$slave_tattoo[slave["tattoo"]]>> + <<$пирсинг[slave["piercing_count"]]>> + <<$wear_ex[slave["ex_count"]]>>'
		if auspex = 1:
			*nl '<<$charm_aura[max(0, 5 + charm_from_aura)]>> = <<$charm_moral[slave["moral"]]>> - (<<$charm_angst[slave["angst"]]>> + <<$charm_spoil[slave["spoil"]]>>)'
			*nl '<a href = "EXEC: msg $charm_help"><<$charm_stat>>&nbsp;<img src="content/pic/chart.png"></a> = <<$brand[brand_reputation]>> + <<$girl_fame[slave["fame"]]>> + <<$стиль[slave["style"]]>> + <<$экзотика[slave["exotic"]]>> <<iif(charm_from_aura < 0, "-", "+")>> <<$charm_aura[max(0, 5 + charm_from_aura)]>> <<iif(slave["fat"] ! 1, "-", "+")>> <<$charm_physique[slave["fat"]]>> - <<$шрамы[slave["scars"]]>> - <<$синяки[slave["bruises"]]>>' &! $charm_stat is updated by $slave_price call earlier
		else
			*nl '<font color="black">노예의 오라와 매혹 등급을 보려면 아우스펙스를 시전해야 한다</font>&nbsp;<a href = "EXEC: msg $charm_help & gt $curloc"><img src="content/pic/chart.png"></a>'
		end
	*p '</center></div>'
	*p '<div id = "upper_text">'
		*p '<<$slave_boobs>><<$slave_boobsx>>'
		if slave['lactation'] > 0:
