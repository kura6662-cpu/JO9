# slave_stat
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1573 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'slave_stat': gs 'snk_room_bridge', 'guard', 'slave_stat'
! JO9 MOD END J9M1573
! JO9_UI_V16_READABILITY
!SLAVE STAT SCREEN
gs '$newloc' &! ensure all stats are updated before displaying them

if slave_state = CONST_INT['slave_faint']:
	$info_text = '  <<$slave_name>>는 지쳐서 조용히 신음한다. 상태가 매우 좋지 않아 보인다. 쉬게 하거나, 심하면 의료 처치까지 해 주어야 한다.'
elseif slave_state = CONST_INT['slave_dead']:
	$info_text = '  <<$slave_name>>는 죽었다. 생기 없는 시체가 바닥에 누워 있다.'
elseif $info_text = '':
	dynamic $replace("$info_text = '<<$psy_status[$slave_psy_status]>>'", 'dyn'+'slave', 'slave') &! evaluate delayed sub-expressions with substitution
end

!Fix blank screen bug - crushboss
if slave_state ! CONST_INT['no_slave']:
	if $slave["wpn"] = '': $slave["wpn"] = 'безоружный'
	if $slave["armor"] = '': $slave["armor"] = 'без_брони'
	if $slave["cloth"] = '': $slave["cloth"] = 'голая'
end

stat_importance['stamina'] = 1
stat_importance['sensitivity'] = 1
stat_importance['temper'] = 1
stat_importance['intellect'] = 1
stat_importance['ego'] = 1
stat_importance['exotic'] = 1
stat_importance['fat'] = 1

stat_importance['obedience'] = 1
stat_importance['moral'] = 1
stat_importance['custom'] = 1
stat_importance['instinct'] = 1
stat_importance['rational'] = 1
stat_importance['pride'] = 1
stat_importance['spoil'] = 1

stat_importance['expression'] = 1
stat_importance['pet'] = 1
stat_importance['dressage'] = 1
stat_importance['nurse'] = 1
stat_importance['service'] = 1
stat_importance['cook'] = 1
stat_importance['gladiatrix'] = 1
stat_importance['alchemy'] = 1
stat_importance['enchanter'] = 1
stat_importance['calisthenics'] = 1
stat_importance['art'] = 1
stat_importance['cowSK'] = 1
stat_importance['music'] = 1
stat_importance['secretary'] = 1

stat_importance['oral'] = 1
stat_importance['penetration'] = 1
stat_importance['petting'] = 1
stat_importance['orgy'] = 1
stat_importance['roleplay'] = 1
stat_importance['xenophily'] = 1
stat_importance['fetishism'] = 1
stat_importance['nipplefuck'] = 1
stat_importance['lesbiansex'] = 1

gs '$slave_price'
gs 'stats_layout'

*p '<div id = "bookmark_one">규칙</div>'
*p '<div id = "bookmark_two">신체</div>'
*p '<div id = "bookmark_three">장비</div>'
*p '<div id = "bookmark_four">오라</div>'
! JO9 MOD START J9M1572 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_inventory = 1:
*p '<div id="close"><a href="EXEC: gs ''snk_room_bridge'', ''inventory_close''"><img src="content/pic/buttons/close_button.png"></a></div>'
elseif exam_in_progress = 1:
	*p '<div id = "close"><a href = "EXEC: $equip_choice = '''' & gt ''demo_menu_form''"><img src = "content/pic/buttons/close_button.png"></a></div>'
! JO9 MOD END J9M1572
elseif is_home = 1:
	*p '<div id = "close"><a href = "EXEC: $equip_choice = '''' & gt ''menu_form''"><img src = "content\pic\buttons\close_button.png"></a></div>'
else
	*p '<div id = "close"><a href = "EXEC: $equip_choice = '''' & gt ''city_menu_form''"><img src = "content\pic\buttons\close_button.png"></a></div>'
end

gs '$slave_traits'
gs '$addon_custom_data'
gs '$addon', 'info_box'

!lillimerge add more tooltips?


*p '<div id="left_column"><br>'
*nl '호 칭 : &nbsp<<$slave_name>>'
*nl '연 령 대 : &nbsp;<<$slave_age_name[slave["age"]]>>'
if slave['age_count'] = 1:
	*nl '소 유 일 수 : &nbsp;1 일'
elseif slave['age_count'] < 1000:
	*nl '소 유 일 수 : &nbsp;<<slave["age_count"]>> 일'
else
	*nl '소 유 주 기 : &nbsp;<<slave["age_count"]/10>> 주기'
end
*nl ''
*nl '<a style="font-size:30px" class="tooltip-right" tooltip-data="등급을 올리는 방법" href="EXEC: msg $rating_help"><<$rating[rating]>></a>  노예 속성정보 <a class="tooltip-right" tooltip-data="속성에 대하여" style="color:black" href = "EXEC: msg $rank_help & msg $rank_help_2"><img style="width:15px;height:15px;" src="content/pic/chart.png"></a><br>' 
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'beauty', slave['beauty'], 1)
*nl '<font style="font-size:12px;">외모 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $красота_справка & dynamic $msg, $красота_справка_2 & $info_text = $красота_совет & gt $curloc"><<$beauty[slave["beauty"]]>></a>'
$tooltip_text = func('$addon', 'stat_tooltip_text', 'stamina')
*nl '<font style="font-size:12px;">체력 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $здоровье_справка & dynamic $msg, $здоровье_справка_2 & $info_text = $здоровье_совет & gt $curloc"><<$stamina[slave["stamina"]]>></a>'
$tooltip_text = func('$addon', 'stat_tooltip_text', 'sensitivity')
*nl '<font style="font-size:12px;">감수성 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $чувствительность_справка & dynamic $msg, $чувствительность_справка_2 & $info_text = $чувствительность_совет & gt $curloc"><<$sensitivity[slave["sensitivity"]]>></a><div style="line-height:25%"><br></div>'
$tooltip_text = func('$addon', 'stat_tooltip_text', 'temper')
*nl '<font style="font-size:12px;">성격 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $темперамент_справка & dynamic $msg, $темперамент_справка_2 & $info_text = $темперамент_совет & gt $curloc"><<$temper[slave["temper"]]>></a>'
$tooltip_text = func('$addon', 'stat_tooltip_text', 'intellect')
*nl '<font style="font-size:12px;">지성 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $ум_справка & dynamic $msg, $ум_справка_2 & $info_text = $ум_совет & gt $curloc"><<$intellect[slave["intellect"]]>></a>'
$tooltip_text = func('$addon', 'stat_tooltip_text', 'ego')
*nl '<font style="font-size:12px;">자아 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $характер_справка & dynamic $msg, $характер_справка_2 & $info_text = $характер_совет & gt $curloc"><<$ego[slave["ego"]]>></a><div style="line-height:25%"><br></div>'
$tooltip_text = func('$addon', 'stat_tooltip_text', 'pride', -1)
*nl '<font style="font-size:12px;">태도 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $гордыня_справка & dynamic $msg, $гордыня_справка_2 & $info_text = $гордыня_совет & gt $curloc"><<$pride[slave["pride"]]>></a>'
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'exotic', slave['exotic'], 1)
*nl '<font style="font-size:12px;">독특함 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $экзотичность_справка & dynamic $msg, $экзотичность_справка_2 & $info_text = $экзотичность_совет & gt $curloc"><<$exotic[slave["exotic"]]>></a>'
$tooltip_text = func('$addon', 'physique_tooltip_text', 'fat', slave['fat'])
*nl '<font style="font-size:12px;">체형 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $жыр_справка & dynamic $msg, $жыр_справка_2 & $info_text = $жыр_совет & gt $curloc"><<$fat[slave["fat"]]>></a><div style="line-height:25%"><br></div>'
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'style', slave['style'], 1)
*nl '<font style="font-size:12px;">세련됨 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $стиль_справка & dynamic $msg, $стиль_справка_2 & $info_text = $стиль_совет & gt $curloc"><<$style[slave["style"]]>></a>'
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'fame', slave['fame'], 1)
*nl '<font style="font-size:12px;">인지도 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: dynamic $msg, $слава_справка & dynamic $msg, $слава_справка_2 & $info_text = $слава_совет & gt $curloc"><<$girl_fame[slave["fame"]]>></a>'
$tooltip_text = func('$addon', 'no_rate_full_grade_tooltip_text', 'mood', slave['mood'], 1)
*nl '<font style="font-size:12px;">기분 </font><a class="tooltip-right" tooltip-data="<<$tooltip_text>>" href="EXEC: msg $mood_chart & $info_text = $slave_mood_help & gt $curloc"><<$mood[slave_mood_plus]>></a><div style="line-height:25%"><br></div>'
*p '<div style="line-height:25%"><br></div>노예의 특성<div style="line-height:5%"><br></div><<$slave_features_list>></div>'

!calculation of the food cost (all of this code is unused)
!food_cost = 2
!if slave_ration = -2: food_cost = 1 - slave_ration is never non-zero, so this is always false - ImperatorAugustus
!if slave_ration > -2: food_cost = 2 - slave_ration is never non-zero, so this is always true (therefore set food_cost = 2 above, instead of = 0)
!if slave_ration = 1: food_cost = 5 - slave_ration is never non-zero, so this is always false
!if double_ration = 1: food_cost += food_cost - double_ration is never set, so this is always false
!if enable_dessert = 1: food_cost += 2 - enable_dessert is never non-zero, so this is always false
!if slave["diet_supplements"] = 1: food_cost += 1
!daily_cost = food_cost

if slave_stat_screen = 0:
	*p '<div id = "mark_one"><img src = "content\pic\buttons\sel_button.png"></div>'
	*p '<div id = "mark_two"><a href = "EXEC: slave_stat_screen = 1 & $info_text = '''' & gt $curloc"><img src = "content\pic\buttons\unsel_button.png"></a></div>'
	*p '<div id = "mark_three"><a href = "EXEC: slave_stat_screen = 2 & $info_text = '''' & gt $curloc"><img src = "content\pic\buttons\unsel_button.png"></a></div>'
	*p '<div id = "mark_four"><a href = "EXEC: slave_stat_screen = 3 & $info_text = '''' & gt $curloc"><img src = "content\pic\buttons\unsel_button.png"></a></div>'
	if is_home = 1:
		*p '<div id="center_image"><img src = "content\pic\bg\<<$interior_study[$study]>>.png"></div>'
	else
	  	*p '<div id="center_image"><img src = "content\pic\bg\<<$bg[$place]>>_small.png"></div>'
	end
	if nsfw = 0: *p func('display_fullimage', 'slave', 'center_image', 'psy')
	if presets_list = 0:
		*p '<div style="line-height:71%;font-family:Sandoll 미생;font-size:22px;" id="left_padding"><br>&nbsp&nbsp - 잠자리 -<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp지하 감옥<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp바닥<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp침낭<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp내 침대<br>'
! JO9 MOD START J9M1571 | 2026-10-10_restore_private_room_ui_corrections | changed block; context may be included
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp개인침대<br>'
! JO9 MOD END J9M1571
		*nl '&nbsp&nbsp- 식단 -<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp건조식<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp통조림<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp산란액<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp남은음식<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp보조식품<br>'
		*nl '&nbsp&nbsp- 식사량 조절 -<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp소량<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp보통<br>'
		*nl '&nbsp&nbsp&nbsp&nbsp&nbsp가득<br>'
		if max(master_medic, assistant['nurse']) > 3:
			*nl '&nbsp&nbsp&nbsp&nbsp&nbsp열량 계산식<br>'
		else
			*nl '&nbsp&nbsp&nbsp&nbsp&nbsp조합 영양사<br>'
		end
		if difficulty_setting = 2 or slave['diet_portion'] ! 4:
			*nl '<br>&nbsp&nbsp- 위 식단 총 열량 -'
			*p '<center><<IIF(slave["calories"] > 0, "<br>+", "<br>")>><<slave["calories"]*100>> cal</center>'
		end
		*p '</div>'

	else
		*p '<div style="line-height:71%;font-family:Sandoll 미생;font-size:22px;" id="left_padding"><br>&nbsp&nbsp - 저장 및 설정 -</div>'
		*p '<br><div style="line-height:71%;font-family:Sandoll 미생;font-size:22px;" id="left_rules"><br>'
		*nl '<br><a style = "color: #FFD700;" href = "EXEC: i = 1 & dynamic $name_preset & gt $curloc"><<$preset_name[1]>></a>&nbsp<a style = "color: #FFD700;" href = "EXEC: i = 1 & dynamic $save_preset & gt $curloc">[저장]</a>'
		*nl '<br><a style = "color: #FFD700;" href = "EXEC: i = 2 & dynamic $name_preset & gt $curloc"><<$preset_name[2]>></a>&nbsp<a style = "color: #FFD700;" href = "EXEC: i = 2 & dynamic $save_preset & gt $curloc">[저장]</a>'
		*nl '<br><a style = "color: #FFD700;" href = "EXEC: i = 3 & dynamic $name_preset & gt $curloc"><<$preset_name[3]>></a>&nbsp<a style = "color: #FFD700;" href = "EXEC: i = 3 & dynamic $save_preset & gt $curloc">[저장]</a>'
		*nl '<br><a style = "color: #FFD700;" href = "EXEC: i = 4 & dynamic $name_preset & gt $curloc"><<$preset_name[4]>></a>&nbsp<a style = "color: #FFD700;" href = "EXEC: i = 4 & dynamic $save_preset & gt $curloc">[저장]</a>'
		*nl '<br><a style = "color: #FFD700;" href = "EXEC: i = 5 & dynamic $name_preset & gt $curloc"><<$preset_name[5]>></a>&nbsp<a style = "color: #FFD700;" href = "EXEC: i = 5 & dynamic $save_preset & gt $curloc">[저장]</a><br>'
		*nl '<br><a style = "color: #FFD700;" href = "EXEC: preset = 0 & dynamic $purge_preset & gt $curloc"><br><u>초기화</u></a>&nbsp<a style = "color: #FFD700;" href = "EXEC: dynamic $msg, $presets_help & gt $curloc">[?]</a>'
		*nl '<br><a style = "color: #FFD700;" href = "EXEC: presets_list = 0 & gt $curloc"><u>닫기</u></a></div>'
	end

	*p '<div style="line-height:71%;font-family:Sandoll 미생;" id="right_padding">'
	*nl '<br>식사 준비&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '잡일과 청소 명령&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '목욕 명령&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '펠라 자명종&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '예의 강요&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '펫 강요&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '재갈 물리기&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '육변기 강요&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '소변기 강요&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '절정 금지&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '배변 금지&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '안개 괴물 착정&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '자위 금지&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '바기나 비즈&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp<br>'
	*nl '(보유시)도구 사용&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp</div>'
		if $slave['rules_explanations'] ! '':
			if slave['rules_broken'] = 0:
				*nl '<div id = "chekbox_15r" style="display:block">'
				*p '<a class="tooltip-left-down" tooltip-data="규칙을 잘 따르고 있다." href="EXEC: dynamic $msgsmallfont, $slave[''rules_explanations'']"><<$rules_obedience[slave["rules_broken"]]>></a></div>'
			elseif slave['rules_broken'] = 1:
				*nl '<div id = "chekbox_15r" style="display:block">'
				*p '<a class="tooltip-left-down" tooltip-data="주인에게 대항한다!" href="EXEC: dynamic $msgsmallfont, $slave[''rules_explanations'']"><<$rules_obedience[slave["rules_broken"]]>></a></div>'
			end
		else
			*nl '<div id = "chekbox_15r" style="color:white;display:block;">'
			*p '  규칙 설정 가능<a class="tooltip-bottom" tooltip-data="노예의 조교 방향을 생각해보자."></a></div>'
		end
		*nl '<div id = "chekbox_16r"><a style="color: #FFD700;" href = "EXEC: presets_list = 1 & gt $curloc"><br><u>사용중인 규칙 목록화</u>&nbsp&nbsp&nbsp</a></div>'
	if presets_list = 0:
		if dungeon > 0:
			if slave["sleep_condition"] = -2:
				*p '<div id="chekbox_1l"><img src="content\pic\buttons\sel_button.png"></div>'
			else
				*p '<div id="chekbox_1l"><a href = "EXEC: slave[''sleep_condition''] = -2 & $info_text = $slave_sleep_condition[1] & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
			end
		else
			*p '<div id="chekbox_1l"><a href = "EXEC: dynamic $msg, $no_dungeon & gt $curloc"><img src="content\pic\buttons\unactive_button.png"></a></div>'
		end
		if slave["sleep_condition"] = -1:
			*p '<div id="chekbox_2l"><img src="content\pic\buttons\sel_button.png"></div>'
		else
			*p '<div id="chekbox_2l"><a href = "EXEC: slave[''sleep_condition''] = -1 & $info_text = $slave_sleep_condition[2] & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
		end
		if slave["sleep_condition"] = 0:
			*p '<div id="chekbox_3l"><img src="content\pic\buttons\sel_button.png"></div>'
		else
			*p '<div id="chekbox_3l"><a href = "EXEC: slave[''sleep_condition''] = 0 & $info_text = $slave_sleep_condition[3] & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
		end
		if slave["sleep_condition"] = 1:
			*p '<div id="chekbox_4l"><img src="content\pic\buttons\sel_button.png"></div>'
		else
			*p '<div id="chekbox_4l"><a href = "EXEC: slave[''sleep_condition''] = 1 & $info_text = $slave_sleep_condition[4] & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
		end
		if boudoir > 0:
			if slave["sleep_condition"] = 2:
				*p '<div id="chekbox_5l"><img src="content\pic\buttons\sel_button.png"></div>'
			else
				*p '<div id="chekbox_5l"><a href = "EXEC: slave[''sleep_condition''] = 2 & $info_text = $slave_sleep_condition[5] & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
			end
		else
			*p '<div id="chekbox_5l"><a href = "EXEC: dynamic $msg, $no_boudoir & gt $curloc"><img src="content\pic\buttons\unactive_button.png"></a></div>'
		end
		if slave["diet_food_type"] = 0:
			*p '<div id="chekbox_6l"><a href = "EXEC: slave[''diet_food_type''] = -1 & slave[''diet_portion''] = 0 & $info_text = $slave_no_food & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
		else
			*p '<div id="chekbox_6l"><a href = "EXEC: slave[''diet_food_type''] = 0 & $info_text = $slave_dry_food & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
		end
		if slave["diet_food_type"] = 1:
			*p '<div id="chekbox_7l"><a href = "EXEC: slave[''diet_food_type''] = -1 & slave[''diet_portion''] = 0 & $info_text = $slave_no_food & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
		else
			*p '<div id="chekbox_7l"><a href = "EXEC: slave[''diet_food_type''] = 1 & $info_text = $slave_cane_food & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
		end
		if spawn_semen < 5 and kitchen = 0 and exam_in_progress = 0:
			! made this available outside the Slums and tutorial, because if he has a kitchen (stasis chamber) he can buy and store even if he does not have a fiend of his own - ImperatorAugustus
			*p '<div id="chekbox_8l"><a href = "EXEC: dynamic $msg, $no_spawn_semen & gt $curloc"><img src="content\pic\buttons\unactive_button.png"></a></div>'
		elseif slave["diet_food_type"] = 2:
			*p '<div id="chekbox_8l"><a href = "EXEC: slave[''diet_food_type''] = -1 & slave[''diet_portion''] = 0 & $info_text = $slave_no_food & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
		else
			*p '<div id="chekbox_8l"><a href = "EXEC: slave[''diet_food_type''] = 2 & $info_text = $slave_semen_food & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
