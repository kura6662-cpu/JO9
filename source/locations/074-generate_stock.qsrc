# generate_stock
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2854 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'generate_stock': gs 'snk_room_bridge', 'guard', 'generate_stock'
! JO9 MOD END J9M2854
!Generate new stock/slave
!Overhauled by crushboss

dynamic $clear_slave_instance, 'stock' &! clear any previous stock - ImperatorAugustus
stock_state = CONST_INT['slave_exist'] &! this is the only place in the game where this state change occurs for stock - ImperatorAugustus

$stock_features_list = ''

$stock_epithet = '값이 싼'
$stock_occupation_auk = '소녀'
$stock_world_auk = '수수께끼 같은 세계'
$stock_family_auk = '고아'

if special_stock > 0:
	!OPTIONAL OVERRIDE TO USE A SPECIFIC PRESET FROM JSON FILES (IT IS RECOMMENDED TO USE NUMBERS AFTER milf_last TO AVOID CHANCE OF RANDOM GENERATION)
	stock_type = special_stock
else
	!NO TYPE OVERRIDE
	!OPTIONAL OVERRIDES FOR AGE
	if $special_age ! '':
		seed_age = age_code[$special_age]
		if seed_age = CONST_INT['loli_age']: meta_type = 1
		if seed_age = CONST_INT['young_age']: meta_type = 2
		if seed_age = CONST_INT['milf_age']: meta_type = 3
		killvar '$special_age'
	elseif cheat_e = 1 and no_loli ! 1:
		meta_type = 1
		cheat_f = 0
		cheat_g = 0
	elseif cheat_f = 1:
		meta_type = 2
		cheat_e = 0
		cheat_g = 0
	elseif cheat_g = 1 and no_milf ! 1:
		meta_type = 3
		cheat_e = 0
		cheat_f = 0
	else
		!RANDOM AGE
		:loop_meta
			meta_type = rand(1,5)
			if meta_type = 4: meta_type = 2
			if meta_type = 5: meta_type = 3
		if no_loli = 1 and meta_type = 1: jump 'loop_meta'
		if no_milf = 1 and meta_type = 3: jump 'loop_meta'
	end

	!SELECT A RANDOM UNIQUE (PREVIOUSLY UNUSED) TYPE, OF APPROPRIATE AGE, FROM JSON FILES
	:loop_type
		if meta_type = 1: stock_type = rand(loli_first, loli_last)
		if meta_type = 2: stock_type = rand(young_first, young_last)
		if meta_type = 3: stock_type = rand(milf_first, milf_last)

		!Keeps track of slaves you’ve already had and doesn’t allow duplicates - crushboss
		!Reset num_count to avoid infinite loop, when there are no more new slaves
		if num_count >= 88:
			killvar 'num_count'
			killvar 'prev_num_type'
			num_count = 0
			prev_num_type = 0
		end
	for i = 0 to num_count step 1: if stock_type = prev_num_type[i]: jump 'loop_type'

	prev_num_type[num_count] = stock_type &! record that we have used this type
	num_count += 1 &! increment total number of unique types used
end &! AGE AND TYPE ARE NOW SET

!LOAD PRESET CHARACTERISTICS (must do this first to avoid overwriting)
gs 'get_stock_seed'

! OPTIONAL OVERRIDE FOR AGE IN COMBINATION WITH special_stock TYPE OVERRIDE
if special_stock > 0 and $special_age ! '': stock['age'] = age_code[$special_age]
killvar '$special_age'

!ROLL BASE STATS NOT ALREADY PRESET (3 in 15 chance for any stat to remain zero)
stat_count = arrsize('$stockatr')
attribute_sum = 12 &! do not overwrite non-zero stats from get_stock_seed on first pass - ImperatorAugustus
i = 0
!Slaves can now no longer generate with stats less than one. Prevents Farid from selling slaves with F- beauty and similar. -RedGreen3
:loop
	dynamic "
		if <<$stockatr[i]>> = 0 or attribute_sum < 12:
			gen = rand(1,12) &! 3 out of 15 chance to leave unchanged - ImperatorAugustus
			if gen = 12:
				<<$stockatr[i]>> = 5
			elseif gen > 10:
				<<$stockatr[i]>> = 4
			elseif gen > 6:
				<<$stockatr[i]>> = 3
			elseif gen > 3:
				<<$stockatr[i]>> = 2
			elseif gen > 0:
				<<$stockatr[i]>> = 1
			end
		end
	"
    if $stockatr[i] = 0:
        $stockatr[i] = 1
    end
	
	i += 1
if i < stat_count: jump 'loop'


!Farid will no longer sell mindbroken, dying, or ugly slaves. - RedGreen3

!Added code to avoid having slaves with all bottomed out stats - crushboss (fixed, level 5 rolls were being overwritten - ImperatorAugustus)
attribute_sum = stock['stamina'] + stock['beauty'] + stock['sensitivity'] + stock['intellect'] + stock['temper'] + stock['ego']
if attribute_sum < 12:
	i = 0
	jump 'loop'
end

!TRANSLATE PRESET BEAUTY TO RATE (backgrounds can modify beauty rate)
if stock['beauty'] = 0: stock_rate['beauty'] = 0
if stock['beauty'] = 1: stock_rate['beauty'] = 10
if stock['beauty'] = 2: stock_rate['beauty'] = 20
if stock['beauty'] = 3: stock_rate['beauty'] = 40
if stock['beauty'] = 4: stock_rate['beauty'] = 80
if stock['beauty'] = 5: stock_rate['beauty'] = 160

!TRANSLATE PRESET EXOTICISM TO RATE (backgrounds can modify exotic rate)
if stock['exotic'] = 0: stock_rate['exotic'] = 0
if stock['exotic'] = 1: stock_rate['exotic'] = 10
if stock['exotic'] = 2: stock_rate['exotic'] = 20
if stock['exotic'] = 3: stock_rate['exotic'] = 40
if stock['exotic'] = 4: stock_rate['exotic'] = 80
if stock['exotic'] = 5: stock_rate['exotic'] = 160

!TRANSLATE PRESET WOUNDS TO RATE (backgrounds can modify wounds rate)
if stock['wounds'] = 0: stock_rate['wounds'] = 0
if stock['wounds'] = 1: stock_rate['wounds'] = 10
if stock['wounds'] = 2: stock_rate['wounds'] = 20
if stock['wounds'] = 3: stock_rate['wounds'] = 40
if stock['wounds'] = 4: stock_rate['wounds'] = 80
if stock['wounds'] = 5: stock_rate['wounds'] = 160

!TRANSLATE PRESET BRUISES TO RATE (backgrounds can modify bruises rate)
if stock['bruises'] = 0: stock_rate['bruises'] = 0
if stock['bruises'] = 1: stock_rate['bruises'] = 10
if stock['bruises'] = 2: stock_rate['bruises'] = 20
if stock['bruises'] = 3: stock_rate['bruises'] = 40
if stock['bruises'] = 4: stock_rate['bruises'] = 80
if stock['bruises'] = 5: stock_rate['bruises'] = 160

!TRANSLATE PRESET SCARS TO RATE (backgrounds can modify scars rate)
if stock['scars'] = 0: stock_rate['scars'] = 0
if stock['scars'] = 1: stock_rate['scars'] = 10
if stock['scars'] = 2: stock_rate['scars'] = 20
if stock['scars'] = 3: stock_rate['scars'] = 40
if stock['scars'] = 4: stock_rate['scars'] = 80
if stock['scars'] = 5: stock_rate['scars'] = 160

!TRANSLATE PRESET HYGIENE TO RATE (backgrounds can modify hygiene rate)
if stock['hygiene'] = 0: stock_rate['hygiene'] = 0
if stock['hygiene'] = 1: stock_rate['hygiene'] = 10
if stock['hygiene'] = 2: stock_rate['hygiene'] = 20
if stock['hygiene'] = 3: stock_rate['hygiene'] = 40
if stock['hygiene'] = 4: stock_rate['hygiene'] = 80
if stock['hygiene'] = 5: stock_rate['hygiene'] = 160

!CREATING RANDOM BACKGROUND IF NOT PRESET
if $stock_world_description = '':
	! -1, т.к. нет нулевого элемента в списке, далее та же фигня
	chance = rand(1, arrsize('$origin_world') - 1)
	$stock_world = $origin_world[chance]
	chance = rand(1,3)
	dynamic "$stock_world_description = $<<$stock_world>>_description[chance]"
end

if $stock_world = 'prehistoric':
	$namebase = 'prehistoric'
	stock["nation_index"] = 1
	stock["world_index"] = 5
	$stock_world_auk = '선사 시대의 세계'
	stock_rate['exotic'] += 10
	if stock['stamina'] < 5: stock['stamina'] += 1
	if stock['temper'] < 5: stock['temper'] += 1
	if stock['ego'] > 1: stock['ego'] -= 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
elseif $stock_world = 'barbarian':
	$namebase = 'barbarian'
	stock["nation_index"] = 2
	stock["world_index"] = 5
	$stock_world_auk = '야만의 세계'
	if stock['stamina'] < 5: stock['stamina'] += 1
	if stock['temper'] < 5: stock['temper'] += 1
	if stock['ego'] > 1: stock['ego'] -= 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
elseif $stock_world = 'sns':
	$namebase = 'barbarian'
	stock["nation_index"] = 2
	stock["world_index"] = 4
	$stock_world_auk = '힘과 마법의 세계'
	if stock['stamina'] < 5: stock['stamina'] += 1
	if stock['ego'] > 1: stock['ego'] -= 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
elseif $stock_world = 'medieval':
	$namebase = 'medieval'
	stock["nation_index"] = 3
	stock["world_index"] = 4
	$stock_world_auk = '전통적인 농경 세계'
	if stock['temper'] < 5: stock['temper'] -= 1
	if stock['ego'] > 1: stock['ego'] -= 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
	if stock['custom'] < 4: stock['custom'] += 1
elseif $stock_world = 'highfantasy':
	nc = rand(1,2)
	if nc = 1:
		$namebase = 'medieval'
		stock["nation_index"] = 3
	else
		$namebase = 'fantasy'
		stock["nation_index"] = 8
	end
	stock["world_index"] = 4
	$stock_world_auk = '마법의 세계'
	if stock['sensitivity'] < 5: stock['sensitivity'] += 1
	stock_rate['exotic'] += 10
elseif $stock_world = 'darkfantasy':
	nc = rand(1,2)
	if nc = 1:
		$namebase = 'medieval'
		stock["nation_index"] = 3
	else
		$namebase = 'barbarian'
		stock["nation_index"] = 2
	end
	stock["world_index"] = 4
	$stock_world_auk = '흑마법의 세계'
	if stock['stamina'] > 1: stock['stamina'] -= 1
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['ego'] > 1: stock['ego'] -= 1
	if stock['sensitivity'] > 1: stock['sensitivity'] -= 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
	if stock['pride'] > 1: stock['pride'] -= 1
	stock_rate['exotic'] += 10
	if stock['custom'] < 4: stock['custom'] += 2
elseif $stock_world = 'steampunk':
	$namebase = 'oldscool'
	stock["nation_index"] = 4
	stock["world_index"] = 3
	$stock_world_auk = '스팀펑크 세계'
	if stock['custom'] < 4: stock['custom'] += 1
elseif $stock_world = 'industrial':
	nc = rand(1,2)
	if nc = 1:
		$namebase = 'oldscool'
		stock["nation_index"] = 4
	else
		$namebase = 'euro'
		stock["nation_index"] = 5
	end
	stock["world_index"] = 3
	$stock_world_auk = '산업이 발달한 세계'
	if stock['custom'] < 4: stock['custom'] += 1
elseif $stock_world = 'modern':
	nc = rand(1,2)
	if nc = 1:
		$namebase = 'russian'
		stock["nation_index"] = 6
	else
		$namebase = 'euro'
		stock["nation_index"] = 5
	end
	stock["world_index"] = 2
	$stock_world_auk = '경제적으로 발전한 세계'
	if stock['ego'] < 5: stock['ego'] += 1
	if stock['pride'] < 5: stock['pride'] += 1
	if stock['intellect'] < 5: stock['intellect'] += 1
	if stock['stamina'] > 1: stock['stamina'] -= 1
elseif $stock_world = 'cyberpunk':
	nc = rand(1,2)
	if nc = 1:
		$namebase = 'russian'
		stock["nation_index"] = 6
	else
		$namebase = 'euro'
		stock["nation_index"] = 5
	end
	stock["world_index"] = 1
	$stock_world_auk = '사이버펑크 세계'
	if stock['ego'] < 5: stock['ego'] += 1
	if stock['intellect'] < 5: stock['intellect'] += 1
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['stamina'] > 1: stock['stamina'] -= 1
elseif $stock_world = 'utopia':
	$namebase = 'utopia'
	stock["nation_index"] = 7
	stock["world_index"] = 1
	$stock_world_auk = '목가적인 유토피아'
	if stock['spoil'] < 5: stock['spoil'] += 1
	if stock['intellect'] < 5: stock['intellect'] += 1
	stock_rate['exotic'] += 10
	if stock['sensitivity'] < 4: stock['sensitivity'] += 2
	if stock['pride'] < 5: stock['pride'] += 1
elseif $stock_world = 'darkfuture':
	$namebase = 'euro'
	stock["nation_index"] = 5
	stock["world_index"] = 2
	$stock_world_auk = '전체주의 국가'
	if stock['stamina'] > 1: stock['stamina'] -= 1
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['intellect'] < 5: stock['intellect'] += 1
	if stock['custom'] < 4: stock['custom'] += 2
	if stock['temper'] > 2: stock['temper'] -= 2
	if stock['ego'] > 2: stock['ego'] -= 2
	if stock['sensitivity'] > 1: stock['sensitivity'] -= 1
	if stock['pride'] > 1: stock['pride'] = 1
	if stock['fat'] > 1: stock['fat'] = 1
elseif $stock_world = 'space':
	nc = rand(1,2)
	if nc = 1:
		$namebase = 'utopia'
		stock["nation_index"] = 7
	else 
		$namebase = 'euro'
		stock["nation_index"] = 5
	end
	stock["world_index"] = 1
	$stock_world_auk = '고도로 발달한 우주 문명'
	if stock['stamina'] > 1: stock['stamina'] -= 1
	if stock['intellect'] < 5: stock['intellect'] += 1
	stock_rate['exotic'] += 10
	if stock['ego'] < 5: stock['ego'] += 1
	if stock['pride'] < 5: stock['pride'] += 1
end

!NAME (AFTER PICKING NAMEBASE)
if $stock_name = '':
	chance = rand(1, arrsize('$<<$namebase>>_name') - 1)
	dynamic "$stock_name = $<<$namebase>>_name[chance]"
end

!FAMILY BACKGROUND (AFTER PICKING WORLD)
if $stock_family_description = '':
	chance = rand(1, arrsize('$<<$stock_world>>_family') - 1)
	dynamic "$stock_family = $<<$stock_world>>_family[chance]"
	$stock_family_description = $family_description[$stock_family]
end

if $stock_family = 'tribe':
	stock["family_index"] = 5
	$stock_family_auk = '야만 부족에서 자란'
	if stock['stamina'] < 5: stock['stamina'] += 1
	if stock['sensitivity'] > 1: stock['sensitivity'] -= 1
elseif $stock_family = 'amazon':
	stock["family_index"] = 5
	$stock_family_auk = '용감한 아마존들에게 길러진'
	if stock['stamina'] < 5: stock['stamina'] += 1
	if stock['temper'] < 5: stock['temper'] += 1
	if stock['ego'] < 5: stock['ego'] += 1
	if stock['pride'] < 5: stock['pride'] += 1
	if stock['sensitivity'] > 1: stock['sensitivity'] -= 1
elseif $stock_family = 'nomad':
	stock["family_index"] = 5
	$stock_family_auk = '유목민에게 길러진'
	if stock['stamina'] < 5: stock['stamina'] += 1
elseif $stock_family = 'pesant':
	stock["family_index"] = 4
	$stock_family_auk = '농부의 딸'
	if stock['stamina'] < 3: stock['stamina'] += 1
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['ego'] > 1: stock['ego'] -= 1
	if stock['sensitivity'] > 1: stock['sensitivity'] -= 1
	if stock['custom'] < 3: stock['custom'] += 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
	if stock['sensitivity'] > 1: stock['sensitivity'] -= 1
elseif $stock_family = 'hunter':
	stock["family_index"] = 4
	if stock['temper'] < 4: stock['temper'] += 1
	if stock['stamina'] < 5: stock['stamina'] += 1
	if stock['intellect'] < 3: stock['intellect'] += 1
	$stock_family_auk = '사냥꾼의 딸'
elseif $stock_family = 'fisher':
	stock["family_index"] = 4
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['custom'] < 3: stock['custom'] += 1
	$stock_family_auk = '어부의 딸'
elseif $stock_family = 'viking':
	stock["family_index"] = 3
	if stock['temper'] < 5: stock['temper'] += 1
	if stock['pride'] < 5: stock['pride'] += 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
	if stock['sensitivity'] > 1: stock['sensitivity'] -= 1
	$stock_family_auk = '바다 약탈자의 딸'
elseif $stock_family = 'barbarian_king':
	stock["family_index"] = 1
	if stock['temper'] < 5: stock['temper'] += 1
	if stock['ego'] < 5: stock['ego'] += 1
	if stock['pride'] < 5: stock['pride'] += 1
	if stock['spoil'] < 4: stock['spoil'] += 2
	if stock['custom'] > 0: stock['custom'] = 0
	$stock_family_auk = '야만족 공주'
	$stock_occupation_auk = '귀부인'
elseif $stock_family = 'orphan':
	stock["family_index"] = 5
	if stock['stamina'] > 1: stock['stamina'] -= 1
	if stock['temper'] < 5: stock['temper'] += 1
	if stock['pride'] > 1: stock['pride'] -= 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
	$stock_family_auk = '고아'
elseif $stock_family = 'bondman':
	stock["family_index"] = 4
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['ego'] > 1: stock['ego'] -= 1
	if stock['sensitivity'] > 1: stock['sensitivity'] -= 1
	if stock['custom'] < 3: stock['custom'] += 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
	if stock['sensitivity'] > 1: stock['sensitivity'] -= 1
	$stock_family_auk = '농노 농가의 딸'
elseif $stock_family = 'gypsy':
	stock["family_index"] = 5
	stock_rate['exotic'] += 10
	if stock['temper'] < 5: stock['temper'] += 1
	$stock_family_auk = '집시 야영지에서 자란'
elseif $stock_family = 'church':
	stock["family_index"] = 5
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['ego'] > 1: stock['ego'] -= 1
	if stock['intellect'] < 3: stock['intellect'] += 1
	if stock['custom'] < 4: stock['custom'] += 1
	$stock_family_auk = '교회 고아원의 학생'
elseif $stock_family = 'craftsman':
	stock["family_index"] = 3
	$stock_family_auk = '장인의 딸'
elseif $stock_family = 'merchant':
	stock["family_index"] = 3
	if stock['spoil'] < 5: stock['spoil'] += 1
	$stock_family_auk = '상인의 딸'
elseif $stock_family = 'valetry':
	stock["family_index"] = 4
	if stock['custom'] < 4: stock['custom'] += 2
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['ego'] > 1: stock['ego'] -= 1
	$stock_family_auk = '하녀의 딸'
elseif $stock_family = 'knight':
	stock["family_index"] = 2
	if stock['spoil'] < 5: stock['spoil'] += 1
	if stock['ego'] < 5: stock['ego'] += 1
	if stock['pride'] < 5: stock['pride'] += 1
	if stock['sensitivity'] < 5: stock['sensitivity'] += 1
	$stock_family_auk = '영지를 가진 봉건 영주의 딸'
elseif $stock_family = 'mprincess':
	stock["family_index"] = 1
	if stock['temper'] < 5: stock['temper'] += 1
	if stock['ego'] < 5: stock['ego'] += 1
	if stock['pride'] < 5: stock['pride'] += 1
	if stock['spoil'] < 4: stock['spoil'] += 2
	if stock['custom'] > 0: stock['custom'] = 0
	$stock_family_auk = '공주'
elseif $stock_family = 'farmers':
	stock["family_index"] = 3
	if stock['stamina'] < 5: stock['stamina'] += 1
	if stock['intellect'] > 1: stock['intellect'] -= 1
	if stock['pride'] > 1: stock['pride'] -= 1
	if stock['custom'] < 5: stock['custom'] += 1
	$stock_family_auk = '농부의 딸'
elseif $stock_family = 'workhouse':
	stock["family_index"] = 5
	if stock['stamina'] > 1: stock['stamina'] -= 1
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['ego'] > 1: stock['ego'] -= 1
	if stock['pride'] > 2: stock['pride'] -= 2
