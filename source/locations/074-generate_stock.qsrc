elseif $stock_family = 'proletarian':
	stock["family_index"] = 4
	if stock['stamina'] > 1: stock['stamina'] -= 1
	if stock['pride'] > 1: stock['pride'] -= 1
	$stock_family_auk = '공장 노동자의 딸'
elseif $stock_family = 'clerk':
	stock["family_index"] = 3
	if stock['intellect'] < 4: stock['intellect'] += 1
	$stock_family_auk = '사무원의 딸'
elseif $stock_family = 'naturalist':
	stock["family_index"] = 3
	if stock['intellect'] < 5: stock['intellect'] += 1
	$stock_family_auk = '과학자 겸 박물학자의 딸'
elseif $stock_family = 'ingeneer':
	stock["family_index"] = 3
	if stock['intellect'] < 5: stock['intellect'] += 1
	$stock_family_auk = '기술자의 딸'
elseif $stock_family = 'doctor':
	stock["family_index"] = 3
	if stock['stamina'] < 5: stock['stamina'] += 1
	if stock['intellect'] < 5: stock['intellect'] += 1
	$stock_family_auk = '유명한 의사의 딸'
elseif $stock_family = 'servant':
	stock["family_index"] = 3
	if stock['custom'] < 4: stock['custom'] += 2
	if stock['temper'] > 1: stock['temper'] -= 1
	if stock['ego'] > 1: stock['ego'] -= 1
	$stock_family_auk = '부잣집 하인의 딸'
elseif $stock_family = 'magnat':
	stock["family_index"] = 2
	if stock['spoil'] < 5: stock['spoil'] += 1
	if stock['ego'] < 5: stock['ego'] += 1
	if stock['pride'] < 5: stock['pride'] += 1
	if stock['sensitivity'] < 5: stock['sensitivity'] += 1
	$stock_family_auk = '거물의 집안에서 자란'
elseif $stock_family = 'bankeer':
	stock["family_index"] = 2
	if stock['spoil'] < 5: stock['spoil'] += 1
	if stock['ego'] < 5: stock['ego'] += 1
	if stock['pride'] < 5: stock['pride'] += 1
	if stock['sensitivity'] < 5: stock['sensitivity'] += 1
	$stock_family_auk = '부유한 은행가의 딸'
elseif $stock_family = 'mayor':
