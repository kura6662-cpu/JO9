# hero_customization_woman
! Readable view; authoritative fields are in ../locations.json.
if snk_room_target > 0 and $curloc = 'hero_customization_woman': gs 'snk_room_bridge', 'guard', 'hero_customization_woman'
! JO9 MOD START J9M3017 | 2026-10-14_hide_outer_frame_on_startup | changed block; context may be included
*p '<style id="jo9_startup_no_outer_frame">body:before,body:after{display:none!important;}</style>'
! JO9 MOD END J9M3017
get_initial_slave = 1
