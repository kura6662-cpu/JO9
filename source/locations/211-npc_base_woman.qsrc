$npc_alignment['bishop_porter'] = 'serpis'
$npc_info['bishop_porter'] = '   Функция архиепископа не вполне религиозна, это просто дань традиции. Преподобная Портер отвечает за работу храмов Дома, которые ежедневно проводят сакральные ритуалы, сжигая Искры и тем самым защищая земли Дома от наступления Туманов.'
demand_rating['bishop_porter'] = 8
