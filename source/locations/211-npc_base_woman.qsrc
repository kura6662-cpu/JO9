$tiamath_pref[1] = '  [ТИАМАТ]
   - ВИДИШЬ ЭТО СИЯЮЩЕЕ ДИТЯ, ЖЕНЩИНА? ОН МОЙ НАСЛЕДНИК, НАДЕЖДА ДОМА В ГРЯДУЩИХ ТЫСЯЧЕЛЕТИЯХ. ТАКОЙ УЯЗВИМЫЙ СЕЙЧАС, НО ПОД МОЕЙ ЗАЩИТОЙ ОН ВЫРАСТЕТ САМЫМ СИЛЬНЫМ СУЩЕСТВОМ В ЭТОМ ГРЯЗНОМ ГОРОДЕ.'
$tiamath_pref[2] = '  [ТИАМАТ]
   - У НЕГО, ТЕМ НЕ МЕНЕЕ, ЕСТЬ ПРОБЛЕМА. ОН НЕ РАЗЛИЧАЕТ ВЫСШИХ И НИЗШИХ. ДОБРОТА СДЕЛАЕТ ЕГО УЯЗВИМЫМ. ЕМУ НАДО ПРИВЫКАТЬ ПОВЕЛЕВАТЬ МЕНЬШИМИ СУЩЕСТВАМИ, ПОДОБНЫМИ ТЕБЕ.'
$tiamath_pref[3] = '  [ТИАМАТ]
   - ВОСПИТАЙ ДЛЯ НЕГО ЧЕЛОВЕЧЕСКУЮ САМКУ. ПОДГОТОВЬ ЕЁ ХОРОШО, ПУСТЬ ОНА БУДЕТ ВЕРНА СВОЕМУ ХОЗЯИНУ ПРЕВЫШЕ ВСЕГО. ОНА ДОЛЖНА УМЕТЬ ОСТРО <font color="#008000"><b>ЧУВСТВОВАТЬ</b></font> БОЛЬ И ПЕЧАЛЬ.'
$tiamath_pref[4] = '  [ТИАМАТ]
   - ДОЛЖНА УХАЖИВАТЬ ЗА НИМ, <font color="#008080"><b>ПРИБИРАТЬ</b></font>, <font color="#008080"><b>ЛЕЧИТЬ</b></font> И <font color="#008080"><b>ПЕТЬ</b></font> ЕМУ КОЛЫБЕЛЬНЫЕ. ЕСЛИ ОН ЗАХОЧЕТ <font color="#0000CD"><b>ОВЛАДЕТЬ</b></font> ЕЙ, ОНА ДОЛЖНА БЫТЬ ГОТОВА И К ЭТОМУ.'
$tiamath_pref[5] = '  [ТИАМАТ]
   - НО САМОЕ ГЛАВНОЕ - ОНА ДОЛЖНА ИДЕАЛЬНО ИСПОЛНЯТЬ <font color="#008000"><b>РОЛЬ ЖИВОТНОГО</b></font>. МОЙ НАСЛЕДНИК ДОЛЖЕН ВЫУЧИТЬ ЧЕГО СТОЯТ ЛЮДИ И НЕ ОШИБАТЬСЯ, ПЫТАЯСЬ ОБЩАТЬСЯ НА РАВНЫХ. ИДИ. ТЫ СЛЫШАЛА МОЮ ВОЛЮ.'
$buy_quote['tiamath'] = '   [ТИАМАТ]
   - ДА. ЭТА ПОДОЙДЁТ. ТЫ ПОЛУЧИШЬ СВОИ ДЕНЬГИ У КАЗНАЧЕЯ, ЖЕНЩИНА.'
