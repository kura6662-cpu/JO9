demand['virginity'] = 1
}
$bishop_porter_pref[1] = '  [Архиепископ Портер]
   - Я не солдат, но работа у меня, тем не менее, опасная, <<$master_name>>. Архиепископ слишком важен для дома, чтобы рисковать. Случись что со мной, и Туманы поглотят половину наших территорий.'
$bishop_porter_pref[2] = '  [Архиепископ Портер]
   - Поэтому я часто использую двойников, чтобы запутать убийц которые покушаются на меня. Требования высокие, так что здесь нужен кто-то опытный, вроде тебя, чтобы подготовить девушку.'
$bishop_porter_pref[3] = '  [Архиепископ Портер]
   - В первую очередь она должна быть мастером перевоплощения и блестяще владеть <font color="#008000"><b>этикетом общения</b></font>. Чтобы сойти за меня рабыня должна непременно быть <font color="#0000CD"><b>умной</b></font> и с <font color="#0000CD"><b>твёрдым характером</b></font>.'
$bishop_porter_pref[4] = '  [Архиепископ Портер]
   - Конечно она так же должна не быть слишком юной и в целом обладать сходным со мной телосложением. И ещё одно... не покушайся на её невинность. Я не хочу, чтобы мужчина осквернял мою свиту.'
$bishop_porter_pref[5] = '  [Архиепископ Портер]
   - У девушек свои удовольствия, нежные и чувственные. Недоступные грубым самцам. Но если ты профессионалка как говорят, то сможешь научить её владеть <font color="#008080"><b>руками</b></font> и <font color="#008080"><b>язычком</b></font> в должной степени.'
$buy_quote['bishop_porter'] = '   [Архиепископ Портер]
   - На первый взгляд не так уж и похоже, но верный макияж, парик и правильная одежда сделают своё дело. Главное что она хорошо обучена. Я довольна, <<$master_name>>. Ты получишь свои искры.'
$refuse_skill_quote['bishop_porter'] = '   [Архиепископ Портер]
   - Мне казалось, я достаточно точно выразила свои пожелания, разве нет? Я не собираюсь платить за неумеху. Плохой двойник для меня может означать смерть. Эта не подходит.'
$refuse_level_quote['bishop_porter'] = '   [Архиепископ Портер]
   - Мне нужна рабыня определенного уровня, <<$master_name>>. Я не собираюсь переплачивать, не держи меня за дуру. Возвращайся когда она будет действительно безупречна и получишь свои искры.'
$refuse_charm_quote['bishop_porter'] = '   [Архиепископ Портер]
   - Нет, нет. Она же совсем иначе движется, по-другому держится. Никогда за меня не сойдёт, сколько грима не накладывай. Я не возьму, её. Найди мне что-то получше, <<$master_name>>.'
$refuse_health_quote['bishop_porter'] = '   [Архиепископ Портер]
   - Посмотри на меня, <<$master_name>>, неужели я выгляжу так же болезно и беспомощно, как и эта твоя рабыня?!'
$refuse_pregnant_quote['bishop_porter'] = '   [Архиепископ Портер]
   - <<$master_name>>, я была о тебе лучшего мнения. Я просила всего-то невиную и похожую на меня рабыню, а ты мне приводишь... Брюхатую девку. Просто уходи и попробуй потом об этом поразмыслить.'
$refuse_special_quote['bishop_porter'] = '   [Архиепископ Портер]
   - Такая мне не нужна. Разве так сложно запомнить особые требования? Не возьму. Пошла вон.'
