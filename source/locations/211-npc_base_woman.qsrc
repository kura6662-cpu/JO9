demand['virginity'] = 1
}
$bishop_shaitana_pref[1] = '  [ШАЙТАНА]
   - А, <<$master_name>>, проходи, садись. Знаешь ли ты, каких усилий стоит нам держать Туманы в узде и расширять владения Дома? Эти ритуалы требуют искр, да. Но не меньше они требуют и мастерства исполнения.'
$bishop_shaitana_pref[2] = '  [ШАЙТАНА]
   - Мне приходится самой подбирать храмовых дев и требования высокие, так что я готова хорошо заплатить за помощь. В наших ритуалах должна участвовать девственница, ещё не вошедшая в возраст любви.'
$bishop_shaitana_pref[3] = '  [ШАЙТАНА]
   - Но при этом она должна быть <font color="#008000"><b>мастером зелий</b></font>, потому что ей предстоит лично смешивать Великий Эликсир. Задача высшей важности, не прощающая ошибок.'
$bishop_shaitana_pref[4] = '  [ШАЙТАНА]
   - так же, для участия в ритуалах, дева должна хорошо <font color="#008080"><b>петь</b></font>, <font color="#008080"><b>танцевать</b></font> и <font color="#008080"><b>играть на цимбалах</b></font>. И в целом она должна быть прельстива богам.'
$bishop_shaitana_pref[5] = '  [ШАЙТАНА]
   - Как видишь, набор требований не простой. Я не могу просто взять ребёнка с улицы и пустить в храм. Подбери лучший материал, воспитай, научи и приходи ко мне. Искры будут ждать.'
$buy_quote['bishop_shaitana'] = '   [ШАЙТАНА]
   - Возраст подходит и внешность тоже. Если она и правда так ловко мешает зелья, как ты рассказываешь, <<$master_name>>, то мне такая подойдёт. Тебе заплатят твои искры.'
$refuse_skill_quote['bishop_shaitana'] = '   [ШАЙТАНА]
   - Любая ошибка будет стоить нам слишком дорого. Я не могу взять в храм девочку, которая не до конца обучена. Тебе нужно поработать ещё.'
$refuse_level_quote['bishop_shaitana'] = '   [ШАЙТАНА]
   - Боги не прощают неуважения. Как и я. Недостаточно просто соблюсти формальные требования. Девочка должна быть подготовлена достойно со всех сторон. Забери её и возвращайся когда она будет стоить своих искр.'
$refuse_charm_quote['bishop_shaitana'] = '   [ШАЙТАНА]
   - Нет. В этом ребёнке скрыт порок, червоточина, которой ты почему-то не чувствуешь. Но я вижу. Она оскорбит богов и всех нас постигнет несчастье. Уведи её прочь.'
$refuse_health_quote['bishop_shaitana'] = '   [ШАЙТАНА]
   - Служение богу требует духовных и физических сил, моральной чистоты и твёрдости разума. Та, что ты привела, к такому не готова.'
$refuse_pregnant_quote['bishop_shaitana'] = '   [ШАЙТАНА]
   - <<$master_name>>, ну ёбаная ты в рот, а?! Я просил девственницу-лоли, а ты приводишь брюхатую девку - каким образом тебе пришла в голову такая идея и как ты вообще этого добилась?'
$refuse_special_quote['bishop_shaitana'] = '   [ШАЙТАНА]
   - Это дитя не подойдёт. Она не отвечает особым требованиям.'
