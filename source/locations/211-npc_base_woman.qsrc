demand['nymphomania'] = 1
}
$Artemia_pref[1] = '  [Артемия]
   - Доброго дня, работорговец. Или работорговка? Как правильно называть девчонку, что торгует девчонками? О, я знаю, торговка рабынями! (звонко смеется) Прости-прости, это так смешно, я никогда не покупала рабынь у женщины! Но можно попробовать и сравнить, как ты справишься с моим заказом.  '
$Artemia_pref[2] = '  - Я хочу <font color="#008000"><b>самую красивую</b></font> рабыню, которой будет не стыдно похвастаться перед подружками. Нежную, чтобы ее возбуждением можно было любоваться и без комплексов, чтобы она делала все, что я от нее хочу. Обязательно найди мне нимфоманку! Я сама люблю частый секс, а если еще и с подружками, то не каждая рабыня осилит наш секс марафон. '
$Artemia_pref[3] = '  - Пусть она будет <font color="#008080"><b>артисткой</b></font>. Мне нравятся вечера музицирования, я нахожу в них какую-то свою, особенную прелесть. Не смотри на меня так, неужели ты думаешь, что я слишком молода, чтобы уметь наслаждаться подобными вещами? Я выросла в богатом доме и каждый раз, когда мы проводили вечера вместе, рабыни услаждали наш слух пением и музыкой. '
$Artemia_pref[4] = '  - О самом главном…. <font color="#008000"><b>Секс</b></font> должен быть самым лучшим. Не должно быть того, что она не умеет. У меня не будет времени доучивать ее. И удели особое внимание особым навыкам – для рабыни не должно быть большего счастья, чем иметь возможность пить мочу своей госпожи и ее подруг. И все в этом духе. Чему вы там учите хороших шлюх? <font color="#008080"><b>Терпеть боль и любить ее</b></font>? Хочу такую рабыню!'
$Artemia_pref[5] = '  - У меня есть лучшая подруга, у которой есть целая коллекция животных для сношения. Так смешно закидывать к ним неопытных рабынь, а потом слушать, как они орут от боли, если те их раздирают или калечат… Моя девочка должна уметь обходиться с <font color="#008080"><b>каждым животным</b></font>, к которому я решу ее закинуть! Если ты все поняла, то до встречи. Буду ждать свою рабыню. '
$buy_quote['Artemia'] = '   [Артемия]
    - Хорошо, <<$master_name>>, я беру её. Вот искры и спасибо. Надеюсь, она меня порадует!'
$refuse_skill_quote['Artemia'] = '   [Артемия]
   - Я же немного требовала. Почти ничего. И даже этого почти ничего она не умеет. Не разочаровывай меня, <<$master_name>>. Я же VIP-клиент, в конце концов.'
