$npc_image['markel'] = 'markel'
$npc_name['markel'] = '마르켈'
$npc_status['markel'] = '(중립)'
$npc_info['markel'] = '황소 구역에서 명성을 얻은 치유사다. 국왕조차 그의 도움을 구했다는 말이 있다. 저택이 습격당해 하인들이 전부 죽은 뒤, 그는 동방 구역으로 옮겼다. 지금 무슨 일을 하는지는 알려지지 않았지만, 스파크가 부족한 처지는 아니다.'
npc_attitude['markel'] = 11

$npc_image['baldita'] = 'baldita'
$npc_name['baldita'] = '발디타'
$npc_status['baldita'] = '(중립)'
$npc_info['baldita'] = '네크로맨서이자 안개의 신봉자다. 그녀는 안개를 신성한 것으로 여기며 기도와 제물을 바친다. 배교자들을 되살려 부린다. 소문으로는 동부 구역의 부유한 주민 하나를 도와 준 대가로, 그곳에 살며 가르칠 허가를 얻었다고 한다.'
npc_attitude['baldita'] = 11

$npc_image['Gennay'] = 'Gennay'
$npc_name['Gennay'] = '젠네이'
$npc_status['Gennay'] = '(중립)'
$npc_info['Gennay'] = '일부 계층에서 유명한 작가다. 매력적인 소설가와의 낭만적인 한때를 바라는 부유한 여자들, 그리고 그보다 덜 부유한 여자들 사이에서도 인기가 많다.'
npc_attitude['Gennay'] = 30

$npc_image['oilokan'] = 'oilokan'
$npc_name['oilokan'] = '오일로칸'
$npc_status['oilokan'] = '(중립)'
$npc_info['oilokan'] = '부유한 상인의 아내로, 매력적인 여자들을 싫어하며 각종 독물에 능하다.'
npc_attitude['oilokan'] = 30

$npc_image['Deming'] = 'Deming'
$npc_name['Deming'] = '데밍'
$npc_status['Deming'] = '(중립)'
$npc_info['Deming'] = '자기만의 흡연 혼합물을 파는 상점 주인이다. 예전에는 밀수업자였지만 몇 번의 성공적인 거래 뒤 은퇴했다. 가끔은 그 선택을 후회하기도 한다.'
npc_attitude['Deming'] = 30
$npc_image['anameleh'] = 'anameleh'
$npc_name['anameleh'] = '아나멜레'
$npc_status['anameleh'] = '(중립)'
$npc_info['anameleh'] = '본래 세계에서 아나멜레와 그의 여동생은 신들의 마지막 후손들이었고, 필멸자들에게 악마로 몰려 사냥당했다. 그들의 마지막 피난처를 집어삼킨 안개는 저주가 아니라 축복이 되었다. 로마에서 아나멜레와 하사는 귀족들과 귀족들 사이에서 호의를 얻었다. 두 사람은 어떤 상인 길드와 연결되어 있고 비밀스러운 클럽에도 속해 있다.'
npc_attitude['anameleh'] = 30

$npc_image['Hassa'] = 'Hassa'
$npc_name['Hassa'] = '하사'
$npc_status['Hassa'] = '(중립)'
$npc_info['Hassa'] = '본래 세계에서 하사와 그녀의 오빠는 신들의 마지막 후손들이었고, 필멸자들에게 악마로 몰려 사냥당했다. 그들의 마지막 피난처를 집어삼킨 안개는 저주가 아니라 축복이 되었다. 로마에서 아나멜레와 하사는 귀족들과 귀족들 사이에서 호의를 얻었다. 두 사람은 어떤 상인 길드와 연결되어 있고 비밀스러운 클럽에도 속해 있다.'
npc_attitude['Hassa'] = 30

$npc_image['Fyrgin'] = 'Fyrgin'
$npc_name['Fyrgin'] = '피르긴'
$npc_status['Fyrgin'] = '(중립)'
$npc_info['Fyrgin'] = '거만한 네크로맨서와 의견 충돌을 겪은 뒤 동부 구역으로 옮겨 온 젊은 마녀다. 인간보다 자기 수호령들을 더 좋아하며, 새들이 자기 주변을 마음대로 날아다니게 둔다.'
npc_attitude['Fyrgin'] = 30

$npc_image['Uzeji'] = 'Uzeji'
$npc_name['Uzeji'] = '우제지'
$npc_status['Uzeji'] = '(중립)'
$npc_info['Uzeji'] = '동부 구역에서 존중받는 고대 여우 정령의 조수이자 목소리다. 어떤 이들은 그녀가 사람들을 속인다고 말한다. 그 여우가 진짜 변신술사가 아니라 단지 잘 훈련된 동물일 뿐일지도 모르기 때문이다.'
npc_attitude['Uzeji'] = 30

$npc_image['Ritegreu'] = 'Ritegreu'
$npc_name['Ritegreu'] = '이르구테긴 & 리트그레우'
$npc_status['Ritegreu'] = '(중립)'
$npc_info['Ritegreu'] = '이르구테긴의 부모는 수상한 사정으로 죽었다. 어머니는 공식 만찬에서 기절한 뒤 끝내 의식을 되찾지 못했고, 아버지는 빈민가에서 시체로 발견되었다. 리트그레우는 그의 하인처럼 행동하지만, 사실은 그를 돌보고 있는 먼 친척이다.'
npc_attitude['Ritegreu'] = 12

$npc_image['Netsumi'] = 'Netsumi'
$npc_name['Netsumi'] = '네츠미'
$npc_status['Netsumi'] = '(중립)'
$npc_info['Netsumi'] = '젊은 여우 변신술사다. 대부분의 비인간들과 달리 평범한 인간들에게 동정심을 품고 있으며, 그들을 우습고도 흥미로운 존재로 여긴다. 동부 구역에서 찻집을 열려 하지만, 아직은 잘 풀리지 않고 있다.'
npc_attitude['Netsumi'] = 30

$npc_image['Gadanfar'] = 'Gadanfar'
$npc_name['Gadanfar'] = '가단파르'
$npc_status['Gadanfar'] = '(중립)'
$npc_info['Gadanfar'] = '말과 전차 경주를 사랑하는 인물이다. 한때 어려운 코스를 돌파하고 경쟁자들을 따돌리는 것으로 유명했지만, 심각한 사고에서 살아남은 뒤 큰 부상을 입었다.'
npc_attitude['Gadanfar'] = 11

$npc_image['veineut'] = 'veineut'
$npc_name['veineut'] = '베이뉴트'
$npc_status['veineut'] = '(중립)'
$npc_info['veineut'] = '"BPHMT" 갱단 소속 현상금 사냥꾼이다. 영리하고 고집이 세며, 곤란한 처지의 젊은 여자들을 돕는 걸 즐긴다. 남성 고객은 좀 더 까다롭지만, 스파크가 있으면 대체로 해결된다.'
npc_attitude['veineut'] = 11

