$npc_image['Ilariya'] = 'Ilariya'
$npc_name['Ilariya'] = 'Илария'
$npc_status['Ilariya'] = 'Советник главы Футалэнда'
$npc_alignment['Ilariya'] = 'Futaland'
$npc_info['Ilariya'] = ' Поговаривают, что она была выращена кем-то из шишек гильдии, но не клеймена, потому что человек, для которого ее создавали, не хотел видеть чужое клеймо на своем заказе. И когда она переехала в дом хозяина, она быстро заняла роль сначала его любовницы, а потом и жены. А еще через полгода ее владелец погиб во время сафари на рабыню. Леди Илария осталась наследницей огромного состоянии, которое теперь благополучно спускает на свои пороки.'
demand_rating['Ilariya'] = 8
$interesting_specialisation['Ilariya'] = 'refferent'
$diary_mark['Ilariya'] = "   <<$npc_name['Ilariya']>>."
$npc_preferences['Ilariya'] = {
stat_importance['intellect'] > 3
stat_importance['ego'] > 3
stat_importance['penetration'] > 4
stat_importance['petting'] > 4
stat_importance['roleplay'] > 4
}
$buyer_demand['Ilariya'] = {
demand['min_beauty'] > 3
demand['notattoos'] = 1
demand['fertility'] = 1
}
$Ilariya_pref[1] = '  [Илария]
   -  Добро пожаловать в мой дом, <<$master_name>>. Как тебе обстановка? Мой ныне покойный муж убил целое состояние на то, чтобы создать здесь все так, как есть сейчас. И из уважения к нему, я все оставила, как и было. Но это не важно. Я рада, что ты зашла. Я бы предложила тебе повеселиться, но тренера рабынь часть такие ханжи… обучать девочек подставлять все дырки они умеют, а свои берегут. '
$Ilariya_pref[2] = '  - Эй, погоди, не уходи, будет тебе заказ, будет!
     Шлюх у меня уже полный дом, я сама скоро смогу ими торговать. Но вот дельной помощницы у меня так и нет. Покупала уже с десяток, но все не то. Или вялые, как больные улитки, или тупые, что бесят неимоверно. Ты поняла, да? Я хочу хорошую помощницу. '
$Ilariya_pref[3] = '  - Я столько раз обожглась на неудачных покупках, поэтому пусть эта девочка будет <font color="#008080"><b>с твердым характером и умная</b></font>. Внешность не такой важный пункт, но раз я плачу, то хочу видеть около себя <font color="#008080"><b>красавицу</b></font>. Я ведь буду ходить с ней на приемы! Поэтому никаких татуировок или, упаси бог, проколов или модификаций. Во избежание казусов – обязательно стерилизуй ее. '
$Ilariya_pref[4] = '  - Деловые поездки иногда забирают меня из дома на несколько дней, а ночью в одиночестве так скучно. Научи ее <font color="#008000"><b>работать ручками, грудью</b></font>…. И что там еще бывает в том же духе? Вокруг бывает так много мужчин, в которых гормоны так и пылают. Мне пригодится, если она будет <font color="#008000"><b>уметь соблазнять и унижаться</b></font> ради моих интересов.'
$Ilariya_pref[5] = '  - Не думаю, что стоит упоминать, что <font color="#008000"><b>секс в обе дырочки</b></font> должен быть отличным. Продавать рабыню без этого просто как продавать чашку без дна. Справишься – хорошо заплачу. Иди, работы тебе предстоит не мало. '
$buy_quote['Ilariya'] = '   [Илария]
    - Хорошо, <<$master_name>>, я беру её. Вот искры и спасибо. Надеюсь, она меня порадует!'
$refuse_skill_quote['Ilariya'] = '   [Илария]
   - Я же немного требовала. Почти ничего. И даже этого почти ничего она не умеет. Не разочаровывай меня, <<$master_name>>. Я же VIP-клиент, в конце концов.'
$refuse_level_quote['Ilariya'] = '   [Илария]
