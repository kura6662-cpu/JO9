$interesting_specialisation['krasnaya_shapochka'] = 'pet'
$diary_mark['krasnaya_shapochka'] = "   <<$npc_name['krasnaya_shapochka']>>. Живёт в Волшебном лесу."
$krasnaya_shapochka_pref[1] = "  [Красная шапочка]
   - Здравствуйте, <<$master_name>>! Вы уж простите меня, бесстыжую, за такой вид, но не могу я иначе...
   Однажды пошла я через лес бабушке гостинцев передать. И тут окружила меня стая волков... Я и думать не думала никогда, что волк может человеческой речью говорить. А на деле так оно и вышло. Вожак стаи, Серый, не хуже человека разговаривает... "
$krasnaya_shapochka_pref[2] = "  [Красная шапочка]  
   - Так мало того, эта стая ещё и жуткими извращенцами оказалась. Видимо, приглянулось им моё молодое, аппетитное тело. Вот они и поставили мне ультиматум: или я буду обслуживать их по первому их требованию, или они бабушку и матушку мою съедят. И что мне оставалось делать?! Пришлось подчиниться... "
$krasnaya_shapochka_pref[3] = "  [Красная шапочка]    
   - А пока я волков развлекала, откуда ни возьмись охотники нагрянули. Я уж подумала, что они волков перебьют всех и меня из беды вытащат, а они с ними заодно оказались. Пришлось и их удовлетворить. И, естественно, от них мне тоже ультиматум подоспел: или я их обслуживаю, или все узнают о том, какая я похотливая и грязная давалка. А я ведь молодая совсем, ещё вся жизнь впереди... "
$krasnaya_shapochka_pref[4] = "  [Красная шапочка]  
   - Пришлось и на их требования согласиться. Иначе кто давалку замуж-то возьмёт?!...Вот так я и стала их секс-рабыней. И хозяев у меня теперь немерено. И один хлеще другого в выдумках. Теперь я только и успеваю в лес бегать, да там их ублажать..." 
$krasnaya_shapochka_pref[5] = "  [Красная шапочка]   
   - Правда, недавно удалось мне о выкупе с ними договориться. Хозяева готовы отпустить меня, если я красивую и послушную девочку им приведу себе на замену... И самое главное, эта девочка должна хорошо животным прикидываться. Собачкой или кошечкой, например... Уж я на себе это сама испытала..." 
$krasnaya_shapochka_pref[6] = "  [Красная шапочка]
   - Нравится им меня на цепь сажать и прогулку по лесу устраивать пока им место какое-нибудь не приглянётся. Там меня они и имеют во все дыры. Так что, сучка породистая должна быть. Ранг <<$rating[demand_rating['krasnaya_shapochka']]>>. И не меньше! 
   Вы же легко справитесь с такой задачей, <<$master_name>>? Я очень рассчитываю на Вашу помощь..." 
$krasnaya_shapochka_pref[7] = "  [Красная шапочка]   
   - <<common_price[demand_rating['krasnaya_shapochka']]>> искр я смогла накопить. Надеюсь, этого достаточно за нужную мне девочку?... Вот и славно.  
   А теперь, простите меня... Пора мне. Хозяева, вон, виднеются... И одежду мою не троньте, пожалуйста! Да-да, не удивляйтесь! Это тоже их выдумка. В лес я теперь только голенькая захожу. Их игрушка сразу готовая должна быть к их играм извращенческим..."
$krasnaya_shapochka_pref[8] = "  [Красная шапочка]      
