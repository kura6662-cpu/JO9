$npc_image['ladonna'] = 'ladonna'
$npc_name['ladonna'] = '라돈나'
$npc_status['ladonna'] = '(중립)'
$npc_info['ladonna'] = '이국적인 것을 즐기는 부유한 과부다. 소문에 따르면 남편은 신혼 첫날밤에 죽었다고 한다 - 늙은 심장이 그녀의 격정적인 기질을 견디지 못한 것이다. 불멸의 로마에서는 그런 "우연"이 드문 일이 아니다.'
npc_attitude['ladonna'] = 30

$npc_image['yagishna'] = 'yagishna'
$npc_name['yagishna'] = '올드 야기슈나'
$npc_status['yagishna'] = '(중립)'
$npc_info['yagishna'] = '"본 레그" 상점의 주인이다. 한때는 강력한 마녀였지만, 안개에 들어오며 힘을 잃었다. 교활함으로 언데드들의 호의를 얻고 네크로폴리스에 정착해 가게를 열었다. 산 자들과의 장사는 잘되지 않아, 지금은 잠시 빈민가로 옮겨 와 있다.'
npc_attitude['yagishna'] = 30

$npc_image['dragon'] = 'dragon'
$npc_name['dragon'] = '코린스트라즈 더 피어스'
$npc_status['dragon'] = '(중립)'
$npc_info['dragon'] = '중간 크기의 검은 드래곤이다. 머리는 굽은 뿔로 보호되고 있으며, 긴 꼬리 끝에는 치명적인 침이 달려 있다. 소문에 따르면 코린스트라즈는 드래곤 퀸에게 반기를 들었다가 종족에서 추방되었다고 한다. 야심가인 그는 자기 그레이트 하우스를 세우려 하며, 필요하다면 필멸자도 이용한다.'
npc_attitude['dragon'] = 21

$npc_image['mouse_king'] = 'mouse_king'
$npc_name['mouse_king'] = '쥐 왕'
$npc_status['mouse_king'] = '(중립)'
$npc_info['mouse_king'] = '"회색" 민족의 진정한 지배자이자 "일곱 머리와 세 꼬리" 결사의 대단장이라고 자칭한다. 스파크를 쥐고 있으며 멀쩡히 살아 빈민가에 살고 있는데, 그건 그 말이 사실이거나 아니면 운이 아주 좋다는 뜻이다.'
