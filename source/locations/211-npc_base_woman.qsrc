$diary_mark['tf_teatr'] = "   <<$npc_name['tf_teatr']>>. Зимняя сказка."
$tf_teatr_pref[1] = "  [Вы]
   - Тук-тук! Всем, здрасте!...
   ... Оу! Какой красивый вид!!!...
    [Маша]
