rider_structure['ride_angelika'] = 4
$rider_description['ride_angelika'] = '안젤리카에게 경주는 그저 노예를 훈련시킬 기회일 뿐이다. 그녀의 말은 완벽하게 길들여져 있지만 체격 면에서 두드러지지는 않는다. 그녀의 전차는 무겁고 방호가 잘 되어 있다.'
$race_startline['ride_angelika'] = {
	speed_points['ride_angelika'] += 12 + ((48271 * (day + 1)) mod 65537)/(65537/3) &! pseudo-rand(12,14)
}
