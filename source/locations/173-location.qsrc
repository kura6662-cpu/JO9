# боевое_меню
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2899 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'боевое_меню': gs 'snk_room_bridge', 'guard', 'боевое_меню'
! JO9 MOD END J9M2899
!CREATING MAIN FIGHTING MENU
gs '#боевые_предметы'
gs '#суперудары'

!Obtain information about the player current weapon
вред_оружия_игрока = базовый_вред[$оружие]
$тип_вреда_оружия = $тип_вреда[$оружие]

$первый_пункт = $атака_1_название[$оружие]
$тип_первой_атаки = $атака_1_тип[$оружие]
$первый_бонус = $атака_1_бонус[$оружие]
$первый_штраф = $атака_1_штраф[$оружие]

$второй_пункт = $атака_2_название[$оружие]
$тип_второй_атаки = $атака_2_тип[$оружие]
$второй_бонус = $атака_2_бонус[$оружие]
$второй_штраф = $атака_1_штраф[$оружие]

!creating
$боевое_меню = ''
$боевое_меню += '<<$первый_пункт>><br>'
$боевое_меню += '<<$второй_пункт>><br>'
if вторичная_атака[$вторичный] = 1 and $вторичный ! '': $боевое_меню += "<a href='EXEC: dynamic $атака_второй_рукой'><<$вторичная_атака_название[$вторичный]>><br>"
$боевое_меню += "<br><a href='EXEC: dynamic $пинок'><font color='red'>발차기</font></a> (<font color='purple'>충격</font>/<font color='green'>집중</font>)<br>"
$боевое_меню += "<a href='EXEC: dynamic $толчок'><font color='green'>밀치기</font></a> (<font color='red'>방심</font>/<font color='purple'>흥분</font>)<br>"
$боевое_меню += "<a href='EXEC: dynamic $подсечка'><font color='purple'>다리걸기</font></a> (<font color='green'>탈력</font>/<font color='red'>회피</font>)<br>"

------------ боевое_меню ------------
