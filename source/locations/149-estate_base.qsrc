! reduce rental costs for normal [1] and easy [0] game difficulty (not obedience difficulty so not adjustable during play) - ImperatorAugustus
! $newloc calls 'gs #estate_base' to refresh after game load (and for new games)
$reduce_rental_costs = {
	if game_difficulty = 1:
		estate_cost_main[$args[0]]    /= 4
		estate_cost_boudoir[$args[0]] /= 4
		estate_cost_dungeon[$args[0]] /= 4
		estate_cost_lab[$args[0]]     /= 4
		estate_cost_barn[$args[0]]    /= 4
	elseif game_difficulty = 0:
		estate_cost_main[$args[0]]    /= 10
		estate_cost_boudoir[$args[0]] /= 10
		estate_cost_dungeon[$args[0]] /= 10
		estate_cost_lab[$args[0]]     /= 10
		estate_cost_barn[$args[0]]    /= 10
	end
}

dynamic $reduce_rental_costs, 'white_house'
