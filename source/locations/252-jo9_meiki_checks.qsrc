	if args[1] = 101 or args[1] = 102 or args[1] = 103 or args[1] = 104 or args[1] = 1041 or args[1] = 1042 or args[1] = 1043 or args[1] = 1044 or args[1] = 1045 or args[1] = 105 or args[1] = 106 or args[1] = 19 or args[1] = 12 or args[1] = 15 or args[1] = 151 or args[1] = 152 or args[1] = 153 or args[1] = 154 or args[1] = 155 or args[1] = 161 or args[1] = 162 or args[1] = 91 or args[1] = 94 or args[1] = 95: result = 1
