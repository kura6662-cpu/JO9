$броня_снять['кольчуга'] = {
	модификатор_колющий += 10
	модификатор_рубящий += 10
	модификатор_дробящий += 10
	модификатор_холод += 10
	модификатор_огонь += 10
	модификатор_молния += 10
	модификатор_свет += 10
	модификатор_тьма += 10
	модификатор_серебро += 10
	модификатор_холодное_железо += 10
}
$броня_эффект['кольчуга'] = {
	скованность = 0
}
$ключевое_слово_1['кольчуга'] = 'тяжелый_доспех'
$ключевое_слово_2['кольчуга'] = 'нет'
$ключевое_слово_3['кольчуга'] = 'нет'
$ключевое_слово_4['кольчуга'] = 'нет'
$ключевое_слово_5['кольчуга'] = 'нет'


!_____________POTIONS_______________

!Balm ['целительный_бальзам']
$item_name['целительный_бальзам'] = '기적의 향유'
$item_description['целительный_бальзам'] = '일회용, 전투중 활력20 회복 및 상처 치유, 고통 제거'
$применить['целительный_бальзам'] = {
	if sound_on = 1: play 'content\snd\potion_fight.wav', sound_volume
	целительный_бальзам -= 1
	здоровье_игрока = макс_здоровье_игрока
	выносливость_игрока = макс_выносливость_игрока
	дух_игрока += 20
	боль = 0
	$действия_игрока = '<br> 당신은 기적의 향유를 상처에 문질러 발랐고 상처는 즉각 나았다. 당신은 고통이나 피로감을 전혀 느끼지 못한다.'
	gt 'ход_противников'
}

!Tonic elixir ['тонизируюзщий_эликсир']
$item_name['тонизируюзщий_эликсир'] = '자양 강장제'
$item_description['тонизируюзщий_эликсир'] = '일회용, 전투중 기력20 회복 및 노력 증가. 약화 제거 및 가속10, 집중10 획득'
$применить['тонизируюзщий_эликсир'] = {
	if sound_on = 1: play 'content\snd\potion_fight.wav', sound_volume
	тонизируюзщий_эликсир -= 1
	выносливость_игрока = макс_выносливость_игрока
	дух_игрока += 20
	разгон = 10
	внимание = 10
	слабость = 0
	$действия_игрока = '<br> 당신은 빠르게 자양 강장제를 마셨다. 그리고 즉각 강한 에너지가 솟구치는 느낌이 들었다. 고통과 절망이 없어졌다.'
	gt 'ход_противников'
}

!Bacchic nectar ['вакхический_нектар']
$item_name['вакхический_нектар'] = '바커스의 술'
$item_description['вакхический_нектар'] = '일회용, 전투중 노력50 증가. 고통, 약화, 경직 제거. 분노10, 흥분10, 방심10 획득'
$применить['вакхический_нектар'] = {
	if sound_on = 1: play 'content\snd\potion_fight.wav', sound_volume
	вакхический_нектар -= 1
	дух_игрока += 50
	боль = 0
	слабость = 0
	скованность = 0
	бешенство = 10
	адреналин = 10
	рассеянность = 10
	$действия_игрока = '<br> 당신은 가까스로 적의 공격을 피해내고, 바커스의 술을 한 번에 마셨다. 당신은 즉각적으로 미쳐 날뛸듯이 격노하게 되었고, 당신의 전의는 하늘을 뚫고 올라갈 정도로 높아졌다.'
	gt 'ход_противников'
}


!sample
!!WEAPON ['образец']
!$item_description - item description;
!$item_name - item name;
!базовый_вред - base damage
!тип_вреда - damage type, колющий - thrusting, рубящий - chopping, дробящий - crushing, психический - morale damage;
!класс_оружия - weapon class, not used;
!атака_1_тип - type of attack, точная - purple attack, быстрая - green attack, сильная - red attack;
!$атака_1_название - attack 1 name;
!атака_1_штраф - status penalty when enemy has a different stance, атака_1_бонус - status bonus when enemy has a different stance, атака_1_длительность - how long statuses lasts;
!$атака_1_текст - attack 1 text;
!вторичная_атака - if secondary attack available;
!вторичная_атака_тип - secondary attack type of attack;
!$вторичная_атака_название - secondary attack name, for dual-wield;
!$вторичная_атака_штраф
!$вторичная_атака_бонус
!вторичная_атака_длительность - as well as usual attack
!$вторичная_атака_текст - secondary attack text;
!ключевое_слово_1 - check for superb availability, example - if superb needs thrusting weapon, ключевое_слово_1 needs to be "колющий";

!$item_description['образец'] = '   '
!$item_name['образец'] = ''
!базовый_вред['образец'] = 1
!$тип_вреда['образец'] = 'дробящий'
!$класс_оружия['образец'] = 'легкое_оружие'
!$атака_1_тип['образец'] = 'точная'
