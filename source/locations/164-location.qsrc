$атака_2_тип['безоружный'] = 'быстрая'
$атака_2_название['безоружный'] = "<a href = 'EXEC: dynamic $второе_действие'><font color='green'>어퍼컷</font></a> (<font color='red'>방심</font>/<font color='purple'>명중</font>)"
