$класс_оружия['безоружный'] = 'безоружный'
$атака_1_тип['безоружный'] = 'точная'
$атака_1_название['безоружный'] = "<a href = 'EXEC: dynamic $первое_действие'><font color='purple'>잽</font></a> (<font color='green'>충격</font>/<font color='red'>가속</font>)"
