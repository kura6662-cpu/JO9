$item_description['посох_огня'] = '<br> 단 하나뿐인 유물, 매우 강력한 지팡이. 구체형 머리는 마법 불똥으로 이글대고 있다. 본적도 없는, 어떤 기술도 뛰어넘는 장인의 기술이다. 소수의 존재만이 휘두를 수 있다.<br><br> 마법 공격형 불 지팡이, 피해량 : 최소 10 ~ 14 최대, 장악력+2'
! JO9 MOD END J9M2605
$item_demo['посох_огня'] = 'scene\item\weapons\two_handed\dragon_fire_staff_relic'
$item_name['посох_огня'] = '화룡의 유물 지팡이'
базовый_вред['посох_огня'] = 8 + rand(2,6)
$тип_вреда['посох_огня'] = 'огонь'
$класс_оружия['посох_огня'] = 'тяжелое_оружие'
