$атака_1_название['посох_огня'] = "<a href = 'EXEC: dynamic $первое_действие'><font color='purple'>불덩이</font></a> (<font color='green'>경직</font>/<font color='red'>분노</font>)"
$атака_1_штраф['посох_огня'] = 'шаткость'
$атака_1_бонус['посох_огня'] = 'бешенство'
атака_1_длительность['посох_огня'] = 2+восприятие
$атака_1_текст['посох_огня'] = "<br> 당신은 적에게 <font color='purple'>이글거리는</font> 강렬한 폭발을 일으켰다"
$атака_2_тип['посох_огня'] = 'сильная'
