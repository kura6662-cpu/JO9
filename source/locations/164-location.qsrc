!$атака_1_текст['образец'] = "<font color='purple'>точный</font>"
!$атака_2_тип['образец'] = 'быстрая'
!$атака_2_название['образец'] = "<a href = 'EXEC: dynamic $второе_действие'><font color='green'>Удар</font> (Ша/Бе)</a>"
!$атака_2_штраф['образец'] = ''
!$атака_2_бонус['образец'] = ''
!$атака_2_текст['образец'] = "<font color='green'>быстрый</font>"
!атака_2_длительность['образец'] = 2+ловкость

!вторичная_атака['образец'] = 1
!$вторичная_атака_тип['образец'] = 'точная'
!$вторичная_атака_название['образец'] = "<a href = 'EXEC: dynamic $атака_второй_рукой'><font color='purple'>Удар</font></a> (<font color='green'>Бл</font>/<font color='red'>Acc</font>)"
!$вторичная_атака_штраф['образец'] = ''
!$вторичная_атака_бонус['образец'] = ''
!вторичная_атака_длительность['образец'] = 2+восприятие
!$вторичная_атака_текст['образец'] = "<font color='purple'>точный</font>"

!$ключевое_слово_1['образец'] = 'легкое_оружие'
