# start_refresh
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2807 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'start_refresh': gs 'snk_room_bridge', 'guard', 'start_refresh'
! JO9 MOD END J9M2807
!Start Refresh - fixes several bugs when the game reload the main Start menu
!Created by crushboss
!Overhauled by ImperatorAugustus

killall &! THIS DELETES EVERY VARIABLE IN THE GAME (the engine has been updated to reload json files afterwards)
warning_pass = 1 &! only display warning the first time main menu is displayed

usehtml = 1
debug = 0
sound_on = 1
music_volume = 100
sound_volume = 100

SHOWOBJS 0
SHOWACTS 0
SHOWINPUT 0
SHOWSTAT 0

INTEGRATED_ACTIONS = 1
HIDE_SCROLL_ARROWS = 1
DISABLESCROLL = 1

$FNAME = 'Sandoll 미생'

!$counter = '$counter' &! realtime update handler
$onobjsel = '$objsel' &! object selector handler
$ongload = '$ongload' &! after load game handler

IF hero_choice = 114 or hero_choice = 119 or hero_choice = 120 or hero_choice = 12 or hero_choice = 17 or hero_choice = 18:
	master_vampire = 1
ELSE
	master_vampire = 0
END


