# #moodlet_base
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2451 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '#moodlet_base': gs 'snk_room_bridge', 'guard', '#moodlet_base'
! JO9 MOD END J9M2451
!MOODLET DATABASE

!master positive moodlets (listed in the order they will appear [if present] in the diary)
killvar '$master_good_mood'
$master_good_mood[] = 'pos_energy'       & $mood_description['pos_energy'] = '나는 상쾌하고 에너지로 가득 차 있다. 이걸 제대로 써먹어야 한다!'
$master_good_mood[] = 'pos_new_slave'    & $mood_description['pos_new_slave'] = '새로운 날 - 새로운 노예. 쇼핑은 언제나 기분을 끌어올린다.'
$master_good_mood[] = 'pos_housing'      & $mood_description['pos_housing'] = '인정할 수밖에 없다. 나는 꽤 괜찮은 집에 살고 있다.'
$master_good_mood[] = 'pos_house_clean'  & $mood_description['pos_house_clean'] = '집안은 완벽할 정도로 깨끗하고 정돈되어 있다.'
$master_good_mood[] = 'pos_master_cloth' & $mood_description['pos_master_cloth'] = '나는 아주 편한 옷을 갖고 있다. 편안함은 중요하다.'
$master_good_mood[] = 'pos_self_clean'   & $mood_description['pos_self_clean'] = '푹 씻는 것보다 좋은 건 없다. 청결은 경건함에 가깝다!'
$master_good_mood[] = 'pos_toilet'       & $mood_description['pos_toilet'] = '내 노예는 훌륭한 변기가 되어 주었다. 평범한 변기보다 훨씬 낫다.'
$master_good_mood[] = 'pos_nice_slave'   & $mood_description['pos_nice_slave'] = '그 여자애의 교육은 순조롭게 진행되고 있다. 내가 일을 아주 잘하고 있는 셈이지.'
$master_good_mood[] = 'pos_massage'      & $mood_description['pos_massage'] = '음... 이 얼마나 황홀한가. 아름답고 상냥한 여자에게 보살핌을 받는다는 건 참 좋군...'
$master_good_mood[] = 'pos_good_morning' & $mood_description['pos_good_morning'] = '아침 펠라 - 하루를 시작하는 완벽한 방식이다.'
$master_good_mood[] = 'pos_satisfied'    & $mood_description['pos_satisfied'] = '이토록 열렬한 섹스를 하고 나면, 뇌는 필연적으로 긍정적인 파장으로 넘어가게 마련이다!'
$master_good_mood[] = 'pos_optimism'     & $mood_description['pos_optimism'] = '내 노예는 너무 귀여워서 쉴 새 없이 대화하고 싶어진다.'
$master_good_mood[] = 'pos_good_pet'     & $mood_description['pos_good_pet'] = '사람들이 왜 고양이를 기르는지 알 것도 같다 - 스트레스 해소에 아주 좋다. 비록 완전히 고양이는 아니더라도...'
$master_good_mood[] = 'pos_show'         & $mood_description['pos_show'] = '즐겁게 시간을 보냈다. 지루함을 날려 버리기엔 딱 좋았지!'
$master_good_mood[] = 'pos_self_food'    & $mood_description['pos_self_food'] = '배불리 잘 먹었다. 그야말로 맛의 축제였다!'
$master_good_mood[] = 'pos_date'         & $mood_description['pos_date'] = '말해 두지만, 그 데이트는 꽤 잘 풀렸다.'
$master_good_mood[] = 'pos_master_winner'& $mood_description['pos_master_winner'] = '승자라는 기분은 참 좋군!'
$master_good_mood[] = 'pos_deal'         & $mood_description['pos_deal'] = '좋은 거래였다. 이제 나는 더 많은 스파크를 갖게 됐고, 그걸 뭔가 즐거운 데 쓸 수 있다!'
$master_good_mood[] = 'pos_wealth'       & $mood_description['pos_wealth'] = '돈 때문에 자신을 제한하지 않아도 된다는 건 훌륭한 일이다.'
$master_good_mood[] = 'pos_kannabis'     & $mood_description['pos_kannabis'] = '콜록콜록... 이 풀, 제법 괜찮다고 해야겠군... 갑작스러운 평온과 고요가 밀려오는데, 지금은 생각을 한데 모으기가 어렵다...'
$master_good_mood[] = 'pos_drunk'        & $mood_description['pos_drunk'] = '지금 나는 취해 있다. 그리고 식인종과 가학적인 개자식들로 가득한 이 썩은 세상이 그렇게까지 나쁘진 않다는 기분이 든다! 나 자신도 그렇게까지 개자식은 아닌 것 같고...'
$master_good_mood[] = 'pos_opium'        & $mood_description['pos_opium'] = '망각의 정수는 모든 근심에서 벗어난 평화와 안도를 준다. 지금 나는, 이게 영원히 가지는 않는다는 것 말고는 아무 걱정도 없다.'
$master_good_mood[] = 'pos_bahus'        & $mood_description['pos_bahus'] = '왜 나는 방패를 물어뜯고 싶은 거지? 그리고 왜 그게 이렇게 긍정적인 기분인 거지? 냐아아아르르르그!!!!'
$master_good_mood[] = 'pos_'             & $mood_description['pos_'] = ''
!unused
!$master_good_mood[] = 'pos_master_precious'  & $mood_description['pos_master_precious'] = 'This magic decoration is perfectly uplifting. When I touch it I immediately calm down and the world seems better. It is just so lovely!'

!master negative moodlets (listed in the order they will appear [if present] in the diary)
killvar '$master_bad_mood'
$master_bad_mood[] = 'neg_master_loser'  & $mood_description['neg_master_loser'] = '나는 지는 게 싫다. 내 잘못은 아니더라도, 노예가 더 잘했어야 했다!'
$master_bad_mood[] = 'neg_boring'        & $mood_description['neg_boring'] = '지루해 죽겠군… 맨날 일하고 떡만 칠 수는 없지. 재미도 좀 봐야 한다!'
$master_bad_mood[] = 'neg_tired'         & $mood_description['neg_tired'] = '우우우… 피곤하다. 푹 쉬어야 한다. 안 그러면 건강을 잃기 쉽다.'
$master_bad_mood[] = 'neg_drunk'         & $mood_description['neg_drunk'] = '머리는 깨질 듯 아프고 입은 바싹 마른다. 술이 필요하다. 당장 마셔야 해… 분명 옷장 어딘가에 병이 있었을 텐데…'
$master_bad_mood[] = 'neg_wounded'       & $mood_description['neg_wounded'] = '붕대 아래 상처가 욱신거린다. 조금만 잘못 움직여도 아프다.'
$master_bad_mood[] = 'neg_no_koffe'      & $mood_description['neg_no_koffe'] = '눈꺼풀이 자꾸 감긴다. 내 아침 캄라 한 잔은 어디 있지?'
$master_bad_mood[] = 'neg_no_opium'      & $mood_description['neg_no_opium'] = '괴롭다. 이대로면 벽이라도 타고 오를 것 같다. 망각이 당장 공급되지 않으면 씨발 죽어 버릴 것만 같다.'
$master_bad_mood[] = 'neg_no_meth'       & $mood_description['neg_no_meth'] = '아, 기분 엿같네. 요정의 가루로 회복해야 한다 - 그러면 금방 나아지고 세상도 다시 알록달록해질 거다.'
$master_bad_mood[] = 'neg_softcore'      & $mood_description['neg_softcore'] = '섹스를 너무 많이 한 모양이다. 아주 신나긴 했지만 완전히 소진된 느낌이다.'
$master_bad_mood[] = 'neg_boner'         & $mood_description['neg_boner'] = '발기 때문에 바지가 터질 것 같다. 당장 풀어 줘야 한다.'
$master_bad_mood[] = 'neg_blazing'       & $mood_description['neg_blazing'] = '왜 내가 괜히 정조나 지키는 척하면서 성욕을 무시했지? 이제 존나 아프다. 풀지 않으면 미쳐 버릴 것 같다!'
$master_bad_mood[] = 'neg_dirty'         & $mood_description['neg_dirty'] = '우웩, 냄새 난다. 씻어야 한다. 내 자신이 역겹다.'
$master_bad_mood[] = 'neg_master_ill'    & $mood_description['neg_master_ill'] = '씨발. 화장실 갈 때마다 자지에서 분비물이 흐르고 따갑다. 그 창녀들 중 하나가 썩음매독을 옮겼군!'
$master_bad_mood[] = 'neg_cleaning'      & $mood_description['neg_cleaning'] = '진흙탕 뒤지는 꼴은 딱 질색이다. 나는 씨발 노예 조련사라고. 이 집엔 치울 사람도 없나?!'
$master_bad_mood[] = 'neg_cook'          & $mood_description['neg_cook'] = '제대로 먹으려면 냄비랑 접시 붙들고 주방에서 낑낑대야 한다. 이게 대체 무슨 꼴이지?'
$master_bad_mood[] = 'neg_food'          & $mood_description['neg_food'] = '이건 음식이 아니라 무슨 개밥 같은 쓰레기다. 왜 내가 어떤 노예들보다도 못 먹고 사는 거지?'
$master_bad_mood[] = 'neg_housing'       & $mood_description['neg_housing'] = '나는 다 쓰러져 가는 허름한 집에서 산다. 일하고 쉬기에 조건이 형편없다.'
$master_bad_mood[] = 'neg_house_mess'    & $mood_description['neg_house_mess'] = '집이 지저분한 난장판이다. 여기 있는 것 자체가 역겹다.'
$master_bad_mood[] = 'neg_wealth'        & $mood_description['neg_wealth'] = '거지 같은 꼴로 살고 있다. 동전 한 푼까지 계산해야 한다. 지긋지긋하다!'
$master_bad_mood[] = 'neg_accounts'      & $mood_description['neg_accounts'] = '서류 작업을 전부 내가 해야 한다. 비서가 필요하다!'
$master_bad_mood[] = 'neg_worn_clothes'  & $mood_description['neg_worn_clothes'] = '내 옷 상태가 영 아니다! 도대체 언제까지 빨고 기우며 버틸 수 있지? 옷장을 갈아엎어야 한다.'
$master_bad_mood[] = 'neg_master_cloth'  & $mood_description['neg_master_cloth'] = '이 옷은 너무 실용성이 없다. 도대체 언제까지 이런 차림으로 꾸며 입고 있어야 하지?'
$master_bad_mood[] = 'neg_alone'         & $mood_description['neg_alone'] = '지금 내겐 노예가 단 한 명도 없다. 어쩐지 너무 외롭다…'
$master_bad_mood[] = 'neg_escape'        & $mood_description['neg_escape'] = '내 노예가 밤사이 내가 자는 동안 달아났다. 돈도 시간도 아깝기 짝이 없다. 이제 새 노예를 사야 한다.'
$master_bad_mood[] = 'neg_slave_suicidal'& $mood_description['neg_slave_suicidal'] = '그 배은망덕한 년이 자살하려고 했다! 조수가 겨우 막아 냈지만, 어젯밤엔 누구도 제대로 잠들지 못했다.'
$master_bad_mood[] = 'neg_slave_died'    & $mood_description['neg_slave_died'] = '나는 그 노예를 살리지 못했다. 병원에 데려갔어야 했나 보다… 이제는 너무 늦었다.'
$master_bad_mood[] = 'neg_slave_killed'  & $mood_description['neg_slave_killed'] = '훈련 도중 노예가 죽었다. 앞으로는 상품을 더 조심히 다뤄야겠다.'
$master_bad_mood[] = 'neg_slave_starved' & $mood_description['neg_slave_starved'] = '노예에게 먹을 걸 더 줬어야 했다. 이제 새 놈을 들여와야 한다…'
$master_bad_mood[] = 'neg_rebell'        & $mood_description['neg_rebell'] = '노예가 내 말을 전혀 듣지 않는다. 아직 손볼 일이 많다…'
$master_bad_mood[] = 'neg_grumpy'        & $mood_description['neg_grumpy'] = '젠장, 내 노예는 어쩌면 이렇게 재미없는 인간이지! 일할 마음도 안 난다 - 지루해 죽겠다.'
$master_bad_mood[] = 'neg_no_food'		 & $mood_description['neg_no_food'] = '어제 너무 바빠서 밥을 못 먹었다 - 지금은 기분도 엉망이고 배에서는 요란하게 꼬르륵거린다!'


!unused
!$master_bad_mood[] = 'neg_master_precious'  & $mood_description['neg_master_precious'] = 'What a pity that I had to take my magic decoration off. It is my precious! I need to put it back and never take it off.'


!no need for variants of the slave moodlets for different slave types, they are all interchangeable, only the mood descriptions strings are character-specific (slave name vs. assistant name, for example) - ImperatorAugustus
!when we use the strings, we will replace any occurrence of 'dynslave' with the correct slave variable and evaluate any subexpressions (e.g., dynamic "$newvar = '<<$string_containing_subexpressions>>'")
!DISABLESUBEX delays subexpression evaluation of the strings defined below


DISABLESUBEX=1
!positive slave moodlets (listed in the order they will appear [if present] in the "how are you feeling?" dialog)
killvar '$slave_good_mood'
! JO9 MOD START J9M2450 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$slave_good_mood[] = 'pos_slave_winner'             & $mood_description['pos_slave_winner'] = '[<<$dynslave_name>>]<br>&nbsp;만세, 우리가 이겼어요! 정말 대단했어요. 훨씬 자신감이 생겼어요.'
$slave_good_mood[] = 'pos_multiple_orgasm'          & $mood_description['pos_multiple_orgasm'] = '[<<$dynslave_name>>]<br>&nbsp;아아, 정말 멋진 섹스였어요! 천국 같은 쾌감이었어요… 한 번 더 느끼고 싶어요.'
$slave_good_mood[] = 'pos_slave_kannabis'           & $mood_description['pos_slave_kannabis'] = '[<<$dynslave_name>>]<br>&nbsp;우우우… …이 풀, 진짜 물건이네요. 너무 황홀해요. 느긋한 음악도 좀 틀어야겠어요.'
$slave_good_mood[] = 'pos_slave_opium'              & $mood_description['pos_slave_opium'] = '[<<$dynslave_name>>]<br>&nbsp;기분 좋아요. 망각이 제 혈관을 타고 흘러가며 고통과 슬픔을 다 쓸어 가는 느낌이에요.'
$slave_good_mood[] = 'pos_slave_alco'               & $mood_description['pos_slave_alco'] = '[<<$dynslave_name>>]<br>&nbsp;저… 딸꾹… 너어어어무 취했어요. 왜 절 취하게 만든 거예요, 응? 제… 딸꾹… 무방비한 처지를 이용해 먹으려는 거예요?'
$slave_good_mood[] = 'pos_no_punish'                & $mood_description['pos_no_punish'] = '[<<$dynslave_name>>]<br>&nbsp;제가 잘못한 걸 알면서도 벌하지 않으셨네요. 절 불쌍히 여겨 주신다는 걸 알게 되니 좋네요 ^ _ ^'
$slave_good_mood[] = 'pos_ineffective_punishment'   & $mood_description['pos_ineffective_punishment'] = '[<<$dynslave_name>>]<br>&nbsp;절 벌주려 하신 건 알겠지만, 생각했던 것만큼 심하진 않았어요…'
$slave_good_mood[] = 'pos_gentle'                   & $mood_description['pos_gentle'] = '[<<$dynslave_name>>]<br>&nbsp;누군가의 보살핌과 애정을 느낄 수 있다는 건 참 좋네요…'
$slave_good_mood[] = 'pos_praise'                   & $mood_description['pos_praise'] = '[<<$dynslave_name>>]<br>&nbsp;주인의 정당한 칭찬에 기뻤어요.'
$slave_good_mood[] = 'pos_slave_date'               & $mood_description['pos_slave_date'] = '[<<$dynslave_name>>]<br>&nbsp;함께 산책해서 정말 좋았어요. 다음에 또 나가고 싶어요!'
$slave_good_mood[] = 'pos_games'                    & $mood_description['pos_games'] = '[<<$dynslave_name>>]<br>&nbsp;자유 시간에 즐길 수 있다니 - 정말 최고예요! 걱정거리에서 벗어나는 건 참 좋네요.'
$slave_good_mood[] = 'pos_dessert'                  & $mood_description['pos_dessert'] = '[<<$dynslave_name>>]<br>&nbsp;아직도 달콤한 간식의 맛이 기억나요. 음… 맛있어요!'
$slave_good_mood[] = 'pos_reward'                   & $mood_description['pos_reward'] = '[<<$dynslave_name>>]<br>&nbsp;잘했을 때 보상을 받는 건 기분 좋아요.'
$slave_good_mood[] = 'pos_spellguarded'             & $mood_description['pos_spellguarded'] = '[<<$dynslave_name>>]<br>&nbsp;제 의지가 당신의 주문보다 강했어요! 훨씬 더 자신감이 생겼어요.'
$slave_good_mood[] = 'pos_cookie'                   & $mood_description['pos_cookie'] = '[<<$dynslave_name>>]<br>&nbsp;정말 맛있는 음식을 먹었어요, 그건 확실히 좋은 일이에요. 주인님 식탁에 오르는 음식은 제 밥그릇 안보다 훨씬 낫네요.'
$slave_good_mood[] = 'pos_sleep'                    & $mood_description['pos_sleep'] = '[<<$dynslave_name>>]<br>&nbsp;제 방에서 푹 잤어요. 가끔은 편안하게 쉬는 게 참 좋네요.'
$slave_good_mood[] = 'pos_slept_with_master'        & $mood_description['pos_slept_with_master'] = '[<<$dynslave_name>>]<br>&nbsp;어젯밤 주인님 침대에서 잘 수 있어서 정말 좋았어요.'
$slave_good_mood[] = 'pos_job'                      & $mood_description['pos_job'] = '[<<$dynslave_name>>]<br>&nbsp;제가 좋아하는 일을 했더니 마음이 한결 가벼워졌어요.'
$slave_good_mood[] = 'pos_cow'                      & $mood_description['pos_cow'] = '[<<$dynslave_name>>]<br>&nbsp;이 젖가슴이 너무 자랑스러워요… 젖 짜이는 게 이렇게 좋을 줄은 몰랐어요…'
$slave_good_mood[] = 'pos_barn'                     & $mood_description['pos_barn'] = '[<<$dynslave_name>>]<br>&nbsp;우리 안에서 뒹굴며 지내는 건 정말 좋았어요. 다시 외양간에 가고 싶어요, 제발… 음머어!'
$slave_good_mood[] = 'pos_slave_clean'              & $mood_description['pos_slave_clean'] = '[<<$dynslave_name>>]<br>&nbsp;방금 씻고 왔어요. 깨끗하고 산뜻한 기분은 참 좋네요.'
$slave_good_mood[] = 'pos_well_rested'              & $mood_description['pos_well_rested'] = '[<<$dynslave_name>>]<br>&nbsp;어제 푹 쉬었어요. 가끔은 느긋하게 늘어지는 것도 기분 좋네요.'
$slave_good_mood[] = 'pos_orgasm'                   & $mood_description['pos_orgasm'] = '[<<$dynslave_name>>]<br>&nbsp;음… 제대로 풀리니까 정말 좋았어요. 그런 식으로 한 번 더 싸도 전혀 상관없어요…'
$slave_good_mood[] = 'pos_clothes'                  & $mood_description['pos_clothes'] = '[<<$dynslave_name>>]<br>&nbsp;제 옷이 정말 편해요. 어디 하나 조이지도 않고 움직임도 방해하지 않아요.'
$slave_good_mood[] = 'pos_pony'                     & $mood_description['pos_pony'] = '[<<$dynslave_name>>]<br>&nbsp;저에겐 제 작은 조랑말도 있어요 - 그 애와 함께 있으면 언제나 즐거워요!'
$slave_good_mood[] = 'pos_slave_love'               & $mood_description['pos_slave_love'] = '[<<$dynslave_name>>]<br>&nbsp;저항할 수 없는 어떤 힘이 저를 주인님께로 끌어당겨요. 늘 주인님 생각만 나요. 곁에 있고 싶어요… 영원히.'
$slave_good_mood[] = 'pos_moral'                    & $mood_description['pos_moral'] = '[<<$dynslave_name>>]<br>&nbsp;전 언제나 주인님을 섬길 수 있어 행복해요. 저 착한 아이 맞죠, 주인님?'
$slave_good_mood[] = 'pos_'                         & $mood_description['pos_'] = '[<<$dynslave_name>>]<br>&nbsp;전 괜찮아요. 딱히 특별한 건 없어요…'
$slave_good_mood[] = 'pos_sa_promote'          		& $mood_description['pos_sa_promote'] = '[<<$dynslave_name>>]<br>&nbsp;저를 조수로 삼아 주셔서 영광이에요. 이제 저는 단순한 하인이 아니에요. 그게 제게 자신감을 줘요.'
$slave_good_mood[] = 'pos_sa_friendship'       		& $mood_description['pos_sa_friendship'] = '[<<$dynslave_name>>]<br>&nbsp;주인님의 노예가 제 삶을 환하게 밝혀 줘요 – 이제 이야기 나눌 상대가 생겼으니까요.'
$slave_good_mood[] = 'pos_sa_love'             		& $mood_description['pos_sa_love'] = '[<<$dynslave_name>>]<br>&nbsp;주인님의 노예는 제게 아주 소중한 존재예요. 이렇게 중요한 사람이 곁에 있다는 건 멋진 일이에요.'
$slave_good_mood[] = 'pos_sa_sadist'           		& $mood_description['pos_sa_sadist'] = '[<<$dynslave_name>>]<br>&nbsp;저 쓰레기를 벌주게 해 주셔서 감사합니다! 정말 즐거웠어요.'
$slave_good_mood[] = 'pos_sa_enemy_prisoned'   		& $mood_description['pos_sa_enemy_prisoned'] = '[<<$dynslave_name>>]<br>&nbsp;그 쓰레기를 가둬 두셨군요. 잘됐어요! 그놈이 없으니 집안 공기조차 한결 가벼워졌어요.'
$slave_good_mood[] = 'pos_sa_enemy_punished'   		& $mood_description['pos_sa_enemy_punished'] = '[<<$dynslave_name>>]<br>&nbsp;그 쓰레기를 벌주셔서 정말 좋았어요, 주인님. 앞으로도 자주 그렇게 해 주세요.'
$slave_good_mood[] = 'pos_slave_love2'         		& $mood_description['pos_slave_love2'] = '[<<$dynslave_name>>]<br>&nbsp;주인님을 보면 배 속에서 나비가 날아다니기 시작해요. 절 좋아하시죠, 그렇죠?'
$slave_good_mood[] = 'pos_slave_love3'         		& $mood_description['pos_slave_love3'] = '[<<$dynslave_name>>]<br>&nbsp;주인님 곁에 있으면 안전하다고 느껴져요. 주인님이 저를 지켜 주고 받쳐 주실 거라는 걸 알아요.'
$slave_good_mood[] = 'pos_slave_love4'         		& $mood_description['pos_slave_love4'] = '[<<$dynslave_name>>]<br>&nbsp;주인님 생각만 해도 젖어요. 여기, 직접 만져 보세요…'
$slave_good_mood[] = 'pos_slave_love5'         		& $mood_description['pos_slave_love5'] = '[<<$dynslave_name>>]<br>&nbsp;저는 나쁜 아이였고 벌받아 마땅했어요. 주인님이 절 벌주실 때가 정말 좋아요.'
$slave_good_mood[] = 'pos_slave_love6'         		& $mood_description['pos_slave_love6'] = '[<<$dynslave_name>>]<br>&nbsp;전 늘 주인님과 함께 있고 싶어요. 저를 떠나지 말아 주세요, 주인님. 주인님이 없으면 무서워요.'
$slave_good_mood[] = 'pos_master_vampire'      		& $mood_description['pos_master_vampire'] = '[<<$dynslave_name>>]<br>&nbsp;그 송곳니를 한 주인님, 정말 섹시해요! 주인님이 제 피를 마시는 상상만으로도 흥분돼요…'
! JO9 MOD END J9M2450




!unused
!$slave_good_mood[] = 'pos_artifact'                 & $mood_description['pos_artifact'] = '  [<<$dynslave_name>>]<br>- This magic decoration just superb. While I wear it, the world seems a lot better than it is. I will never take it off!'

!negative slave moodlets (listed in the order they will appear [if present] in the "how are you feeling?" dialog)
killvar '$slave_bad_mood'
! JO9 MOD START J9M2449 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$slave_bad_mood[] = 'neg_slave'                     & $mood_description['neg_slave'] = '[<<$dynslave_name>>]<br>&nbsp;전 이 낯설고 이상한 세계에 떨어지자마자 곧바로 노예가 되어 버렸어요. 제가 어떤 기분일 것 같아요?'
$slave_bad_mood[] = 'neg_angst'                     & $mood_description['neg_angst'] = '[<<$dynslave_name>>]<br>&nbsp;내일, 아니 다음 순간에 제게 무슨 일이 닥칠지도 몰라요. 왜 살아야 하는 거죠? 절망 때문에 울부짖고 싶어요…'
$slave_bad_mood[] = 'neg_fear'                      & $mood_description['neg_fear'] = '[<<$dynslave_name>>]<br>&nbsp;전 어떤 잘못을 해도 주인님이 절 벌할 수 있다는 걸 알아요. 그래서 늘 두려움 속에 살아요. 온갖 끔찍한 상상이 머릿속에서 떠나질 않아요.'
$slave_bad_mood[] = 'neg_slave_meth'                & $mood_description['neg_slave_meth'] = '[<<$dynslave_name>>]<br>&nbsp;너무 괴로워요. 정말, 정말 괴로워요. 입은 바싹 마르고, 힘은 빠지고, 근육은 쑤시고… 가루가 필요해요!'
$slave_bad_mood[] = 'neg_slave_opium'               & $mood_description['neg_slave_opium'] = '[<<$dynslave_name>>]<br>&nbsp;못 버티겠어요. 지금 당장 한 대 맞아야 해요! 아, 제발… 부탁이에요…'
$slave_bad_mood[] = 'neg_slave_koffe'               & $mood_description['neg_slave_koffe'] = '[<<$dynslave_name>>]<br>&nbsp;캄라를 마시기 전엔 도무지 잠이 깨질 않아요. 눈도 못 뜨겠어요.'
$slave_bad_mood[] = 'neg_slave_alco'                & $mood_description['neg_slave_alco'] = '[<<$dynslave_name>>]<br>&nbsp;아직도 어제 마신 술 때문에 머리가 아파요. 이렇게 많이 마시면 안 됐어요.'
$slave_bad_mood[] = 'neg_slave_loser'               & $mood_description['neg_slave_loser'] = '[<<$dynslave_name>>]<br>&nbsp;이 패배는 제 잘못이 아니에요! 상대가 너무 강했단 말이에요…'
$slave_bad_mood[] = 'neg_slave_wounded'             & $mood_description['neg_slave_wounded'] = '[<<$dynslave_name>>]<br>&nbsp;상처가 욱신거려요. 조금만 잘못 움직여도 아파요.'
$slave_bad_mood[] = 'neg_ugly'                      & $mood_description['neg_ugly'] = '[<<$dynslave_name>>]<br>&nbsp;이 멍이랑 긁힌 자국들 좀 봐요… 절 망가뜨려 놨어요. 거울 속 제 모습을 보는 것조차 무서워요.'
$slave_bad_mood[] = 'neg_hungry'                    & $mood_description['neg_hungry'] = '[<<$dynslave_name>>]<br>&nbsp;먹을 것도 충분히 못 받았는데 일을 너무 많이 했어요. 몸에 힘이 없어요.'
$slave_bad_mood[] = 'neg_starvation'                & $mood_description['neg_starvation'] = '[<<$dynslave_name>>]<br>&nbsp;정말 너무 안 좋아요. 어지러워요.'
$slave_bad_mood[] = 'neg_exhausted'                 & $mood_description['neg_exhausted'] = '[<<$dynslave_name>>]<br>&nbsp;너무 피곤해요. 쉬어야 해요.'
$slave_bad_mood[] = 'neg_raped'                     & $mood_description['neg_raped'] = '[<<$dynslave_name>>]<br>&nbsp;절 강간했어요! 더럽혀지고 짓밟히고 유린당한 기분이에요.'
$slave_bad_mood[] = 'neg_defloration'               & $mood_description['neg_defloration'] = '[<<$dynslave_name>>]<br>&nbsp;처음 하는 섹스는<<iif(dynslave["courage"] ! 2, " 무섭고", "")>> 아파요. 아직도 거기가 욱신거려요…'
$slave_bad_mood[] = 'neg_barn_plus'                 & $mood_description['neg_barn_plus'] = '[<<$dynslave_name>>]<br>&nbsp;네, 그곳, 그… 외양간… 정말 끔찍하고 숨 막혔어요… 악몽 같았어요.'
$slave_bad_mood[] = 'neg_barn'                      & $mood_description['neg_barn'] = '[<<$dynslave_name>>]<br>&nbsp;그렇게 오래 외양간에 가둬 두다니… 절 무슨 동물처럼 다뤄선 안 돼요! 제발, 다시는 거기로 보내지 마세요…'
$slave_bad_mood[] = 'neg_cow'                       & $mood_description['neg_cow'] = '[<<$dynslave_name>>]<br>&nbsp;젖가슴에서 계속 젖이 흘러요… 너무 끔찍해요. 전 젖소가 되고 싶지 않아요!'
$slave_bad_mood[] = 'neg_pain'                      & $mood_description['neg_pain'] = '[<<$dynslave_name>>]<br>&nbsp;절 아프게 했어요. 아직도 그 고통이 남아 있어요. 사라지질 않아요.'
$slave_bad_mood[] = 'neg_forced'                    & $mood_description['neg_forced'] = '[<<$dynslave_name>>]<br>&nbsp;절 억지로 추하고 더러운 짓에 끌어들였어요. 너무 무력해요. 게다가 멍도 아파요.'
$slave_bad_mood[] = 'neg_spellbound'                & $mood_description['neg_spellbound'] = '[<<$dynslave_name>>]<br>&nbsp;당신의 사악한 주문이 절 짓눌렀어요. 머릿속에서 이상한 목소리들이 속삭여요. 절 미치게 만들어요!'
$slave_bad_mood[] = 'neg_shame'                     & $mood_description['neg_shame'] = '[<<$dynslave_name>>]<br>&nbsp;세상에, 아직도 너무 창피해요. 왜 그런 식으로 저를 전시하게 만든 거예요?'
$slave_bad_mood[] = 'neg_no_praise'                 & $mood_description['neg_no_praise'] = '[<<$dynslave_name>>]<br>&nbsp;잘하려고 그렇게 애썼는데도 좋은 말 한마디도 안 해 주셨어요.'
$slave_bad_mood[] = 'neg_abuse'                     & $mood_description['neg_abuse'] = '[<<$dynslave_name>>]<br>&nbsp;그렇게 심하게 욕을 퍼부으셔서 아직도 속이 메스꺼워요.'
$slave_bad_mood[] = 'neg_disgust'                   & $mood_description['neg_disgust'] = '[<<$dynslave_name>>]<br>&nbsp;그 끔찍한 일들을 잊을 수가 없어요. 고통조차, 당신이 저한테 하는 그 역겹고 끔찍한 짓들보다는 견디기 쉬워요.'
$slave_bad_mood[] = 'neg_slave_food'                & $mood_description['neg_slave_food'] = '[<<$dynslave_name>>]<br>&nbsp;주시는 음식이 정말 형편없어요. 솔직히 말하면 너무 역겨워서, 삼키느니 차라리 굶는 게 나을 정도예요…'
$slave_bad_mood[] = 'neg_bad_sleep'                 & $mood_description['neg_bad_sleep'] = '[<<$dynslave_name>>]<br>&nbsp;잠자리 상태가 정말 최악이에요. 그런 "휴식"을 하고 나면 온몸이 저리고 쑤셔요…'
$slave_bad_mood[] = 'neg_slept_with_master'         & $mood_description['neg_slept_with_master'] = '[<<$dynslave_name>>]<br>&nbsp;주인님 침대가 바닥보단 부드럽긴 해도, 잠은 오질 않아요…'
$slave_bad_mood[] = 'neg_slave_mess'                & $mood_description['neg_slave_mess'] = '[<<$dynslave_name>>]<br>&nbsp;지금 집안은 엉망진창이에요. 설거지도 안 돼 있고, 모든 게 뒤집혀 있어요. 살기 좋은 환경은 아니네요.'
$slave_bad_mood[] = 'neg_slave_ill'                 & $mood_description['neg_slave_ill'] = '[<<$dynslave_name>>]<br>&nbsp;화장실 갈 때 아프고 분비물도 이상해 보여요. 뭔가 옮은 것 같아요…'
$slave_bad_mood[] = 'neg_slave_dirty'               & $mood_description['neg_slave_dirty'] = '[<<$dynslave_name>>]<br>&nbsp;더럽고 냄새나서 온몸이 가려워요. 씻고 싶어요…'
$slave_bad_mood[] = 'neg_menstruation'              & $mood_description['neg_menstruation'] = '[<<$dynslave_name>>]<br>&nbsp;저 그날이에요… 생리 중이라서요. 그래서 기분도 별로고 예민해요…'
$slave_bad_mood[] = 'neg_job'                       & $mood_description['neg_job'] = '[<<$dynslave_name>>]<br>&nbsp;지루하고 불쾌한 일을 시키시잖아요. 그래서 기분이 나빠요.'
$slave_bad_mood[] = 'neg_prisoner'                  & $mood_description['neg_prisoner'] = '[<<$dynslave_name>>]<br>&nbsp;감옥에서 너무 오랜 시간을 보냈어요. 전혀 즐거운 경험이 아니었어요…'
$slave_bad_mood[] = 'neg_naked'                     & $mood_description['neg_naked'] = '[<<$dynslave_name>>]<br>&nbsp;아무 데서나 벌거벗고 다녀야 해요. 춥고 창피해요.'
$slave_bad_mood[] = 'neg_clothes'                   & $mood_description['neg_clothes'] = '[<<$dynslave_name>>]<br>&nbsp;저한테 입혀 놓은 옷이 너무 불편해요.'
$slave_bad_mood[] = 'neg_horny'                     & $mood_description['neg_horny'] = '[<<$dynslave_name>>]<br>&nbsp;모든<<$little_txt>> <<$slave_noun4[dynslave["age"]]>>에게는 때때로 약간의 애정이 필요해요. 이게 없으면 너무 슬퍼요…'
$slave_bad_mood[] = 'neg_rules'                     & $mood_description['neg_rules'] = '[<<$dynslave_name>>]<br>&nbsp;당신이 억지로 따르게 하는 그 끔찍한 규칙들 전부가… 전혀 삶의 즐거움을 더해 주질 않아요.'
$slave_bad_mood[] = 'neg_spoil'                     & $mood_description['neg_spoil'] = '[<<$dynslave_name>>]<br>&nbsp;당신은 절 전혀 아껴 주지 않아요! 이것 좀 봐요, 이게 무슨 꼴이에요?! 기분 좀 풀어 주든가 해요! 지루하단 말이에요!'
$slave_bad_mood[] = 'neg_cheap_gift'                & $mood_description['neg_cheap_gift'] = '[<<$dynslave_name>>]<br>&nbsp;약속하신 특별한 선물은 언제 주실 건가요?'
$slave_bad_mood[] = 'neg_cheap_reward'              & $mood_description['neg_cheap_reward'] = '[<<$dynslave_name>>]<br>&nbsp;약속한 보상이… 이게 다예요?'
$slave_bad_mood[] = 'neg_pony_died'                 & $mood_description['neg_pony_died'] = '[<<$dynslave_name>>]<br>&nbsp;제 작은 조랑말이 죽었어요!'
$slave_bad_mood[] = 'neg_'                          & $mood_description['neg_'] = '[<<$dynslave_name>>]<br>&nbsp;아무렇지도 않아요. 전혀 신경 안 써요.'
$slave_bad_mood[] = 'neg_master_vampire'            & $mood_description['neg_master_vampire'] = '[<<$dynslave_name>>]<br>&nbsp;당신이 언제든 제 피를 마실 수 있다고 생각하면 너무 무서워요. 당신이 두려워요!'
$slave_bad_mood[] = 'neg_sa_catfight'               & $mood_description['neg_sa_catfight'] = '[<<$dynslave_name>>]<br>&nbsp;주인님, 일이 이렇게 주먹질로 번진 건 죄송하지만, 저 여자가 억지로 그렇게 만들었어요!'
$slave_bad_mood[] = 'neg_sa_love_lost2'             & $mood_description['neg_sa_love_lost2'] = '[<<$dynslave_name>>]<br>&nbsp;전 그 애를 정말 사랑했어요! 그런데 운명이 우리를 갈라놨어요. 그래도 주인님이 계셔서 다행이에요.'
$slave_bad_mood[] = 'neg_sa_jealous'                & $mood_description['neg_sa_jealous'] = '[<<$dynslave_name>>]<br>&nbsp;주인님은 다른 여자들이랑 너무 많은 시간을 보내세요! 전 주인님의 관심이 그리워요.'
$slave_bad_mood[] = 'neg_sa_nonfriendly'            & $mood_description['neg_sa_nonfriendly'] = '[<<$dynslave_name>>]<br>&nbsp;주인님, 주인님의 하인과 같은 집에서 사는 게 너무 힘들어요. 그 애는 저를 좋아하지 않아요.'
$slave_bad_mood[] = 'neg_sa_rivalry'                & $mood_description['neg_sa_rivalry'] = '[<<$dynslave_name>>]<br>&nbsp;주인님, 저 년은 자기가 제일 중요한 줄 알아요! 하지만 결국 그냥 노예일 뿐이잖아요!'
$slave_bad_mood[] = 'neg_sa_demote'                 & $mood_description['neg_sa_demote'] = '[<<$dynslave_name>>]<br>&nbsp;저를 그냥 평범한 노예로 만들어 버리셨어요! 제가 그렇게 충실하게 섬겼는데도요! 왜 그러셨어요, 주인님?'
$slave_bad_mood[] = 'neg_sa_friend_prisoned'        & $mood_description['neg_sa_friend_prisoned'] = '[<<$dynslave_name>>]<br>&nbsp;제 친구를 감옥에 넣으셨어요. 걔가 벌받을 짓을 했더라도, 전 여전히 마음이 아파요.'
$slave_bad_mood[] = 'neg_sa_friend_punished'        & $mood_description['neg_sa_friend_punished'] = '[<<$dynslave_name>>]<br>&nbsp;제 친구를 벌주셨어요. 그게 교육 과정의 일부라는 건 이해하지만, 그래도 슬퍼요.'
$slave_bad_mood[] = 'neg_sa_love_lost1'             & $mood_description['neg_sa_love_lost1'] = '[<<$dynslave_name>>]<br>&nbsp;전 그 애를 사랑했어요! 진심으로요, 아시겠어요? 주인님이 뭘 알겠어요? 그런 감정은 아마 한 번도 느껴 본 적도 없겠죠...'
$slave_bad_mood[] = 'neg_sa_ill'                    & $mood_description['neg_sa_ill'] = '[<<$dynslave_name>>]<br>&nbsp;그 애가 빨리 나았으면 좋겠어요. 건강이 걱정돼요.'
$slave_bad_mood[] = 'neg_not_sleep_together'        & $mood_description['neg_not_sleep_together'] = '[<<$dynslave_name>>]<br>&nbsp;어젯밤 정말 외로웠어요, 주인님. 왜 전 주인님 침대에서 자면 안 되나요?'
$slave_bad_mood[] = 'neg_another_sleep_together'    & $mood_description['neg_another_sleep_together'] = '[<<$dynslave_name>>]<br>&nbsp;그 년이 주인님과 같이 잤어요. 그 생각만 해도 가슴이 아파요. 목 졸라 죽여 버리고 싶어요.'
! JO9 MOD END J9M2449


!unused
!$slave_bad_mood[] = 'neg_artifact'          & $mood_description['neg_artifact'] = '  [<<$dynslave_name>>]<br>- My magic decoration! My… My… precioooous… Angry master took it away from us… gollum… poor… poor us… so lonely…'

killvar '$assistant_bad_mood'
! JO9 MOD START J9M2448 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$assistant_bad_mood[] = 'neg_slave'              & $mood_description_assistant['neg_slave'] = '[<<$dynslave_name>>]<br>&nbsp;이 낯설고 이상한 세계에 떨어지자마자 바로 노예가 되어 버렸어요. 제가 어떤 기분일 것 같아요?'
$assistant_bad_mood[] = 'neg_angst'              & $mood_description_assistant['neg_angst'] = '[<<$dynslave_name>>]<br>&nbsp;내일, 아니 다음 순간에 제게 무슨 일이 생길지 전혀 모르겠어요. 왜 살아야 하죠? 절망 때문에 울부짖고 싶어요…'
$assistant_bad_mood[] = 'neg_fear'               & $mood_description_assistant['neg_fear'] = '[<<$dynslave_name>>]<br>&nbsp;당신이 제가 뭘 잘못하든 벌할 수 있다는 걸 알아요. 그래서 전 늘 두려움 속에서 살아요. 온갖 공포스러운 생각이 머릿속을 떠나질 않아요.'
$assistant_bad_mood[] = 'neg_pain'               & $mood_description_assistant['neg_pain'] = '[<<$dynslave_name>>]<br>&nbsp;당신이 절 아프게 했어요. 아직도 느껴져요. 사라지질 않아요.'
$assistant_bad_mood[] = 'neg_abuse'              & $mood_description_assistant['neg_abuse'] = '[<<$dynslave_name>>]<br>&nbsp;너무 심하게 욕을 해서 아직도 속이 메스꺼워요.'
$assistant_bad_mood[] = 'neg_disgust'            & $mood_description_assistant['neg_disgust'] = '[<<$dynslave_name>>]<br>&nbsp;그 끔찍한 일들을 전부 잊을 수가 없어요. 당신이 제게 하는 그 역겹고 끔찍한 짓들에 비하면, 고통조차 견디기 더 쉬워요.'
$assistant_bad_mood[] = 'neg_sick'               & $mood_description_assistant['neg_sick'] = '[<<$dynslave_name>>]<br>&nbsp;정말 너무 안 좋아요. 머리가 빙빙 돌아요.'
$assistant_bad_mood[] = 'neg_menstruation'       & $mood_description_assistant['neg_menstruation'] = '[<<$dynslave_name>>]<br>&nbsp;생리 중이에요. 배도 아프고 기분도 가라앉아 있어요.'
$assistant_bad_mood[] = 'neg_slave_food'         & $mood_description_assistant['neg_slave_food'] = '[<<$dynslave_name>>]<br>&nbsp;주시는 음식이 정말 형편없어요. 이걸 먹느니 차라리 굶는 게 나아요…'
$assistant_bad_mood[] = 'neg_slave_dirty'        & $mood_description_assistant['neg_slave_dirty'] = '[<<$dynslave_name>>]<br>&nbsp;더럽고 가려워요. 씻어야겠어요…'
$assistant_bad_mood[] = 'neg_slave_mess'         & $mood_description_assistant['neg_slave_mess'] = '[<<$dynslave_name>>]<br>&nbsp;집이 완전히 난장판이에요. 전혀 쾌적하지 않아요.'
$assistant_bad_mood[] = 'neg_hungry'             & $mood_description_assistant['neg_hungry'] = '[<<$dynslave_name>>]<br>&nbsp;너무 배고파요. 제대로 된 음식을 먹어야 해요.'
$assistant_bad_mood[] = 'neg_exhausted'          & $mood_description_assistant['neg_exhausted'] = '[<<$dynslave_name>>]<br>&nbsp;너무 지쳤어요. 쉬어야 해요.'
$assistant_bad_mood[] = 'neg_no_praise'          & $mood_description_assistant['neg_no_praise'] = '[<<$dynslave_name>>]<br>&nbsp;그렇게 열심히 했는데도 좋은 말 한마디 안 해 주셨어요.'
$assistant_bad_mood[] = 'neg_shame'              & $mood_description_assistant['neg_shame'] = '[<<$dynslave_name>>]<br>&nbsp;아직도 너무 창피해요. 왜 저한테 그런 짓을 시키신 거예요?'
$assistant_bad_mood[] = 'neg_rules'              & $mood_description_assistant['neg_rules'] = '[<<$dynslave_name>>]<br>&nbsp;억지로 따르게 하는 이 모든 규칙들이… 전혀 즐겁지 않아요.'
$assistant_bad_mood[] = 'neg_spoil'              & $mood_description_assistant['neg_spoil'] = '[<<$dynslave_name>>]<br>&nbsp;당신은 절 전혀 아껴 주지 않아요! 이것 좀 보세요, 이게 무슨 꼴이에요! 기분 좀 풀어 주세요… 지루해요!'
$assistant_bad_mood[] = 'neg_bad_sleep'          & $mood_description_assistant['neg_bad_sleep'] = '[<<$dynslave_name>>]<br>&nbsp;잠자리 상태가 정말 최악이에요. 이런 "휴식"을 하고 나면 온몸이 쑤셔요.'
$assistant_bad_mood[] = 'neg_prisoner'           & $mood_description_assistant['neg_prisoner'] = '[<<$dynslave_name>>]<br>&nbsp;너무 오랫동안 갇혀 있었어요. 전혀 즐겁지 않았어요…'
$assistant_bad_mood[] = 'neg_naked'              & $mood_description_assistant['neg_naked'] = '[<<$dynslave_name>>]<br>&nbsp;벌거벗고 돌아다녀야 해요. 창피하고 추워요.'
$assistant_bad_mood[] = 'neg_job'                & $mood_description_assistant['neg_job'] = '[<<$dynslave_name>>]<br>&nbsp;지루하고 불쾌한 일을 시키시잖아요. 그래서 기분이 망가져요.'
$assistant_bad_mood[] = 'neg_horny'              & $mood_description_assistant['neg_horny'] = '[<<$dynslave_name>>]<br>&nbsp;가끔은 누구나 애정이 필요하잖아요. 그런 게 없으면 전 슬퍼져요…'
$assistant_bad_mood[] = 'neg_forced'             & $mood_description_assistant['neg_forced'] = '[<<$dynslave_name>>]<br>&nbsp;절 억지로 불쾌한 짓에 끌어들였어요. 너무 무력하고, 몸도 아파요.'
$assistant_bad_mood[] = 'neg_raped'              & $mood_description_assistant['neg_raped'] = '[<<$dynslave_name>>]<br>&nbsp;절 강간했어요! 더럽고 유린당한 기분이에요.'
$assistant_bad_mood[] = 'neg_defloration'        & $mood_description_assistant['neg_defloration'] = '[<<$dynslave_name>>]<br>&nbsp;첫 섹스는<<iif(dynslave["courage"] ! 2, " 무섭고", "")>> 아파요. 아직도 거기가 욱신거려요…'
$assistant_bad_mood[] = 'neg_spellbound'         & $mood_description_assistant['neg_spellbound'] = '[<<$dynslave_name>>]<br>&nbsp;당신의 주문이 절 짓누르고 있어요. 이상한 속삭임이 머릿속을 가득 채워 절 미치게 해요!'
$assistant_bad_mood[] = 'neg_artifact'           & $mood_description_assistant['neg_artifact'] = '[<<$dynslave_name>>]<br>&nbsp;제 마법 물건! 제 소중한 것… 잔인한 주인이 그걸 빼앗아 갔어요… 너무 외로워요…'
$assistant_bad_mood[] = 'neg_master_vampire'     & $mood_description_assistant['neg_master_vampire'] = '[<<$dynslave_name>>]<br>&nbsp;당신이 언제든 제 피를 마실 수 있다고 생각하면 너무 무서워요. 당신이 두려워요!'
! JO9 MOD END J9M2448


killvar '$assistant_good_mood'
! JO9 MOD START J9M2447 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$assistant_good_mood[] = 'pos_prise'               & $mood_description_assistant['pos_prise'] = '[<<$dynslave_name>>]<br>&nbsp;좋은 말 한마디는 언제나 기분 좋죠 :3'
$assistant_good_mood[] = 'pos_slave_date'          & $mood_description_assistant['pos_slave_date'] = '[<<$dynslave_name>>]<br>&nbsp;함께 산책해서 정말 좋았어요. 다음에도 이렇게 시간을 보내고 싶어요!'
$assistant_good_mood[] = 'pos_reward'              & $mood_description_assistant['pos_reward'] = '[<<$dynslave_name>>]<br>&nbsp;잘했을 때 보상을 받는 건 즐거운 일이에요. 기분이 좋아져요.'
$assistant_good_mood[] = 'pos_orgasm'              & $mood_description_assistant['pos_orgasm'] = '[<<$dynslave_name>>]<br>&nbsp;음… 제대로 풀리니까 정말 좋았어요. 다시 해도 전혀 상관없어요…'
$assistant_good_mood[] = 'pos_cookie'              & $mood_description_assistant['pos_cookie'] = '[<<$dynslave_name>>]<br>&nbsp;정말 잘 먹었어요, 너무 좋았어요. 주인님 음식이 제 밥그릇 안보다 훨씬 낫네요!'
$assistant_good_mood[] = 'pos_sleep'               & $mood_description_assistant['pos_sleep'] = '[<<$dynslave_name>>]<br>&nbsp;제 방에서 푹 잤어요. 가끔은 편안하게 쉬는 게 정말 좋네요.'
$assistant_good_mood[] = 'pos_slave_clean'         & $mood_description_assistant['pos_slave_clean'] = '[<<$dynslave_name>>]<br>&nbsp;방금 씻고 왔어요. 깨끗하고 산뜻한 기분은 정말 좋네요.'
$assistant_good_mood[] = 'pos_well_rested'         & $mood_description_assistant['pos_well_rested'] = '[<<$dynslave_name>>]<br>&nbsp;어제 푹 쉬었어요. 가끔은 느긋하게 늘어지는 것도 참 좋네요.'
$assistant_good_mood[] = 'pos_desert'              & $mood_description_assistant['pos_desert'] = '[<<$dynslave_name>>]<br>&nbsp;아직도 그 달콤한 간식 향이 기억나요. 음… 맛있었어요!'
$assistant_good_mood[] = 'pos_no_punish'           & $mood_description_assistant['pos_no_punish'] = '[<<$dynslave_name>>]<br>&nbsp;잘못했는데도 벌하지 않으셨네요. 절 아껴 주신다는 걸 알게 되니 좋아요 ^_^'
$assistant_good_mood[] = 'pos_moral'               & $mood_description_assistant['pos_moral'] = '[<<$dynslave_name>>]<br>&nbsp;전 언제나 주인님을 섬길 수 있어서 행복해요. 저 착한 아이 맞죠, 주인님?'
$assistant_good_mood[] = 'pos_clothes'             & $mood_description_assistant['pos_clothes'] = '[<<$dynslave_name>>]<br>&nbsp;제 옷은 정말 편해요. 어디 하나 조이지도 않고 움직임도 방해하지 않아요.'
$assistant_good_mood[] = 'pos_job'                 & $mood_description_assistant['pos_job'] = '[<<$dynslave_name>>]<br>&nbsp;제가 좋아하는 일을 하면 마음이 한결 가벼워져요.'
$assistant_good_mood[] = 'pos_games'               & $mood_description_assistant['pos_games'] = '[<<$dynslave_name>>]<br>&nbsp;자유 시간에 놀 수 있다니 정말 최고예요! 걱정거리에서 벗어나는 건 참 좋네요.'
$assistant_good_mood[] = 'pos_gentle'              & $mood_description_assistant['pos_gentle'] = '[<<$dynslave_name>>]<br>&nbsp;가끔은 누군가의 보살핌과 애정을 느낄 수 있다는 게 정말 좋네요…'
$assistant_good_mood[] = 'pos_pony'                & $mood_description_assistant['pos_pony'] = '[<<$dynslave_name>>]<br>&nbsp;저에겐 제 작은 조랑말가 있어요 – 그 애가 있으면 언제나 더 즐거워져요!'
$assistant_good_mood[] = 'pos_spellguarded'        & $mood_description_assistant['pos_spellguarded'] = '[<<$dynslave_name>>]<br>&nbsp;제 의지가 당신의 마법보다 강했어요! 정말 자신감이 생겼어요.'
$assistant_good_mood[] = 'pos_artifact'            & $mood_description_assistant['pos_artifact'] = '[<<$dynslave_name>>]<br>&nbsp;이 마법 장신구는 정말 훌륭해요. 이걸 착용하고 있으면 세상이 더 나아 보이는 것 같아요. 절대 벗고 싶지 않아요!'
$assistant_good_mood[] = 'pos_slave_kannabis'      & $mood_description_assistant['pos_slave_kannabis'] = '[<<$dynslave_name>>]<br>&nbsp;우와아… 이 풀 진짜 대단해요. 너무 느긋해져요. 부드러운 음악도 같이 있었으면 좋겠어요.'
$assistant_good_mood[] = 'pos_slave_alco'          & $mood_description_assistant['pos_slave_alco'] = '[<<$dynslave_name>>]<br>&nbsp;저… 딸꾹… 너무 취한 것 같아요. 왜 술을 주신 거예요? 제 무방비한… 딸꾹… 상태를 이용해 먹으려는 거예요?'
$assistant_good_mood[] = 'pos_slave_opium'         & $mood_description_assistant['pos_slave_opium'] = '[<<$dynslave_name>>]<br>&nbsp;기분 좋아요. 망각이 제 혈관을 타고 흘러가며 고통과 슬픔을 씻어 내리는 느낌이에요.'
$assistant_good_mood[] = 'pos_slave_drunk'         & $mood_description_assistant['pos_slave_drunk'] = '[<<$dynslave_name>>]<br>&nbsp;저… 딸꾹… 너무 취한 것 같아요. 왜 술을 주신 거예요? 제 무방비한… 딸꾹… 상태를 이용해 먹으려는 거예요?'
$assistant_good_mood[] = 'pos_slave_love'          & $mood_description_assistant['pos_slave_love'] = '[<<$dynslave_name>>]<br>&nbsp;전 주인님께 거부할 수 없이 끌려요. 늘 주인님 생각만 해요. 곁에 있고 싶어요… 언제나.'
$assistant_good_mood[] = 'pos_multiple_orgasm'     & $mood_description_assistant['pos_multiple_orgasm'] = '[<<$dynslave_name>>]<br>&nbsp;아아, 정말 멋진 섹스였어요! 천국 같은 쾌감이었어요… 다시 한 번 느끼고 싶어요.'
$assistant_good_mood[] = 'pos_slave_winner'        & $mood_description_assistant['pos_slave_winner'] = '[<<$dynslave_name>>]<br>&nbsp;만세, 우리가 이겼어요! 정말 대단했어요. 엄청 자신감이 생겼어요.'
$assistant_good_mood[] = 'pos_sa_promote'          & $mood_description_assistant['pos_sa_promote'] = '[<<$dynslave_name>>]<br>&nbsp;저를 조수로 삼아 주셔서 영광이에요. 이제 전 단순한 노예가 아니에요. 그게 절 자신 있게 만들어 줘요.'
$assistant_good_mood[] = 'pos_sa_friendship'       & $mood_description_assistant['pos_sa_friendship'] = '[<<$dynslave_name>>]<br>&nbsp;주인님의 노예는 제 존재를 환하게 밝혀 줘요 – 이제 대화할 상대가 생겼으니까요.'
$assistant_good_mood[] = 'pos_sa_love'             & $mood_description_assistant['pos_sa_love'] = '[<<$dynslave_name>>]<br>&nbsp;주인님의 노예는 제게 아주 소중한 존재예요. 이렇게 중요한 사람이 있다는 건 멋진 일이에요.'
$assistant_good_mood[] = 'pos_sa_sadist'           & $mood_description_assistant['pos_sa_sadist'] = '[<<$dynslave_name>>]<br>&nbsp;저 쓰레기를 벌주게 해 주셔서 감사해요! 정말 즐거웠어요.'
$assistant_good_mood[] = 'pos_sa_enemy_prisoned'   & $mood_description_assistant['pos_sa_enemy_prisoned'] = '[<<$dynslave_name>>]<br>&nbsp;그 쓰레기를 가둬 두셨네요. 잘됐어요! 그놈이 없으니 집안 공기조차 한결 가벼워졌어요.'
$assistant_good_mood[] = 'pos_sa_enemy_punished'   & $mood_description_assistant['pos_sa_enemy_punished'] = '[<<$dynslave_name>>]<br>&nbsp;그 쓰레기를 벌주셔서 정말 좋아요, 주인님. 앞으로도 더 자주 그렇게 해 주세요.'
$assistant_good_mood[] = 'pos_slave_love2'         & $mood_description_assistant['pos_slave_love2'] = '[<<$dynslave_name>>]<br>&nbsp;주인님을 보면 배 속에서 나비가 날기 시작해요. 절 좋아하시죠, 그렇죠?'
$assistant_good_mood[] = 'pos_slave_love3'         & $mood_description_assistant['pos_slave_love3'] = '[<<$dynslave_name>>]<br>&nbsp;주인님 곁에 있으면 안전하다고 느껴져요. 주인님이 저를 지켜 주고 받쳐 주실 거라는 걸 알아요.'
$assistant_good_mood[] = 'pos_slave_love4'         & $mood_description_assistant['pos_slave_love4'] = '[<<$dynslave_name>>]<br>&nbsp;주인님 생각만 해도 젖어요. 여기, 직접 만져 보세요…'
$assistant_good_mood[] = 'pos_slave_love5'         & $mood_description_assistant['pos_slave_love5'] = '[<<$dynslave_name>>]<br>&nbsp;전 나쁜 아이였고 벌받아 마땅했어요. 주인님이 절 벌주실 때가 정말 좋아요.'
$assistant_good_mood[] = 'pos_slave_love6'         & $mood_description_assistant['pos_slave_love6'] = '[<<$dynslave_name>>]<br>&nbsp;전 언제나 주인님과 함께 있고 싶어요. 절 떠나지 말아 주세요, 주인님. 주인님이 없으면 무서워요.'
$assistant_good_mood[] = 'pos_master_vampire'      & $mood_description_assistant['pos_master_vampire'] = '[<<$dynslave_name>>]<br>&nbsp;그 송곳니를 한 주인님, 정말 섹시해요! 주인님이 제 피를 마시는 상상만으로도 흥분돼요…'
! JO9 MOD END J9M2447


DISABLESUBEX=0

------------ #moodlet_base ------------
