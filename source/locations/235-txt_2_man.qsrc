! JO9 MOD START J9M2674 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$spectre_quest[1] = '[스펙터 경]<br>&nbsp;<<$master_name>>, 극도의 신중함이 필요한 특별 임무가 하나 있소. 불멸의 로마에서 가장 뛰어난 노예 조련사라는 당신 명성 때문에 이 제안을 하는 거요.'
	$spectre_quest[2] = '[스펙터 경]<br>&nbsp;내 형제와 나는 수년째 불화를 겪어 왔소. 그는 내 인생 대부분 동안 내 옆구리의 가시였고, 나도 이제 늙고 지쳐 그의 장난질에 진저리가 났소. 이제는 그에게 교훈을 줄 때가 되었지. 관계를 회복할 희망은 없으니 그 점은 묻지 마시오.'
	$spectre_quest[3] = '[스펙터 경]<br>&nbsp;형제에겐 아이가 하나뿐이오. 아내는 이미 아이를 가질 나이를 지났거든. 펠리시티라는 딸이 하나 있는데 아직 나이가 어리오. 그 애는 형제의 보물 같은 존재이고, 그는 펠리시티를 끔찍이 사랑하오. 펠리시티는 그에게 세상의 전부이니, 그는 그 애를 위해서라면 무슨 짓이든 할 거요.'
	$spectre_quest[4] = '[스펙터 경]<br>&nbsp;펠리시티는 교육 수준이 높고 백색 도시의 공주요. 무엇이든 은쟁반에 받들어지듯 넘치게 받으며 누구보다도 응석받이로 자랐지. 게다가 어디를 가든 사람들이 돌아볼 만큼 매우 아름답소.'
	$spectre_quest[5] = '[스펙터 경]<br>&nbsp;그 애는 처녀이기도 하고, 매우 단정하고 숙녀답소. 자존심과 응석만 방해가 되지 않는다면, 나는 그 애가 모든 면에서 완벽하다고 했을 거요. 매우 바람직하고 재능도 있어, 불멸의 로마에서 수많은 구혼자들의 선망 대상이오.'
	$spectre_quest[6] = '[스펙터 경]<br>&nbsp;내 복수 말이오. 나는 안개 근처에서 활동하는 대규모 밀수단의 우두머리에게 왕의 몸값을 치렀소. 형제가 장기 상업 여행으로 집을 비운 사이 펠리시티를 집에서 납치해 오게 하려고 말이오.'
	$spectre_quest[7] = '[스펙터 경]<br>&nbsp;나는 당신이 그 애를 노예로 만들고 훈련시키길 원하오. 당신은 빈민가로 가서 밀수꾼들에게서 펠리시티를 사 와야 하오. 왕의 몸값만 한 돈이 들겠지만, 내가 준비한 보상은 시간과 경비를 훨씬 넘치게 보상해 줄 거요.'
	$spectre_quest[8] = '[스펙터 경]<br>&nbsp;밀수꾼들은 펠리시티를 사람들 눈에 띄지 않게 단단히 숨겨 두었소. 그들은 오직 당신에게만 그 애를 팔 거요. 펠리시티를 집에서 빼돌릴 때 밀수꾼들이 예상보다 훨씬 많은 인원을 잃은 모양이라, 추가 보상을 몹시 서두르고 있소.'
	$spectre_quest[9] = '[스펙터 경]<br>&nbsp;내 동생은 천재라서 평생 나를 한수 위였지만, 이제 그건 끝이다. 드디어 내가 마지막 웃음을 지을 차례다. 나의 궁극적인 복수란 바로 펠리시티를 S+ 등급의 첩으로 길러내는 것이다. 그녀는 모든 명령에 복종하고, 당신에게 완전히 헌신해야 한다. 그녀를 데리고 있는 동안 매일 악마의 정액을 먹이고, 그 외에는 아무것도 주지 마라!'
	$spectre_quest[10] = '[스펙터 경]<br>&nbsp;강철 장미에서 포이즌이 제안하는 신체 개조는 전부 받게 하고, 노예 장신구와 물품도 착용시키시오. 특히 유두 사슬 말이오. 일단 피어싱을 하게 되면, 유두 사슬은 어떤 경우에도 벗기면 안 되오! 보 아저씨이 새겨 줄 수 있는 문신은 전부 새기시오.'
	$spectre_quest[11] = '[스펙터 경]<br>&nbsp;가능한 모든 방법으로, 그리고 할 수 있는 한 자주 그녀를 미친 듯이 박아대라. 그녀의 처녀성을 빼앗은 뒤에는 항상 그 꽉 조이는 작은 보지에 질 구슬을 넣어 두어라. 언제나 자네 목욕 시중을 들게 하고, 매일 블로우잡을 하게 만들며, 숙주에게 정액을 심고 싶어질 때마다 촉수 괴물를 착유하게 하라. 펠리시티가 짜낼 괴물는 늘 준비되어 있어야 하네.'
	$spectre_quest[12] = '[스펙터 경]<br>&nbsp;그녀가 ‘레이싱 그랜드 챔피언’ 타이틀을 따게 하시오. 그래, 온 로마가 지켜보는 앞에서 그녀가 모욕당하고 굴욕을 당하게 만들고 싶소. 그녀를 불멸의 로마 전역에서 가장 음탕한 창녀로 만들어버리시오! 내 동생이 집으로 돌아오기 전까지 이 모든 일을 완수해야 하오. 내가 그의 귀환을 다소 늦출 수는 있겠지만, 그가 내일 돌아오기로 결정하더라도 최소 120일은 걸릴 테니, 수락한다면 그 기간 동안 임무를 수행해야 하오.'
	$spectre_quest[13] = '[스펙터 경]<br>&nbsp;동생이 집에 돌아왔을 때 어떤 표정을 지을지 벌써부터 기대되네! 그가 그렇게 아끼던 펠리시티가 하찮은 창녀이자 포니걸 챔피언으로 전락했으니 말이지. 동생이 복수하거나 너에게 문제를 일으킬까 봐 걱정하지 마. 당분간은 더 중요한 일로 그를 묶어둘 테니까.'
	$spectre_quest[14] = '[스펙터 경]<br>&nbsp;몇 가지 더 말씀드리자면, 그녀를 내게 데려올 때 임신 상태여야 하며, 극도로 성욕이 왕성해야 합니다. 그녀를 색정광, 노출증 환자, 변태, 양성애자로 훈련시켜야 합니다. 또한 그녀는 귀하가 속한 길드에서 가르치는 모든 성적 기술을 완벽하게 익혀야 합니다.'
	$spectre_quest[15] = '[스펙터 경]<br>&nbsp;보상 말이오 - 실례, 내가 좀 앞서갔군. 이 모든 걸 해낸다면 내 소중한 사슬 갑옷을 주겠소. 나는 이제 너무 늙어서 더는 싸울 필요가 없고, 그것도 쓸 일이 없소. 수년 동안 내게 온갖 고생을 안긴 형제에게 되갚는 일만이, 내가 그 갑옷을 내놓게 만들 유일한 이유요.'
	$spectre_quest[16] = '[스펙터 경]<br>&nbsp;그 사슬 갑옷은 극히 희귀하며, 불멸의 로마와 연결된 단 하나의 세계에만 존재하는 금속으로 만들어졌소. 그 세계는 매우 위험하고, 그곳에 서식하는 흉물들 때문에 많은 목숨이 희생되오. 온갖 악이 그곳에 깃들어 그 땅을 집처럼 여기고 있지. 전쟁도 언제나 사악하고 잔혹한 방식으로 벌어지오.'
	$spectre_quest[17] = '[스펙터 경]<br>&nbsp;그 금속은 채굴해야 하는데 지하 아주 깊은 곳에 있소. 희귀하고 귀한 그 금속을 채굴하는 데 조금이라도 성공할 가능성을 얻으려면, 소규모라도 고도로 훈련된 군대가 늘 그곳을 지켜야 하오. 겨우 몇 온스 캐는 데도 몇 달이 걸리기 일쑤지. 내 알기로 불멸의 로마에서 그런 물건을 가진 자는 나뿐이오. 물론 내가 그걸 가지고 있다고 떠벌리진 않지만.'
	$spectre_quest[18] = '[스펙터 경]<br>&nbsp;그 사슬 갑옷은 순수한 미스릴로 만들어졌소. 가볍고 유연하면서도 고딕 판금갑옷보다 두 배 강한 재료지. 이 미스릴 갑옷은 여러 차례 내 목숨을 구했고, 내가 몇 번의 암살 시도를 막아 내며 살아남을 수 있었던 것도 이 덕분이오. 나는 귀족처럼 보이지만, 사실 온갖 무기를 다루는 훈련에 수년을 바쳤소. 내가 가장 즐기는 취미 중 하나지.'
	$spectre_quest[19] = '[스펙터 경]<br>&nbsp;정해 준 기한 안에 펠리시티를 산 채로, 완전히 훈련된 상태로 내게 데려오시오. 그러면 그 갑옷은 당신 것이오! 나를 실망시키면, 세상 어디에도 당신이 숨을 곳은 없을 거요. 내 지휘 아래에는 거의 끝이 없는 자원이 있고, 나는 완벽함을 요구하오. 실수의 여지는 전혀 없소! 그리고 명심하시오. 수락하는 순간부터 나는 내가 가진 강력한 마법으로 펠리시티의 진척을 지켜볼 것이오.'
! JO9 MOD END J9M2674

! JO9 MOD START J9M2673 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$spectre_quest_prompt = '[스펙터 경]<br>&nbsp;내가 전해줄 지침을 전부 따라야 하네. 받게, 내 모든 요구가 한 치의 오차없이 다 들어 있을거야. 사육을 시작하면, 다른 노예는 얼씬도 못하게 해. 또 펠리시티에 먹일 산란액도 잊지 말고! 어떤가, 이 최고로 난해하고 구체적인 작업. 이걸 해냄과 동시에 자네 위신을 얻겠나? 아니면 내가 자넬 잘못봤다 말 할건가?</div>'
! JO9 MOD END J9M2673

! JO9 MOD START J9M2672 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$spectre_fail[1] = '[스펙터 경]<br>&nbsp;그래, 이 펠리시티가 더 사육되고 더 망가져야 할 것 같군. 확실해 졌을때 데려오도록. 그럼 값을 매길수 없는 이 귀중한 <u>미스릴 갑옷</u>을 약속하지!</div>'
	$spectre_win[1] = '[스펙터 경]<br>&nbsp;경주 왕좌권을 이게 우승하는걸 내 똑똑히 봤지! 아주 잘 훈련된 경마야. 두말 없이 받겠네, 복수를 위한 최후의 작품으로 말이야. 미스릴 갑옷을 받게, 꽤 만족스러울거야. 동시에 자넨 내 신의와 감사를 얻었어. 일을 마무리한걸 축하하네!</div>'
! JO9 MOD END J9M2672

	killvar '$julia_meeting'
! JO9 MOD START J9M2671 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$julia_meeting[1] = '[듀어드 대장]<br>&nbsp;자네를 기다리고 있었다. 요한나가 바로 저쪽에서 기다리고 있네.'
	$julia_meeting[2] = '[여자]<br>&nbsp;어서 오세요, <<$master_name>>. 저는 요한나예요. 그 아이는 깨어 있고, 당신을 만날 준비도 됐어요. 따라오세요, 길을 안내해 드릴게요.'
! JO9 MOD END J9M2671
	$julia_meeting[3] = '  그녀를 따라 방으로 들어서자, 어린 소녀 하나가 당신을 올려다본다. 얼굴에 환한 미소가 번지더니, 두 팔을 활짝 벌리고 당신에게 달려들어 안기며 울기 시작한다. 당신의 여동생, 줄리아다!'
! JO9 MOD START J9M2670 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$julia_meeting[4] = '[줄리아]<br>&nbsp;정말 오빠였어… 설마, 그럴 리 없어, 불가능해… 그렇게 생각했는데… 진짜 오빠였어. 너무 무서웠는데, 그러다 그 얘길 들었고, 그래서 여기로 왔어…'
	$julia_meeting[5] = '[<<$master_name>>]<br>&nbsp;괜찮아, 이제 괜찮아. 아빠랑 엄마한테 무슨 일이 있었던 거야? 넌 왜 여기 있는 거고?'
	$julia_meeting[6] = '[줄리아]<br>&nbsp;오빠가 떠난 뒤에, 엄마랑 아빠가… 너무 화가 나 있었어. 그 화를 나한테 풀었어. 그러다 내가 자는 줄 알고 얘기하는 걸 들었는데… 나를 팔아버리려 했어! 그래서 도망쳤어. 하지만… 하지만, 어둠은… 혼자 견디기 힘들었어.'
	$julia_meeting[7] = '[<<$master_name>>]<br>&nbsp;그런데 넌 어떻게 나를 찾은 거야? 그리고 언제 도망친 거지?'
	$julia_meeting[8] = '[줄리아]<br>&nbsp;나도 잘 모르겠어… 오빠가 떠난 지 일주일쯤 지나서 나도 떠났어. 오빠가 전에 해 준 얘기가 조금 기억났고, 오빠가 떠난 뒤 오빠 책들도 읽었으니까, 그래서 해 보려고 했어… 하지만 망쳤어, 로마엔 가지 못했어.'
	$julia_meeting[9] = '[줄리아]<br>&nbsp;그 뒤엔 너무 지쳐서 다시 시도할 수가 없었어. 그래서 도와줄 사람을 찾아보려 했는데… 사람들은 다 너무 불친절했어. 닥치는 대로 찾아먹고, 훔치기도 하고, 쓰레기통에서도 주워 먹으면서 겨우 살아남았어…'
	$julia_meeting[10] = '[줄리아]<br>&nbsp;그 세계는 정말 좋은 곳이 아니었어… 그래서 다시 한 번 로마로 가 보려고 했어. 하지만 또 실패했지… 그러다 일주일 전쯤, 완전히 희망을 놓고 있었을 때 누군가 이야기하는 걸 엿들었어. <<$master_name>>라는 젊은 소년이 로마의 귀족이 되었다고 하더라. 난 내 귀를 의심했어. 그래서 그 사람들한테 다가가서…'
	$julia_meeting[11] = '[줄리아]<br>&nbsp;이렇게 말했어. "<<$master_name>>? 그게 정말이에요? 제 오빠예요! 저를 불멸의 로마로 데려다주시면, 분명 보답해 줄 거예요." 하지만 그 사람들은 날 믿지 않았고, 비웃었어. 난 완전히 무너졌지.'
	$julia_meeting[12] = '[줄리아]<br>&nbsp;그때 누군가 내 어깨에 손을 얹었어. 남자의 손이었어. 너무 무서웠어… 그런데 알고 보니 그 사람은 친절한 사람이었어. 자기는 로마에서 왔고, 오빠를 안다고 말했어…'
	$julia_meeting[13] = '[줄리아]<br>&nbsp;그 사람이 내게 몇 가지를 물었고, 아마 내가 그를 납득시킨 것 같아. 먹을 것도 주고, 그다음엔 안개를 지나 함께 나를 여기, 바티칸으로 데려왔어. 여기서 요한나가 나를 돌봐 줬어.'
	$julia_meeting[14] = '[줄리아]<br>&nbsp;드디어 오빠를 찾았고, 먹을 것도 있고, 따뜻한 곳도 있어서 너무 행복해… 오빠, 다시는 나 두고 가지 마!'
	$julia_meeting[15] = '[<<$master_name>>]<br>&nbsp;안 떠날게. 네 짐 챙겨. 내가 널 집으로 데려갈 거야. 난 밖에서 기다릴게. 요한나와 얘기할 일이 있어.'
	$julia_meeting[16] = '[<<$master_name>>]<br>&nbsp;요한나, 그 애를 도와줘서 고마워요. 누가 그 애를 여기 데려왔는지, 그리고 도착했을 때 상태가 어땠는지 아나요?'
	$julia_meeting[17] = '[요한나]<br>&nbsp;그 애는 맨헌터가 우리에게 데려왔어요. 굶주렸고 더러웠고 조금 야생 같았지만, 그래도 아직 남자의 손길은 닿지 않은 상태였죠. 그 아이가 발견된 세계는 질 좋은 광물로 유명한데, 마침 그날 그가 거기에 있었어요. 그 애는 운이 좋았어요, 정말 아주 운이 좋았죠. 당신의 새로운 지위를 듣고 딱 알맞은 순간에 나서지 않았다면, 분명 비참한 운명을 맞았을 거예요. 이제 그 애를 데려가세요. 그리고 우리의 관대함을 기억해 주세요.'
! JO9 MOD END J9M2670
	$julia_meeting[18] = '요한나에게 존중과 사색이 섞인 고갯짓을 하고 물러서자, 방에서 나온 줄리아가 얼마 안 되는 소지품을 들고 있는 것이 보인다. 작은 가방 하나에 다 들어갈 정도다. 당신이 그녀를 집으로 데려가는 동안, 그녀는 자신에겐 처음이고 당신에겐 익숙한 광경들을 신이 나서 둘러본다. 자신이 아는 옛 소년으로부터 당신이 얼마나 높이 올라왔는지, 그리고 로마가 당신을 얼마나 바꾸어 놓았는지 그녀는 거의 깨닫지 못한다. 머지않아 알게 되겠지만…'

	$csell_tuto = '_____<br>당신은 공공 목장의 외양간 안에 있다. 판매될 젖소들은 평가를 위해 이곳으로 데려와진다.<br>' + _
	'<br><b><font color="#0000D8"></b>짙은 파란색</font>으로 표시되는 요소들은 젖소의 최종 가격에 큰 영향을 줄 수 있다.<br>' + _
	'<b><font color="#A300CC"></b>옅은 파란색</font>으로 표시되는 요소들은 젖소의 최종 가격에 중간 정도의 영향만 준다.'

! JO9 MOD START J9M2669 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
