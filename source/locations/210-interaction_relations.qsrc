    $text[1] = '  Вы рассказываете воспитуемой о различиях между человеческими (и не только) расами, о концепции жизненного пространства и прочих спорных моментах. Мир Вечного Рима представляет вам массу возможностей проиллюстрировать эти теории на практике взаимоотношений людей, зверолюдов и прочих народов, широко предствленных в самом Вечном городе и на его окраинах.'
    $text_2 = '  <<$slave_name>> бессмысленно хлопает глазами и накручивает волосы на палец. По её пустым глазам вы видите, что она не поняла ни слова из того, что вы пытались ей сказать. Либо вам не хватает навыка учителя, либо ей не хватает интеллекта или кругозора.'
    $text_3 = '  <<$slave_name>> слушает вас явно через силу. Вашим аргументам сложно пробиться через её личные убеждения и печальный жизненный опыт. Видимо, вам придётся ещё много раз повторять попытки добиться её понимания по этому вопросу.'
    $text_4 = '  <<$slave_name>> слушает вас очень внимательно, и вы видите понимание на её лице. Отрадно - это значит, что понадобится ещё несколько уроков, и вам удастся воспитать у вашей воспитуемой нетерпимость к людям других наций.'
    $text_5 = '  <<$slave_name>> полностью осознала мысль, которую вы пытались до неё донести. Теперь она будет косо смотреть на людей других рас и наций.'    
    $lecture_theme = 'bigotry_nation'
    $special_part = {
        if slave['bigotry_nation'] >=20: 
            slave['tolerant_nation'] = 0
            slave['bigotry_nation'] = 0
        end
    }    
END

