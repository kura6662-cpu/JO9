# interaction.relations
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2933 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'interaction.relations': gs 'snk_room_bridge', 'guard', 'interaction.relations'
! JO9 MOD END J9M2933

!Отношения рабыни и ассистентки - mrross

!Вопрос о настроении ассистентки
!IF interaction = menu_feeling_assistant:
! repulse = -2
! $interaction_type = 'talk_assistant'
! txt_count = ndex_a
! msg 'Ассистентка:<br>Любовь к мастеру1: <<assistant["pos_slave_love"]>><br>Любовь к мастеру2: <<assistant["pos_slave_love2"]>><br>Любовь к мастеру3: <<assistant["pos_slave_love3"]>><br>Любовь к мастеру4: <<assistant["pos_slave_love4"]>><br>Любовь к мастеру5: <<assistant["pos_slave_love5"]>><br>Любовь к мастеру6: <<assistant["pos_slave_love6"]>>'
! copyarr '$text', '$assistant_mood_list'
!END

!Вопрос к ассистентке - что ты думаешь о воспитуемой?
IF interaction = menu_relation_assistant:
 repulse = -2
 $interaction_type = 'talk_assistant'
 txt_count = 6
 sa_rel = 2
 gs 'origins_relations'
END

!isolate assistant - slave Ограничить общение с ассистенткой на время
IF interaction = menu_isolate_slave:
    $interaction_type = 'talk'
    txt_count = 1
    if slave['isolate'] <= 0:
        $text[1] = '  Вы запрещаете рабыне общаться с ассистенткой на любые личные темы и приказываете ограничить разговоры вопросами быта и обучения. <<$slave_name>> с поклоном отвечает вам, что выполнит вашу волю. Вы прекрасно понимаете, что ваш запрет продержится не дольше нескольких дней, однако это поможет на время заморозить отношения ассистентки и рабыни.'
        slave['isolate'] = 5
    else
        $text[1] = '  Вы разрешаете рабыне общаться с ассистенткой на любые личные темы. <<$slave_name>> с поклоном отвечает вам, что выполнит вашу волю. Посмотрим, к чему это приведёт.'
        slave['isolate'] = 0
    end
END
!smear assistant - slave Охладить оношение к ассистентке
IF interaction = menu_smear_slave:
    $interaction_type = 'talk'
    txt_count = 1
    if slave['smear'] = 0:
        $text[1] = '  Вы напоминаете рабыне, что <<$assistant_name>> - не её подруга, а ваша помощница, и её цель - помочь вам обучить рабыню, чтобы вы могли побыстрее её продать. По лицу рабыни вы видите, что она поняла смысл ваших слов и обдумывает их. Вы надеетесь, что она сделает правильные выводы.'
        slave['smear'] = 5
    else
        $text[1] = '  Вы напоминаете рабыне, что <<$assistant_name>> - не её подруга, а ваша помощница, и её цель - помочь вам обучить рабыню, чтобы вы могли побыстрее её продать. Рабыня кивает с несколько отстранённым видом - вы уже говорили ей это недавно, и она не услышала для себя ничего нового.'
    end
END
!praise assistant - slave Вызвать сочувствие к ассистентке
IF interaction = menu_praise_slave:
    $interaction_type = 'talk'
    txt_count = 1
    if slave['praise'] = 0:
        $text[1] = '  Вы напоминаете рабыне, что <<$assistant_name>> - живой чувствующий человек, прошедший через те же злоключения, которые достались на долю ассистентки. Рабыня задумывается, выслушав ваши слова. Вы надеетесь, что её отношение к ассистентке хоть немного улучшится.'
        slave['praise'] = 5
    else
        $text[1] = '  Вы напоминаете рабыне, что <<$assistant_name>> - живой чувствующий человек, прошедший через те же злоключения, которые достались на долю ассистентки. Рабыня молча выслушивает вас и едва заметно пожимает плечами - похоже, на этот раз ваши слова её не впечатлили.'
    end
END

!isolate slave - assistant Ограничить общение с рабыней на время
IF interaction = menu_isolate_assistant:
    $interaction_type = 'talk_assistant'
    txt_count = 1
     if assistant['isolate'] <= 0:
        $text[1] = '  Вы запрещаете ассистентке общаться с воспитуемой на любые личные темы и приказываете ограничить разговоры вопросами быта и обучения. <<$assistant_name>> с поклоном отвечает вам, что выполнит вашу волю. Вы прекрасно понимаете, что ваш запрет не продержится вечно, однако это поможет на время заморозить отношения ассистентки и рабыни.'
        assistant['isolate'] = 5
    else
        $text[1] = '  Вы разрешаете ассистентке общаться с воспитуемой на любые личные темы. <<$assistant_name>> с поклоном отвечает вам, что выполнит вашу волю. Посмотрим, к чему это приведёт.'
        assistant['isolate'] = 0
    end
END
!smear slave - assistant Охладить оношение к рабыне
IF interaction = menu_smear_assistant:
    $interaction_type = 'talk_assistant'
    txt_count = 1
    if assistant['smear'] = 0:
        $text[1] = '  Вы напоминаете ассистентке, что <<$slave_name>> - лишь товар, который будет продан после процесса подготовки, и что эмоционально привязыватся к ней - плохая идея. По лицу ассистентки вы видите, что она поняла смысл ваших слов и обдумывает их. Вы надеетесь, что она сделает правильные выводы.'
        assistant['smear'] = 5
    else
        $text[1] = '  Вы напоминаете ассистентке, что <<$slave_name>> - лишь товар, который будет продан после процесса подготовки, и что эмоционально привязыватся к ней - плохая идея. Ассистентка кивает с несколько отстранённым видом - вы уже говорили ей это недавно, и она не услышала для себя ничего нового.'
    end
END
!praise slave - assistant Вызвать сочувствие к рабыне
IF interaction = menu_praise_assistant:
    $interaction_type = 'talk_assistant'
    txt_count = 1
    if assistant['praise'] = 0:
        $text[1] = '  Вы напоминаете ассистентке, что <<$slave_name>> - живой чувствующий человек, прошедший через те же злоключения, которые достались на долю ассистентки. Ассистентка задумывается, выслушав ваши слова. Вы надеетесь, что её отношение к воспитуемой хоть немного улучшится.'
        assistant['praise'] = 5
    else
        $text[1] = '  Вы напоминаете ассистентке, что <<$slave_name>> - живой чувствующий человек, прошедший через те же злоключения, которые достались на долю ассистентки.  Ассистентка молча выслушивает вас и едва заметно пожимает плечами - похоже, на этот раз ваши слова её не впечатлили.'
    end
END




!Отношения рабыни и ассистентки - mrross
!Групповая трудотерапия - mrross
IF interaction = menu_teambuilding_1:
  !Автоодевание - загрузка пресета
  i_aw = slave["aw_service"] 
  aw_msg = 1 
  dynamic $aw_preset_load
  !/Автоодевание - загрузка пресета
  repulse = -3
  complex_repulse = -3    
  if slave["service_affinity"] < 0: complex_repulse += 2
  if slave["service_affinity"] > 0: talent_bonus = 5
  if slave["<<assistant['id']>>"] < acc_rel['bad1']: complex_repulse += 2
  if assistant["<<slave['id']>>"] < acc_rel['bad1']: complex_repulse += 2    
  $interaction_type = 'make_slave_assistant_do'
  couch_skill = (assistant["service"] + slave["service"])/2
  slave_skill = slave["service"]
  misc_bonus = learn_bonus["service"]   
  $target_skill = 'slave_rate["service"]'
  $target_skill_two = 'assistant_rate["service"]'
  $target_affinity = 'service_affinity'
  gs 'picture_selector'
  $refuse_txt = '<<$slave_name>> отказывается работать в команде с ассистенткой. Ну, если она предпочитает насилие - это несложно устроить...'
  txt_count = 3
  $text[1] = '<<$assistant_name>> и <<$slave_name>> вместе принимаются за приготовление пищи, после чего следует генеральная уборка. Это - не обычное обучение. Задача ваших рабынь сегодня заключается в том, чтобы выполнить каждую задачу в четыре руки, во всём помогая друг другу.'
  $text[2] = 'Здесь крайне важна слаженность действий, обе участницы должны думать не только за себя, но и за свою партнёршу. Обе должны научиться сдерживать свою неприязнь ради общего дела. В теории это должно вызвать у них чувство взаимной симпатии.'
  if slave['teambuilding_1'] = 0 and assistant['teambuilding_1'] = 0:
      $text[3] = 'Ваши рабыни очень неплохо справляются с задачей. Ужин мог бы быть немного вкуснее и пол мог блестеть чуточку ярче, но зато девушки явно потеплели друг к другу, на их лицах можно видеть удовлетворённые улыбки. Совместный труд определённо сближает.'
  else
      $text[3] = 'Рабыни выполнили задачу, но вы не заметили в их действиях былого энтузиазма. Заученные движения, отрешённые взгляды, сухие короткие фразы - вряд ли такое взаимодействие поможет сплотить ваших подопечных. Возможно, стоит подождать дня три, прежде чем вновь проводить подобные эксперименты.' 
  end
  sin_potential = 3
  add_assistant_hygiene = house_mess + 2
  add_slave_hygiene = house_mess + 2
  add_master_hygiene = 0
  $special_part = {
    if slave["service_affinity"] ! 0 and slave["service_affinity_revealed"] = 0: slave["service_affinity_revealed"] = 1
    house_mess_rate -= (slave["service"]*16)
    if house_mess < 0: house_mess = 0
    if house_mess_rate < 0: house_mess_rate = 0
    dynamic $house_cleaning
    if slave["cook_affinity"] ! 0 and slave["cook_affinity_revealed"] = 0: slave["cook_affinity_revealed"] = 1
    if cooked_food < slave["cook"]: cooked_food = (slave["cook"] + assistant["cook"]) / 2
    show_food = 1
    gs '#food_base'
    gs '$food_choice'
    dynamic $slave_energy_drop
    dynamic $assistant_energy_drop
    dynamic $slave_energy_drop
    dynamic $assistant_energy_drop
! JO9 MOD START COG_DIRECT_88 | 2026-10-16_innate_learning_traits
    dynamic 'slave_rate["cook"] += func(''jo9_learning_xp'', (skill_rise), slave[''jo9_learning_trait''], ''cook'')'
! JO9 MOD END COG_DIRECT_88
! JO9 MOD START COG_DIRECT_89 | 2026-10-16_innate_learning_traits
    dynamic 'assistant_rate["cook"] += func(''jo9_learning_xp'', (skill_rise), assistant[''jo9_learning_trait''], ''cook'')'
! JO9 MOD END COG_DIRECT_89
    if slave['teambuilding_1'] = 0 and assistant['teambuilding_1'] = 0:
      slave['teambuilding_1'] = 3
      assistant['teambuilding_1'] = 3
      slave["<<assistant['id']>>"] += 15
      assistant["<<slave['id']>>"] += 15
    else
      slave['teambuilding_1'] = 3
      assistant['teambuilding_1'] = 3
    end
  }
END

!Групповая гимнастика - mrross
IF interaction = menu_teambuilding_2:
    !Автоодевание - загрузка пресета
    i_aw = slave["aw_stamina"] 
    aw_msg = 1 
    dynamic $aw_preset_load
    !/Автоодевание - загрузка пресета
    $interaction_type = 'make_slave_assistant_do'
    repulse = -3
    complex_repulse = -3    
    if slave['energy'] > 3: complex_repulse = 0
    if slave['energy'] < 0: complex_repulse -= slave['energy']
    if slave["sport_affinity"] < 0: complex_repulse += 2
    IF slave["sport_affinity"] > 0:
      talent_bonus = 5
      complex_repulse = -100
    END
    if slave["<<assistant['id']>>"] < acc_rel['bad1']: complex_repulse += 1
    if assistant["<<slave['id']>>"] < acc_rel['bad1']: complex_repulse += 1    
    couch_skill = (assistant["stamina"] + slave["stamina"])/2
    slave_skill = slave["stamina"]
    misc_bonus = learn_bonus["stamina"]   
    $target_skill = 'slave_rate["stamina"]'
    $target_skill_two = 'assistant_rate["stamina"]'
    $target_affinity = 'sport_affinity'
    gs 'picture_selector'
    $refuse_txt = '<<$slave_name>> отказывается заниматься спортом с ассистенткой. Ну, если она предпочитает насилие - это несложно устроить...'
    txt_count = 2
    $text[1] = '    Вы приказываете рабыне и ассистентке вместе заняться гимнастикой. Ход вашей мысли прост: совместная деятельность сближает. Если <<$assistant_name>> и <<$slave_name>> будут выполнять совместные упражнения, им придётся идти на контакт и помогать друг другу.'
    if slave["<<assistant['id']>>"] < acc_rel['bad2'] or assistant["<<slave['id']>>"] < acc_rel['bad2']:
      $text[2] = '    Возможно, ваша логика в своей основе верна, но вы не учли того, что <<$assistant_name>> и <<$slave_name>> уже вызывают друг у друга неприязнь. Занимаются они вполсилы, стараются не дотрагиваться и не смотреть друг на друга. Таким образом вы добьётесь скорее отрицательного эффекта. Попробуйте сначала другие методы.'
    else
      $text[2] = '    <<$assistant_name>> и <<$slave_name>> вместе выполняют комплекс гимнастических упражнений, который требует от них близкого взаимодействия и поддержки друг друга. Кажется, вам удалось добиться нужного уровня взаимодействия между ними - девушки улыбаются и понимают друг друга с полуслова. Такие упражнения можно делать хоть каждый день, если не жалко времени.'
    end
    sin_potential = 3
    add_assistant_hygiene = 10
    add_slave_hygiene = 10
    add_house_mess = 5   
    add_master_hygiene = 0 
    $special_part = {
      if slave["sport_affinity_revealed"] = 0 and slave["sport_affinity"] = 1: slave["sport_affinity_revealed"] = 1
      slave["calories"] -= 2
      assistant["calories"] -= 2
      dynamic $slave_energy_drop
      dynamic $assistant_energy_drop
      if slave["<<assistant['id']>>"] < acc_rel['bad2'] or assistant["<<slave['id']>>"] < acc_rel['bad2']:
        slave["<<assistant['id']>>"] -= 1
        assistant["<<slave['id']>>"] -= 1    
      else
        slave["<<assistant['id']>>"] += 3
        assistant["<<slave['id']>>"] += 3    
      end
      slave['teambuilding_2'] = 1
      assistant['teambuilding_2'] = 1
    }
END


!Поход в ресторан втроём - mrross
IF interaction = menu_teambuilding_3:
 $interaction_type = 'prise_date'
 slave['teambuilding_3'] = 1
 assistant['teambuilding_3'] = 1
 prise_level = 5
 slave['promise_reward'] = 0
 prise_potence = 4 + (slave["moral"]*2 + slave["rational"] + slave["instinct"] + slave["spoil"] - slave["fear"])*4 - already_done_curslave[interaction]
 if slave["passion_fame"] = -1:  prise_potence = prise_potence/2
 if slave["passion_sweets"] < 0: prise_potence -= 4
 if prise_potence <= 0: prise_potence = 1
 if slave["passion_sweets"] > 0: prise_potence += prise_potence
 date_success = 5
 if prise_potence < 40: date_success = 4
 if prise_potence < 10: date_success = 3
 if prise_potence < 5: date_success = 2
 if prise_potence <= 1: date_success = 1
 IF date_success > 2:
  slave['promise_reward'] = 0
  if slave["sin"] = 0 and slave["pride"] < 4: slave_rate["temper"] += 1 & slave_rate["moral"] += 2
 END
 prise_cost = 12
 add_master_hygiene = 3
 add_slave_hygiene = 3
 add_house_mess = 1
 slave["<<assistant['id']>>"] += date_success
 assistant["<<slave['id']>>"] += date_success
 $text[1] = '  <<$date_treesome_description[1]>>'
 $text[2] = '  <<$date_treesome_result[date_success]>>'
 $place = 'restaurant'
 daily_reward_count += 1
 special_food = 1
 assistant["special_food"] = 1
 if slave["passion_fame"] ! 0 and slave["passion_fame_revealed"] = 0: slave["passion_fame_revealed"] = 1
 if slave["passion_sweets"] ! 0 and slave["passion_sweets_revealed"] = 0: slave["passion_sweets_revealed"] = 1
 $special_part = {
    if date_success > assistant['pos_slave_date']: assistant['pos_slave_date'] = date_success
    if master_mood['pos_self_food'] < 1: master_mood['pos_self_food'] = 1
    dynamic $assistant_energy_drop
    assistant["rewarded_today"] += prise_level*3
 }
END

!Поход на пляж втроём - mrross
IF interaction = menu_teambuilding_35:
 $interaction_type = 'prise_date'
 slave['teambuilding_35'] = 1
 assistant['teambuilding_35'] = 1
 prise_level = 3
 slave['promise_reward'] = 0
 prise_potence = slave["stamina"] + slave["temper"] + (slave["moral"]*2 + slave["rational"] + slave["instinct"] + slave["spoil"])*2 - slave["fear"] - already_done_curslave[interaction]
 if slave["passion_fame"] = -1:  prise_potence = prise_potence/2
 if slave["water_attitude"] = -1: prise_potence -= prise_potence
 if prise_potence <= 0: prise_potence = 1
 if slave["passion_fame"] > 0:  prise_potence += prise_potence
 if slave["water_attitude"] = 2: prise_potence += prise_potence
 date_success = 5
 if prise_potence < 40: date_success = 4
 if prise_potence < 10: date_success = 3
 if prise_potence < 5: date_success = 2
 if prise_potence <= 1: date_success = 1
 IF date_success > 2:
  slave['promise_reward'] = 0
  if slave["sin"] = 0 and slave["pride"] < 4: slave_rate["temper"] += 1 & slave_rate["moral"] += 2
 END
 prise_cost = 4
 master_hygiene = 1
 slave["hygiene"] = 1
 add_master_hygiene = 0
 add_slave_hygiene = 0
 add_house_mess = 2
 slave["<<assistant['id']>>"] += date_success
 assistant["<<slave['id']>>"] += date_success
 $text[1] = '  <<$date_treesome_description[2]>>'
 $text[2] = '  <<$date_treesome_result[date_success]>>'
 $place = 'beach'
 gs 'picture_selector'
 daily_reward_count += 1
 slave["calories"] -= 1
 assistant["calories"] -= 1
 if slave["passion_fame"] ! 0 and slave["passion_fame_revealed"] = 0: slave["passion_fame_revealed"] = 1
 $special_part = {
    dynamic $assistant_energy_drop
    assistant["rewarded_today"] += prise_level*3
 }
END

!Высказать чувства в лицо - mrross
IF interaction = menu_provoke_1:
   $interaction_type = 'talk_assistant'
    slave['provoke_1'] = 1
    assistant['provoke_1'] = 1
    txt_count = 2
    $text[1] = '  Вы вызываете воспитуемоую и ассистентку, ставите их перед собой и приказываете честно высказать вслух всё то, что они думают друг о друге. Всё то, что раньше они говорили вам только наедине, когда вторая не слышит. Вы строго предупреждаете девушек, что знаете их чувства друг к другу с их же слов, и та, кто не будет говорить откровенно, будет наказана, поэтому нет смысла лгать и изворачиваться.'
    if slave['<<assistant["id"]>>'] >= acc_rel['good3'] and assistant['<<slave["id"]>>'] >= acc_rel['good3']:
        $text[2] = '   Повинуясь вашему приказу, ассистентка говорит, что <<$slave_name>> - её лучшая подруга, и хотя у неё, разумеется, есть свои недостатки, они ничего не значат. Воспитуемая улыбается в ответ, отвечает в том же духе и ненароком берёт вторую девушку за руку. Вы понимаете, что ваш план не удался. Чувства не всегда бывают негативными. Но ведь вы знали, что девушки хорошо друг к другу относятся, правда?'
        slave['<<assistant["id"]>>'] += 5
        assistant['<<slave["id"]>>'] += 5
    elseif slave['<<assistant["id"]>>'] >= acc_rel['bad1'] and assistant['<<slave["id"]>>'] >= acc_rel['bad1']:
        $text[2] = '   Девушки явно смущены вашим приказом. <<$assistant_name>>, чувствуя большую ответственность, начинает пересказывать свои чувства, которые она испытывает к воспитуемой. <<$slave_name>> слегка краснеет и хмурится. Не всё услышанное приходится ей по душе. В свою очередь она тоже высказывает всё в лицо ассистентке. Отношения между ними сильно не поколебались, но зерно раздора явно посеяно.'
        slave['<<assistant["id"]>>'] -= 5
        assistant['<<slave["id"]>>'] -= 5
    else
        $text[2] = '   Не стесняясь в выражениях, <<$slave_name>> высказывает ассистентке в глаза всё, что о ней думает. Лицо вашей помощницы наливается красным, и она тоже не лезет в карман за словом. Некоторое время девушки кричат друг на друга, пока вы своим приказом не заставляете их замолчать. Цель выполнена.'        
