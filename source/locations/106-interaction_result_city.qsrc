!interaction type - buy item for current slave
if $interaction_type = 'buy_item':
	$return_lock  = 'shop_general'
	if nsfw = 0 and $item_demo[$item_id] ! '': $bg_path = $item_demo[$item_id] & $picture_type = 'pic_png'
	shop_description = 1
	dynamic "$text[1] = '<<$item_description[$item_id]>>'"
	killvar 'shop_description'
	if one_time_aurabound_items_hint = 0:
		one_time_aurabound_items_hint = 1
! JO9 MOD START J9M1682 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
		msg '<font size= 3%>   구매를 검토하던 당신은 불멸의 로마의 대부분 옷과 장신구엔 마법이 깃들어 있다는 사실을 떠올린다. 그것들은 착용자에게 맞춰 스스로 형태를 바꾸지만, 그 과정에서 그 사람의 오라에 묶여 버려 다른 사람에게는 맞춰지지 않는다. 그래서 모든 판매는 확실히 최종 거래가 된다. 주의해서 사라! 아마 경제를 굴러가게 하려는 수단일 것이다...'
! JO9 MOD END J9M1682
	end
	if sparks >= item_price[$item_id]:
		$do_buy = {
			if sound_on = 1: 
				if item_price[$item_id] >= 50:
					play $large_money_sound, sound_volume
				else
					play $small_money_sound, sound_volume
				end
			end
			sparks -= item_price[$item_id]
			inventory[$item_id] += item_qty
			end
		}
	else
		killvar '$do_buy'
		$text[2] = '  가격이 지금 네가 감당할 수 있는 것보다 조금 비싸지만, 그건 쉽게 해결된다. 노예 두어 명만 팔면 된다…'
	end
	gt 'item_buy'
end

