  gt 'item_buy'
  else
  $text[1] = '   물건 가격은 <<item_price[$item_id]>> 스파크로, 지금 네가 감당할 수 있는 것보다 조금 비싸지만, 그건 해결 가능하다. 노예 두어 명만 팔면 된다...'
 END
END

IF $interaction_type = 'byer_invitation':
	gs '$slave_price'
	npc = 1
	copyarr '$text', '$<<$npc_id>>_pref'
	IF npc_progress[$npc_id] = 2:
		copyarr '$text', '$<<$npc_id>>_otkaz'
	else
		IF slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0 and slave['brand'] < 4:
			killvar '$text'
			$text[1] = '괜찮은 상품이 있군. 팔아 볼까?'
			$yes = {$interaction_type = 'sell_slave_simple'
			gt 'interaction_result_city'}
			$no = {
			if from_club = 1:
				from_club = 0
				gt "<<$return_lock>>"
			else
				gt "<<$return_lock>>"
			end
			}
			gt 'choice_screen'
		END
	END
END


!Тип взаимодействия - покупка предмета для текущей ассистентки
IF $interaction_type = 'buy_item_assistant':
 txt_count = 1
 $return_lock  = 'shop_general'
 $picture_type = 'pic_jpg'
 if nsfw = 0: $special_bg  = "<<$item_demo[$item_id]>>"
 $text[1] = $item_description[$item_id]
 IF sparks >= item_price[$item_id]:
  $do_buy = {
  if sound_on = 1: play 'content\snd\kkm.wav', sound_volume
  sparks -= item_price[$item_id]
  assistant_inventory[$item_id] += 1}
  gt 'item_buy'
  else
  $text[1] = '가격은 <<item_price[$item_id]>> 스파크다 — 가격이 지금 네가 감당할 수 있는 것보다 조금 비싸지만, 그건 쉽게 해결된다. 노예 두어 명만 팔면 된다…'
 END
END
