	if nsfw = 0 and $item_demo[$item_id] ! '': $bg_path = $item_demo[$item_id] & $picture_type = 'pic_png' & npc = 0
	shop_description = 1
	dynamic "$text[1] = '<<$item_description[$item_id]>>'"
	base_str = master_str
	base_flagelation = master_flagelation
	gs '#боевые_предметы' &! recalculate damage values using above variables
	if $item_id ! '' and $броня_надеть[$item_id] ! '':
		killvar 'модификатор_колющий' &! piercing modifier
		killvar 'модификатор_рубящий' &! slashing modifier
		killvar 'модификатор_дробящий' &! crushing modifier
		killvar 'модификатор_холод' &! cold modifier
		killvar 'модификатор_огонь' &! heat modifier
		killvar 'модификатор_молния' &! electricity modifier
		dynamic $броня_надеть[$item_id] &! get on-equip armor values
		$text[1] += '<br><br>관통 <<модификатор_колющий>>. 참격 <<модификатор_рубящий>>. 타격 <<модификатор_дробящий>>. 냉기 <<модификатор_холод>>. 화염 <<модификатор_огонь>>. 전격 <<модификатор_молния>>.'
	end
	if $item_id ! '' and базовый_вред[$item_id] > 0: $text[1] += '<br><br>현재 네 힘과 숙련도를 기준으로, 다른 무기들과 비교했을 때 이것의 위력 평가는 <<базовый_вред[$item_id]>>다.'
	killvar 'shop_description'
	if sparks >= max(item_price[$item_id], wpn_price):
		$do_buy = {
			if sound_on = 1: 
				if max(item_price[$item_id], wpn_price) >= 50:
					play $large_money_sound, sound_volume
				else
					play $small_money_sound, sound_volume
				end
			end
			sparks -= max(item_price[$item_id], wpn_price)
			dynamic '<<$item_id>> += max(1,multiple)' &! at least one if no multiple specified - ImperatorAugustus
			if $return_lock = 'shop_wpn': wpn_price = 0 & npc = 1 & skip_to = 999 & $text[1] = $shop_wpn_accept
		}
		$do_no_buy = {
			wpn_price = 0 &! avoid infinite loop - ImperatorAugustus
		}
	elseif wpn_price > 0:
		$do_buy = {
			npc = 1
			skip_to = 999
			wpn_price = 0 &! avoid infinite loop - ImperatorAugustus
			$text[1] = $shop_wpn_deny
		}
		$do_no_buy = {
			wpn_price = 0 &! avoid infinite loop - ImperatorAugustus
		}
	else
		killvar '$do_buy' &! disables the yes button on the item_buy screen - ImperatorAugustus
		$text[2] = '  가격이 지금 네가 감당할 수 있는 것보다 조금 비싸지만, 그건 쉽게 해결된다. 노예 두어 명만 팔면 된다…'
	end
	gt 'item_buy'
end

