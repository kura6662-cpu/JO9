# interaction_result_city
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1689 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'interaction_result_city': gs 'snk_room_bridge', 'guard', 'interaction_result_city'
! JO9 MOD END J9M1689
! JO9 MOD START TBV_SALE_REWARD_SNAPSHOT | 2026-10-17_trait_value
killvar 'jo9_trait_value_sold_peerless'
if $interaction_type = 'sell_slave_simple' or $interaction_type = 'slave_sold_house' or $interaction_type = 'sell_slave_complex' or $interaction_type = 'slave_sold': jo9_trait_value_sold_peerless = slave['jo9_peerless']
!handling templates
! JO9 MOD END TBV_SALE_REWARD_SNAPSHOT
if sp_txt_is_set_from_save = 0: sp_txt = 1

!interaction type - talk
if $interaction_type = 'standart':
	dynamic $special_part
end

!interaction type - buyer invitation
if $interaction_type = 'buyer_invitation':
	gs '$slave_price'
	npc = 1
	killvar '$text'
	dynamic '$text[1] = $<<$npc_id>>_pref[1]'
	if npc_progress[$npc_id] = 2:
		if personal_relations[$npc_id] < 0:
! JO9 MOD START J9M1688 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
			$text[1] = '[<<$npc_name[$npc_id]>>]<br>&nbsp;다시는 당신에게서 사지 않겠어. 그리고 전에 당신이 내게 어떻게 했는지 몇몇 친구들에게도 한마디 해뒀지.'
! JO9 MOD END J9M1688
		else
! JO9 MOD START J9M1687 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
			$text[1] = '[<<$npc_name[$npc_id]>>]<br>&nbsp;난 아직 새 노예가 필요 없네. 하지만 몇몇 친구들에게 한마디 해뒀으니, 그런 상품의 구매자는 어렵지 않게 찾게 될 거야.'
! JO9 MOD END J9M1687
		end
	else
		if slave_state = CONST_INT['slave_exist'] and slave['brand'] > 0:
			txt = 1
			$yes = {
				!TODO: give NPCs money in a better way
				npc_money[$npc_id] = common_price[demand_rating[$npc_id]]
				npc_money[$npc_id] += (48271 * (day + slave_type + city_form + len($npc_id)) mod 65537) / (65537 / (2 * common_price[demand_rating[$npc_id]]))
				!$interaction_type = 'sell_slave_simple' &! no negotiation
				$interaction_type = 'sell_slave_house' &! use negotiation
				gt 'interaction_result_city'
			}
			$no = {
				if from_club = 1:
					from_club = 0
					gt $return_lock
				else
					gt 'city_menu_form'
				end
			}
			gt 'choice_screen'
		end
	end
end

!interaction type - slave sell simple scheme
if $interaction_type = 'sell_slave_simple':
	gs '$slave_price'
	if slave[$npc_id] > 0 and (day - slave[$npc_id]) >= 10: slave[$npc_id] = 0
	if slave_specialisation[$interesting_specialisation[$npc_id]] >= demand_rating[$npc_id]/2 and rating >= demand_rating[$npc_id] and slave[$npc_id] = 0: buyer_interested = 1
	!charm_demand_max = 10 + demand_rating[$npc_id]
	!charm_demand = rand(5,charm_demand_max)
									charm_demand = 6  &! require D- charm ( 6+) at F-/D-/D+ rating    (0-2)
	if demand_rating[$npc_id] >= 3: charm_demand = 12 &! require C- charm (12+) at C-/C+ rating       (3-4)
	if demand_rating[$npc_id] >= 5: charm_demand = 18 &! require B+ charm (18+) at B-/B+ rating       (5-6)
	if demand_rating[$npc_id] >= 7: charm_demand = 24 &! require A+ charm (24+) at A-/A+ rating       (7-8)
	if demand_rating[$npc_id] >= 9: charm_demand = 38 &! require S+ charm (38+) at S-/S+ rating       (9-10)
	! if charm_demand > charm and buyer_interested = 1 and no_charm_check = 1: buyer_interested = 1
	if charm_demand > charm and buyer_interested = 1 and no_charm_check = 0: buyer_interested = 0
	if slave['wounds'] > 0 or slave['energy'] < 0 or slave['stamina'] < 2: buyer_interested = 0
	if slave['rehabilitation'] > 0 or $slave_psy_status = 'broken': buyer_interested = 0
	if slave['pregnant'] > 0 and slave['pregnant_revealed'] > 0: buyer_interested = 0
	! msg 'Slave Rating: <<rating>>'
	! msg 'Demand Rating: <<demand_rating[$npc_id]>>'
	! msg 'Slave Charm: <<charm>>'
	! msg 'Charm Demand: <<charm_demand>>'
	! msg 'NPC ID: <<slave[$npc_id]>>'
	! msg 'Buyer Interested:  <<buyer_interested>>'
	! msg 'No Charm check: <<no_charm_check>>'
	if buyer_interested = 1:
		npc_progress[$npc_id] = 2
		$text[1] = $buy_quote[$npc_id]
! JO9 MOD START TBV_FIXED_PRICE_78 | 2026-10-17_trait_value
		sparks += func('jo9_traits_value', 'base_price', 'slave', common_price[demand_rating[$npc_id]])
! JO9 MOD END TBV_FIXED_PRICE_78
		if sound_on = 1: play $large_money_sound, sound_volume
		if slave['ill'] > 0: sold_ill_slave += 1 &! trigger follow-up event
		if slave['parasite'] > 0: sold_parasite_slave += 1 &! trigger follow-up event
		dynamic $clear_slave_instance, 'slave'
		master_moodlet['pos_deal'] = 5
! JO9 MOD START TBV_SALE_REWARD_0_2 | 2026-10-17_trait_value
		if fixed_brand_rise = 0:
			if brand_reputation <= demand_rating[$npc_id]/2: brand_rate += func('jo9_traits_value', 'reward', '', demand_rating[$npc_id]/2, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_0_2
			if faction_fame[$npc_alignment[$npc_id]] < demand_rating[$npc_id]/2:
				dynamic $rise_faction_fame
! JO9 MOD START TBV_SALE_REWARD_0_1 | 2026-10-17_trait_value
				brand_rate += func('jo9_traits_value', 'reward', '', 1, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_0_1
! JO9 MOD START TBV_SALE_REWARD_0_0 | 2026-10-17_trait_value
			end
		elseif brand_reputation < 3:
			brand_rate += func('jo9_traits_value', 'reward', '', fixed_brand_rise, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_0_0
		end
	else
		killvar '$text'
		if charm_demand > charm: $text[1] = $refuse_charm_quote[$npc_id]
		if slave_specialisation[$interesting_specialisation[$npc_id]] < demand_rating[$npc_id]/2: $text[1] = $refuse_skill_quote[$npc_id]
		if demand_rating[$npc_id] > rating: $text[1] = $refuse_level_quote[$npc_id]
		if slave['wounds'] > 0 or slave['energy'] < 0 or slave['stamina'] < 2: $text[1] = $refuse_health_quote[$npc_id]
		if slave['rehabilitation'] > 0 or $slave_psy_status = 'broken': $text[1] = $refuse_health_quote[$npc_id]
		if slave['pregnant'] > 0 and slave['pregnant_revealed'] > 0: $text[1] = $refuse_pregnant_quote[$npc_id]
		if slave[$npc_id] > 0: $text[1] = $refuse_again_quote[$npc_id]
	end
end

!interaction type - slave sell to clients from houses, new scheme
if $interaction_type = 'sell_slave_house':
	gs '$slave_price'
	if slave[$npc_id] > 0 and (day - slave[$npc_id]) >= 10: slave[$npc_id] = 0
	if rating >= demand_rating[$npc_id] and slave[$npc_id] = 0: buyer_interested = 1
	!if slave_specialisation[$interesting_specialisation[$npc_id]] >= demand_rating[$npc_id]/2: buyer_interested = 1
	!charm_demand_max = 15 + demand_rating[$npc_id]
	!charm_demand = rand(5,charm_demand_max)
									charm_demand = 6  &! require D- charm ( 6+) at F-/D-/D+ rating    (0-2)
	if demand_rating[$npc_id] >= 3: charm_demand = 12 &! require C- charm (12+) at C-/C+ rating       (3-4)
	if demand_rating[$npc_id] >= 5: charm_demand = 18 &! require B+ charm (18+) at B-/B+ rating       (5-6)
	if demand_rating[$npc_id] >= 7: charm_demand = 24 &! require A+ charm (24+) at A-/A+ rating       (7-8)
	if demand_rating[$npc_id] >= 9: charm_demand = 38 &! require S+ charm (38+) at S-/S+ rating       (9-10)
	if charm_demand > charm and buyer_interested = 1 and no_charm_check = 1: buyer_interested = 1
	if charm_demand > charm and buyer_interested = 1 and no_charm_check = 0: buyer_interested = 0
	if slave['wounds'] > 0 or slave['energy'] < 0 or slave['stamina'] < 2: buyer_interested = 0
	if slave['rehabilitation'] > 0 or $slave_psy_status = 'broken': buyer_interested = 0
	if slave['pregnant'] > 0 and slave['pregnant_revealed'] > 0: buyer_interested = 0
	if buyer_interested = 1:
		buyer_from_house = 1
		gt 'slave_sell'
	else
		killvar '$text'
		if charm_demand > charm: $text[1] = $refuse_charm_quote[$npc_id]
		if demand_rating[$npc_id] > rating: $text[1] = $refuse_level_quote[$npc_id]
		if slave_specialisation[$interesting_specialisation[$npc_id]] < demand_rating[$npc_id]/2: $text[1] = $refuse_skill_quote[$npc_id]
		if slave['wounds'] > 0 or slave['energy'] < 0 or slave['stamina'] < 2: $text[1] = $refuse_health_quote[$npc_id]
		if slave['rehabilitation'] > 0 or $slave_psy_status = 'broken': $text[1] = $refuse_health_quote[$npc_id]
		if slave['pregnant'] > 0 and slave['pregnant_revealed'] > 0: $text[1] = $refuse_pregnant_quote[$npc_id]
		if slave[$npc_id] > 0: $text[1] = $refuse_again_quote[$npc_id]
	end
end

!interaction type - slave sold to clients from houses, new scheme (used for negotiation sales)
if $interaction_type = 'slave_sold_house':
	npc = 1
! JO9 MOD START TBV_SALE_REWARD_1_4 | 2026-10-17_trait_value
	npc_progress[$npc_id] = 2
	personal_relations[$npc_id] += func('jo9_traits_value', 'reward', '', client_satisfaction, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_1_4
	if client_satisfaction > 0:
		if fixed_brand_rise = 0:
			if have_discounted = 1:
! JO9 MOD START TBV_SALE_REWARD_1_3 | 2026-10-17_trait_value
				if brand_reputation <= demand_rating[$npc_id]/2: brand_rate += func('jo9_traits_value', 'reward', '', demand_rating[$npc_id], jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_1_3
				have_discounted = 0
			else
! JO9 MOD START TBV_SALE_REWARD_1_2 | 2026-10-17_trait_value
				if brand_reputation <= demand_rating[$npc_id]/2: brand_rate += func('jo9_traits_value', 'reward', '', demand_rating[$npc_id]/2, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_1_2
			end
			if faction_fame[$npc_alignment[$npc_id]] < demand_rating[$npc_id]/2: dynamic $rise_faction_fame
		elseif brand_reputation < 3:
! JO9 MOD START TBV_SALE_REWARD_1_1 | 2026-10-17_trait_value
			brand_rate += func('jo9_traits_value', 'reward', '', fixed_brand_rise, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_1_1
		end
! JO9 MOD START TBV_SALE_REWARD_1_0 | 2026-10-17_trait_value
	elseif client_satisfaction < 0:
		brand_rate += func('jo9_traits_value', 'reward', '', client_satisfaction, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_1_0
	end
	sparks += sell_price
	if sound_on = 1: play $large_money_sound, sound_volume
	if slave['ill'] > 0: sold_ill_slave = 1 &! trigger follow-up event
	if slave['parasite'] > 0: sold_parasite_slave = 1 &! trigger follow-up event
	dynamic $sold_clothing
	dynamic $clear_slave_instance, 'slave'
	master_moodlet['pos_deal'] = 5
	city_form = city_form_transfer
	$place = $place_transfer
end

!interaction type - sell_slave_complex (no negotiating, but check special demands and charm and raise brand rate by demand rating)
if hero_choice < 100:
	if $interaction_type = 'sell_slave_complex':
		gs 'slave_sell_chek'
		if buyer_interested = 1:
			killvar '$text'
			$text[1] = $buy_quote[$npc_id]
			if noprice = 0:
! JO9 MOD START TBV_FIXED_PRICE_177 | 2026-10-17_trait_value
				sparks += func('jo9_traits_value', 'base_price', 'slave', common_price[demand_rating[$npc_id]])
! JO9 MOD END TBV_FIXED_PRICE_177
				if sound_on = 1: play $large_money_sound, sound_volume
				master_moodlet['pos_deal'] = 5
			end
			if slave['ill'] > 0: sold_ill_slave = 1 &! trigger follow-up event
			if slave['parasite'] > 0: sold_parasite_slave = 1 &! trigger follow-up event
			dynamic $clear_slave_instance, 'slave'
		!fixed code for kings
			if demand_rating[$npc_id] = 10:
! JO9 MOD START TBV_SALE_REWARD_2_3 | 2026-10-17_trait_value
				brand_rate += func('jo9_traits_value', 'reward', '', 20, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_2_3
			else
! JO9 MOD START TBV_SALE_REWARD_2_2 | 2026-10-17_trait_value
				brand_rate += func('jo9_traits_value', 'reward', '', demand_rating[$npc_id], jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_2_2
			end

			if faction_fame[$npc_alignment[$npc_id]] < demand_rating[$npc_id]/2: dynamic $rise_faction_fame
			npc_progress[$npc_id] = 2
			active[$quest[5]] = 0
			if noble_status = 0 and demand_rating[$npc_id] = 10:
				noble_status = 1
				if $npc_alignment[$npc_id] = 'taurus' or $npc_alignment[$npc_id] = 'serpis' or $npc_alignment[$npc_id] = 'kamira' or $npc_alignment[$npc_id] = 'korvus':
					noble_via_faction = 1
				end
			end
		else
			if sl_txt = 105: $text[1] = $refuse_pregnant_quote[$npc_id]
			if sl_txt = 104: $text[1] = $refuse_health_quote[$npc_id]
			if sl_txt = 103: $text[1] = $refuse_charm_quote[$npc_id]
			if sl_txt = 102: $text[1] = $refuse_skill_quote[$npc_id]
			if sl_txt = 101: $text[1] = $refuse_level_quote[$npc_id]
			if sl_txt = 100 and $refuse_special_quote[$npc_id] ! '': $text[1] = $refuse_special_quote[$npc_id]
		end
	end
else
	if $interaction_type = 'sell_slave_complex':
		gs 'slave_sell_chek'
! JO9 MOD START TBV_FIXED_PRICE_215 | 2026-10-17_trait_value
		if buyer_interested = 1:
			$text[1] = $buy_quote[$npc_id]
			if noprice = 0:
				sparks += func('jo9_traits_value', 'base_price', 'slave', common_price[demand_rating[$npc_id]])
! JO9 MOD START TBV_SALE_REWARD_2_0 | 2026-10-17_trait_value
! JO9 MOD START TBV_SALE_REWARD_2_1 | 2026-10-17_trait_value
! JO9 MOD END TBV_FIXED_PRICE_215
				if sound_on = 1: play $large_money_sound, sound_volume
				master_moodlet['pos_deal'] = 5
			end
			if slave['ill'] > 0: sold_ill_slave = 1 &! trigger follow-up event
			if slave['parasite'] > 0: sold_parasite_slave = 1 &! trigger follow-up event
			dynamic $clear_slave_instance, 'slave'
		!fixed code for kings
			if demand_rating[$npc_id] = 10:
				brand_rate += func('jo9_traits_value', 'reward', '', 20, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_2_1
			else
				brand_rate += func('jo9_traits_value', 'reward', '', demand_rating[$npc_id], jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_2_0
			end

			if faction_fame[$npc_alignment[$npc_id]] < demand_rating[$npc_id]/2: dynamic $rise_faction_fame
			npc_progress[$npc_id] = 2
			active[$quest[5]] = 0
			if noble_status = 0 and demand_rating[$npc_id] = 10: noble_status = 1
		else
			if sl_txt = 105: $text[1] = $refuse_pregnant_quote[$npc_id]
			if sl_txt = 104: $text[1] = $refuse_health_quote[$npc_id]
			if sl_txt = 103: $text[1] = $refuse_charm_quote[$npc_id]
			if sl_txt = 102: $text[1] = $refuse_skill_quote[$npc_id]
			if sl_txt = 101: $text[1] = $refuse_level_quote[$npc_id]
			if sl_txt = 100 and $refuse_special_quote[$npc_id] ! '': $text[1] = $refuse_special_quote[$npc_id]
		end
	end
end

!interaction type - cow sell
if $interaction_type = 'sell_milk_cow':
	gs '$cow_price'
	$text[1] = '야릭는 타산적인 눈빛으로 네 노예를 훑어보며 너를 외양간으로 안내한다.'
	if cow['cowSK'] > 2: buyer_interested = 1
	if cow['wounds'] > 0 or cow['energy'] < 0 or cow['stamina'] < 1: buyer_interested = 0
	if cow['cowSK'] > 2 and cowprice < 800:
		buyer_interested = 0
	end
	if buyer_interested = 1:
		copyarr '$text', '$cow_auction'
		$special_action[arrsize('$cow_auction')-1] = { gt 'choice_screen' }
		$yes = {
			npc_progress[$npc_id] = 2
			sparks += cowprice
			if sound_on = 1: play $large_money_sound, sound_volume
			if cow['ill'] > 0: sold_ill_slave += 1 &! trigger follow-up event
			if cow['parasite'] > 0: sold_parasite_slave += 1 &! trigger follow-up event
			dynamic $clear_slave_instance, 'cow'
			master_moodlet['pos_deal'] = 5
			gt 'shop_general'
		}
		$no = {
			gt 'shop_general'
		}
	else
		if cow['cowSK'] < 3:
! JO9 MOD START J9M1686 | 2026-10-09_dialogue_format_and_protagonist, 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
			$text[2] = '<i>야릭가 네 여자를 재빨리 살펴본 뒤, 네 쪽으로 돌아선다:</i><br>[야릭]<br>&nbsp;' + _
			'젖이 돈다고 소가 되는 건 아니지! 네 여자는 외양간에서 더 오래 지내면서 소처럼 행동하는 법을 배워야 해. 제안은 못 하겠군, 미안하오 조련사님.'
! JO9 MOD END J9M1686
		elseif cow['wounds'] > 0 or cow['energy'] < 0 or cow['stamina'] < 2:
			$text[2] = $refuse_health_quote[$npc_id]
		elseif cow['cowSK'] > 2 and cowprice < 800:
! JO9 MOD START J9M1685 | 2026-10-09_dialogue_format_and_protagonist, 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
			$text[2] = '<i>야릭가 네 여자를 재빨리 살펴본 뒤, 네 쪽으로 돌아선다:</i><br>[야릭]<br>&nbsp;' + _
			'죄송하지만 조련사님, 이 여잔 받을 수 없소, 생산성이 충분하지 않을 거요. 외양간 생활에 더 익숙해진다면 모를까… 하지만, 음흠, 어쩌면 영영 좋은 소는 되지 못할지도 모르겠군.'
! JO9 MOD END J9M1685
		end
	end
end

if $interaction_type = 'ask_milk_tip':
	! tip_asked is set in interaction_city to a random value between 2 and 6 (roll of 1 does not come here)
	! a roll of 1, or not buying a tip, results in equal probability of overnight price rise/drop/no change
	! buying tips daily costs on average 41$ per decade (no fee if no tip), offsetting profits in exchange for lower risk of being forced to sell at unfavorable market price
	! since farmhand automates selling milk at optimal market price, influencing probability through tips is unnecessary unless a run of bad luck occurs over multiple decades
	! or, when finances are tight enough that some milk may need to be sold at below-optimal prices to cover costs, it is prudent to invest in tips, especially on day 8 of 10
	milk_tip = 1
	if milk_price < 2 and tip_asked < 5:
		tip_asked += 2 &! price cannot go down further; worst case no change (2 + 2 = 4); buying a tip at min price doubles chance of price rise to 2/3 instead of 1/3
		! because a roll of 3 becomes a price rise instead of a price drop, and a roll of 4 becomes a price rise instead of no change
	elseif milk_price < 7 and milk_price > 1 and tip_asked < 6:
		tip_asked += 1 &! below-max price makes higher demand more likely; buying a tip while below max price halves chance of price drop to 1/6 instead of 1/3
		! because a roll of 3 becomes no change instead of a price drop and a roll of 4 becomes a price rise instead of no change
	elseif milk_price > 6 and tip_asked > 2:
		tip_asked = 4 &! price cannot go up further; buying a tip at max price halves chance of price drop 1/6 instead of 1/3
		! because a roll of 3 or 5 or 6 becomes no change instead of a price drop or a price rise
	end
	if tip_asked = 2 or tip_asked = 3:
		milk_demand = 0 &! going down
		$text[1] = '<<$tip_milk[milk_demand]>>'
	end
	if tip_asked = 4:
		milk_demand = 1 &! no change
		$text[1] = '<<$tip_milk[milk_demand]>>'
	end
	if tip_asked = 5 or tip_asked = 6:
		milk_demand = 2 &! going up
		$text[1] = '<<$tip_milk[milk_demand]>>'
	end
end

!interaction type - Bryn teaches the hero a special technique
if $interaction_type = 'learn_spm':
	$place = 'colosseum'
	$return_lock = 'next_day' & is_home = 1 &! is_home = 1 to bypass menu_form ESC intercept
	npc = 1
	$npc_id = 'брина_рыжая'
! JO9 MOD START J9M1684 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
	$text[1] = '[적발의 브리나]<br>&nbsp;자! 더 세게!! 더 빠르게!!! 네 싸움 솜씨는 열두 살짜리 계집애보다도 못하군, 노예상인. 하하, 받아라! 느껴지나? 그래, 바로 이거야. 이렇게 해야 적을 죽일 수 있어! 일어나, 멍청아! 다시. 더 세게!! 더 빠르게!!!'
	$text[2] = '  브리나은 하루 종일 널 훈련장 안에서 굴려 대고, 그 결과 당신은 완전히 쥐어짠 듯한 기분이 든다. 시범 타격을 얻어맞은 탓에 온몸에 멍이 들었다. 그런데 그걸로 스파크까지 받아 간다! 뭐, 적어도 이제 당신은 새로운 강력한 기술을 알게 됐다. 이제 집으로. 쉴 시간이다…'
! JO9 MOD END J9M1684
	if $master_spm[1] = '': 
		$master_spm[1] = $spm_to_learn 
	elseif $master_spm[2] = '': 
		$master_spm[2] = $spm_to_learn 
	elseif $master_spm[3] = '': 
		$master_spm[3] = $spm_to_learn 
	elseif $master_spm[4] = '': 
		$master_spm[4] = $spm_to_learn 
	elseif $master_spm[5] = '': 
		$master_spm[5] = $spm_to_learn 
	elseif $master_spm[6] = '': 
		$master_spm[6] = $spm_to_learn 
	elseif $master_spm[7] = '': 
		$master_spm[7] = $spm_to_learn 
	elseif $master_spm[8] = '': 
		$master_spm[8] = $spm_to_learn 
	end
	spm_learned[$spm_to_learn] = 1
	spm_number += 1
end

!interaction type - sold slave
if $interaction_type = 'slave_sold':
! JO9 MOD START TBV_SALE_REWARD_3_3 | 2026-10-17_trait_value
	personal_relations[$npc_id] += func('jo9_traits_value', 'reward', '', client_satisfaction, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_3_3
	if client_satisfaction > 0 and npc_bennies[$npc_id] > 0:
		bennies_give = 1 + rating - demand_rating[$npc_id]
		if bennies_give <=  npc_bennies[$npc_id]:
! JO9 MOD START TBV_SALE_REWARD_3_2 | 2026-10-17_trait_value
			brand_rate += func('jo9_traits_value', 'reward', '', bennies_give, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_3_2
			npc_bennies[$npc_id] -= bennies_give
		else
! JO9 MOD START TBV_SALE_REWARD_3_1 | 2026-10-17_trait_value
			brand_rate += func('jo9_traits_value', 'reward', '', npc_bennies[$npc_id], jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_3_1
			npc_bennies[$npc_id] = 0
		end
	end
	if client_satisfaction < 0 and npc_bennies[$npc_id] > 0:
! JO9 MOD START TBV_SALE_REWARD_3_0 | 2026-10-17_trait_value
		brand_rate += func('jo9_traits_value', 'reward', '', client_satisfaction, jo9_trait_value_sold_peerless)
! JO9 MOD END TBV_SALE_REWARD_3_0
		npc_bennies[$npc_id] += client_satisfaction
		if npc_bennies[$npc_id] < 0: npc_bennies[$npc_id] = 0
	end
	$return_lock = $return_lock_transfer
	sparks += sell_price
	if slave['ill'] > 0: sold_ill_slave = 1 &! trigger follow-up event
	if slave['parasite'] > 0: sold_parasite_slave = 1 &! trigger follow-up event
	dynamic $sold_clothing
	dynamic $clear_slave_instance, 'slave'
	master_moodlet['pos_deal'] = 5
	rr = rand(0,10)
	no_slave_count[$npc_id] = count_size[$npc_id] + rr
	$place = $place_transfer
end

