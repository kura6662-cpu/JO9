# interaction_result
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M0015 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'interaction_result': gs 'snk_room_bridge', 'guard', 'interaction_result'
! JO9 MOD END J9M0015

if first_visit['interaction_result'] = 0:
	first_visit['interaction_result'] = 1 &! do-once

	killvar '$master_slave_interaction_types'
	killvar '$master_assistant_interaction_types'
	killvar '$master_prisoner_interaction_types'
	!도나이식
	killvar '$master_room1_interaction_types'	
	killvar '$master_room2_interaction_types'	
	killvar '$master_room3_interaction_types'	
	killvar '$master_room4_interaction_types'
	killvar '$master_cow_interaction_types'
	killvar '$other_interaction_types'
	killvar '$ignored_interaction_types'
	

	! list of interaction types that involve master and slave
	$master_slave_interaction_types[] = 'talk'
	$master_slave_interaction_types[] = 'abuse'
	$master_slave_interaction_types[] = 'get_drug'
	$master_slave_interaction_types[] = 'make_slave_do'
	$master_slave_interaction_types[] = 'master_teaches_slave'
	$master_slave_interaction_types[] = 'self_sex_lesson'
	$master_slave_interaction_types[] = 'self_sex_lesson_special'
	$master_slave_interaction_types[] = 'compliment'
	$master_slave_interaction_types[] = 'praise_date'
	$master_slave_interaction_types[] = 'present'
	$master_slave_interaction_types[] = 'praise_erotic'
	$master_slave_interaction_types[] = 'praise_sweets'
	$master_slave_interaction_types[] = 'rest'
	$master_slave_interaction_types[] = 'present_torture' &! showing torture equipment to slave
	$master_slave_interaction_types[] = 'torture' &! involves master and slave but skilled master uses half-action (handled by $master_energy_drop)
	$master_slave_interaction_types[] = 'rape'
	$master_slave_interaction_types[] = 'branding'
	$master_slave_interaction_types[] = 'execution'
	$master_slave_interaction_types[] = 'chestbuster'
	$master_slave_interaction_types[] = 'milking_slave'
	$master_slave_interaction_types[] = 'lecture_slave'

	! list of interaction types that involve master and assistant
	$master_assistant_interaction_types[] = 'get_drug_assistant'
	$master_assistant_interaction_types[] = 'master_teaches_assistant'
	$master_assistant_interaction_types[] = 'make_assistant_do'
	$master_assistant_interaction_types[] = 'self_sex_lesson_assistant'
	$master_assistant_interaction_types[] = 'milking_assistant'
	$master_assistant_interaction_types[] = 'talk_assistant'
	$master_assistant_interaction_types[] = 'lecture_assistant'
	$master_assistant_interaction_types[] = 'abuse_assistant'
	$master_assistant_interaction_types[] = 'torture_assistant'
	$master_assistant_interaction_types[] = 'assistant_compliment'
	$master_assistant_interaction_types[] = 'assistant_prise_erotic'
	$master_assistant_interaction_types[] = 'assistant_prise_date'
	$master_assistant_interaction_types[] = 'assistant_rest'
	$master_assistant_interaction_types[] = 'assistant_prise_date'

	! list of interaction types that involve master and prisoner
	$master_prisoner_interaction_types[] = 'make_prisoner_do'
	$master_prisoner_interaction_types[] = 'rape_prisoner'
	$master_prisoner_interaction_types[] = 'milking_prisoner'

	! list of interaction types that involve master and cow
	$master_cow_interaction_types[] = 'milking_cow'
	$master_cow_interaction_types[] = 'impregnate_cow'

	! list of interaction types that confound one-size-fits-all treatment
	$other_interaction_types[] = 'spell_cast' &! involves master and possibly slave or assistant (auspex)
	$other_interaction_types[] = 'make_slave_assistant_do' &! involves slave and assistant and possibly master
	$other_interaction_types[] = 'assistant_teaches_slave' &! involves assistant and slave, no master
	$other_interaction_types[] = 'coach_teaches_slave' &! involves slave only
	$other_interaction_types[] = 'school_class' &! involves slave and either assistant or master as escort
	$other_interaction_types[] = 'prisoner_torture' &! involves master, prisoner and slave (as observer)
	$other_interaction_types[] = 'milking_farmhand' &! involves farmhand and slave
	$other_interaction_types[] = 'cow_insemination' &! involves cow and anonymous npcs
	$other_interaction_types[] = 'completed' &! does not increment interaction counters
	$other_interaction_types[] = 'competition'
	$other_interaction_types[] = 'make_slave_assistant_do'
	$other_interaction_types[] = 'reward_special'
	$other_interaction_types[] = 'prise_date'
	
	!도나이식
	$master_room1_interaction_types[] = 'make_room1_do'	
	$master_room2_interaction_types[] = 'make_room2_do'	
	$master_room3_interaction_types[] = 'make_room3_do'	
	$master_room4_interaction_types[] = 'make_room4_do'			
	$master_room1_interaction_types[] = 'milking_room1'	
	$master_room2_interaction_types[] = 'milking_room2'	
	$master_room3_interaction_types[] = 'milking_room3'	
	$master_room4_interaction_types[] = 'milking_room4'	

	! list of interaction types that are ignored in this location, but are handled in interaction_screen
	$ignored_interaction_types[] = 'basic'
	$ignored_interaction_types[] = 'special'
	$ignored_interaction_types[] = 'special_png'
	$ignored_interaction_types[] = 'special_talk'

	$dyn_interaction_result_extras = {
		if sex_quality > 0:
			sex_quality = max(1, min(interaction_dynslave['diligence'], sex_quality)) &! sex_quality [1,5] cannot exceed diligence
			if dynslave_state = CONST_INT['slave_faint']: sex_quality = 1 &! unconscious slaves cannot apply their skills to improve sex quality for the master - ImperatorAugustus
		end

		if interaction_dynslave['res'] >= 0 and interaction_dynslave['diligence'] > 0 and $interaction_type ! 'talk' and $interaction_type ! 'abuse': dynslave_rate['custom'] += 1 &! obedience is habit-forming

		! when compelled by Domini Dictum to do things the slave does not want to do, angst rate increases proportionally
		if interaction_dynslave['res'] < 0 and dynslave['domini_dictum'] = 1:
			dynslave_rate['angst'] -= interaction_dynslave['res']
			interaction_dynslave['res'] = 0 &! Domini Dictum guarantees obedience
			$dynslave_psy_status = 'reluctant' &! for better text selection
		end

		! increase applicable trait xp, reveal applicable hidden traits, apply moodlets, adjust sex skill training difficulty based on applicable traits, and clear pain threat if appropriate
		if interaction_dynslave['res'] >= 0:
			if orgastic > 0:
				if dynslave['nymphomania'] < 0: rise_mod += -2
				if dynslave['nymphomania'] = 2: rise_mod += 2
				if dynslave['nymphomania_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['nymphomania_revealed'] = 1
				! xp is gained from orgasms
			end
			if painful > 0:
				if dynslave['masochism'] < 0: rise_mod += -2
				if dynslave['masochism'] = 2: rise_mod += 2
				if dynslave['masochism_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['masochism_revealed'] = 1
				if dynslave['masochism'] ! 2: dynslave['neg_pain'] = max(dynslave['neg_pain'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['masochism_xp'] += 1
				dynslave['threat_pain'] = 0 &! fulfills threat if one was made - ImperatorAugustus
			end
			if shameful > 0:
				if dynslave['exhibitionism'] < 0: rise_mod += -2
				if dynslave['exhibitionism'] = 2: rise_mod += 2
				if dynslave['exhibitionism_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['exhibitionism_revealed'] = 1
				if dynslave['exhibitionism'] ! 2: dynslave['neg_shame'] = max(dynslave['neg_shame'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['exhibitionism_xp'] += 1
				if torture_succeeded > 0 and difficulty_setting = 2 and dynslave['pride'] > 2: dynslave_rate['pride'] -= 2*torture_intensity &! only for hardcore obedience difficulty, otherwise it is handled in $dyn_torture_result
			end
			if disgusting > 0:
				if dynslave['perversion'] < 0: rise_mod += -2
				if dynslave['perversion'] = 2: rise_mod += 2
				if dynslave['perversion_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['perversion_revealed'] = 1
				if dynslave['perversion'] ! 2: dynslave['neg_disgust'] = max(dynslave['neg_disgust'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['perversion_xp'] += 1
				if torture_succeeded > 0 and difficulty_setting = 2 and dynslave['pride'] > 2: dynslave_rate['pride'] -= 2*torture_intensity &! only for hardcore obedience difficulty, otherwise it is handled in $dyn_torture_result
			end
			if abuse > 0:
				if dynslave['abuse_attitude'] < 0: rise_mod += -2
				if dynslave['abuse_attitude'] = 2: rise_mod += 2
				if dynslave['abuse_attitude_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['abuse_attitude_revealed'] = 1
				if dynslave['abuse_attitude'] ! 2: dynslave['neg_abuse'] = max(dynslave['neg_abuse'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['abuse_xp'] += 1
			end
			if lesbian > 0:
				if dynslave['homosexualism'] < 0: rise_mod += -2
				if dynslave['homosexualism'] = 2: rise_mod += 2
				if dynslave['homosexualism_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['homosexualism_revealed'] = 1
				if dynslave['homosexualism'] ! 2: dynslave['neg_disgust'] = max(dynslave['neg_disgust'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['lesbian_xp'] += 1
			end
			if bloody > 0:
				if dynslave['blood_attitude'] < 0: rise_mod += -2
				if dynslave['blood_attitude'] = 2: rise_mod += 2
				if dynslave['blood_attitude_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['blood_attitude_revealed'] = 1
				if dynslave['blood_attitude'] ! 2: dynslave['neg_disgust'] = max(dynslave['neg_disgust'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['blood_xp'] += 1
			end
			if darkness > 0:
				if dynslave['darkness_attitude'] < 0: rise_mod += -2
				if dynslave['darkness_attitude'] = 2: rise_mod += 2
				if dynslave['darkness_attitude_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['darkness_attitude_revealed'] = 1
				if dynslave['darkness_attitude'] ! 2: dynslave['neg_disgust'] = max(dynslave['neg_disgust'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['darkness_xp'] += 1
			end
			if deprivation > 0:
				if dynslave['deprivation_attitude'] < 0: rise_mod += -2
				if dynslave['deprivation_attitude'] = 2: rise_mod += 2
				if dynslave['deprivation_attitude_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['deprivation_attitude_revealed'] = 1
				if dynslave['deprivation_attitude'] ! 2: dynslave['neg_disgust'] = max(dynslave['neg_disgust'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['deprivation_xp'] += 1
			end
			if fire_based > 0:
				if dynslave['fire_attitude'] < 0: rise_mod += -2
				if dynslave['fire_attitude'] = 2: rise_mod += 2
				if dynslave['fire_attitude_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['fire_attitude_revealed'] = 1
				if dynslave['fire_attitude'] ! 2: dynslave['neg_disgust'] = max(dynslave['neg_disgust'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['fire_xp'] += 1
			end
			if water_based > 0:
				if dynslave['water_attitude'] < 0: rise_mod += -2
				if dynslave['water_attitude'] = 2: rise_mod += 2
				if dynslave['water_attitude_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['water_attitude_revealed'] = 1
				if dynslave['water_attitude'] ! 2: dynslave['neg_disgust'] = max(dynslave['neg_disgust'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['water_xp'] += 1
			end
			if vermin_based > 0:
				if dynslave['vermin_attitude'] < 0: rise_mod += -2
				if dynslave['vermin_attitude'] = 2: rise_mod += 2
				if dynslave['vermin_attitude_revealed'] = 0 and 'dynslave' = $interaction_partner: dynslave['vermin_attitude_revealed'] = 1
				if dynslave['vermin_attitude'] ! 2: dynslave['neg_disgust'] = max(dynslave['neg_disgust'], min(torture_intensity, dynslave['sensitivity']))
				dynslave['vermin_xp'] += 1
			end
			!compassion is handled in the appropriate interactions - ImperatorAugustus
		end &! end of res check
	}
end

if arrcomp('$master_slave_interaction_types', $interaction_type) ! -1:
	$interaction_partner = 'slave'
elseif arrcomp('$master_assistant_interaction_types', $interaction_type) ! -1:
	$interaction_partner = 'assistant'
elseif arrcomp('$master_prisoner_interaction_types', $interaction_type) ! -1:
	$interaction_partner = 'prisoner'
elseif arrcomp('$master_cow_interaction_types', $interaction_type) ! -1:
	$interaction_partner = 'cow'
!도나이식
elseif arrcomp('$master_room1_interaction_types', $interaction_type) ! -1:
	$interaction_partner = 'room1'	
elseif arrcomp('$master_room2_interaction_types', $interaction_type) ! -1:
	$interaction_partner = 'room2'	
elseif arrcomp('$master_room3_interaction_types', $interaction_type) ! -1:
	$interaction_partner = 'room3'	
elseif arrcomp('$master_room4_interaction_types', $interaction_type) ! -1:
	$interaction_partner = 'room4'			
elseif arrcomp('$other_interaction_types', $interaction_type) ! -1:
	$interaction_partner = ''
elseif arrcomp('$ignored_interaction_types', $interaction_type) ! -1:
	$interaction_partner = ''
else
	msg '경고! 알 수 없는 interaction 타입 (<<interaction>>): ''<<$interaction_type>>''. 이것을 보고해 주십시오!'
	$interaction_partner = ''
end


!consolidated pre-work for specific interactions
dynamic $do_for_each_slave_in_list, '$dyn_sex_acceptance',    '$main_screen_slave_characters' &! fills in interaction_*['sex_acceptance']
dynamic $do_for_each_slave_in_list, '$dyn_repulse_check',     '$main_screen_slave_characters' &! fills in interaction_*['res']
dynamic $do_for_each_slave_in_list, '$dyn_diligence',         '$main_screen_slave_characters' &! fills in interaction_*['diligence']
dynamic $do_for_each_slave_in_list, '$dyn_torture_phobia',    '$main_screen_slave_characters' &! fills in interaction_*['phobia']
!intentionally not done here because it should be done after $special_part:  $dyn_erotic_stimulation

if $interaction_partner ! '':
	dynamic $replace($dyn_reward_potence, 'dyn'+'slave', $interaction_partner)   &! modifies interaction_reward_potence
	if debug_interactions > 0: dynamic $replace({msg 'dynslave: $interaction_type (<<interaction>>) = <<$interaction_type>>, sex_acceptance = <<interaction_dynslave[''sex_acceptance'']>>, obedience = <<dynslave[''obedience'']>>, repulse = <<interaction_dynslave[''repulse'']>>, res = <<interaction_dynslave[''res'']>>, motivation_repulse = <<interaction_dynslave[''motivation_repulse'']>>, diligence = <<interaction_dynslave[''diligence'']>>, psy = <<$dynslave_psy_status>>, mood = <<dynslave[''mood'']>>, arousal = <<dynslave[''arousal'']>>, fear = <<dynslave[''fear'']>>, pride = <<dynslave[''pride'']>>, taming = <<dynslave[''instinct'']>>, habit = <<dynslave[''custom'']>>, awareness = <<dynslave[''rational'']>>, devotion = <<dynslave[''moral'']>>, today = <<dynslave_already_done_today[$str(interaction)]>>, recent = <<dynslave_already_done_recent[$str(interaction)]>>, total = <<dynslave_already_done_total[$str(interaction)]>>'}, 'dynslave', $interaction_partner)
	dynamic $replace($dyn_interaction_result_extras, 'dyn'+'slave', $interaction_partner)
elseif $interaction_type = "make_slave_assistant_do" or $interaction_type = "assistant_teaches_slave":
	if debug_interactions > 0: dynamic $replace({msg 'dynslave: $interaction_type (<<interaction>>) = <<$interaction_type>>, sex_acceptance = <<interaction_dynslave[''sex_acceptance'']>>, obedience = <<dynslave[''obedience'']>>, repulse = <<interaction_dynslave[''repulse'']>>, res = <<interaction_dynslave[''res'']>>, motivation_repulse = <<interaction_dynslave[''motivation_repulse'']>>, diligence = <<interaction_dynslave[''diligence'']>>, psy = <<$dynslave_psy_status>>, mood = <<dynslave[''mood'']>>, arousal = <<dynslave[''arousal'']>>, fear = <<dynslave[''fear'']>>, pride = <<dynslave[''pride'']>>, taming = <<dynslave[''instinct'']>>, habit = <<dynslave[''custom'']>>, awareness = <<dynslave[''rational'']>>, devotion = <<dynslave[''moral'']>>, today = <<dynslave_already_done_today[$str(interaction)]>>, recent = <<dynslave_already_done_recent[$str(interaction)]>>, total = <<dynslave_already_done_total[$str(interaction)]>>'}, 'dynslave', 'slave')
	dynamic $replace($dyn_interaction_result_extras, 'dyn'+'slave', 'slave')
	dynamic $replace($dyn_interaction_result_extras, 'dyn'+'slave', 'assistant')
elseif $interaction_type = "coach_teaches_slave" or _ 
       $interaction_type = "school_class" or _ 
       $interaction_type = "milking_farmhand" or _ 
       $interaction_type = "cow_insemination":
	if debug_interactions > 0: dynamic $replace({msg 'dynslave: $interaction_type (<<interaction>>) = <<$interaction_type>>, sex_acceptance = <<interaction_dynslave[''sex_acceptance'']>>, obedience = <<dynslave[''obedience'']>>, repulse = <<interaction_dynslave[''repulse'']>>, res = <<interaction_dynslave[''res'']>>, motivation_repulse = <<interaction_dynslave[''motivation_repulse'']>>, diligence = <<interaction_dynslave[''diligence'']>>, psy = <<$dynslave_psy_status>>, mood = <<dynslave[''mood'']>>, arousal = <<dynslave[''arousal'']>>, fear = <<dynslave[''fear'']>>, pride = <<dynslave[''pride'']>>, taming = <<dynslave[''instinct'']>>, habit = <<dynslave[''custom'']>>, awareness = <<dynslave[''rational'']>>, devotion = <<dynslave[''moral'']>>, today = <<dynslave_already_done_today[$str(interaction)]>>, recent = <<dynslave_already_done_recent[$str(interaction)]>>, total = <<dynslave_already_done_total[$str(interaction)]>>'}, 'dynslave', 'slave')
	dynamic $replace($dyn_interaction_result_extras, 'dyn'+'slave', 'slave')
end

!handling templates

! "OTHER" INTERACTION TYPE - MUST HANDLE ITS OWN INTERACTION COUNTERS AND ENERGY DROPS
!interaction type - studying complete
if $interaction_type = 'completed':
	show_slave_fullimage = 1
	$text[1] = 'Your slave has fully mastered this skill, and you’re unlikely to be able to teach her something new. Perhaps you should pay attention to the less developed aspects or just use her skills in practice.'
end

! "OTHER" INTERACTION TYPE - MUST HANDLE ITS OWN INTERACTION COUNTERS AND ENERGY DROPS
!magic spells
if $interaction_type = 'spell_cast':
	!no sex_acceptance, repulse_check, or diligence for spellcasting - magic resistance and effectiveness use different formulas
	if master_mage <= 0: spell_effectiveness = 1
	if master_mage = 1:  spell_effectiveness = 2
	if master_mage = 2:  spell_effectiveness = 4
	if master_mage = 3:  spell_effectiveness = 6
	if master_mage = 4:  spell_effectiveness = 8
	if master_mage = 5:  spell_effectiveness = 10
	if master_mage >= 6: spell_effectiveness = 12
	! If randomness is wanted, uncomment the line below. -RedGreen3
	!spell_effectiveness -= slave['ego'] + ((48271 * (slave_type + interaction)) mod 65537)/(63357/(1+slave['ego'])) &! against a slave with max ego, spells now have a chance to fail for all master mage skill levels except S++ - ImperatorAugustus
	dynamic $replace("$text[1] = '<<$cast_spell[interaction]>>'", 'dyn'+'slave', 'slave') &! evaluate sub-expressions with substitution
	dynamic $special_part
	dynamic $replace($dyn_erotic_stimulation, 'dyn'+'slave', 'slave') &! should be done after $special_part - ImperatorAugustus
	$place = 'study'
	$special_image[1] = 'magic.png'
	if interaction ! menu_magna_magnifika:
		! magna magnifika is self-cast on the master, not on a slave
		slave_already_done_today[$str(interaction)] += 1
		slave_already_done_total[$str(interaction)] += 1
		slave_already_done_recent[$str(interaction)] += 1
	end
	if bull_ring_on = 0: master_half_action += 1
	if silent_auto_cast = 1 and (interaction ! menu_sententia_veritas or spell_effectiveness > 0) and $return_lock = 'end_day_screen': gt $return_lock &! do not hide failed Sententia auto-cast - ImperatorAugustus
end


! "OTHER" INTERACTION TYPE - MUST HANDLE ITS OWN INTERACTION COUNTERS AND ENERGY DROPS
!interaction type - order for slave and assistant - improved and fixed - crushboss (was used only for threesome [non-lesson] interaction, now also used for lesbian show - ImperatorAugustus)
!requires slave_skill to be set by the corresponding interaction
if $interaction_type = 'make_slave_assistant_do':
	if interaction_slave['res'] < 0:
		show_slave_fullimage = 1
		$place = 'study'
		dynamic $replace("$text[1] = '<<$refuse_txt>>'", 'dyn'+'slave', 'slave') &! evaluate sub-expressions with substitution
		dynamic $sin_gained_now, 'slave'
		interaction_no_auto_energy_drop = 1
	elseif interaction_assistant['res'] < 0:
		show_assistant_fullimage = 1
		$place = 'study'
		dynamic $replace("$text[1] = '<<$refuse_txt>>'", 'dyn'+'slave', 'assistant') &! evaluate sub-expressions with substitution
		dynamic $sin_gained_now, 'assistant'
		interaction_no_auto_energy_drop = 1
	else
! JO9 MOD START J9TP_ACTIVITY_DUAL | 2026-10-17_traits_personality
gs 'jo9_traits_personality', 'activity', 'slave', 'work:' + $target_skill, 0
gs 'jo9_traits_personality', 'activity', 'assistant', 'work:' + $target_skill, 0
! JO9 MOD END J9TP_ACTIVITY_DUAL
		dynamic $special_part
		!update slave affinities, associated moodlets, and skills
		if $target_affinity ! '':
			if slave[$target_affinity] ! 0: slave[$target_affinity + '_revealed'] = max(1, slave[$target_affinity + '_revealed'])
			!revealing assistant affinities is intentionally omitted here to avoid confusion because the messages refer to "slave" (TODO)
			if slave[$target_affinity] > 0: slave['pos_job'] = max(slave['pos_job'], 2)
			if slave[$target_affinity] < 0: slave['neg_job'] = max(slave['neg_job'], 2)
			if assistant[$target_affinity] > 0: assistant['pos_job'] = max(assistant['pos_job'], 2)
			if assistant[$target_affinity] < 0: assistant['neg_job'] = max(assistant['neg_job'], 2)
		end
		if slave_skill = 0:
			dynamic $sin_gained_now, 'slave'
			dynamic $sin_gained_now, 'assistant'
		else
			dynamic $virtue_gained_now, 'slave'
			dynamic $virtue_gained_now, 'assistant'
			!tutor_modifier += iif(master_mood < 0, 1 + master_tutor/2, iif(master_mood > 3, master_tutor + 1, master_tutor))
			!dynamic $replace($dyn_skill_rise, 'dyn'+'slave', 'slave')
			dynamic $replace($dyn_advance_sex_skills_nolesson, 'dyn'+'slave', 'slave'), 'noreset'
			!tutor_modifier += iif(master_mood < 0, 1 + master_tutor/2, iif(master_mood > 3, master_tutor + 1, master_tutor))
			!dynamic $replace($dyn_skill_rise, 'dyn'+'slave', 'assistant')
			dynamic $replace($dyn_advance_sex_skills_nolesson, 'dyn'+'slave', 'assistant'), 'noreset'
		end
		dynamic $replace($dyn_erotic_stimulation, 'dyn'+'slave', 'slave') &! should be done after $special_part and after $virtue_gained_now
		dynamic $replace($dyn_erotic_stimulation, 'dyn'+'slave', 'assistant') &! should be done after $special_part and after $virtue_gained_now
		dynamic $slave_energy_drop
