!General effects (fall-through from specific interactions above)
dynamic $array_append, '$text', '$orgasm_text' & killvar '$orgasm_text' &! ensure orgasm texts are always displayed last - ImperatorAugustus

!completion counter (global, character-independent)
already_done_today[$str(interaction)] += 1

!completion updates for specific slave (does not cover the interaction types listed in $other_interaction_types)
if $interaction_partner ! '':
	dynamic "
		<<$interaction_partner>>_already_done_today[$str(interaction)] += 1
		<<$interaction_partner>>_already_done_total[$str(interaction)] += 1
		<<$interaction_partner>>_already_done_recent[$str(interaction)] += 1
		if interaction_reward_level > 0: <<$interaction_partner>>['daily_reward_count'] += 1

		! interactions that involve the master plus one other slave consume a full action for the master and the partner
		if interaction_no_auto_energy_drop = 0 and (interaction_<<$interaction_partner>>['res'] >= 0 or instr($interaction_type, 'praise') ! 0):
			! only energy drop if the repulse check succeeded and the bypass flag is not set
			dynamic $master_energy_drop
			dynamic $<<$interaction_partner>>_energy_drop
		end
	"
end

!Lecture Assistant
IF $interaction_type = 'lecture_assistant':
    txt_count = 2
! JO9 MOD START J9TP_ACTIVITY_LECTURE_A | 2026-10-17_traits_personality
gs 'jo9_traits_personality', 'activity', 'assistant', 'learn:' + $lecture_theme, 0
! JO9 MOD END J9TP_ACTIVITY_LECTURE_A
    skill_rise = master_tutor + assistant["intellect"] - assistant["world_index"]
    if skill_rise < 0: skill_rise = 0
    if skill_rise = 0:
        $text[2] = $text_2
    elseif skill_rise > 0 and skill_rise < 5:
        $text[2] = $text_3
    elseif skill_rise >= 5:
        $text[2] = $text_4
    end
! JO9 MOD START COG_LECTURE_ASSISTANT | 2026-10-16_innate_learning_traits
! JO9 MOD START J9TP_GAIN_73 | 2026-10-17_traits_personality
    assistant[$lecture_theme] += func('jo9_traits_personality', 'xp', 'assistant', $lecture_theme, func('jo9_learning_xp', (skill_rise), assistant['jo9_learning_trait'], $lecture_theme))
! JO9 MOD END J9TP_GAIN_73
! JO9 MOD END COG_LECTURE_ASSISTANT
    if assistant[$lecture_theme] >= 20: 
        $text[2] = $text_5
    end
    dynamic $special_part
END

