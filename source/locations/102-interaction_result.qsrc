IF $interaction_type = 'lecture_slave':
	$interaction_type = 'talk'
  res = slave["obedience"] + slave["fear"]
  IF res < 0:
  	$special_bg = $study
  	txt_count = 1
  	$text[1] = '<<$refuse_text>>'
  	if already_done_today[interaction] = 0 and slave["sin"] < 1: slave["sin"] = 1
  	if sententia_veritas = 1: slave["sin"] = 5 & sententia_veritas = 0 & sententia_veritas_casted = 1
  ELSE
    txt_count = 2
! JO9 MOD START J9TP_ACTIVITY_LECTURE_S | 2026-10-17_traits_personality
gs 'jo9_traits_personality', 'activity', 'slave', 'learn:' + $lecture_theme, 0
! JO9 MOD END J9TP_ACTIVITY_LECTURE_S
    skill_rise = master_tutor + slave["intellect"] - slave["world_index"]
    if skill_rise < 0: skill_rise = 0
    if skill_rise = 0:
        $text[2] = $text_2
    elseif skill_rise > 0 and skill_rise < 5:
        $text[2] = $text_3
    elseif skill_rise >= 5:
        $text[2] = $text_4
    end
! JO9 MOD START COG_LECTURE_SLAVE | 2026-10-16_innate_learning_traits
! JO9 MOD START J9TP_GAIN_72 | 2026-10-17_traits_personality
    slave[$lecture_theme] += func('jo9_traits_personality', 'xp', 'slave', $lecture_theme, func('jo9_learning_xp', (skill_rise), slave['jo9_learning_trait'], $lecture_theme))
! JO9 MOD END J9TP_GAIN_72
! JO9 MOD END COG_LECTURE_SLAVE
    if slave[$lecture_theme] >= 20: 
        $text[2] = $text_5
    end
    dynamic $special_part
  END
END


!Reset interaction variables to avoid influencing non-interaction results (e.g. $sin_gained_now in #dynamic checks 'res' variable)
dynamic $do_for_each_slave_in_list, '$reset_interaction_variables', '$main_screen_slave_characters' &! every slave instance that can be 'interacted' with (slave, assistant, prisoner, cow) - ImperatorAugustus

!interaction type - competition for slave and assistant - mrross
IF $interaction_type = 'competition':
 if couch_skill < 1: couch_skill = 1
 if couch_skill > 5: couch_skill = 5
 teacher_potential = couch_skill - slave_skill
 if teacher_potential < 0: teacher_potential = 0
 IF res < 0:
  show_slave_fullimage = 1
  $special_bg = $bedroom
  txt_count = 1  
  $text[1] = $refuse_txt
  dynamic $sin_gained_now
 ELSE
! JO9 MOD START J9TP_ACTIVITY_COMPETITION | 2026-10-17_traits_personality
gs 'jo9_traits_personality', 'activity', 'slave', 'learn:' + $replace($target_skill, 'slave_rate', 'slave'), 0
gs 'jo9_traits_personality', 'activity', 'assistant', 'learn:' + $replace($target_skill_two, 'assistant_rate', 'slave'), 0
! JO9 MOD END J9TP_ACTIVITY_COMPETITION
  tutor_modifier = assistant["intellect"]
  if master_mood < 0: tutor_modifier = (1 + (tutor_modifier/2))
  if master_mood > master_tutor: tutor_modifier += 1
  IF slave["intellect"] < 2:
   tutor_modifier -= 2
  ELSEIF slave["intellect"] = 2:
   tutor_modifier -= 1
  ELSEIF slave["intellect"] = 4:
   tutor_modifier += 1
  ELSEIF slave["intellect"] = 5:
   tutor_modifier += 2
  END
  tutor_modifier += misc_bonus
  if tutor_modifier < 0: tutor_modifier = 1
  dynamic $diligence
  dynamic $complex_diligence
  if diligence < talent_bonus: diligence = talent_bonus
  skill_rise = ((tutor_modifier * diligence)/2)
  if talent_bonus > 0 and $slave['pos_job'] < 1: $slave['pos_job'] = 1
  if slave[$target_affinity] > 0: slave['pos_job'] = 1
  if slave[$target_affinity] < 0: slave['neg_job'] = 1 & gs '$mod_slave_drop', 1
  IF $target_skill = 'slave_rate["stamina"]':
   skill_rise = skill_rise/2
   if skill_rise < 3: skill_rise = 3
  END
  if skill_rise < 1: skill_rise = 1
  IF diligence = 0: skill_rise = 1
  slave_competition_potential = slave_skill + slave_skill_2 + slave_skill_3 + diligence + complex_diligence - (slave["<<assistant['id']>>"] / 20)
  res = 5
  dynamic $diligence_assistant
  dynamic $complex_diligence_assistant
  assiatant_competition_potential = assistant_skill + assistant_skill_2 + assistant_skill_3 + diligence + complex_diligence - (assistant["<<slave['id']>>"] / 20)
  competition_result = slave_competition_potential - assiatant_competition_potential
  if competition_result > 3:
  	$text[2] = $slave_won
  	diligence = 5
  	dynamic $virtue_gained_now
  	slave["<<assistant['id']>>"] -= relation_bonus
  	assistant["<<slave['id']>>"] -= relation_bonus * 3
  elseif competition_result < -3:
  	$text[2] = $assistant_won
  	sin_potential = 3
  	dynamic $sin_gained_now  	
  	slave["<<assistant['id']>>"] -= relation_bonus * 3
  	assistant["<<slave['id']>>"] -= relation_bonus
  else
  	$text[2] = $competition_draw
  	slave["<<assistant['id']>>"] += relation_bonus * 2
  	assistant["<<slave['id']>>"] += relation_bonus * 2
  end
  IF talent_bonus > 0:
   IF slave["mood"] > 0:
    slave_rate["mood"] += slave["mood"]
   ELSE
    slave_rate["mood"] += 1
   END
  END
  master_hygiene_rate += add_master_hygiene
  slave_rate["hygiene"] += add_slave_hygiene
  assistant_rate["hygiene"] += add_assistant_hygiene
  house_mess_rate += add_house_mess
! JO9 MOD START COG_COMPETITION_SLAVE | 2026-10-16_innate_learning_traits
! JO9 MOD START TRAITS_BODY_COMPETITION_SLAVE | 2026-10-17_traits_batch
! JO9 MOD START J9TP_GAIN_71 | 2026-10-17_traits_personality
  dynamic '<<$target_skill>> += func(''jo9_traits_personality'', ''xp'', ''slave'', $target_skill, func(''jo9_traits_combat'', ''education_xp'', ''slave'', func(''jo9_learning_xp'', (skill_rise), slave[''jo9_learning_trait''], $target_skill), $target_skill))'
! JO9 MOD END J9TP_GAIN_71
! JO9 MOD END TRAITS_BODY_COMPETITION_SLAVE
! JO9 MOD END COG_COMPETITION_SLAVE
! JO9 MOD START COG_COMPETITION_ASSISTANT | 2026-10-16_innate_learning_traits
! JO9 MOD START TRAITS_BODY_COMPETITION_ASSISTANT | 2026-10-17_traits_batch
! JO9 MOD START J9TP_GAIN_70 | 2026-10-17_traits_personality
  dynamic '<<$target_skill_two>> += func(''jo9_traits_personality'', ''xp'', ''assistant'', $target_skill_two, func(''jo9_traits_combat'', ''education_xp'', ''assistant'', func(''jo9_learning_xp'', (skill_rise), assistant[''jo9_learning_trait''], $target_skill_two), $target_skill_two))'
! JO9 MOD END J9TP_GAIN_70
! JO9 MOD END TRAITS_BODY_COMPETITION_ASSISTANT
! JO9 MOD END COG_COMPETITION_ASSISTANT
  res = slave["obedience"] - repulse
  dynamic $diligence
  dynamic $special_part
!  gs '$calculate_attributes_fast'
 END
end



