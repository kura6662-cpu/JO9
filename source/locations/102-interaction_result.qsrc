	dynamic $special_part &! sets $text[1]
	dynamic $replace($dyn_erotic_stimulation, 'dyn'+'slave', 'slave') &! should be done after $special_part - ImperatorAugustus
	if $slave_psy_status = 'broken':
		slave_rate['mood'] += free_time
	elseif slave['passion_comfort'] = 1:
		interaction_reward_potence *= 2
		$text[1] += ' 그녀는 이런 안락함과 평온의 순간들을 진심으로 즐긴다.'
		slave['pos_job'] = max(slave['pos_job'], 1 + interaction_reward_level)
	elseif slave['passion_comfort'] = -1 and $slave_psy_status ! 'broken':
		interaction_reward_potence /= 2
		$text[1] += ' 그녀는 가만히 앉아 있는 것을 좋아하지 않기 때문에, 이 보상은 그리 마음에 들지 않았다.'
	end
	if slave_already_done_today[$str(interaction)] > 0:
		slave_rate['mood'] += interaction_reward_potence/2
		if slave['virtue'] < interaction_reward_level: slave_rate['spoil'] += interaction_reward_potence
		if slave['virtue'] >= interaction_reward_level: slave_rate['rational'] += 1
	else
		slave_rate['mood'] += interaction_reward_potence
		if slave['virtue'] < interaction_reward_level: slave_rate['spoil'] += interaction_reward_potence
		if slave['virtue'] >= interaction_reward_level: slave_rate['rational'] += min(interaction_reward_level, slave['intellect'])
		slave_rate['spoil'] += (1 + interaction_reward_level)/2 &! being rewarded with rest always spoils somewhat -ImperatorAugustus
	end
	slave['well_rested'] += free_time
	slave['energy'] -= free_time
	free_time = 0
	if slave['passion_comfort'] = 1 or $slave_psy_status = 'broken':
		slave['neg_cheap_reward'] = 0
	elseif slave['passion_comfort'] = -1 or interaction_reward_level < min(5, min(3, slave['total_rewards']/5) + min(3, max(slave['spoil'], slave['pride'] - 2)) - max(0, slave['moral'] - 2)):
		if slave['promise_reward'] > 0: slave['neg_cheap_reward'] = 100
	else
		slave['neg_cheap_reward'] = 0
	end
	slave['promise_reward'] = 0 &! promise fulfilled, even if the slave disliked it
	slave['total_rewards'] += 1
	sparks -= interaction_reward_cost
	slave['virtue'] = 0
end



