# #sex_options_woman
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2949 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '#sex_options_woman': gs 'snk_room_bridge', 'guard', '#sex_options_woman'
! JO9 MOD END J9M2949
!ОПЦИИ ВЫБОРА ДЛЯ СЕКС-ДВИЖКА
killvar '$play_sound'
$play_sound[1] = ''
!Обычные опции
$sex_options[0] = {
    FUNC('$menu', '===SEX_BEGIN===', 'column_3')
    FUNC('$menu', 'sex_empty_item', 1)
    IF strip = 0:
        FUNC('$menu', 'sex_interaction', $menu_item_sexStriptease, menu_sexStriptease, '스트립쇼')
    else
        FUNC('$menu', 'sex_interaction', $menu_item_sexSeduce, menu_sexSeduce, '유혹')
    END
    FUNC('$menu', 'sex_interaction', $menu_item_sexKiss, menu_sexKiss, '키스')
    FUNC('$menu', 'sex_interaction', $menu_item_Caressme, menu_Caressme, '나를 애무해 <<$intensity[intensity]>>')
    FUNC('$menu', 'sex_interaction', $menu_item_Massageher, menu_Massageher, '그녀를 마사지해 <<$intensity[intensity]>>')
    FUNC('$menu', 'sex_interaction', $menu_item_Arouseher, menu_Arouseher, '그녀를 흥분시켜 <<$intensity[intensity]>>')
    IF sex['pc_boner'] > 0:
        FUNC('$menu', 'exec_sex_options', $menu_item_Startsex, 'sex_num = 1 & gt $curloc', '섹스 시작')
    END
    FUNC('$menu', 'exec_sex_options', $menu_item_Perverse, 'sex_num = 2 & gt $curloc', '변태 놀이')
    FUNC('$menu', 'exec_sex_options', $menu_item_Exitsex, 'sex_num = 0 & gt "sex_end"', '섹스 중지')
    FUNC('$menu', '===SEX_END===')
}
$sex_options[1] = {
    FUNC('$menu', '===SEX_BEGIN===', 'column_3')
    FUNC('$menu', 'sex_empty_item', 3)
    if lube = 0: FUNC('$menu', 'sex_interaction', $menu_item_Lubricant, menu_Lubricant, '윤활제')
    IF sex['girl_virgin'] = 1:
        FUNC('$menu', 'exec_sex_options', $menu_item_Defloration, 'sex_num = 11 & sex_interaction = 11 & gt "sex_interaction_woman" ', '처녀막 파괴')
    else
        FUNC('$menu', 'exec_sex_options', $menu_item_activeVaginal, 'sex_num = 11 & sex_interaction = 12 & gt "sex_interaction_woman" ', '질 섹스')
    END
    FUNC('$menu', 'exec_sex_options', $menu_item_activeAnal, 'sex_num = 12 & sex_interaction = 13 & gt "sex_interaction_woman" ', '애널 섹스')
    FUNC('$menu', 'exec_sex_options', $menu_item_minet, 'sex_num = 13 & sex_interaction = 14 & gt "sex_interaction_woman" ', '<<$minet[intensity]>>')
    FUNC('$menu', 'exec_sex_options', $menu_item_frottage, 'sex_num = 14 & sex_interaction = 15 & gt "sex_interaction_woman" ', '<<$frottage[intensity]>>')
    FUNC('$menu', 'exec_sex_options', $menu_item_Prelude, 'sex_num = 0 & gt $curloc', '전희')
    FUNC('$menu', '===SEX_END===')
}
$sex_options[11] = {
    FUNC('$menu', '===SEX_BEGIN===', 'column_3')
    FUNC('$menu', 'sex_empty_item', 1)
	IF sex['girl_virgin'] = 1:
        FUNC('$menu', 'sex_interaction', $menu_item_Continuezvirgin, menu_Continuezvirgin, '계속하기 <<$intensity[intensity]>>')
    else
        FUNC('$menu', 'sex_interaction', $menu_item_Continuexvirgin, menu_Continuexvirgin, '계속 <<$intensity[intensity]>>')
    END
    IF sex["pc_excitement_state"] > 2:
        FUNC('$menu', 'exec_sex_options', $menu_item_Cum, 'sex_num = 0 & sex_interaction = 91 & gt "sex_interaction_woman', '사정')
    else
        FUNC('$menu', 'sex_location_gray', $menu_item_Cum_gray, empty, 'Кончить')
    END
    FUNC('$menu', 'sex_interaction', $menu_item_Caress_mouth, menu_Caress_mouth, '입으로 애무 <<$intensity[intensity]>>')
    FUNC('$menu', 'sex_interaction', $menu_item_Caress_hands, menu_Caress_hands, '손으로 애무 <<$intensity[intensity]>>')
    FUNC('$menu', 'sex_interaction', $menu_item_sex_comment, menu_sex_comment, '<<$sex_comment[intensity]>>')
    FUNC('$menu', 'sex_interaction', $menu_item_sex_hit, menu_sex_hit, '<<$sex_hit[intensity]>>')
    FUNC('$menu', 'sex_interaction', $menu_item_Bite, menu_Bite, '물기 <<$intensity[intensity]>>')
    !$sex_menu += "<div id=""under"">Strangle <<$intensity[intensity]>> <br><div id = ""clear""><a href = 'EXEC: sex_interaction = 166 & gt ""sex_interaction""'><img src = ""content\pic\clear.png""></a></div></div>"
    FUNC('$menu', 'exec_sex_options', $menu_item_Stopsex, 'sex_num = 0 & gt $curloc', '섹스 중지')
    FUNC('$menu', '===SEX_END===')
}
