        FUNC('$menu', 'sex_interaction', $menu_item_Tie_her, menu_Tie_her, '묶기')
    else
        FUNC('$menu', 'sex_interaction', $menu_item_Untie_her, menu_Untie_her, '풀어주기')
    END
    IF sex['clamps'] = 0:
        FUNC('$menu', 'sex_interaction', $menu_item_Nipple_clamps, menu_Nipple_clamps, '유두 클램프')
    ELSE
        FUNC('$menu', 'sex_interaction', $menu_item_Remove_clamps, menu_Remove_clamps, '클램프 제거')
