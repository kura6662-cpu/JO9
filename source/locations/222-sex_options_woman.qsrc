   $sex_menu += {<div id="under">꺼짐<br><div id = "clear"><a href = 'EXEC: nsfw = 0 & gt curloc'><img src = "content\pic\clear.png"></a></div></div>}
  END
  $sex_menu += {<br><br><br><div id="under">Назад <br><div id = "clear"><a href = 'EXEC: sex_num = 0 & gt curloc'><img src = "content\pic\clear.png"></a></div></div>}
