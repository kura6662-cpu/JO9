$sex_options[2] = {
    FUNC('$menu', '===SEX_BEGIN===', 'column_3')
    IF sex["eyes_bound"] = 0:
        FUNC('$menu', 'sex_interaction', $menu_item_Blindfold_her, menu_Blindfold_her, '그녀에게 안대 씌우기')
    else
        FUNC('$menu', 'sex_interaction', $menu_item_Remove_blindfold, menu_Remove_blindfold, '안대 벗기기')
    END
