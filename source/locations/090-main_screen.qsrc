# main_screen
! Readable view; authoritative fields are in ../locations.json.
ui_style = 2
! JO9_SINGLE_GRIMDARK_UI_20261014
! JO9 MOD START J9M1303 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'main_screen': gs 'snk_room_bridge', 'guard', 'main_screen'
if snk_room_target > 0: gs 'snk_room_menu_screen' & exit
! JO9 MOD END J9M1303
! JO9_UI_V16_READABILITY
$jo9_v16_fast_sex_S = ''
$jo9_v16_fast_sex_A = ''
$jo9_v16_fast_wash_master = ''
$jo9_v16_fast_clean_master = ''
$jo9_v16_fast_cook_master = ''
$jo9_v16_fast_punish_slave = ''
$jo9_v16_fast_reward_slave = ''
$jo9_v16_fast_wash_slave = ''
$jo9_v16_fast_slave_milking = ''
$jo9_v16_fast_clean_slave = ''
$jo9_v16_fast_cook_slave = ''
$jo9_v16_fast_tentacle_slave = ''
$jo9_v16_fast_assistant_milking = ''
$jo9_v16_fast_clean_assistant = ''
$jo9_v16_fast_cook_assistant = ''
$jo9_v16_fast_tentacle_assistant = ''
!main_screen, at home
dynamic $home_sounds

gs 'main_layout'
presets_list = 0
$info_text = '' &! reset stats screens bottom text
$prisoner_info_text = '' &! reset prison bottom text
$cow_info_text = '' &! reset barn screen bottom text
$room1_info_text = ''
$room2_info_text = ''
$room3_info_text = ''
$room4_info_text = ''

! JO9 MOD START J9M1302 | 2026-10-08_persistent_image_cycle | changed block; context may be included
*p func('interior_change', 'jo9_html', '<div id = "large_image"><img src="content\pic\bg\<<$bg[$place]>>.png"></div>')
! JO9 MOD END J9M1302
*p '<div id = "main_screen"><<$text_display>></div>'
! JO9 MOD START J9M1301 | 2026-10-15_css24_qsp_titles | changed block; context may be included
*p '<div id="jo9_ui_home"></div><div id="jo9_master_card"><span class="jo9_card_title">주인공</span></div><div id="jo9_slave_card"><span class="jo9_card_title">노예</span></div><div id="jo9_assistant_card"><span class="jo9_card_title">조수</span></div>'
! JO9 MOD END J9M1301

if wizard_mode = 1:
	*p '<div class="upper_container"><div id = "upper">일: <<day>> 금: <<sparks>>$ | 계약: <<contract["time"]>> 일 |  Cal: <<slave["calories"]>>  |  두: <<slave["fear"]>>/<<slave_rate["fear"]>>  |  자: <<slave["instinct"]>>/<<slave_rate["instinct"]>>  |  의: <<slave["rational"]>>/<<slave_rate["rational"]>>  |  길: <<slave["custom"]>>/<<slave_rate["custom"]>>  |  충: <<slave["moral"]>>/<<slave_rate["moral"]>>  |  결: <<slave["spoil"]>>/<<slave_rate["spoil"]>>  |  절: <<slave["angst"]>>/<<slave_rate["angst"]>></div></div>'
else
	$shedule_warn = ''
	if exam_in_progress = 0:
		if ride_count = 0:    $shedule_warn += '<font color="#ff5700"><b>!</b></font>'
		if auction_count = 0: $shedule_warn += '<font color="#ff5700"><b>!</b></font>'
		if gladi_count = 0:   $shedule_warn += '<font color="#ff5700"><b>!</b></font>'
	end 
	if exam_in_progress = 1:
		$upper_info_bar = '경과 <<day>> 일 │ 소지금 <<sparks>>$'
	else
		$upper_info_bar = '경과 <<day>> 일 │ 소지금 <<sparks>>$'
	end
	if debt > 0: $upper_info_bar += ' │ 변제 <<debt>>$ <<debt_count>> 일'
	if contract['time'] > 0: $upper_info_bar += ' │ 계약 <<contract["time"]>> 일'
	if slave_state > CONST_INT['no_slave']: $upper_info_bar += ' │ '
		*p '<div class="upper_container"><div id = "upper"><<$shedule_warn>>&nbsp;<<$upper_info_bar>></div>'
	if slave_state > CONST_INT['no_slave']:
		if difficulty_setting = 2 or slave['diet_portion'] ! 4:
			*p '<div id="upper_calculator"><img src="content\pic\kalkulyator.png"></div>'
			$upper_info_bar = ' <<IIF(slave["calories"] > 0, "+", " ")>><<slave["calories"]*100>> cal │ '	
			*p '<div id = "upper_calories"><<$upper_info_bar>></div>'			
		end
		if header_clothing = 0:
			if $item_name[$slave["cloth"]] ! '' and $item_name[$slave["cloth"]] ! '알몸':
				$upper_info_bar = '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["cloth"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["cloth"]>>.png"></div>'
			else
				if slave['age'] = CONST_INT['young_age']: 
					$upper_info_bar = '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="알몸"> <img src="content\pic\ui overhaul\clothing bar small\naked_young.png"></div>'
				elseif slave['age'] = CONST_INT['loli_age']:
					$upper_info_bar = '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="알몸"> <img src="content\pic\ui overhaul\clothing bar small\naked_loli.png"></div>'
				else
					$upper_info_bar = '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="알몸"> <img src="content\pic\ui overhaul\clothing bar small\naked_milf.png"></div>'
				end
			end
		
			if $item_name[$slave["headband"]] ! '' and $item_name[$slave["headband"]] ! '-':
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["headband"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["headband"]>>.png"></div>'
			else
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="머리: -"> <img src ="content\pic\ui overhaul\clothing bar small\no_headband.png"></div>'
			end
		
			if $item_name[$slave["earrings"]] ! '' and $item_name[$slave["earrings"]] ! '-':
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["earrings"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["earrings"]>>.png"></div>'
			else
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="귀걸이: -"> <img src ="content\pic\ui overhaul\clothing bar small\no_earrings.png"></div>'
			end
		
			if $item_name[$slave["collar"]] ! '' and $item_name[$slave["collar"]] ! '-':
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["collar"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["collar"]>>.png"></div>'
			else
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="목: -"> <img src ="content\pic\ui overhaul\clothing bar small\no_collar.png"></div>'
			end
		
			if $item_name[$slave["gloves"]] ! '' and $item_name[$slave["gloves"]] ! '-':
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["gloves"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["gloves"]>>.png"></div>'
			else
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="장갑: -"> <img src ="content\pic\ui overhaul\clothing bar small\no_gloves.png"></div>'
			end
		
			if $item_name[$slave["boots"]] ! '' and $item_name[$slave["boots"]] ! '-':
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["boots"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["boots"]>>.png"></div>'
			else
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="신발: -"> <img src ="content\pic\ui overhaul\clothing bar small\no_boots.png"></div>'
			end
			
			$upper_info_bar += '<a class="tooltip-bottom" tooltip-data="장비창" href="EXEC: header_clothing = 1 & gt ''main_screen''"> <img src="content\pic\ui overhaul\clothing bar\clothbar_right.png"></a>'
		else
			if $item_name[$slave["armor"]] ! '갑옷 없음' and $item_name[$slave["armor"]] ! '':
				$upper_info_bar = '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["armor"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["armor"]>>.png"></div>'
			else
				$upper_info_bar = '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="갑옷: 갑옷 없음"> <img src ="content\pic\ui overhaul\clothing bar small\no_armor.png"></div>'
			end
		
			if $item_name[$slave["left_wpn"]] ! 'безоружный' and $item_name[$slave["left_wpn"]] ! '' and $item_name[$slave["left_wpn"]] ! '맨주먹':
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["left_wpn"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["left_wpn"]>>.png"></div>'
			else
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="왼손: 맨주먹"> <img src ="content\pic\ui overhaul\clothing bar small\no_leftwpn.png"></div>'
			end
		
			if $item_name[$slave["right_wpn"]] ! 'безоружный' and $item_name[$slave["right_wpn"]] ! '' and $item_name[$slave["right_wpn"]] ! '맨주먹':
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["right_wpn"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["right_wpn"]>>.png"></div>'
			else
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="오른손: 맨주먹"> <img src ="content\pic\ui overhaul\clothing bar small\no_rightwpn.png"></div>'
			end
		
			if $item_name[$slave["back_wpn"]] ! 'безоружный' and $item_name[$slave["back_wpn"]] ! '':
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="<<$item_name[$slave["back_wpn"]]>>"> <img src ="content\pic\ui overhaul\clothing bar small\<<$slave["back_wpn"]>>.png"></div>'
			else
				$upper_info_bar += '<div style="display:inline-block;position:relative;" class="tooltip-bottom" tooltip-data="등뒤: -"> <img src ="content\pic\ui overhaul\clothing bar small\no_backwpn.png"></div>'
			end
			$upper_info_bar += '<a class="tooltip-bottom" tooltip-data="의류" href="EXEC: header_clothing = 0 & gt ''main_screen''"> <img src="content\pic\ui overhaul\clothing bar\clothbar_right.png"></a>'
		end
		*p '<div id = "upper_equipment"><<$upper_info_bar>></div>'
	end
	if assistant_state > CONST_INT['no_slave']:

		*p '<div id="upper_calculator"><img src="content\pic\kalkulyator.png"></div>'
		$upper_info_bar = ' <<IIF(assistant["calories"] > 0, "+", " ")>><<assistant["calories"]*100>> cal │ '		
		*p '<div id = "upper_calories"><<$upper_info_bar>></div>'			
	end	
	*p '</div>'
end

!schedule <a style="color:red" href="EXEC: msg $shedule"></a>
if ride_count > 2: $rideday = '<<ride_count>>일 뒤'
if ride_count = 2: $rideday = '이틀 뒤'
if ride_count = 1: $rideday = '내일'
if ride_count = 0: $rideday = '오늘!'
if auction_count > 2: $auctionday = '<<auction_count>>일 뒤'
if auction_count = 2: $auctionday = '이틀 뒤'
if auction_count = 1: $auctionday = '내일'
if auction_count = 0: $auctionday = '오늘!'
if gladi_count > 2: $gladiday = '<<gladi_count>>일 뒤'
if gladi_count = 2: $gladiday = '이틀 뒤.'
if gladi_count = 1: $gladiday = '내일'
if gladi_count = 0: $gladiday = '오늘!'

! JO9 MOD START J9M1300 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$shedule = '<br><center><u>행사 일정</u></center><br>' + _
'콜로세움 경주 : <<$rideday>><br>' + _
'콜로세움 투기 : <<$gladiday>><br>' + _
'조합유치 경매 : <<$auctionday>><br>&nbsp&nbsp' + _
'<br><center>각 순환주기 10일 입니다</center>'
! JO9 MOD END J9M1300

!option icon
if exam_in_progress = 1:
	*p '<div id="options_icon"><a class="tooltip-bottom" tooltip-data="게임 설정" href = "EXEC: menu_form = 2000 & gt ''demo_menu_form''"><img src="content\pic\buttons\gear.png"></a></div>'
else
	*p '<div id="options_icon"><a class="tooltip-bottom" tooltip-data="게임 설정" href = "EXEC: menu_form = 2000 & gt ''menu_form''"><img src="content\pic\ui\grimdark\buttons\gear.png"></a></div>'
	if slave_state = CONST_INT['slave_exist'] and cheat_show = 1:
		*p '<div id="options_cheats"><a class="tooltip-bottom" tooltip-data="치트 핫키" href = "EXEC: menu_form = 2101 & gt ''menu_form''"><img src="content\pic\buttons\gear_slave_editor.png"></a></div>'
	end
	if exam_in_progress = 0 and $master_head_gear = 'raven_crown':
		if slave_state = CONST_INT['slave_exist']:
			*p '<div id="refresh_database_icon"><a class="tooltip-bottom" tooltip-data="종합정보 갱신" href = "EXEC: gs ''interior_storage'' & gs ''refresh_database'' & gs ''interior_restore'' & play ''content/snd/kkm.wav'', sound_volume & gt $curloc"><img src="content\pic\buttons\gear_console.png"></a></div>'
		else
			p ''
		end
	end
end

!console button, only in developer versions
*p '<div id="console_icon"><a class="tooltip-bottom" tooltip-data="콘솔 명령" href = "EXEC: dynamic $console"><img src="content\pic\buttons\gear_console.png"></a></div>'

if sound_on = 1:
	*p '<div id="sound_icon"><a class="tooltip-bottom" tooltip-data="사운드 켜짐" href = "EXEC: sound_on = 0 & close all & gt $curloc"><img src="content\pic\<<iif(ui_style = 2, ''ui\grimdark\buttons\sound_on.png'', ''buttons\sound_on.png'')>>"></a></div>'
else
	*p '<div id="sound_icon"><a class="tooltip-bottom" tooltip-data="사운드 꺼짐" href = "EXEC: sound_on = 1 & gt $curloc"><img src="content\pic\<<iif(ui_style = 2, ''ui\grimdark\buttons\sound_off.png'', ''buttons\sound_off.png'')>>"></a></div>'
end

!sound option
if menu_form = 2000:
	*p '<div style="position:absolute;top:595px;left:79px"><img src = "content/pic/소리.png"></div>'
	*p '<div style="position:absolute;top:589px;left:95px;font-family:경기천년제목 Medium;"><table><tr><td style="width:100px"><font color="#FFD700" size="5">배경음악 :</font></td><td><a href = 1><img src="content/pic/buttons/Minus.png"></a></td><td><center><font color="#FFD700" size="5"><<music_volume>>%</font></center></td><td><a href = 2><img src="content/pic/buttons/Plus.png"></a></td><td><a href = 3><img src="content/pic/buttons/close_button.png"></a></td></tr>'
	*nl '<tr><td style="width:100px"><font color="#FFD700" size="5">효과음악 :</font></td><td><a href = 4><img src="content/pic/buttons/Minus.png"></a></td><td><center><font color="#FFD700" size="5"><<sound_volume>>%</font></center></td><td><a href = 5><img src="content/pic/buttons/Plus.png"></a></td><td><a href = 6><img src="content/pic/buttons/close_button.png"></a></td></tr></table></div>'
	dynamic $volume_controls
end

!Trophy Room feature - created by crushboss (relocated for readability -ImperatorAugustus)
if exam_in_progress = 0:
	*p '<div id="trophy_room"><a class="tooltip-left-small-button" tooltip-data="트로피 룸" href = "EXEC: gt ''trophy_room_screen''"><img src="content\pic\ui\approved_main_v1\header_trophy.png" style="width:23px;height:23px;"></a></div>'
end

!button for fast travel to cryo facility (relocated for readability, and use $transport_energy_drop instead of $master_energy_drop -ImperatorAugustus)
if stasis_tank = 1:
	*p '<div id = "cryobutton"><a class="tooltip-bottom" tooltip-data="크라이오 슬립" href = "EXEC: dynamic $transport_energy_drop, ''serpis_house'' & copyarr ''$display_options'', ''$stasis_options'' & skip_to = 2 & gt ''shop_general''"><img src="content\pic\ui\grimdark\buttons\cryobutton.png" style="width:32px;height:32px;"></a></div>'
end

!showing spell state
$active_spell = ''
if auspex = 1: $active_spell += '<a class="tooltip-left-down" tooltip-data="아우스펙스 사용중"><img src="content\pic\ui overhaul\auspex.png" style="width:34px;height:36px"></a><br>'
if magna_magnifika > 0: $active_spell += '<a class="tooltip-left-down" tooltip-data="마그나 마그니피카 사용중"><img src="content\pic\ui overhaul\magna magnifika.png" style="width:34px;height:36px"></a><br>'
if slave['domini_dictum'] = 1: $active_spell += '<a class="tooltip-left-down" tooltip-data="도미니 딕툼 사용중"><img src="content\pic\ui overhaul\domini dictum.png" style="width:34px;height:36px"></a><br>'
if slave['sententia_veritas'] > 0: $active_spell += '<a class="tooltip-left-down" tooltip-data="센텐티아 베리타스 사용중"><img src="content\pic\ui overhaul\sententia veritas.png" style="width:34px;height:36px"></a>'
$active_spell += '</div>'
*p '<div id = "active_spell"><<$active_spell>></div>'

!ImperatorAugustus: consolidated master avatar and status display, sync with city_screen
*p '<div id = "master_short_ava"><a href = "EXEC: master_stat_screen = 0 & gt ''master_stat''"><img src = "<<$master_ava_color>>"></a></div>'
! JO9_UI_V192_AP_master
$energy_help = '<div>초록색 행동력 바는 대부분의 행동에 소비되며 수면, 캄라, 요정 꽃가루, 강장 영약, 숙련된 마사지로 회복됩니다.<br><br>빨간 칸은 피로입니다. 이 상태에서 행동력을 더 소비하면 근력이나 지구력에 해를 줍니다.<br>보라색은 운동 한계 경고입니다. 행동력이 남아 있어도 추가 운동은 해롭습니다.<br>사선 칸은 현재 체력으로 사용할 수 없는 영역이며, 반 칸은 행동력 0.5입니다.<br><br>녹색 화살표는 현재 한도를 넘는 초과 에너지를 뜻합니다. 운동 한계 상태에서는 화살표도 보라색입니다.<br>파란 별 아이콘은 휴식 적립입니다. 밤의 규칙 행동이나 다음 날을 위해 환급 및 이월되며, 이월에는 지구력 한도가 적용됩니다.<br><br>바와 아이콘에 마우스를 올리면 정확한 수치를 확인할 수 있습니다.</div>'
jo9_ap_units = 2 * master_energy - master_half_action
jo9_ap_cap = max(0, min(5, 5))
jo9_ap_bonus = max(0, 0)
jo9_ap_extra = max(0, jo9_ap_units - 2 * jo9_ap_cap)
jo9_ap_base = min(jo9_ap_units, 2 * jo9_ap_cap)
$jo9_ap_cells = ''
for jo9_ap_i = 1 to 5 step 1:
 $jo9_ap_kind = 'jo9_ap_empty'
 if jo9_ap_units >= 0:
  if jo9_ap_i > jo9_ap_cap: $jo9_ap_kind = 'jo9_ap_locked'
  if jo9_ap_base >= 2 * jo9_ap_i: $jo9_ap_kind = 'jo9_ap_green'
  if jo9_ap_base = 2 * jo9_ap_i - 1: $jo9_ap_kind = 'jo9_ap_green_half'
  if master_moodlet['neg_master_overexerted'] > 0: $jo9_ap_kind = $replace($jo9_ap_kind, 'green', 'purple')
 else
  if -jo9_ap_units >= 2 * (6 - jo9_ap_i): $jo9_ap_kind = 'jo9_ap_red'
  if -jo9_ap_units = 2 * (6 - jo9_ap_i) - 1: $jo9_ap_kind = 'jo9_ap_red_half'
 end
 $jo9_ap_cells += '<span class="jo9_ap_cell <<$jo9_ap_kind>>"></span>'
end
$jo9_ap_tip = '행동력 ' + iif(jo9_ap_units < 0, '-', '') + str(max(jo9_ap_units, -jo9_ap_units) / 2) + iif(max(jo9_ap_units, -jo9_ap_units) MOD 2 = 1, '.5', '') + ' · 현재 한도 ' + str(jo9_ap_cap) + ' / 기본 상한 5'
$jo9_ap_extra_tip = '초과 에너지 ' + str(jo9_ap_extra / 2) + iif(jo9_ap_extra MOD 2 = 1, '.5', '')
$jo9_ap_rest_tip = '휴식 적립 ' + str(jo9_ap_bonus) + ' · 밤 또는 다음 날 환급, 이월 한도 적용'
$jo9_ap_tip += ' · ' + $jo9_ap_extra_tip + ' · 휴식 적립 ' + str(jo9_ap_bonus)
if jo9_ap_units < 0: $jo9_ap_tip += ' · 피로: 추가 소비 시 근력 및 지구력에 악영향'
if master_moodlet['neg_master_overexerted'] > 0: $jo9_ap_tip += ' · 운동 한계: 추가 운동 주의'
$jo9_ap_arrow = 'jo9_extra_green'
if master_moodlet['neg_master_overexerted'] > 0: $jo9_ap_arrow = 'jo9_extra_purple' & $jo9_ap_extra_tip += ' · 운동 한계: 추가 운동 주의'
if jo9_ap_extra = 0: $jo9_ap_arrow += ' jo9_ap_inactive'
$jo9_ap_star = 'jo9_rest_star'
if jo9_ap_bonus = 0: $jo9_ap_star += ' jo9_ap_inactive'
*p '<div id="jo9_ap_master" class="jo9_ap"><a tooltip-data="<<$jo9_ap_tip>>" href="EXEC: msg $energy_help"><span class="jo9_ap_cells"><<$jo9_ap_cells>></span></a></div><div id="jo9_extra_master" class="jo9_extra"><span class="jo9_extra_icon <<$jo9_ap_arrow>>" tooltip-data="<<$jo9_ap_extra_tip>>"></span><span class="jo9_extra_icon <<$jo9_ap_star>>" tooltip-data="<<$jo9_ap_rest_tip>>"></span></div><div id="master_short_stat">'
	$tooltip_text = func('$addon', 'no_rate_full_grade_tooltip_text', 'mood', master_mood, 1)
	*p '<a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>" href="EXEC: msg $mood_chart"><<$mood[master_mood_plus]>></a>'
	$tooltip_text = func('$addon', 'no_rate_full_grade_tooltip_text', 'master_excitement', master_excitement, 1)
	*nl '<a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>" href = "EXEC: msg $excitement_chart"><<dyneval($vb_cycle_stat, IIF(max(master_moodlet["neg_boner"], master_moodlet["neg_blazing"]) = 0, 5 + master_excitement, 0), $excitement[master_excitement_plus])>></a>'
	$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'hygiene', master_hygiene, -1)
	*nl '<a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>" href = "EXEC: msg $hygiene_chart"><<$personal_hygiene[master_hygiene]>></a>'
*p '</div>'

!ImperatorAugustus: consolidated assistant avatar and status display, moved energy to top, added : to fiend status
if assistant_state = CONST_INT['slave_exist']:
	*p '<div id = "assistant_short_ava"><a href = "EXEC: assistant_stat_screen = 0 & gt ''assistant_stat''"><img src = "<<$assistant[''ava_clear'']>>.png"></a></div>'
	! JO9_UI_V192_AP_assistant
jo9_ap_units = 2 * assistant['energy'] - assistant['half_action']
jo9_ap_cap = max(0, min(5, assistant['stamina']))
jo9_ap_bonus = max(0, assistant['well_rested'])
jo9_ap_extra = max(0, jo9_ap_units - 2 * jo9_ap_cap)
jo9_ap_base = min(jo9_ap_units, 2 * jo9_ap_cap)
$jo9_ap_cells = ''
for jo9_ap_i = 1 to 5 step 1:
 $jo9_ap_kind = 'jo9_ap_empty'
 if jo9_ap_units >= 0:
  if jo9_ap_i > jo9_ap_cap: $jo9_ap_kind = 'jo9_ap_locked'
  if jo9_ap_base >= 2 * jo9_ap_i: $jo9_ap_kind = 'jo9_ap_green'
  if jo9_ap_base = 2 * jo9_ap_i - 1: $jo9_ap_kind = 'jo9_ap_green_half'
  if assistant['neg_exhausted'] > 0: $jo9_ap_kind = $replace($jo9_ap_kind, 'green', 'purple')
 else
  if -jo9_ap_units >= 2 * (6 - jo9_ap_i): $jo9_ap_kind = 'jo9_ap_red'
  if -jo9_ap_units = 2 * (6 - jo9_ap_i) - 1: $jo9_ap_kind = 'jo9_ap_red_half'
 end
 $jo9_ap_cells += '<span class="jo9_ap_cell <<$jo9_ap_kind>>"></span>'
end
$jo9_ap_tip = '행동력 ' + iif(jo9_ap_units < 0, '-', '') + str(max(jo9_ap_units, -jo9_ap_units) / 2) + iif(max(jo9_ap_units, -jo9_ap_units) MOD 2 = 1, '.5', '') + ' · 현재 한도 ' + str(jo9_ap_cap) + ' / 기본 상한 5'
$jo9_ap_extra_tip = '초과 에너지 ' + str(jo9_ap_extra / 2) + iif(jo9_ap_extra MOD 2 = 1, '.5', '')
$jo9_ap_rest_tip = '휴식 적립 ' + str(jo9_ap_bonus) + ' · 밤 또는 다음 날 환급, 이월 한도 적용'
$jo9_ap_tip += ' · ' + $jo9_ap_extra_tip + ' · 휴식 적립 ' + str(jo9_ap_bonus)
if jo9_ap_units < 0: $jo9_ap_tip += ' · 피로: 추가 소비 시 근력 및 지구력에 악영향'
if assistant['neg_exhausted'] > 0: $jo9_ap_tip += ' · 운동 한계: 추가 운동 주의'
$jo9_ap_arrow = 'jo9_extra_green'
if assistant['neg_exhausted'] > 0: $jo9_ap_arrow = 'jo9_extra_purple' & $jo9_ap_extra_tip += ' · 운동 한계: 추가 운동 주의'
if jo9_ap_extra = 0: $jo9_ap_arrow += ' jo9_ap_inactive'
$jo9_ap_star = 'jo9_rest_star'
if jo9_ap_bonus = 0: $jo9_ap_star += ' jo9_ap_inactive'
*p '<div id="jo9_ap_assistant" class="jo9_ap"><a tooltip-data="<<$jo9_ap_tip>>" href="EXEC: msg $energy_help"><span class="jo9_ap_cells"><<$jo9_ap_cells>></span></a></div><div id="jo9_extra_assistant" class="jo9_extra"><span class="jo9_extra_icon <<$jo9_ap_arrow>>" tooltip-data="<<$jo9_ap_extra_tip>>"></span><span class="jo9_extra_icon <<$jo9_ap_star>>" tooltip-data="<<$jo9_ap_rest_tip>>"></span></div><div id="assistant_short_stat">'
elseif assistant_state = CONST_INT['no_slave']:
	*p '<div id = "assistant_short_ava"><img src = "content/pic/blank_ava.png"></div>'
	*p '<div id = "assistant_short_stat">조수 없음'
elseif assistant_state = CONST_INT['slave_faint']:
	*p '<div id = "assistant_short_ava"><a href = "EXEC: assistant_stat_screen = 0 & gt ''assistant_stat''"><img src = "<<$assistant["ava"]>>.png"></a></div>'
	*p '<div id = "assistant_short_stat">의식 없음'
elseif assistant_state = CONST_INT['slave_dead']:
	*p '<div id = "assistant_short_ava"><a href = "EXEC: assistant_stat_screen = 0 & gt ''assistant_stat''"><img src = "<<$assistant["ava_gray"]>>.png"></a></div>'
	*p '<div id = "assistant_short_stat">사망'
end
if assistant_state = CONST_INT['slave_exist']:
	$tooltip_text = func('$addon', 'no_rate_full_grade_tooltip_text', 'mood', assistant['mood'], 1)
	*p '<a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>" href="EXEC: msg $mood_chart"><<$mood[assistant_mood_plus]>></a>'
end
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'house_mess', house_mess, -1)
*nl '<a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>" href = "EXEC: msg $house_mess_chart"><<$house_mess[house_mess]>></a>'
$tooltip_text = func('$addon', 'no_rate_stat_tooltip_text', 'cooked_food', cooked_food_plus, 1)
*nl '<div style="display:inline-block;position:relative;" class="tooltip-left" tooltip-data="<<$tooltip_text>>"><<$replace($replace($replace($cooked_food_label[cooked_food_plus], ''통조림 음식'', ''통조림''), ''음식찌꺼기'', ''남은음식''), ''음식 찌꺼기'', ''남은음식'')>></div>'
if ate_already >= max(1, master_str) and cooked_food <= master_str:
	$tooltip_text = '식사 질이 당신의 체력을 유지하기에 충분했다'
	*p '<div id="master_info_hungry"><a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>"><<dyneval($vb_cycle_skill, ate_already, "배부름")>></a></div>'
elseif ate_already > 0:
	$tooltip_text = '식사 질이 당신의 체력을 유지하기에 충분하지 않았다'
	*p '<div id="master_info_hungry"><a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>"><<dyneval($vb_cycle_skill, ate_already, "배고픔")>></a></div>'
end
*p '</div>'
! JO9 MOD START MONSTER_STATUS_MAIN_SCREEN | 2026-10-17_zzzz_monster_status_icon
! 조수 상태칸 밖에 괴물 상태 아이콘을 표시한다. 1=갈망, 2=만족. 성장 이름은 툴팁으로 표시한다.
if pet_tentacle > 0 and (tentacle_state = 1 or tentacle_state = 2):
	$tooltip_text = $strfind($tentacle_name[tentacle_size], '>([^<>]+)<', 1)
	if $tooltip_text = '': $tooltip_text = $tentacle_name[tentacle_size]
	$tooltip_text = '안개 괴물 · ' + $tooltip_text + ' / 현재 상태: ' + iif(tentacle_state = 1, '갈망', '만족')
	*p '<div id="jo9_house_monster"><a class="tooltip-left-small-button" tooltip-data="<<$tooltip_text>>" href="EXEC: msg $tentacle_chart"><img src="content\pic\ui\monster_status\<<iif(tentacle_state = 1, "craving", "satisfied")>>.png" alt="안개 괴물"></a></div>'
end
