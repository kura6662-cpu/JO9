		if slave['sin'] > 0: $jo9_v16_fast_punish_slave = '<div id="fast_punish_slave"><a class="tooltip-left" tooltip-data="처벌" href = "EXEC: menu_form = 14 & gt ''demo_menu_form''"><img src="content\pic\ui\approved_main_v1\action_punish.png"></a></div>'
		if slave['sin'] = 0 and slave['virtue'] = 0:
			$jo9_v16_fast_punish_slave = '<div id="fast_punish_slave"><a class="tooltip-left-small-button" tooltip-data="처벌" href = "EXEC: menu_form = 14 & gt ''demo_menu_form''"><img src="content\pic\ui\approved_main_v1\action_punish.png"></a></div>' 
			$jo9_v16_fast_reward_slave = '<div id="fast_reward_slave"><a class="tooltip-left-small-button" tooltip-data="보상" href = "EXEC: menu_form = 15 & gt ''demo_menu_form''"><img src="content\pic\ui\approved_main_v1\action_reward.png"></a></div>'
		end
	else
		if slave['virtue'] > 0: $jo9_v16_fast_reward_slave = '<div id="fast_reward_slave"><a class="tooltip-left" tooltip-data="보상" href = "EXEC: menu_form = 15 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_reward.png"></a></div>'
		if slave['sin'] > 0: $jo9_v16_fast_punish_slave = '<div id="fast_punish_slave"><a class="tooltip-left" tooltip-data="처벌" href = "EXEC: menu_form = 14 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_punish.png"></a></div>'
		if slave['sin'] = 0 and slave['virtue'] = 0:
			$jo9_v16_fast_punish_slave = '<div id="fast_punish_slave"><a class="tooltip-left-small-button" tooltip-data="처벌" href = "EXEC: menu_form = 14 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_punish.png"></a></div>'
			$jo9_v16_fast_reward_slave = '<div id="fast_reward_slave"><a class="tooltip-left-small-button" tooltip-data="보상" href = "EXEC: menu_form = 15 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_reward.png"></a></div>'
		end
	end
end
!Bathe radio buttons - overhauled by crushboss, and again by i107760 and again by ImperatorAugustus
if bath > 0:
	!fast wash button for master - slave bathes master, assistant bathes master, or master bathes alone
	if master_hygiene > 0:
		if slave_state = CONST_INT['slave_exist'] and slave['washes_master_rule'] = 1: 
			$jo9_v16_fast_wash_master = '<div id="fast_wash_master"><a class="tooltip-left-small-button" tooltip-data="씻는다" href = "EXEC: interaction = 5411 & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_wash.png" width="18px" height="18px"></a></div>'
		elseif assistant_state = CONST_INT['slave_exist'] and assistant['washes_master_rule'] = 1:
			$jo9_v16_fast_wash_master = '<div id="fast_wash_master"><a class="tooltip-left-small-button" tooltip-data="씻는다" href = "EXEC: interaction = menu_assistant_washes_master & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_wash_a.png" width="18px" height="18px"></a></div>'
		else
			$jo9_v16_fast_wash_master = '<div id="fast_wash_master"><a class="tooltip-left-small-button" tooltip-data="씻는다" href = "EXEC: interaction = 34 & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_wash.png" width="18px" height="18px"></a></div>'
		end
	end
	!fast wash button for slave - assistant bathes slave, slave bathes master (only if master is dirty), or slave bathes alone
	if slave_state = CONST_INT['slave_exist'] and slave['hygiene'] > 0:
		if assistant_state = CONST_INT['slave_exist'] and assistant['washes_slave_rule'] = 1:
			$jo9_v16_fast_wash_slave = '<div id="fast_wash_slave"><a class="tooltip-left-small-button" tooltip-data="씻게 한다" href = "EXEC: interaction = menu_assistant_washes_slave & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_wash_a.png" width="18px" height="18px"></a></div>'
		elseif master_hygiene > 0 and slave_state = CONST_INT['slave_exist'] and slave['washes_master_rule'] = 1:
			$jo9_v16_fast_wash_slave = '<div id="fast_wash_slave"><a class="tooltip-left-small-button" tooltip-data="씻게 한다" href = "EXEC: interaction = 5411 & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_wash.png" width="18px" height="18px"></a></div>'
		else
			$jo9_v16_fast_wash_slave = '<div id="fast_wash_slave"><a class="tooltip-left-small-button" tooltip-data="씻게 한다" href = "EXEC: interaction = menu_bath_S & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_wash.png" width="18px" height="18px"></a></div>'
		end
	end
end

if master_excitement >= 0:
	if slave_state = CONST_INT['slave_exist']:
		if exam_in_progress = 1:
			$jo9_v16_fast_sex_S = '<div id="fast_sex_S"><a class="tooltip-left-small-button" tooltip-data="<<$slave_name>>와(과) 섹스한다" href = "EXEC: menu_form = 16 & gt ''demo_menu_form''"><img src="content\pic\ui\approved_main_v1\action_heart_s.png" style="width:19px;height:19px"></a></div>'
		else
			$jo9_v16_fast_sex_S = '<div id="fast_sex_S"><a class="tooltip-left-small-button" tooltip-data="<<$slave_name>>와(과) 섹스한다" href = "EXEC: menu_form = 16 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_heart_s.png" style="width:19px;height:19px"></a></div>'
		end
	end
	if assistant_state = CONST_INT['slave_exist']:
		$jo9_v16_fast_sex_A = '<div id="fast_sex_A"><a style="font-family:Sandoll 미생" class="tooltip-left-small-button" tooltip-data="<<$assistant_name>>와(과) 섹스한다" href = "EXEC: menu_form = 4 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_heart_a.png" style="width:19px;height:19px"></a></div>'
	end
end

!exchange button for the slave and assistant (slave must be devoted or slave slot must be empty while there is an assistant)
if exam_in_progress = 0:
	if slave_state = CONST_INT['slave_exist'] and slave['moral'] >= 3:
		*p  '<div id="exchange"><a class="tooltip-left-down" tooltip-data="위치변경 : 조수⇔노예" href = "EXEC: gt ''slave_to_assistant''"><img src="content\pic\buttons\exchange3.png" style="width:20px;height:55px;"></a></div>'
	elseif slave_state = CONST_INT['no_slave'] and assistant_state ! CONST_INT['no_slave']:
		*p  '<div id="exchange"><a class="tooltip-left-down" tooltip-data="위치변경 : 조수⇔노예" href = "EXEC: gt ''slave_to_assistant''"><img src="content\pic\buttons\exchange3.png" style="width:20px;height:55px;"></a></div>'
	end
end

!Change rooms in apartment - crushboss
if exam_in_progress = 0:
	*p  '<div id="fast_interior"><a class="tooltip-bottom" tooltip-data="집 내부 방 전환" href = "EXEC: change_interior = 1 & gs ''interior_change'' & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\tool_room.png"></a></div>'
	!bug fix: added missing closing </a> tag - ImperatorAugustus
end

!fast buttons for milking - Pianocat
if slave_state = CONST_INT['slave_exist'] and slave['lactation'] > 0:
	if slave['milk_summ'] >= 10:
		$jo9_v16_fast_slave_milking = '<div id="fast_slave_milking"><a class="tooltip-left-down" tooltip-data="노예 착유" href = "EXEC: interaction = 591 & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_milking.png" style="width:32px;height:34px"></a></div>'
	else
		$jo9_v16_fast_slave_milking = '<div id="fast_slave_milking"><a class="tooltip-left-down" tooltip-data="젖이 부족함"><img src="content\pic\ui\approved_main_v1\action_milking_gray.png" style="width:32px;height:34px"></a></div>'
	end
end
if assistant_state = CONST_INT['slave_exist'] and assistant['lactation'] > 0 and assistant['milk_summ'] >= 10:
	$jo9_v16_fast_assistant_milking = '<div id="fast_assistant_milking"><a class="tooltip-left-down" tooltip-data="조수 착유" href = "EXEC: interaction = 592 & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_milking.png" style="width:32px;height:34px"></a></div>'
end
!if assistant_state = CONST_INT['slave_exist']:
!	if assistant['virtue'] > 0: *p '<div id="fast_redeem_a"><a class="tooltip-left" tooltip-data="보상" href = "EXEC: menu_form = 5600 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_reward.png"></a></div>'
!	if assistant['sin'] > 0: *p '<div id="fast_redeem_a"><a class="tooltip-left" tooltip-data="처벌" href = "EXEC: menu_form = 5620 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_punish.png"></a></div>'
!	if assistant['sin'] = 0 and assistant['virtue'] = 0:
!		*p '<div id="fast_redeem_a_1"><a class="tooltip-left-small-button" tooltip-data="보상" href = "EXEC: menu_form = 5620 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_punish.png"></a></div>'
!		*p '<div id="fast_redeem_a_2"><a class="tooltip-left-small-button" tooltip-data="처벌" href = "EXEC: menu_form = 5600 & gt ''menu_form''"><img src="content\pic\ui\approved_main_v1\action_reward.png"></a></div>'
!	end
!end
!options
*p '<div id = "settings"><<$setting_display>></div>'
*p '<div id = "settings_ex" style="left:<<iif(menu_form = 2000,570,100)>>px"><<$setting_display_c>></div>'
*p '<div id = "settings_ex2"><<$setting_display_c2>></div>'
*p '<div id = "settings_2r"><<$setting_display_r>></div>'


!buttons/icons disabled in option menu and cheat menus
if menu_form < 2000 or menu_form > 2110:
	if exam_in_progress = 0:
		if ride_count = 0:
			*p '<div id = "ride_counting"><a class="tooltip-left-down" tooltip-data="오늘은 경주가 열리는 날!" href = "EXEC: city_district = 1 & dynamic $transport_energy_drop, ''white_house'' & interaction_city = 12 & gt ''interaction_city''"><img src="content\pic\ui overhaul\watch the race.png"></a></div>'
		else
			*p '<div id = "ride_counting"><a class="tooltip-left-down" tooltip-data="경주는 <<ride_count>>일 후 시작"><img src="content\pic\ui overhaul\watch the race_gray.png"></a></div>'
		end
		if gladi_count = 0:
			*p '<div id = "gladi_counting"><a class="tooltip-left-down" tooltip-data="오늘은 경기가 열리는 날!" href = "EXEC: city_district = 1 & dynamic $transport_energy_drop, ''white_house'' & interaction_city = 12 & gt ''interaction_city''"><img src="content\pic\ui overhaul\watch the battle.png"></a></div>'
		else
			*p '<div id = "gladi_counting"><a class="tooltip-left-down" tooltip-data="콜로세움 경기는 <<gladi_count>>일 후 시작"><img src="content\pic\ui overhaul\watch the battle_gray.png"></a></div>'
		end
		if auction_count > 0:
			*p '<div id = "auction_counting"><a class="tooltip-left-down" tooltip-data="길드의 낙인 노예 경매는 <<auction_count>>일<<iif(auction_count > 1, {s}, {})>> 후"><img src="content\pic\ui overhaul\auction_gray.png"></a></div>'
		elseif slave_state ! CONST_INT['no_slave']:
			if slave['brand'] = 0:
				*p '<div id = "auction_counting"><a class="tooltip-left-down" tooltip-data="길드 경매에서는 낙인 찍힌 노예만 팔 수 있다"><img src="content\pic\ui overhaul\auction_gray.png"></a></div>'
			else
				*p '<div id = "auction_counting"><a class="tooltip-left-down" tooltip-data="길드의 낙인 노예 경매에 노예를 내놓기" href =  "EXEC: city_district = 1 & dynamic $transport_energy_drop, ''white_house'' & interaction_city = 93 & gt ''interaction_city''"><img src="content\pic\ui overhaul\auction.png"></a></div>'
			end
		else
			*p '<div id = "auction_counting"><a class="tooltip-left-down" tooltip-data="오늘은 길드의 낙인 노예 경매가 열리는 날"><img src="content\pic\ui overhaul\auction_gray.png"></a></div>'
		end
	end
	
	if slave_state = CONST_INT['slave_exist']:
		*p '<div id = "teach"><a class="tooltip-left-large" tooltip-data="노예와 개인 훈련" href = "EXEC: teach_stat_screen = 0 & gt ''teach_screen''"><img src="content\pic\<<iif(ui_style = 2, ''ui\grimdark\buttons\teach.png'', ''buttons\teach.png'')>>" width=''31px'' height=''31px''></a></div>'
		if assistant_state = CONST_INT['slave_exist']:
			*p '<div id = "teach_a"><a class="tooltip-bottom" tooltip-data="<<$assistant_name>>, 수업을 진행해라" href = "EXEC: teach_stat_screen = 1 & gt ''teach_screen''"><img src="content\pic\<<iif(ui_style = 2, ''ui\grimdark\buttons\teach_a.png'', ''buttons\teach_a.png'')>>"></a></div>'
			if sparks >= school_price[0]: *p '<div id = "teach_s"><a class="tooltip-bottom" tooltip-data="<<$slave_name>>, 수업에 가라…" href = "EXEC: teach_stat_screen = 2 & gt ''teach_screen''"><img src="content\pic\<<iif(ui_style = 2, ''ui\grimdark\buttons\teach_s.png'', ''buttons\teach_s.png'')>>"></a></div>'
			if sparks >= coach_price[0]: *p '<div id = "teach_r"><a class="tooltip-bottom" tooltip-data="<<$slave_name>>를 위해 개인 교사 초청" href = "EXEC: teach_stat_screen = 3 & gt ''teach_screen''"><img src="content\pic\<<iif(ui_style = 2, ''ui\grimdark\buttons\teach_r.png'', ''buttons\teach_r.png'')>>"></a></div>'
		else
			if sparks >= school_price[0] and exam_in_progress ! 1: *p '<div id = "teach_s_noa"><a class="tooltip-bottom" tooltip-data="<<$slave_name>>, 수업에 가라…" href = "EXEC: teach_stat_screen = 2 & gt ''teach_screen''"><img src="content\pic\<<iif(ui_style = 2, ''ui\grimdark\buttons\teach_s.png'', ''buttons\teach_s.png'')>>"></a></div>'
			if sparks >= coach_price[0]: *p '<div id = "teach_r_noa"><a class="tooltip-bottom" tooltip-data="<<$slave_name>>를 위해 개인 교사 초청" href = "EXEC: teach_stat_screen = 3 & gt ''teach_screen''"><img src="content\pic\<<iif(ui_style = 2, ''ui\grimdark\buttons\teach_r.png'', ''buttons\teach_r.png'')>>"></a></div>'
		end
	end

	if lab > 0 and (slave_state = CONST_INT['slave_exist'] or assistant_state = CONST_INT['slave_exist']):
		if assistant['alchemist_rule'] = 1: 
			$rule_subject = '<<$assistant_name>>'
		else
			$rule_subject = '<<$slave_name>>'
		end
		*p '<div id = "lab"><a class="wide tooltip-left-large" tooltip-data="<<$rule_subject>>, 물약을 조제해라…" href = "EXEC: interaction = 21 & gt ''interaction''"><img src="content\pic\<<iif(ui_style = 2, ''ui\grimdark\buttons\lab.png'', ''buttons\lab.png'')>>" width=''31px'' height=''31px''></a></div>'
	end	

	if dungeon > 0 or barn > 0 or stasis_tank > 0:

		if cell_state = 0:
			if dungeon > 0:
				cell_state = 1
			elseif barn > 0:
				cell_state = 2
			else
				cell_state = 3
			end
		end

		if dungeon > 0: 
			*p '<div id = "show_cell"><a href="EXEC: cell_state = 1 & gt ''main_screen''"><img src="content/pic/ui overhaul/dungeon.png" width="46" height="51"></a></div>'
		end

		if barn > 0: 
			*p '<div id = "show_barn"><a href="EXEC: cell_state = 2 & gt ''main_screen''"><img src="content/pic/ui overhaul/barn.png" width="46" height="51"></a></div>'
			if farmhand_state = CONST_INT['slave_exist']:
				*p '<div id="fast_cow_check_inner"><a class="tooltip-left-down" tooltip-data="우유량을 확인한다" href = "EXEC: gs ''#var_base'' & msg $cow_milk_quantity"><img src="content\pic\buttons\milk_drop_large.png" style="width:32px;height:34px"></a></div>'
				if cow['milk_summ'] >= 10:
					if farmhand_state = CONST_INT['slave_exist']:
						*p '<div id="fast_cow_milking_inner"><a class="tooltip-left-down" tooltip-data="<<$farmhand_name>>에게 착유를 명령한다" href = "EXEC: interaction = menu_farmhand_milking & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_milking.png" style="width:32px;height:34px"></a></div>'
					else
						*p '<div id="fast_cow_milking_inner"><a class="tooltip-left-down" tooltip-data="직접 착유한다" href = "EXEC: interaction = menu_C_milking & gt ''interaction''"><img src="content\pic\ui\approved_main_v1\action_milking.png" style="width:32px;height:34px"></a></div>'
					end
					if cow['milk_summ'] < 10:
						*p '<div id="fast_cow_milking_inner"><a class="tooltip-left-down" tooltip-data="우유가 나오지 않는다." href = "empty"><img src="content\pic\ui overhaul\milking_gray.png" style="width:32px;height:34px"></a></div>'
					end
				end
			end
		end

		if stasis_tank > 0:
			! double clicking un-selects any cryo cell, making the avatar disappear but keeping the buttons visible - ImperatorAugustus
			*p '<div id = "show_cryo"><a href="EXEC: cryo_cell_selected = iif(cell_state = 3, 0, cryo_cell_selected) & cell_state = 3 & gt ''main_screen''"><img src="content/pic/ui overhaul/cell rent.png" width="46" height="51"></a></div>'
		end

		if cell_state = 1:
			!ImperatorAugustus: show clear avatar image for awake prisoner, regular avatar for fainted prisoner (was used for all except no_slave), gray avatar for dead prisoner
			if prisoner_state = CONST_INT['no_slave']:
				*p '<div id = "cage"><img src = "content/pic/blank_ava.png"></div>'
			elseif prisoner_state = CONST_INT['slave_exist']:
				*p '<div id = "cage"><img src = "<<$prisoner["ava_clear"]>>.png"></div>'
			elseif prisoner_state = CONST_INT['slave_faint']:
				*p '<div id = "cage"><img src = "<<$prisoner["ava"]>>.png"></div>'
			elseif prisoner_state = CONST_INT['slave_dead']:
				*p '<div id = "cage"><img src = "<<$prisoner["ava_gray"]>>.png"></div>'
			end
			*p '<div id = "cage"><a class="tooltip-left-huge" tooltip-data="지하 감옥 감방" href = "EXEC: gt ''prison_cell''"><img src="content\pic\cage.png"></a></div>'

			!ImperatorAugustus: show fast swap button when prison is selected
			if prisoner_state ! CONST_INT['no_slave']:
				if slave_state = CONST_INT['no_slave']:
					*p '<div id = "show_cell"><a class="tooltip-left-down" tooltip-data="<<$prisoner_name>> 석방" href = "EXEC: killvar ''$prisoner_info_text'' & gt ''slave_to_cage''"><img src="content\pic\buttons\release.png" width="46" height="51"></a></div>'
				else
					*p '<div id = "show_cell"><a class="tooltip-left-down" tooltip-data="<<$slave_name>>와 <<$prisoner_name>> 교체" href = "EXEC: killvar ''$prisoner_info_text'' & gt ''slave_to_cage''"><img src="content\pic\buttons\cell_exchange.png" width="46" height="51"></a></div>'
				end
			elseif slave_state > CONST_INT['no_slave']:
				*p '<div id = "show_cell"><a class="tooltip-left-down" tooltip-data="<<$slave_name>> 감금" href = "EXEC: killvar ''$prisoner_info_text'' & gt ''slave_to_cage''"><img src="content\pic\buttons\imprison.png" width="46" height="51"></a></div>'
			end
		end
		
		if cell_state = 2:
			if farmhand_state = CONST_INT['no_slave']:
				*p '<div id = "barn"><img src = "content/pic/blank_ava.png"></div>'
			elseif farmhand_state = CONST_INT['slave_exist']:
				*p '<div id = "barn"><img src = "<<$farmhand["ava_clear"]>>.png"></div>'
			elseif farmhand_state = CONST_INT['slave_faint']:
				*p '<div id = "barn"><img src = "<<$farmhand["ava"]>>.png"></div>'
			elseif farmhand_state = CONST_INT['slave_dead']:
				*p '<div id = "barn"><img src = "<<$farmhand["ava_gray"]>>.png"></div>'
			end
			*p '<div id = "barn"><a class="tooltip-left-huge" tooltip-data="외양간을 관리한다" href = "EXEC: gt ''barn''"><img src="content\pic\barn2.png"></a></div>'
			if cow_state = CONST_INT['no_slave']:
				*p '<div id = "barn_cow"><img src = "content/pic/blank_ava.png" style="width:50px;height:50px"></div>'
			elseif cow_state = CONST_INT['slave_exist']:
				*p '<div id = "barn_cow"><img src = "<<$cow["ava_clear"]>>.png" style="width:50px;height:50px"></div>'		
			elseif cow_state = CONST_INT['slave_faint']:
				*p '<div id = "barn_cow"><img src = "<<$cow["ava"]>>.png" style="width:50px;height:50px"></div>'
			elseif cow_state = CONST_INT['slave_dead']:
				*p '<div id = "barn_cow"><img src = "<<$cow["ava_gray"]>>.png" style="width:50px;height:50px"></div>'  
			end  
			*p '<div id = "barn_cow"><a class="tooltip-left-small-button" tooltip-data="외양간 젖소"><img src="content\pic\maidroom.png" style="width:50px;height:50px"></a></div>'        
			if harpy_state = CONST_INT['no_slave']:
				*p '<div id = "barn_harpy"><img src = "content/pic/blank_ava.png" style="width:50px;height:50px"></div>'
			elseif harpy_state = CONST_INT['slave_exist']:
				*p '<div id = "barn_harpy"><img src = "<<$harpy["ava_clear"]>>.png" style="width:50px;height:50px"></div>'		
			elseif harpy_state = CONST_INT['slave_faint']:
				*p '<div id = "barn_harpy"><img src = "<<$harpy["ava"]>>.png" style="width:50px;height:50px"></div>'
			elseif harpy_state = CONST_INT['slave_dead']:
				*p '<div id = "barn_harpy"><img src = "<<$harpy["ava_gray"]>>.png" style="width:50px;height:50px"></div>'  
			end  
