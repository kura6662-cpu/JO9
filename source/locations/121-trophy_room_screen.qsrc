# trophy_room_screen
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2873 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'trophy_room_screen': gs 'snk_room_bridge', 'guard', 'trophy_room_screen'
! JO9 MOD END J9M2873
!Trophy Room - Created by crushboss

!Reset vars
toggle_trophy = 0
trophy_won_fog = 0
trophy_won_arena = 0
trophy_won_count = 0

gs 'main_layout'
gs '#txt_man'
!if hero_choice > 100: gs '#txt_woman'
!if hero_choice > 100: gs '#var_base_woman'
gs '#var_base'

$backimage = 'content\pic\bg\trophy\bg_trophy.png'

if toggle_trophy = 0: gs 'trophy_room'

!Fog trophies are set to =2 as a do-once for awarding fighting xp from A+ to S+, so min(1) is used here to avoid double counting - ImperatorAugustus
trophy_won_fog = min(1,trophy_ogre) + min(1,trophy_warg) + min(1,trophy_werewolf) + min(1,trophy_hugefiend) + min(1,trophy_blackmedic) + min(1,trophy_maturefiend) + min(1,trophy_vampire) + min(1,trophy_lich) + min(1,trophy_beastmen) + min(1,trophy_paladin) + min(1,trophy_orc) + min(1,trophy_youngfiend) + min(1,trophy_scum) + min(1,trophy_goblins)
trophy_won_arena = trophy_corvus + trophy_camira + trophy_serpis + trophy_taurus + trophy_vatican + trophy_absolute + trophy_slaves_x + trophy_arenafiend + trophy_racechampion + trophy_racegrandchampion
trophy_won_count = trophy_won_fog + trophy_won_arena

*p '<div id = "trophy_right_column"><center><img src = "<<$master_ava_color>>">'
*nl '<<$master_name>></center></div>'

*p '<div id = "trophy_right_column_mid">'
*nl '&nbsp&nbsp 트로피 - 총계:&nbsp&nbsp 24'
*nl '&nbsp&nbsp 트로피 - 안개:&nbsp&nbsp&nbsp 14'
*nl '&nbsp&nbsp 트로피 - 아레나:&nbsp&nbsp&nbsp 10<br>'
*nl '획득한 트로피 - 총계:&nbsp <<trophy_won_count>>'
*nl '획득한 트로피 - 안개:&nbsp&nbsp <<trophy_won_fog>>'
*nl '획득한 트로피 - 아레나:&nbsp&nbsp <<trophy_won_arena>></div>'

*p '<div id = "trophy_right_column_trophy"><center><img src="content\pic\bg\trophy\trophy.png"></center></div>'

if toggle_trophy = 0:
 	*p '<div id = "toggle_button_trophy"><a href = "EXEC: gs ''toggle_trophy''"><img src = "content\pic\buttons\dual_active_trophy.png"></a></div>'
else
 	*p '<div id = "toggle_button_trophy"><a href = "EXEC: gs ''toggle_trophy''"><img src = "content\pic\buttons\dual_used_trophy.png"></a></div>'
end

*p '<div id = "close_button_trophy"><a href = "EXEC: gt ''menu_form''"><img src = "content\pic\buttons\close_button.png"></a></div>'

------------ trophy_room_screen ------------
