$prisoner_ration[1] = '  당신은 죄수를 굶기기로 한다. 이러면 스파크도 조금 절약된다.'
$prisoner_ration[2] = '  당신은 죄수를 최소한의 식단으로 유지하기로 한다. 영양이 형편없어도 아마 목숨은 붙어 있을 것이고, 당신도 스파크를 조금 아낄 수 있다.'
$prisoner_ration[3] = '  개사료 - 불멸의 로마에서는 꽤 흔한 음식이다. 값도 싸고 영양도 괜찮다. 당신은 낡은 깡통의 내용물을 우리 안에 놓인 허름한 그릇에 쏟아 넣었다.'
$prisoner_ration[4] = '  당신은 죄수에게 안개 괴물의 정액을 먹이기로 한다. 정액 재고만 있다면 공짜니까, 많은 스파크를 아낄 수 있다. 다른 문제는 - 죄수가 그런 음식을 좋아할까 하는 점인데, 당신은 그다지 신경 쓰지 않는다.'
$prisoner_ration[5] = '  그녀의 그릇은 하루 종일 집어먹게 될 쿠키로 수북하다. 정크푸드다. 값은 개사료와 같지만 탄수화물, 지방, 설탕뿐이고, 거기에 배고픔을 유발하는 물약까지 섞여 있다. 먹을수록 더 배가 고파진다. 완전히 건강에 해롭지만, 살을 찌우는 텅 빈 칼로리는 <i>엄청나게</i> 많고, 너무 맛있어서 감방의 지루함 속에서는 놀라운 의지력이 없으면 과식을 피하기 힘들다. 상표 문구에도 이렇게 적혀 있다: "하나만 먹고 끝낼 수 있을까!"'

$cow_ration[1] = '  당신은 당신의 젖소를 굶기기로 한다. 이러면 스파크를 절약할 수 있지만, 생산성도 점점 떨어질 것이다.'
$cow_ration[2] = '  당신은 젖소에게 표준 가축 사료를 주기로 한다. 맛은 없지만, 시간이 지나면 익숙해질 것이다.'
$cow_ration[3] = '  풍부한 양의 사료다. 매일 조금씩 당신의 젖소를 살찌울 것이다. 비용은 많이 들지만 꽤 효율적이다. 다만 극단적인 과체중은 건강에 나쁠 수 있다.'
$cow_ration[4] = '  당신은 젖소에게 안개 괴물의 정액을 먹이기로 한다. 정액 재고만 있다면 공짜니까 많은 스파크를 아낄 수 있다. 아마 당신의 젖소는 그걸 좋아하지 않겠지만…'

$cow_unlocked = '  당신은 젖소를 쇠사슬에서 풀어 준다. 이제 그녀는 정상적으로 움직일 수 있고, 이 외양간이 마음에 들지 않으면 나갈 수도 있다.'
$cow_locked = '  당신은 쇠사슬을 이용해 젖소를 구속하고, 그녀의 손목과 발목에 철제 족쇄를 채운다. 이렇게 하면 움직임의 자유가 제한되어 외양간 칸막이에서 달아나지 못한다. 다만 정신 상태에 미치는 영향은 꽤 가혹할 수 있다.'
!DOING THE WORK

$slave_cook_description[0] = '  당신은 <<$dynslave_name>>를 부엌으로 보내 저녁을 준비하게 한다. 분명 자기 실력에 자신이 없어 보이지만, 뭐 어떤가 - 일하게 두자! 한 시간 뒤 가서 확인해 보니, 그녀는 그냥 통조림을 열어 접시에 담아 놓았을 뿐이었다.'


$master_cook_description[0] = '  부엌을 들여다보며 머리를 긁적이지만, 이 재료들로 뭘 만들 수 있을지 감이 오지 않는다. 물론 막연한 생각은 몇 개 있지만, 대부분 참사로 끝날 것 같다. 한숨을 쉬며, 당신은 그냥 통조림 몇 개를 열어 접시에 쏟아 담는다. 이걸로 됐다!'
$master_cook_description[1] = '  이 얼마나 잔혹한 아이러니인가 - 노예상인이 요리를 하다니. 노예의 땅 불멸의 로마에서!<br>  특히 당신은 요리를 잘하는 편도 아니다. 간단한 샐러드, 샌드위치 몇 개, 데운 통조림 음식 - 그게 당신 요리 예술의 한계다. 이제 그 결과물을 스스로 먹어야 한다.'
$master_cook_description[2] = '  "이건 노예가 할 일인데." 당신은 소매를 걷어붙이며 생각한다. 결국 드레싱을 곁들인 샐러드나 고기와 채소를 넣은 맛있는 스튜를 만드는 게 그리 어려운 일은 아니다. 적어도 당신 실력이라면 귀한 식재료를 망치지 않을 정도는 된다.'
$master_cook_description[3] = '  프라이팬의 어느 쪽이 위로 가야 하는지만 알면 요리도 즐겁다. 그리고 당신은 안다! 스테이시스 챔버 속 재료들을 재빨리 훑어본 당신은 곧바로 세 코스 메뉴 전체를 머릿속에 그려 내고, 천천히, 품위 있게 자신의 요리 계획을 현실로 만든다. 벨리시모(끝내주는군)!'
$master_cook_description[4] = '  요리는 진지한 일이고, 당신의 부엌은 그런 작업을 위해 완벽하게 준비되어 있다. 최고의 칼과 조리도구, 완벽한 식재료, 넉넉한 공간까지 있다. 이제 남은 건 당신의 상당한 셰프 재능을 발휘하는 것뿐이다. 그러면 훌륭한 세 코스 저녁이 완성된다!'
$master_cook_description[5] = '  물론 이 일은 노예들에게 맡길 수도 있다. 하지만 당신 같은 <i>총주방장</i>의 요리 예술을 따라잡지는 못할 것이다. 그리고 여자는 감을 잃지 않으려면 가끔은 요리의 걸작도 만들어 내야 한다. 당신의 음식은 배뿐 아니라 눈까지 즐겁게 한다. 맛있군!'
$master_cook_description[6] = '  물론 이 일은 노예들에게 맡길 수도 있다. 하지만 당신 같은 총주방장의 요리 예술을 따라잡지는 못할 것이다. 그리고 여자는 감을 잃지 않으려면 가끔은 요리의 걸작도 만들어 내야 한다. 당신의 음식은 배뿐 아니라 눈까지 즐겁게 한다. 맛있군!'

$master_clean_description[0] = '  이곳은 돼지우리다. 우울해질 지경이다. <br>  정리를 하면서도, 당신은 이 광경이 뭔가 잘못됐다는 생각을 떨칠 수 없다. 당신 정도 되는 노예상인이 이런 일로 손을 더럽혀서는 <i>안</i> 된다. <br>  원래 이런 일은 노예가 하는 것 아닌가?! '
$master_clean_description[1] = '  패배자의 정의: 자기 집을 스스로 청소하는 노예상인. 당신은 슬픈 한숨과 함께 청소를 시작하며, 다음번에는 반드시 노예들에게 이 일을 시키겠다고 엄숙히 다짐한다.'

$master_clean_description[2] = '  청소라는 건 남이 할 때는 나쁘지 않다. 하지만 자기 손으로 하는 건 원래 당신 전문이 아니었다. 불행히도 이곳은 엉망이고, 결국 이 일을 해야 하는 건 당신뿐인 것 같다. 욕을 중얼거리며, 당신은 집을 재빨리 치운다.'
$master_clean_description[3] = '  당신은 심각한 난장판조차 감당할 만큼 하녀 경험이 충분하지만, 그래도 자기 집을 직접 청소해야 한다는 건 뭔가 심각하게 잘못된 일이다.'
$master_clean_description[4] = '  당신처럼 숙련된 하녀에게 집 청소, 빨래, 설거지는 아무 문제도 아니다. 다만 당신은 남의 일을 지휘하는 쪽이 훨씬 더 뛰어날 뿐이다.'
$master_clean_description[5] = '  이곳을 말끔하게 만드는 데는 그리 오래 걸리지 않는다. 당신은 설거지를 하고, 먼지를 털고, 자잘한 일들을 빠르고 효율적으로 끝낸다. 복잡한 건 없고, 필요하다면 하녀 없이도 충분히 할 수 있다.'
$master_clean_description[6] = '  일류 하녀인 당신에게는 집을 깨끗하게 만드는 일이 순식간이다. 당신은 설거지를 하고, 먼지를 털고, 자잘한 일들을 빠르고 효율적으로 처리한다. 복잡한 건 없고, 필요하다면 하녀 없이도 충분히 할 수 있다.'

$work_out_description[0] = '  이런 건강 상태라면 저 <<$slave_ass_txt[slave["fat"]]>> 엉덩이는 운동이 아니라 침대에 누워 있어야 한다!'
$work_out_description[1] = '  <<$slave_name>>는 가벼운 스트레칭과 단순한 운동을 할 만한 체력만 겨우 남아 있지만, 누구든 시작은 해야 한다.'
$work_out_description[2] = '  <<$slave_name>>는 단순한 체조를 한다. 몸을 늘리고, 제자리에서 돌고, 뛰어오른다 - 지나치게 까다롭게 따지지 않는다면, 전반적으로 유산소 운동이라고 불러도 될 정도다.'
$work_out_description[3] = '  <<$slave_name>>는 단순한 체조를 한다. 몸을 늘리고, 돌고, 제자리에서 뛴다 – 기본적인 유산소 운동이다. 당신은 그녀 엉덩이 모양이 더 예뻐지도록 계단 오르기도 시킨다.'
$work_out_description[4] = '  <<$slave_name>>는 30분짜리 운동 세트를 소화한다. 분명 몸 상태가 좋다. 스트레칭, 점프, 회전에 더해, 등, 복근, 허벅지, 엉덩이를 위한 근력 운동까지 해낸다.'
$work_out_description[5] = '  순수한 즐거움이다 - <<$slave_name>>가 운동에 얼마나 몰입해 있는지 지켜보는 것 자체가. 그녀는 유산소 운동과 근력 운동을 모두 가볍게 수행하며, 모든 동작을 빠르고, 매끄럽고, 정확하게 해낸다.'


$bathing_master_alone = '  목욕을 하며 당신은 따뜻한 물을 즐기고 긴장을 푼다. 땀, 눈물, 질 분비물, 그보다 더한 것들까지 – 전부 노예주인의 삶의 일부일 뿐이다. 끝도 없고, 화려함도 없고, 감사도 못 받는 일이지만 어쨌든 해야 한다. 그래도 아, 고된 하루의 때를 씻어 내는 것만큼 좋은 건 없다. 청결 - 그것이야말로 건강의 보증이다!'
$slave_washes_master = '  <<$slave_name>>는 잠들기 전 당신이 긴장을 풀고 상쾌해지도록 도와준다. 그녀는 당신의 온몸을 조심스럽고 부드럽게 씻겨 준 뒤, 부드러운 수건으로 물기를 닦아 주고 목욕가운과 슬리퍼를 가져다준다.'
$assistant_washes_master = '  <<$assistant_name>>는 잠들기 전 당신이 긴장을 풀고 상쾌해지도록 도와준다. 그녀는 당신의 온몸을 조심스럽고 부드럽게 씻겨 준 뒤, 부드러운 수건으로 물기를 닦아 주고 목욕가운과 슬리퍼를 가져다준다.'
$assistant_washes_slave = '  <<$assistant_name>>는 당신의 노예를 욕실로 데려가 비누와 스펀지로 깨끗이 씻긴다.'


!SEX LESSONS - slave

!!!!!
!IDLENESS
$slave_rest = '  <<$slave_name>>는 저녁까지 일상의 번거로움에서 벗어나 쉬고 긴장을 푼다. 훈련 면에서는 꽤 무의미한 시간 보내기지만, <<$slave_noun4[slave["age"]]>>는 이렇게 게으르게 쉴 기회에 감사해야 할 것이다.'
$boardgames = '  <<$slave_name>>는 저녁까지 카드놀이 혼자 하기, 수수께끼 풀기, 직소 퍼즐 맞추기로 시간을 보낸다.'

$idle[1] = '  <<$slave_name>>는 창가에 앉아 턱을 괴고 거리를 바라본다. 까마귀를 세는 건지, 지나가는 사람들을 멍하니 보는 건지 모른다. 지루할지도 모르지만, 당신이 그녀에게 떠넘길 수 있었던 많은 훈련들보다는 낫다.'
$idle[2] = '  <<$slave_name>>는 집 안을 목적 없이 어슬렁거리며 인테리어의 이곳저곳을 살핀다. 지루할지도 모르지만, 당신이 그녀에게 떠넘길 수 있었던 많은 훈련들보다는 낫다.'
$idle[3] = '  <<$slave_name>>는 누워서 쉬며, 축복 같은 낮잠 속에서 여가 시간을 보낸다. 지루할지도 모르지만, 당신이 그녀에게 떠넘길 수 있었던 많은 훈련들보다는 낫다.'
$idle[4] = '  <<$slave_name>>는 자기 감정에 잠긴 채 중얼중얼 무언가를 속삭이며 자유 시간을 보낸다. 지루할지도 모르지만, 당신이 그녀에게 떠넘길 수 있었던 많은 훈련들보다는 낫다.'
$idle[5] = '  <<$slave_name>>는 먼 고향의 노래를 조용히 흥얼거리며 자유 시간을 보낸다. 지루할지도 모르지만, 당신이 그녀에게 떠넘길 수 있었던 많은 훈련들보다는 낫다.'

$outdoor_rest[1] = '  당신은 노예를 겟세마네 정원으로 데려가 두어 시간 혼자 있게 내버려 둔다. 내면의 평화를 찾으라는 뜻이다. 경비병이 정해진 시간이 끝나면 그녀를 다시 데려다줄 것이다.'
$outdoor_rest[2] = '  당신이 온천에서 몸을 씻는 동안, 노예는 여자들 쪽으로 보내 당신 곁에서 잠시 벗어나 다른 소녀들과 어울리며 놀게 한다. 물론 동시에 씻기도 하니, 꽤 도움이 될 것이다. 일석이조다!'
$outdoor_rest[3] = '  당신은 <<$slave_name>>가 다른 노예들 사이에서 즐거운 시간을 보내고, 대화를 통해 속마음을 털어놓을 수 있기를 바란다. 어쩌면 사회성도 다듬고 성격도 발달시킬 수 있을 것이다. 그리고 그동안 당신은 자기 일을 볼 하루 전체를 얻게 된다.'

$outdoor_rest_assistant[1] = '  당신은 <<$assistant_name>>를 동행시켜 <<$slave_name>>를 겟세마네 정원으로 보내, 두어 시간 혼자 있게 하고 내면의 평화를 찾게 한다. 정해진 시간이 끝나면 경비병이 그녀를 돌려보낼 것이다.'
$outdoor_rest_assistant[2] = '  당신은 <<$assistant_name>>와 함께 <<$slave_name>>를 온천으로 보내, 당신 곁에서 잠시 벗어나 다른 소녀들과 어울리며 놀게 한다. 물론 동시에 씻기도 하니, 꽤 도움이 될 것이다. 일석이조다!'
$outdoor_rest_assistant[3] = '  당신은 <<$assistant_name>>를 동행시켜 <<$slave_name>>를 황금 새장으로 보낸다. <<$slave_name>>가 다른 노예들 사이에서 즐거운 시간을 보내고, 대화를 통해 속마음을 털어놓을 수 있기를 바란다. 어쩌면 사회성도 다듬고 성격도 발달시킬 수 있을 것이다. 그리고 그동안 당신은 자기 일을 볼 하루 전체를 얻게 된다.'
