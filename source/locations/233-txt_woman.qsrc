!now translated, but the slave_ration texts below are not used currently - ImperatorAugustus
$slave_ration[1] = '  불멸의 로마에서는 음식이 거의 생산되지 않는다. 그럴 공간이 부족하기 때문이다. 모든 식량은 다른 세계들에서 수입해야 하므로, 여기서는 음식도 다른 모든 것처럼 비싸다. 노예 유지비를 아끼는 가장 쉬운 방법은 - 아예 먹이지 않는 것이다. 하루 이틀의 허기는 체중을 줄이고 존중을 늘리는 데 도움이 된다. 중요한 건 - 너무 과하게 하지 않는 것이다!'
$slave_ration[2] = '  노예의 음식을 제한하면 돈도 절약되고 겸손함도 가르칠 수 있다. 게다가 식단을 줄이면 과체중 문제도 해결된다. 다만 배고픈 노예에게 불필요한 일을 시켜서 건강을 해치지는 말아야 한다.'
$slave_ration[3] = '  신선한 채소와 벌크 물질 - 예를 들면 식이섬유 - 가 많은 음식으로 이루어진 식단은 노예가 과체중을 빼는 동안에도 꽤 맛있게 먹고 큰 허기 없이 버틸 수 있게 해 준다. 물론 일반 식단보다 비용은 더 든다.'
$slave_ration[4] = '  불멸의 로마의 모든 식량은 수입품이다. 주로 통조림 음식이 들어오는데, 오랜 운송 동안 상하지 않기 때문이다. 통조림 음식은 적당한 비용으로 노예에게 영양가 있는 식사를 제공한다. 물론 그렇게 맛있진 않지만, 그렇다고 역겨운 것도 아니다.'
$slave_ration[5] = '  노예가 고된 육체노동을 하거나 탈진에서 회복 중이라면 두 배 분량이 필요할 수 있다. 물론 두 배 식단에는 돈도 두 배로 들고, 쓰이지 않은 열량은 전부 길러지는 사람의 옆구리에 쌓이게 된다.'
$slave_ration[6] = '  집에서 조리한 음식은 일반 통조림 식단보다 맛이 좋다. 이런 먹이는 누구든 기분 좋게 만든다, 특히 미식가라면 더더욱! 다만 체형 관리는 잊지 마라. 그리고 음식은 누군가가 요리해야 한다 - 그렇지 않으면 당신도 통조림 음식을 먹게 될 것이다!'
$slave_ration[7] = '  보통 식사에 달콤한 디저트를 곁들이면, 통조림 식사라 해도 훨씬 더 많은 즐거움을 주고 기분도 확실히 좋아진다. 다만 이런 사치는 스파크가 들고 열량도 많이 늘어난다는 점을 감안해야 한다.'
$slave_ration[8] = '  디저트를 피하면 돈을 아낄 수 있고 추가 열량도 줄일 수 있다. 물론 식사가 그렇게 즐겁진 않겠지만, 누가 당신에게 응석을 약속했나?'
$slave_ration[9] = '  몸에 필요한 모든 비타민과 미네랄을 섞어 만든 복합 보충제다. 매일 먹이면 건강에 좋은 영향을 주지만, 추가 스파크를 들일 가치까지 있을까?'
!----------------------------!

$slave_no_food = '  불멸의 로마에서는 스스로 음식을 길러 먹을 기회가 거의 없다. 모든 음식은 안개 너머의 세계들에서 들여와야 하고, 그래서 꽤 많은 돈이 든다. 노예에게 음식을 주지 않으면 두 마리 새를 한 번에 잡을 수 있다 - 더 순종적으로 만들면서 돈도 아낄 수 있다. 물론 건강에는 좋지 않다.'
$slave_dry_food = '줄바르스 주마스의 탈수 반려동물 사료는 유력한 노예상들의 선택이다. 10리터짜리 셀로판 봉투 단위로 배송되며, 무게가 가벼워 안개를 통한 운송 비용도 싸다. 여성 노예에게 필요한 모든 영양소와 식이섬유를 포함하지만, 맛은 역겹다.'
$slave_cane_food = '  반려동물용 통조림 음식. 여성 노예에게 맞는 영양 구성이 완벽하게 일치하며, 건사료나 안개 괴물 정액보다 맛도 낫다. 불행히도 꽤 비싸다 - 신선한 음식은 무게가 많이 나가고, 다른 세계들에서 수입해야 하니까. 훌륭한 복종과 적당한 헌신에 대한 보상으로만 써야 한다. 그렇지 않으면 노예를 응석받이로 만들 위험이 있다.'
$slave_semen_food = '  괴물는 로마의 재앙이자 축복이다. 위험하지만, 역겹고도 영양가 있는 정액을 어마어마하게 생산할 수 있다. 이 생물들을 착유하는 일은 쉽지 않아서 그 정액도 값이 싸지 않다. 하지만 자기 괴물와 뛰어난 착유사가 있다면 노예 먹이기는 훨씬 쉬워진다. 물론 그녀가 그걸 먹게 만들 수만 있다면 말이다…'
$slave_no_leftovers = '  모든 노예가 주인 식탁의 남은 음식을 먹을 자격이 있는 건 아니다. 그런 영예는 벌어야 한다. 그리고 노예의 체형도 잊지 마라. <br><br>  외양간에서 여자를 살찌우는 중이라면, 대신 그녀에게 남은 음식을 먹일 수도 있다.'
if pig_state = CONST_INT['slave_exist']: $slave_no_leftovers = '  <br>  당신의 남은 음식은 현재 주방 음식찌꺼기에 섞여 <br><b>외양간의 암퇘지 먹이로 쓰인다</b>. 원래 쓰레기가 됐을 음식으로 그녀를 먹이는 것은 비용 없이 살을 찌우는 훌륭한 방법이다.'
$slave_eats_leftovers = '  당신의 노예는 당신의 남은 음식을 먹을 수 있다. 식탁 찌꺼기는 보통 노예 음식보다 더 맛있지만, 대개 배를 충분히 채우기엔 부족하다. 이것은 디저트, 즉 기본 식단에 더해지는 괜찮은 추가분 정도로 보면 된다. 훌륭한 복종과 적당한 헌신에 대한 보상으로만 써야 한다. 그렇지 않으면 노예를 응석받이로 만들 위험이 있다.'
$slave_min_portion = '  노예가 굶어 죽지만 않을 정도의 최소량이다. 단, 그녀가 음식으로 얻는 열량보다 더 많이 소모하게 만들지 않는 한에서. 만족하긴 어려울 테지만, 살은 빠지고 누가 우두머리인지도 배우게 될 것이다. 게다가 돈도 조금 아낄 수 있다.'
$slave_normal_portion = '  노예가 자기 체중을 유지할 수 있을 만큼의 딱 알맞은 양이다. 단, 그녀가 음식으로 얻는 열량보다 더 많이 소모하지 않는 한에서. 열량을 정확히 계산하려면 의료 조수가 있으면 좋겠지만, 지금은 그냥 눈대중으로 한다. 아마 괜찮을 것이다.'
$slave_max_portion = '  노예의 그릇은 가득 차 넘친다. 그녀는 원하는 만큼 먹을 수 있다. 물론 낭비이긴 하지만, 음식으로 얻는 열량보다 더 많이 소모하지 않는 한 배고프지는 않을 것이다. 다만 살이 조금 찔 수도 있다.'
$slave_diet_supplements = '  "나노분자 25% 더 함유", "유전자조작 식품 미포함" 같은 화려한 설명이 달린 첨단 생리활성 첨가제 복합체다. 대체 이게 무슨…? 노예 건강이 평균 이하라면 도움이 될 수도 있다. 하지만 이미 건강하다면 그저 돈 낭비일 뿐이다.<br><br>  하루 1 스파크, 10일 단위로 청구.'
$slave_nutritionist = '  길드 영양사가 당신이 제공하는 음식으로 신중하게 계산된 식사를 준비해, 열량 섭취를 조절하여 노예의 체중이 안정적으로 유지되도록 해 준다. 비용은 하루 5 스파크의 적당한 수수료다. 노예가 건강하지 않다면, 회복을 돕도록 식단도 조정된다.' + iif(difficulty_setting = 2, ' 물론 노예가 음식으로 얻는 열량보다 더 많이 소모하지 않도록 당신이 직접 주의해야 한다.', '')
$slave_nutritionist_assistant = '  의료 훈련을 받은 당신의 조수가, 당신이 제공하는 음식으로 신중하게 계산된 식사를 준비해 노예의 체중이 열량 섭취 조절을 통해 안정되게 유지되도록 해 준다. 노예가 건강하지 않다면, 회복을 돕도록 식단도 조정된다.' + iif(difficulty_setting = 2, ' 물론 노예가 음식으로 얻는 열량보다 더 많이 소모하지 않도록 당신이 직접 주의해야 한다.', '')
$slave_nutritionist_master = '  당신의 의료 전문지식을 이용해, 이용 가능한 음식으로 신중하게 계산된 식사를 직접 준비하여 노예의 체중이 열량 섭취 조절을 통해 안정되게 유지되도록 한다. 노예가 건강하지 않다면, 회복을 돕도록 식단도 조정할 것이다.' + iif(difficulty_setting = 2, ' 물론 노예가 음식으로 얻는 열량보다 더 많이 소모하지 않도록 당신이 직접 주의해야 한다.', '')

$assistant_account_rule_abort = '  당신은 조수에게 회계 관리를 맡기는 책임에서 벗겨 주는 편이 낫겠다고 판단한다. 결국 그녀가 실수하거나 뭔가를 잊으면, 대가를 치르는 건 당신이니까.'
$assistant_account_rule = '  당신은 조수에게 이제부터 모든 회계를 제대로 제때 관리하는 책임을 맡긴다고 말한다. 이 결정은 매우 중요하다. 실력이 좋으면 절약할 수 있지만, 실수는 재정 문제로 이어질 수 있다. 그래도 서류에 직접 파묻히는 것보단 낫다. 이 일을 노예에게도 맡긴다면, 조수가 그녀 일을 감독하게 된다.'

$silence_rule = '  당신은 노예에게 어떤 것을 물어보기 전까지는 침묵을 지키라고 명령한다. 이는 민감성, 겸손, 움직임의 표현력을 기르는 데 도움이 되지만, 기질을 억누를 수도 있다.'
$silence_rule_abort = '  당신은 노예가 스스로 말하고 자기 의견을 표현하는 것을 허락한다.'
$humility_rule = '  당신은 노예에게 이제부터 예의 바른 노예답게 행동하라고 명령한다. 언제나 공손하게 당신을 "주인님"이라고 불러야 한다. 이렇게 하면 절대적인 복종에 빠르게 익숙해질 것이다.'
$humility_rule_abort = '  당신은 노예가 노예와 주인 사이의 격식을 갖춘 의사소통 규칙을 따르지 않고도, 좀 더 친근하게 당신을 부르도록 허락한다.'
$masturbation_rule = '  당신은 노예에게, 별도로 지시하지 않는 한 자위를 금지한다. 그녀가 복종한다면 흥분을 스스로 풀지 못하게 될 것이고, 자위 욕구를 성공적으로 참아 내면 길들임도 조금 증가할 것이다.'
$masturbation_rule_abort = '  당신은 노예가 자유롭게 자위하도록 내버려 둔다.'
$orgasm_prohibited = '  당신은 특별한 허락을 주지 않는 한, 노예가 오르가즘을 느끼는 것을 금지한다. 그녀가 사정을 참아 낼 때마다 흥분과 민감성은 증가할 것이다.'
$orgasm_prohibited_abort = '  당신은 노예에게 허락 없이 절정해도 된다고 말해 해방을 허락하지만, 언제든 마음을 바꿀 수 있다는 경고도 덧붙인다!'
$shit_prohibited = '  당신은 노예가 당신 허락 없이 화장실에 가는 것을 금지한다. 아주 드물게, 그리고 당신 감독 아래에서만 화장실 이용을 허락할 것이다. 이것은 겸손을 가르치는 데 도움이 되지만, 그 대가로 노예의 기분은 나빠질 것이다.'
$shit_prohibited_abort = '  당신은 노예가 원할 때마다 스스로 화장실에 가도록 허락한다. 적어도 끊임없는 눈물과 애원으로 당신을 방해하진 않을 것이다.'
$pet_rule = '  당신은 노예에게 애완동물처럼 행동하라고 명령한다: 언제나 네 발로 걸어 다니고 동물에게 어울리는 소리를 내야 한다. 이것은 겸손을 가르치는 동시에 유연성도 길러 준다.'
$pet_rule_abort = '  당신은 노예가 다시 사람처럼 행동하도록 허락한다.'

$blowjob_rule = '  당신은 노예를 인간 알람시계로 쓸 것이다. 매일 아침 정해진 시간에, <<$slave_name>>는 당신의 보지를 핥아 당신을 깨워야 한다. 이 방식은 아침 기분을 좋게 하고 노예를 성적 행위에 대비시키는 데도 도움이 된다.'
$blowjob_rule_abort = '  당신은 아침에 일어날 때 노예가 당신을 기분 좋게 해 주려 들거나 자기 책임을 회피하려 드는 일에 더는 방해받지 않기로 한다.'
$urinal_rule = '  당신은 노예를 인간 소변기로 사용할 것이다. <<$slave_name>>는 당신의 오줌을 모두 조심스럽게 삼키고, 흘린 것까지 혀로 깨끗이 핥아야 한다. 이것은 그녀의 자존심을 크게 깎아내리고 당신의 기분도 좋게 만든다. 또한 아직 부족한 기술도 가르쳐 줄 것이다. 위생에는 좋지 않다.'
$urinal_rule_abort = '  당신은 평범한 화장실을 사용할 것이니, 가까운 미래에는 노예의 서비스가 필요 없다고 말한다.'
$toilet_rule = '  당신은 노예를 인간 화장실로 사용할 것이다. <<$slave_name>>는 모든 것을 삼키고, 혀로 당신을 부드럽게 닦아야 한다. 불필요한 자존심을 없애는 데 이보다 더 좋은 방법은 없다. 게다가 잘 훈련된 노예 변기는 집 안에서 편리하고 기분도 끌어올린다. 아무것도 아니더라도 노예는 적어도 뭔가는 배우게 된다. 건강과 위생에는 해롭다.'
$toilet_rule_abort = '  당신은 평범한 화장실을 사용할 것이니, 가까운 미래에는 노예의 서비스가 필요 없다고 노예에게 말한다.'

$v_balls_rule = '  당신은 노예의 보지에 질구슬을 넣고, 민감성과 욕망을 기를 수 있도록 항상 착용하고 있으라고 명령한다.'
$v_balls_rule_abort = '  당신은 노예에게 질구슬을 빼서 깨끗이 씻은 뒤 당신에게 가져오라고 명령한다. 그녀의 흥분은 학습의 방해물이 되지 않도록 통제되어야 한다.'
$force_rules = '  당신은 배 모양 애널 플러그, 개구기, 정조대, 펫 수트, 변기 거치대 같은 여러 도구와 조수의 특별 감독까지 동원해, 그녀가 규칙을 무시하지 못하게 하겠다고 노예에게 말한다. 물론 이것이 그녀를 비참하고 우울하게 만들 수는 있지만, 동시에 겸손을 가르치고 복종이 결국 그녀 자신에게 가장 좋은 선택이라는 사실도 깨닫게 할 것이다.'
$force_rules_abort = '  당신은 노예에게, 이제부터는 특별한 도구와 추가 감독의 도움 없이도 모든 규칙을 순종적으로 따르라고 말한다. 물론 그렇다고 명령을 무시해도 벌이 없다는 뜻은 아니다…'

$assistant_cleans_rule_abort = '  당신은 조수가 집안을 정리하는 데 시간을 낭비하지 않아도 되도록 허락한다. 이 부분에는 다른 계획이 있으니까.'
$assistant_cleans_rule = '  당신은 조수에게 노예가 하지 않을 때 집안 청결과 질서를 돌보라고 명령한다. 이제 그녀가 충분한 시간을 찾고 기력만 남아 있다면, 당신이 더 상기시키지 않아도 스스로 하게 될 것이다.'
$assistant_cooks_rule_abort = '  당신은 조수가 일상적인 요리에 기력을 낭비하지 않아도 되도록 허락한다. 이 부분에는 다른 계획이 있으니까.'
$assistant_cooks_rule = '  당신은 조수에게 노예가 하지 않을 때 당신 식사를 요리하라고 명령한다. 이제 그녀가 충분한 시간을 찾고 기력만 남아 있다면, 당신이 더 상기시키지 않아도 스스로 하게 될 것이다.'
