$aura_obedience[16] = '당신은 복종의 징후에 집중하고, <font color="#cd0000">반항의 날카로운 가시 여섯 개</font>를 센다.'
$aura_obedience[17] = '당신은 복종의 징후에 집중하고, <font color="#cd0000">반항의 날카로운 가시 일곱 개</font>를 센다.'
$aura_obedience[18] = '당신은 복종의 징후에 집중하고, <font color="#cd0000">반항의 날카로운 가시 여덟 개</font>를 센다.'
$aura_obedience[19] = '당신은 복종의 징후에 집중하고, <font color="#cd0000">반항의 날카로운 가시 아홉 개</font>를 센다.'
$aura_obedience[20] = '당신은 복종의 징후에 집중하고, <font color="#cd0000">반항의 날카로운 가시가 아주 많이</font> 보인다.'

$aura_supermacy[1] = '<font color="#cd0000">당신 노예의 아우라가 당신 것보다 훨씬 더 밝게 빛난다</font>.'
$aura_supermacy[2] = '<font color="#EA0090">당신 노예의 아우라가 당신 것보다 더 밝게 빛난다</font>.'
$aura_supermacy[3] = '<font color="#0000D8">당신 노예의 아우라는 당신 것과 대략 비슷하다</font>.'
$aura_supermacy[4] = '<font color="#009900">당신 노예의 아우라는 당신 것보다 더 희미하다</font>.'
$aura_supermacy[5] = '<font color="#009900">당신 노예의 아우라는 당신 것보다 훨씬 더 희미하다</font>.'

$aura_lust[0] = '아우라는 거의 맥동 없이 천천히 부드럽게 움직인다. 성적 욕망의 징후는 전혀 눈에 띄지 않는다.'
$aura_lust[1] = '아우라의 미세한 떨림은 약한 성적 욕망이 존재한다는 것을 암시한다.'
$aura_lust[2] = '관능적인 아우라의 흔들림은 상당한 성적 흥분이 존재한다는 뜻이다.'
$aura_lust[3] = '아우라는 분명히 떨리고, 비틀렸다가 다시 풀리기를 관능적인 리듬으로 반복한다. 이는 강한 성적 흥분을 뜻한다.'
$aura_lust[4] = '아우라는 관능적이고 갈망에 찬 맥동을 하며, 당신 쪽으로 뻗고 휘어진다. 이는 강력한 성적 흥분과 거의 통제 불가능한 욕망의 징후다.'
$aura_lust[5] = '거의 간질 발작 같은 속도의 깜빡임과 변조는 극한의 성적 흥분을 암시한다. 모든 색이 빠른 소용돌이로 뒤섞여, 마치 고속으로 도는 팽이 표면처럼 보인다.'

$aura_fear[0] = '<font color="#960018">루비빛 공포의 번뜩임</font><font color="#009900">은 거의 미미하다</font>.'
$aura_fear[1] = '<font color="#960018">루비빛 공포의 번뜩임</font>은 드물다. 1분 동안 겨우 <font color="#EA0090">한 번</font>만 눈에 띄었다.'
$aura_fear[2] = '<font color="#960018">루비빛 공포의 번뜩임</font>이 이따금 나타난다. 1분 동안 <font color="#6B0084">두 번</font>을 셌다.'
$aura_fear[3] = '<font color="#960018">루비빛 공포의 번뜩임</font>이 꽤 자주 나타난다. 당신은 <font color="#0000D8">세 번</font>을 셌다.'
$aura_fear[4] = '<font color="#960018">루비빛 공포의 번뜩임</font>은 꽤 밝고 눈에 잘 띈다. 특히 강한 것만도 <font color="#EA0090">네 번</font>을 셌다.'
$aura_fear[5] = '<font color="#960018">루비빛 공포의 번뜩임</font>은 하나하나 나타나면서도 쉽게 사라지지 않고, 아드레날린으로 넘치는 심장처럼 맥동한다. 겨우 1분 동안 무려 <font color="#CD0000">다섯 번</font>이나 셌다.'

$aura_angst[0] = '<font color="#464451">무연탄빛 절망</font><font color="#009900">은 거의 감지되지 않는다</font>.'
$aura_angst[1] = '<font color="#464451">무연탄빛 절망</font>이 <font color="#cd0000">하나</font>의 촉수를 형성해, 당신 노예의 아우라 전체를 꿰뚫고 있다.'
$aura_angst[2] = '<font color="#464451">무연탄빛 절망</font>이 <font color="#cd0000">두 개</font>의 촉수를 형성해, 양쪽에서 당신 노예의 아우라를 단단히 휘감고 있다.'
$aura_angst[3] = '<font color="#464451">무연탄빛 절망</font>이 빽빽한 응괴를 이루었고, 거기서 <font color="#cd0000">세 개</font>의 역겹게 꿈틀거리는 촉수가 삐져나와 있다.'
$aura_angst[4] = '<font color="#464451">무연탄빛 절망</font>이 자라나 <font color="#009FEF">네 개</font>의 촉수를 뻗어, 사방에서 당신 노예의 아우라를 집어삼키고 있다.'
$aura_angst[5] = '<font color="#464451">무연탄빛 절망</font>이 당신 노예의 아우라 전체에 스며들어 있다. 다른 모든 색을 갈기갈기 찢어 버리는, <font color="#cd0000">다섯 개</font>의 굵고 역겹게 꿈틀거리는 촉수가 선명하게 보인다.'

$aura_rational[0] = '<font color="#B452CD">자각의 자수정 핵</font><font color="#cd0000">은 형성되지 않았다</font>.'
$aura_rational[1] = '<font color="#B452CD">자각의 자수정 핵</font>은 매우 작고, <font color="#EA0090">오직 하나</font>의 방울만으로 형성되어 있다.'
$aura_rational[2] = '<font color="#B452CD">자각의 자수정 핵</font>은 <font color="#6B0084">두 개</font>의 단단히 응집된 방울로 이루어져 있다.'
$aura_rational[3] = '<font color="#B452CD">자각의 자수정 핵</font>은 중간 크기다. 그 안에서 <font color="#0000D8">세 개</font>의 방울을 셌다.'
$aura_rational[4] = '<font color="#B452CD">자각의 자수정 핵</font>은 크고 치밀하며, <font color="#009FEF">네 개</font>의 또렷한 방울로 형성되어 있다.'
$aura_rational[5] = '<font color="#B452CD">자각의 자수정 핵</font>은 중심부를 지배하고 있다. 그 형태는 최소 <font color="#009900">다섯 개</font>의 잘 형성된 방울이 존재함을 보여 준다.'

$aura_instinct[0] = '<font color="#CD9B1D">길들임의 황금 실오라기</font><font color="#cd0000">는 거의 눈에 띄지 않는다</font>.'
$aura_instinct[1] = '<font color="#CD9B1D">길들여짐의 황금 실선</font>은 거의 형성되지 않았다. 그중 단 <font color="#EA0090">하나</font>만이 충분히 강해 보인다.'
$aura_instinct[2] = '<font color="#CD9B1D">길들여짐의 황금 실선</font>이 여기저기 보인다. 그중 <font color="#6B0084">두 가닥</font>이 특히 강해 보인다.'
$aura_instinct[3] = '<font color="#CD9B1D">길들여짐의 황금 실선</font>이 곳곳에서 눈에 띈다. 그중 <font color="#0000D8">세 가닥</font>이 특히 강해 보인다.'
$aura_instinct[4] = '<font color="#CD9B1D">길들여짐의 황금 실선</font>은 어디에나 보인다. 그중 <font color="#009FEF">네 개</font>의 특히 밝은 고리가 지구본의 자오선처럼 아우라 둘레를 따라 지나간다.'
$aura_instinct[5] = '<font color="#CD9B1D">길들여짐의 황금 실선</font><font color="#009900">이 아우라 전체를 덮어</font>, 촘촘히 묶인 햄 조각처럼 보이게 만든다.'

$aura_custom[0] = '<font color="#082567">습관의 사파이어빛 점멸</font><font color="#cd0000">은 완전히 부재한다</font>.'
$aura_custom[1] = '<font color="#082567">습관의 사파이어빛 점멸</font>은 매우 흐릿하며, <font color="#EA0090">한 곳</font>에서만 겨우 눈에 띈다.'
$aura_custom[2] = '<font color="#082567">습관의 사파이어빛 점멸</font>은 꽤 희미하게, 겨우 <font color="#6B0084">두 곳</font>에서만 나타난다.'
$aura_custom[3] = '<font color="#082567">습관의 사파이어빛 점멸</font>은 제법 안정적이다. 그 집중점이 <font color="#0000D8">세 곳</font> 보인다.'
$aura_custom[4] = '<font color="#082567">습관의 사파이어빛 점멸</font>은 당신 노예의 아우라 전체 표면을 굽이치며 지나가며, <font color="#009FEF">네 방향</font>에서 그것을 감싼다.'
$aura_custom[5] = '<font color="#082567">습관의 사파이어빛 점멸</font><font color="#009900">이 당신 노예의 아우라 전체를 감싸</font>, 부드럽고 안개 낀 장막처럼 보인다. 모든 각과 돌출부, 선명한 색들을 부드럽게 하고 가린다.'

$aura_spoil[0] = '<font color="#EE1289">버릇들임의 저속한 분홍빛 윤광</font><font color="#009900">은 당신 노예의 아우라를 망치지 않는다</font>.'
$aura_spoil[1] = '<font color="#EE1289">버릇들임의 저속한 분홍빛 윤광</font>은 <font color="#009FEF">한 곳</font>에 모여, 역겨운 벌레구멍 같은 것을 만들고 있다.'
$aura_spoil[2] = '<font color="#EE1289">버릇들임의 저속한 분홍빛 윤광</font>은 당신 노예의 아우라 위에 <font color="#cd0000">두 개</font>의 혐오스러운 종기를 형성한다.'
$aura_spoil[3] = '<font color="#EE1289">버릇들임의 저속한 분홍빛 윤광</font>은 당신 노예의 아우라 위에 <font color="#cd0000">세 개</font>의 고약한 종기를 형성한다.'
$aura_spoil[4] = '<font color="#EE1289">버릇들임의 저속한 분홍빛 윤광</font>은 당신 노예의 아우라 위에 <font color="#cd0000">네 개</font>의 흉한 궤양을 형성한다.'
$aura_spoil[5] = '<font color="#EE1289">버릇들임의 저속한 분홍빛 윤광</font><font color="#cd0000">은 어디에나 퍼져 있으며</font>, 당신 노예의 아우라를 피가 밴 종기 같은 무늬로 얼룩지게 만든다.'

$aura_moral[0] = '<font color="#00a86b">헌신의 에메랄드빛 광휘</font><font color="#cd0000">는 전혀 드러나지 않는다</font>.'
$aura_moral[1] = '<font color="#00a86b">헌신의 에메랄드빛 광휘</font>는 <font color="#EA0090">단 한 곳</font>에서만 보이며, 흐린 하늘의 희미한 별처럼 보인다.'
$aura_moral[2] = '<font color="#00a86b">헌신의 에메랄드빛 광휘</font>는 <font color="#6B0084">한 쌍</font>의 부드럽게 빛나는 별을 이룬다.'
$aura_moral[3] = '<font color="#00a86b">헌신의 에메랄드빛 광휘</font>는 <font color="#0000D8">세 개</font>의 뚜렷한 별에서 뻗어 나온다.'
$aura_moral[4] = '<font color="#00a86b">헌신의 에메랄드빛 광휘</font>는 <font color="#009FEF">네 개</font>의 밝은 별에서 뻗어 나와, 당신 노예의 아우라를 비춘다.'
$aura_moral[5] = '<font color="#00a86b">헌신의 에메랄드빛 광휘</font>가 당신 노예의 아우라를 지배하며, 그것을 <font color="#009900">무수한</font> 밝고 선명한 별들로 점찍어 놓는다.'
!ASSISTANT AURA

!TRAITS
$Нет_клейма = ' 노예에게 낙인이 없다! 낙인 없는 노예는 손님에게 팔 수 없고, 또한 낙인 없는 노예는 자신의 운명을 노예로 받아들이는 데 더 오랜 시간이 걸린다. 지하실이 있다면 직접 낙인을 찍을 수 있고("해부학" 탭을 통해), 배제 구역의 문신소에 가도 되며, 능력이 있다면 주문을 사용할 수도 있다.'
! JO9 MOD START RNL133 | 2026-10-17_zz_rank_display_labels
! RNL: 표시 등급 문자만 변경; 같은 대입문의 연결 줄은 원문을 유지한다.
$sanity_broken = ' 노예의 정신이 부서졌다. 이것은 노예가 영혼 없는 인형이 되었음을 뜻한다 - 평점은 낮아지고, 더 이상 애쓰지 않게 되며, 삶에 대한 의지도 잃지만 모든 명령은 묻지도 따지지도 않고 수행한다. 그녀의 본성이 D를 넘기 전까지는 자존심과 기질이 오르지 않는다. 전투 승리, 개인실, 황금 새장, 겟세마네 정원, 온천 등이 그녀 정신을 회복시키는 데 도움이 될 수 있다.'
$sanity_low = ' 노예의 정신 상태가 위험할 정도로 낮아지고 있다! 자존심을 조심하라 - 자존심이 떨어지면 정신도 약해진다. 기질과 본성 상태를 확인하라 - 정상적인 정신 상태를 유지하려면 두 수치의 평균이 D를 넘어야 한다.'
! JO9 MOD END RNL133
$Нимфоманка = ' 당신은 당신의 노예가, 좋게 말해도, 섹스를 몹시 밝힌다는 걸 알아차렸다. 많은 성적 행위는 그녀에게 더 쉬워지겠지만, 채워지지 않는 욕망은 그녀를 미치게 만들 것이다.'
$Фригидная = ' 당신은 당신 노예가 섹스에 완전히 무관심하다는 걸 깨닫는다. 그녀를 흥분시키는 것은 사실상 불가능하고, 이는 관련 기술 발달을 분명 복잡하게 만들며 모든 에로틱한 보상을 무효화한다.'
$Мазохистка = ' 고통은 당신 노예를 겁주지 않는다. 오히려 그녀는 고통을 갈망하고, 거기서 쾌락을 얻는다. 마조히스트에게 채찍질은 소용없지만, 그녀에게 영향을 줄 다른 방법은 있다…'
$Привычна_к_боли = ' 당신의 노예는 고통을 견딜 수 있다. 마조히스트는 아니지만, 평범한 고문으로 겁주기는 쉽지 않다. 하지만 고통 말고도 두려움의 원천은 언제든 찾을 수 있다…'
$Боится_боли = ' 당신의 노예는 고통을 끔찍이 두려워해, 평범한 매질만으로도 울음을 터뜨릴 준비가 되어 있다. 기억해 두어라 - 고통스러운 처벌이 훨씬 더 효과적일 것이다!'
$Эксгибиционистка = ' 당신은 당신의 노예가 자기 알몸을 드러내는 데 특별한 기쁨을 느낀다는 걸 알아차린다. 그녀에게 알몸의 수치를 느끼게 만들 수는 없지만, 분명 어떤 수업들은 더 쉽게 진행될 것이다.'
$Стеснительная = ' 당신 노예는 분명 자기 알몸을 미칠 듯이 부끄러워한다. 알몸을 드러내는 기술을 가르치기는 어려울 것이지만, 이 특성은 더 효과적인 처벌을 고르는 데 활용할 수 있다.'
$Извращенка = ' 당신 노예는 대부분의 사람들이 역겹다고 여기는 것들을 좋아하는 것 같다. 가장 더럽고 변태적인 짓들에 특히 강하게 흥분한다 - 이는 극단적인 성기술을 익히는 데 분명 유용하다.'
$Пуристка = ' 당신은 당신 노예가 비표준적이고 더러운 종류의 섹스와, 변태성과 관련된 모든 것을 견디지 못한다는 걸 알아차린다. 극단적인 성적 행위를 교육하는 일은 특히 어려울 것이다.'
$Лесбиянка = ' 실제로 확인해 보니 당신 노예는 남자에게는 완전히 무관심하지만, <<iif(slave_type, $slave_girls2_txt[slave["age"]], "여자들")>>과는 기꺼이 섹스한다. 대부분의 경우 이것은 문제가 되겠지만, 그래도 그녀에게도 가르칠 수 있는 건 있다.'
$Бисексуальная = ' 당신은 당신 노예가 여자와 남자 모두와의 섹스를 똑같이 즐긴다는 걸 이해한다. 이런 개방성은 특정 성적 행위에서 꽤 유용할 수 있다.'
$Гомофобка = ' 당신 노예는 다른 <<iif(slave_type, $slave_noun6[slave["age"]], "소녀")>>와의 섹스로는 전혀 흥분할 수 없다. 아주 큰 문제는 아니지만, 그래도 몇몇 성적 행위에서는 성과가 떨어질 것이다.'
$Пси_мазохистка = ' 당신은 당신 노예가 모욕당하고 말로 학대당할 때 비뚤어진 쾌락을 느낀다는 걸 알아차린다. 욕설과 협박은 아무 소용이 없고, 오히려 그녀의 나쁜 행동만 더 부추길 뿐이다. 더 거친 제재를 써야 한다.'
$Истеричка = ' 타인의 관심은 당신 노예에게 엄청나게 중요하다. 그녀는 언제나 주목의 중심에 있고 싶어 하고, 칭찬을 갈망한다. 말로 하는 격려는 특히 효과적일 것이다.'
$Дитя_тьмы = ' 틈만 나면 당신 노예는 어두운 구석에 숨으려 든다. 어둠 속에서 특별히 편안함을 느끼는 것 같다. 이것은 몇몇 처벌의 효과를 낮출 수 있다.'
$Боится_темноты = ' 당신은 당신 노예가 어둠 속에 남겨지는 것을 죽을 만큼 두려워한다는 걸 알아차렸다. 이 공포는 당신에게 유리하게 쓸 수 있다: 시야 제한을 수반하는 처벌이 특히 효과적일 것이다.'
$Кровожадная = ' 당신 노예는 피의 모습과 맛을 좋아하는 것 같다. 이런 특성은 몇몇 고문의 효과를 떨어뜨릴 수 있다. 바늘과 메스가 그녀를 겁주는 대신 오히려 끌어당기기 때문이다.'
$Боится_крови = ' 피를 보는 순간 노예는 거의 기절할 지경이 된다. 피를 흘리게 하는 고문은 특히 강력한 효과를 낼 것이라는 점을 기억해 둔다. 이제 바늘과 메스를 갈아야 할 시간이다!'
$Пиромания = ' 당신 노예는 불에 절대적으로 매혹된 것 같다. 불꽃을 너무 좋아해서, 고통스러운 화상조차 용감하게 견디려 든다. 이것은 어떤 종류의 고문의 효과를 낮출 것이다.'
$Пирофобия = ' 노출된 불꽃은 당신 노예에게 짐승 같은 공포를 불러일으키는 것 같다. 즉, 불과 관련된 고문을 사용하면 훨씬 더 큰 효과를 얻을 수 있다는 뜻이다.'
$Дитя_воды = ' 당신 노예는 물을 사랑하는 듯하며, 물에 빠져 죽을 수도 있다는 전망도 그다지 두려워하지 않는다. 물을 이용한 고문으로 그녀를 겁주기는 어려울 것이다.'
$Гидрофобия = ' 당신 노예는 질식하는 것을 미칠 듯이 두려워하며, 머리가 물에 잠기면 그대로 굳어 버린다. 이것은 모든 수중 고문의 효율을 크게 높여 줄 것이다.'
$Арахнофилия = ' 당신 노예는 온갖 역겨운 생물들 - 딱정벌레, 전갈, 뱀, 쥐, 특히 거미 - 에 병적인 애착을 느끼는 것 같다! 그래서 아무리 혐오스러운 파충류를 들이밀어도 그녀를 겁줄 수가 없다.'
$Арахнофобия = ' 당신은 당신 노예가 딱정벌레, 전갈, 뱀, 쥐, 특히 거미 같은 온갖 역겨운 생물들을 미친 듯이 두려워한다는 걸 알아차린다. 즉, 이런 생물들을 이용한 고문이 극도로 효과적이라는 뜻이다.'
$Любит_беспомощность = ' 당신은 이동을 제한하는 것이 당신 노예에게 매우 긍정적으로 작용한다는 걸 알아차린다. 그녀는 그저 묶이거나 좁은 상자에 갇히는 걸 기뻐하는 것 같다. 이런 점은 많은 처벌을 사실상 쓸모없게 만든다.'
$InuredHelplessness = ' 당신은 이동 제한이 당신 노예를 거의 괴롭히지 않는다는 걸 알아차린다. 이 부류의 처벌은 그녀에게 덜 효과적이겠지만, 완전히 쓸모없는 건 아니다.'
$Клаустрофобия = ' 노예의 움직임을 제한하면 그녀는 즉시 공포로 질식할 듯해진다. 무력감과 도망칠 수 없다는 감각이 그녀에게 짐승 같은 공포를 일으키는 것 같다. 가장 효과적인 처벌을 고를 때 이 점을 기억해야 한다.'
$Ленивая = ' 당신 노예를 지켜보면, 그녀가 빈둥거릴 기회를 높이 평가한다는 걸 알 수 있다. 노예에게는 썩 좋은 특성이 아니지만, 몇몇 종류의 보상은 분명 더 효과적일 것이다.'
$Гиперактивная = ' 당신 노예는 도무지 가만히 앉아 있지를 못한다. 언제나 활력이 넘치고, 늘 무슨 일엔가 바쁘다. 자유 시간을 준다고 해서 특별한 감사는 받지 못할 것이다.'
$Любит_роскошь = ' 보아하니 당신 노예는 아름답고, 사치스럽고, 반짝이는 모든 것에 미쳐 있다. 드레스와 장신구만 있으면 그녀 마음은 쉽게 얻을 수 있다.'
$Аскетичная = ' 당신 노예는 사치에 완전히 무관심한 것 같다. 반짝이는 장식품이나 화려한 드레스로는 매수할 수 없다. 좋지 않은 일이다. 영향을 줄 수단이 줄어들기 때문이다.'
$Сладкоежка = ' 당신은 당신 노예가 달고 맛있는 모든 것에 미쳐 있다는 걸 알아차린다. 이런 미식 취향은 조종할 수 있는 큰 기회를 드러낸다: 달콤한 디저트 하나만 있어도 그녀는 엄청난 데까지 나아갈 준비가 되어 있다!'
$Не_любит_сладкое = ' 당신 노예는 미식가가 아닌 것 같다. 아주 조금만 먹고, 음식 맛에는 거의 관심이 없다. 안타깝지만 케이크나 초콜릿으로는 매수할 수 없다.'
$Тщеславная = ' 당신은 노예가 사람들 사이에서 활짝 살아나는 걸 알아차린다. 그녀는 분명 주목의 중심에 서는 걸 좋아하고, 끊임없이 떠든다. 도시 데이트는 아주 효과적인 보상이 될 것이다.'
$Хикикомори = ' 당신 노예는 낯선 사람을 피하고, 공개된 장소에 있는 걸 즐기지 않는다는 걸 알게 된다. 보아하니 그녀가 원하는 건 그저 네 벽 안에 틀어박혀 아무 데도 나가지 않는 것뿐이다. 데이트는 그녀에게 끝없는 스트레스가 될 것이다.'
$Отмороженая = ' 당신 노예는 단순히 용감한 정도가 아니라 무모하다. 어째서인지 공포라는 감정을 모르고, 겁주는 것이 불가능하다. 이런 유형은 타인에게뿐 아니라 자기 자신에게도 매우 위험할 수 있다!'
$Храбрая = ' 당신 노예는 자신의 두려움을 쉽게 극복할 수 있다. 물론 여전히 공포를 이용해 영향을 줄 수는 있지만, 그녀는 보통 노예들보다 훨씬 용감하므로 고문으로 꺾기는 쉽지 않을 것이다.'
$Трусиха = ' 당신 노예는 진짜 겁쟁이인 것 같다. 조금만 압박해도 곧바로 굴복할 준비가 되어 있다. 가벼운 처벌만으로도 그녀의 저항 의지를 빨리 꺾고 당신 뜻을 밀어붙일 수 있을 것이다.'
$Мощный_метаболизм = ' 당신 노예의 신진대사는 믿을 수 없을 만큼 효율적이다. 먹고 싶은 걸 다 먹어도 살이 안 찌는 것 같다. 그러니 식단에 대해 덜 신경 써도 된다.'
$Хороший_метаболизм = ' 당신 노예는 신진대사가 아주 좋다. 대부분의 사람보다 살이 훨씬 천천히 찌므로 식단을 조금 느슨하게 관리해도 된다. 편리한 일이다.'
$Ослабленный_метаболизм = ' 시간이 지나면서 당신은 당신 노예가 신진대사에 문제가 있다는 걸 깨닫는다. 다른 이들보다 쉽게 살이 찌므로 식단에 특별한 주의가 필요하다.'
$Слабый_метаболизм = ' 당신 노예의 신진대사는 심하게 망가져 있다. 빵 하나만 더 먹어도 체중계에는 바로 지방이 늘어난 수치가 찍힌다. 식단을 아주 세심하게 관리해야 한다.'
$Спортивная = ' 당신 노예는 매우 활동적이고 운동에서 큰 즐거움을 얻는다. 훌륭한 몸 상태로 만드는 일은 어렵지 않을 것이다.'
$Апатичная = ' 당신 노예는 운동을 좋아하지 않고, 스스로를 밀어붙이지도 않는다. 제대로 된 몸 상태로 만들기가 어려울 것이다.'
$оратор = ' 당신 노예는 자기 표현에 재능을 보인다. 예절과 수사학을 키우는 일은 쉬울 것이고, 이는 분명 반가운 소식이다!'
$питомец = ' 보아하니 당신 노예는 애완동물 흉내 내는 걸 정말 좋아한다. 그리고 무엇보다도, 그걸 아주 잘한다. 훈련은 잘 진행될 것이다!'
$Brony = ' 보아하니 당신 노예는 말이 되는 걸 좋아한다. 남들이 굴욕적이고 힘들다고 여길 일을, 그녀는 즐겁고 흥미롭게 여긴다.'
$Indolent = ' 당신 노예는 몸도 머리도 쓰기 싫어하고, 그저 빈둥거리길 좋아한다. 어쩌면 젖소로 바꾸기가 더 쉬울지도 모르겠다?'
$медсестра = ' 당신 노예는 의학 쪽에서 눈에 띄는 능력을 보인다. 훌륭한 간호사로 키워 내기 쉬울 것이다!'
$горничная = ' 당신 노예는 집안의 질서를 유지하는 데 큰 즐거움을 느끼는 것 같다. 이 점 덕분에 훌륭한 하녀가 될 수 있을 것이다!'
$кухарка = ' 당신 노예는 분명 요리에 재능이 있다. 요리하는 걸 즐기고, 난로 앞에서 이것저것 만지작거리는 걸 분명 재미있어한다.'
$воительница = ' 당신 노예는 타고난 전사다! 전투 기술을 키우는 일은 쉬울 것이고, 이런 능력은 수요도 아주 많다.'
$чародейка = ' 당신 노예는 믿기 힘든 마법 재능을 드러냈다. 훌륭한 마녀나 연금술사가 될 것이다.'
$певица = ' 당신 노예는 그림 그리는 걸 좋아할 뿐 아니라, 머릿속에 떠오른 것을 그대로 재현하는 데도 대단한 재능이 있다. 위대한 화가로 훈련시키기 쉬울 것이다!'
$музыкантка = ' 당신 노예는 절대음감을 지녔다. 이것은 악기 연주를 배울 때 엄청난 도움이 될 것이다. 그녀의 음악적 재능을 키우는 데 특별한 주의를 기울여야 한다.'
$танцовщица = ' 당신 노예는 춤에 분명한 재능이 있다. 음악을 깊이 느끼고, 춤동작을 순식간에 따라 하며, 쉽게 즉흥적으로 움직이고 자기만의 스타일과 안무까지 만들어 낸다.'
$секретарша = ' 당신 노예는 개인 조수로서 탁월한 감각을 지닌 것 같다 - 차분하고, 세심하며, 서류 작업도 쉽게 해낸다. 이 재능을 최대한 활용해야 한다!'
$Эйдетическая_память = ' 보아하니 당신 노예는 완벽한 기억력을 지녔다. 책의 한 페이지 전체를 통째로 외워 인용할 수 있다. 이미 배운 것을 잊는 일은 거의 없을 것이다.'
$Забывчивая = ' 당신 노예 머릿속은 완전히 엉망인 것 같다. 하루 전 들은 말조차 끊임없이 잊어버린다. 수업을 중단하기만 하면 기술이 놀라울 만큼 빠르게 사라진다.'
$Дисциплинированная = ' 보아하니 당신 노예는 엄격한 규율에 익숙하고, 자기 욕망을 무시한 채 복종할 준비가 되어 있다. 노예에게는 분명 유용한 특성이다.'
$Своенравная = ' 규율은 분명 당신 노예의 강점이 아니다. 정리도 안 되어 있고, 언제나 제멋대로 행동한다. 늘 막대기 들고 머리 위에 서 있어야 한다.'
$Мания_величия = ' 당신 노예는 분명 자기 장점을 과대평가하고, 자기 가치를 지나치게 확신한다. 하지만 밝은 면도 있다: 별것 아닌 공에도 큰 보상을 줘도, 그녀를 버릇없게 만들 걱정은 덜해도 된다.'
$Комплекс_вины = ' 당신 노예는 끊임없이 죄책감을 느끼며, 어떤 실수에도 몹시 괴로워한다. 이렇게 자존감이 낮으니 사소한 잘못에도 자신이 심한 벌을 받아 마땅하다고 여긴다.'
$Милосердная = ' 당신은 당신 노예가 다른 사람의 고통을 함께 느낀다는 걸 이해한다. 이건 그녀를 통제하는 데 이용할 수 있다!'
$Садистка = ' 당신 노예는 분명 다른 사람의 고통을 보는 걸 즐기고, 어쩌면 그 과정에 직접 끼는 것도 싫어하지 않을 것이다. 안타깝게도 이는 당신의 영향 수단을 좁힌다.'
$NaturalGrace = ' 당신 노예는 움직임과 몸짓이 매끄럽고 유연하며 자연스럽고 아름답다. 그녀가 무엇을 하든 그 안에는 타고난 매력과 아름다움이 있다.'
$Klutzy = ' 당신 노예는 움직임과 몸짓이 서툴고 부조화롭다. 우아한 움직임이 필요한 활동을 시키면 큰 난관이 될 것이다.'
$Dexterity = ' 당신 노예는 손가락이 매우 민첩하다. 빠르고 정확하게 움직일 수 있다. 예술적인 활동을 시킨다면 이 재능은 큰 선물이 될 것이다.'
$Clumsy = ' 당신 노예는 손이 매우 서툴다. 예술적인 활동을 시키면 이것이 큰 장애물이 될 것이다.'

