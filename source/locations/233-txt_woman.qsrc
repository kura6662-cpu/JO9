$shame_torture_reaction['docile'] = $shame_torture_reaction['soft']

$exhibition_walk_description = '  당신은 노예를 데리고 도시에서 가장 붐비는 거리들을 지나가며, 가끔 멈춰 서서는 관심 있는 행인들에게 가장 내밀한 부위를 보여 주도록 강요한다.'
$exhibition_podium_description = '  당신은 잡파와 합의를 본다: 그는 그녀를 벌거벗고 사슬에 묶인 채로 한 시간 정도 전시해 둘 것이다. 물론 실제로 팔리지는 않겠지만, 관심의 중심이 된 채 노출되는 경험은 자신의 처지를 다시 상기시켜 줄 것이다.'
$body_art_description = '  당신은 벌거벗은 노예를 중앙 포럼으로 데려가, 누구든 그녀의 <<$slave_body_txt[slave["age"]]>> 몸 위에 글을 쓰거나 그림을 그리게 허락한다. 원하는 만큼 만져도 좋다. 이 벌은 꽤 인기가 많아서, 그녀 옆에도 똑같이 칠해진 다른 여자들이 서 있다.'
$common_use_description = '  당신은 시장 경비병들에게 당신의<<$slave_virgin7_txt[slave["virginity"]]>> 노예를 넘긴다. 그들은 그녀를 벗긴 뒤 족쇄틀에 가두고, 공용으로 사용할 수 있도록 내버려 둔다.<br>' + _
'늙은이들, 젊은 소년들, 점심시간의 악취 나는 노동자들; 그들은 공짜 입과 보지와 똥구멍을 이용하려고 몰려든다. 한 시간 뒤 그녀를 데리러 오면,<<$slave_virgin8_txt[slave["virginity"]]>> 정액이 그 <<$slave_noun1[slave["age"]]>>의<<$slave_fat_txt[slave["fat"]]>> 허벅지를 타고 쏟아지고 있다.<br>' + _
'  <<$slave_virgin3_txt[slave["virginity"]]>>'
$common_toilet_description = '  1 스파크를 받고, 당신은 이빨 빠진 늙은이가 운영하는 유료 공중화장실에 그<<$slave_body7_txt[slave["age"]]>> 노예를 빌려 준다. 악취 나는 이 오두막 안에서 그녀는 무릎을 꿇은 채, 두 손을 낮게 뒤로 돌려 벽에 사슬로 묶인다.<br>' + _
'"요즘은, 노예 소녀가 배관이랑 화장지보다 더 싸다우, 영주님. 그리구 대부분의 신사 양반들은 소변기보단 부드러운 입술을 더 좋아하지. 더 개인적이거든, 안 그류? 그리구 부드러운 혀는? 휴지보다 더 잘 닦인다우, 영주님, 휴지보다 더."'
if dogortoilet = 1: $common_toilet_description = '  당신은 자기<<$slave_virgin7_txt[slave["virginity"]]>> 노예를 시장 경비들에게 넘긴다. 그들은 그녀의 옷을 벗기고 족쇄대에 가둔 뒤, 동네 개들이 그녀를 올라타게 한다. 여기에 익숙한 그 잡종들은 차례가 누구냐를 두고 서로 으르렁거리며 물어뜯는다. 군중은 웃고 환호한다. 그 뒤, 그 <<$slave_noun1[slave["age"]]>>는 개 정액이 허벅지를 타고 흐르는 채 반 시간 동안 갇혀 있게 된다.<br>' + _
'  <<$slave_virgin3_txt[slave["virginity"]]>>'

!CONDITIONS AND RULES
$slave_sleep_condition[1] = '  감옥 - 아주 작고 어두운 방이다. 눕는 것도, 몸을 완전히 펴는 것도 불가능하다. 이 감방에서 보내는 하룻밤은 저항 의지를 꺾을 수 있지만, 건강도 해칠 수 있고, 나쁜 꿈은 말할 것도 없다. 폐소공포증이 있는 사람에게는 특히 강하게 작용한다.'
$slave_sleep_condition[2] = '  당신은 편안함은 벌어야 하는 것임을 보여 주기 위해 노예에게서 침낭을 빼앗았다. 차갑고 딱딱한 바닥에서 보내는 밤은 휴식에도 건강에도 좋지 않지만, <<$slave_name>>는 분명 조금 더 순종적으로 될 것이다.'
!TODO: But if she does not feel guilty, it may drive her into depression.
$slave_sleep_condition[3] = '  노예가 바닥 위 딱딱한 침낭에서 자는 건 흔한 일이다. 작고 따뜻한 담요와 쌀겨를 채운 쿠션이 밤에 그녀를 따뜻하게 해 주고 그럭저럭 잠들게 해 주긴 하겠지만, 전혀 편안하진 않다.'
$slave_sleep_condition[4] = '  특별한 장려책으로, 당신의 노예는 주인과 같은 침대에서 잘 수 있도록 허락될 수 있다. 이건 그녀를 더 깊고 편안하게 자게 해 줄 것이다. 주인과 함께 자는 것은 복종적이고 헌신적인 노예에게는 큰 행복의 원천이지만, 훈련이 부족하거나 기분이 나쁜 소녀는 전혀 기뻐하지 않을 것이다.'
if is_perv ! 0 and slave['age'] = CONST_INT['loli_age']: $slave_sleep_condition[4] += '<br><b>  더러운 늙은이들은 침대에<<$little_txt>> 여자들을 두는 걸 <i>사랑한다</i>.</b>'
$slave_sleep_condition[5] = '  자기만의 푹신한 침대에서 자는 것 - 어떤 노예에게도 최고의 사치다. 이 침대는 매우 푹신하고 편안하다. 이런 생활 환경은 그녀를 더 깊이 자게 하고 기분도 상당히 개선해 줄 것이다. 동시에 그녀가 더 독립적으로 느끼게 만들 수도 있다. 훌륭한 복종과 적당한 헌신에 대한 보상으로만 써야 한다. 그렇지 않으면 노예를 응석받이로 만들 위험이 있다.'
$slave_sleep_condition[6] = ' 조수가 주인과 같은 침대에서 자는 것은 주인에게서 받을 수 있는 최고 수준의 인정과 신뢰의 표시다. 다만, 이미 노예에게 당신 침대를 같이 쓰라고 명령했다면, 그녀는 자기 깔개로 가야 한다는 점을 기억하라.'
$assistant_rape_abort = '    당신은 조수가 노예를 강간하는 것을 금지했다.'
$assistant_rape = '   당신은 조수가 노예와 마음껏 즐기도록 허가했다.'
