	end

	if assistant["stamina"] < 0:
		func('$menu', 'exec', $menu_item_A_Cowbreeding_gray, empty, '불가 : 젖소녀 조련', '<<$assistant_name>> 몸이 약해서 <<$slave_name>> 를 가르칠 수 없다.')
	elseif slave['stamina'] < 2:
