    FUNC('$menu', 'exec', $menu_item_Vulnus_sanare_gray, empty, '불누스 사나레', '스파크가 부족합니다')
  ELSEIF spell_Vulnus_sanare = 1:
    FUNC('$menu', 'exec', $menu_item_Vulnus_sanare_gray, empty, '불누스 사나레', '이 주문은 하루에 한 번 넘게 시전할 수 없습니다')
  ELSEIF npc_progress['Jinn'] < 2:
    FUNC('$menu', 'exec', $menu_item_Vulnus_sanare_gray, empty, '불누스 사나레', '당신은 이 주문을 모른다')
  END
  IF master_mage >= 3 and spell_Vulnus_sanare = 0 and (slave_state = CONST_INT['slave_exist'] and npc_progress['Jinn'] = 2) and sparks >= 150:
    FUNC('$menu', 'goto', $menu_item_Vulnus_sanare, menu_Vulnus_sanare_full, 'interaction', 'interaction', '불누스 사나레 맥시마(150$)', '문신을 새기고 처녀성을 복원한다')
  ELSEIF slave_state = CONST_INT['no_slave']:
    FUNC('$menu', 'exec', $menu_item_Vulnus_sanare_gray, empty, '불누스 사나레 맥시마', '불누스 사나레를 시전할 노예가 없다')
  ELSEIF slave_state = CONST_INT['slave_faint']:
    FUNC('$menu', 'exec', $menu_item_Vulnus_sanare_gray, empty, '불누스 사나레 맥시마', '<<$slave_name>>은 의식을 잃었다')
  ELSEIF sparks < 150:
    FUNC('$menu', 'exec', $menu_item_Vulnus_sanare_gray, empty, '불누스 사나레 맥시마', '스파크가 부족합니다')
  ELSEIF spell_Vulnus_sanare = 1:
    FUNC('$menu', 'exec', $menu_item_Vulnus_sanare_gray, empty, '불누스 사나레 맥시마', '이 주문은 하루에 한 번 넘게 시전할 수 없습니다')
  ELSEIF master_mage < 3:
    FUNC('$menu', 'exec', $menu_item_Vulnus_sanare_gray, empty, '불누스 사나레 맥시마', '이것을 시전하기에는 당신의 마법 실력이 부족하다')
  ELSEIF npc_progress['Jinn'] < 2:
    FUNC('$menu', 'exec', $menu_item_Vulnus_sanare_gray, empty, '불누스 사나레 맥시마', '당신은 이 주문을 모른다')
  END
  FUNC('$menu', '===END===')
END


