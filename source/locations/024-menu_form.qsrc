!main menu - Slave activities - Reward - Give free time
full_day = slave["stamina"] - 1
if full_day < 1: full_day = 1

if menu_form = 152:
! JO9 MOD START J9M2735 | 2026-10-10_restore_private_room_ui | changed block; context may be included
	if nsfw = 0 and snk_room_target = 0: $text_display += func('display_fullimage', 'slave', 'center_image_home')
! JO9 MOD END J9M2735

	func('$menu', '===BEGIN===', 'column_0')

	if slave['energy'] >= 1:
		func('$menu', 'goto', $menu_item_hour_rest, menu_hour_rest, 'interaction', 'interaction', '한 시간 휴식', '<<$slave_name>> 한 시간 쯤 쉬게 둔다. (1단계, 행동력 0/-1)')
	else
		func('$menu', 'exec', $menu_item_hour_rest_gray, empty, '한 시간 휴식', '<<$slave_name>>, 이미 잘 준비를 했다.')
	end
	if slave['energy'] >= 1 and boardgames >= 0:
		func('$menu', 'goto', $menu_item_hour_fun, menu_hour_fun, 'interaction', 'interaction', '한 시간 놀이', '<<$slave_name>> 한 시간 쯤 놀게 둔다. (1단계, 행동력 0/-1)')
	else
		func('$menu', 'exec', $menu_item_hour_fun_gray, empty, '한 시간 놀이', '<<$slave_name>> 체력이 부족해서 할 수 없다.')
	end
	if (slave['energy'] - slave['half_action']/2) >= 2:
		func('$menu', 'goto', $menu_item_day_rest, menu_day_rest, 'interaction', 'interaction', '밤까지 휴식', '<<$slave_name>> 밤까지 쉬게 둔다. (2단계, 0/행동력 전부 보존)')
	else
		func('$menu', 'exec', $menu_item_day_rest_gray, empty, '밤까지 휴식.', '<<$slave_name>> 체력이 부족해서 할 수 없다.')
	end
	if (slave['energy'] - slave['half_action']/2) >= 2 and boardgames >= 0:
