	func('$menu', '===BEGIN===', 'column_0')

	if bath > 0:
		func('$menu', 'goto', $menu_item_Washme, menu_Washme, 'interaction', 'interaction', '나를 목욕 시킨다', '<<$slave_name>>에게 나를 씻기게 한다')
	else
		func('$menu', 'exec', $menu_item_Washme_gray, empty, '혼욕 불가', $no_bath)
	end
	func('$menu', 'goto', $menu_item_Massage, menu_Massage, 'interaction', 'interaction', '나에게 안마를 시킨다', '<<$slave_name>>의 안마를 받아본다')
	func('$menu', 'menu_form', $menu_item_Entertain, menu_Entertain, '나를 즐겁게 하게 한다', '<<$slave_name>>로 즐겨본다')

	if master_excitement >= 0:
		func('$menu', 'goto', $menu_item_slave_Relaxed_Vaginal_sex, menu_slave_Relaxed_Vaginal_sex, 'interaction', 'interaction', '편안한 섹스', '느긋히 <<$slave_name>>의 음부에 넣는다')
		func('$menu', 'goto', $menu_item_slave_Relaxed_Anal_sex, menu_slave_Relaxed_Anal_sex, 'interaction', 'interaction', '편안한 항문 섹스', '느긋히 <<$slave_name>>의 항문에 넣는다')
		func('$menu', 'goto', $menu_item_slave_Relaxed_Oral_sex, menu_slave_Relaxed_Oral_sex, 'interaction', 'interaction', '편안한 구강 섹스', '느긋히 <<$slave_name>>의  구강에 넣는다')
		func('$menu', 'goto', $menu_item_slave_Active_sex, menu_slave_Active_sex, 'interaction', 'interaction', '직접 섹스한다', '<<$slave_name>>와 직접 조작으로 섹스한다')

		if assistant_state = CONST_INT['slave_exist'] and slave_state = CONST_INT['slave_exist'] and assistant['energy'] > -2 and slave['energy'] > -2:
			func('$menu', 'goto', $menu_item_Threesome, menu_Threesome, 'interaction', 'interaction', '쓰리섬', '<<$slave_name>> 및 <<$assistant_name>>와 쓰리섬을 한다')
		elseif assistant_state ! CONST_INT['slave_exist'] and slave_state = CONST_INT['slave_exist'] and slave['energy'] > -2 and sparks > 0:
			!check assistant ! exist instead of = no_slave to allow this interaction when assistant is fainted or dead - ImperatorAugustus
			func('$menu', 'goto', $menu_item_Threesome, menu_Threesome_noassistant, 'interaction', 'interaction', '쓰리섬 (1$)', '<<$slave_name>>와 집 밖의 다른 한 명과 쓰리섬을 한다')
		elseif slave['energy'] <= -2:
			func('$menu', 'exec', $menu_item_Threesome_gray, empty, '쓰리섬', $text_exhausted)
		elseif sparks < 1:
			func('$menu', 'exec', $menu_item_Threesome_gray, empty, '쓰리섬', '창녀를 고용할 돈이 없습니다')
		end
	else
		func('$menu', 'exec', $menu_item_slave_Relaxed_Vaginal_sex_gray, empty, '삽입 불가', '성기의 힘이 부족하다.')
		func('$menu', 'exec', $menu_item_slave_Relaxed_Anal_sex_gray, empty, '삽입 불가', '성기의 힘이 부족하다.')
