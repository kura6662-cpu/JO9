	end

	func('$menu', '===END===')
	$text_display += '<br><div id="Back_Musical_instruments"><a style="padding-top: 75px;" class="icon tooltip-right" tooltip-data="뒤로" href = "EXEC: menu_form = 0 & gt ''menu_form''"><img src = "content\pic\ui overhaul\back.png"></a></div>'
	$text_display += '<br><div id="Cancel_Musical_instruments"><a style="padding-top: 75px;" class="icon tooltip-right" tooltip-data="취소" href = "EXEC: menu_form = 0 & gt ''menu_form''"><img src = "content\pic\ui overhaul\cancel.png"></a></div>'
end

! JO9 MOD START SLAVE_EDITOR_LAYOUT | 2026-10-17_editor_alignment
! 편집기 여섯 페이지에만 배치용 CSS 범위를 추가한다. 기존 링크·증감 조건은 유지한다.
! JO9 MOD START TRAITS_EDITOR_LAYOUT | 2026-10-17_traits_batch
if menu_form >= 2101 and menu_form <= 2107:
! JO9 MOD END TRAITS_EDITOR_LAYOUT
	$setting_display = '<div class="jo9-slave-editor">' + $setting_display + '</div>'
	$setting_display_r = '<div class="jo9-slave-editor">' + $setting_display_r + '</div>'
	$setting_display_c = '<div class="jo9-editor-nav">' + $setting_display_c + '</div>'
	$setting_display_c2 = '<div class="jo9-editor-nav">' + $setting_display_c2 + '</div>'
end
! JO9 MOD END SLAVE_EDITOR_LAYOUT

! JO9 MOD START CHEAT_MASTER_LAYOUT | 2026-10-17_zzz_cheat_master_layout
! 두 화면에 배치 클래스만 추가한다. 주인 편집기는 기존 편집기 스타일을 공유한다.
if menu_form = 2100:
	$setting_display = '<div class="jo9-cheat-menu jo9-editor-nav">' + $setting_display + '</div>'
	$setting_display_r = '<div class="jo9-cheat-menu jo9-editor-nav">' + $setting_display_r + '</div>'
end
if menu_form = 2110:
	$setting_display = '<div class="jo9-slave-editor jo9-master-editor">' + $setting_display + '</div>'
	$setting_display_r = '<div class="jo9-slave-editor jo9-master-editor">' + $setting_display_r + '</div>'
end
if menu_form = 2100 or menu_form = 2110:
	$setting_display_c = '<div class="jo9-editor-nav">' + $setting_display_c + '</div>'
	$setting_display_c2 = '<div class="jo9-editor-nav">' + $setting_display_c2 + '</div>'
end
! JO9 MOD END CHEAT_MASTER_LAYOUT

gt 'main_screen'

