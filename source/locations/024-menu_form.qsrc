!transition to the market by clicking on the slave slot if she does not exist
if menu_form = 3000:
	$text_display += '<div id="slavemarket_text">노예가 없습니다!<br>노예 시장으로 갈까요?</div>'

	func('$menu', '===BEGIN_H_MENU===', 'slavemarket')
	func('$menu', 'empty_item', 3)

	func('$menu', 'exec_options', $menu_item_go_market_yes, 'dynamic $transport_energy_drop, "white_house" & menu_form = 0 & city_form = 11 & txt = 1 & gt "slave_auction_buy"', '예')
	func('$menu', 'exec_options', $menu_item_go_market_no, 'menu_form = 0 & gt "menu_form"', '아니오')
	func('$menu', '===END===')
	!fixed NO option (gt ''menu_form'' did not work, gt "menu_form" does) - ImperatorAugustus
end

!Menu for the Barn - arrived here via main menu > domestic issues > business > the barn
if menu_form = 3001:
	if nsfw = 0 and farmhand_state = CONST_INT['slave_exist']: $text_display += func('display_fullimage', 'farmhand', 'center_image_home')
	!Farmhand
	func('$menu', '===BEGIN===', 'column_0')
	if barn_report_available = 0:
		func('$menu', 'exec_options', $menu_item_barn_accounts_gray, empty, '장부 : 외양간 장부 확인 불가', '아직은 장부를 볼 수 없다.')
	else
		func('$menu', 'exec_options', $menu_item_barn_accounts, 'msg $barn_accounts', '장부 : 외양간 장부 확인', '외양간 장부를 본다.')
	end
	if farmhand_state = CONST_INT['no_slave']:
		if slave_state ! CONST_INT['no_slave'] and slave['moral'] >= 3 and slave['nurse'] > 2 and slave['secretary'] > 2:
			func('$menu', 'exec', $menu_item_farmhand, 'dynamic $swap_slave_instances, ''slave'', ''farmhand'' & slave[''half_action''] += 1 & gt $curloc','노예 ⇒ 지기','<<$slave_name>>(을)를 외양간 지기로 만든다')
		elseif slave_state ! CONST_INT['no_slave']:
			func('$menu', 'exec', $menu_item_farmhand_gray, empty,'노예 ⇒ 외양간 지기 불가','조건을 만족하지 않는다.')
		else
			func('$menu', 'exec', $menu_item_farmhand_gray, empty,'노예 ⇒ 외양간 지기 불가','노예가 없다.')
		end
	else
		if slave_state = CONST_INT['no_slave']:
			func('$menu', 'goto', $menu_item_retfarmhand, menu_retfarmhand, 'interaction', 'interaction', '지기 ⇒ 노예', '외양간지기를 복귀시킨다.')
			if cow_state = CONST_INT['slave_exist'] and farmhand_state = CONST_INT['slave_exist']:
				func('$menu', 'interaction', $menu_item_farmhand_milking, menu_farmhand_milking, '지기 : 지금은 젖을 짤 수 없다.')
			elseif cow_state = CONST_INT['slave_faint']:
				func('$menu', 'exec', $menu_item_farmhand_milking_gray, empty, '지기 : 착유 지시 불가', '소의 의식이 없다.')
			elseif farmhand_state ! CONST_INT['slave_exist']:
				func('$menu', 'exec', $menu_item_farmhand_milking_gray, empty, '지기 : 착유 지시 불가', '외양간지기가 필요하다.')
			end
		else
			func('$menu', 'exec', $menu_item_retfarmhand_gray, empty, '지기 ⇒ 노예', '데려올 자리가 없다.')
			if cow_state = CONST_INT['slave_exist'] and farmhand_state = CONST_INT['slave_exist']:
				func('$menu', 'interaction', $menu_item_farmhand_milking, menu_farmhand_milking, '지기 : 지금은 젖을 짤 수 없다.')
			elseif cow_state = CONST_INT['slave_faint']:
				func('$menu', 'exec', $menu_item_farmhand_milking_gray, empty, '지기 : 착유 지시 불가', '소의 의식이 없다.')
			elseif farmhand_state ! CONST_INT['slave_exist']:
				func('$menu', 'exec', $menu_item_farmhand_milking_gray, empty, '지기 : 착유 지시 불가', '외양간지기가 필요하다.')
			end
		end
		if barn_farmhand_fattens = 0:
			func('$menu', 'goto', $menu_item_Fatten, menu_Fatten, 'interaction', 'interaction', '지기 : 닭 증량', '산란량이 증가할것이다.')
		else
			func('$menu', 'goto', $menu_item_stopFatten, menu_stopFatten, 'interaction', 'interaction', '지기 : 닭 증량 중지', '닭을 그만 찌울 것이다.')
		end
		if barn_farmhand_slaughters = 0:
			func('$menu', 'goto', $menu_item_slaughter, menu_slaughter, 'interaction', 'interaction', '지기 : 돼지 도축', '돼지를 알아서 도축할것이다.')
		else
			func('$menu', 'goto', $menu_item_stopslaughter, menu_stopslaughter, 'interaction', 'interaction', '지기 : 돼지 도축 중지', '돼지 도축을 중지할 것이다.')
		end
		if barn_farmhand_prison = 0 and dungeon = 1:
			func('$menu', 'goto', $menu_item_RetPig, menu_pigprison, 'interaction', 'interaction', '지기 : 돼지 강제수용', '돼지가 없으면 죄수를 데려와서 돼지로 만든다.')
		else
			func('$menu', 'goto', $menu_item_RetPig, menu_stoppigprison, 'interaction', 'interaction', '지기 : 돼지 강제수용 중지', '지하실에서 돼지 강제수용 중지')
		end
	end
	if cow_state = CONST_INT['no_slave'] and slave_state ! CONST_INT['no_slave']: 
		if slave['lactation'] ! 0:
			func('$menu', 'exec_options', $menu_item_Cow, 'interaction = 0 & gs "slave_to_cow" & cow["half_action"] += 1 & gt $curloc', '노예 ⇒ 외양간 젖소', '젖소로 만들기')
		elseif slave['lactation'] = 0:
			func('$menu', 'exec', $menu_item_Cow_gray, empty, '노예 ⇒ 젖소 불가', '과정을 거쳐야만 소로 만들수가 있다.')
		else 
			func('$menu', 'exec', $menu_item_Cow_gray, empty, '노예 ⇒ 젖소 불가', '노예가 없다.')
		end
	else
		if slave_state = CONST_INT['no_slave']:
			func('$menu', 'exec_options', $menu_item_retCow, 'interaction = 0 & gs "slave_to_cow" & gt $curloc', '젖소 ⇒ 노예', '외양간 젖소를 복귀시킨다.')
		else
			func('$menu', 'exec', $menu_item_retCow_gray, empty, '젖소 ⇒ 노예 불가', '데려올 자리가 없다.')
		end
	end
	if slave_state ! CONST_INT['no_slave']:
		func('$menu', 'goto', $menu_item_Pig, menu_pig1, 'interaction', 'interaction', '노예 ⇒ 돼지', '노예 : 돼지로 사육')
	elseif pig_state ! CONST_INT['no_slave'] and slave_state = CONST_INT['no_slave']:
		func('$menu', 'goto', $menu_item_RetPig, menu_retpig, 'interaction', 'interaction', '돼지 ⇒ 노예', '돼지를 집으로 복귀시킨다.')
	else
		func('$menu', 'exec', $menu_item_Pig_gray, empty, '노예 ⇒ 돼지 불가', '노예가 없다.')
	end
	if harpy_state = CONST_INT['no_slave']:
		if slave_state ! CONST_INT['no_slave'] and slave['fertility_revealed'] ! 0:
			func('$menu', 'goto', $menu_item_Harpy, menu_harpy, 'interaction', 'interaction', '노예 ⇒ 닭', '외양간 닭으로 만든다.')
		else
			func('$menu', 'exec', $menu_item_Harpy_gray, empty, '노예 ⇒ 닭 불가', '노예가 없다.')
		end
	else
		if slave_state = CONST_INT['no_slave']:
			func('$menu', 'goto', $menu_item_RetHarpy, menu_retharpy, 'interaction', 'interaction', '닭 복귀', '닭 집으로 복귀시킨다.')
		else
			func('$menu', 'exec', $menu_item_RetHarpy_gray, empty, '닭 ⇒ 노예 불가', '데려올 자리가 없다.')
		end
	end
	func('$menu', 'goto', $menu_item_barntut, menu_barntut, 'interaction', 'interaction', '외양간 설명', '외양간 설명')
	func('$menu', 'goto', $menu_item_barntut, menu_barntut, 'interaction', 'interaction', '어떻게 작동하나요?', '어떻게 작동하나요?')

	func('$menu', '===END===')
	$text_display += '<br><div id="Back_thebarn"><a style="padding-top: 75px;" class="icon tooltip-right" tooltip-data="뒤로" href = "EXEC: menu_form = 3 & gt ''menu_form''"><img src = "content\pic\ui overhaul\back.png"></a></div>'
	$text_display += '<br><div id="Cancel_thebarn"><a style="padding-top: 75px;" class="icon tooltip-right" tooltip-data="취소" href = "EXEC: menu_form = 0 & gt ''menu_form''"><img src = "content\pic\ui overhaul\cancel.png"></a></div>'
end

!신규 컨텐츠
!Main menu - Take care of the slave being educated - Talk - Socialize
IF menu_form = 900:
! JO9 MOD START J9M2717 | 2026-10-10_restore_private_room_ui | changed block; context may be included
  if nsfw = 0 and snk_room_target = 0: $text_display += func('display_fullimage', 'slave', 'center_image_home')
! JO9 MOD END J9M2717
  FUNC('$menu', '===BEGIN===', 'column_0')
  if assistant_state = CONST_INT['slave_exist']:
    if slave['isolate'] > 0: 
      FUNC('$menu', 'goto', $menu_item_isolate_slave, 941, 'interaction', 'interaction', '의사소통 허용', '노예와 조수가 자유롭게 의사소통하도록 허용한다.')
    else  
      FUNC('$menu', 'goto', $menu_item_isolate_slave, 941, 'interaction', 'interaction', '의사소통 제한', '당신이 명령할 때를 제외하고는 의사소통을 금지한다.')
    end
    if slave['smear'] = 5: 
      FUNC('$menu', 'exec', $menu_item_smear_slave_gray, empty, '거리 두게 하기', '상대가 없습니다.')
    else
      FUNC('$menu', 'goto', $menu_item_smear_slave, 942, 'interaction', 'interaction', '거리 두게 하기', '관계에 선을 긋게 한다.')
    end
    if slave['praise'] = 5: 
      FUNC('$menu', 'exec', $menu_item_praise_slave_gray, empty, '동정심 유도', '동정심을 유도할 대상이 없습니다.')  
    else
      FUNC('$menu', 'goto', $menu_item_praise_slave, 943, 'interaction', 'interaction', '동정심 유도', '서로에게 동정심을 느끼게 한다.')
    end  
    FUNC('$menu', 'menu_form', $menu_item_teambuilding, 944, '관계 개선', '노예와 조수의 관계를 개선한다.')
    FUNC('$menu', 'menu_form', $menu_item_provoke, 945, '이간질', '노예와 조수를 자극해 관계를 악화시킨다.')
  else
    FUNC('$menu', 'exec', $menu_item_Explain_position_gray, empty, '의사소통 제한', '의사소통을 제한할 대상이 없습니다.')
    FUNC('$menu', 'exec', $menu_item_Explain_position_gray, empty, '거리 두게 하기', '상대가 없습니다.')
    FUNC('$menu', 'exec', $menu_item_Explain_position_gray, empty, '동정심 유도', '동정심을 유도할 대상이 없습니다.')
    FUNC('$menu', 'exec', $menu_item_Explain_position_gray, empty, '관계 개선', '관계를 개선할 대상이 없습니다.')
    FUNC('$menu', 'exec', $menu_item_Explain_position_gray, empty, '이간질', '이간질할 대상이 없습니다.')
