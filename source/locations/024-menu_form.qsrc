# menu_form
! Readable view; authoritative fields are in ../locations.json.
ui_style = 2
! JO9_SINGLE_GRIMDARK_UI_20261014
! JO9 MOD START J9M2805 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'menu_form': gs 'snk_room_bridge', 'guard', 'menu_form'
if $snk_master_return ! '': gs 'snk_room_bridge', 'master_close'
! JO9 MOD END J9M2805
!main menu
if day < 1:
	gt 'main_menu' &! intercept ESC keyboard shortcut when not in game mode (e.g. before game start or after game over)
elseif get_weapon = 1:
	gt 'shop_general' &! intercept ESC keyboard shortcut when choosing weapons before starting combat
elseif get_weapon = 2 and ($fight_return ! '' or colosseum_fight ! 0):
	! intercept ESC keyboard shortcut during combat
	if $итог_боя ! '':
		gt 'конец_боя' &! combat ended screen
	else
		gt 'боевой_интерфейс' &! combat screen
	end
elseif exam_in_progress = 1:
	gt 'demo_menu_form' &! intercept ESC keyboard shortcut during tutorial (combat intercept check should come first)
elseif $place = 'slave_stage' and slave_state = CONST_INT['no_slave']:
	gt 'slave_auction_buy' &! intercept ESC keyboard shortcut during market auction
elseif $place = 'chariot_race':
	gt 'ride_interface' &! intercept ESC keyboard shortcut during chariot race
elseif is_home = 0 and city_form ! 0:
	! pressing ESC while out and not in the city districts screen takes you back to the last city form you were in
	killobj &! remove any stray objects
	gt 'city_menu_form'
elseif is_home = 0:
	!check for an event when returning home (added here to catch players who never walk outside their home, also checked at the end of city_menu_form for players who do walk) - ImperatorAugustus)
	gs '$city_random_event', 'home'
	is_home = 1
	city_form = estate_location[$estate]
	if sound_on = 1: play 'content/snd/door.wav'
end

if city_district ! -1:
	city_district = -1 &! clear last visited district so fast travel from home to that district or any other will deduct energy unless it is the home district
	menu_form = 0 &! close any open menus and redraw home interior background
end
killobj &! remove any left-over clickable objects (usually arrows from a previous screen exited using ESC)
gs '$newloc' &! ensure all stats are updated before displaying them

!check for drug sound, all other sounds will be disabled except bulk sound
if bulk ! 1:
	!CLOSE ALL
else
	bulk = 0
end

dynamic $slave_pass_out
dynamic $prisoner_pass_out
dynamic $assistant_pass_out
dynamic $cow_pass_out
dynamic $master_pass_out &! master should be last
!knout and whip check
dynamic $toolsequipped


!Fix blank screen bug - crushboss
if slave_state ! CONST_INT['no_slave']:
	if $slave["wpn"] = '': $slave["wpn"] = 'безоружный'
	if $slave["armor"] = '': $slave["armor"] = 'без_брони'
	if $slave["cloth"] = '': $slave["cloth"] = 'голая'
end

!Fix blank screen bug - crushboss
if assistant_state ! CONST_INT['no_slave']:
	if $assistant["wpn"] = '': $assistant["wpn"] = 'безоружный'
	if $assistant["armor"] = '': $assistant["armor"] = 'без_брони'
	if $assistant["cloth"] = '': $assistant["cloth"] = 'голая'
end

!Variable reset
get_girl = 0
$info_text = ''
$text_display = ''
!option display
$setting_display = ''
$setting_display_c = ''
$setting_display_c2 = ''
$setting_display_r = ''
$return_lock  = 'menu_form'
sp_txt = 0

$text_feeble = '<<$slave_name>>의 체력이 부족해서 그 일은 시킬 수 없다.'

!gs '$moodlets_account' - no need to update mood every single time a menu is displayed or navigated, doing it in $newloc is sufficient - ImperatorAugustus
quest_description_mode = 0

if get_initial_slave = 1:
	$special_age = 'young'
	gs 'generate_stock'
	gs 'stock_to_slave'
end

!Testing Code - crushboss
if slave_state = CONST_INT['no_slave'] and cheat_j = 1: get_new_slave = 1

!Get new slave cheat - cheat_j - crushboss
if get_new_slave = 1 and slave_state = CONST_INT['no_slave'] and active[$quest[12]] = 0:
	get_new_slave = 0
	gs 'generate_stock'
	gs 'stock_to_slave_nogt'
end

if isabella_get = 1 and assistant_state = CONST_INT['no_slave']:
	isabella_get = 0
	gs 'get_special_assistant'
end

!Slave Equipped Armor, Weapons, and Cloth - crushboss
if (cheat_h = 1 or cheat_j = 1 or cheat_k = 1) and ($slave["wpn"] = '' or $slave["wpn"] = 'безоружный'): $slave["wpn"] = 'катана'
if (cheat_h = 1 or cheat_j = 1 or cheat_k = 1) and ($slave["armor"] = '' or $slave["armor"] = 'без_брони'): $slave["armor"] = 'плейт'
if (cheat_h = 1 or cheat_j = 1 or cheat_k = 1) and $slave["right_wpn"] = '': $slave["right_wpn"] = 'катана'
if (cheat_h = 1 or cheat_j = 1 or cheat_k = 1) and $slave["left_wpn"] = '': $slave["left_wpn"] = 'кинжал'
if (cheat_h = 1 or cheat_j = 1 or cheat_k = 1) and $slave["back_wpn"] = '': $slave["back_wpn"] = 'фламберг'
if (cheat_h = 1 or cheat_j = 1 or cheat_k = 1) and ($slave["cloth"] = '' or $slave["cloth"] = 'голая'): $slave["cloth"] = 'sun_dress'
!End of testing code - crushboss

!main menu
if menu_form = 0:
	if interior_num = 7 or interior_num = 0:
		$place = 'home_lux'
	else
		change_interior = 0
		gs 'interior_change'
	end
	func('$menu', '===BEGIN===', 'column_0')
	if slave_state = CONST_INT['slave_exist']:
		func('$menu', 'menu_form', $menu_item_slave_act, menu_slave_act, '노예 : 활동 지시',  '<<$slave_name>> 활동 지시')
	elseif slave_state = CONST_INT['no_slave']:
		func('$menu', 'exec', $menu_item_slave_act_gray, empty, '노예 : 없음', '노예가 없다.')
	elseif slave_state = CONST_INT['slave_faint']:
		func('$menu', 'menu_form', $menu_item_slave_act, menu_unconscious, '노예 : 활동 불가', '<<$slave_name>> 의식이 없다.')
	elseif slave_state = CONST_INT['slave_dead']:
		func('$menu', 'exec', $menu_item_slave_act_gray, empty, '노예 : 활동 불가', '<<$slave_name>> 이미 죽어있다.')
	end
	if slave_state = CONST_INT['slave_exist']:
		if slave['energy'] > -4:
			func('$menu', 'menu_form', $menu_item_slave_assig, menu_slave_assig, '노예 : 과제 할당',  '<<$slave_name>> 과제 할당')
		else
			func('$menu', 'menu_form', $menu_item_slave_assig, menu_slave_assig, '노예 : 활동 불가',  $text_exhausted)
		end
	elseif slave_state = CONST_INT['no_slave']:
		if assistant_state ! CONST_INT['no_slave']:
			func('$menu', 'goto', $menu_item_slave_assig_gray, empty, 'menu_form', 'slave_to_assistant', '노예 : 활동 불가', '노예가 없다.')
		else
			func('$menu', 'exec', $menu_item_slave_assig_gray, empty, '노예 : 없음', '노예가 없다.')
		end
	elseif slave_state = CONST_INT['slave_faint']:
		func('$menu', 'exec', $menu_item_slave_assig_gray, empty, '노예 : 활동 불가', '<<$slave_name>> 의식이 없다.')
	elseif slave_state = CONST_INT['slave_dead']:
		func('$menu', 'exec', $menu_item_slave_assig_gray, empty, '노예 : 활동 불가', '<<$slave_name>> 이미 죽어있다.')
	end
	if assistant_state = CONST_INT['slave_exist']:
		func('$menu', 'menu_form', $menu_item_assistant_assig, menu_assistant_assig, '조수 : 과제 할당',  '<<$assistant_name>> 활동 지시')
	elseif slave_state = CONST_INT['no_slave']:
		func('$menu', 'exec', $menu_item_appoint_gray, empty, '조수 : 없음',  '조수가 없다.')
	elseif slave_state = CONST_INT['slave_faint']:
		func('$menu', 'exec', $menu_item_appoint_gray, empty, '조수 : 활동 불가',  '<<$slave_name>> 의식이 없다.')
	elseif slave_state = CONST_INT['slave_dead']:
		func('$menu', 'exec', $menu_item_appoint_gray, empty, '조수 : 활동 불가',  '<<$slave_name>> 이미 죽어있다.')
	elseif slave_state = CONST_INT['slave_exist'] and slave["moral"] < 3:
		func('$menu', 'exec', $menu_item_appoint_gray, empty, '조수 : 활동 불가',  '<<$slave_name>>의 충성심이 부족하다.')
	elseif slave_state = CONST_INT['slave_exist'] and slave["moral"] >= 3:
		func('$menu', 'goto', $menu_item_appoint_gray, empty, 'menu_form', 'slave_to_assistant', '조수 : 없음', '조수가 없다.')
	end
	func('$menu', 'menu_form', $menu_item_domestic, menu_domestic, '주인 : 가업 및 회계',  '가업 및 회계')

	if sparks > 0:
		func('$menu', 'menu_form', $menu_item_cast_spell, menu_cast_spell, '주인 : 마법 목록',  '마법을 확인한다')
	else
		func('$menu', 'exec', $menu_item_cast_spell_gray, empty, '주인 : 마법 불가',  '스파크가 부족하다.')
	end
	if $estate = 'white_house' and kulaconstruct >= 1:
   	func('$menu', 'menu_form', $menu_item_Second_floor, menu_Second_floor, '2층으로', '2층으로 이동')
	end		

	!autosave
	if autosave_day = 1:
		func('$menu', 'exec_options', $menu_item_end_day, 'savegame "save/auto_day_end.sav" & gt "next_day"', '하루 종료', '하루를 끝낸다')
	else
		func('$menu', 'goto', $menu_item_end_day, next_day, 'menu_form', 'next_day', '하루 종료', '하루를 끝낸다')
	end

	func('$menu', '===END===')
	!$text_display += '<br><div id="under_gray">Калории: <<slave["calories"]>>/ Истощение: <<slave["starvation"]>> / жЫр <<slave_rate["fat"]>><br></div>'

	!if nsfw = 0 and (slave_type <= 2575 and slave_type >= 2573): $text_display += func('display_fullimage', 'slave', 'center_image_home') &! wilhelmine, helen and yasmin

end

!main menu - Slave activities
if menu_form = 1:
! JO9 MOD START J9M2804 | 2026-10-10_restore_private_room_ui | changed block; context may be included
	if nsfw = 0 and snk_room_target = 0: $text_display += func('display_fullimage', 'slave', 'center_image_home')
! JO9 MOD END J9M2804

	func('$menu', '===BEGIN===', 'column_0')

	func('$menu', 'menu_form', $menu_item_talk, menu_talk, '회화한다',  '<<$slave_name>>와 대화')

	if slave['energy'] > -4:
! JO9 MOD START J9M2803 | 2026-10-10_restore_private_room_ui | changed block; context may be included
! SNK_ROOM_SEX_BEGIN
if snk_room_target > 0 and master_excitement >= 0: func('$menu', 'exec', $menu_item_sex, 'gs ''snk_room_bridge'', ''room_sex''', '섹스한다', '기존 개인실 상호작용')
if snk_room_target > 0 and master_excitement < 0: func('$menu', 'exec', $menu_item_sex_gray, '', '섹스 불가', '기존 상호작용 조건이 충족되지 않았습니다.')
! SNK_ROOM_SEX_END
		if snk_room_target = 0: func('$menu', 'menu_form', $menu_item_sex, menu_sex, '섹스한다',  '<<$slave_name>>와 섹스')
! JO9 MOD END J9M2803
		func('$menu', 'menu_form', $menu_item_lesson, menu_lesson, '교육 활동',  '<<$slave_name>>에 지식주입')
		func('$menu', 'menu_form', $menu_item_sex_edu, menu_sex_edu, '성교육',  '<<$slave_name>>에 성교육')
	else
! JO9 MOD START J9M2802 | 2026-10-10_restore_private_room_ui | changed block; context may be included
		if snk_room_target = 0: func('$menu', 'exec', $menu_item_sex_gray, empty, '섹스 불가', $text_exhausted)
! JO9 MOD END J9M2802
		func('$menu', 'exec', $menu_item_lesson_gray, empty, '교육 불가', $text_exhausted)
		func('$menu', 'exec', $menu_item_sex_edu_gray, empty, '성교육 불가', $text_exhausted)
	end

	if slave['energy'] = -4:
		func('$menu', 'exec', $menu_item_tutor_gray, empty, '가정교사 (<<coach_price[0]>>-<<coach_price[5]>>$)', $text_exhausted)
	elseif sparks < coach_price[0]:
		func('$menu', 'exec', $menu_item_tutor_gray, empty, '가정교사 (<<coach_price[0]>>-<<coach_price[5]>>$)', '<<$slave_name>>에게 가정교사를 불러줄 스파크가 부족하다.')
	else
		func('$menu', 'menu_form', $menu_item_tutor, menu_tutor, '가정교사 (<<coach_price[0]>>-<<coach_price[5]>>$)',  '<<$slave_name>>에게 가정교사 교육')
	end

	func('$menu', 'menu_form', $menu_item_reward, menu_reward, '칭찬', '<<$slave_name>>의 행동을 칭찬')
! JO9 MOD START J9M2801 | 2026-10-10_restore_private_room_ui | changed block; context may be included
	if snk_room_target = 0: func('$menu', 'menu_form', $menu_item_punish, menu_punish, '처벌',  '<<$slave_name>>의 행동을 처벌')
	if snk_room_target = 0: func('$menu', 'menu_form', $menu_item_get_rid_of, menu_get_rid_of, '처분', '<<$slave_name>> 를 처분한다')
! JO9 MOD END J9M2801
    if master_vampire >= 1:
		if master_str_rate < 400 : 
! JO9 MOD START J9M2800 | 2026-10-10_restore_private_room_ui | changed block; context may be included
			if snk_room_target = 0: FUNC('$menu', 'goto', $menu_item_vampire_bite, menu_vampire_byte_slave, 'interaction', 'interaction', '피를 마신다', '그녀의 생명력을 조금 빼앗아 자신의 것으로 삼는다.')
! JO9 MOD END J9M2800
		else
! JO9 MOD START J9M2799 | 2026-10-10_restore_private_room_ui | changed block; context may be included
			if snk_room_target = 0: FUNC('$menu', 'exec', $menu_item_vampire_bite_gray, empty, '피를 마신다', '갈증이 없습니다.')  
! JO9 MOD END J9M2799
		end  
  end
	func('$menu', '===END===')
	$text_display += '<br><div id="Back_activities"><a style="padding-top: 75px;" class="icon tooltip-right" tooltip-data="뒤로" href = "EXEC: menu_form = 0 & gt ''menu_form''"><img src = "content\pic\ui overhaul\back.png"></a></div>'
end

!개인실
if menu_form = 30010:

	if nsfw = 0 and $assistant['fullimage'] ! '': $text_display += '<div id="center_image_home"><img src="content\pic\<<$assistant["fullimage"]>>.png"></div>'
	func('$menu', '===BEGIN===', 'column_0')
!	    if assistant_state = CONST_INT['no_slave']:
!		    func('$menu', 'goto', $menu_item_kikuboudoir, menu_kikuboudoir, 'interaction', 'interaction','조수개인실',  '조수랑 노는곳')
!		else
!		    func('$menu', 'goto', $menu_item_kikuboudoir, menu_kikuboudoir, 'interaction', 'interaction','<<$assistant_name>>의 개인실',  '조수랑 노는곳')			
!		end
		if room1_state = CONST_INT['no_slave']:
		    func('$menu', 'goto', $menu_item_doir, menu_room1, 'interaction', 'interaction','빈방',  '메이드 개인실')
		else    
		    func('$menu', 'goto', $menu_item_doir, menu_room1, 'interaction', 'interaction','<<$room1_name>>의 방',  '메이드 개인실')
		end  
		if kulaconstruct >= 2:
		    if room2_state = CONST_INT['no_slave'] :
		    func('$menu', 'goto', $menu_item_doir, menu_room2, 'interaction', 'interaction','빈방',  '메이드 개인실')
		    else    
		    func('$menu', 'goto', $menu_item_doir, menu_room2, 'interaction', 'interaction','<<$room2_name>>의 방',  '메이드 개인실')
		    end 
		end
		if kulaconstruct >= 3 :
		    if room3_state = CONST_INT['no_slave']:
		    func('$menu', 'goto', $menu_item_doir, menu_room3, 'interaction', 'interaction','빈방',  '메이드 개인실')
		    else    
		    func('$menu', 'goto', $menu_item_doir, menu_room3, 'interaction', 'interaction','<<$room3_name>>의 방',  '메이드 개인실')
		    end
		end    
		if kulaconstruct >= 4 :
		    if room4_state = CONST_INT['no_slave'] and kulaconstruct >= 4:
		    func('$menu', 'goto', $menu_item_doir, menu_room4, 'interaction', 'interaction','빈방',  '메이드 개인실')
		    else    
		    func('$menu', 'goto', $menu_item_doir, menu_room4, 'interaction', 'interaction','<<$room4_name>>의 방',  '메이드 개인실')
		    end	
		end    	
	func('$menu', '===END===')
	$text_display += '<br><div id="Back_cast"><a class="icon tooltip-right" tooltip-data="뒤로" href = "EXEC: menu_form = 0 & gt ''menu_form''"><img src = "content\pic\ui overhaul\back.png"></a></div>'
end

!main menu - Domestic issues
if menu_form = 3:

	func('$menu', '===BEGIN===', 'column_0')

	if bath > 0:
		func('$menu', 'goto',  $menu_item_bath, menu_take_bath, 'interaction', 'interaction', '씻는다.', '씻도록 한다.')
	else
		func('$menu', 'exec', $menu_item_bath_gray, empty, '씻을 수가 없다.', $no_bath)
	end

	if kitchen = 0:
		func('$menu', 'exec', $menu_item_meal_gray, empty, '요리할 수 없다.', $no_kitchen)
	elseif cooked_food < master_butler:
		func('$menu', 'goto',  $menu_item_meal, menu_prepare_meal, 'interaction', 'interaction', '요리한다.', '요리를 하도록 한다.')
	else
		func('$menu', 'exec', $menu_item_meal_gray, empty, '이미 준비되어 있다.', '이미 식사가 준비되어 있다.')
	end

	if house_mess > 0:
		func('$menu', 'goto',  $menu_item_Tidy, menu_Tidy, 'interaction', 'interaction', '잡일과 청소를 한다.', '잡일과 청소를 하도록 한다.')
	else
		func('$menu', 'exec', $menu_item_Tidy_gray, empty, '정리하지 않아도 된다.', '이미 정돈되어 있다.')
	end
	func('$menu', 'menu_form', $menu_item_Take_drug, menu_Take_drug, '약물 복용', '약물 복용')
	func('$menu', 'menu_form', $menu_item_Drink_potion, menu_Drink_potion, '마법약 복용', '마법약 복용')
	func('$menu', 'menu_form', $menu_item_Accounting, menu_Accounting, '회계', '회계')
	if barn = 1:
		func('$menu', 'menu_form', $menu_item_barn, menu_barn, '축사 출입', '축사 출입')
	else
		func('$menu', 'exec', $menu_item_barn_gray, empty, '축사 출입 불가', '축사가 없다.')
	end
	func('$menu', '===END===')
	$text_display += '<br><div id="Back_Domestic"><a style="padding-top: 75px;" class="icon tooltip-right" tooltip-data="뒤로" href = "EXEC: menu_form = 0 & gt ''menu_form''"><img src = "content\pic\ui overhaul\back.png"></a></div>'
end

!main menu - Assistant assignments
if menu_form = 4:
	if nsfw = 0: $text_display += '<div id="center_image_home"><img src="content\pic\<<$assistant[''fullimage'']>>.png"></div>'

	func('$menu', 'spacer', -1)
	func('$menu', '===BEGIN===', 'column_0')

	if slave_state = CONST_INT['slave_exist']:
		func('$menu', 'menu_form', $menu_item_lesson_S_A, menu_lesson_S_A, '조수⇒노예 : 교육', '<<$assistant_name>>에게 <<$slave_name>>를 교육하게 한다')
	else
		func('$menu', 'exec', $menu_item_lesson_S_A_gray, empty, '조수⇒노예 : 불가', '노예가 없다')
	end

	if house_mess > 0:
		func('$menu', 'goto', $menu_item_Tidy_A, menu_Tidy_A, 'interaction', 'interaction', '잡일과 청소 지시', '<<$assistant_name>>에게 잡일과 청소 지시')
	else
		func('$menu', 'exec', $menu_item_Tidy_A_gray, empty, '잡일과 청소 불가', '이미 정돈되어 있다.')
	end

	if kitchen = 0:
		func('$menu', 'exec', $menu_item_dinner_A_gray, empty, '요리 불가', $no_kitchen)
	elseif cooked_food >= assistant['moral']:
		func('$menu', 'exec', $menu_item_dinner_A_gray, empty, '요리 불가', '이미 식사가 준비되어 있다.')
	elseif assistant["cook"] > 0:
		func('$menu', 'goto', $menu_item_dinner_A, menu_dinner_A, 'interaction', 'interaction', '요리 지시', '<<$assistant_name>>에게 식사준비 지시')
	else
		func('$menu', 'exec', $menu_item_dinner_A_gray, empty, '요리 불가', '<<$assistant_name>> 요리를 할 줄 모른다.')
