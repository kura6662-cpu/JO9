!настройки
$sex_options[100] = {
	$sex_menu = '<br>'
	if exam_in_progress ! 1:
		$sex_menu += '<div id="under_gray">{ { { UI } } }<br></div>'
		if ui_style ! 1:
			$sex_menu += '<br><div id="under">구형<br><div id = "clear"><a href = ''EXEC: ui_style = 1 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		else
			$sex_menu += '<br><div id="under_gray">구형<br></div>'
		end
		if ui_style ! 0:
			$sex_menu += '<div id="under">클래식<br><div id = "clear"><a href = ''EXEC: ui_style = 0 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		else
			$sex_menu += '<div id="under_gray">클래식<br></div>'
		end
		if ui_style ! 2:
			$sex_menu += '<div id="under">Grimdark<br><div id = "clear"><a href = ''EXEC: ui_style = 2 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
		else
			$sex_menu += '<div id="under_gray">Grimdark<br></div>'
		end
	end

	$sex_menu += '<br><div id="under_gray">{ { { NSFW } } }<br></div>'
	if nsfw ! 1:
		$sex_menu += '<div id="under">켜기<br><div id = "clear"><a href = ''EXEC: nsfw = 1 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
	else
		$sex_menu += '<div id="under">끄기<br><div id = "clear"><a href = ''EXEC: nsfw = 0 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
	end

	$sex_menu += '<br><br><br><div id="under">뒤로 <br><div id = "clear"><a href = ''EXEC: sex_num = 0 & gt curloc''><img src = "content\pic\clear.png"></a></div></div>'
