# #sex_options
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2918 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '#sex_options': gs 'snk_room_bridge', 'guard', '#sex_options'
! JO9 MOD END J9M2918
!MAIN MENU FOR ACTIVE SEX

killvar '$play_sound'
$play_sound[1] = ''

!main options
$sex_options[0] = {
	func('$menu', '===SEX_BEGIN===', 'column_3')
	func('$menu', 'sex_empty_item', 1)
	if strip = 0:
		func('$menu', 'sex_interaction', $menu_item_sexStriptease, menu_sexStriptease, '스트립쇼 지시')
	else
		func('$menu', 'sex_interaction', $menu_item_sexSeduce, menu_sexSeduce, '유혹 지시')
	end
	func('$menu', 'sex_interaction', $menu_item_sexKiss, menu_sexKiss, '키스한다')
	func('$menu', 'sex_interaction', $menu_item_Caressme, menu_Caressme, '<<$intensity[intensity]>> 애무지시')
	func('$menu', 'sex_interaction', $menu_item_Massageher, menu_Massageher, '<<$intensity[intensity]>> 마사지한다')
	func('$menu', 'sex_interaction', $menu_item_Arouseher, menu_Arouseher, '<<$intensity[intensity]>> 흥분시킨다')
	if sex['pc_boner'] > 0:
		func('$menu', 'exec_sex_options', $menu_item_Startsex, 'sex_num = 1 & gt $curloc', '섹스')
	end
	func('$menu', 'exec_sex_options', $menu_item_Perverse, 'sex_num = 2 & gt $curloc', '괴롭히기')
	func('$menu', 'exec_sex_options', $menu_item_Exitsex, 'sex_num = 0 & gt "sex_end"', '나가기')
	func('$menu', '===SEX_END===')
}

