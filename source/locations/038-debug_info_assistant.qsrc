# debug_info_assistant
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1530 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'debug_info_assistant': gs 'snk_room_bridge', 'guard', 'debug_info_assistant'
! JO9 MOD END J9M1530
!사ㅓ고생
gs 'main_layout'
gs '$slave_price', 'assistant' &! replaced gs '$assistant_rank_stats' - ImperatorAugustus
if $assistant_psy_status = 'servile': $assistant_psy_status = '<font color="#009900">노예근성</font>'
if $assistant_psy_status = 'obedient': $assistant_psy_status = '<font color="#006600">복종중</font>'
if $assistant_psy_status = 'optimistic': $assistant_psy_status = '<font color="#009FEF">긍정적</font>'
if $assistant_psy_status = 'soft': $assistant_psy_status = '<font color="#0000D8">상냥함</font>'
if $assistant_psy_status = 'docile': $assistant_psy_status = '<font color="#A300CC">온순함</font>'
if $assistant_psy_status = 'reluctant': $assistant_psy_status = '<font color="#6B0084">거리감</font>'
if $assistant_psy_status = 'resistant': $assistant_psy_status = '<font color="#FF4FBB">저항</font>'
if $assistant_psy_status = 'arrogant': $assistant_psy_status = '<font color="#EA0090">혐오감</font>'
if $assistant_psy_status = 'hateful': $assistant_psy_status = '<font color="#cd0000">증오심</font>'
if $assistant_psy_status = 'frightened': $assistant_psy_status = '<font color="#6B0084">두려움</font>'
if $assistant_psy_status = 'lachrymose': $assistant_psy_status = '<font color="#FF4FBB">울보</font>'
if $assistant_psy_status = 'depresive': $assistant_psy_status = '<font color="#EA0090">우울증</font>'
if $assistant_psy_status = 'broken': $assistant_psy_status = '<font color="#cd0000">정신병</font>'
if $assistant_psy_status = 'hysteric': $assistant_psy_status = '<font color="#ad0e7b">관심병</font>'
if $assistant_psy_status = 'horny': $assistant_psy_status = '<font color="#ad0e7b">발정중</font>'
$assistant_ava_portrait = $assistant['ava']
! JO9 MOD START J9M1529 | 2026-10-09_dialogue_format_and_protagonist | changed block; context may be included
$debug_psy_status_fuck = '<center>노예의 정신상태 종류 (색상 무관) -<br><br><font color="#ad0e7b">발정중</font>　　<font color="#ad0e7b">관심병</font><br><font color="#cd0000">정신병</font>두려움<font color="#cd0000">증오심</font><br><font color="#EA0090">우울증</font>　　　　<font color="#EA0090">혐오감</font><br><font color="#FF4FBB">울보</font>　　<font color="#FF4FBB">저항</font><br><font color="#6B0084">거리감</font><br><font color="#A300CC">온순함</font><br><font color="#0000D8">상냥함</font><br><font color="#009FEF">긍정적</font><br><font color="#006600">복종중</font><br><font color="#009900">노예근성</font></center>'
! JO9 MOD END J9M1529
*p '<div id = "title_scroll_debug"><img src = "content\pic\bg\page_blank_debug.png"></div>'
*p '<div id = "title_scroll_column_left_top">'
*nl '<center><<$assistant_name>>'
*nl '<img src = "<<$assistant[''ava'']>>.png"></center></div>'
*p '<div id = "title_scroll_column_left_top">'
*nl '<center><<$assistant_name>>'
*nl '<img src = "content\pic\girls\face\<<assistant_type>>.png"></center></div>'
*p '<div id = "title_scroll_column_left">'
*nl '<font color="#187700">기분 등급</font>: <<assistant["mood"]>>'
*nl '<font color="#187700">기분 단계</font>: <<assistant_rate["mood"]>>'
*nl '<font color="#ad0e7b">흥분 등급</font>: <<assistant["arousal"]>>'
*nl '<font color="#ad0e7b">흥분 단계</font>: <<assistant_rate["arousal"]>>'
*nl '성교육 계: <<assistant["sex_sum"]>>'
*nl '<a class="tooltip-right" tooltip-data="정신상태 Tip" href = "EXEC: msg $debug_psy_status_fuck">정신 상태</a>: <<$assistant_psy_status>></div>'
*p '<div id = "title_scroll_column_right1">'
*nl '<u>복종심 요소</u>'
if assistant["obedience"] > 0: *nl '<font color="#008000">현재 복종도: <<assistant["obedience"]>></font>'
if assistant["obedience"] = 0: *nl '<font color="#3c8712">현재 복종도: <<assistant["obedience"]>></font>'
if assistant["obedience"] < 0: *nl '<font color="#cd0000">현재 복종도: <<assistant["obedience"]>></font>'
*nl '<font color="#960018">두려움 등급</font>: <<assistant["fear"]>>'
*nl '<font color="#960018">두려움 단계</font>: <<assistant_rate["fear"]>>'
*nl '<font color="#464451">절망 등급</font>: <<assistant["angst"]>>'
*nl '<font color="#464451">절망 단계</font>: <<assistant_rate["angst"]>>'
*nl '<font color="#EE1289">응석 등급</font>: <<assistant["spoil"]>>'
*nl '<font color="#EE1289">응석 단계</font>: <<assistant_rate["spoil"]>>'
*nl '<font color="#e0640b">장악력 영향</font>: <<master_supermacy>></div>'
*p '<div id = "title_scroll_column_right2">'
*nl '<u>충성심 요소</u>'
*nl '<font color="#008080">헌신 등급</font>: <<assistant["moral"]>>'
*nl '<font color="#008080">헌신 단계</font>: <<assistant_rate["moral"]>>'
*nl '<font color="#9e8e00">사육 등급</font>: <<assistant["instinct"]>>'
*nl '<font color="#9e8e00">사육 단계</font>: <<assistant_rate["instinct"]>>'
*nl '<font color="#082567">습관 등급</font>: <<assistant["custom"]>>'
*nl '<font color="#082567">습관 단계</font>: <<assistant_rate["custom"]>>'
*nl '<font color="#B452CD">인식 등급</font>: <<assistant["rational"]>>'
*nl '<font color="#B452CD">인식 단계</font>: <<assistant_rate["rational"]>></div>'
*p '<div id = "title_scroll_column_middle">'
*nl '<a style="text-align:center"><u>노예 훈련을 위한 Tip</u></a>'
*nl '복종심 Tip : 두려움 → 의류 → 아우라'
*nl '충성심 TIp : 습관+인식+사육 → 충성'
*nl '복종심과 충성심은 매우 연계됩니다.</div>'
$debug_quit_num = 'debug_quit_' + rand(1,5)
$debug_quit = '<img src="content/pic/bg/<<$debug_quit_num>>.png">'
*p '<div id = "title_scroll_debug_quit"><a class="tooltip-bottom" tooltip-data="닫기" href = "EXEC: gt ''menu_form''"><<$debug_quit>></a></div>'
------------ debug_info_assistant ------------
