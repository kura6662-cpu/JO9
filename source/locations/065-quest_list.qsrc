# $quest_list
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2844 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = '$quest_list': gs 'snk_room_bridge', 'guard', '$quest_list'
! JO9 MOD END J9M2844
!create a list for active quests
$quest_list = ''

n = arrsize('$quest')
i = 0
:loop
	if active[$quest[i]] = 1: $quest_list += '<<$quest[i]>><br><br>'
	i += 1
if i < n: jump 'loop'

if is_perv ! 0:
	if (assistant_state < CONST_INT['slave_exist'] or assistant['age'] ! CONST_INT['loli_age'] or assistant['beauty'] < 3):  $quest_list += '음탕한 늙은이인 이상, 아주 젊고 예쁜 조수를 두면 참 사랑스러울 텐데<br><br>'
	! this should not show up as an objective if you have a fainted loli assistant, so the state check is < exist (which means: either no slave or dead) - ImperatorAugustus

	if loli_magic < 2 and (assistant_state > CONST_INT['no_slave'] and assistant['age'] = CONST_INT['loli_age'] and assistant['beauty'] > 2):
		$quest_list += '음탕한 늙은이인 이상, 아주 젊고 예쁜 노예를 하나 더 두면 참 멋질 텐데<br><br>'

		if $estate ! 'white_house' and $estate ! 'korvus_house' and $estate ! 'taurus_house':
			$quest_list += '음탕한 늙은이인 이상, 젊고 예쁜 노예들을 더 둘 공간이 넓었으면 참 좋을 텐데<br><br>'
		end
	end
end

if julia_start = -1 and julia_met = 0:
	$quest_list += '바티칸에서 온 편지에, 자기 언니라고 주장하는 소녀가 그곳에 머무르고 있다고 했다! 가능한 한 빨리 가서 비서 요한나를 만나야 한다<br><br>'
end

if quest_description_mode = 1: $quest_list = '   <<$quest_description[choosen_quest]>>'
------------ $quest_list ------------
