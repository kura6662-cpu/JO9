# origins_relations
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M2947 | 2026-10-10_restore_private_room_ui | changed block; context may be included
if snk_room_target > 0 and $curloc = 'origins_relations': gs 'snk_room_bridge', 'guard', 'origins_relations'
! JO9 MOD END J9M2947
! Рассчёт взаимоотношений между рабыней и ассистенткой - mrross



! JO9 MOD START VOICE_RELATION_CONTEXT | 2026-10-18_relation_dialogue_flow
! Only the current answer owns this display context; no character/save keys are added.
killvar 'jo9_relation_last_sign'
killvar 'jo9_relation_cue_used'
killvar '$jo9_relation_prev_group'
killvar '$jo9_relation_prev_body'
killvar 'jo9_relation_prev_tone'
jo9_relation_active=1
! JO9 MOD END VOICE_RELATION_CONTEXT
if sa_rel = 1:
	copyarr '$slave1', '$slave'
	copyarr 'slave1', 'slave'
	$slave1['name'] = $slave_name	
	slave1["other_rel"] = slave['<<assistant["id"]>>']
	copyarr '$slave2', '$assistant'
	copyarr 'slave2', 'assistant'
	$slave2['name'] = $assistant_name
elseif sa_rel = 2:
	copyarr '$slave1', '$assistant'
	copyarr 'slave1', 'assistant'
	$slave1['name'] = $assistant_name	
	slave1["other_rel"] = assistant['<<slave["id"]>>']
	copyarr '$slave2', '$slave'
	copyarr 'slave2', 'slave'
	$slave2['name'] = $slave_name
end

int_index = 1 + slave1["intellect"]/2
int_index2 = 1 + slave2["intellect"]/2


sa_relations = 0


if sa_rel = 1: $text[1] = "<br>당신은 노예를 불러 조수를 내보내 대화를 방해하지 못하게 한다. 둘만 남았고 <<$slave2['name']>>가 엿듣지 않는다는 걸 확인한 뒤, 직접 이야기해 본 당신의 조수에 대해 그 아이가 어떻게 생각하는지 묻는다.<br>"
if sa_rel = 2: $text[1] = "<br>당신은 조수를 불러 노예를 내보내 대화를 방해하지 못하게 한다. 둘만 남았고 <<$slave2['name']>>가 엿듣지 않는다는 걸 확인한 뒤, 직접 이야기해 본 당신의 노예에 대해 그 아이가 어떻게 생각하는지 묻는다.<br>"
! Если сёстры, то биография не влияет
snk_origin_relation = slave1['relative_id'] > 0 and slave2['id'] > 0 and slave1['relative_id'] = slave2['id'] and $slave1['relative_relations'] ! ''
$snk_origin_relation_intro = $text[1]
$snk_origin_relation_body = '<br>' + $slave1['relative_relations']
if snk_origin_relation:
	if int_index = 1: $snk_origin_relation_intro += "<<$slave1['name']>>는 어깨를 으쓱하고 아무 생각 없이 대답한다:"
	if int_index = 2: $snk_origin_relation_intro += "<<$slave1['name']>>는 마치 전에도 한 말인 것처럼 대답한다:"
	if int_index = 3: $snk_origin_relation_intro += "<<$slave1['name']>>는 조금 어리둥절한 표정으로 당신을 보지만, 그래도 대답한다:"
end

if slave1['id'] = 1926319775 and slave2['id'] = 1395836363:
 snk_origin_relation = 1
 $snk_origin_relation_intro = $text[1] + '<<$slave1[''name'']>>는 곧바로 대답한다:'
! JO9 MOD START WORLD_TEXT_EXTRA_07 | 2026-10-18_world_text_rework_228
 $snk_origin_relation_body = '<br>센세잖아… 고향 세계에서는 대마법사 제리의 직속 제자이자 1급 마법사로 이름을 날리던 인간인데, 이 시궁창 같은 도시에서는 나랑 똑같이 목줄을 차고 있네.<!-- #nwtx -->'
! JO9 MOD END WORLD_TEXT_EXTRA_07
end
if slave1['id'] = 1395836363 and slave2['id'] = 1926319775:
 snk_origin_relation = 1
 $snk_origin_relation_intro = $text[1] + '<<$slave1[''name'']>>는 곧바로 대답한다:'
! JO9 MOD START WORLD_TEXT_EXTRA_08 | 2026-10-18_world_text_rework_228
 $snk_origin_relation_body = '<br>프리렌 씨군요… 고향 세계에서는 천 년 넘게 살아온 전설적인 엘프 마법사였는데, 그런 분조차 이 저주받은 안개와 노예상의 손아귀는 피하지 못하셨네요.<!-- #nwtx -->'
! JO9 MOD END WORLD_TEXT_EXTRA_08
end

!Если рабыня не идёт на контакт
if sa_rel = 2 and slave["obedience"] < 0:
	if int_index = 1: $text[1] += "<<$slave1['name']>>는 발을 구르고 주먹을 움켜쥔 채 분개한 목소리로 말한다:"
	if int_index = 2: $text[1] += "<<$slave1['name']>>는 엄한 표정을 짓고 못마땅한 목소리로 말한다:"
	if int_index = 3: $text[1] += "<<$slave1['name']>>는 당신의 질문에 무심하게 대답한다:"
! JO9 MOD START J9M2946 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
	! JO9 MOD START VOICE_ARGON_FACT_NATIVE_062 | 2026-10-18 native selected text only
	$text[2] = '<<$slave2["name"]>> ' + $dyneval($voice_native, '1117_refuse_talk_<<int_index>>', $sa_relations_text["refuse_talk_<<int_index>>"], 'slave1',2)	
	! JO9 MOD END VOICE_ARGON_FACT_NATIVE_062
! JO9 MOD END J9M2946
!	jump 'bio_override'
end

! Если есть приказ "Ограничить общение"
if slave1['isolate'] >= 1: 
	if int_index = 1: $text[1] += "<<$slave1['name']>>는 어깨를 으쓱하고 아무 생각 없이 대답한다:"
	if int_index = 2: $text[1] += "<<$slave1['name']>>는 마치 전에도 한 말인 것처럼 대답한다:"
	if int_index = 3: $text[1] += "<<$slave1['name']>>는 조금 어리둥절한 표정으로 당신을 보지만, 그래도 대답한다:"
