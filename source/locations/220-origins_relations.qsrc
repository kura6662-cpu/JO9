if sa_relations < 0 and slave1["other_rel"] >= acc_rel['good2']: 
	! JO9 MOD START VOICE_ARGON_FACT_NATIVE_471 | 2026-10-18 native selected text only
	$text[6] += $dyneval($voice_native, '1117_acc_itog_decaying_<<int_index>>', $sa_relations_text['acc_itog_decaying_<<int_index>>'], 'slave1',6)
	! JO9 MOD END VOICE_ARGON_FACT_NATIVE_471
elseif sa_relations > 0 and slave1["other_rel"] <= acc_rel['bad2']:
	! JO9 MOD START VOICE_ARGON_FACT_NATIVE_473 | 2026-10-18 native selected text only
	$text[6] += $dyneval($voice_native, '1117_acc_itog_improving_<<int_index>>', $sa_relations_text['acc_itog_improving_<<int_index>>'], 'slave1',6)
	! JO9 MOD END VOICE_ARGON_FACT_NATIVE_473
else
	if slave1["other_rel"] < acc_rel['bad3']: 
		$i_rel = 'bad3'
	elseif slave1["other_rel"] >= acc_rel['bad3'] and slave1["other_rel"] < acc_rel['bad2']: 
		$i_rel = 'bad2'
	elseif slave1["other_rel"] >= acc_rel['bad2'] and slave1["other_rel"] < acc_rel['bad1']: 
		$i_rel = 'bad1'
	elseif slave1["other_rel"] >= acc_rel['bad1'] and slave1["other_rel"] <= acc_rel['good1']: 
		$i_rel = 'indiff'
	elseif slave1["other_rel"] > acc_rel['good1'] and slave1["other_rel"] <= acc_rel['good2']: 
		$i_rel = 'good1'	
	elseif slave1["other_rel"] > acc_rel['good2'] and slave1["love"] ! slave2["id"]: 
		$i_rel = 'good2'	
	elseif slave1["other_rel"] > acc_rel['good3'] or  slave1["love"] = slave2["id"]: 
		$i_rel = 'good3'	
	end
	! JO9 MOD START VOICE_ARGON_FACT_NATIVE_490 | 2026-10-18 native selected text only
	$text[6] += $dyneval($voice_native, '1117_acc_itog_<<$i_rel>>_<<int_index>>', $sa_relations_text['acc_itog_<<$i_rel>>_<<int_index>>'], 'slave1',6)
	! JO9 MOD END VOICE_ARGON_FACT_NATIVE_490
end







!msg 'Рабыня <<$slave1["name"]>> <<slave1["id"]>><br>Темпер: <<slave1["temper"]>><br>Мир: <<slave1["world_index"]>>/<<sa_relations1>><br>Нация: <<slave1["nation_index"]>>/<<sa_relations2>><br>Семья: <<slave1["family_index"]>>/<<sa_relations3>><br>Работа: <<slave1["work_index"]>>/<<sa_relations4>><br>Рабыня <<$slave2["name"]>> <<slave2["id"]>><br>Мир: <<slave2["world_index"]>><br>Нация: <<slave2["nation_index"]>><br>Семья: <<slave2["family_index"]>><br>Работа: <<slave2["work_index"]>><br>Текущее отношение:<<sa_relations>><br>Отношения: <<slave["<<assistant[''id'']>>"]>>, <<assistant["<<slave[''id'']>>"]>>'




