if int_index = 3: $text[1] += "<<$slave1['name']>>는 당신을 흘끗 본 뒤, 노예답게 바닥으로 시선을 내린다:"


! JO9 MOD START J9M2944 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
$text[2] = "<<$slave2['name']>>"
! JO9 MOD END J9M2944


! МИРОВЫЕ ОТНОШЕНИЯ
if slave1["tolerant_world"] >= 20:
	if slave2["tolerant_world"] >= 20:
		sa_relations += 2
		! JO9 MOD START VOICE_ARGON_FACT_NATIVE_092 | 2026-10-18 native selected text only
		$text[2] += $dyneval($voice_native, '1117_tolerant_world_eq_<<int_index>>', $sa_relations_text['tolerant_world_eq_<<int_index>>'], 'slave1',2)
		! JO9 MOD END VOICE_ARGON_FACT_NATIVE_092
	else
		! JO9 MOD START VOICE_ARGON_FACT_NATIVE_094 | 2026-10-18 native selected text only
		$text[2] += $dyneval($voice_native, '1117_tolerant_world_<<int_index>>', $sa_relations_text['tolerant_world_<<int_index>>'], 'slave1',2)
		! JO9 MOD END VOICE_ARGON_FACT_NATIVE_094
	end
else	
	if slave1["world_index"] < slave2["world_index"]: 
		sa_relations += ((slave1["world_index"] - slave2["world_index"])/2)
		! JO9 MOD START VOICE_ARGON_FACT_NATIVE_099 | 2026-10-18 native selected text only
		$text[2] += $dyneval($voice_native, '1117_world_prim_<<int_index>>', $sa_relations_text['world_prim_<<int_index>>'], 'slave1',2)
		! JO9 MOD END VOICE_ARGON_FACT_NATIVE_099
	elseif slave1["world_index"] > slave2["world_index"]: 
		sa_relations -= ((slave1["world_index"] - slave2["world_index"])/2)
		! JO9 MOD START VOICE_ARGON_FACT_NATIVE_102 | 2026-10-18 native selected text only
		$text[2] += $dyneval($voice_native, '1117_world_adv_<<int_index>>', $sa_relations_text['world_adv_<<int_index>>'], 'slave1',2)
		! JO9 MOD END VOICE_ARGON_FACT_NATIVE_102
	elseif slave1["world_index"] = slave2["world_index"]: 
		sa_relations += 1
		! JO9 MOD START VOICE_ARGON_FACT_NATIVE_105 | 2026-10-18 native selected text only
		$text[2] += $dyneval($voice_native, '1117_world_eq_<<int_index>>', $sa_relations_text['world_eq_<<int_index>>'], 'slave1',2)
		! JO9 MOD END VOICE_ARGON_FACT_NATIVE_105
	end
end
! JO9 MOD START VOICE_RELATION_PARAGRAPH_1 | 2026-10-18_relation_semantic_speech
$text[2] += " "
