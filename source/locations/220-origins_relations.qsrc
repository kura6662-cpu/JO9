		! JO9 MOD END VOICE_ARGON_FACT_NATIVE_142
	end
else	
! Правители 
	if slave1["family_index"] = 1:
		sa_relations += 3 - slave2["family_index"]
		if slave2["family_index"] = 1:
		! JO9 MOD START VOICE_ARGON_FACT_NATIVE_149 | 2026-10-18 native selected text only
		$text[2] += $dyneval($voice_native, '1117_family_class1to1_<<int_index>>', $sa_relations_text['family_class1to1_<<int_index>>'], 'slave1',2)
		! JO9 MOD END VOICE_ARGON_FACT_NATIVE_149
