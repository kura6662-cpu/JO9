			! JO9 MOD END VOICE_ARGON_FACT_NATIVE_159
		end	
! Средний класс
	elseif slave1["family_index"] = 3: 
		sa_relations += 5 - slave2["family_index"]
		if slave2["family_index"] < slave1["family_index"]:
			! JO9 MOD START VOICE_ARGON_FACT_NATIVE_165 | 2026-10-18 native selected text only
