		! JO9 MOD START VOICE_ARGON_FACT_NATIVE_125 | 2026-10-18 native selected text only
		$text[2] += $dyneval($voice_native, '1117_nation_beast_<<slave1["world_index"]>>_<<int_index>>', $sa_relations_text['nation_beast_<<slave1["world_index"]>>_<<int_index>>'], 'slave1',2)
		! JO9 MOD END VOICE_ARGON_FACT_NATIVE_125
