	$text[2] = '' + $sa_relations_text['isolate_<<int_index>>']
! JO9 MOD END J9M2945
!	jump 'bio_override'
end

if int_index = 1: $text[1] += "<<$slave1['name']>>는 혼란스러운 듯 찡그리고 입술을 오므린 채 손가락에 머리카락을 감는다:"
