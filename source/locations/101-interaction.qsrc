!!!! COW LESSONS!!!!

if code_defined['interaction_cow_setup'] = 0:
	code_defined['interaction_cow_setup'] = 1 &! do-once

	$interaction_cow_setup = {
		if cow_locked = 1: deprivation = 1

		interaction_assistant['repulse'] = 0
		if assistant['brand'] = 1: interaction_assistant['repulse'] -= 1 &! being branded by hot iron reduces resistance to cow training

		interaction_assistant['motivation_repulse'] = assistant['intellect'] + assistant['pride'] + assistant['ego']
		if $assistant['cloth'] = 'cow_gear': interaction_assistant['motivation_repulse'] -= 1
		if assistant['nose_piercing'] = 1: interaction_assistant['motivation_repulse'] -= 1
		if assistant['lactation'] > 0: interaction_assistant['motivation_repulse'] -= 1

		$target_skill = 'cowSK'
		$target_affinity = 'cowSK_affinity'
		$misc_bonus = 'learn_bonus["cowSK"]'
	}
end

!Personal lesson on cow skill - Pianocat
if interaction = 5026:
	if assistant['cowSK'] > 2 and (assistant['lactation'] = 0 or $assistant['cloth'] ! 'cow_gear' or barn = 0):
		$interaction_type = 'special' &! bypass interaction_result, skip to interaction_screen
		show_assistant_fullimage = 1
		$text[1] = '  <<$assistant_name>>는 젖소 흉내를 완벽하게 낼 수 있다. 이 기술을 더 끌어올려 진짜 젖소로 만들려면, 그녀에게 수유 증강 수술을 해 두고, 추방자 구역의 동물 농장에서 산 젖소 장비를 갖춰 주고, 훈련할 축사를 빌려야 한다.'
	else
		$interaction_type = 'master_teaches_assistant'
		dynamic $interaction_cow_setup
		$coach_skill = 'master_domination'
		$special_part = {
			assistant_skill = assistant['cowSK']
			$bg_path = func('display_pic', 'assistant', 'cow', 'girls/normal_scenes/')
			$text[1] = $cowSK_lesson_description[assistant_skill] &! uses delayed sub-expressions
			$coach_skill = '0' &! this is to prevent master domination skill rising (uncapped) from the "lesson" part of the training, while still using domination to limit the skill level that the master can teach; domination can increase (capped) if the training segues to "impregnate" - ImperatorAugustus
			if assistant['cowSK'] < 1:
				if assistant['pride'] > 2: assistant_rate['pride'] -= 1
				assistant_rate['temper'] += 1
			elseif assistant['cowSK'] < 3:
				assistant_rate['ego'] -= 2
				if assistant['pride'] > 2: assistant_rate['pride'] -= 1
				assistant_rate['temper'] -= 2
			else
				assistant_rate['ego'] -= 3
				if assistant['pride'] > 1: assistant_rate['pride'] -= 1
				assistant_rate['temper'] -= 3
				$text[3] = '…'
				$special_action[3] = { cow_lesson_in_progress = 1 & interaction = iif(assistant['cowSK'] > 3 and assistant['milk_summ'] > 10, menu_C_milking, menu_cow_impregnate) & gs 'assistant_to_cow' } &! segue into "impregnate cow" or milking interaction in barn
			end
			house_mess_rate += 3
			master_hygiene_rate += 4
			assistant_rate['hygiene'] += 10
		}
	end
	if barn = 1: $place = 'barn'
end

