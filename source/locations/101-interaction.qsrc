!Lecture on social structure for assistant
IF interaction = 5526:
    $interaction_type = 'lecture_assistant'
    txt_count = 2
$text[1] = ' 당신은 조수에게 모든 사람은 똑같이 태어난다고 말한다. 물론 어떤 사람은 부유한 집안에서 태어나고, 어떤 사람은 가난한 집안에서 태어나지만, 이건 대체로 운의 문제다. 자신보다 더 운이 좋거나 더 운이 나빴다는 이유로 누군가를 부러워하거나 멸시하는 것은 생산적이지 않다. 특히 불멸의 로마에서 노예가 된 소녀들은 이제 지위가 같고, 그들의 과거는 중요하지 않기 때문이다.'
$text_2 = ' <<$assistant_name>>는 멍하니 눈을 깜빡이며 머리카락을 손가락에 감아 꼬고 있다. 그녀의 텅 빈 눈빛을 보면, 당신이 전하려 한 말을 한마디도 이해하지 못했다는 것이 분명하다. 당신에게 교사의 자질이 부족하거나, 그녀에게 지능이나 시야가 부족한 것이다.'
$text_3 = ' <<$assistant_name>>는 분명 힘겹게 당신의 말을 듣고 있다. 당신의 논리는 그녀의 개인적 신념과 비참한 삶의 경험을 뚫고 들어가기 힘들어 보인다. 이 문제를 이해시키려면 앞으로도 여러 번 더 시도해야 할 것 같다.'
$text_4 = ' <<$assistant_name>>는 당신의 말을 매우 주의 깊게 듣고, 당신은 그녀의 얼굴에서 이해의 기색을 본다. 좋다 - 앞으로 몇 번만 더 수업하면, 당신은 조수에게 다른 사회 계층 사람들에 대한 관용을 길러 줄 수 있을 것이다.'
$text_5 = ' <<$assistant_name>>는 당신이 전하려 한 요점을 완전히 이해했다. 이제 그녀는 더 이상 다른 사회 계층 사람들과 갈등을 일으켜 당신을 곤란하게 만들지 않을 것이다.'
    $lecture_theme = 'tolerant_family'
    $special_part = {}
END

!Lecture on Humanism for an Assistant
IF interaction = 5527:
    $interaction_type = 'lecture_assistant'
    txt_count = 2
$text[1] = '당신은 조수에게 사람의 인생에서의 성공은 대체로 자신의 통제를 벗어난 환경에 달려 있다고 말한다. 어떤 가정과 세계에 태어났는지, 어떻게 자랐는지, 무엇을 배웠는지, 자라면서 무엇을 보았는지가 매우 중요하다. 인간의 성격은 벽돌처럼 이런 요소들이 쌓여 만들어진다. 어떤 벽돌을 받았느냐가 불운했다고 해서 사람을 멸시하는 것은 옳지 않다.'
$text_2 = ' <<$assistant_name>>는 멍하니 눈을 깜빡이며 머리카락을 손가락에 감아 꼬고 있다. 그녀의 텅 빈 눈빛을 보면, 당신이 전하려 한 말을 한마디도 이해하지 못했다는 것이 분명하다. 당신에게 교사의 자질이 부족하거나, 그녀에게 지능이나 시야가 부족한 것이다.'
$text_3 = ' <<$assistant_name>>는 분명 힘겹게 당신의 말을 듣고 있다. 당신의 논리는 그녀의 개인적 신념과 비참한 삶의 경험을 뚫고 들어가기 힘들어 보인다. 이 문제를 이해시키려면 앞으로도 여러 번 더 시도해야 할 것 같다.'
$text_4 = ' <<$assistant_name>>는 당신의 말을 매우 주의 깊게 듣고, 당신은 그녀의 얼굴에서 이해의 기색을 본다. 고무적인 일이다 - 앞으로 몇 번만 더 수업하면, 당신은 조수에게 다른 사회적 지위를 가진 사람들에 대한 관용을 길러 줄 수 있을 것이다.'
$text_5 = ' <<$assistant_name>>는 당신이 전하려 한 생각을 완전히 이해했다. 이제 그녀는 더 이상 다른 사회적 지위를 가진 사람들과 갈등을 일으켜 당신을 곤란하게 만들지 않을 것이다'
    $lecture_theme = 'tolerant_work'
    $special_part = {}
END

!Lecture on the conflict of worlds for the assistant
IF interaction = 5528:
    $interaction_type = 'lecture_assistant'
    txt_count = 2    
$text[1] = ' 당신은 조수에게 갈등은 사회의 정상적인 상태이며, 각 사람은 주변 사람들을 자기 편과 남으로 나누려는 경향이 있다고 말한다. 그리고 다른 세계 출신 사람들은 자연스럽게 서로의 적이 된다. 반대로 비슷한 세계 출신 사람들은 서로에게 끌리고 관계를 유지하며, 그렇게 다른 세계 사람들과의 끝없는 적대의 토대를 만든다.'
$text_2 = ' <<$assistant_name>>는 멍하니 눈을 깜빡이며 머리카락을 손가락에 감아 꼬고 있다. 그녀의 텅 빈 눈빛을 보면, 당신이 전하려 한 말을 한마디도 이해하지 못했다는 것이 분명하다. 당신에게 교사의 자질이 부족하거나, 그녀에게 지능이나 시야가 부족한 것이다.'
$text_3 = ' <<$assistant_name>>는 분명 힘겹게 당신의 말을 듣고 있다. 당신의 논리는 그녀의 개인적 신념과 비참한 삶의 경험을 뚫고 들어가기 힘들어 보인다. 이 문제를 이해시키려면 앞으로도 여러 번 더 시도해야 할 것 같다.'
$text_4 = ' <<$assistant_name>>는 당신의 말을 매우 주의 깊게 듣고, 당신은 그녀의 얼굴에서 이해의 기색을 본다. 좋다 - 앞으로 몇 번만 더 수업하면, 당신은 조수에게 다른 세계 사람들에 대한 불관용을 길러 줄 수 있을 것이다.'
$text_5 = ' <<$assistant_name>>는 당신이 전하려 한 생각을 완전히 이해했다. 이제 그녀는 자기 세계와 닮지 않은 어떤 세계 사람도 곱게 보지 않게 될 것이다.'
    $lecture_theme = 'bigotry_world'
    $special_part = {
        if assistant['bigotry_world'] >=20: 
            assistant['tolerant_world'] = 0
            assistant['bigotry_world'] = 0
        end
    }      
END

!Lecture on racial theory for an assistant
IF interaction = 5529:
    $interaction_type = 'lecture_assistant'
    txt_count = 2
$text[1] = '당신은 조수에게 인간(뿐만 아니라 다른 종족들)의 차이, 생활권 개념, 그리고 그 밖의 여러 논쟁적인 문제들에 대해 이야기한다. 불멸의 로마의 세계는 영원한 도시 그 자체와 그 외곽에 널리 존재하는 인간, 수인, 그 밖의 여러 민족들 사이의 관계를 통해 이러한 이론들을 실제로 보여 줄 수 있는 기회를 얼마든지 제공한다.'
$text_2 = ' <<$assistant_name>>는 멍하니 눈을 깜빡이며 머리카락을 손가락에 감아 꼬고 있다. 그녀의 텅 빈 눈빛을 보면, 당신이 전하려 한 말을 한마디도 이해하지 못했다는 것이 분명하다. 당신에게 교사의 자질이 부족하거나, 그녀에게 지능이나 시야가 부족한 것이다.'
$text_3 = ' <<$assistant_name>>는 분명 힘겹게 당신의 말을 듣고 있다. 당신의 논리는 그녀의 개인적 신념과 비참한 삶의 경험을 뚫고 들어가기 힘들어 보인다. 이 문제를 이해시키려면 앞으로도 여러 번 더 시도해야 할 것 같다.'
$text_4 = ' <<$assistant_name>>는 당신의 말을 매우 주의 깊게 듣고, 당신은 그녀의 얼굴에서 이해의 기색을 본다. 좋다 - 앞으로 몇 번만 더 수업하면, 당신은 조수에게 다른 민족 사람들에 대한 불관용을 길러 줄 수 있을 것이다.'
$text_5 = ' <<$assistant_name>>는 당신이 전하려 한 요점을 완전히 이해했다. 이제 그녀는 다른 인종과 민족의 사람들을 곱게 보지 않게 될 것이다.'
    $lecture_theme = 'bigotry_nation'
    $special_part = {
        if assistant['bigotry_nation'] >=20: 
            assistant['tolerant_nation'] = 0
            assistant['bigotry_nation'] = 0
        end
    }       
END

!Lecture on class theory for assistant
IF interaction = 5530:
    $interaction_type = 'lecture_assistant'
    txt_count = 2
$text[1] = ' 당신은 조수에게 모든 사람은 서로 다르게 태어난다고 말한다. 설명할 게 무엇이 있나? 귀족이나 부유한 집안에서 태어났다면, 이미 농민이나 사무직 노동자의 자식보다 훨씬 더 많은 길과 기회가 열려 있다. 자신이 어떤 사회 계층에 태어났는지의 중요성은 아무리 강조해도 지나치지 않다. 교육, 양육, 물질적 안정의 수준이 다르면 완전히 다른 인간이 만들어진다.'
$text_2 = ' <<$assistant_name>>는 멍하니 눈을 깜빡이며 머리카락을 손가락에 감아 꼬고 있다. 그녀의 텅 빈 눈빛을 보면, 당신이 전하려 한 말을 한마디도 이해하지 못했다는 것이 분명하다. 당신에게 교사의 자질이 부족하거나, 그녀에게 지능이나 시야가 부족한 것이다.'
