$text_4 = ' <<$assistant_name>>는 당신의 말을 매우 주의 깊게 듣고, 당신은 그녀의 얼굴에서 이해의 기색을 본다. 좋다 - 앞으로 몇 번만 더 수업하면, 당신은 조수에게 다른 사회 계층 사람들에 대한 불관용을 길러 줄 수 있을 것이다.'
$text_5 = ' <<$assistant_name>>는 당신이 전하려 한 요점을 완전히 이해했다. 이제 그녀는 다른 사회 계층 사람들을 곱게 보지 않게 될 것이다.'
    $lecture_theme = 'bigotry_family'
    $special_part = {
        if assistant['bigotry_family'] >=20: 
            assistant['tolerant_family'] = 0
            assistant['bigotry_family'] = 0
        end
    }        
END

!Lecture on Social Darwinism for an Assistant
IF interaction = 5531:
    $interaction_type = 'lecture_assistant'
    txt_count = 2
$text[1] = ' 당신은 조수에게 모든 사람의 성취는 그 사람 자신의 공로라고 말한다. 강하고 야망 있는 사람들은 믿기 어려운 결과를 이루고, 어떤 구렁텅이에서도 기어올라 정상에 설 수 있다. 인생에서 아무것도 이루지 못했다면, 그건 오직 네 잘못일 뿐이고 누구의 잘못도 아니다. 아마 너는 그 이상을 해낼 능력이 없는 것이다.'
$text_2 = ' <<$assistant_name>>는 멍하니 눈을 깜빡이며 머리카락을 손가락에 감아 꼬고 있다. 그녀의 텅 빈 눈빛을 보면, 당신이 전하려 한 말을 한마디도 이해하지 못했다는 것이 분명하다. 당신에게 교사의 자질이 부족하거나, 그녀에게 지능이나 시야가 부족한 것이다.'
$text_3 = ' <<$assistant_name>>는 분명 힘겹게 당신의 말을 듣고 있다. 당신의 논리는 그녀의 개인적 신념과 비참한 삶의 경험을 뚫고 들어가기 힘들어 보인다. 이 문제를 이해시키려면 앞으로도 여러 번 더 시도해야 할 것 같다.'
$text_4 = ' <<$assistant_name>>는 당신의 말을 매우 주의 깊게 듣고, 당신은 그녀의 얼굴에서 이해의 기색을 본다. 좋다 - 앞으로 몇 번만 더 수업하면, 당신은 조수에게 다른 사회적 지위를 가진 사람들에 대한 불관용을 길러 줄 수 있을 것이다.'
$text_5 = ' <<$assistant_name>>는 당신이 전하려 한 생각을 완전히 이해했다. 이제 그녀는 삶에서의 성공이 자기 성취와 한쪽이든 다른 쪽이든 크게 다른 사람들을 곱게 보지 않게 될 것이다.'
    $lecture_theme = 'bigotry_work'
    $special_part = {
        if assistant['bigotry_work'] >=20: 
            assistant['tolerant_work'] = 0
            assistant['bigotry_work'] = 0
        end
    }      
END

!Lecture on the plurality of worlds for the educated
IF interaction = 5535:
    $interaction_type = 'lecture_slave'
    txt_count = 2        
$text[1] = '당신은 노예에게 서로 다른 세계가 많이 있다고 말한다. 그중 하나에서 태어났다는 사실이 사람을 더 낫거나 더 못난 존재로 만들지는 않는다. 결국 원시적인 세계 사람이든 발전한 세계 사람이든 똑같이 불멸의 로마에 이르게 되며, 안개는 그들의 발전 수준 따위에는 전혀 관심이 없다. 사람이 자기 세계에서 태어난 것은 공도 저주도 아니다. 그보다 더 높은 시각을 가져야 한다.'
$text_2 = ' <<$slave_name>>는 멍하니 눈을 깜빡이며 머리카락을 손가락에 감아 꼬고 있다. 그녀의 텅 빈 눈빛을 보면, 당신이 전하려 한 말을 한마디도 이해하지 못했다는 것이 분명하다. 당신에게 교사의 자질이 부족하거나, 그녀에게 지능이나 시야가 부족한 것이다.'
$text_3 = ' <<$slave_name>>는 분명 힘겹게 당신의 말을 듣고 있다. 당신의 논리는 그녀의 개인적 신념과 비참한 삶의 경험을 뚫고 들어가기 힘들어 보인다. 이 문제를 이해시키려면 앞으로도 여러 번 더 시도해야 할 것 같다.'
$text_4 = ' <<$slave_name>>는 당신의 말을 매우 주의 깊게 듣고, 당신은 그녀의 얼굴에서 이해의 기색을 본다. 좋다 - 앞으로 몇 번만 더 수업하면, 당신은 노예에게 다른 세계 사람들에 대한 관용을 길러 줄 수 있을 것이다.'
$text_5 = ' <<$slave_name>>는 당신이 전하려 한 생각을 완전히 이해했다. 이제 그녀는 더 이상 다른 세계 사람들과 갈등을 일으켜 당신을 곤란하게 만들지 않을 것이다.'
$refuse_text = ' <<$slave_name>>는 복종을 거부한다. 그녀는 처벌받아 마땅하다.'
    $lecture_theme = 'tolerant_world'
    $special_part = {}
END

!Lecture on the harm of racism for the educated
IF interaction = 5536:
    $interaction_type = 'lecture_slave'
    txt_count = 2        
$text[1] = '당신은 노예에게 문화가 서로 다른 민족이 많이 있으며, 그들의 문화 차이가 그 민족들을 더 낫거나 더 못하게 만들지는 않는다고 말한다. 오히려 문화적 다양성은 세상을 더 흥미롭게 만들며, 다른 문화를 가진 사람들은 우스운 야만인으로 볼 것이 아니라 당신에게 새롭고 흥미로운 것을 가르쳐 줄 수 있는 사람들로 받아들여야 한다.'
$text_2 = ' <<$slave_name>>는 멍하니 눈을 깜빡이며 머리카락을 손가락에 감아 꼬고 있다. 그녀의 텅 빈 눈빛을 보면, 당신이 전하려 한 말을 한마디도 이해하지 못했다는 것이 분명하다. 당신에게 교사의 자질이 부족하거나, 그녀에게 지능이나 시야가 부족한 것이다.'
$text_3 = ' <<$slave_name>>는 분명 힘겹게 당신의 말을 듣고 있다. 당신의 논리는 그녀의 개인적 신념과 비참한 삶의 경험을 뚫고 들어가기 힘들어 보인다. 이 문제를 이해시키려면 앞으로도 여러 번 더 시도해야 할 것 같다.'
