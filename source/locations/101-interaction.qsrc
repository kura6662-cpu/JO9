		if slave['abuse_attitude'] ! -1 and $slave_psy_status ! 'broken':
			if slave['promise_reward'] > 0 or slave['neg_cheap_reward'] > 0:
				interaction_reward_potence = 0 - slave['promise_reward']
				if $slave_psy_status ! 'broken' and slave['neg_cheap_reward'] > 0:
					killvar '$text'
					$text[1] = $compliment_description[4] + $promise_reward_doubt
				else
					$text[2] = $promise_fail
				end
			end
		end
		slave['promise_reward'] += 1
	}
end

