!!!!FITNESS / GYMNASTICS / SPORTS / ENDURANCE / STAMINA LESSONS!!!!

!Personal lesson on gymnastics and sports and fitness
if interaction = 5018:
	$interaction_type = 'master_teaches_assistant'
	interaction_assistant['repulse'] = -5 + iif(assistant['stamina'] > 2, 2 - assistant['stamina'], 3 - assistant['stamina']) + iif(assistant['pride'] > 2, 1, 0) &! Athletics lesson: (-1 per level of Endurance at B+ or more | vice versa) (+1 if Pride is B+ or above | not vice versa) - easier with high endurance, harder with low endurance, harder with high pride, not easier with low pride
	interaction_assistant['motivation_repulse'] = 5 - assistant['stamina'] &! B+ endurance gains diligence at 3+ aura stats; A+ endurance at 2+ aura stats; S+ endurance at 1+ aura stats
	$coach_skill = 'master_str'
	$target_skill = 'stamina'
	$misc_bonus = 'learn_bonus["stamina"]'
	$target_affinity = 'sport_affinity'
	$special_part = {
		$bg_path = func('display_pic', 'assistant', 'gym', 'girls/normal_scenes/')
		$text[1] = $gym_lesson_description[assistant['stamina']] &! uses delayed sub-expressions
		tutor_modifier += assistant['energy'] &! stamina is easier to improve with high energy and much harder to improve with low energy - ImperatorAugustus
		assistant['calories'] -= 2 &! stamina increase is handled by $dyn_skill_rise in interaction_result
		if assistant['stamina'] = 4 and assistant['fat'] > 3: $text[1] += ' 그래도 지구력을 더 늘리려면 체중을 좀 줄여야 한다.'
		master_hygiene_rate += 10
		assistant_rate['hygiene'] += 10
		house_mess_rate += 5
		if is_perv ! 0 and assistant['age'] = CONST_INT['loli_age']: master_excitement_rate += 3
	}
	if hall = 1: $place = 'hall'
end

