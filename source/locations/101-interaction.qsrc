!Отношения рабыни и ассистентки - mrross

!Вопрос о настроении ассистентки
!IF interaction = 1126:
! repulse = -2
 !$interaction_type = 'talk_assistant'
! txt_count = ndex_a
! msg 'Ассистентка:<br>Любовь к мастеру1: <<assistant["pos_slave_love"]>><br>Любовь к мастеру2: <<assistant["pos_slave_love2"]>><br>Любовь к мастеру3: <<assistant["pos_slave_love3"]>><br>Любовь к мастеру4: <<assistant["pos_slave_love4"]>><br>Любовь к мастеру5: <<assistant["pos_slave_love5"]>><br>Любовь к мастеру6: <<assistant["pos_slave_love6"]>>'
! copyarr '$text', '$assistant_mood_list'
!END



if interaction = 1126:
    $interaction_type = 'talk_assistant'
    interaction_slave['repulse'] = -2
	show_assistant_fullimage = 1
    killvar '$slave_mood_list'
    $ndex = 1

    n = arrsize('$slave_good_mood')
    i = 0
    :loop_good
        $curmod = $slave_good_mood[i]
        if assistant[$curmod] > 0:
            dynamic "$slave_mood_list[$ndex] = '" + $replace($mood_description[$curmod], 'dynslave', 'assistant') + "'"
            $ndex += 1
        end
        i += 1
    if i < n: jump 'loop_good'

    n = arrsize('$slave_bad_mood')
    i = 0
    :loop_bad
        $curmod = $slave_bad_mood[i]
        if assistant[$curmod] > 0:
            dynamic "$slave_mood_list[$ndex] = '" + $replace($mood_description[$curmod], 'dynslave', 'assistant') + "'"
            $ndex += 1
        end
        i += 1
    if i < n: jump 'loop_bad'


    if arrsize('$slave_mood_list') < 1:
        dynamic "$slave_mood_list[1] = '" + $replace($mood_description['pos_'], 'dynslave', 'assistant') + "'"
    end

    killvar '$text'
    copyarr '$text', '$slave_mood_list'
end



