		if interaction_slave['diligence'] > 0:
			$bg_path = func('display_pic', 'slave', 'gym', 'girls/normal_scenes/')
			$text[1] = $work_out_description[slave["stamina"]]
			if slave['stamina'] > 0 and is_perv ! 0:
				if slave['age'] = CONST_INT['loli_age']:
					master_excitement_rate += slave['beauty']
					master_perv_rate += 5 - slave['fat'] + slave['beauty']
						$text[1] += ' 그녀의<<$little_txt>> 몸이 움직이는 모습을 보는 것은 즐겁다.'
				else
