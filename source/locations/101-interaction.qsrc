!isolate assistant - slave Restrict communication with the assistant for a while
IF interaction = 941:
    $interaction_type = 'talk'
    txt_count = 1
    if slave['isolate'] <= 0:
		$text[1] = '당신은 노예에게 조수와 개인적인 주제로 소통하는 것을 금하고, 대화를 일상생활과 교육으로만 제한하라고 명령한다. <<$slave_name>>는 고개를 숙이며 당신의 뜻을 따르겠다고 말한다. 당신도 이 금지가 며칠 이상 지속되지는 않을 것임을 잘 알고 있지만, 적어도 한동안은 조수와 노예의 관계를 얼어붙게 만들 수 있다.'
        slave['isolate'] = 5
    else
		$text[1] = '당신은 노예가 조수와 어떤 개인적인 주제로든 소통하는 것을 허락한다. <<$slave_name>>는 고개를 숙이며 당신의 뜻을 따르겠다고 말한다. 어디로 이어질지 두고 보자.'
        slave['isolate'] = 0
    end
END
!smear assistant - slave Cool down your attitude towards your assistant
IF interaction = 942:
    $interaction_type = 'talk'
    txt_count = 1
    if slave['smear'] = 0:
		$text[1] = ' 당신은 노예에게 <<$assistant_name>>는 그녀의 친구가 아니라 당신의 조수이며, 목표는 노예를 더 빨리 팔 수 있도록 훈련을 돕는 것이라고 상기시킨다. 노예의 얼굴을 보면, 그녀가 당신의 말을 이해하고 곱씹고 있다는 것이 드러난다. 당신은 그녀가 올바른 결론에 이르기를 바란다.'
        slave['smear'] = 5
    else
		$text[1] = ' 당신은 노예에게 <<$assistant_name>>는 그녀의 친구가 아니라 당신의 조수이며, 목표는 노예를 더 빨리 팔 수 있도록 훈련을 돕는 것이라고 상기시킨다. 노예는 다소 멍한 표정으로 고개를 끄덕인다 - 최근에도 이미 들었던 말이라, 새로울 것은 없었던 모양이다.'
    end
END
!praise assistant - slave To evoke sympathy for the assistant
IF interaction = 943:
    $interaction_type = 'talk'
    txt_count = 1
    if slave['praise'] = 0:
		$text[1] = ' 당신은 노예에게 <<$assistant_name>> 역시 살아 있고 감정을 가진 사람이며, 조수가 겪었던 것과 같은 불행을 겪어 온 존재라고 상기시킨다. 노예는 당신의 말을 곱씹기 위해 잠시 멈춘다. 적어도 조금이라도 그녀의 조수에 대한 태도가 나아지길 바란다.'
