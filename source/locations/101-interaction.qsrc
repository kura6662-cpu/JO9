		$text[1] = '  미노타우로스들은 보통 자신들이 수정시키는 여자들을 다치게 하지 않도록 조심하지만, 그 과정은 젖소들에게 종종 고통스럽고 지치는 일이다. 하지만 결과가 너무나 효과적이어서, 모든 농부가 높은 생산성을 원할 때면 이 짐승들을 이용한다. 비용을 생각하면, 다시 한 번 비용을 치르기 전에 젖소의 수정 등급이 F까지 떨어질 때까지 기다리는 편이 가장 좋을지도 모른다.'
! JO9 MOD END RNL124
		interaction_cow['erotic_stimulation'] = 10
		ejaculation_intensity = 0 &! master is not involved
		dynamic $replace($vaginally_penetrated, 'dyn'+'slave', 'cow')
		dynamic $cow_energy_drop
		dynamic $cow_energy_drop &! extra energy drop compared to group insemination
		dynamic $inseminate, 'cow' &! sex with minotaur
		cow['cum_load'] += rand(100,110) &! needed because ejaculation_intensity = 0
		if rand(1,12) > cow['stamina'] and cow['ill'] = 0: cow['ill'] = 1
		if cow['virginity'] = 3: damage = 10 - (cow['sub_horse'] + cow['sub_fisting']) &! calibrated to wound unless stamina is at least A+ and both skills are at least B+
		if cow['virginity'] < 3: damage = 14 - (cow['sub_horse'] + cow['sub_fisting']) &! calibrated to always wound (note that virginity < 3 implies low skill levels)
		cow_rate['sensitivity'] -= damage/2 &! before calling $dyn_slave_damaged, which resets damage global
		if damage > 0: dynamic $replace($dyn_slave_damaged, 'dyn'+'slave', 'cow')
		if cow['sub_horse'] < 5: cow['sub_horse'] += 1 & cow['sub_horse_xp'] = 0
		if cow['sub_horse'] > 2: cow['virginity'] = 3
		cow_rate['instinct'] += 1
! JO9 MOD START COG_DIRECT_26 | 2026-10-16_innate_learning_traits
! JO9 MOD START J9TP_GAIN_24 | 2026-10-17_traits_personality
		cow_rate['cowSK'] += func('jo9_traits_personality', 'xp', 'cow', 'cowSK', func('jo9_learning_xp', (1), cow['jo9_learning_trait'], 'cowSK'))
! JO9 MOD END J9TP_GAIN_24
! JO9 MOD END COG_DIRECT_26
		if cow_state = CONST_INT['slave_exist']: cow_rate['stamina'] += 1 &! not unconscious
		house_mess_rate += 10
		cow_rate['hygiene'] += 25
	}
	$place = 'barn'
end


