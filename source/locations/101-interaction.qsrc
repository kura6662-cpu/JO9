			$text[1] = '  당신은 노예에게 아직 그녀의 새 이름을 생각 중이라고 말해 준다. 그래도 그녀가 자신은 당신의 소유물이고, 당신은 원하는 대로 그녀의 이름을 정할 수 있다는 사실만은 이해하는 것이 중요하다.'
		end
	}
end

!Slave/Assistant relationships
!gs 'interaction.relations'


!lab
if interaction = 21:
	$place = 'lab'
	$return_lock = 'menu_form'
	if assistant['alchemist_rule'] = 1 and assistant_state = CONST_INT['slave_exist']:
		copyarr '$sp_text', '$assistant_alchemist'
	else
		copyarr '$sp_text', '$slave_alchemist'
	end
	copyarr '$display_options', '$lab_options'
	if debug_interactions ! 2: gt 'shop_general'
end

$interaction_brew_potion = {
	npc = 0
	$place = 'lab'
	$return_lock = 'menu_form'
	$get_pot = 'самогон'
	brewing_skill = min(dynslave['alchemy'], dynslave['enchanter'])
	if put_kanabis = 0:
		if min(lab_store['koffe'], lab_store['meth'], lab_store['opium']) = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
		if $potion_base = 'water' and brewing_skill > 0: $get_pot = 'вакхический_нектар'
		if $potion_base = 'spirit':
			if fridge['alcohol'] = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
			if brewing_skill > 1: $get_pot = 'тонизируюзщий_эликсир'
		end
		if $potion_base = 'slime':
			if lab_store['slime'] = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
			if brewing_skill > 2: $get_pot = 'целительный_бальзам'
		end
	end
	if put_koffe = 0:
		if min(lab_store['kanabis'], lab_store['meth'], lab_store['opium']) = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
		if $potion_base = 'slime': 
			if lab_store['slime'] = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
			if brewing_skill > 4: $get_pot = 'приворотное_зелье'
		end
	end
!각인의 물약 조합식
	if put_koffe = 0:
		if min(lab_store['kanabis'], lab_store['meth'], lab_store['opium']) = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
		if $potion_base = 'spirit':
			if fridge['alcohol'] = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
			if dynslave['alchemy'] > 4: $get_pot = 'brainwashing_potion'
		end
	end	
	if put_meth = 0:
		if min(lab_store['kanabis'], lab_store['koffe'], lab_store['opium']) = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
		if $potion_base = 'water' and brewing_skill > 4: $get_pot = 'вода_леты'
		if $potion_base = 'spirit':
			if fridge['alcohol'] = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
			if brewing_skill > 3: $get_pot = 'вода_леты'
		end
		if $potion_base = 'slime':
			if lab_store['slime'] = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
			if brewing_skill > 2: $get_pot = 'вода_леты'
		end
	end
	if put_opium = 0:
		if min(lab_store['kanabis'], lab_store['koffe'], lab_store['meth']) = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
		if $potion_base = 'spirit':
			if fridge['alcohol'] = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
			if brewing_skill > 1: $get_pot = 'афродизиак'
		end
		if $potion_base = 'slime':
			if lab_store['slime'] = 0: interaction = 23 & gt 'interaction' &! insufficient ingredients
			if brewing_skill > 2: $get_pot = 'мощный_афодизиак'
		end
	end
	! deduct ingredients from storage
	if $potion_base = 'spirit': fridge['alcohol'] -= 1
	if $potion_base = 'slime': lab_store['slime'] -= 1
	if put_kanabis > 0: lab_store['kanabis'] -= 1
	if put_koffe > 0: lab_store['koffe'] -= 1
	if put_meth > 0: lab_store['meth'] -= 1
	if put_opium > 0: lab_store['opium'] -= 1
	$special_action[1] = { $return_lock = 'interaction' & interaction = 21 & sp_txt = 0 }
! JO9 MOD START J9M1679 | 2026-10-15_trim_leading_body_blank_lines | changed block; context may be included
	$text[1] = '<center> 모든 재료들이 혼합되었을 때에야 비로소 비약들이 만들어집니다.<br><br> 질높은 연금 장비들을 적절히 사용하여 증류하고 양조해주세요.<br><br> 그 다음, 스파크의 힘을 가득히 담아 내어야만 마법깃든 영약이 완성됩니다.</center>'
! JO9 MOD END J9M1679
	$text[2] = $get_pot_description[$get_pot]
	if $get_pot = 'самогон':
		fridge['alcohol'] += 1
	else
		dynamic "<<$get_pot>> += 1"
		sparks -= 1
	end
	dynslave['half_action'] += 1
	dynslave_rate['hygiene'] += 5
	if sound_on = 1: play 'content\snd\bulk.wav', sound_volume
}

if interaction = 22:
	if assistant['alchemist_rule'] = 1 and assistant_state = CONST_INT['slave_exist']:
		dynamic $replace($interaction_brew_potion, 'dynslave', 'assistant')
	else
		dynamic $replace($interaction_brew_potion, 'dynslave', 'slave')
	end
end

