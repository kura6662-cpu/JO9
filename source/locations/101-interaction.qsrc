			$text[1] += '오라 귀속 의상을'
		end
	else
		if tmp_armor = 1: $text[1] += '멀쩡한 갑옷을'
		if tmp_jewelry = 1: $text[1] += '오라 귀속 장신구를'
		if tmp_clothes = 1: $text[1] += '오라 귀속 의상을'
	end
	$tmp = ''
	if tmp_weapons ! 0: $text[1] += ', 그리고 무장까지 하고 있다'
	if tmp_armor + tmp_weapons = 2:
		$tmp = ' 그녀의 무기와 갑옷, 그리고'
	elseif tmp_weapons ! 0:
		$tmp = ' 그녀의 무기와'
	elseif tmp_armor ! 0:
		$tmp = ' 그녀의 갑옷과'
	end
	$text[1] += '. 그녀에게<<$tmp>> '
	if tmp_clothes > 0:
		$text[1] += '몸에 걸친 옷을 남겨 둘까?'
	else
		$text[1] += '당신이 그녀에게 사 준 장신구를 남겨 둘까?'
	end
	$yes = {
		dynamic $clear_slave_instance, 'slave'
		gt 'menu_form'
	}
	$no = {
		if $slave['armor'] ! 'без_брони': dynamic '<<$slave["armor"]>> += 1'
		if $slave['back_wpn'] ! '': dynamic '<<$slave["back_wpn"]>> += 1'
		if $slave['left_wpn'] ! '': dynamic '<<$slave["left_wpn"]>> += 1'
		if $slave['right_wpn'] ! '': dynamic '<<$slave["right_wpn"]>> += 1'
		!aura-bound items cannot be reused
		!inventory[$slave['cloth']] += 1
		!inventory[$slave['headband']] += 1
		!inventory[$slave['collar']] += 1
		!inventory[$slave['gloves']] += 1
		!inventory[$slave['boots']] += 1
		!inventory[$slave['ring_left']]  += 1
		!inventory[$slave['ring_right']]  += 1
		!inventory[$slave['earrings']] += 2
		!inventory[$slave['tongue']]  += 1
		!inventory[$slave['nipplerings']] += 2
		!inventory[$slave['navel']] += 1
		!inventory[$slave['clitring']] += 1
		dynamic $clear_slave_instance, 'slave'
		gt 'menu_form'
	}
	menu_form = 0
	if debug_interactions ! 2: gt 'choice_screen'
end


