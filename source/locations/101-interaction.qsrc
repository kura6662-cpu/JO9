! JO9 MOD END J9TP_GAIN_23
! JO9 MOD END COG_DIRECT_29
		master_hygiene_rate += 1 + assistant['nurse']
		assistant_rate['hygiene'] += 1 + assistant['nurse']
		house_mess_rate += 1 + assistant['nurse']
	}
