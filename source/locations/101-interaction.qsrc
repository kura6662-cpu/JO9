	interaction_slave['motivation_repulse'] = 5 - slave['stamina'] &! B+ endurance gains diligence at 3+ aura stats; A+ endurance at 2+ aura stats; S+ endurance at 1+ aura stats
	$refuse_txt = '  <<$slave_name>>는 체조를 거부한다. 복종을 가르쳐야 할 듯하다.'
	$misc_bonus = 'learn_bonus["stamina"]'
