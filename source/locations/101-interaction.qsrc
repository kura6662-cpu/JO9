			$text[1] = '  노예의 행동은 <<$slave_noun8[slave["age"]]>>가 전혀 애쓰려 하지 않는다는 것을 분명히 보여 준다. 가벼운 스트레칭을 잠깐 하는 정도로는 도저히 체조라고 할 수 없다.'
			if slave['energy'] <= 0: $text[1] += ' 그녀는 지쳐 보인다' + iif(slave['mood'] < 0, ', 그리고 비참해 보인다.', '.') &! condition is <= because energy drop happens before $special_part
		end
		if slave['stamina'] = 4 and slave['fat'] > 3: $text[1] += ' 그래도 지구력을 더 늘리려면 체중을 좀 줄여야 한다.'
		slave_rate['hygiene'] += 20
		house_mess_rate += 3
	}
	if hall = 1: $place = 'hall'
end

