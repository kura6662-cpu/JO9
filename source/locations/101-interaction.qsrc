	interaction_assistant['repulse'] = -4 + iif(assistant['intellect'] < 3, 3 - assistant['intellect'], 2 - assistant['intellect']) + iif(assistant['stamina'] < 3, -1, 0) &! Nursing lesson: -5 + (+1 per level of Intellect at C- or less | vice versa) (-1 if Endurance is C- or below | but not vice versa) - harder with low intellect, easier with high intellect, easier with low endurance
	interaction_assistant['motivation_repulse'] = 5 - assistant['intellect']
