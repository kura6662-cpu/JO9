!master washes himself - no bath rule - menu_take_bath
if interaction = 34:
	$interaction_type = 'special_png'
	$bg_path = 'scene\master_bathing'
	g = rand(1, picMax['master_bathing'])
	if g > 1: $bg_path += '_' + $str(g)
	$text[1] = $bathing_master_alone
	if bull_ring_on = 0: master_half_action += 1 &! no more infinite bathing - taking a bath consumes a half action - ImperatorAugustus
	if felicity = 1 and $quest12 ! 'fail' and active[$quest[12]] = 1: $quest12 = 'fail' & $quest12_failreason = '당신은 그녀가 당신의 목욕 시중 담당이라는 걸 잊은 모양이군.'
	master_hygiene_rate = 0
	master_hygiene = 0
	master_moodlet['pos_self_clean'] = 1
	house_mess_rate += 1
	$place = 'bathroom'
end

!master cooks
if interaction = menu_prepare_meal:
	$interaction_type = 'special'
	$bg_path = 'scene/master_cooking'
	g = rand(1, picMax['master_cooking'])
	if g > 1: $bg_path += '_' + $str(g)
	gs '$food_choice', master_butler &! consume ingredients, update last_cooked_food, cooked_food and $cooked_meal - lack of ingredients or skill limits meal quality - will only replace a lower quality meal
	$text[1] = $master_cook_description[last_cooked_food] &! description based on meal quality
	if last_cooked_food >= master_butler - boost_up['master_butler']: master_butler_rate += (skill_adv_mul * 1)
	if last_cooked_food = 0: easy_for_master = 1 &! preparing canned food is easy - ImperatorAugustus
	dynamic $master_energy_drop
	master_moodlet['neg_cook'] = max(0, 3 + master_cha - master_butler)
	master_hygiene_rate += 5
	house_mess_rate += 5
	$place = 'kitchen'
end

!master cleans the house
if interaction = 36:
	$interaction_type = 'special'
	$bg_path = 'scene/master_clean'
	g = rand(1, picMax['master_clean'])
	if g > 1: $bg_path += '_' + $str(g)
	$text[1] = $master_clean_description[master_butler]
	dynamic $master_energy_drop
	master_hygiene_rate += house_mess + 2
	if house_mess_rate > 80: house_mess_rate = 80
	house_mess_rate -= max(8,master_butler*16) &! D- is twice as effective as F- (previously, F- was completely ineffective) - ImperatorAugustus
	dynamic $house_cleaning
	if master_butler < 3 and house_mess = 0: house_mess_rate = 10 &! B+ skill or better is needed to reach perfect cleanliness
	master_moodlet['neg_cleaning'] = 1 + master_cha
	master_butler_rate += (skill_adv_mul * 1)
	$place = 'study'
end

