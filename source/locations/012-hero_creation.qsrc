# hero_creation
! Readable view; authoritative fields are in ../locations.json.
if snk_room_target > 0 and $curloc = 'hero_creation': gs 'snk_room_bridge', 'guard', 'hero_creation'
! JO9 MOD START J9M1525 | 2026-10-14_hide_outer_frame_on_startup | changed block; context may be included
*p '<style id="jo9_startup_no_outer_frame">body:before,body:after{display:none!important;}</style>'
! JO9 MOD END J9M1525
!Hero Creation Screen
!Overhauled by crushboss



!for msg
$MSG_BACKIMAGE = 'content\pic\msg_bg.png'
$MSG_OK_IMAGE = 'content/pic/buttons/ok-icon.png'
$MSG_FORMAT = '<div id="ink">%TEXT%</div>'
MSG_TEXT_X = 80
MSG_TEXT_Y = 50
MSG_TEXT_W = 380
MSG_TEXT_H = 400
MSG_OK_X = 250
MSG_OK_Y = 340
MSG_X = 200

!init vars

!if hero_choice > 100: gs '#var_base_woman'
gs '#var_base'

if hero_choice = 0: hero_choice = 1

if game_difficulty < 2:
	! Cheat codes are disabled for Extreme difficulty, except the age ones

	if $master_name = 'JeanGrey' and cheat_all_basic < 1:
		cheat_a = 2
		cheat_b = 2
		cheat_c = 2
		cheat_i = 2
		cheat_k = 2
		cheat_all_basic = 1
	end

	if $master_name = 'BlackWidow' and cheat_all_low < 1:
		cheat_a = 2
		cheat_b = 2
		cheat_c = 2
		cheat_i = 2
		cheat_k = 2
		cheat_l = 2
		cheat_all_low = 1
	end

	if $master_name = 'ScarletWitch' and cheat_all < 1:
		cheat_a = 2
		cheat_b = 2
		cheat_c = 2
		cheat_h = 2
		cheat_i = 2
		cheat_k = 2
		cheat_all = 1
	end

	if $master_name = 'BlackCat' and cheat_all_max < 1:
	! npc_reveal['realtor'] = 1
		cheat_a = 2
		cheat_b = 2
		cheat_c = 2
		cheat_i = 2
		cheat_j = 2
		cheat_all_max = 1
		faction_fame['serpis'] = 4
		faction_fame['taurus'] = 4
		faction_fame['kamira'] = 4
		faction_fame['korvus'] = 4
		faction_fame['neutral'] = 5
		noble_status = 1
		guild_reputation_rate += 40
		brand_rate += 20
	end

	if ($master_name = 'CrushBoss' and cheat_a < 1) or cheat_a = 2:
		hero_choice = 3
		cheat_m = 2
		master_excitement_rate = 200
		inventory['stethoscope'] = 1
		faction_fame['neutral'] = 1
		faction_fame['taurus'] = 1
		faction_fame['serpis'] = 1
		faction_fame['korvus'] = 1
		faction_fame['kamira'] = 1
		!Special Combat Techniques
		spm_learned['удар_с_разворота'] = 1
		spm_learned['рассечение'] = 1
		spm_learned['воинственный_клич'] = 1
		spm_learned['подрезка'] = 1
		spm_learned['ослепление'] = 1
		spm_learned['оглушение'] = 1
		spm_learned['ответный_удар'] = 1
		spm_learned['лицо_прикладом'] = 1
		$master_spm[1] = 'удар_с_разворота'
		$master_spm[2] = 'рассечение'
		$master_spm[3] = 'воинственный_клич'
		$master_spm[4] = 'подрезка'
		$master_spm[5] = 'ослепление'
		$master_spm[6] = 'оглушение'
		$master_spm[7] = 'ответный_удар'
		$master_spm[8] = 'лицо_прикладом'
		isabella_get = 1
		cheat_a = 1
	end

	if ($master_name = 'Thor' and cheat_b < 1) or cheat_b = 2:
		!Estate
		$estate = 'white_house'
		faction_fame['neutral'] = 1
		faction_fame['korvus'] = 0
		$starting_area = '<font color="009900">백색 도시</font>'
		$estate = 'white_house'

		!Extended Rental
		extended_rental_cheat = 5
		lab = 1
		boudoir = 1
		dungeon = 1
		barn = 1
		bath = 1
		kitchen = 1
		pen = 1
		arachnidSpider = 1
		polypusvermin = 1

		!Estate Interiors
		$study = 'classic'
		$bed = 'stylish'
		$bath = 'gothic'
		$dungeon = 'executor'
		$kitchen = 'basic'
		$lab = 'basic'
		$boudoir = 'gothic'

		!Starting Money
		sparks += 25000

		!Standard of Living, Brand Rate, Faction Fame, & Misc
		master_wealth_target = 6
		master_wealth = 6
		brand_rate += 50
		faction_fame['neutral'] = 1
		faction_fame['taurus'] = 1
		faction_fame['serpis'] = 1
		faction_fame['korvus'] = 1
		faction_fame['kamira'] = 1
		cheat_b = 1
	end

	if ($master_name = 'Hulk' and cheat_c < 1) or cheat_c = 2:
		!Estate
		$estate = 'white_house'
		faction_fame['neutral'] = 1
		$starting_area = '<font color="009900">백색 도시</font>'

		!Stat adjustments
		master_str = 5
		master_libido = 5
		master_domination = 5

		!Weapon and Armor Inventory
		фламберг = 6
		нагината = 6
		моргенштерн = 6
		грейтекс = 6
		бита = 6
		скотобой = 6
		кнут = 6
		шпага = 6
		рапира = 6
		кончар = 6
		гладиус = 6
		бастард = 6
		мачете = 6
		катана = 6
		трезубец = 6
		демократизатор = 6
		кинжал = 6
		стилет = 6
		кастет = 6
		нагайка = 6
		глушилка = 6
		тесак = 6
		мулава = 6
		плейт = 6
		! кольчуга = 3
		! посох_огня = 1

		!Master Clothing Inventory
		! comfy_robes = 1
		! fancy_suit = 1
		regal_suit = 1
		formal_suit = 1
		aketon = 1
		livery = 1
		medic_robes = 1
		wizard_robes = 1

		raven_crown = 1
		chimera_earring = 1
		snake_amulet = 1
		bull_ring = 1
		obereg = 1

		!Master Armor, Weapons, and Clothing Equipped
		$master_wpn = 'бастард'
		$master_scnd = ''
		$master_cloth = 'aketon'
		$master_armor = 'плейт'
		$master_back_wpn = 'нагината'
		$master_left_wpn = 'тесак'
		$master_right_wpn = 'бастард'
		$master_arm_wpn = 'кинжал'
		$master_leg_wpn = 'стилет'
		$master_head_gear = 'raven_crown'
		$master_earring = 'chimera_earring'
		$master_amulet = 'snake_amulet'
		$master_ring = 'bull_ring'
		$master_karman = 'obereg'
		raven_crown_on = 1
		chimera_gem_on = 1
		snake_amulet_on = 1
		bull_ring_on = 1
		obereg_on = 1
		item_supermacy_bonus += 5

		!Master fridge Inventory
		fridge['vegetables'] = 30
		fridge['grain'] = 25
		fridge['spice'] = 30
		fridge['cheese'] = 25
		fridge['eggs'] = 25
		fridge['milk'] = 25
		fridge['cream'] = 25
		fridge['mince'] = 25
		fridge['meat'] = 30
		fridge['alcohol'] = 60
		spawn_semen = 120

		!Lab Inventory
		lab_store['slime'] = 12
		lab_store['kanabis'] = 30
		lab_store['koffe'] = 30
		lab_store['meth'] = 30
		lab_store['opium'] = 30

		!Potion Inventory
		вакхический_нектар = 20
		тонизируюзщий_эликсир = 30
		целительный_бальзам = 30
		приворотное_зелье = 20
		мощный_афодизиак = 20
		вода_леты = 10
		метаболизм_плюс = 10
		метаболизм_минус = 10
		жир_плюс = 10
		жир_минус = 10

		!BSDM Inventory
		inventory['deprivation_suit'] = 1
		inventory['vaginal_balls'] = 1
		inventory['anal_plug'] = 1
		inventory['secure_gag'] = 1
		inventory['chastity_belt'] = 1
		inventory['pissuar_stable'] = 1
		inventory['toilet_stable'] = 1
		inventory['stethoscope'] = 1
		vibrator = 1
		cheat_c = 1
	end

	if $master_name = 'BruceLee' and cheat_d < 1:
		sparks += 5000
		hero_points = 1600
		master_fighter = 5
		cheat_d = 1
	end

	if ($master_name = 'Elektra' and cheat_h < 1) or cheat_h = 2:
		cheat_h = 1
	end

	if ($master_name = 'Isabella' and cheat_i < 1) or cheat_i = 2:
		cheat_i = 1
	end

	if ($master_name = 'Deathstrike' and cheat_j < 1) or cheat_j = 2:
		cheat_j = 1
		cheat_h = 0
	end

	if ($master_name = 'Rogue' and cheat_k < 1) or cheat_k = 2:
		cheat_k = 1
	end

	if ($master_name = 'Enchantress' and cheat_l < 1) or cheat_l = 2:
		cheat_l = 1
	end

	if ($master_name = 'Qwerty' and cheat_m < 1) or cheat_m = 2:
		master_str = 5
		master_cha = 5
		master_style = 5
		master_libido = 5
		master_tutor = 5
		master_fighter = 5
		master_butler = 5
		master_artdirector = 5
		master_medic = 5
		master_mage = 5
		master_torture = 5
		master_domination = 5
		master_bondage = 5
		master_flagelation = 5
		master_petting = 5
		master_oral = 5
		master_penetration = 5
		master_fetish = 5
		master_excitement = 5
		cheat_m = 1
	end

end &! end of game difficulty check

if no_loli ! 1 and (($master_name = 'loli' and cheat_e < 1) or cheat_e = 2):
	cheat_e = 1
	cheat_f = 0
	cheat_g = 0
end
if cheat_e > 0:
	*p '<div style="position:absolute;top:0px;left:0px;font-family:Kaushan Script;color:#FFFFFF;font-size:16px;">로리 노예 전용</div>'
end

if ($master_name = 'young' and cheat_f < 1) or cheat_f = 2:
	cheat_f = 1
	cheat_e = 0
	cheat_g = 0
end
if cheat_f > 0:
	*p '<div style="position:absolute;top:0px;left:0px;font-family:Kaushan Script;color:#FFFFFF;font-size:16px;">젊은 노예만</div>'
end

if (($master_name = 'mature' or $master_name = 'milf') and cheat_g < 1) or cheat_g = 2:
	cheat_g = 1
	cheat_e = 0
	cheat_f = 0
end
if cheat_g > 0:
	*p '<div style="position:absolute;top:0px;left:0px;font-family:Kaushan Script;color:#FFFFFF;font-size:16px;">성숙한 노예만</div>'
end

if cheat_a > 0 or cheat_b > 0 or cheat_c > 0 or cheat_d > 0 or cheat_h > 0 or cheat_i > 0 or cheat_j > 0 or cheat_k > 0 or cheat_l > 0 or cheat_all > 0 or cheat_all_basic > 0 or cheat_all_low > 0 or cheat_all_max > 0 or isabella_get > 0:
	*p '<div style="position:absolute;top:23px;left:0px;font-family:Kaushan Script;color:#FFFFFF;font-size:16px;">치트 활성화됨</div>'
end

IF hero_choice = 114 or hero_choice = 119 or hero_choice = 120 or hero_choice = 12 or hero_choice = 17 or hero_choice = 18:
	master_vampire = 1
ELSE
	master_vampire = 0
END


if no_loli ! 1 and game_difficulty ! 0:
	if hero_choice = 9 and master_libido > 1: dynamic $lower_libido & gt $curloc &! Uncle Tom is always impotent in loli version
	if hero_choice = 9 and master_libido = 1: dynamic $lower_libido & msg '이 캐릭터는 도전용 캐릭터입니다. 성욕은 보통 또는 극한 난이도에서 고정됩니다.' & gt $curloc

	if hero_choice = 9 and ($estate = 'white_house' or $estate = 'korvus_house'): dynamic $lower_rep & gt $curloc
	if hero_choice = 9 and $estate = 'taurus_house': dynamic $lower_rep & msg '이 캐릭터는 도전용 캐릭터입니다. 보통 또는 극한 난이도에서는 백색 도시, 네크로폴리스, 황소 구역에서 시작할 수 없습니다.' & gt $curloc
end

if game_difficulty ! 0 and $estate = 'white_house': dynamic $lower_rep & msg '보통 또는 극한 난이도에서는 백색 도시에서 시작할 수 없습니다. 그곳에는 귀족만 거주할 수 있습니다.' & gt $curloc

$master_ava = $sepia_ava_path[hero_choice]
$master_ava_color = $clear_ava_path[hero_choice]

*p '<div id = "title_scroll"><img src = "content\pic\scroll_large.png"></div>'

!Choose game difficulty feature - ImperatorAugustus
if first_visit['hero_creation'] = 0:
	first_visit['hero_creation'] = 1 &! do-once

	game_difficulty = 1
	$difficulty_description[0] = '쉬움'
	$difficulty_description[1] = '보통'
	$difficulty_description[2] = '극한'
end

if custom_game = 1:
	*p '<div style="position:absolute;top:25px;left:490px;font-family:Sandoll 미생;"><table><tr>'
	*p '<td style="width:100px"><font size="7">난이도:</font></td>'
	*p '<td><a href = "EXEC: dynamic $game_difficulty_decrease"><img src="content/pic/buttons/Minus.png"></a></td>'
	*p '<td><center><font size="7"><<$difficulty_description[game_difficulty]>></font></center></td>'
	*p '<td><a href = "EXEC: dynamic $game_difficulty_increase"><img src="content/pic/buttons/Plus.png"></a></td>'
	*p '</tr></table></div>'
end

*p '<div id = "title_scroll_text_left">'
*nl '<a href = "EXEC: dynamic $rise_rep & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_rep & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $rep_message & gt $curloc"><<$starting_area>></a>'
*nl '<a href = "EXEC: dynamic $rise_str & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_str & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $сила_с_справка & gt $curloc"><<$master_str[master_str]>></a>'
*nl '<a href = "EXEC: dynamic $rise_cha & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_cha & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $харизма_с_справка & gt $curloc"><<$master_cha[master_cha]>></a>'
*nl '<a href = "EXEC: dynamic $rise_libido & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_libido & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $возбуждение_с_справка & gt $curloc"><<$master_libido[master_libido]>></a>'
*nl '<a href = "EXEC: dynamic $rise_domination & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_domination & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $доминирование_с_справка & gt $curloc"><<$master_domination[master_domination]>></a>'
*nl '<u>기술:</u>'
if game_difficulty = 0:
	*p '&nbsp;<a href = "EXEC: cheat_m = 2 & hero_points = 895 & gt $curloc"><img src="content/pic/buttons/teach_s.png"></a>'
end
*nl '<a href = "EXEC: dynamic $rise_tutor & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_tutor & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $учитель_с_справка & gt $curloc"><<$master_tutor[master_tutor]>></a>'
*nl '<a href = "EXEC: dynamic $rise_butler & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_butler & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $дворецкий_с_справка & gt $curloc"><<$master_butler[master_butler]>></a>'
*nl '<a href = "EXEC: dynamic $rise_artdirector & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_artdirector & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $артдиректор_с_справка & gt $curloc"><<$master_artdirector[master_artdirector]>></a>'
*nl '<a href = "EXEC: dynamic $rise_medic & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_medic & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $медик_с_справка & gt $curloc"><<$master_medic[master_medic]>></a>'
*nl '<a href = "EXEC: dynamic $rise_fighter & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_fighter & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $боец_с_справка & gt $curloc"><<$master_fighter[master_fighter]>></a>'
*nl '<a href = "EXEC: dynamic $rise_mage & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_mage & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $маг_с_справка & gt $curloc"><<$master_mage[master_mage]>></a>'
*nl '<a href = "EXEC: dynamic $rise_flagelation & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_flagelation & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $флагеляция_с_справка & gt $curloc"><<$master_flagelation[master_flagelation]>></a>'
*nl '<a href = "EXEC: dynamic $rise_torture & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_torture & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $палач_с_справка & gt $curloc"><<$master_torture[master_torture]>></a>'
*nl '<a href = "EXEC: dynamic $rise_bondage & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_bondage & gt $curloc ">[-]</a>&nbsp<a href="EXEC: msg $бондаж_с_справка & gt $curloc"><<$master_bondage[master_bondage]>></a>'
*nl '<u><a style = "color: #191970;" href="EXEC: msg $секс_техники_с_справка & gt $curloc">섹스 테크닉:</a></u>'
*nl '<a href = "EXEC: dynamic $rise_petting & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_petting & gt $curloc ">[-]</a>&nbsp<<$master_petting[master_petting]>>'
*nl '<a href = "EXEC: dynamic $rise_penetration & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_penetration & gt $curloc ">[-]</a>&nbsp<<$master_penetration[master_penetration]>>'
*nl '<a href = "EXEC: dynamic $rise_oral & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_oral & gt $curloc ">[-]</a>&nbsp<<$master_oral[master_oral]>>'
*nl '<a href = "EXEC: dynamic $rise_fetish & gt $curloc ">[+]</a>/<a href = "EXEC: dynamic $lower_fetish & gt $curloc ">[-]</a>&nbsp<<$master_fetish[master_fetish]>></div>'

!отдельный класс чтобы блок не съезжал при длинном имени
*p '<div style="position:absolute;top:160px;left:450px;width:420px;font-family:Sandoll 미생;color:#191970;font-size:30px;">이름: <<$master_name>> <a href = "EXEC: dynamic $name_type">[변경]</a></div>'

*p '<div id = "title_scroll_text_right"><center>'
if game_difficulty ! 0:
	*p '포인트:'
	*nl iif(hero_points < 0, '<font color="#cd0000"><<hero_points>></font>', '<font color="#009900"><<hero_points>></font>')
else
	*nl
end

*nl '<a href = "EXEC: dynamic $scroll_ava_back & gt $curloc"><img src = "content\pic\buttons\back_button.png"></a> 외형 <a href = "EXEC: dynamic $scroll_ava & gt $curloc"><img src = "content\pic\buttons\forward_button.png"></a>'
*p '</center></div>'
*p '<div id = "title_scroll_text_rightmid"><img src = "<<$master_ava>>"></div>'

*p '<div id = "close_scroll"><a href = "EXEC: hero_points = 0 & gt ''main_menu''"><img src = "content\pic\buttons\close_button.png"></a></div>'
if (hero_points >= 0 and sparks >= 200) or game_difficulty = 0:
	*p '<div style="position:absolute;top:715px;left:580px;font-family:Sandoll 미생;font-size:36px;"><a style = "color: black;" href = "EXEC: gt ''start_game''">{ 시작 }</a></div>'
end

*p '<div id = "title_scroll_text_rightlow">'
*nl '<br><u>커스터마이즈 비용:</u>'
*nl '<font color="#009900">경이로움</font>'
*nl '<font color="#009FEF">탁월함</font>'
*nl '<font color="#0000D8">좋음</font>'
*nl '<font color="#6B0084">미흡함</font>'
*nl '<font color="#EA0090">나쁨</font>'
*nl '<font color="#cd0000">최악</font></div>'

*p '<div style="position:absolute;top:440px;left:855px;font-family:Kaushan Script;"><br>'
*nl '<br><font color="#009900">80 점</font>'
*nl '<font color="#009FEF">40 점</font>'
*nl '<font color="#0000D8">20 점</font>'
*nl '<font color="#6B0084">10 점</font>'
*nl '<font color="#EA0090">5  점</font>'
*nl '<font color="#cd0000">0  점</font></div>'

if game_difficulty = 0:
	*p '<div style="position:absolute;top:445px;left:755px;font-family:Kaushan Script;"><a style = "color: black;" href = "EXEC: msg $patrician_mode_help & gt $curloc"><u>귀족</u>:</a></div>'
	if get_initial_slave = 1:
		*p '<div style="position:absolute;top:448px;left:870px;"><a href = "EXEC: get_initial_slave = 0 & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
	else
		*p '<div style="position:absolute;top:451px;left:870px;"><a href = "EXEC: get_initial_slave = 1 & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
	end
else
	*p '<div style="position:absolute;top:445px;left:755px;font-family:Kaushan Script;"><a style = "color: black;" href = "EXEC: msg ''  이 옵션이 비활성화되어 있으면, 선택한 노예상의 배경 이야기와 맞지 않는 기술과 능력치는 올리는 데 훨씬 더 많은 노력이 필요합니다. 배경 이야기를 보려면 메인 메뉴에서 일반 시작을 선택하세요. 이는 힘, 전투, 예술성, 마법, 의술, 그리고/또는 관리 능력에 영향을 줄 수 있습니다.'' & gt $curloc"><u>스토리 무시</u>:</a></div>'
	if slaver_background_matters = 0:
		*p '<div style="position:absolute;top:448px;left:870px;"><a href = "EXEC: slaver_background_matters = 1 & gt $curloc"><img src="content\pic\buttons\sel_button.png"></a></div>'
	else
		*p '<div style="position:absolute;top:451px;left:870px;"><a href = "EXEC: slaver_background_matters = 0 & gt $curloc"><img src="content\pic\buttons\unsel_button.png"></a></div>'
	end
end

!Choose starting sparks feature - crushboss
if custom_game = 1:
	*p '<div style="position:absolute;top:90px;left:485px;font-family:Sandoll 미생;"><table><tr>'
	*p '<td style="width:100px"><font size="7">스파크:</font></td>'
	*p '<td><a href = "EXEC: dynamic $sparks_decrease"><img src="content/pic/buttons/Minus.png"></a></td>'
	*p '<td><center><font color="<<iif(sparks < 200, ''#cd0000'', ''#0000D8'')>>" size="6"><<sparks>></font></center></td>'
	*p '<td><a href = "EXEC: dynamic $sparks_increase"><img src="content/pic/buttons/Plus.png"></a></td>'
	*p '</tr></table></div>'
end

!Choose starting factions feature - crushboss
