! JO9 MOD START J9M1290 | 2026-10-16_meiki_tentacle_success_safe_icon | changed block; context may be included
	if slave['sub_tentacles'] > tentacle_size or slave['virginity'] = 4:
		if slave['virginity'] = 4:
			$text = '%명기착정성공'
		else
			$text = '  <<$slave_name>>는 양동이를 들고 안개 괴물 우리로 간다. 이전 경험 덕분에 그녀는 자제력을 잃지 않고 해낸다. 만족할 줄 모르는 미끈한 촉수 몇 개가 그녀의 모든 구멍을 파고드는 동안, 그녀는 다른 촉수들을 붙잡고 그것들을 양동이 안으로 직접 짜낸다. 획득한 안개 괴물 정액: <<semen_gain[max(0, tentacle_size - spawn_milked)]>>'
		end
! JO9 MOD END J9M1290
		decade_semen += semen_gain[max(0, tentacle_size - spawn_milked)]
		spawn_milked += slave['sub_tentacles']
		if spawn_milked > tentacle_size: tentacle_state = 2 &! satisfied
		if felicity = 1 and $quest12 ! 'fail' and active[$quest[12]] = 1 and slave_type ! 2572: $quest12 = 'fail' & $quest12_failreason = '노예상, 당신의 노예에게 당신의 괴물를 돌보게 하지 않았던 모양이군.'
		if assistant_quiet_rule = 0: jump 'loop'
	else
		$text = '  <<$slave_name>>는 양동이를 들고 안개 괴물 우리로 간다. 하지만 그 물건을 짜내려는 그녀의 노력은 아무 성과도 내지 못한다. 강력한 촉수들에 휘감긴 채, 네 노예는 현실감각을 완전히 잃고 안개 괴물이 그녀의 구멍들에 씨앗을 퍼부을 때까지 절정에 절정을 거듭한다.'
