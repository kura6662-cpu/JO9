! JO9 MOD END J9M1297
!End Day Screen
!Overhauled by crushboss

gs '_layout'

killvar '$text'
menu_form = 0
$info_bar = ''
$place = ''
$npc_id = ''
$interaction_type = ''
$bg_path = ''
png = 0
npc = 0

if end_day_phase = 0:
	end_day_phase = 1
	$toplay = 'night' & dynamic $play_music &! due to an engine bug the night music will sometimes continue playing during the day - ImperatorAugustus
end

if end_day_phase = 2:
	dynamic $home_sounds
end

if exam_in_progress = 1:
	gs 'demo_estate'
	slave['energy'] = slave['stamina']
end

if slave_auto_rest = 1:
	slave_auto_rest = 0
	$text = $idle[rand(1,5)]
	$bg_path = func('display_pic', 'slave', 'rest', 'girls/normal_scenes/')
	$place = 'bedroom'
	if assistant_quiet_rule = 0: jump 'loop'
end

if slave_auto_cook = 1:
	slave_auto_cook = 0
	assistant_auto_cook = 0
	master_auto_cook = 0
	room1_auto_cook = 0
	room2_auto_cook = 0
	room3_auto_cook = 0
	room4_auto_cook = 0	
	$bg_path = func('display_pic', 'slave', 'cook', 'girls/normal_scenes/')
	$place = 'kitchen'
	slave_skill = min(slave['cook'], max(1, slave['mood']))
	dynamic $replace("$text = '  <<$slave_cook_description[min(slave_skill, cooked_food_plus)]>>'", 'dyn'+'slave', 'slave') &! description based on lesser of meal quality or skill
	if assistant_quiet_rule = 0: jump 'loop'
end

