$next_day_stamina_update = {
	!Revised by ImperatorAugustus (moved everything inside slave_faint condition, removed skill_adv_mul - this is recovery, not training)
	!Conscious slaves no longer gain endurance passively from here (they can still recover endurance up to B+ passively from diet if they have excess calories at day-end)
	if dynslave_state = CONST_INT['slave_faint']:
		if dynslave['stamina'] > 0 and dynslave['fat'] > 0:
			! Slave wakes up if endurance and physique are both above F-
			dynslave_state = CONST_INT['slave_exist']
			!removed stamina drop when waking - not all forms of unconsciousness are harmful, and we have other mechanisms for reducing stamina - ImperatorAugustus
