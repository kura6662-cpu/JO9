# next_day
! Readable view; authoritative fields are in ../locations.json.
! JO9 MOD START J9M1558 | 2026-10-10_restore_private_room_ui_corrections | changed block; context may be included
if snk_room_target > 0 and $curloc = 'next_day': gs 'snk_room_bridge', 'guard', 'next_day'
gs 'snk_room_diet_migrate'
! JO9 MOD END J9M1558

*p '	'
!Next Day
!Overhauled by crushboss

! forfeit occupied rentals and their occupants if ending day without the necessary facility (moving to another rental same day simply transfers slaves to equivalent rental in new residence building)
if kitchen = 0:
	fridge['vegetables'] = 0
	fridge['grain'] = 0
	fridge['spice'] = 0
	fridge['mince'] = 0
	fridge['meat'] = 0
	fridge['virgin_meat'] = 0
	fridge['eggs'] = 0
	fridge['milk'] = 0
	fridge['cream'] = 0
	fridge['cheese'] = 0
end

if dungeon = 0 and prisoner_state > CONST_INT['no_slave']: dynamic $clear_slave_instance, 'prisoner'

if barn = 0:
	if farmhand_state > CONST_INT['no_slave']: dynamic $clear_slave_instance, 'farmhand'
	if harpy_state > CONST_INT['no_slave']: dynamic $clear_slave_instance, 'harpy'
	if cow_state > CONST_INT['no_slave']: dynamic $clear_slave_instance, 'cow'
	if pig_state > CONST_INT['no_slave']: dynamic $clear_slave_instance, 'pig'
end

if pen = 0:
	if pet_tentacle > 0:
		pet_tentacle = 0
		tentacle_size = 0
		tentacle_hp = 0
	end
end

slave["rewarded_today"] = 0
assistant["rewarded_today"] = 0

gs '#var_base'
gs '#txt' &! after #var_base
gs '#txt_2' &! after #var_base

killvar 'play_sound'
killvar '$text'
killvar 'sex'
killvar 'sex_num'
killvar 'sex_done_today'
killvar 'sex_done_thisperson'
killvar 'assistant_already_sex_today'
killvar 'slave_already_sex_today'
killvar 'суперудар_сделан'
killvar 'cure_room1_ill'
killvar 'room1_abortion'
killvar 'room1_insidous_abortion'
killvar 'room1_stimulation'
killvar 'cure_room2_ill'
killvar 'room2_abortion'
killvar 'room2_insidous_abortion'
killvar 'room2_stimulation'
killvar 'cure_room3_ill'
killvar 'room3_abortion'
killvar 'room3_insidous_abortion'
killvar 'room3_stimulation'
killvar 'cure_room4_ill'
killvar 'room4_abortion'
killvar 'room4_insidous_abortion'
killvar 'room4_stimulation'

!Считаем динамику отношений в конце дня - mrross
if slave_state = CONST_INT['slave_exist'] and assistant_state = CONST_INT['slave_exist']: 
	sa_rel = 1
	gs 'relations_fastcalc'
	sa_rel = 2
	gs 'relations_fastcalc'
end
if slave_state = 1: 
	sa_rel = 1
	gs 'master_love'
	sa_rel = 0
end	
if assistant_state = 1: 
	sa_rel = 2
	gs 'master_love'
	sa_rel = 0
end

!Обратный таймер приказов - mrross
if slave['isolate'] > 0 and RAND(0, slave['obedience'] * 2) <= 0: slave['isolate'] -= 1
if assistant['isolate'] > 0 and RAND(0, assistant['obedience'] * 2) <= 0: assistant['isolate'] -= 1
if slave["smear"] > 0: slave["smear"] -= 1
if assistant["smear"] > 0: assistant["smear"] -= 1
if slave["praise"] > 0: slave["praise"] -= 1
if assistant["praise"] > 0: assistant["praise"] -= 1
if slave['teambuilding_1'] > 0: slave['teambuilding_1'] -= 1
if assistant['teambuilding_1'] > 0: assistant['teambuilding_1'] -= 1
if slave['teambuilding_2'] > 0: slave['teambuilding_2'] -= 1
if assistant['teambuilding_2'] > 0: assistant['teambuilding_2'] -= 1
if slave['teambuilding_3'] > 0: slave['teambuilding_3'] -= 1
if assistant['teambuilding_3'] > 0: assistant['teambuilding_3'] -= 1
if slave['teambuilding_35'] > 0: slave['teambuilding_35'] -= 1
if assistant['teambuilding_35'] > 0: assistant['teambuilding_35'] -= 1
if slave['provoke_1'] > 0: slave['provoke_1'] -= 1
if assistant['provoke_1'] > 0: assistant['provoke_1'] -= 1
if slave['provoke_2'] > 0: slave['provoke_2'] -= 1
if assistant['provoke_2'] > 0: assistant['provoke_2'] -= 1
if slave['provoke_3'] > 0: slave['provoke_3'] -= 1
if assistant['provoke_3'] > 0: assistant['provoke_3'] -= 1
if slave['provoke_4'] > 0: slave['provoke_4'] -= 1
if assistant['provoke_4'] > 0: assistant['provoke_4'] -= 1
if slave['provoke_5'] > 0: slave['provoke_5'] -= 1
if assistant['provoke_5'] > 0: assistant['provoke_5'] -= 1

!Реакция ассистентки на мастера-вампира - mrross
if master_vampire >= 1 and assistant_type ! 2605:
	if assistant["blood_attitude"] > 0 or assistant["masochism"] > 0:
		assistant['pos_master_vampire'] = 1
		assistant_rate['arousal'] += assistant['sensitivity'] + assistant['temper'] - assistant['fear']
	elseif assistant['moral'] < 2:
		if assistant['courage'] ! 2: assistant['neg_master_vampire'] = 1
		assistant_rate["fear"] += 7 - assistant['ego'] - assistant["courage"]
	end
end


base_score += master_mood &! this should happen before daily vars are reset

$reset_daily_master_vars = {
	!Reset mood rate daily (persistent effects go in moodlets)
	master_mood_rate = 0 &! this var is adjusted later in next_day

	!Cap extra energy based on strength level (some carry-over is permitted) - ImperatorAugustus
	master_half_action = max(master_str * -2, master_half_action) &! more positive values are less energy

	!Following vars are not used anywhere else in next_day
	master_massaged = 0
	master_spaed = 0
	master_erected = 0
	master_styled = 0

	!Update daily counters (alone_count = days with no slave and no assistant)
	if slave_state < CONST_INT['slave_exist'] and assistant_state < CONST_INT['slave_exist']:
		!check < exist instead of = no_slave: living with dead slaves counts as being alone - ImperatorAugustus
		alone_count += 1
	end

	!Reduce energised level (from Tonic Elixir) slowly over time
	if master_energised > 5: master_energised -= ((48271 * day) mod 65537)/(65537/7)
}
dynamic $reset_daily_master_vars &! TODO: determine best placement of this

$next_day_update_daily_slave_vars = {
	if dynslave_state ! CONST_INT['no_slave']:
		! state check includes dead, conscious and fainted

		!Decay mood rate daily (persistent effects go in moodlets)
		dynslave_rate['mood'] /= 5 &! this var is adjusted later in next_day
		!note mood is not reset yet, so the ending mood for the day remains unchanged and can be referenced until the end of next_day - ImperatorAugustus
		!Lower rehabilitation time by one each day or reset it to zero if negative
		if dynslave['rehabilitation'] ! 0: dynslave['rehabilitation'] = max(0, dynslave['rehabilitation'] - 1)
		!Cap extra energy based on endurance level (some carry-over is permitted) - ImperatorAugustus
		dynslave['half_action'] = max(dynslave['stamina'] * -2, dynslave['half_action']) &! more positive values are less energy
		!Reset active spells (sententia veritas is intentionally omitted here so it can persist overnight)
		dynslave['domini_dictum'] = 0
		!Reset daily activity flags
		dynslave['beaten'] = 0
		dynslave['massaged'] = 0
		dynslave['tattoo_timeup'] = 0
		!Update style
		if dynslave['makeup'] ! 3: dynslave['makeup'] = 0
		if dynslave['perfume'] = 1: dynslave['perfume'] = 0
		if dynslave['epilation'] > 0: dynslave['epilation'] -= 1
		if dynslave['manicure'] > 0: dynslave['manicure'] -= 1
		if dynslave['hairstyle'] > 0: dynslave['hairstyle'] -= 1
		!removed hair hardcode state, hairfix
		!if dynslave['hairstyle'] > 0: dynslave['hairstyle_demo'] = 1
		! fixed the typo, by Lyazar
		if dynslave_inventory['perfume'] > 0: dynslave['perfume'] = 1
		!Reduce caught masturbating deterrence counter
		if dynslave['caught_masturbating'] > 0: dynslave['caught_masturbating'] -= 1
		!Reduce daring level slowly over time
		if dynslave['daring'] > 1: dynslave['daring'] -= ((48271 * (day + dynslave_type)) mod 65537)/(65537/3) &! this is used to limit merit, decreases here and increases in $dyn_repulse_check in #dynamic
		!Reduce energised level (from Tonic Elixir) slowly over time
		if dynslave['energised'] > 5: dynslave['energised'] -= ((48271 * (day + dynslave_type)) mod 65537)/(65537/7)
	end
}

dynamic $do_for_each_slave_in_list, '$next_day_update_daily_slave_vars', '$unfrozen_slave_characters' &! all except iced (see #dynamic and #static_base)

!decrement positive and negative moodlets
gs '$mod_master_drop', 1
gs '$mod_master_rise', 1
$next_day_moodlet_magnitude_update = {
	if dynslave_state > CONST_INT['no_slave']:
		gs '$mood_drop', 'dynslave', 1 &! lower magnitude of positive moodlets by 1
! JO9 MOD START J9TP_MEMORY_DECAY | 2026-10-17_traits_personality
		gs 'jo9_traits_personality', 'decay', 'dynslave' &! incident memory recovery; other moodlets retain -1
! JO9 MOD END J9TP_MEMORY_DECAY
	end
}
dynamic $do_for_each_slave_in_list, '$next_day_moodlet_magnitude_update', '$unfrozen_slave_characters'

!Debug
!msg 'total_food_cost = <<total_food_cost>>'
if search['active'] = 1: gs '$expert_search'
npc = 0

if debt_count > 0:
	debt_count -= 1
	if debt_count = 0 and debt > 0:
	dynamic $death, '<br> 이 불멸의 로마에서 돈을 빌린 사실을 잊는건 정말 바보같은 짓입니다. 당신은 사채업자의 부하들에 치욕적인 죽음을 맞이 했습니다....<br><br><center><b>Game Over</b></center>'
	end
end

stock_limit = rand(5,8)
stock_sold = 0
auction_phase = 0
haggling_stage = 0
sl_txt = 0

if gladi_count > 0:
	gladi_count -= 1
else
	gladi_count = 9
end

!Testing Code - every day is a Gladiatrix contest, Race contest, or auction day - crushboss
!gladi_count = 0
!ride_count = 1
!auction_count = 1
!End of Testing Code - crushboss

if ride_count > 0:
	ride_count -= 1
else
	ride_count = 9
	!Creating a route to the next race
	$trace[1] = 'ride_start'

	i = 1
	:loop_trace
		i += 1
		a = rand(1,12)
		$trace[i] = $trace_type[a]
	if i < 11: jump 'loop_trace'

	$trace[12] = 'ride_finish'
end

if auction_count > 0:
	auction_count -= 1
else
	auction_count = 9
end


!training contract completion check or elapsed days counter increment
if contract['active'] = 2: contract['active'] = 0
if contract['active'] = 1:
	contract['time'] += 1
	if contract['time'] = 1 + contract_time[contract['level']]: guild_reputation_rate -= 5 + guild_reputation &! reduce guild rep if late on a contract (do once, the day after it was due) - ImperatorAugustus
end

!Daily Expenses (charged per-decade in billing)
if stasis_tank > 0: decade_cryo_costs += 2
if iced_1_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_2_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_3_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_4_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_5_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_6_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_7_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_8_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_9_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_10_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_11_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_12_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_13_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_14_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_15_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_16_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_17_state ! CONST_INT['no_slave']: decade_cryo_costs += 1
if iced_18_state ! CONST_INT['no_slave']: decade_cryo_costs += 1

!Считаем динамику отношений в конце дня - mrross
if slave_state = CONST_INT['slave_exist'] and assistant_state = CONST_INT['slave_exist']: 
	sa_rel = 1
	gs 'relations_fastcalc'
	sa_rel = 2
	gs 'relations_fastcalc'
end

!Обратный таймер приказов - mrross
if slave['isolate'] > 0 and RAND(0, slave['obedience'] * 2) <= 0: slave['isolate'] -= 1
if assistant['isolate'] > 0 and RAND(0, assistant['obedience'] * 2) <= 0: assistant['isolate'] -= 1
if slave["smear"] > 0: slave["smear"] -= 1
if assistant["smear"] > 0: assistant["smear"] -= 1
if slave["praise"] > 0: slave["praise"] -= 1
if assistant["praise"] > 0: assistant["praise"] -= 1
if slave['teambuilding_1'] > 0: slave['teambuilding_1'] -= 1
if assistant['teambuilding_1'] > 0: assistant['teambuilding_1'] -= 1
if slave['teambuilding_2'] > 0: slave['teambuilding_2'] -= 1
if assistant['teambuilding_2'] > 0: assistant['teambuilding_2'] -= 1
if slave['teambuilding_3'] > 0: slave['teambuilding_3'] -= 1
if assistant['teambuilding_3'] > 0: assistant['teambuilding_3'] -= 1
if slave['teambuilding_35'] > 0: slave['teambuilding_35'] -= 1
if assistant['teambuilding_35'] > 0: assistant['teambuilding_35'] -= 1
if slave['provoke_1'] > 0: slave['provoke_1'] -= 1
if assistant['provoke_1'] > 0: assistant['provoke_1'] -= 1
if slave['provoke_2'] > 0: slave['provoke_2'] -= 1
if assistant['provoke_2'] > 0: assistant['provoke_2'] -= 1
if slave['provoke_3'] > 0: slave['provoke_3'] -= 1
if assistant['provoke_3'] > 0: assistant['provoke_3'] -= 1
if slave['provoke_4'] > 0: slave['provoke_4'] -= 1
if assistant['provoke_4'] > 0: assistant['provoke_4'] -= 1
if slave['provoke_5'] > 0: slave['provoke_5'] -= 1
if assistant['provoke_5'] > 0: assistant['provoke_5'] -= 1



!NPC state
gs 'npc_progress'
farid_debt += farid_potential_debt
farid_potential_debt = 0

!Beginning of assistant checks - no calculations if no assistant exists - crushboss
if assistant_state > CONST_INT['no_slave']:
	!chance of dying at zero value health - assistant
	!base - 14% - min 6% max 20% (0% if master has S+ medical skill)
	if assistant['stamina'] = 0 and assistant_rate['stamina'] = -10 and master_medic < 5:
		dprob_max = 7
		! psy status affect the chance
		if $assistant_psy_status = 'servile' or $assistant_psy_status = 'obedient': dprob_max = 16
		if $assistant_psy_status = 'soft' or $assistant_psy_status = 'optimistic': dprob_max = 9
		if $assistant_psy_status = 'broken': dprob_max = 5
		death_prob = 1 + ((48271 * (day + assistant_type)) mod 65537)/(65537/dprob_max) &! pseudo-rand(1,dprob_max)
		if death_prob = 5:
			assistant_died = 1
		end
	end

	if assistant['ego'] < 3: assistant_rate['ego'] += 1 &! nature increases passively up to B+ (Independent) - ImperatorAugustus

	!Training bonuses for easy obedience difficulty - crushboss
	if difficulty_setting = 1 and assistant_state = CONST_INT['slave_exist']:
		moral_basis = ((master_str + master_domination + master_fighter + master_cha)/5)
		if moral_basis < 1: moral_basis = 1
		assistant_rate['moral'] += moral_basis
		assistant_rate['custom'] += 1
		assistant_rate['rational'] += 1
		assistant_rate['instinct'] += 1
		assistant_rate['spoil'] -= 5
	end

	!brand effect - assistant
	if assistant_state = CONST_INT['slave_exist'] and assistant['brand'] > 0: assistant_rate['custom'] += 1
	if assistant_state = CONST_INT['slave_exist'] and assistant['brand'] = 3: assistant_rate['custom'] += 1

	! Clear merit and guilt for assistant - crushboss
	assistant['virtue'] = 0
	assistant['sin'] = 0

end &! End of assistant checks - do not remove this end statement - crushboss

!independent slave actions
slave_attack = 0
slave_escape = 0
slave_suicide = 0
!Slave cannot attack, escape or kill herself if she is mind-broken or locked in a cell at night (-2)
if slave['sleep_condition'] ! -2 and $slave_psy_status ! 'broken':

	!added check for health and unconsciousness, if health is zero or if she is lying unconscious, the slave will not be able to escape or attack - the_vm
	if slave['stamina'] > 0 and slave_state = CONST_INT['slave_exist']:

		if slave['mood'] < -1 and slave['temper'] > slave['obedience']:
			n = 7 + master_cha - slave['angst']
			if assistant_state = CONST_INT['slave_exist']:
				n += assistant['intellect'] + assistant['moral']
				if assistant['supervise_rule'] = 1: n += assistant['ego'] + assistant['gladiatrix']
			end

			if ((48271 * (day + slave_type)) mod 65537)/(65537/n) = 1:
				if slave['angst'] > 0 and (slave['gladiatrix'] + slave['angst']) > max(0, master_supermacy - master_style):
					slave_attack = 1
				elseif slave['slave_collar'] = 0:
					!Slave without collar will escape successfully unless she has a magical brand
					if slave['brand'] = 3:
						slave_escape = 2
					else
						slave_escape = 1
					end
				elseif slave['brand'] = 1 or slave['brand'] = 2:
					!Slave is returned if wearing a slave collar and has your brand - crushboss
					slave_escape = 3
				elseif slave['brand'] = 4:
					!Slave is returned if wearing a slave collar and the guild brand - crushboss
					slave_escape = 4
				end
			end
		end

		!Added an extra chance for the slave to turn on her master and attack - crushboss (relaxed conditions - ImperatorAugustus)
		if slave['angst'] > 2 and slave['stamina'] > 3 and slave['gladiatrix'] > 0 and slave['moral'] = 0 and slave['mood'] < 0 and (master_supermacy - master_style) < 2 and exam_in_progress = 0:
			slave_attack = 1
			slave_escape = 0
		end

		!Slave will not escape or attack with high obedience or devotion - crushboss (removed instinct condition - ImperatorAugustus)
		if slave['obedience'] > 7 or slave['moral'] > 1:
			slave_escape = 0
			slave_attack = 0
		end

		if slave['mood'] = -5 and slave['angst'] > max(slave['ego'], slave['temper']) and ((48271 * (day + slave_type)) mod 65537)/(65537/11) < slave['angst']: slave_suicide = 1 &! pseudo-rand(0, 10)

	end &! end health and consciousness check

	!slave cannot escape during exam in training mode
	!slaves will heal faster from wounds in tutorial mode since there is no medical center to visit - crushboss
	!slaves will recover from negative energy in tutorial - crushboss
	if exam_in_progress = 1:
		slave_escape = 0
		if slave_rate['wounds'] > 0: slave_rate['wounds'] -= slave['stamina'] + 2
		! fixed reversed sign (was adding stamina to wounds rate instead of subtracting) - ImperatorAugustus
		if slave['energy'] < 0: slave['energy'] += 1
		if slave['energy'] < 0 and slave['stamina'] > 3: slave['energy'] += 1
	end

end &! end of not-sleeping-in-dungeon check

!Slave Cook rule
if kitchen > 0 and cooked_food <= 0 and ate_already < max(1, master_str) and slave_state = CONST_INT['slave_exist'] and slave['cooks_rule'] = 1 and slave['energy'] >= 0 and slave['obedience'] >= -6 + iif(slave['pride'] > 2, -2, 0) + iif(slave['ego'] < 3, 1, 0) + iif(slave['intellect'] < 3, 1, 0):
	slave_auto_cook = 1 &! flag for end_of_day_screen
	slave_skill = min(slave['cook'], max(1, slave['mood']))
	gs '$food_choice', slave_skill &! consume ingredients, update last_cooked_food, cooked_food and $cooked_meal - lack of ingredients or skill limits meal quality - will only replace a lower quality meal
	$misc_bonus = 'learn_bonus["cook"]'
	$target_skill = 'cook'
	$target_affinity = 'cook_affinity'
	tutor_modifier = 0
	if last_cooked_food < slave_skill: tutor_modifier -= 5 &! sub-par diligence or using cheap ingredients for home cooking slows progress - ImperatorAugustus
	dynamic $replace($dyn_diligence, 'dyn'+'slave', 'slave')
	dynamic $replace($dyn_skill_rise, 'dyn'+'slave', 'slave')
	tutor_modifier = 0 &! prevent spillover
	if slave['energy'] > 0:
		slave['energy'] -= 1 &! not using energy_drop here so end of day calorie display is reliable and subsequent rule energy checks can pass
	else
		slave['half_action'] += 2 &! queue up energy drop for next morning
	end
	house_mess_rate += 5
	slave_rate['hygiene'] += 5
end

!Assistant Cooks Rule (or if slave was supposed to do it but did not)
if kitchen > 0 and cooked_food <= 0 and ate_already < max(1, master_str) and assistant_state = CONST_INT['slave_exist'] and (assistant['cooks_rule'] = 1 or slave['cooks_rule'] = 1) and assistant['energy'] >= 0:
	assistant_auto_cook = 1 &! flag for end_of_day_screen
	slave_skill = min(assistant['cook'], max(1, assistant['mood']))
	gs '$food_choice', slave_skill &! consume ingredients, update last_cooked_food, cooked_food and $cooked_meal - lack of ingredients or skill limits meal quality - will only replace a lower quality meal
	$misc_bonus = 'learn_bonus["cook"]'
	$target_skill = 'cook'
	$target_affinity = 'cook_affinity'
	tutor_modifier = 0
	if last_cooked_food < slave_skill: tutor_modifier -= 5 &! sub-par diligence or using cheap ingredients for home cooking slows progress - ImperatorAugustus
	dynamic $replace($dyn_diligence, 'dyn'+'slave', 'assistant')
	dynamic $replace($dyn_skill_rise, 'dyn'+'slave', 'assistant')
	tutor_modifier = 0 &! prevent spillover
	if assistant['energy'] > 0:
		assistant['energy'] -= 1 &! not using energy_drop here so end of day calorie display is reliable and subsequent rule energy checks can pass
	else
		assistant['half_action'] += 2 &! queue up energy drop for next morning
	end
	house_mess_rate += 5
	assistant_rate['hygiene'] += 5
end

!도나이식 메이드 요리
if kitchen > 0 and cooked_food <= 0 and ate_already < max(1, master_str) and room1_state = CONST_INT['slave_exist'] and (room1['cooks_rule'] = 1 or slave['cooks_rule'] = 1) and room1['energy'] >= 0:
	room1_auto_cook = 1
	slave_skill = min(room1['cook'], max(1, room1['mood']))
	gs '$food_choice', slave_skill 
	$misc_bonus = 'learn_bonus["cook"]'
	$target_skill = 'cook'
	$target_affinity = 'cook_affinity'
	tutor_modifier = 0
	dynamic $replace($dyn_diligence, 'dyn'+'slave', 'room1')
	dynamic $replace($dyn_skill_rise, 'dyn'+'slave', 'room1')
	if room1['energy'] > 0:
		room1['energy'] -= 1 
	else
		room1['half_action'] += 2 
	end
	house_mess_rate += 5
	room1_rate['hygiene'] += 5
end

if kitchen > 0 and cooked_food <= 0 and ate_already < max(1, master_str) and room2_state = CONST_INT['slave_exist'] and (room2['cooks_rule'] = 1 or slave['cooks_rule'] = 1) and room2['energy'] >= 0:
	room2_auto_cook = 1
	slave_skill = min(room2['cook'], max(1, room2['mood']))
	gs '$food_choice', slave_skill 
	$misc_bonus = 'learn_bonus["cook"]'
	$target_skill = 'cook'
	$target_affinity = 'cook_affinity'
