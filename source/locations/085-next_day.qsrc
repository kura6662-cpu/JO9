			!SLEEP IN CELLS (applies to prisoner or slave with corresponding sleep rule): Always apply physical effects (above), check not fainted for mental impacts - ImperatorAugustus
			if slave_state ! CONST_INT['slave_faint']:
				dynslave['deprivation_attitude_revealed'] = max(1, dynslave['deprivation_attitude_revealed'])
				if dynslave['deprivation_attitude'] = -1:
					if dynslave['sin'] < 3: dynslave_rate['angst'] += dynslave['sensitivity']*4
					if dynslave['sin'] > 0: dynslave_rate['rational'] += dynslave['intellect']
					dynslave_rate['fear'] += 20
					gs '$mood_drop', 'slave', 5
				elseif dynslave['deprivation_attitude'] = 0:
					if dynslave['sin'] < 3: dynslave_rate['angst'] += dynslave['sensitivity']*2
					if dynslave['sin'] > 0: dynslave_rate['rational'] += dynslave['intellect']
					dynslave_rate['fear'] += 5
					gs '$mood_drop', 'slave', 2
				elseif dynslave['deprivation_attitude'] = 1:
					if dynslave['sin'] < 1: dynslave_rate['angst'] += dynslave['sensitivity']
					if dynslave['sin'] > 0: dynslave_rate['rational'] += dynslave['intellect']
					if dynslave['fear'] < 1: dynslave_rate['fear'] += 1
				elseif dynslave['deprivation_attitude'] = 2:
					if dynslave['fear'] > 0: dynslave['fear'] -= 1
					dynslave_rate['mood'] += slave['temper']
				end
				if dynslave['deprivation_attitude'] ! 2:
					dynslave_rate['mood'] -= 5
					dynslave['neg_prisoner'] = dynslave['sensitivity']
					dynslave_rate['instinct'] += 3 &! changed from custom to instinct (imprisonment builds reflexive fear-based obedience) - ImperatorAugustus
				end
				dynslave['deprivation_xp'] += 1
				dynslave['sin'] = 0 &! clear guilt carried over from the previous day
			end

		end &! end of conscious or fainted state check
	}
end

dynamic $replace($next_day_prison_sleep_effects, 'dyn'+'slave', 'slave')
dynamic $replace($next_day_prison_sleep_effects, 'dyn'+'slave', 'prisoner')

!existence check for sleep condition effects - ImperatorAugustus
if slave_state > CONST_INT['no_slave']:

	if slave['sleep_condition'] = -1:
		slave['energy'] -= 1
		if slave['stamina'] > 2: slave_rate['stamina'] -= 1 &! exercising once per day is enough for an upward trend; decline stops at Weakened - ImperatorAugustus
		if slave['sensitivity'] > 1: slave['neg_bad_sleep'] = 1
		slave['neg_spoil'] = 0 &! no spoil moodlet after overnight on floor (the text is incongruous with the situation) - ImperatorAugustus
		!SLEEP ON FLOOR: Always apply physical effects (above), check not fainted for mental impacts - ImperatorAugustus
		if slave_state ! CONST_INT['slave_faint']:
			slave_rate['mood'] -= slave['sensitivity'] &! effect ranges from -0 to -0.5 mood, in addition to -1 from the moodlet - ImperatorAugustus
			slave_rate['instinct'] += max(1, min(2, master_supermacy/5)) &! slave feels superiority of master (added master_supermacy check - ImperatorAugustus)
			!TODO: proposed revision (Sleeping on the floor is now considered a punishment similar to sleeping in the cells and will resolve guilt) - ImperatorAugustus
			!TODO: proposed revision (If the slave does not feel any guilt, sleeping on the floor will drain awareness and increase angst)
			!if slave['sin'] = 0:
			!	slave_rate['angst'] += (slave['sensitivity']*2 + slave['temper'])/3 &! angst increases by weighted average of sensitivity (x2) and temperament (x1)
			!	slave_rate['rational'] -= 2 &! drain awareness due to punishment without guilt
			!	!If the slaver behaves in an arbitrary way and punishes a slave who is not feeling guilty, it weakens her motivation to obey the slaver to avoid punishments, because the slaver has shown that he may punish regardless
			!else
			!	slave_rate['rational'] += 2 &! increase awareness due to punishment with guilt
			!	slave['sin'] /= 2 &! reduce guilt carried over from the previous day by half (between -= 1 for unpunished guilt and = 0 for sleeping in prison)
			!end
		end
	end

	if slave['sleep_condition'] = 0:
		if slave['sensitivity'] > 3: slave['neg_bad_sleep'] = 1
		!BEDROLL: Always apply physical effects (above), check not fainted for mental impacts - ImperatorAugustus
		if slave_state ! CONST_INT['slave_faint']:
			slave_rate['custom'] += 1 &! slave grows accustomed to the situation
		end
	end

	!Sleep (in my bed) with slaver in master bedroom - improved - crushboss
	if slave['sleep_condition'] = 1:
		!For a 'positive' sleeping condition, even if slave is unconscious, they would find out where they slept when they wake up, so apply all effects even if unconscious (energy gain only if the slave wanted to be there, as otherwise they would not sleep well) - ImperatorAugustus
		if slave['moral'] = 0:
			slave_rate['angst'] += slave['sensitivity']
		elseif slave['moral'] = 1:
			slave_rate['pride'] += slave['ego']
			slave_rate['spoil'] += slave['temper']
		end
		!slave_rate['mood'] += (slave['moral']*2) &! disabled: moodlet is enough of a boost, extra mood rate is overkill - ImperatorAugustus
		slave_rate['mood'] -= slave['angst'] + slave['pride'] &! negative mood rate can stay - ImperatorAugustus
		if master_supermacy > 0: slave_rate['instinct'] += 1 &! added master_supermacy check, taming occurs regardless of attitude - ImperatorAugustus
		if slave['pride'] < 3 and slave['angst'] <= 0 and slave['moral'] >= 3:
			slave['half_action'] -= 1
			slave_rate['moral'] += 1
			slave['pos_slept_with_master'] = 1
			!added new moodlets for sleeping with master and liking or disliking it and removed mood condition (maybe she just had a rough day) - ImperatorAugustus
		else
			! added inverse effects for a slave who does not want to sleep with master - ImperatorAugustus
			slave['half_action'] += 1 &! restless sleep due to not wanting to be there
			slave_rate['moral'] -= 1
			slave['neg_slept_with_master'] = 1
		end
	end

	!Slave sleeps in boudoir - improved - crushboss
	if slave['sleep_condition'] = 2:
		!For a 'positive' sleeping condition, even if slave is unconscious, they would find out where they slept when they wake up, so apply all effects even if unconscious - ImperatorAugustus
		slave['half_action'] -= 3 &! gives full energy star more than sleeping with master, but does not raise devotion - ImperatorAugustus
		if slave['moral'] = 0:
			slave_rate['spoil'] += slave['temper']
		elseif slave['moral'] >= 1 and slave['moral'] < 4:
			slave_rate['spoil'] += 1
		end
		if slave['sensitivity'] > 0: slave['pos_sleep'] = 1
		if slave['angst'] < 3: slave_rate['mood'] += slave['sensitivity'] &! there is already a moodlet, but sleeping in the boudoir is a privilege: this adds up to +0.5 mood - ImperatorAugustus
		if master_supermacy > 0: slave_rate['instinct'] += 1 &! added master_supermacy check - ImperatorAugustus
		slave_rate['custom'] += 1 &! slave grows accustomed to the situation
		if slave['sensitivity'] < 3: slave_rate['sensitivity'] += 1 &! empathy increases passively up to B+ (Sensitive) - ImperatorAugustus
		if slave['ego'] < 3: slave_rate['ego'] += 1 &! nature increases passively up to B+ (Independent) - ImperatorAugustus and utterlyjunky
	end

end &! end of existence and interactions check for slave sleep conditions

$next_day_angst_effects = {
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted - ImperatorAugustus

		!Obtain/reduce Angst - improved - crushboss
		if dynslave['mood'] < 0:
			angst_rise = 6 - dynslave['sensitivity'] + dynslave['mood']
			if angst_rise < 0: dynslave_rate['angst'] += dynslave['sensitivity']
		else
			dynslave_rate['angst'] -= dynslave['moral']*3 + dynslave['rational']*2 + dynslave['custom'] + dynslave['mood'] &! removed instinct, reduced weights - ImperatorAugustus
			! discarded prisoner formula, which was (if positive mood in prison): prisoner_rate['angst'] -= prisoner['mood'] * prisoner['angst'] - ImperatorAugustus
		end

		!Angst increase if too many punishments are given out per day - slaves who are abused lose hope (moved to $dyn_torture_result) - ImperatorAugustus
		dynslave['daily_punishment_count'] = 0 &! reset here instead of in $end_day_variable_reset so you cannot freeze slaves to avoid raising angst with too many punishments - ImperatorAugustus

		!Angst does the dirty work
		if dynslave['angst'] > 0:
			dynslave_rate['temper'] -= dynslave['angst']
			dynslave_rate['ego'] -= dynslave['angst']

			if dynslave['angst'] > (4 - dynslave['sensitivity']):
				dynslave['neg_angst'] = dynslave['angst'] &! at F- sensitivity, 5 angst will apply moodlet; at B+, 2 angst; at A+, 1 angst -ImperatorAugustus
				gs '$mood_drop', 'dynslave', dynslave['angst'] - 1 &! positive moodlets also decay faster when above moodlet is applied - ImperatorAugustus
			end
		end
	end
}

dynamic $do_for_each_slave_in_list, '$next_day_angst_effects', '$unfrozen_slave_characters' &! all except iced

$next_day_fear_effects = {
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted - ImperatorAugustus

		!Lowering fear - improved - crushboss
		if dynslave['moral'] > dynslave['fear'] and dynslave['fear'] > 0 and dynslave['mood'] > 0:
			dynslave['fear'] -= 1
			dynslave_rate['fear'] = 0
		elseif dynslave['moral'] > 0 and dynslave['fear'] > 0 and dynslave['mood'] > 0:
			dynslave_rate['fear'] -= dynslave['moral']*3
		end

		!Reduce the mood because of fear
		if dynslave['fear'] > dynslave['moral'] and dynslave['fear'] > (dynslave['ego'] - dynslave['sensitivity']):
			! replaced the conditions for suppressing this moodlet - ImperatorAugustus
			! slave morality counters fear by reframing everything as "what master wants is what I want"
			! nature/willpower (ego) increases resistance to fear, but is countered by sensitivity
			dynslave['neg_fear'] = 1
		end

		if master_supermacy < 0: dynslave_rate['instinct'] -= max(0, dynslave['ego'] - (2 + dynslave['fear'])) &! if the master has a weaker aura than the slave, intimidation/submission-based obedience fades, offset by fear - ImperatorAugustus
	end
}

dynamic $do_for_each_slave_in_list, '$next_day_fear_effects', '$unfrozen_slave_characters'

gs '$difficulty_setting' &! among other things, this caps daily reward count at 2 on lower difficulties, so call it before $next_day_spoil_effects

$next_day_spoil_effects = {
	if dynslave_state = CONST_INT['slave_exist']:
		! state check does not include fainted - ImperatorAugustus

		!Spoil increase if too many rewards are given out per day - slaves should not expect a reward every time they obey - crushboss
		if dynslave['daily_reward_count'] > 2: dynslave_rate['spoil'] += (dynslave['daily_reward_count'] * 5)

		if 'dynslave' = 'slave' and dynslave['fear'] = 0 and dynslave['days_without_food'] = 0:
			!Spoil increase if not enough rules are enabled per day - slaves do not respect a master who does not expect them to follow any rules - crushboss
			!Only for current "training" slave, other roles are considered busy enough to avoid these spoil increases -ImperatorAugustus
			!Slaves will not become spoiled due to insufficient rules unless they are also without fear -ImperatorAugustus
			if overnight_rules_count < 3: dynslave_rate['spoil'] += (dynslave['pride'] + dynslave['ego'] + dynslave['temper'])
		end

		!Too high of spoiling causes obedience to fade - crushboss
		!Lowered threshold from > 3 to > 1 and made effect scale with spoil level (was flat -2,-2,-2,-4) - ImperatorAugustus
		if dynslave['spoil'] > 1:
			dynslave_rate['rational'] -= dynslave['spoil']
			dynslave_rate['instinct'] -= dynslave['spoil']
			dynslave_rate['custom'] -= dynslave['spoil']
			dynslave_rate['moral'] -= dynslave['spoil']
		end

		! moodlet
		if dynslave['spoil'] > max(0, dynslave['mood'], dynslave['fear']) and dynslave['sleep_condition'] >= -1: dynslave['neg_spoil'] = 1 &! not for prisoners or slaves sleeping in cells (TODO: or on the floor)
	end

	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted - ImperatorAugustus
		dynslave['daily_reward_count'] = 0 &! reset here instead of in $end_day_variable_reset so you cannot freeze slaves to avoid spoiling them with too many rewards (but you can still avoid it by making them faint) - ImperatorAugustus

		!lowering spoil - improved - crushboss (restructured and also applied to prisoner, sleeping in cells, sleeping on floor, not being fed and being more afraid than devoted - ImperatorAugustus)
		if (dynslave_rate['spoil'] > 0 or dynslave['spoil'] > 0) and ('dynslave' ! 'slave' or overnight_rules_count >= iif(difficulty_setting = 2, 3, 2) or dynslave['sleep_condition'] < 0 or dynslave['days_without_food'] ! 0 or dynslave['fear'] > dynslave['moral']):
			dynslave_rate['spoil'] -= 1 + dynslave['moral'] + dynslave['fear'] + dynslave['angst']*2 + max(0, dynslave['days_without_food'])*3
			if dynslave['mood'] < 0: dynslave_rate['spoil'] -= dynslave['sensitivity']
		end

	end
}

dynamic $do_for_each_slave_in_list, '$next_day_spoil_effects', '$unfrozen_slave_characters'

$next_day_slave_mood = {
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted - ImperatorAugustus

		if dynslave_state = CONST_INT['slave_exist']:
			! state check is conscious only - ImperatorAugustus
			! carry over +0.2 mood for each level of previous day mood that was above -5 (+0.2 at Dysphoric, +0.4 at Sullen, +0.6 at Melancholic, +0.8 at Pessimistic, +1 at Calm, +2 at Ecstatic)
			dynslave_rate['mood'] += 10 + dynslave['mood']*2 + dynslave['moral'] + (dynslave['stamina'] - 3) + _
				- dynslave['arousal'] - dynslave['fear'] - dynslave['spoil'] - dynslave['angst']*2 _
				- dynslave['hygiene'] - (house_mess - 1) &! removed energy from this formula (handled elsewhere), doubled angst impact, adjusted carry over to reduce mood swings by applying a bonus representing half of the previous day mood (counting anything above depressed as positive) - ImperatorAugustus

			! there should be no dynslave_rate['mood'] changes in next_day after this, so dynslave_rate['mood'] now reflects sum for upcoming day (except for up to 0.5 in end_day_screen if slave masturbates)
		end

		! effects for both conscious and fainted slaves (for when they wake up):
		if dynslave['moral'] > 0: dynslave['pos_moral'] = dynslave['moral']
		if dynslave['mood'] < 0 and dynslave['pride'] < 2: dynslave_rate['pride'] += dynslave['temper'] &! unhappy slaves gain pride up to B+, reflecting diminishing desire for intimacy - ImperatorAugustus

		!Lower slave mood when obedience, devotion, habit, instinct, and awareness are low and mood is high - crushboss (mood caps are now handled by $moodlets_account - ImperatorAugustus)
		!if dynslave['mood'] > 2 and (dynslave['moral'] < 1 or (dynslave['moral'] < 2 and max(dynslave['rational'], dynslave['instinct'], dynslave['custom']) <= 3)):
		!	dynslave_rate['mood'] -= (dynslave['pride'] + dynslave['temper'] + dynslave['ego'])
		!end

	end
}

dynamic $do_for_each_slave_in_list, '$next_day_slave_mood', '$unfrozen_slave_characters'

$next_day_slave_arousal = {
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted - ImperatorAugustus

		!Overhauled arousal calculation and modifiers - crushboss
		if dynslave['nymphomania'] > 0: dynslave_rate['arousal'] += (dynslave['temper'] + dynslave['sensitivity'] + dynslave['mood'])/2
		if dynslave['nymphomania'] < 0: dynslave_rate['arousal'] -= (dynslave['temper'])/2 &! frigid trait negates nightly arousal gain factors and subtracts half of temperament - ImperatorAugustus
		if dynslave['nymphomania'] >= 0: dynslave_rate['arousal'] += dynslave['stamina'] + daily_bonus['arousal'] + dynslave['sensitivity'] + dynslave['mood'] + dynslave['moral']
		dynslave_rate['arousal'] -= (6 + dynslave['angst'] + dynslave['pride'] + dynslave['fear'] + dynslave['spoil'])

		dynslave['pos_orgasm'] /= 2 &! moodlet exponentially decays (in addition to the daily reduction for all moodlets) -ImperatorAugustus

	end &! end of conscious or fainted state check
}

dynamic $do_for_each_slave_in_list, '$next_day_slave_arousal', '$unfrozen_slave_characters'

$next_day_slave_moral = {
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted - ImperatorAugustus

		!Growing moral - i.e. Daily Devotion Bonus - improved - crushboss (added min. obedience - ImperatorAugustus)
		moral_app = min (dynslave['moral'], dynslave['custom'], dynslave['rational'], dynslave['instinct'])
		if moral_app = dynslave['moral'] and overnight_rules_count >= iif(difficulty_setting = 2, 3, 2):
			if min(dynslave['obedience'], dynslave['mood']) > 0 and max(dynslave['angst'], dynslave['spoil']) = 0 and max(dynslave['fear'], dynslave['pride']) < 5:
				moral_basis = (dynslave['custom'] + dynslave['rational'] + dynslave['instinct'])/3
				moral_boost = min (dynslave['mood'], moral_basis)
				if moral_boost < 1: moral_boost = 1
				dynslave_rate['moral'] += moral_boost
			end
		end

		!Lowering moral progress if the slave is severely mishandled - crushboss (angst threshold lowered from 5 to 3 by ImperatorAugustus)
		if dynslave['angst'] > 2 or (dynslave['fear'] > 4 and dynslave['mood'] < 0):
			dynslave_rate['moral'] -= (dynslave['pride'] + dynslave['ego'] + dynslave['temper'])
		end

		!Love begins with true devotion - crushboss (added sensitivity benefit; removed strength condition - ImperatorAugustus)
		if dynslave['moral'] >= 5 and master_domination >= 5 and master_cha >= 5: dynslave['pos_slave_love'] = 100 & dynslave['sensitivity'] += 1

	end &! end of conscious or fainted state check
}

dynamic $do_for_each_slave_in_list, '$next_day_slave_moral', '$unfrozen_slave_characters'

!Training bonuses for easy obedience difficulty - crushboss
if difficulty_setting = 1:
	moral_basis = ((master_str + master_domination + master_fighter + master_cha)/5)
	if moral_basis < 1: moral_basis = 1
	slave_rate['moral'] += moral_basis
	slave_rate['custom'] += 1
	slave_rate['rational'] += 1
	slave_rate['instinct'] += 1
	slave_rate['spoil'] -= 5
	slave_rate['angst'] -= 5
end

!brand effect
if slave['brand'] > 0: slave_rate['custom'] += 1
if slave['brand'] = 3: slave_rate['custom'] += 1

!chance of dying at zero value health
!base - 14% - min 6% max 20% (0% if master or assistant has S+ medical skill)
if slave_state > CONST_INT['no_slave'] and slave['stamina'] = 0 and slave_rate['stamina'] = -10 and max(master_medic, iif(assistant_state = CONST_INT['slave_exist'], assistant['nurse'], 0)) < 5:
	dprob_max = 7
	! psy status affect the chance
	if $slave_psy_status = 'servile' or $slave_psy_status = 'obedient': dprob_max = 16
	if $slave_psy_status = 'soft' or $slave_psy_status = 'optimistic': dprob_max = 9
	if $slave_psy_status = 'broken': dprob_max = 5
	death_prob = 1 + ((48271 * (day + slave_type)) mod 65537)/(65537/dprob_max) &! pseudo-rand(1,dprob_max)
	if death_prob = 5:
		slave_died = 1
	end
end

!Slave energy refresh for following day (no changes to slave energy after this) - ImperatorAugustus
$next_day_energy_refresh = {
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted - ImperatorAugustus

		a = dynslave['stamina'] - dynslave['wounds']
		if a < 1:
			if farmhand_state = CONST_INT['slave_exist'] and arrpos('$livestock_slave_characters', 'dynslave') ! -1 and farmhand['nurse'] > dynslave['wounds']:
				a = 1
			elseif assistant_state = CONST_INT['slave_exist'] and assistant['nurse'] > dynslave['wounds']:
				a = 1
			elseif master_medic > dynslave['wounds']:
				a = 1
			end
		end
		dynslave['energy'] += a &! can be negative if wounded

	end &! end of conscious or fainted state check
}

dynamic $do_for_each_slave_in_list, '$next_day_energy_refresh', '$unfrozen_slave_characters'

!master part
if min(estate_quality_modifier, master_wealth) > master_cha + house_mess: master_cha_rate += 1 &! estate_quality_modifier is calculated in $newloc, house_mess will be zero if someone cleaned
if master_cha > min(master_wealth - 1, estate_quality_modifier): master_cha_rate -= 1 &! personality diminishes if standard of living [0,6] or estate quality is inadequate - ImperatorAugustus
if snake_amulet_on = 1 and master_cha < 3: master_cha_rate += 1 &! quest artifact passively raises personality up to B+, countering the penalty for low standard of living or estate quality
if master_visage > 0: master_visage -= 1
if master_haircut > 0: master_haircut -= 1

!mood change - fixed by wisarddd 2020-02-28 (changed by ImperatorAugustus to use average of brand reputation and master personality - increasing reputation or personality means increasing demand for entertainment, but absence of one holds back the other)
! When bored, positive moods end faster. If the day is ended with the master in a good enough mood, the master will not be bored the next day even if they have not been entertained for a long time. How tolerant the slaver is of not being entertained depends on brand reputation and personality. It is a comparison of how long since the last "good enough" entertainment (and the standards for "good enough" entertainment also rise as reputation and personality increases) vs. reputation and mood. If the sum of reputation and negative mood exceeds the time since the last good entertainment, the master will be bored. At the low end, assuming no recent entertainment, a Pessimistic or better mood will not be bored at F- brand reputation, but a Calm mood will be bored at D- brand reputation, a Hopeful mood will be bored at C- reputation, an Optimistic mood will be bored at B+ reputation, a Pleased mood will be bored at A+ reputation, and an Euphoric mood will be bored at S+ reputation. The master will never be bored if the day ends in Ecstatic mood. Drinking and other drugs can elevate mood, so they can help. In moderation. In terms of ways to obtain "good enough" entertainment (which reduces the mood threshold to avoid boredom), "serve me" performances qualify if done well. As you noted, going to watch arena events, socializing at the club, or going to the theater (slave reward) also qualify. At S+ brand reputation and personality, the arena events only satisfy for a couple of days. The club and the theater last for a few days regardless of reputation, but they still interact with mood as described, so you get some leeway but still need to keep mood up to avoid boredom.
if master_moodlet['pos_show'] < (brand_reputation + master_cha)/2 - 1 - master_mood:
	! if the right side of the inequality is zero or negative, the master is NOT bored; this means that high enough mood can avoid boredom without recent entertainment
	! the more recent / better the entertainment, the higher pos_show will be, which means that mood can be lower; the higher the mood, the less recent the entertainment needs to be
	! the higher the brand reputation and personality, the more recent / better the entertainment needs to have been (or more mood is required to not be bored if there was no entertainment)
	! at "Pessimistic" (-1) mood, a master with F- brand reputation OR personality will NOT be bored regardless of entertainment; lower mood OR higher personality/reputation will require entertainment to avoid boredom
	master_moodlet['neg_boring'] = 1
	master_moodlet['pos_show'] = 0
	if demo_game = 0: gs '$mod_master_drop', 1 &! disabled for tutorial - ImperatorAugustus
end

!wounds and illness effects
if assistant_state = CONST_INT['slave_exist']:
	healing = max(master_medic, assistant['nurse']) &! ImperatorAugustus: changed to use best skill of master or assistant instead of sum
else
	healing = master_medic
end
if master_wounds > 0:
	master_str_rate -= master_wounds*3 &! injuries deplete strength for master too - ImperatorAugustus
	master_wounds_rate -= master_str + healing - (master_hygiene + 1) + max(0, ate_already - 2, cooked_food - 2) &! B+ = +1, A+ = +2, S+ = +3 - ImperatorAugustus
	master_moodlet['neg_wounded'] = master_wounds &! higher magnitude is harder to overcome with a positive $mod_master_rise (alcohol, opium, club) - ImperatorAugustus
elseif master_wounds_rate > 0:
	master_wounds_rate -= master_str + healing + max(0, ate_already - 2, cooked_food - 2) &! after wounds close, they continue healing but hygiene no longer affects them - ImperatorAugustus
end
if master_wounds_rate < 0: master_wounds_rate = 0
killvar 'healing'

if master_ill > 0:
	master_ill += 1
	if master_ill > master_str: master_str_rate -= 1
	if master_ill > 6: master_moodlet['neg_master_ill'] = master_ill
	if ((48271 * day) mod 65537)/(65537/60) < master_str: master_ill = 0 & master_moodlet['neg_master_ill'] = 0 &! chance of natural recovery: 5% at B+ strength, 8.3% at S+ strength - ImperatorAugustus
end

!next day energy for master (not capped here so master_half_action carries over properly)
master_energy += master_str + 1 - master_wounds

!Addiction
if master_koffed > 0:
	master_koffed = 0
	master_koffe_addiction += 1
	if master_koffe_addiction > master_str*8:
		master_moodlet['neg_no_koffe'] = master_koffe_addiction &! can linger for days
		master_half_action += 1 &! addiction penalty applies only day after
		master_str_rate -= 1 &! addiction penalty applies only day after
	end
elseif master_koffe_addiction > 0 and (day mod 2) = 0:
	master_koffe_addiction -= 1
end

if master_drunk > 0:
	master_drunk = 0
	master_alco_addiction += 1
	master_moodlet['pos_drunk'] = 0
	if master_alco_addiction > master_str:
		master_moodlet['neg_drunk'] = master_alco_addiction &! can linger for days
		master_str_rate -= 1 &! addiction penalty applies only day after
	end
elseif master_alco_addiction > 0 and (day mod 3) = 0:
	master_alco_addiction -= 1
end

if kannabis_pressure > 0 and (day mod 2) = 0: kannabis_pressure -= 1

if master_on_meth > 0:
	master_on_meth = 0
	master_meth_addiction += 1
	if master_meth_addiction > master_str:
		master_moodlet['neg_no_meth'] = master_meth_addiction
		master_energy -= 1 &! next day energy crash
		master_str_rate -= master_meth_addiction/2 &! addiction penalty is higher if taken yesterday
	end
else
	if master_meth_addiction > 0 and (day mod 3) = 0: master_meth_addiction -= 1
	if master_meth_addiction > 1:
		master_moodlet['neg_no_meth'] = master_meth_addiction
		master_str_rate -= master_meth_addiction/10 &! lingering addiction penalty
	end
end

if master_on_opium > 0:
	master_on_opium = 0
	master_opium_addiction += 1
	master_moodlet['pos_opium'] = 0
	if master_opium_addiction > master_str:
		master_moodlet['neg_no_opium'] = master_opium_addiction - 2 - (day mod master_str) &! -2 to -6
		if master_moodlet['neg_no_opium'] > 1: gs '$mod_master_drop', 3
		master_str_rate -= master_opium_addiction &! addiction penalty is higher if taken yesterday
	end
else
	if master_opium_addiction > 0 and (day mod 4) = 0: master_opium_addiction -= 1
	if master_opium_addiction > master_str:
		master_moodlet['neg_no_opium'] = master_opium_addiction
		master_str_rate -= 1 &! lingering addiction penalty
	end
end

!rise arousal
master_excitement_rate += master_libido*10 + max(0, master_mood*10) &! libido is offset by negative mood - ImperatorAugustus
if master_excitement = 5 and chimera_gem_on ! 1:
	blazing_counter += 1
else
	blazing_counter = 0
end

!Beginning of prisoner check - no calculations if no prisoner exists - crushboss (> instead of ! as this also does not apply to dead prisoners - ImperatorAugustus)
if prisoner_state > CONST_INT['no_slave']:
	prisoner_rate['hygiene'] += 7 + prisoner['wounds']

	! prisoner has already been processed by $next_day_resolve_previous_day_calorie_effects but we still need to apply $next_day_starvation_effects for the day now ending
	dynamic $replace($next_day_starvation_effects, 'dyn'+'slave', 'prisoner'), (prisoner['prison_food_type'] + 1) &! -1 represents no food, so +1 to shift it to zero for boolean

	! chance to drop nature and pride by a full level each time the slave advances a level of physique while in prison, or eats enough if already at max physique (can drop rapidly at that point)
	! here we rely on the fact that previous day calories effects have already been processed, modifying fat rate, but fat itself has not yet been updated, so we can check if it has reached the threshold
	if prisoner['fat'] > 2:
		! only if physique exceeds Slender (2) - ImperatorAugustus
		! for a more gradual decline, changed pride to not start to drop until nature is zero (25% chance per day) - ImperatorAugustus
		if prisoner['fat'] < 5 and prisoner_rate['fat'] >= indep_atr_max_threshold[prisoner['fat']]:
			! gaining a level of physique (getting fatter) at next update
			prisoner['ego'] -= rand(0,1)
			! ego can be -1 here if was 0 before, which would bypass following = 0 condition (50% chance next line condition is true, and 50% chance it reduces pride, yielding 25% chance overall)
			if prisoner['ego'] = 0: prisoner['pride'] -= rand(0,1)
		elseif prisoner['fat'] = 5 and prisoner_rate['fat'] > 6:
			! at high pride, low nature, this can occur every other day with cookies diet
			! at low pride, low nature, this can occur daily
			prisoner_rate['fat'] = 0
			prisoner['ego'] -= rand(0,1)
			! ego can be -1 here if was 0 before
			if prisoner['ego'] = 0: prisoner['pride'] -= rand(0,1)
		end
		! clamp values
		if prisoner['ego'] < 0: prisoner['ego'] = 0
		if prisoner['pride'] < 0: prisoner['pride'] = 0
	end

	! set excess calories (and costs) for next day
	if prisoner['prison_food_type'] = -1 or prisoner_state = CONST_INT['slave_faint']:
		! no food (a fainted prisoner usually would be woken by $next_day_stamina_update before this, but just in case, we treat that as no food)
		prisoner_food_cost = 0 &! zero cost today, not an accumulating total - ImperatorAugustus
		prisoner['calories'] = -22 + prisoner['fat']*2 &! this threshold will trigger immediate fainting in $next_day_resolve_previous_day_calorie_effects for slaves without fat reserves - ImperatorAugustus
	elseif prisoner['prison_food_type'] = 1:
		! insufficient diet
		prisoner_food_cost = 1 &! added to total_food_cost daily, not an accumulating total - ImperatorAugustus
		prisoner['calories'] = -6 &! below minimum non-starvation level (-5) so will trigger effects in $next_day_starvation_effects the following night if left in prison without other source of calories - ImperatorAugustus
	elseif prisoner['prison_food_type'] = 0:
		! sufficient diet
		prisoner_food_cost = (3 + iif(prisoner['neg_hungry'] > 0, 3, 0)) / 3 &! added to total_food_cost daily, not an accumulating total - ImperatorAugustus
		prisoner['calories'] = 3 + iif(prisoner['neg_hungry'] > 0, 3, 0) &! .33$/cal, equivalent to dehydrated food (which is what it is)
	elseif prisoner['prison_food_type'] = 2:
		! fiend cum
		if prisoner['fiend_tattoo'] = 0: prisoner['neg_disgust'] = max(prisoner['neg_disgust'], 1 + prisoner['pride'] - prisoner['perversion'])
		if prisoner['fiend_tattoo'] ! 1 and prisoner['perversion'] ! 2: prisoner['neg_slave_food'] = 1
		prisoner['perversion_xp'] += 1
		if spawn_semen > 2 + iif(prisoner['neg_hungry'] > 0, 3, 0):
			spawn_semen -= 3 + iif(prisoner['neg_hungry'] > 0, 3, 0)
			prisoner_food_cost = 0 &! zero cost today, not an accumulating total - ImperatorAugustus
		else
			! any excess needs to be purchased at 1$/cal (2x more expensive than fresh food; keep in sync with slave food_cost calculation) - ImperatorAugustus
			prisoner_food_cost = (3 + iif(prisoner['neg_hungry'] > 0, 3, 0) - spawn_semen) &! 1-3 sparks (+3 if neg_hungry), added to total_food_cost daily, not an accumulating total - ImperatorAugustus
			spawn_semen = 0
		end
		prisoner['calories'] = 3 + iif(prisoner['neg_hungry'] > 0, 3, 0)
	elseif prisoner['prison_food_type'] = 3:
		! cookies
		prisoner_eats = (11 - prisoner['ego'] - prisoner['pride'] - prisoner['mood']) / 2 &! [3,8]
		if prisoner['age'] = CONST_INT['milf_age']: prisoner_eats += 1
		if prisoner['age'] = CONST_INT['loli_age']: prisoner_eats -= 1
		if prisoner['neg_hungry'] > 0: prisoner_eats += 3
		if prisoner_eats < 3: prisoner_eats = 3 &! removed safety check for corpulent slaves, so they can self-harm to death by eating too much - ImperatorAugustus
		prisoner_food_cost = prisoner_eats/3 &! 1-3 sparks (+1 if neg_hungry), added to total_food_cost daily, not an accumulating total - ImperatorAugustus
		prisoner['calories'] = prisoner_eats
		prisoner['neg_disgust'] = max(prisoner['neg_disgust'], 1 + prisoner['pride'] + prisoner['ego'])
		prisoner['neg_slave_food'] = 0
		prisoner['ego'] -= 1
		prisoner_rate['mood'] -= rand(1,prisoner_eats+2)
	end

	total_food_cost += prisoner_food_cost

	!chance of dying at zero value health
	!base - 14% - min 6% max 20% (0% if master or assistant has S+ medical skill)
	if prisoner['stamina'] = 0 and prisoner_rate['stamina'] = -10 and max(master_medic, iif(assistant_state = CONST_INT['slave_exist'], assistant['nurse'], 0)) < 5:
		dprob_max = 7
		! psy status affect the chance
		if $prisoner_psy_status = 'servile' or $prisoner_psy_status = 'obedient': dprob_max = 16
		if $prisoner_psy_status = 'soft' or $prisoner_psy_status = 'optimistic': dprob_max = 9
		if $prisoner_psy_status = 'broken': dprob_max = 5
		death_prob = 1 + ((48271 * (day + prisoner_type)) mod 65537)/(65537/dprob_max) &! pseudo-rand(1,dprob_max)
		if death_prob = 5:
			prisoner_died = 1
		end
	end

!End of prisoner checks - do not remove this end statement - crushboss
end

$next_day_impregnation_update = {
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted - ImperatorAugustus
		dynslave['impregnation'] = 0
		dynslave['cum_load'] -= rand(4,8)
		if dynslave['cum_load'] < 0: dynslave['cum_load'] = 0
		if dynslave['lactation'] > 0 and dynslave['cum_load'] > 0:
			if dynslave['cum_load'] >= 1: dynslave['impregnation'] = 1
			if dynslave['cum_load'] > 10: dynslave['impregnation'] = 2
			if dynslave['cum_load'] > 25: dynslave['impregnation'] = 3
			if dynslave['cum_load'] > 40: dynslave['impregnation'] = 4
			if dynslave['cum_load'] > 50: dynslave['impregnation'] = 5
			if dynslave['cum_load'] > 60: dynslave['impregnation'] = 6
			if dynslave['cum_load'] > 70: dynslave['impregnation'] = 7
			if dynslave['cum_load'] > 80: dynslave['impregnation'] = 8
			if dynslave['cum_load'] > 90: dynslave['impregnation'] = 9
			if dynslave['cum_load'] > 100: dynslave['impregnation'] = 10
		end
	end
}

!slaves impregnation (linked to lactation) - converted to dynamic function by ImperatorAugustus
dynamic $do_for_each_slave_in_list, '$next_day_impregnation_update', '$main_screen_slave_characters' &! slave, assistant, prisoner, cow - TODO: add others?

$next_day_lactation_update = {
	if dynslave_state > CONST_INT['no_slave']:
		!slave lactation - fixed by crushboss - updated by Pianocat - converted to dynamic function and limited to conscious state by ImperatorAugustus

		dynslave['milk_gain'] = 0
		if dynslave['lactation'] > 0:
			dynslave['energy'] -= 1
			dynslave['milk_gain'] = dynslave['boobs'] + dynslave['cowSK'] + dynslave['impregnation'] + min((dynslave['custom']*3)/2, 5) + dynslave['mood'] - dynslave['angst']*2 - dynslave['rehabilitation']/2
			! [0-6] + [0,5] + [0,10] + [0,5], + [-5,5] + [-10,0] + [-10,0] = [-25,31] from formula above
			if dynslave['age'] = CONST_INT['milf_age']: dynslave['milk_gain'] += 2
			if dynslave['fat'] = 2: dynslave['milk_gain'] += 1
			if dynslave['fat'] = 3: dynslave['milk_gain'] += 2
			if dynslave['fat'] > 3: dynslave['milk_gain'] += 4
			if dynslave['fat'] = 0: dynslave['milk_gain'] = dynslave['milk_gain']/2
			if dynslave['ill'] > 0: dynslave['milk_gain'] = (dynslave['milk_gain']/3)*2
			if $dynslave_psy_status = 'broken': dynslave['milk_gain'] = (dynslave['milk_gain']/3)*2
			! above factors can increase value by up to +6 (or lower if F- physique, ill or broken) yielding max milk_gain of 37 (Stupendous Boobs, S+ Impregnation, S+ Cow, 4+ Habit, Ecstatic, Mature, Chubby)
			dynslave['lactation'] = 1
			if dynslave['milk_gain'] > 10: dynslave['lactation'] = 2
			if dynslave['milk_gain'] > 16: dynslave['lactation'] = 3
			if dynslave['milk_gain'] > 22: dynslave['lactation'] = 4
			if dynslave['milk_gain'] > 35: dynslave['lactation'] = 5
			if dynslave['cowSK'] = 5 or (dynslave['cowSK'] > 2 and dynslave['cowSK_affinity'] > 0):
				dynslave['pos_cow'] = 1
				dynslave['neg_cow'] = 0
			else
				dynslave['pos_cow'] = 0
				if dynslave['cowSK'] < 5 and dynslave['cowSK_affinity'] <= 0:
					dynslave['neg_cow'] = 1
				else
					dynslave['neg_cow'] = 0
				end
			end
		end

		!Milk summ calculation + random boost - Pianocat
		if dynslave['milk_gain'] < 0: dynslave['milk_gain'] = 0
		if dynslave['milk_summ'] > 130: dynslave['milk_summ'] = 130

		if dynslave['milk_summ'] >= 0 and dynslave['milk_summ'] < 20: dynslave['milk_summ'] += rand(0,1)
		if dynslave['milk_summ'] >= 20 and dynslave['milk_summ'] < 40: dynslave['milk_summ'] += rand(2,4)
		if dynslave['milk_summ'] >= 40 and dynslave['milk_summ'] < 60: dynslave['milk_summ'] += rand(5,6)
		if dynslave['milk_summ'] >= 60 and dynslave['milk_summ'] < 80: dynslave['milk_summ'] += rand(2,4)
		if dynslave['milk_summ'] >= 80 and dynslave['milk_summ'] < 90: dynslave['milk_summ'] += rand(0,1)
		if dynslave['milk_summ'] >= 90 and dynslave['milk_summ'] < 100: dynslave['milk_summ'] -= rand(1,3)
		if dynslave['milk_summ'] >= 100 and dynslave['milk_summ'] < 110: dynslave['milk_summ'] -= rand(2,6)
		if dynslave['milk_summ'] >= 110 and dynslave['milk_summ'] < 120: dynslave['milk_summ'] -= rand(4,8)
		if dynslave['milk_summ'] >= 120: dynslave['milk_summ'] -= rand(5,10)

		!Transfer the milk gained this day to the total amount of milk
		dynslave['milk_summ'] += dynslave['milk_gain']

		! max milk_gain of 37 gets a boost of [2,4] on day 1, then if not milked, [39,41] + 37 = [76,78] on day 2 gets a boost of [2,4], then if not milked, [78,82] + 37 = [115,119] on day 3 gets a penalty of [4,8]
		! day 1 milking produces 3 bottles, day 2 milking produces 7-8 bottles, day 3 milking produces 11-12 bottles: average 3, 3.75 and 3.83 bottles per day respectively, so a maxed cow is best milked once per 3 days
		! milk sells for up to 7$ (was 4$) per bottle (and can be bought for 6$ per bottle) so on average a maxed cow milked every 2-3 days produces 262$ (was 150$) per decade - best case 280$ per decade
		! compare an average cow (Average Boobs, S+ cow skill, B+ impregnation, 3 Habit, Pleased, Young, Voluptuous): 3 + 5 + 3 + 4 + 3 + 2 = 20 milk_gain, B+ lactation
		! milk gain of 20 gets a boost of [2,4] on day 1, then if not milked, [22,24] + 20 = [42,44] on day 2 gets a boost of [5,6], then if not milked, [47,50] + 20 = [67,70] on day 3 gets a boost of [2,4], then if not milked, [69,74] + 20 = [89,94] on day 4 gets a penalty/bonus of [-3,1], then if not milked, [86,95] + 20 = [106,115] on day 5 gets a penalty of [2,8]
		! day 1 milking produces 2 bottles, day 2 milking produces 4-5 bottles, day 3 milking produces 6-7 bottles, day 4 milking same, day 5 milking produces 10-11 bottles, on average, 2, 2.25, 2.16, 1.63, 2.1
		! so it is optimal to milk an average cow once per two days also, producing around 157$ (was 90$) per decade
	end
}

!slave lactation - fixed by crushboss - updated by Pianocat - converted to dynamic function by ImperatorAugustus
dynamic $do_for_each_slave_in_list, '$next_day_lactation_update', '$main_screen_slave_characters' &! slave, assistant, prisoner, cow - TODO: add others?

!Milk demand adjustment
dynamic $milk_price
milk_tip = 0
tip_asked = 0

!Beginning of cow check - no calculations if no cow exists - crushboss - updated Pianocat
if cow_state > CONST_INT['no_slave']:
	cow_rate['hygiene'] += 12 + cow['wounds']

	! cow has already been processed by $next_day_resolve_previous_day_calorie_effects but we still need to apply $next_day_starvation_effects for the day now ending
	dynamic $replace($next_day_starvation_effects, 'dyn'+'slave', 'cow'), (cow_ration + 1) &! -1 represents no food, so +1 to shift it to zero for boolean

	! set excess calories (and costs) for next day
	! as calculated in $next_day_lactation_update, an average cow produces 157$/decade (was 90$/decade) and a perfect cow produces 262$/decade (was 150$/decade)
	! so costs in excess of 14$/day (was 8$/day) would be a loss for an average cow and costs in excess of 24$/day (was 14$/day) would be a loss for a perfect cow
	if cow_ration = -1 or (cow_state = CONST_INT['slave_faint'] and farmhand_state ! CONST_INT['slave_exist']):
		! no food or fainted cow and no one to force feed (cow would be woken before this by $next_day_stamina_update if in good enough condition)
		cow_rate['angst'] += 5
		cow_rate['mood'] -= 5
		barn_cow_food += 0 &! zero cost, accumulating sum for decade billing - ImperatorAugustus
		cow['calories'] = -22 + cow['fat']*2 &! this threshold will trigger immediate fainting in $next_day_resolve_previous_day_calorie_effects for slaves without fat reserves - ImperatorAugustus
		! this diet is "free" but will degrade the endurance (quickly) and physique (slowly) and induce despair if it lasts more than one night, so it is best used sparingly and on alternating days at most
		! effectively, this tactic (give food only on alternate days) can obtain roughly 50% more profitability (+$45/decade with average cow, +75$/decade with perfect cow) at a cost of ~55 endurance rate
		! if you exercise the cow on the days when the cow is fed (assuming standard food on those days), you will have +600 calories (due to hunger) so can exercise 2-3 times without triggering starvation
		! with proper attire (leotard, sneakers) and a good trainer (clever/intelligent assistant with equal or better endurance), you can compensate for the endurance loss and sustain this pattern
		! this therefore is viable for increasing profits when you do not have a productive fiend, but - given the amount of micro-management - is best reserved for when 45-75$ is desperately needed
	elseif cow_ration = 1:
		! standard food
		if cow['time_in_barn'] < 10: cow['neg_slave_food'] = 1
		cow['calories'] = 3 &! lactation increases food_need by 1, so weak (worst) metabolism cows will still gain physique (which boosts productivity) when not on fattening diet - ImperatorAugustus
		if cow['neg_hungry'] > 0: cow['calories'] += cow['stamina']*3 &! hungry cows eat more (neg_hungry implies F- physique or days_without_food > 0 or losing weight) ... and will overcome powerful metabolism at D- lactation
		barn_cow_food += cow['calories']/3 + cow['lactation'] + 5 &! [1,5] + [1,5] + 5 = 7 - 15 sparks daily, accumulating sum for decade billing (.33$/calorie for standard food, equivalent to dehydrated) - ImperatorAugustus
		! this diet runs at 6$/day profit for a non-hungry B+ lactation cow (9$/day cost, 15$/day earned) and 15$/day profit for a non-hungry S+ lactation cow (11$/day cost, 26$/day earned)
	elseif cow_ration = 0:
		! fattening food
		cow['calories'] = 4 + cow['lactation'] &! 4 + [1,5] = 5 - 9 calories, lactation increases food_need by 1, so 7 calories are needed to overcome powerful metabolism, achieved at B+ (3) lactation - ImperatorAugustus
		if cow['neg_hungry'] > 0: cow['calories'] += cow['stamina']*3 &! hungry cows eat more (neg_hungry implies F- physique or days_without_food > 0 or losing weight) ... and will overcome powerful metabolism at F- lactation
		barn_cow_food += cow['calories']/2 + cow['lactation'] + 5 &! [2,12] + [1,5] + 5 = 8 - 22 sparks daily, accumulating sum for decade billing (.5$/calorie for fattening food, equivalent to fresh food) - ImperatorAugustus
		! this diet runs at 4$/day profit for a non-hungry B+ lactation cow (11$/day cost, 15$/day earned) and 12$/day profit for a non-hungry S+ lactation cow (14$/day cost, 26$/day earned)
	elseif cow_ration = 2:
		! fiend cum
		! this diet is "free" (cost of a fiend is 100$ plus slave energy divided over its lifetime) so it provides the best profitability as long as you do not run out of spawn semen
		cow['calories'] = 3 &! lactation increases food_need by 1, so weak (worst) metabolism cows will still gain physique (which boosts productivity) when not on fattening diet - ImperatorAugustus
		if cow['neg_hungry'] > 0: cow['calories'] += cow['stamina']*3 &! hungry cows eat more (neg_hungry implies F- physique or days_without_food > 0 or losing weight) ... and will overcome powerful metabolism at D- lactation
		if cow['fiend_tattoo'] = 0: cow['neg_disgust'] = max(cow['neg_disgust'], 1 + cow['pride'] - cow['perversion'])
		if cow['fiend_tattoo'] ! 1 and cow['perversion'] ! 2: cow['neg_slave_food'] = 1
		cow['perversion_xp'] += 1
		if spawn_semen > cow['calories'] + cow['lactation'] + 5:
			spawn_semen -= cow['calories'] + cow['lactation'] + 5
		else
			! any excess needs to be purchased at 1$/cal (2x more expensive than fresh food; keep in sync with slave food_cost calculation) - ImperatorAugustus
			barn_cow_food += (cow['calories'] + cow['lactation'] + 5 - spawn_semen) &! accumulating sum for decade billing - ImperatorAugustus
			spawn_semen = 0
		end
		! best case, this diet runs at 15$/day profit for a non-hungry B+ lactation cow and 26$/day profit for a non-hungry S+ lactation cow (if sufficient supply)
		! worst case, this diet runs at 4$/day profit for a non-hungry B+ lactation cow and 13$/day profit for a non-hungry S+ lactation cow (if no supply)
	end

	!Risks for slave to escape the barn or commit suicide
	cow_escape = 0
	cow_suicide = 0
	if $cow_psy_status ! 'broken' and cow_locked = 0:
		if cow['cowSK'] < 5 and rand(8,12) > cow['cowSK'] + cow['obedience'] + cow['fear']*2: cow_escape = 1
		if cow['angst'] > cow['ego'] + cow['custom'] and rand(0,10) < cow['angst']: cow_suicide = 1
	end

	!Time in barn influence slave - Pianocat
	!fixed state check: time_in_barn also increases for fainted cow - ImperatorAugustus
	if cow_escape = 0: cow['time_in_barn'] += 1
	if cow['time_in_barn'] = 1: barn_first_night = 1
	if cow['time_in_barn'] = 10: barn_first_decade = 1

	!barn_custom determines how slaves react at time spent in barn - Pianocat
	no_more_barn_update = 0
	if cow['cowSK'] = 5:
		cow['barn_custom'] = 6
		no_more_barn_update = 1
	else
		cow_sanity = cow['ego'] + cow['temper'] + cow['pride']
		if cow['cowSK'] = 4: cow['barn_custom'] = 5
		if cow['cowSK'] = 4 and cow_sanity < 5: cow['barn_custom'] = 4
		if cow['cowSK'] = 3: cow['barn_custom'] = 3
		if cow['cowSK'] = 3 and cow_sanity < 5: cow['barn_custom'] = 2
		if cow['cowSK'] < 3: cow['barn_custom'] = 1
		if cow_sanity < 3: cow['barn_custom'] = 0
		killvar 'cow_sanity'
	end

	cow['cowSK_affinity_revealed'] = max(1, cow['cowSK_affinity_revealed'])
	cow['deprivation_attitude_revealed'] = max(1, cow['deprivation_attitude_revealed'])

	!impacts on the cow - less negative impact and quicker learning if a farmhand is appointed - Pianocat
	!condition escape_cow=0 added, to avoid an escaping cow malus/bonus, excepted moral ones
	if cow['barn_custom'] = 6:
		if farmhand_state = CONST_INT['slave_exist']:
			cow['pos_cow'] = 1
			cow['pos_barn'] = 1
			cow_rate['intellect'] -= 2
		else
			if cow['deprivation_attitude'] > 0: cow['pos_barn'] = 1
			cow_rate['intellect'] -= 3
		end
	elseif cow['barn_custom'] = 5:
		if cow_escape = 0:
! JO9 MOD START COG_DIRECT_12 | 2026-10-16_innate_learning_traits
			cow_rate['cowSK'] += func('jo9_learning_xp', (10), cow['jo9_learning_trait'], 'cowSK')
! JO9 MOD END COG_DIRECT_12
			if cow['pride'] > 2: cow_rate['pride'] -= 2
			if farmhand_state = CONST_INT['slave_exist']:
				cow['pos_barn'] = 1
				cow_rate['temper'] -= 1
				cow_rate['intellect'] -= 2
				cow_rate['ego'] -= 1
			else
				if cow['deprivation_attitude'] > 0: cow['pos_barn'] = 1
				cow_rate['temper'] -= 2
				cow_rate['intellect'] -= 3
				cow_rate['ego'] -= 2
			end
		end
	elseif cow['barn_custom'] = 4:
		if cow_escape = 0:
! JO9 MOD START COG_DIRECT_13 | 2026-10-16_innate_learning_traits
			cow_rate['cowSK'] += func('jo9_learning_xp', (8), cow['jo9_learning_trait'], 'cowSK')
! JO9 MOD END COG_DIRECT_13
			if cow['pride'] > 2: cow_rate['pride'] -= 2
			if farmhand_state = CONST_INT['slave_exist']:
				cow['pos_barn'] = 1
				cow_rate['temper'] -= 1
				cow_rate['intellect'] -= 2
				cow_rate['ego'] -= 1
			else
				if cow['deprivation_attitude'] > 0: cow['pos_barn'] = 1
				cow_rate['temper'] -= 2
				cow_rate['intellect'] -= 3
				cow_rate['ego'] -= 2
			end
		end
	elseif cow['barn_custom'] = 3:
		if cow_escape = 0:
! JO9 MOD START COG_DIRECT_14 | 2026-10-16_innate_learning_traits
			cow_rate['cowSK'] += func('jo9_learning_xp', (5), cow['jo9_learning_trait'], 'cowSK')
! JO9 MOD END COG_DIRECT_14
			if cow['pride'] > 2: cow_rate['pride'] -= 2
		end
		if farmhand_state = CONST_INT['slave_exist']:
			if cow_escape = 0:
				cow_rate['temper'] -= 1
				cow_rate['intellect'] -= 2
				cow_rate['ego'] -= 1
			end
		else
			if cow['deprivation_attitude'] < 1: cow['neg_barn'] = 2
			if cow_escape = 0:
				cow_rate['temper'] -= 2
				cow_rate['intellect'] -= 3
				cow_rate['ego'] -= 2
			end
		end
	elseif cow['barn_custom'] = 2:
		cow['neg_barn'] = 3
		if cow_escape = 0:
! JO9 MOD START COG_DIRECT_15 | 2026-10-16_innate_learning_traits
			cow_rate['cowSK'] += func('jo9_learning_xp', (3), cow['jo9_learning_trait'], 'cowSK')
! JO9 MOD END COG_DIRECT_15
			if cow['pride'] > 2: cow_rate['pride'] -= 2
		end
		if farmhand_state = CONST_INT['slave_exist']:
			if cow_escape = 0:
				cow_rate['temper'] -= 1
				cow_rate['intellect'] -= 2
				cow_rate['ego'] -= 1
			end
		else
			if cow['deprivation_attitude'] < 1: cow['neg_barn_plus'] = 2
			if cow_escape = 0:
				cow_rate['temper'] -= 2
				cow_rate['intellect'] -= 3
				cow_rate['ego'] -= 2
			end
		end
	elseif cow['barn_custom'] = 1:
		cow['neg_barn'] = 4
		if cow['deprivation_attitude'] < 2: cow['neg_barn_plus'] = 2
		if cow_escape = 0:
! JO9 MOD START COG_DIRECT_16 | 2026-10-16_innate_learning_traits
			cow_rate['cowSK'] += func('jo9_learning_xp', (2), cow['jo9_learning_trait'], 'cowSK') 
! JO9 MOD END COG_DIRECT_16
			if cow['pride'] > 2: cow_rate['pride'] -= 4
		end
		if farmhand_state = CONST_INT['slave_exist']:
			if cow_escape = 0:
				cow_rate['temper'] -= 3
				cow_rate['intellect']-= 3
				cow_rate['ego'] -= 3
			end
		else
			cow['neg_disgust'] = max(cow['neg_disgust'], 1)
			if cow_escape = 0:
				cow_rate['temper'] -= 4
				cow_rate['intellect'] -= 3
				cow_rate['ego'] -= 4
			end
		end
	end

	if cow['pos_barn'] > 0: cow['neg_barn'] = 0 & cow['neg_barn_plus'] = 0 & cow['neg_cow'] = 0

	cow['deprivation_xp'] += 1

	!Broken cows do not care if farmhand or not - Pianocat
	if cow['barn_custom'] = 0:
! JO9 MOD START COG_DIRECT_17 | 2026-10-16_innate_learning_traits
		cow_rate['cowSK'] += func('jo9_learning_xp', (6), cow['jo9_learning_trait'], 'cowSK')
! JO9 MOD END COG_DIRECT_17
		cow_rate['intellect'] -= 3
	end

	!Adding additional penalties if cow is locked
	if cow_locked = 1 and cow['barn_custom'] ! 0:
		if cow['deprivation_attitude'] = -1:
			cow_rate['fear'] += 20
			cow_rate['angst'] += 20
			cow_rate['mood'] -= 20
			cow_rate['rational'] += 5
			if cow['fear'] < cow['sensitivity']: cow['fear'] = cow['sensitivity']
		end 
		if cow['deprivation_attitude'] = 0:
			cow_rate['fear'] += 5
			cow_rate['angst'] += 10
			cow_rate['mood'] -= 10
			cow_rate['rational'] += 5
			a = cow['sensitivity'] - 1
			if cow['fear'] < a: cow['fear'] = a
		end
		if cow['deprivation_attitude'] = 1:
			cow_rate['fear'] += 3
			cow_rate['angst'] += 5
			cow_rate['mood'] -= 5
			cow_rate['rational'] += 3
			a = cow['sensitivity'] - cow['ego']
			if cow['fear'] < a: cow['fear'] = a
		end
		if cow['deprivation_attitude'] = 2:
			cow_rate['fear'] += 0
			cow_rate['mood'] += 2
		end
		cow['energy'] -= 1
		cow['deprivation_xp'] += 1
		cow['neg_prisoner'] = 3
	end

	!cow stamina slowly trends to Weakened (faster/slower if locked)
	if cow['stamina'] < 2:
		cow_rate['stamina'] += 2 - cow_locked
	elseif cow['stamina'] > 2:
		cow_rate['stamina'] -= 2 + cow_locked
	elseif cow_rate['stamina'] > 0:
		cow_rate['stamina'] -= 1
	elseif cow_rate['stamina'] < 0:
		cow_rate['stamina'] += 1
	end

	!however, a farmhand will try to maintain cow stamina at Healthy with light exercise
	if farmhand_state = CONST_INT['slave_exist'] and cow['calories'] > -1 and (cow['stamina'] < 3 or (cow['stamina'] = 3 and cow_rate['stamina'] < 0)):
		cow_rate['stamina'] += 4 & cow['calories'] -= 3 &! +3 here opposes -1/-2/-3 above (stamina > 2, stamina_rate > 0, cow_locked = 1)
	end

	!chance of dying at zero value health - cow
	!base - 14% - min 6% max 20% (0% if farmhand has S+ medical skill)
	if cow['stamina'] = 0 and cow_rate['stamina'] = -10 and iif(farmhand_state = CONST_INT['slave_exist'], farmhand['nurse'], 0) < 5:
		dprob_max = 7
		! psy status affect the chance
		if $cow_psy_status = 'servile' or $cow_psy_status = 'obedient': dprob_max = 16
		if $cow_psy_status = 'soft' or $cow_psy_status = 'optimistic': dprob_max = 9
		if $cow_psy_status = 'broken': dprob_max = 5
		death_prob = 1 + ((48271 * (day + cow_type)) mod 65537)/(65537/dprob_max) &! pseudo-rand(1,dprob_max)
		if death_prob = 5:
			cow_died = 1
		end
	end

!End of cow checks - do not remove this end statement
end

!개인실 식사 설정	
! JO9 MOD START J9M1550 | 2026-10-10_restore_private_room_ui_corrections | changed block; context may be included
! SNK_DIET_BEGIN_room1
if room1_state = CONST_INT['slave_exist']:
 room1_rate['hygiene'] += 12 + room1['wounds']
 dynamic $replace($next_day_starvation_effects, 'dyn'+'slave', 'room1'), (room1_ration + 1)
 if room1_ration = 0:
  room1['calories'] = 6 + room1['lactation']
  total_food_cost += 4
 else
  if room1['fat'] > 1: room1['calories'] = -6
  if room1['fat'] = 0: room1['calories'] = 6
  if room1['fat'] = 1: room1['calories'] = 3
  if room1_ration = 1:
   if room1['time_in_barn'] < 10: room1['neg_slave_food'] = 1
   total_food_cost += 2
  elseif room1_ration = 2:
   total_food_cost += 8
  end
 end
 if room1['neg_hungry'] > 0: room1['calories'] += room1['stamina']
 if room1_ration = 2:
  room1['special_diet_days'] += 1
  if room1['special_diet_days'] >= 5:
   room1['pos_cookie'] = max(room1['pos_cookie'], 1)
   room1_rate['spoil'] += 1 + room1['moral']
  end
  if room1['special_diet_days'] >= 10: room1['pos_dessert'] = max(room1['pos_dessert'], 1)
 else
  room1['special_diet_days'] = 0
 end
elseif room1_state = CONST_INT['no_slave'] or room1_state = CONST_INT['slave_dead']:
 room1['special_diet_days'] = 0
! JO9 MOD END J9M1550
end
