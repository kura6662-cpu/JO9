}

dynamic $do_for_each_slave_in_list, '$next_day_addiction_pilfering', '$assistant_slave_characters' &! assistant and farmhand

$next_day_menses_preg_egglaying_update = {
	if dynslave_state > CONST_INT['no_slave']:
		! state check includes fainted (cycle continues even when unconscious) - ImperatorAugustus
		!Menstrual cycle and pregnancy - improved and fixed - crushboss (converted to dynamic and overhauled by ImperatorAugustus)
		if dynslave['fertility'] = 1: dynslave['menstruation'] = 0 & dynslave['neg_menstruation'] = 0 & dynslave['parasite'] = 0 &! egglayers cannot menstruate or host parasites
		
		if dynslave['inseminated'] > 0: dynslave['inseminated'] -= 1 &! inseminated represents remaining lifespan of live sperm (should be set to 3-5 when insemination occurs)
		
		if dynslave['menstruation'] > 0:
			if dynslave['fertility_revealed'] = 0: dynslave['fertility_revealed'] = 1 &! menstruation reveals fertility
			dynslave['pregnant'] = 0 &! menstruation while pregnant ends the pregnancy (miscarriage and reactions thereto are not implemented) - ImperatorAugustus
			dynslave['menstruation'] += 1 &! tracking duration of menstruation and suppressing end_of_day_screen notification (shown when = 1 only)
			!TODO: sex while menstruation > 0 should impact hygiene more, and perhaps give neg moodlets (depending on master / slave perversion)
			if dynslave['menstruation'] > 3 + ((48271 * (day + dynslave_type)) mod 65537)/(65537/4):
				! end menstruation after pseudo-rand(3,6) days, remove moodlet
				dynslave['menstruation'] = 0
				dynslave['neg_menstruation'] = 0
			end
		elseif dynslave['pregnant'] > 0 and dynslave['fertility'] ! -2 and dynslave['fertility'] ! 1:
			! pregnant, not immature, not egglaying = real pregnancy (if pregnant before sterilization, pregnancy continues) - ImperatorAugustus
			dynslave['pregnant'] += 1 &! counting days pregnant (early term is 37w0d to 38w6d [259-272 days], full term is 39w0d - 40w6d [273 to 286 days], after is late)
			if dynslave['stamina'] > 2: dynslave_rate['stamina'] -= 1 + (dynslave['pregnant'] / 30) &! pregnancy drains stamina at an increasing daily rate as it progresses to term, stopping at Weakened - ImperatorAugustus
			!Pregnancy Revealed - overhauled entire pregnancy system - added $pregnancy and $pregnancy_assistant modules - crushboss (overhauled again, modules removed - ImperatorAugustus)
			!Overhauled code to work with Oviparity (egglaying) and sjm_UI_UIadds module - modified pregnancy activities to point to the above modules - crushboss (replaced with $inseminate - ImperatorAugustus)
			if dynslave['pregnant_revealed'] = 0:
				!Normal and early detection chance - crushboss (but not too early - ImperatorAugustus)
				if dynslave['pregnant'] >= 120 or (dynslave['pregnant'] > 90 and inventory['stethoscope'] ! 0 and (master_medic > 2 or assistant['nurse'] > 2) and rand(1,21) = 8):
					dynslave['pregnant_revealed'] = 1
					if dynslave['fertility_revealed'] = 0: dynslave['fertility_revealed'] = 1 &! detected pregnancy reveals fertility
				end
			end
		end
		if dynslave['pregnant'] = 0 and dynslave['fertility'] ! -2 and dynslave['fertility'] ! 1:
			! not pregnant, not immature, and not egglaying -> can menstruate (surgical sterilization prevents pregnancy but does not stop cycles) - ImperatorAugustus
			dynslave['cycle_day'] -= 1 &! countdown to beginning of the next cycle
			if dynslave['cycle_day'] <= 0:
				dynslave['menstruation'] = 1 &! today is first day of menstruation (triggers end_of_day_screen notifications)
				dynslave['neg_menstruation'] = 1000 &! large magnitude to survive any mood_drop including the -100 from Water of Lethe
				dynslave['cycle_day'] = rand(21,35) &! duration of next cycle varies from 21 to 35 days, averaging 28 (synchronization of women living together is a myth)
			elseif dynslave['ovulation'] > 0:
				dynslave['ovulation'] -= 1 &! countdown to ovulation day
				if dynslave['ovulation'] = 0 and dynslave['fertility'] = 0 and dynslave['inseminated'] > iif(dynslave_type = 2572, 1, rand(1,5)):
					dynslave['pregnant'] = 1 &! pregnancy starts on ovulation day if live sperm can reach the egg (max 80% chance, reduced by time since insemination)
					dynslave['pregnant_revealed'] = 0
				end
			elseif dynslave['cycle_day'] > 16:
				dynslave['ovulation'] = dynslave['cycle_day'] - rand(13,15) &! ovulation occurs on average 14 days before menstruation
			end
		end
		!Egglaying
		dynslave['egg_time'] = 0
		if dynslave['fertility'] = 1 and dynslave['rehabilitation'] = 0:
			if dynslave['eggs_to_lay'] <= 0:
				dynslave['eggs_to_lay'] = dynslave['age'] + dynslave['stamina'] + dynslave['fat'] + 3 + ((48271 * (day + dynslave_type + barn_egg_profit)) mod 65537)/(65537/4) &! [0,2] + [0,5] + [0,5] + pseudo-rand(3,6) = [3,18]
				dynslave['pregnant'] = 1 &! repurpose pregnant variable as a delay timer counting days until next batch of eggs are ready
			elseif dynslave['pregnant'] > 3:
				dynslave['eggs_to_lay'] -= 1 &! lay one egg each day after the third day until all eggs are laid
				dynslave['egg_time'] = 1 &! notifies end_of_day_screen that an egg was laid today by this slave
				total_eggs_laid_today += 1 &! global counter of eggs laid today by all slaves in the household, cleared in end_day_screen
				dynslave_rate['custom'] += 1
! JO9 MOD START J9M1551 | 2026-10-15_zz_meiki_state | changed block; context may be included
				if dynslave['jo9_meiki_known'] = 0: dynslave['virginity'] = 3 &! relaxed; preserve permanent known state
! JO9 MOD END J9M1551
			else
				dynslave['pregnant'] += 1 &! increment timer until next batch of eggs are ready
			end
		end
	end
}

IF hero_choice > 100:
	if female["age"] = 1: female['fertility'] = -2
	IF female['fertility'] < 0:
		female['parasite'] = 0
		female['pregnant'] = 0
	END
	if female_vaginal_modification = 4: female['parasite'] = 0
	female['cycle_day'] += 1
	if female['cycle_day'] > 28: female['cycle_day'] = 1
	IF female['pregnant'] = 0 and female['parasite'] = 0:
		IF female["age"] ! 1 and hero_choice > 100:
			if female['ovulation'] > 0: female['ovulation'] -= 1
			if female['ovulation'] < 0: female['ovulation'] = 0
			IF female['cycle_day'] = 1:
				female['neg_menstruation'] = 6 - master_energy
				female_menstruation = 1
			END
			if female['cycle_day'] = 9: female['ovulation'] = 7
		END
	else
		IF female['parasite'] = 0:
			female['pregnant'] += 1
			master_energy -= 1
		END
		female['ovulation'] = 0
	END
END



!Menstrual cycle and pregnancy/egglaying - slave - improved and fixed - crushboss (converted to dynamic function and revised -ImperatorAugustus)
dynamic $do_for_each_slave_in_list, '$next_day_menses_preg_egglaying_update', '$main_screen_slave_characters' &! slave, assistant, prisoner, cow

!Menstrual cycle and pregnancy/egglaying - add farmhand, pig (TODO: harpy is handled elsewhere for now) -ImperatorAugustus
dynamic $replace($next_day_menses_preg_egglaying_update,'dyn'+'slave','farmhand')
dynamic $replace($next_day_menses_preg_egglaying_update,'dyn'+'slave','pig')

!Change stats under the influence of the established rules

!Clear the rules if no slave exists - crushboss
!no longer needed, all rules are now properties of slave array so they are cleaned up automatically - ImperatorAugustus

!Ensure all variables are set to zero - sanity check - probably unnecessary - crushboss
!rules_broken = 0 - legacy variable (globally replaced by slave['rules_broken']) - ImperatorAugustus
slave['num_rules_broken'] = 0
slave['num_rules_wanttobreak'] = 0
! TODO: are above lines unnecessary here? ($end_day_variable_reset clears them) - ImperatorAugustus
!removed unnecessary rule_res variable clearing (they were reset before each use) and later eliminated those variables entirely - ImperatorAugustus
overnight_rules_count = 0
$slave['rules_explanations'] = ''
!the two lines above are necessary daily resets - ImperatorAugustus

!Rewrote most of the rule code - was a total mess - crushboss - yeah me too:) - Slaver (ditto -ImperatorAugustus)
!rule_masturbation is not handled here but later in next_day and end_day_screen - crushboss
!orgasm_prohibited rule is not handled here but in #dynamic, sexy_time_engine, and end_day_screen - crushboss
!All the other rules that require special handling are handled in this section - crushboss

!Changed condition from ! no_slave to slave_exist (a fainted slave cannot follow rules) - ImperatorAugustus
if slave_state = CONST_INT['slave_exist']:

	if slave['cooks_rule'] = 1:
		overnight_rules_count += 1
		! Cooking lesson repulse (-6) as baseline, offset by -2 for high pride (pride prefers less interaction with slaver) and +1 each for low intellect, low nature due to discomfort with lack of guidance
		if slave['obedience'] < -6 + iif(slave['pride'] > 2, -2, 0) + iif(slave['ego'] < 3, 1, 0) + iif(slave['intellect'] < 3, 1, 0):
			slave['neg_rules'] = 1
			slave['num_rules_broken'] += 1
			$slave['rules_explanations'] += iif($slave['rules_explanations'] ! '', '<br>', '') + '<u>식사 준비</u>: '
			$slave['rules_explanations'] += '<<$slave_name>>(은)는 당신을 위해 요리하길 거부했다.'
		end
	end

	if slave['cleans_rule'] = 1:
		overnight_rules_count += 1
		! Maid lesson repulse as baseline, offset by -2 for high pride (pride prefers less interaction with slaver) and +1 each for low intellect, low nature due to discomfort with lack of guidance
		if slave['obedience'] < -5 + iif(slave['stamina'] < 3, 1, -1) + iif(slave['intellect'] > 2, 1, -1) + iif(slave['pride'] > 2, slave['pride'] - 2, slave['pride'] - 3) + _ 
																			iif(slave['pride'] > 2, -2, 0) + iif(slave['ego'] < 3, 1, 0) + iif(slave['intellect'] < 3, 1, 0):
			slave['neg_rules'] = 1
			slave['num_rules_broken'] += 1
			$slave['rules_explanations'] += iif($slave['rules_explanations'] ! '', '<br>', '') + '<u>잡일과 청소 노예</u>: '
			$slave['rules_explanations'] += '<<$slave_name>>(은)는 당신의 집을 청소하길 거부했다.'
		end
	end

	if slave['washes_master_rule'] = 1:
		overnight_rules_count += 1
		if slave_auto_wash = -1:
			slave_auto_wash = 0
			slave['neg_rules'] = 1
			slave['num_rules_broken'] += 1
			$slave['rules_explanations'] += iif($slave['rules_explanations'] ! '', '<br>', '') + '<u>목욕 노예</u>: '
			$slave['rules_explanations'] += '<<$slave_name>>(은)는 당신과의 혼욕을 거부했다.'
		end
	end

	if slave['blowjob_rule'] = 1:
		overnight_rules_count += 1
		stimulating = 1 &! sex acceptance will be added to repulse - ImperatorAugustus
		interaction_slave['repulse'] = 6 &! same as blowjob lesson
		dynamic $replace($dyn_sex_acceptance, 'dyn'+'slave', 'slave')
		$interaction_partner = 'slave' & dynamic $replace($dyn_repulse_check, 'dyn'+'slave', 'slave')
		$slave['rules_explanations'] += iif($slave['rules_explanations'] ! '', '<br>', '') + '<u>펠라 자명종</u>: '
		if interaction_slave['res'] < 0:
			if slave['force_rules'] = 1 and assistant['supervise_rule'] = 1 and assistant['gladiatrix'] > slave['gladiatrix'] and assistant['stamina'] > slave['stamina']:
				slave['neg_rules'] = 1
				slave['num_rules_wanttobreak'] += 1
				$slave['rules_explanations'] += '<<$slave_name>>(은)는 아침에 입으로 봉사하기를 거부했지만, 당신의 조수가 그녀의 목에 당신의 자지를 억지로 쑤셔넣었다.'
