			dynslave['energy'] = -4
		elseif max(master_medic, assistant['nurse']) > 3:
			dynslave_rate['stamina'] += 1 &! A+ or S+ medical skill assists recovery (otherwise, it is up to diet alone)
		end
	end
}
dynamic $do_for_each_slave_in_list, '$next_day_stamina_update', '$unfrozen_slave_characters'

