					$slave['rules_explanations'] += ' 다만, 시도는 했어도 결국 당신을 ' + iif(master_excitement < -2, '흥분시키지 못했다.', '사정시키지 못했다.')
					$slave['rules_explanations'] += ' 그녀의 괴로워하는 낯짝에 혐오와 죄책감이 서려있다.'
				else
					$slave['rules_explanations'] += ' 그녀의 괴로워하는 낯짝에 혐오감이 서려있다.'
				end
			elseif max(0, min(master_excitement + 1, slave['sub_bj'] - master_penetration/2)) > 0:
				$slave['rules_explanations'] += ' 난 아주 만족스러운 미소로 한가득 정액을 뿜어줬다.'
			elseif master_excitement < -2:
				$slave['rules_explanations'] += ' 허나 나름 노력했지만, 결국 당신을 흥분시키지 못해 죄책감을 느끼고 있다.'
			else
				$slave['rules_explanations'] += ' 허나 나름 노력했지만, 결국 당신을 사정시키지 못해서 죄책감을 느끼고 있다.'
			end
		end
		if $reset_interaction_variables ! '': dynamic $replace($reset_interaction_variables, 'dyn'+'slave', 'slave')
	end

	if slave['humility_rule'] = 1:
		overnight_rules_count += 1
		$slave['rules_explanations'] += iif($slave['rules_explanations'] ! '', '<br>', '') + '<u>예절 강요</u>: '
		if slave['obedience'] < 1:
			if slave['force_rules'] = 1 and inventory['shock_collar'] > 0:
				slave['neg_rules'] = 1
				slave['num_rules_wanttobreak'] += 1
				$slave['rules_explanations'] += '<<$slave_name>>(은)는 당신을 주인님이라 부르려 하는 것만으로도 입에 가시가 돋는 모양이다.'
			else
				slave['humility_rule_broken'] = 1
				slave['num_rules_broken'] += 1
				$slave['rules_explanations'] += '<<$slave_name>>(은)는 당신을 주인님이라 부르기를 거부했다.'
			end
		else
			$slave['rules_explanations'] += '<<$slave_name>>(은)는 당신을 주인님이라고 부른다.'
		end
		if slave['humility_rule_broken'] = 0:
			slave_rate['mood'] -= slave['ego'] + slave['pride'] - slave['moral']
			if slave['ego'] + slave['pride'] - slave['moral'] > 0:
				$slave['rules_explanations'] += ' 하지만 그 모습은 티가 날 정도로 과장되어 보인다.'
			else
				$slave['rules_explanations'] += ' 그녀는 마치 그렇게 부르는 것만으로도 자랑스러움을 느끼는 모양이다.'
			end
		end
	end

	if slave['pet_rule'] = 1:
		overnight_rules_count += 1
