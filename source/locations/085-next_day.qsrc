			else
				slave['blowjob_rule_broken'] = 1
				slave['num_rules_broken'] += 1
				$slave['rules_explanations'] += '<<$slave_name>>(은)는 방에 찾아와 아침 펠라 하기를 거부했다.'
				if slave['force_rules'] = 1 and assistant['supervise_rule'] = 1: $slave['rules_explanations'] += ' 당신의 조수는 힘과 실력이 부족해서 강제할 수 없었다.'
			end
		else
			$slave['rules_explanations'] += '<<$slave_name>>(은)는 당신의 방에 찾아와 부드럽게 펠라치오를 했다.'
		end
		if slave['blowjob_rule_broken'] = 0:
